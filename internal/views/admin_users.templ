package views

import (
	"context"
	"fmt"
	"strings"
	"time"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/copybutton"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// AdminUserData is one person as the Users page lists them. Each action's
// path is its address, or empty when the action doesn't apply to them: the
// address shows the action's dialog (GET) and makes the change (POST).
type AdminUserData struct {
	ID                       string
	Username                 string
	Status                   string
	Role                     string
	Current                  bool
	HasPassword              bool
	PasswordChangeRequired   bool
	MFALabel                 string
	MFADetail                string
	MFARequired              bool
	DeletionPending          bool
	PasswordResetRequestedAt *time.Time
	InvitationState          string
	InvitationExpiresAt      *time.Time
	MFAPolicyPath            string
	StatusPath               string
	CredentialResetPath      string
	RequiredChangePath       string
	DeletionPath             string
	InvitationRevokePath     string
	InvitationRotatePath     string
}

type AdminUsersData struct {
	Users               []AdminUserData
	Total               int
	Active              int
	Pending             int
	Disabled            int
	Administrators      int
	StepUpRequired      bool
	InvitationCSRFToken string
	InvitationForm      AdminUserInvitationFormData
	Invitation          *AdminUserInvitationData
	CredentialReset     *AdminUserCredentialResetData
	// Dialog opens with the page, when the page was asked for at an
	// action's address.
	Dialog *AdminUserDialog
}

type AdminUserInvitationFormData struct {
	Name        string
	Username    string
	FieldErrors map[string]string
}

type AdminUserInvitationData struct {
	Name          string
	Username      string
	RedemptionURL string
	Token         string
	ExpiresAt     time.Time
	Rotated       bool
}

type AdminUserCredentialResetData struct {
	Username      string
	RedemptionURL string
	Token         string
	ExpiresAt     time.Time
}

// AdminUserAction is one thing the Users page can do to a person.
type AdminUserAction string

const (
	AdminUserActionMFAPolicy        AdminUserAction = "mfa-policy"
	AdminUserActionStatus           AdminUserAction = "status"
	AdminUserActionCredentialReset  AdminUserAction = "credential-reset"
	AdminUserActionRequiredChange   AdminUserAction = "require-password-change"
	AdminUserActionDeletion         AdminUserAction = "delete"
	AdminUserActionInvitationRevoke AdminUserAction = "invitation-revoke"
	AdminUserActionInvitationRotate AdminUserAction = "invitation-rotate"
)

// Path is the address of action for this person, or "" when it doesn't
// apply to them. Revoking needs an invitation that still works.
func (user AdminUserData) Path(action AdminUserAction) string {
	switch action {
	case AdminUserActionMFAPolicy:
		return user.MFAPolicyPath
	case AdminUserActionStatus:
		return user.StatusPath
	case AdminUserActionCredentialReset:
		return user.CredentialResetPath
	case AdminUserActionRequiredChange:
		return user.RequiredChangePath
	case AdminUserActionDeletion:
		return user.DeletionPath
	case AdminUserActionInvitationRevoke:
		if user.InvitationState == "active" {
			return user.InvitationRevokePath
		}
	case AdminUserActionInvitationRotate:
		return user.InvitationRotatePath
	}
	return ""
}

// AdminUserDialog is one action's dialog for one person. The page asks for
// it when the administrator picks the action, so a form's CSRF proof is
// made only for the dialog that opens.
type AdminUserDialog struct {
	Action    AdminUserAction
	User      AdminUserData
	CSRFToken string
}

// adminUserDialogSlotID is where the Users page puts the dialog of the
// action picked from a person's menu.
const adminUserDialogSlotID = "admin-user-dialog"

// AdminVerificationOnPageHeader is the header htmx sends from a page that
// already has the verification dialog, so the dialogs it fetches don't bring
// another.
const AdminVerificationOnPageHeader = "Gofer-Verification-On-Page"

// adminVerificationOnPageHeaders are the hx-headers of a page that has the
// verification dialog.
const adminVerificationOnPageHeaders = `{"` + AdminVerificationOnPageHeader + `":"true"}`

// adminUserMenuEntry is one entry of a person's action menu.
type adminUserMenuEntry struct {
	Path        string
	Label       string
	Icon        func(...icon.Props) templ.Component
	Destructive bool
	Disabled    bool
}

// adminUserMenuEntries are the entries of user's action menu, in order:
// invitation, sign-in, two-step sign-in, access, and deletion last.
func adminUserMenuEntries(ctx context.Context, user AdminUserData) []adminUserMenuEntry {
	var entries []adminUserMenuEntry
	if path := user.Path(AdminUserActionInvitationRevoke); path != "" {
		entries = append(entries, adminUserMenuEntry{Path: path, Label: i18n.T(ctx, "admin.invite.revoke_button"), Icon: icon.MailX})
	}
	if path := user.Path(AdminUserActionInvitationRotate); path != "" {
		if user.InvitationState == "active" {
			entries = append(entries, adminUserMenuEntry{Path: path, Label: i18n.T(ctx, "admin.invite.rotate_menu"), Icon: icon.RefreshCw})
		} else {
			entries = append(entries, adminUserMenuEntry{Path: path, Label: i18n.T(ctx, "admin.invite.issue"), Icon: icon.MailPlus})
		}
	}
	if path := user.Path(AdminUserActionCredentialReset); path != "" {
		entries = append(entries, adminUserMenuEntry{Path: path, Label: i18n.T(ctx, "admin.reset.generate"), Icon: icon.KeyRound})
	}
	if path := user.Path(AdminUserActionRequiredChange); path != "" {
		entries = append(entries, adminUserMenuEntry{
			Path: path, Label: i18n.T(ctx, "admin.required_change.button"), Icon: icon.RectangleEllipsis,
			Disabled: user.PasswordChangeRequired,
		})
	}
	if path := user.Path(AdminUserActionMFAPolicy); path != "" {
		if user.MFARequired {
			entries = append(entries, adminUserMenuEntry{Path: path, Label: i18n.T(ctx, "admin.mfa.clear_menu"), Icon: icon.ShieldOff})
		} else {
			entries = append(entries, adminUserMenuEntry{Path: path, Label: i18n.T(ctx, "admin.mfa.require"), Icon: icon.ShieldCheck})
		}
	}
	if path := user.Path(AdminUserActionStatus); path != "" {
		if user.Status == "disabled" {
			entries = append(entries, adminUserMenuEntry{Path: path, Label: i18n.T(ctx, "admin.users.enable"), Icon: icon.UserCheck})
		} else {
			entries = append(entries, adminUserMenuEntry{Path: path, Label: i18n.T(ctx, "admin.users.disable"), Icon: icon.UserX})
		}
	}
	if path := user.Path(AdminUserActionDeletion); path != "" {
		label := i18n.T(ctx, "admin.delete.button")
		if user.DeletionPending {
			label = i18n.T(ctx, "admin.delete.retry")
		}
		entries = append(entries, adminUserMenuEntry{Path: path, Label: label, Icon: icon.Trash2, Destructive: true})
	}
	return entries
}

// adminUserMenuItemAttributes make a menu entry fetch its dialog with htmx.
// Without htmx, its link opens the page with the dialog.
func adminUserMenuItemAttributes(path string) templ.Attributes {
	return templ.Attributes{"hx-get": path, "hx-target": "#" + adminUserDialogSlotID, "hx-swap": "innerHTML"}
}

func adminUserMenuItemClass(destructive bool) string {
	if destructive {
		return "justify-start gap-2 text-destructive hover:text-destructive focus:text-destructive"
	}
	return "justify-start gap-2"
}

func adminUserUsername(ctx context.Context, username string) string {
	if strings.TrimSpace(username) == "" {
		return i18n.T(ctx, "admin.users.no_username")
	}
	return username
}

func adminUserInvitationFieldError(data AdminUserInvitationFormData, field string) string {
	if data.FieldErrors == nil {
		return ""
	}
	return data.FieldErrors[field]
}

func adminUserInvitationFormOpen(data AdminUserInvitationFormData) bool {
	return len(data.FieldErrors) != 0 || strings.TrimSpace(data.Name) != "" ||
		strings.TrimSpace(data.Username) != ""
}

func adminUserInvitationCopyText(ctx context.Context, data *AdminUserInvitationData) string {
	if data == nil {
		return ""
	}
	return i18n.T(ctx, "admin.invite.copy_text", "username", data.Username, "url", data.RedemptionURL, "token", data.Token, "expires", adminDateTimeZone(ctx, data.ExpiresAt))
}

func adminUserCredentialResetCopyText(ctx context.Context, data *AdminUserCredentialResetData) string {
	if data == nil {
		return ""
	}
	return i18n.T(ctx, "admin.reset.copy_text", "username", data.Username, "url", data.RedemptionURL, "token", data.Token, "expires", adminDateTimeZone(ctx, data.ExpiresAt))
}

func adminUserInvitationStateLabel(ctx context.Context, state string) string {
	switch state {
	case "active":
		return i18n.T(ctx, "admin.invite.state.active")
	case "expired":
		return i18n.T(ctx, "admin.invite.state.expired")
	case "revoked":
		return i18n.T(ctx, "admin.invite.state.revoked")
	default:
		return i18n.T(ctx, "admin.invite.state.none")
	}
}

func adminUserInvitationDialogID(prefix string, user AdminUserData) string {
	reference := strings.TrimSuffix(
		strings.TrimPrefix(user.InvitationRotatePath, "/admin/users/invitations/"),
		"/rotate",
	)
	return prefix + "-" + user.InvitationState + "-" + reference
}

templ AdminUsersPage(data AdminUsersData, verification ...AdminSecurityVerificationData) {
	<div
		class="flex-1 flex flex-col min-w-0 overflow-hidden"
		data-admin-users
		if adminSecurityVerificationValue(verification).Required {
			hx-headers={ adminVerificationOnPageHeaders }
		}
	>
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
					<div>
						<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.users") }</h2>
						<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.users.description") }</p>
					</div>
					<div class="flex flex-wrap items-center gap-2">
						@dialog.Trigger(dialog.TriggerProps{For: "admin-user-invitation-dialog"}) {
							@button.Button() {
								@icon.UserPlus(icon.Props{Class: "size-4"})
								{ i18n.T(ctx, "admin.users.invite") }
							}
						}
						<span class="w-fit shrink-0 rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{ i18n.N(ctx, "admin.users.count", data.Total, "count", i18n.Number(ctx, data.Total)) }</span>
					</div>
				</div>
				@AdminUserInvitationDialog(data)
				if data.Invitation != nil {
					@AdminUserInvitationResultDialog(data.Invitation)
				}
				if data.CredentialReset != nil {
					@AdminUserCredentialResetResultDialog(data.CredentialReset)
				}
				<div id={ adminUserDialogSlotID }>
					if data.Dialog != nil {
						@AdminUserActionDialog(*data.Dialog)
					}
				</div>
				<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label={ i18n.T(ctx, "admin.users.summary") }>
					<div class="rounded-lg border border-border bg-card px-4 py-3">
						<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "admin.users.stat.active") }</p>
						<p class="mt-1 text-xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, data.Active) }</p>
					</div>
					<div class="rounded-lg border border-border bg-card px-4 py-3">
						<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "admin.users.stat.pending") }</p>
						<p class="mt-1 text-xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, data.Pending) }</p>
					</div>
					<div class="rounded-lg border border-border bg-card px-4 py-3">
						<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "admin.users.stat.disabled") }</p>
						<p class="mt-1 text-xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, data.Disabled) }</p>
					</div>
					<div class="rounded-lg border border-border bg-card px-4 py-3">
						<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "admin.users.stat.admins") }</p>
						<p class="mt-1 text-xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, data.Administrators) }</p>
					</div>
				</div>
				<section class="mt-6 overflow-hidden rounded-lg border border-border bg-card" aria-labelledby="admin-users-heading">
					<div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3">
						<h3 id="admin-users-heading" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.users.heading") }</h3>
						<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.users.heading_detail") }</span>
					</div>
					if len(data.Users) == 0 {
						<div class="px-4 py-10 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "admin.users.empty") }</div>
					} else {
						<div class="overflow-x-auto">
							<table class="w-full min-w-[70rem] text-left text-sm">
								<thead class="bg-muted/45 text-xs font-semibold text-muted-foreground">
									<tr>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.user") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.status") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.role") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.mfa") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.invitation") }</th>
										<th scope="col" class="px-4 py-3 text-right">{ i18n.T(ctx, "admin.col.actions") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.user_id") }</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-border">
									for _, user := range data.Users {
										<tr class="bg-background/35 align-top hover:bg-accent/35">
											<td class="px-4 py-3">
												<div class="flex flex-wrap items-center gap-2">
													<span class="whitespace-nowrap font-semibold text-foreground">{ adminUserUsername(ctx, user.Username) }</span>
													if user.Current {
														<span class="rounded-full border border-primary/25 bg-primary/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-primary">{ i18n.T(ctx, "admin.users.you") }</span>
													}
												</div>
											</td>
											<td class="px-4 py-3">
												<span
													class={
														"inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold",
														templ.KV("border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200", user.Status == "active"),
														templ.KV("border-amber-500/30 bg-amber-500/10 text-amber-800 dark:text-amber-200", user.Status == "pending"),
														templ.KV("border-destructive/30 bg-destructive/10 text-destructive", user.Status == "disabled"),
													}
												>
													if user.DeletionPending {
														{ i18n.T(ctx, "admin.users.deleting") }
													} else {
														{ adminValueLabel(ctx, user.Status) }
													}
												</span>
												if user.PasswordChangeRequired {
													<p class="mt-2">
														<span class="inline-flex whitespace-nowrap rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "admin.users.password_change_required") }</span>
													</p>
												}
												if user.PasswordResetRequestedAt != nil {
													<p class="mt-2">
														<span class="inline-flex whitespace-nowrap rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "admin.users.reset_requested") }</span>
													</p>
													<p class="mt-1 whitespace-nowrap text-xs text-muted-foreground">{ i18n.T(ctx, "admin.users.requested_at", "date", i18n.Dates(ctx).ShortDateTime(user.PasswordResetRequestedAt.Local())) }</p>
												}
											</td>
											<td class="px-4 py-3">
												<span
													class={
														"inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold",
														templ.KV("border-primary/30 bg-primary/10 text-primary", user.Role == "management_admin"),
														templ.KV("border-border bg-muted text-muted-foreground", user.Role == "management_user"),
													}
												>{ adminValueLabel(ctx, user.Role) }</span>
											</td>
											<td class="px-4 py-3">
												<span
													class={
														"inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold",
														templ.KV("border-primary/30 bg-primary/10 text-primary", user.MFALabel == "required"),
														templ.KV("border-border bg-muted text-muted-foreground", user.MFALabel != "required"),
													}
												>{ adminValueLabel(ctx, user.MFALabel) }</span>
												<p class="mt-1 whitespace-nowrap text-xs text-muted-foreground">{ adminValueLabel(ctx, user.MFADetail) }</p>
											</td>
											<td class="px-4 py-3">
												if user.InvitationRotatePath == "" {
													<span class="text-xs text-muted-foreground">—</span>
												} else {
													<span
														class={
															"inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold",
															templ.KV("border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200", user.InvitationState == "active"),
															templ.KV("border-amber-500/30 bg-amber-500/10 text-amber-800 dark:text-amber-200", user.InvitationState == "expired"),
															templ.KV("border-destructive/30 bg-destructive/10 text-destructive", user.InvitationState == "revoked"),
															templ.KV("border-border bg-muted text-muted-foreground", user.InvitationState == "not_issued"),
														}
													>{ adminUserInvitationStateLabel(ctx, user.InvitationState) }</span>
													if user.InvitationExpiresAt != nil {
														<p class="mt-1 whitespace-nowrap text-xs text-muted-foreground">
															if user.InvitationState == "active" {
																{ i18n.T(ctx, "admin.invite.expires", "date", i18n.Dates(ctx).ShortDateTime(user.InvitationExpiresAt.Local())) }
															} else {
																{ i18n.T(ctx, "admin.invite.expired_at", "date", i18n.Dates(ctx).ShortDateTime(user.InvitationExpiresAt.Local())) }
															}
														</p>
													}
												}
											</td>
											<td class="px-4 py-3 text-right">
												if entries := adminUserMenuEntries(ctx, user); len(entries) == 0 {
													<span class="text-xs text-muted-foreground">—</span>
												} else {
													@adminUserActionsMenu(user, entries)
												}
											</td>
											<td class="px-4 py-3"><code class="break-all font-mono text-xs text-muted-foreground">{ user.ID }</code></td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
				<p class="mt-4 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.users.privacy") }</p>
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

// adminUserActionsMenu is the ⋮ menu of what the administrator can do to
// user, each entry leading to its action's dialog.
templ adminUserActionsMenu(user AdminUserData, entries []adminUserMenuEntry) {
	@dropdown.Dropdown() {
		@dropdown.Trigger() {
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeIcon,
				Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "admin.users.actions_for", "user", adminUserUsername(ctx, user.Username))},
			}) {
				@icon.EllipsisVertical(icon.Props{Class: "size-4"})
			}
		}
		@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "w-max min-w-48 whitespace-nowrap"}) {
			for index, entry := range entries {
				if entry.Destructive && index > 0 {
					@dropdown.Separator()
				}
				if entry.Disabled {
					@dropdown.Item(dropdown.ItemProps{Disabled: true, Class: adminUserMenuItemClass(entry.Destructive)}) {
						@adminUserMenuItemLabel(entry)
					}
				} else {
					@dropdown.Item(dropdown.ItemProps{
						Href:       entry.Path,
						Class:      adminUserMenuItemClass(entry.Destructive),
						Attributes: adminUserMenuItemAttributes(entry.Path),
					}) {
						@adminUserMenuItemLabel(entry)
					}
				}
			}
		}
	}
}

templ adminUserMenuItemLabel(entry adminUserMenuEntry) {
	<span class={ "inline-flex", templ.KV("text-muted-foreground", !entry.Destructive) } aria-hidden="true">
		@entry.Icon(icon.Props{Class: "size-4"})
	</span>
	{ entry.Label }
}

// AdminUserActionDialog is one action's dialog for one person, open. htmx
// puts it in the page's dialog slot when the administrator picks the
// action, and the page renders it there when asked for at its address. The
// verification, when given, is the one sending the change will ask for.
templ AdminUserActionDialog(d AdminUserDialog, verification ...AdminSecurityVerificationData) {
	switch d.Action {
		case AdminUserActionMFAPolicy:
			@adminUserMFAPolicyDialog(d.User, d.CSRFToken)
		case AdminUserActionStatus:
			@adminUserStatusDialog(d.User, d.CSRFToken)
		case AdminUserActionCredentialReset:
			@adminUserCredentialResetDialog(d.User, d.CSRFToken)
		case AdminUserActionRequiredChange:
			@adminUserRequiredChangeDialog(d.User, d.CSRFToken)
		case AdminUserActionDeletion:
			@adminUserDeletionDialog(d.User, d.CSRFToken)
		case AdminUserActionInvitationRevoke:
			@adminUserInvitationRevokeDialog(d.User, d.CSRFToken)
		case AdminUserActionInvitationRotate:
			@adminUserInvitationRotateDialog(d.User, d.CSRFToken)
	}
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

func adminUserMFAPolicyDialogID(user AdminUserData) string {
	return "admin-user-mfa-policy-" + strings.NewReplacer("/", "-", " ", "-").Replace(user.ID)
}

func adminUserMFAPolicyButtonVariant(user AdminUserData) button.Variant {
	if user.MFARequired {
		return button.VariantDestructive
	}
	return button.VariantDefault
}

templ adminUserMFAPolicyDialog(user AdminUserData, csrfToken string) {
	@dialog.Dialog(dialog.Props{ID: adminUserMFAPolicyDialogID(user), Open: true}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					if user.MFARequired {
						{ i18n.T(ctx, "admin.mfa.clear_title") }
					} else {
						{ i18n.T(ctx, "admin.mfa.require_title", "user", adminUserUsername(ctx, user.Username)) }
					}
				}
				@dialog.Description() {
					if user.MFARequired {
						{ i18n.T(ctx, "admin.mfa.clear_detail") }
					} else {
						{ i18n.T(ctx, "admin.mfa.require_detail") }
					}
				}
			}
			<form method="post" action={ user.MFAPolicyPath } data-step-up>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<input type="hidden" name="required" value={ fmt.Sprintf("%t", !user.MFARequired) }/>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: adminUserMFAPolicyButtonVariant(user)}) {
						if user.MFARequired {
							{ i18n.T(ctx, "admin.mfa.clear") }
						} else {
							{ i18n.T(ctx, "admin.mfa.require") }
						}
					}
				}
			</form>
		}
	}
}

