// adminUserInvitationRotateDialog replaces a working invitation, or issues
// a new one when the last expired or was revoked.
templ adminUserInvitationRotateDialog(user AdminUserData, csrfToken string) {
	@dialog.Dialog(dialog.Props{ID: adminUserInvitationDialogID("admin-invitation-rotate", user), Open: true}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					if user.InvitationState == "active" {
						{ i18n.T(ctx, "admin.invite.rotate_title") }
					} else {
						{ i18n.T(ctx, "admin.invite.issue_title", "user", adminUserUsername(ctx, user.Username)) }
					}
				}
				@dialog.Description() {
					if user.InvitationState == "active" {
						{ i18n.T(ctx, "admin.invite.rotate_detail", "user", adminUserUsername(ctx, user.Username)) }
					} else {
						{ i18n.T(ctx, "admin.invite.issue_detail", "user", adminUserUsername(ctx, user.Username)) }
					}
				}
			}
			<form method="post" action={ user.InvitationRotatePath } data-step-up>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						if user.InvitationState == "active" {
							{ i18n.T(ctx, "admin.invite.rotate_button") }
						} else {
							{ i18n.T(ctx, "admin.invite.issue_button") }
						}
					}
				}
			</form>
		}
	}
}

func adminUserStatusDialogID(user AdminUserData) string {
	return "admin-user-status-" + strings.NewReplacer("/", "-", " ", "-").Replace(user.ID)
}

templ adminUserStatusDialog(user AdminUserData, csrfToken string) {
	@dialog.Dialog(dialog.Props{ID: adminUserStatusDialogID(user), Open: true}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					if user.Status == "disabled" {
						{ i18n.T(ctx, "admin.users.enable_title", "user", adminUserUsername(ctx, user.Username)) }
					} else {
						{ i18n.T(ctx, "admin.users.disable_title", "user", adminUserUsername(ctx, user.Username)) }
					}
				}
				@dialog.Description() {
					if user.Status == "disabled" {
						{ i18n.T(ctx, "admin.users.enable_detail") }
					} else {
						{ i18n.T(ctx, "admin.users.disable_detail") }
					}
				}
			}
			<form method="post" action={ user.StatusPath } data-step-up>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				if user.Status == "disabled" {
					<input type="hidden" name="status" value="active"/>
				} else {
					<input type="hidden" name="status" value="disabled"/>
				}
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					if user.Status == "disabled" {
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							{ i18n.T(ctx, "admin.users.enable_button") }
						}
					} else {
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
							{ i18n.T(ctx, "admin.users.disable_button") }
						}
					}
				}
			</form>
		}
	}
}

func adminUserDeletionDialogID(user AdminUserData) string {
	return "admin-user-delete-" + strings.NewReplacer("/", "-", " ", "-").Replace(user.ID)
}

templ adminUserDeletionDialog(user AdminUserData, csrfToken string) {
	{{ deletionDialogID := adminUserDeletionDialogID(user) }}
	@dialog.Dialog(dialog.Props{ID: deletionDialogID, Open: true}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.delete.title", "user", adminUserUsername(ctx, user.Username)) }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.delete.description") }
				}
			}
			<div class="space-y-4 text-sm text-foreground">
				<div class="rounded-lg border border-destructive/25 bg-destructive/5 px-4 py-3">
					<p class="font-semibold text-destructive">{ i18n.T(ctx, "admin.delete.removes") }</p>
					<ul class="mt-2 list-disc space-y-1 pl-5 text-muted-foreground">
						<li>{ i18n.T(ctx, "admin.delete.removes_signin") }</li>
						<li>{ i18n.T(ctx, "admin.delete.removes_mailboxes") }</li>
						<li>{ i18n.T(ctx, "admin.delete.removes_data") }</li>
					</ul>
				</div>
				<div class="rounded-lg border border-border bg-muted/35 px-4 py-3 text-muted-foreground">
					<p><span class="font-semibold text-foreground">{ i18n.T(ctx, "admin.delete.remote_title") }</span> { i18n.T(ctx, "admin.delete.remote") }</p>
					<p class="mt-2">{ i18n.T(ctx, "admin.delete.audit") }</p>
				</div>
				<div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-amber-900 dark:text-amber-100">
					<p class="font-semibold">{ i18n.T(ctx, "admin.delete.backup_title") }</p>
					<p class="mt-1">{ i18n.T(ctx, "admin.delete.backup") }</p>
				</div>
			</div>
			<form method="post" action={ user.DeletionPath } data-step-up class="mt-5">
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				<label for={ deletionDialogID + "-confirmation" } class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.delete.confirm_before") } <code class="font-mono">{ user.Username }</code> { i18n.T(ctx, "admin.delete.confirm_after") }</label>
				<input
					id={ deletionDialogID + "-confirmation" }
					name="confirmation"
					type="text"
					autocomplete="off"
					autocapitalize="none"
					spellcheck="false"
					required
					class="mt-2 flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 font-mono text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
				/>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						if user.DeletionPending {
							{ i18n.T(ctx, "admin.delete.retry_button") }
						} else {
							{ i18n.T(ctx, "admin.delete.submit") }
						}
					}
				}
			</form>
		}
	}
}

func adminUserCredentialResetDialogID(user AdminUserData) string {
	return "admin-user-credential-reset-" + strings.NewReplacer("/", "-", " ", "-").Replace(user.ID)
