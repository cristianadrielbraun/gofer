templ adminUserRequiredChangeDialog(user AdminUserData, csrfToken string) {
	@dialog.Dialog(dialog.Props{ID: "admin-user-required-change-" + user.ID, Open: true}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.required_change.title", "user", adminUserUsername(ctx, user.Username)) }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.required_change.detail") }
				}
			}
			<form method="post" action={ user.RequiredChangePath } data-step-up>
				<input type="hidden" name="_csrf" value={ csrfToken }/>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Disabled: user.PasswordChangeRequired}) {
						{ i18n.T(ctx, "admin.required_change.submit") }
					}
				}
			</form>
		}
	}
}

templ AdminUserInvitationDialog(data AdminUsersData) {
	@dialog.Dialog(dialog.Props{ID: "admin-user-invitation-dialog", Open: !data.StepUpRequired && adminUserInvitationFormOpen(data.InvitationForm)}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-xl max-h-[calc(100vh-2rem)]"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.invite.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.invite.description") }
				}
			}
			<form method="post" action="/admin/users/invitations" class="space-y-4" data-step-up>
				if data.InvitationCSRFToken != "" {
					<input type="hidden" name="_csrf" value={ data.InvitationCSRFToken }/>
				}
				<div class="space-y-1.5">
					<label for="admin-invitation-name" class="block text-sm font-semibold text-foreground">{ i18n.T(ctx, "compose.from.display_name") }</label>
					<input
						id="admin-invitation-name"
						name="name"
						type="text"
						value={ data.InvitationForm.Name }
						maxlength="100"
						required
						autocomplete="off"
						if adminUserInvitationFieldError(data.InvitationForm, "name") != "" {
							aria-invalid="true"
							aria-describedby="admin-invitation-name-error"
						}
						class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30 aria-[invalid=true]:border-destructive"
					/>
					if fieldError := adminUserInvitationFieldError(data.InvitationForm, "name"); fieldError != "" {
						<p id="admin-invitation-name-error" class="text-xs font-medium text-destructive">{ fieldError }</p>
					}
				</div>
				<div class="space-y-1.5">
					<div class="space-y-1.5">
						<label for="admin-invitation-username" class="block text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.invite.username") }</label>
						<input
							id="admin-invitation-username"
							name="username"
							type="text"
							value={ data.InvitationForm.Username }
							minlength="3"
							maxlength="32"
							required
							autocomplete="off"
							autocapitalize="none"
							spellcheck="false"
							if adminUserInvitationFieldError(data.InvitationForm, "username") != "" {
								aria-invalid="true"
								aria-describedby="admin-invitation-username-help admin-invitation-username-error"
							} else {
								aria-describedby="admin-invitation-username-help"
							}
							class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30 aria-[invalid=true]:border-destructive"
						/>
						<p id="admin-invitation-username-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.invite.username_help") }</p>
						if fieldError := adminUserInvitationFieldError(data.InvitationForm, "username"); fieldError != "" {
							<p id="admin-invitation-username-error" class="text-xs font-medium text-destructive">{ fieldError }</p>
						}
					</div>
				</div>
				<div class="rounded-md border border-border bg-muted/35 px-3 py-2.5 text-xs leading-relaxed text-muted-foreground">
					{ i18n.T(ctx, "admin.invite.note") }
				</div>
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: "admin-user-invitation-dialog"}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Disabled: data.InvitationCSRFToken == ""}) {
						@icon.UserPlus(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "admin.invite.create") }
					}
				}
			</form>
		}
	}
}

templ AdminUserInvitationResultDialog(data *AdminUserInvitationData) {
	@dialog.Dialog(dialog.Props{ID: "admin-user-invitation-result-dialog", Open: true, DisableClickAway: true, DisableESC: true}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-xl max-h-[calc(100vh-2rem)]"}) {
			@dialog.Header() {
				@dialog.Title() {
					if data.Rotated {
						{ i18n.T(ctx, "admin.invite.rotated") }
					} else {
						{ i18n.T(ctx, "admin.invite.created") }
					}
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.token.copy_now") }
				}
			}
			<div role="status" class="rounded-md border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-200">
				<p class="font-semibold">
					if data.Rotated {
						{ i18n.T(ctx, "admin.invite.ready", "username", data.Username) }
					} else {
						{ i18n.T(ctx, "admin.invite.pending", "username", data.Username) }
					}
				</p>
				<p class="mt-1 text-xs">{ i18n.T(ctx, "admin.invite.name_expires", "name", data.Name, "date", adminDateTimeZone(ctx, data.ExpiresAt)) }</p>
			</div>
			<div class="space-y-2">
				<div class="flex items-center justify-between gap-3">
					<label for="admin-user-invitation-details" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.invite.details") }</label>
					<div class="flex items-center gap-1 text-xs text-muted-foreground">
						<span data-copy-tooltip-text>{ i18n.T(ctx, "admin.token.copy_details") }</span>
						@copybutton.CopyButton(copybutton.Props{
							TargetID: "admin-user-invitation-details",
							Attrs:    templ.Attributes{"aria-label": i18n.T(ctx, "admin.invite.copy_label")},
						})
					</div>
				</div>
				<textarea id="admin-user-invitation-details" readonly rows="6" class="w-full resize-none rounded-md border border-border bg-background px-3 py-2 font-mono text-xs leading-relaxed text-foreground outline-none">{ adminUserInvitationCopyText(ctx, data) }</textarea>
			</div>
			<div class="rounded-md border border-amber-500/25 bg-amber-500/10 px-3 py-2.5 text-xs leading-relaxed text-amber-900 dark:text-amber-100">
				{ i18n.T(ctx, "admin.invite.send_note") }
			</div>
			@dialog.Footer() {
				@dialog.Close(dialog.CloseProps{For: "admin-user-invitation-result-dialog"}) {
					@button.Button() {
						{ i18n.T(ctx, "admin.invite.saved") }
					}
				}
			}
		}
	}
}

templ AdminUserCredentialResetResultDialog(data *AdminUserCredentialResetData) {
	@dialog.Dialog(dialog.Props{ID: "admin-user-credential-reset-result-dialog", Open: true, DisableClickAway: true, DisableESC: true}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-xl max-h-[calc(100vh-2rem)]"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.reset.created") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.token.copy_now") }
				}
			}
			<div role="status" class="rounded-md border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-200">
				<p class="font-semibold">{ i18n.T(ctx, "admin.reset.ready", "username", data.Username) }</p>
				<p class="mt-1 text-xs">{ i18n.T(ctx, "admin.invite.expires", "date", adminDateTimeZone(ctx, data.ExpiresAt)) }</p>
			</div>
			<div class="space-y-2">
				<div class="flex items-center justify-between gap-3">
					<label for="admin-user-credential-reset-details" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.reset.details") }</label>
					<div class="flex items-center gap-1 text-xs text-muted-foreground">
						<span data-copy-tooltip-text>{ i18n.T(ctx, "admin.token.copy_details") }</span>
						@copybutton.CopyButton(copybutton.Props{
							TargetID: "admin-user-credential-reset-details",
							Attrs:    templ.Attributes{"aria-label": i18n.T(ctx, "admin.reset.copy_label")},
						})
					</div>
				</div>
				<textarea id="admin-user-credential-reset-details" readonly rows="6" class="w-full resize-none rounded-md border border-border bg-background px-3 py-2 font-mono text-xs leading-relaxed text-foreground outline-none">{ adminUserCredentialResetCopyText(ctx, data) }</textarea>
			</div>
			<div class="rounded-md border border-amber-500/25 bg-amber-500/10 px-3 py-2.5 text-xs leading-relaxed text-amber-900 dark:text-amber-100">
				{ i18n.T(ctx, "admin.reset.send_note") }
			</div>
			@dialog.Footer() {
				@dialog.Close(dialog.CloseProps{For: "admin-user-credential-reset-result-dialog"}) {
					@button.Button() {
						{ i18n.T(ctx, "admin.reset.saved") }
					}
				}
			}
		}
	}
}
