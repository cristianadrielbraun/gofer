package views

import "github.com/cristianadrielbraun/gofer/internal/i18n"

import (
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/collapsible"
	"github.com/cristianadrielbraun/gofer/components/datepicker"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/popover"
	"github.com/cristianadrielbraun/gofer/components/progress"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	"github.com/cristianadrielbraun/gofer/components/timepicker"
	"github.com/cristianadrielbraun/gofer/components/toast"
	"github.com/cristianadrielbraun/gofer/components/tooltip"
	"github.com/cristianadrielbraun/gofer/internal/models"
	"strconv"
	"time"
)

templ CalendarLayout(accounts []models.Account, month CalendarMonthData, uiSettings map[string]string) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class={ themeClass(uiSettings) } data-theme={ themeStyle(uiSettings) } { themeLookAttributes(uiSettings)... }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "page.title", "page", i18n.T(ctx, "app.calendar")) }</title>
			@AppIcon()
			@FontFaces()
			@SavedPanelSizeStyle()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			@ThemeColorsStyle(uiSettings)
			@dialog.Script()
			@dropdown.Script()
			@popover.Script()
			@datepicker.Script()
			@timepicker.Script()
			@toast.Script()
			@collapsible.Script()
			@selectbox.Script()
			@progress.Script()
			@SettingsComponentScripts()
			@AppSidebarResponsiveStyle()
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk" data-ui-settings={ uiSettingsJSON(uiSettings) }>
			@CalendarShell(accounts, month, uiSettings)
			<div id="app-pane-dialogs"></div>
			@ComposeDialog(accounts)
			@CalendarLoadingTemplates(accounts, uiSettings)
			@AppSwitchSidebarTemplates(accounts, uiSettings)
			@AppSwitchEmptyPaneTemplates()
			@AppNavigationTemplates(uiSettings)
			@AppNavigationDialogs()
			<script src={ assetver.URL("/assets/js/htmx.min.js") }></script>
			<script src={ assetver.URL("/assets/js/mail-search.js") }></script>
			<script src={ assetver.URL("/assets/js/virtual-scroll.js") }></script>
			<script src={ assetver.URL("/assets/js/app.js") }></script>
			<script src={ assetver.URL("/assets/js/settings.js") }></script>
			<script src={ assetver.URL("/assets/js/settings-page.js") }></script>
			<script src={ assetver.URL("/assets/js/ui-settings.js") }></script>
			<script src={ assetver.URL("/assets/js/resize.js") }></script>
			@AppNavigationScripts()
			@AppDialogs()
		</body>
	</html>
}

templ CalendarShell(accounts []models.Account, month CalendarMonthData, uiSettings map[string]string) {
	<div id="app-shell" class="app-shell flex h-screen overflow-hidden">
		@MobileTopBar()
		@CalendarSidebar(accounts, PanelSetting(uiSettings, "calendar", "sidebar_width", "256px"))
		@ResizeHandle("sidebar")
		@CalendarPage(month, uiSettings)
	</div>
}

templ CalendarSidebar(accounts []models.Account, width string) {
	<aside class="app-drawer flex flex-col surface-leather text-sidebar-foreground h-full overflow-hidden" style={ "width:" + width } data-app-sidebar>
		@SidebarHeader(accounts, "calendar")
		@CalendarSidebarBody(accounts)
		@SidebarFooter()
	</aside>
}

templ CalendarSidebarBody(accounts []models.Account) {
	@CalendarSidebarContent(accounts, false)
}

templ CalendarSidebarContent(accounts []models.Account, loading bool) {
	{{ configuredAccounts := calendarConfiguredAccounts(accounts) }}
	<div id="sidebar-app-body" class="flex min-h-0 flex-1 flex-col" data-sidebar-app-body="calendar" aria-busy={ strconv.FormatBool(loading) } inert?={ loading }>
		<div class="px-4 pb-4" data-sidebar-create>
			<div class="inline-flex w-full items-stretch rounded-lg shadow-sm">
				<button type="button" disabled?={ loading } data-calendar-create-trigger hx-get="/api/calendar/events/new" hx-target="#app-pane-dialogs" hx-swap="innerHTML" hx-sync="#app-pane-dialogs:replace" hx-disabled-elt="this" class="btn-skeuo flex h-10 min-w-0 flex-1 cursor-pointer items-center justify-center gap-2 rounded-l-lg rounded-r-none text-sm font-semibold text-sidebar-primary-foreground disabled:cursor-wait disabled:opacity-50" aria-haspopup="dialog" aria-controls="calendar-create-dialog">
					@icon.CalendarPlus(icon.Props{Class: "size-4"})
					<span>{ i18n.T(ctx, "calendar.new_event") }</span>
				</button>
				@dropdown.Dropdown() {
					@dropdown.Trigger() {
						<button type="button" disabled?={ loading } class="btn-skeuo inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-l-none rounded-r-lg border-l border-sidebar-border/70 text-sidebar-primary-foreground disabled:opacity-50" aria-label={ i18n.T(ctx, "calendar.actions") }>
							@icon.EllipsisVertical(icon.Props{Class: "size-4"})
						</button>
					}
					@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "w-max min-w-48 whitespace-nowrap normal-case tracking-normal"}) {
						@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "button", "data-calendar-import-open": ""}}) {
							<span class="inline-flex text-muted-foreground">
								@icon.Upload(icon.Props{Class: "size-4"})
							</span>
							{ i18n.T(ctx, "calendar.import.menu") }
						}
						@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "button", "data-calendar-export-open": ""}}) {
							<span class="inline-flex text-muted-foreground">
								@icon.Download(icon.Props{Class: "size-4"})
							</span>
							{ i18n.T(ctx, "calendar.export.menu") }
						}
						@dropdown.Separator()
						@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "button", "data-calendar-subscription-add": ""}}) {
							<span class="inline-flex text-muted-foreground">
								@icon.Rss(icon.Props{Class: "size-4"})
							</span>
							{ i18n.T(ctx, "calendar.subscription.menu") }
						}
					}
				}
			</div>
			@CalendarImportDialog(accounts)
			@CalendarExportDialog(accounts)
			@CalendarSubscriptionDialog()
		</div>
		<hr class="divider-etched mx-4"/>
		<nav class="flex min-h-0 flex-1 flex-col overflow-y-auto px-3 pt-3 pb-3">
			<div class="px-2.5 pb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-sidebar-foreground">{ i18n.T(ctx, "calendar.connected_accounts") }</div>
			if len(configuredAccounts) == 0 {
				<div class="rounded-md border border-sidebar-border/60 bg-sidebar-accent/20 px-2.5 py-3 text-[11px] leading-relaxed text-sidebar-foreground">
					<p>{ i18n.T(ctx, "calendar.no_accounts") }</p>
					<a href="/settings/accounts" class="mt-2 inline-flex items-center gap-1.5 font-semibold text-sidebar-primary hover:text-sidebar-accent-foreground">
						{ i18n.T(ctx, "calendar.open_account_setup") }
						@icon.ChevronRight(icon.Props{Class: "size-3"})
					</a>
				</div>
			} else {
				for _, account := range configuredAccounts {
					<div class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-[13px] text-sidebar-foreground">
						<div class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(account.Color) }></div>
						<div class="min-w-0 flex-1">
							<div class="truncate font-medium">{ calendarAccountName(ctx, account) }</div>
							<div class="truncate text-[11px] text-sidebar-foreground">{ i18n.T(ctx, "calendar.account_kind", "provider", calendarAccountProviderLabel(account)) }</div>
						</div>
					</div>
					<div class="mb-2 space-y-0.5" role="group" aria-label={ i18n.T(ctx, "calendar.calendars_for", "account", calendarAccountName(ctx, account)) }>
						for _, source := range account.CalendarSources {
							@calendarSourceRow(account, source, loading)
						}
					</div>
					if len(account.OtherCalendarSources) > 0 {
						@CalendarOtherSources(account, loading)
					}
				}
			}
			if subscriptions, home := calendarSubscriptions(accounts); len(subscriptions) > 0 {
				<div class="flex items-center gap-2.5 rounded-md py-2 pl-2.5 pr-2.5 text-[13px] text-sidebar-foreground" data-calendar-subscriptions>
					<span class="inline-flex size-2.5 shrink-0 items-center justify-center text-sidebar-foreground">
						@icon.Rss(icon.Props{Class: "size-3"})
					</span>
					<div class="min-w-0 flex-1">
						<div class="truncate font-medium">{ i18n.T(ctx, "calendar.subscription.title") }</div>
						<div class="truncate text-[11px] text-sidebar-foreground">{ i18n.T(ctx, "calendar.subscription.kind") }</div>
					</div>
					@tooltip.Tooltip() {
						@tooltip.Trigger() {
							@button.Button(button.Props{
								Variant:  button.VariantGhost,
								Size:     button.SizeIcon,
								Class:    "size-6 shrink-0 rounded text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
								Disabled: loading,
								Attributes: templ.Attributes{
									"data-calendar-subscription-add": "",
									"aria-label":                     i18n.T(ctx, "calendar.subscription.add"),
								},
							}) {
								@icon.Plus(icon.Props{Class: "size-3.5"})
							}
						}
						@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionRight, ShowArrow: true}) {
							{ i18n.T(ctx, "calendar.subscription.add") }
						}
					}
				</div>
				<div class="mb-2 space-y-0.5" role="group" aria-label={ i18n.T(ctx, "calendar.subscription.title") }>
					for _, source := range subscriptions {
						@calendarSourceRow(home, source, loading)
					}
				</div>
			}
		</nav>
	</div>
}

// calendarSourceRow is one synced calendar in the sidebar: its visibility
// checkbox, color, name, menu and refresh state.
templ calendarSourceRow(account models.Account, source models.AccountCalendarSource, loading bool) {
	<label class="group flex min-h-8 cursor-pointer items-center gap-2.5 rounded-md py-1.5 pl-7 pr-2.5 text-[12px] text-sidebar-foreground transition-colors hover:bg-sidebar-accent/60 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-sidebar-ring" data-calendar-source-row>
		<span class="inline-flex shrink-0">
			@checkbox.Checkbox(checkbox.Props{
				ID:      "calendar-visible-" + source.ID,
				Checked: !source.IsHidden, Disabled: loading,
				Class: "size-3.5 border-sidebar-border checked:border-sidebar-primary checked:bg-sidebar-primary",
				Attributes: templ.Attributes{
					"data-calendar-visibility":    source.ID,
					"data-calendar-source-id":     source.ID,
					"data-calendar-source-hidden": strconv.FormatBool(source.IsHidden),
					"aria-label":                  i18n.T(ctx, "calendar.source.show", "calendar", calendarSourceDisplayName(ctx, source)),
				},
			})
		</span>
		<span class="size-2 shrink-0 rounded-full" style={ calendarEventColorStyle(CalendarEvent{SourceColor: source.Color}) }></span>
		<span class={ "min-w-0 flex-1 truncate", templ.KV("opacity-50", source.IsHidden) } data-calendar-source-name title={ calendarSourceDisplayName(ctx, source) }>{ calendarSourceDisplayName(ctx, source) }</span>
		// Its menu: show only this calendar (or all of them again when it
		// already is the only one shown), or stop syncing it; a
		// subscription's is changed or removed instead. Appears on hover or
		// keyboard focus, and stays while the menu is open.
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				<button type="button" disabled?={ loading } data-calendar-source-menu={ source.ID } aria-label={ i18n.T(ctx, "calendar.source.options", "calendar", calendarSourceDisplayName(ctx, source)) } class="inline-flex size-6 shrink-0 items-center justify-center rounded text-sidebar-foreground opacity-0 transition-opacity hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:opacity-100 group-hover:opacity-100 aria-expanded:opacity-100 disabled:pointer-events-none">
					@icon.Ellipsis(icon.Props{Class: "size-3.5"})
				</button>
			}
			@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "w-52 normal-case tracking-normal"}) {
				@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "button", "data-calendar-visibility-only": source.ID}}) {
					<span class="inline-flex text-muted-foreground" data-calendar-only-icon="only">
						@icon.Focus(icon.Props{Class: "size-4"})
					</span>
					<span class="inline-flex text-muted-foreground" data-calendar-only-icon="all" hidden>
						@icon.Eye(icon.Props{Class: "size-4"})
					</span>
					<span data-calendar-only-tooltip={ source.ID }>{ i18n.T(ctx, "calendar.source.show_only") }</span>
				}
				if source.Provider == "ics" {
					// A subscription is changed and removed only in Gofer.
					@dropdown.Separator()
					@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: calendarSubscriptionEditAttributes(source)}) {
						<span class="inline-flex text-muted-foreground">
							@icon.Pencil(icon.Props{Class: "size-4"})
						</span>
						{ i18n.T(ctx, "calendar.subscription.edit") }
					}
					@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2 text-destructive hover:text-destructive focus:text-destructive", Attributes: templ.Attributes{"type": "button", "data-calendar-subscription-remove": source.ID, "data-calendar-source-name": calendarSourceDisplayName(ctx, source)}}) {
						<span class="inline-flex">
							@icon.Trash2(icon.Props{Class: "size-4"})
						</span>
						{ i18n.T(ctx, "calendar.subscription.remove") }
					}
				} else {
					@dropdown.Separator()
					@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "button", "data-calendar-source-stop": source.ID}}) {
						<span class="inline-flex text-muted-foreground">
							@icon.CircleMinus(icon.Props{Class: "size-4"})
						</span>
						{ i18n.T(ctx, "calendar.source.stop_syncing") }
					}
					if calendarTransferProvider(source.Provider) {
						// Import adds the events of an .ics file to this
						// calendar, when it can be written to; Export
						// downloads all of its events as one.
						@dropdown.Separator()
						if calendarTransferWritable(source) {
							@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "button", "data-calendar-import-open": source.ID}}) {
								<span class="inline-flex text-muted-foreground">
									@icon.Upload(icon.Props{Class: "size-4"})
								</span>
								{ i18n.T(ctx, "calendar.import.menu") }
							}
						}
						@dropdown.Item(dropdown.ItemProps{Href: "/api/calendar/sources/" + source.ID + "/export", Class: "justify-start gap-2", Attributes: templ.Attributes{"download": "", "data-calendar-source-export": source.ID}}) {
							<span class="inline-flex text-muted-foreground">
								@icon.Download(icon.Props{Class: "size-4"})
							</span>
							{ i18n.T(ctx, "calendar.source.export_ics") }
						}
					}
					@dropdown.Separator()
					// Rename and Delete change the calendar on its provider, for
					// every app, not only in Gofer.
					@CalendarSourceManageItems(account, source)
				}
			}
		}
		// The same 24px slot as the "Other calendars" count and buttons,
		// so the icons at the end of every row line up.
		<span class="relative inline-flex size-6 shrink-0 items-center justify-center">
			@CalendarSourceSyncIndicator(source, loading)
			<span data-calendar-visibility-status class="absolute inset-0 inline-flex items-center justify-center opacity-0" aria-hidden="true">@icon.LoaderCircle(icon.Props{Class: "size-3 animate-spin"})
</span>
		</span>
	</label>
}

// CalendarImportDialog imports an .ics file's events into a synced CalDAV
// calendar, or into a new calendar on an account that syncs calendars, named
// from the file.
templ CalendarImportDialog(accounts []models.Account) {
	{{ calendars := calendarTransferCalendars(ctx, accounts, true) }}
	{{ targets := calendarTransferNewTargets(ctx, accounts) }}
	@dialog.Dialog(dialog.Props{ID: "calendar-import-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg normal-case tracking-normal"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "calendar.import.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "calendar.import.description") }
				}
			}
			if len(calendars) == 0 && len(targets) == 0 {
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "calendar.import.needs_account") }</p>
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: "calendar-import-dialog"}) {
						<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border px-3 text-sm font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "common.close") }</button>
					}
				}
			} else {
				<form class="space-y-4" data-calendar-import-form>
					<div class="space-y-1.5">
						<label for="calendar-import-file" class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "calendar.import.file") }</label>
						<input id="calendar-import-file" type="file" name="file" accept=".ics,text/calendar" required data-calendar-import-file class="block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground file:mr-3 file:rounded-md file:border-0 file:bg-primary file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-primary-foreground hover:file:bg-primary/90"/>
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "calendar.import.file_help") }</p>
					</div>
					<div class="space-y-1.5">
						<label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "calendar.import.into") }</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "target", Class: "h-10 bg-background", Required: true, DisableClear: true, Attributes: templ.Attributes{"data-calendar-import-target": ""}}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "calendar.choose_calendar"), Class: "text-left"})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								for i, choice := range calendars {
									@selectbox.Item(selectbox.ItemProps{Value: choice.Value, Selected: i == 0}) {
										{ choice.Label }
									}
								}
								for i, choice := range targets {
									@selectbox.Item(selectbox.ItemProps{Value: choice.Value, Disabled: choice.Disabled, Selected: len(calendars) == 0 && i == calendarTransferFirstTarget(targets)}) {
										{ choice.Label }
									}
								}
							}
						}
					</div>
					<div class="space-y-1.5" data-calendar-import-name-field hidden?={ len(calendars) > 0 }>
						<label for="calendar-import-name" class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "calendar.import.new_name") }</label>
						@input.Input(input.Props{ID: "calendar-import-name", Name: "name", Type: input.TypeText, Placeholder: i18n.T(ctx, "calendar.import.name_placeholder"), Attributes: templ.Attributes{"maxlength": "100", "autocomplete": "off", "data-calendar-import-name": ""}})
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "calendar.import.name_help") }</p>
					</div>
					<div class="space-y-1.5" data-calendar-import-progress hidden>
						<div class="flex items-center justify-between gap-3 text-xs text-muted-foreground">
							<span data-calendar-import-progress-label aria-live="polite">{ i18n.T(ctx, "calendar.import.preparing") }</span>
							<span class="tabular-nums" data-calendar-import-progress-count></span>
						</div>
						@progress.Progress(progress.Props{Max: 100, Value: 0, Size: progress.SizeSm, Attributes: templ.Attributes{"data-calendar-import-progress-bar": "", "aria-label": i18n.T(ctx, "calendar.import.progress")}})
					</div>
					@dialog.Footer() {
						@dialog.Close(dialog.CloseProps{For: "calendar-import-dialog"}) {
							<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border px-3 text-sm font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "common.cancel") }</button>
						}
						<button type="submit" data-calendar-import-submit class="inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-primary px-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
							@icon.Upload(icon.Props{Class: "size-4"})
							<span data-calendar-import-submit-label>{ i18n.T(ctx, "calendar.import.title") }</span>
						</button>
					}
				</form>
			}
		}
	}
}

// CalendarExportDialog downloads one synced CalDAV calendar as an .ics file.
templ CalendarExportDialog(accounts []models.Account) {
	{{ calendars := calendarTransferCalendars(ctx, accounts, false) }}
	@dialog.Dialog(dialog.Props{ID: "calendar-export-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg normal-case tracking-normal"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "calendar.export.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "calendar.export.description") }
				}
			}
			if len(calendars) == 0 {
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "calendar.export.none") }</p>
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: "calendar-export-dialog"}) {
						<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border px-3 text-sm font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "common.close") }</button>
					}
				}
			} else {
				<form class="space-y-4" data-calendar-export-form>
					<div class="space-y-1.5">
						<label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "calendar.calendar") }</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "source", Class: "h-10 bg-background", Required: true, DisableClear: true}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "calendar.choose_calendar"), Class: "text-left"})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								for i, choice := range calendars {
									@selectbox.Item(selectbox.ItemProps{Value: choice.SourceID, Selected: i == 0}) {
										{ choice.Label }
									}
								}
							}
						}
					</div>
					@dialog.Footer() {
						@dialog.Close(dialog.CloseProps{For: "calendar-export-dialog"}) {
							<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border px-3 text-sm font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "common.cancel") }</button>
						}
						<button type="submit" data-calendar-export-submit class="inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-primary px-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
							@icon.Download(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "calendar.export.submit") }
						</button>
					}
				</form>
			}
		}
	}
}

// CalendarSubscriptionDialog subscribes to a calendar feed by its address,
// or changes a subscription, which the page fills in. The name and color
// may be left for the feed to suggest.
templ CalendarSubscriptionDialog() {
	@dialog.Dialog(dialog.Props{ID: "calendar-subscription-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "data-dialog max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:flex [&>[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:min-h-0 [&>[data-tui-dialog-panel]]:flex-col [&>[data-tui-dialog-panel]]:gap-0 [&>[data-tui-dialog-panel]]:p-0 sm:max-w-lg normal-case tracking-normal"}) {
			@dialog.Header(dialog.HeaderProps{Class: "shrink-0 px-6 pt-6 pb-4"}) {
				@dialog.Title() {
					<span data-calendar-subscription-mode="add">{ i18n.T(ctx, "calendar.subscription.add_title") }</span>
					<span data-calendar-subscription-mode="edit" hidden>{ i18n.T(ctx, "calendar.subscription.edit_title") }</span>
				}
				@dialog.Description() {
					{ i18n.T(ctx, "calendar.subscription.description") }
				}
			}
			<form class={ dataDialogFormClass } data-calendar-subscription-form novalidate>
				<input type="hidden" name="id" value="" data-calendar-subscription-id/>
				@dataDialogScroll("space-y-4 pb-4") {
					<div class="space-y-1.5">
						<label for="calendar-subscription-url" class="block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "calendar.subscription.url") }</label>
						@input.Input(input.Props{ID: "calendar-subscription-url", Name: "url", Type: input.TypeURL, Placeholder: i18n.T(ctx, "calendar.subscription.url_placeholder"), Required: true, Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "data-calendar-subscription-url": ""}})
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "calendar.subscription.url_help") }</p>
					</div>
					<div class="space-y-1.5">
						<label for="calendar-subscription-name" class="block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "calendar.subscription.name") } <span class="font-normal">{ i18n.T(ctx, "identities.optional") }</span></label>
						@input.Input(input.Props{ID: "calendar-subscription-name", Name: "name", Type: input.TypeText, Placeholder: i18n.T(ctx, "calendar.subscription.name_placeholder"), Attributes: templ.Attributes{"maxlength": "100", "autocomplete": "off", "data-calendar-subscription-name": ""}})
					</div>
					<div class="space-y-1.5">
						<span class="block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "calendar.subscription.color") }</span>
						<input type="hidden" name="color" value="" data-calendar-subscription-color/>
						<div class="flex flex-wrap gap-2" role="group" aria-label={ i18n.T(ctx, "calendar.subscription.color") }>
							<button
								type="button"
								class="account-color-swatch inline-flex size-7 items-center justify-center rounded-full border border-dashed border-border text-muted-foreground transition-transform hover:scale-110 focus-visible:outline-none"
								data-calendar-subscription-color-option=""
								data-account-color-active="true"
								aria-pressed="true"
								aria-label={ i18n.T(ctx, "calendar.subscription.color_feed") }
								title={ i18n.T(ctx, "calendar.subscription.color_feed") }
							>
								@icon.Rss(icon.Props{Class: "size-3.5"})
							</button>
							for _, color := range accountColorOptions() {
								<button
									type="button"
									class="account-color-swatch size-7 rounded-full transition-transform hover:scale-110 focus-visible:outline-none"
									style={ accountColorStyle(color) }
									data-calendar-subscription-color-option={ color }
									data-account-color-active="false"
									aria-pressed="false"
									aria-label={ i18n.T(ctx, "settings.account.color_use", "color", color) }
								></button>
							}
						</div>
					</div>
					<div class="space-y-1.5">
						<span class="block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "calendar.subscription.refresh") }</span>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "refresh_minutes", Class: "h-10 bg-background", Required: true, DisableClear: true, Attributes: templ.Attributes{"value": strconv.Itoa(calendarSubscriptionDefaultRefresh()), "data-calendar-subscription-refresh": strconv.Itoa(calendarSubscriptionDefaultRefresh())}}) {
								@selectbox.Value(selectbox.ValueProps{Class: "text-left"})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								for _, minutes := range calendarSubscriptionRefreshChoices() {
									@selectbox.Item(selectbox.ItemProps{Value: strconv.Itoa(minutes), Selected: minutes == calendarSubscriptionDefaultRefresh()}) {
										{ calendarSubscriptionRefreshLabel(ctx, minutes) }
									}
								}
							}
						}
					</div>
					<p class="flex items-start gap-2 text-xs text-muted-foreground">
						@icon.Info(icon.Props{Class: "mt-0.5 size-3.5 shrink-0"})
						<span>{ i18n.T(ctx, "calendar.subscription.read_only") }</span>
					</p>
				}
				@dataDialogFooter() {
					@dialog.Close() {
						<button type="button" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent">{ i18n.T(ctx, "common.cancel") }</button>
					}
					<button type="submit" data-calendar-subscription-submit class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-50">
						<span data-calendar-subscription-mode="add">{ i18n.T(ctx, "calendar.subscription.subscribe") }</span>
						<span data-calendar-subscription-mode="edit" hidden>{ i18n.T(ctx, "common.save") }</span>
					</button>
				}
			</form>
		}
	}
}

// CalendarSourceManageItems are a synced calendar's Rename and Delete. Where
// the provider won't allow them they are greyed out: a Google calendar Gofer
// didn't create still opens an offer to allow full calendar access, and one
// shared with the account only says why. A Google calendar the account
// doesn't own can instead be renamed or removed just for it.
templ CalendarSourceManageItems(account models.Account, source models.AccountCalendarSource) {
	{{ state := calendarManageState(account, source) }}
	{{ name := calendarSourceDisplayName(ctx, source) }}
	switch state {
		case "personal", "personal-access":
			for _, action := range []string{"rename-mine", "remove"} {
				@dropdown.Item(dropdown.ItemProps{Class: calendarPersonalItemClass(state), Attributes: calendarPersonalItemAttributes(state, action, account, source, name)}) {
					<span class={ "inline-flex", templ.KV("text-muted-foreground", state == "personal") }>
						if action == "rename-mine" {
							@icon.Pencil(icon.Props{Class: "size-4"})
						} else {
							@icon.CalendarMinus(icon.Props{Class: "size-4"})
						}
					</span>
					if action == "rename-mine" {
						{ i18n.T(ctx, "calendar.source.rename_mine") }
					} else {
						{ i18n.T(ctx, "calendar.source.remove") }
					}
					if state == "personal-access" {
						<span class="ml-auto inline-flex text-muted-foreground">
							@icon.KeyRound(icon.Props{Class: "size-3.5"})
						</span>
					}
				}
			}
		case "owner":
			@dropdown.Item(dropdown.ItemProps{Class: "items-start justify-start gap-2", Disabled: true}) {
				<span class="inline-flex pt-0.5 text-muted-foreground">
					@icon.Pencil(icon.Props{Class: "size-4"})
				</span>
				<span class="flex flex-col">
					{ i18n.T(ctx, "calendar.source.rename_or_delete") }
					<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "calendar.source.owner_only") }</span>
				</span>
			}
		case "access":
			for _, action := range []string{"rename", "delete"} {
				@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2 text-muted-foreground opacity-70", Attributes: templ.Attributes{
					"type": "button", "aria-disabled": "true",
					"data-calendar-source-needs-access": action, "data-calendar-source-name": name,
					"data-calendar-account-email": account.Email, "data-calendar-account-name": account.Name,
				}}) {
					<span class="inline-flex">
						if action == "rename" {
							@icon.Pencil(icon.Props{Class: "size-4"})
						} else {
							@icon.Trash2(icon.Props{Class: "size-4"})
						}
					</span>
					if action == "rename" {
						{ i18n.T(ctx, "calendar.source.rename") }
					} else {
						{ i18n.T(ctx, "calendar.source.delete") }
					}
					<span class="ml-auto inline-flex text-muted-foreground">
						@icon.KeyRound(icon.Props{Class: "size-3.5"})
					</span>
				}
			}
		default:
			@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "button", "data-calendar-source-rename": source.ID, "data-calendar-source-name": name, "data-calendar-account-email": account.Email, "data-calendar-account-name": account.Name}}) {
				<span class="inline-flex text-muted-foreground">
					@icon.Pencil(icon.Props{Class: "size-4"})
				</span>
				{ i18n.T(ctx, "calendar.source.rename") }
			}
			if source.Undeletable != "" {
				@dropdown.Item(dropdown.ItemProps{Class: "items-start justify-start gap-2", Disabled: true}) {
					<span class="inline-flex pt-0.5 text-muted-foreground">
						@icon.Trash2(icon.Props{Class: "size-4"})
					</span>
					<span class="flex flex-col">
						{ i18n.T(ctx, "calendar.source.delete") }
						<span class="text-xs text-muted-foreground">{ i18n.Stored(ctx, "calendar.undeletable.", source.Undeletable) }</span>
					</span>
				}
			} else {
				@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2 text-destructive hover:text-destructive focus:text-destructive", Attributes: templ.Attributes{"type": "button", "data-calendar-source-delete": source.ID, "data-calendar-source-name": name, "data-calendar-provider": calendarSourceHome(ctx, source), "data-calendar-account-email": account.Email, "data-calendar-account-name": account.Name}}) {
					<span class="inline-flex">
						@icon.Trash2(icon.Props{Class: "size-4"})
					</span>
					{ i18n.T(ctx, "calendar.source.delete") }
				}
			}
	}
}

// CalendarOtherSources lists, folded away under an account, its calendars
// that aren't synced, each with a button that starts syncing it.
templ CalendarOtherSources(account models.Account, loading bool) {
	@collapsible.Collapsible(collapsible.Props{Class: "-mt-1.5 mb-2", Attributes: templ.Attributes{"data-calendar-other-sources": account.ID}}) {
		@collapsible.Trigger(collapsible.TriggerProps{Class: "group"}) {
			<button type="button" disabled?={ loading } class="flex min-h-7 w-full cursor-pointer items-center gap-1.5 rounded-md py-1 pl-7 pr-2.5 text-left text-[11px] text-sidebar-foreground transition-colors hover:bg-sidebar-accent/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sidebar-ring disabled:cursor-wait">
				@icon.ChevronRight(icon.Props{Class: "size-3 shrink-0 transition-transform group-aria-expanded:rotate-90"})
				<span class="min-w-0 flex-1 truncate">{ i18n.T(ctx, "calendar.other_calendars") }</span>
				<span class="inline-flex w-6 shrink-0 justify-center tabular-nums">{ strconv.Itoa(len(account.OtherCalendarSources)) }</span>
			</button>
		}
		@collapsible.Content() {
			<div class="space-y-0.5 pt-0.5" role="group" aria-label={ i18n.T(ctx, "calendar.other_calendars_for", "account", calendarAccountName(ctx, account)) }>
				for _, source := range account.OtherCalendarSources {
					<div class="group flex min-h-8 items-center gap-2.5 rounded-md py-1.5 pl-7 pr-2.5 text-[12px] text-sidebar-foreground transition-colors hover:bg-sidebar-accent/60" data-calendar-other-source={ source.ID }>
						<span class="size-2 shrink-0 rounded-full opacity-60" style={ calendarEventColorStyle(CalendarEvent{SourceColor: source.Color}) }></span>
						<span class="min-w-0 flex-1 truncate opacity-70" title={ calendarSourceDisplayName(ctx, source) }>{ calendarSourceDisplayName(ctx, source) }</span>
						@tooltip.Tooltip() {
							@tooltip.Trigger() {
								@button.Button(button.Props{
									Variant:  button.VariantGhost,
									Size:     button.SizeIcon,
									Class:    "size-6 shrink-0 rounded text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
									Disabled: loading,
									Attributes: templ.Attributes{
										"data-calendar-source-start": source.ID,
										"aria-label":                 i18n.T(ctx, "calendar.source.sync", "calendar", calendarSourceDisplayName(ctx, source)),
									},
								}) {
									<span class="inline-flex" data-calendar-source-start-icon>
										@icon.Plus(icon.Props{Class: "size-3.5"})
									</span>
								}
							}
							@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionRight, ShowArrow: true}) {
								{ i18n.T(ctx, "calendar.source.sync_this") }
							}
						}
					</div>
				}
			</div>
		}
	}
}

templ CalendarPage(month CalendarMonthData, uiSettings map[string]string) {
	<div id="main-content" class={ mailPaneLayoutClass(PaneLayout(uiSettings, "calendar")) + " bg-background" } data-mail-pane-layout={ PaneLayout(uiSettings, "calendar") }>
		@CalendarMainPane(month, uiSettings)
		@ResizeHandle("maillist")
		@CalendarAgendaPane(month)
	</div>
}

templ CalendarSourceSyncIndicator(source models.AccountCalendarSource, loading bool) {
	<span data-calendar-source-sync={ source.ID } data-calendar-sync-attempt={ strconv.Itoa(source.SyncAttempt) } data-calendar-sync-state={ source.SyncState } data-calendar-last-synced={ source.LastSyncedAt } data-calendar-next-attempt={ source.NextAttemptAt } data-calendar-source-error={ source.SyncError } role="img" aria-label={ calendarSourceSyncTitle(ctx, source) } title={ calendarSourceSyncTitle(ctx, source) } class="absolute inset-0 inline-flex items-center justify-center">
		if loading {
			<span class="calendar-skeleton size-3 rounded bg-sidebar-accent" aria-hidden="true"></span>
		} else {
			<span data-calendar-source-sync-icon="syncing" hidden?={ source.SyncState != "syncing" } class="text-sidebar-primary">@icon.LoaderCircle(icon.Props{Class: "size-3 animate-spin"})
</span>
			<span data-calendar-source-sync-icon="failed" hidden?={ source.SyncState != "failed" } class="text-destructive">@icon.CircleAlert(icon.Props{Class: "size-3"})
</span>
			<span data-calendar-source-sync-icon="ok" hidden?={ source.SyncState != "ok" || source.LastSyncedAt == "" } class="text-emerald-600 dark:text-emerald-400">@icon.Check(icon.Props{Class: "size-3"})
</span>
			<span data-calendar-source-sync-icon="pending" hidden?={ source.SyncState == "syncing" || source.SyncState == "failed" || (source.SyncState == "ok" && source.LastSyncedAt != "") } class="text-sidebar-foreground">@icon.Clock3(icon.Props{Class: "size-3"})
</span>
		}
	</span>
}

templ CalendarMainPane(month CalendarMonthData, uiSettings map[string]string) {
	<section id="mail-list" class="flex w-full max-lg:!w-full lg:flex flex-col border-r border-border bg-card h-full min-w-0 overflow-hidden" style={ "width:" + mailListWidthCSS(PanelSetting(uiSettings, "calendar", "mail_list_width", "50%")) } data-panel-section="calendar" aria-busy={ strconv.FormatBool(month.Loading) }>
		@CalendarMainContent(month)
		@CalendarMoveConfirm()
		@CalendarContextMenu()
		<button type="button" class="mobile-compose-fab" data-on-click='["goferClickElement","[data-calendar-create-trigger]"]' aria-label={ i18n.T(ctx, "calendar.new_event") }>
			@icon.CalendarPlus(icon.Props{Class: "size-6"})
		</button>
	</section>
}

templ CalendarMainContent(month CalendarMonthData) {
	<div id="calendar-main" data-calendar-month={ month.MonthKey } data-calendar-month-label={ calendarPeriodLabel(ctx, month) } data-calendar-today-date={ month.TodayDateKey } data-calendar-view={ month.View } data-calendar-date={ month.DateKey } data-calendar-period={ month.PeriodKey } data-calendar-sync-sources={ month.SyncSourcesJSON } data-calendar-has-sources={ strconv.FormatBool(month.HasSources) } data-calendar-timezone={ month.Month.Location().String() } data-calendar-loading?={ month.Loading } aria-busy={ strconv.FormatBool(month.Loading) } class="relative flex min-h-0 flex-1 flex-col overflow-hidden">
		if month.AutoSync && !month.Loading {
			<div
				class="hidden"
				hx-post="/api/calendar/sync"
				hx-vals={ calendarViewSyncValues(month) }
				hx-trigger="load"
				hx-target="#main-content"
				hx-swap="outerHTML"
				hx-sync="#main-content:drop"
				data-on-htmx-before-request='["handleCalendarSyncStart","$event"]'
				data-on-htmx-after-request='["handleCalendarSyncResult","$event"]'
				data-on-htmx-send-abort='["handleCalendarSyncAbort","$event"]'
				data-calendar-auto-sync
			></div>
		}
		if !month.Loading {
			<div class="hidden" data-calendar-cache-refresh hx-get={ calendarViewURL(month.View, month.DateKey) + "&cache=1" } hx-trigger="calendar-cache-refresh" hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:drop" data-on-htmx-before-request='["configureCalendarCacheRequest","$event"]'></div>
		}
		<header class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-4" inert?={ month.Loading }>
			<h1 class="min-w-0 truncate text-lg font-bold tracking-tight" style="font-family: var(--font-serif)" data-calendar-title>{ calendarPeriodLabel(ctx, month) }</h1>
			<div class="flex shrink-0 items-center gap-1.5">
				@button.Button(button.Props{Variant: button.VariantOutline, Href: calendarViewURL(month.View, month.TodayDateKey), Class: "h-8 px-2.5 text-xs font-semibold text-foreground " + raisedButtonClass, Attributes: templ.Attributes{"hx-get": calendarViewURL(month.View, month.TodayDateKey), "hx-target": "#main-content", "hx-select": "#main-content", "hx-swap": "outerHTML", "hx-sync": "#main-content:replace", "hx-push-url": calendarViewURL(month.View, month.TodayDateKey), "data-calendar-today": ""}}) {
					{ i18n.T(ctx, "calendar.today") }
				}
				// The arrows share one outline button's look; templui has no button group.
				<div class="inline-flex h-8 items-center rounded-md border bg-card shadow-xs dark:border-input dark:bg-card">
					<a href={ calendarNavigationURL(month, -1) } hx-get={ calendarNavigationURL(month, -1) } hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:replace" hx-push-url={ calendarNavigationURL(month, -1) } data-calendar-navigate="-1" class="inline-flex h-full w-8 items-center justify-center rounded-l-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground" aria-label={ calendarNavigationLabel(ctx, month, "previous") }>
						@icon.ChevronLeft(icon.Props{Class: "size-4"})
					</a>
					<a href={ calendarNavigationURL(month, 1) } hx-get={ calendarNavigationURL(month, 1) } hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:replace" hx-push-url={ calendarNavigationURL(month, 1) } data-calendar-navigate="1" class="inline-flex h-full w-8 items-center justify-center rounded-r-md border-l border-border text-muted-foreground transition-colors hover:bg-accent hover:text-foreground" aria-label={ calendarNavigationLabel(ctx, month, "next") }>
						@icon.ChevronRight(icon.Props{Class: "size-4"})
					</a>
				</div>
				<nav aria-label={ i18n.T(ctx, "calendar.view.label") } class="relative grid h-8 w-36 grid-cols-2 gap-0.5 rounded-lg border border-border bg-background p-0.5" data-calendar-view-nav>
					<div data-calendar-view-indicator aria-hidden="true" class="absolute top-0.5 bottom-0.5 left-0.5 rounded-md border border-border bg-card shadow-sm transition-transform duration-200 ease-out motion-reduce:transition-none" style={ calendarViewIndicatorStyle(month.View) }></div>
					<a href={ calendarViewURL("month", month.DateKey) } hx-get={ calendarViewURL("month", month.DateKey) } hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:replace" hx-push-url={ calendarViewURL("month", month.DateKey) } class={ calendarViewSwitchClass(month.View != "week") } aria-current={ calendarViewCurrent(month.View != "week") } data-calendar-view-switch="month">{ i18n.T(ctx, "calendar.view.month") }</a>
					<a href={ calendarViewURL("week", month.DateKey) } hx-get={ calendarViewURL("week", month.DateKey) } hx-target="#main-content" hx-select="#main-content" hx-swap="outerHTML" hx-sync="#main-content:replace" hx-push-url={ calendarViewURL("week", month.DateKey) } class={ calendarViewSwitchClass(month.View == "week") } aria-current={ calendarViewCurrent(month.View == "week") } data-calendar-view-switch="week">{ i18n.T(ctx, "calendar.view.week") }</a>
				</nav>
			</div>
		</header>
		if month.View == "week" {
			<div class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-b border-border bg-muted/10 px-4 py-2 sm:px-5" inert?={ month.Loading }>
				<p data-calendar-week-scale-status class="text-[11px] text-muted-foreground" aria-live="polite">{ i18n.T(ctx, "calendar.week.scale_fit_condensed") }</p>
				<div class="inline-flex items-center gap-1" role="group" aria-label={ i18n.T(ctx, "calendar.week.zoom") }>
					<button type="button" data-calendar-week-zoom="fit" aria-pressed="true" class="inline-flex h-7 items-center rounded-md border border-border bg-accent px-2.5 text-xs font-semibold transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">{ i18n.T(ctx, "calendar.week.fit") }</button>
					<div class="inline-flex overflow-hidden rounded-md border border-border bg-background shadow-sm">
						<button type="button" data-calendar-week-zoom="out" disabled class="inline-flex size-7 items-center justify-center text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring disabled:opacity-35" aria-label={ i18n.T(ctx, "calendar.week.zoom_out") }>
							@icon.Minus(icon.Props{Class: "size-3.5"})
						</button>
						<button type="button" data-calendar-week-zoom="in" class="inline-flex size-7 items-center justify-center border-l border-border text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring disabled:opacity-35" aria-label={ i18n.T(ctx, "calendar.week.zoom_in") }>
							@icon.Plus(icon.Props{Class: "size-3.5"})
						</button>
					</div>
				</div>
			</div>
		}
		<div class={ "min-h-0 flex-1 overflow-auto", templ.KV("flex flex-col p-3 sm:p-5", month.View != "week") } data-calendar-surface data-calendar-week-scroll?={ month.View == "week" } inert?={ month.Loading }>
			if month.View == "week" {
				@CalendarWeekGrid(month)
			} else {
				<div class="flex min-h-0 flex-1 flex-col overflow-hidden rounded-xl border border-border bg-background shadow-[0_1px_2px_rgba(0,0,0,0.04)]" data-calendar-month-grid>
					<div class="grid shrink-0 grid-cols-7 border-b border-border bg-muted/35">
						for index := 0; index < 7; index++ {
							<div class="px-2 py-2 text-center text-[10px] font-bold uppercase tracking-[0.14em] text-muted-foreground sm:px-3 sm:text-[11px]">{ calendarWeekdayLabel(ctx, index) }</div>
						}
					</div>
					<div class="grid min-h-0 flex-1 grid-cols-7" style={ "grid-template-rows:repeat(" + strconv.Itoa(len(month.Weeks)) + ",minmax(0,1fr));" }>
						for _, week := range month.Weeks {
							for dayIndex, day := range week.Days {
								{{ dayEvents := calendarEventsForDay(day, month.Events)
visibleEvents := calendarVisibleEventCount(dayEvents) }}
								<div class={ calendarDayClass(day) } data-calendar-day={ day.ISODate } data-calendar-week-start={ week.Days[0].ISODate } data-calendar-day-event-count={ strconv.Itoa(visibleEvents) } data-calendar-day-selected="false" data-calendar-day-start={ day.Date.Format(time.RFC3339) } data-calendar-day-end={ day.Date.AddDate(0, 0, 1).Format(time.RFC3339) } data-calendar-day-title={ i18n.Dates(ctx).LongDateNoYear(day.Date) } aria-label={ calendarDayLabel(ctx, day) }>
									<button type="button" disabled?={ month.Loading } data-calendar-select-day={ day.ISODate } aria-label={ i18n.T(ctx, "calendar.show_day_events", "date", i18n.Dates(ctx).LongDate(day.Date)) } aria-pressed="false" aria-controls="calendar-agenda-list" class="absolute inset-0 rounded-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring">
										<span class="sr-only">{ i18n.Dates(ctx).LongDate(day.Date) }</span>
									</button>
									<div class="pointer-events-none relative flex shrink-0 items-start justify-between gap-1">
										<span class={ calendarDayNumberClass(day) }>{ day.DayNumber }</span>
										if day.IsToday {
											<span class="hidden rounded-full bg-primary/10 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-primary sm:inline-flex">{ i18n.T(ctx, "calendar.today") }</span>
										}
									</div>
									if !month.Loading {
										@CalendarDayDots(dayEvents)
									}
									if !month.Loading && len(dayEvents) > 0 {
										<div hidden?={ visibleEvents == 0 } class="pointer-events-none relative z-10 mt-0.5 flex min-h-0 flex-1 flex-col gap-1 sm:mt-1" data-calendar-month-events>
											<div class="grid min-h-0 grid-cols-1 gap-1" data-calendar-month-event-list>
												for _, candidate := range calendarMonthCandidates(dayEvents) {
													{{ event := candidate.Event
continuesBefore := event.AllDay && event.StartDate < day.ISODate
continuesAfter := event.AllDay && event.EndDate > day.Date.AddDate(0, 0, 1).Format("2006-01-02") }}
													<button type="button" hidden?={ !candidate.Visible } data-calendar-source-id={ event.SourceID } data-calendar-source-hidden={ strconv.FormatBool(event.SourceHidden) } data-calendar-response-state={ calendarEventResponseState(event) } { calendarMoveAttributes(event)... } data-calendar-month-event={ event.ID } data-calendar-event-all-day={ strconv.FormatBool(event.AllDay) } data-calendar-event-start-date={ event.StartDate } data-calendar-event-end-date={ event.EndDate } data-calendar-continues-before?={ continuesBefore } data-calendar-continues-after?={ continuesAfter } class="group pointer-events-auto relative flex w-full min-w-0 items-center gap-1.5 truncate rounded bg-primary/[0.06] px-1.5 py-1 text-left text-[10px] leading-tight text-foreground transition-colors hover:bg-primary/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" title={ calendarEventResponseSummary(ctx, event) } aria-label={ i18n.T(ctx, "calendar.open_event", "event", calendarEventResponseSummary(ctx, event)) } aria-haspopup="dialog" aria-controls="calendar-event-details-content" hx-get={ calendarEventDetailsURL(event.ID) } hx-target="#app-pane-dialogs" hx-swap="innerHTML" hx-sync="#app-pane-dialogs:replace" hx-disabled-elt="this" data-calendar-event-trigger>
														<span class={ "flex min-w-0 flex-1 items-center gap-1.5", templ.KV("invisible", continuesBefore && dayIndex > 0) }>
															<span class="size-1.5 shrink-0 rounded-full" style={ calendarEventColorStyle(event) }></span>
															<span class="shrink-0 font-semibold text-primary">{ calendarEventTimeLabel(ctx, event, day.Date.Location()) }</span>
															<span class="min-w-0 flex-1 truncate" data-calendar-event-summary><span data-calendar-event-text>{ calendarEventSummary(ctx, event) }</span></span>
															@CalendarEventResponseIndicator(event, true)
														</span>
													</button>
												}
											</div>
											<button type="button" hidden?={ visibleEvents <= 3 } data-calendar-select-day={ day.ISODate } data-calendar-day-overflow aria-label={ i18n.T(ctx, "calendar.show_all_day_events", "date", i18n.Dates(ctx).LongDate(day.Date)) } aria-pressed="false" aria-controls="calendar-agenda-list" class="pointer-events-auto max-w-full shrink-0 self-start truncate rounded px-0.5 py-0.5 text-left text-[9px] font-semibold text-muted-foreground hover:bg-primary/10 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:px-1.5 sm:text-[10px]">{ i18n.T(ctx, "calendar.more_events", "count", visibleEvents - 3) }</button>
										</div>
									}
								</div>
							}
						}
					</div>
				</div>
			}
		</div>
		<footer class="flex shrink-0 flex-wrap items-center justify-between gap-2 px-4 py-2 text-[11px] text-muted-foreground sm:px-5" data-calendar-layout-footer>
			<div class="flex flex-wrap items-center gap-x-4 gap-y-1" role="group" aria-label={ i18n.T(ctx, "calendar.legend") }>
				<span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-primary"></span>{ i18n.T(ctx, "calendar.today") }</span>
				@CalendarEventResponseLegend()
			</div>
			if month.Loading {
				<span class="inline-flex items-center gap-1.5" role="status"><span class="size-2 rounded-full bg-muted"></span>{ i18n.T(ctx, "calendar.loading") }</span>
			} else {
				<span class={ calendarSyncMessageClass(month) } role="status" aria-live="polite">
					<span data-calendar-sync-dot class={ calendarAgendaStatusDotClass(month) }></span>
					<span data-calendar-sync-status>{ calendarSyncMessage(ctx, month) }</span>
				</span>
			}
		</footer>
	</div>
}

templ CalendarAgendaPane(month CalendarMonthData) {
	<section id="mail-view" class="flex flex-1 min-w-0 flex-col bg-background surface-desk" aria-labelledby="calendar-agenda-heading" data-calendar-agenda aria-busy={ strconv.FormatBool(month.Loading) }>
		<div class="flex min-h-0 flex-1 flex-col">
			<header class="border-b border-border px-5 py-4" data-calendar-agenda-header>
				<button type="button" class="calendar-sheet-handle" data-calendar-sheet-handle aria-label={ i18n.T(ctx, "calendar.agenda.toggle") }><span></span></button>
				<div class="flex items-center justify-between gap-3">
					<p class="text-[10px] font-bold uppercase tracking-[0.18em] text-muted-foreground">{ i18n.T(ctx, "calendar.agenda.title") }</p>
					<button type="button" data-calendar-agenda-clear hidden class="items-center gap-1 text-xs font-semibold text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
						@icon.ChevronLeft(icon.Props{Class: "inline size-3"})
						<span>{ i18n.T(ctx, "calendar.agenda.all_events") }</span>
					</button>
				</div>
				<div class="mt-1 flex items-center justify-between gap-3">
					<h2 id="calendar-agenda-heading" tabindex="-1" class="text-lg font-bold tracking-tight outline-none" style="font-family: var(--font-serif)">{ i18n.T(ctx, "calendar.agenda.all_events") }</h2>
					<span data-calendar-agenda-context class="shrink-0 rounded-full border border-border bg-muted/50 px-2 py-1 text-[10px] font-semibold text-muted-foreground" aria-live="polite">{ calendarPeriodLabel(ctx, month) }</span>
				</div>
			</header>
			{{ agendaEvents := calendarAgendaEvents(month) }}
			if month.Loading {
				<div id="calendar-agenda-list" class="min-h-0 flex-1 overflow-y-auto p-5" aria-hidden="true"></div>
			} else {
				<div data-calendar-agenda-empty hidden?={ len(agendaEvents) > 0 } class="min-h-0 flex-1 overflow-y-auto px-5 py-10 text-center">
					<div class="mx-auto flex size-10 items-center justify-center rounded-full bg-primary/10 text-primary">
						@icon.CalendarDays(icon.Props{Class: "size-5"})
					</div>
					<h3 data-calendar-agenda-empty-title class="mt-3 text-sm font-semibold text-foreground">
						if month.AllSourcesHidden {
							{ i18n.T(ctx, "calendar.agenda.all_hidden") }
						} else {
							{ i18n.T(ctx, "calendar.agenda.no_events") }
						}
					</h3>
					<p data-calendar-agenda-empty-detail class="mx-auto mt-1 max-w-xs text-xs leading-relaxed text-muted-foreground">
						if month.AllSourcesHidden {
							{ i18n.T(ctx, "calendar.agenda.all_hidden_detail") }
						} else if month.View == "week" {
							{ i18n.T(ctx, "calendar.agenda.empty_week") }
						} else {
							{ i18n.T(ctx, "calendar.agenda.empty_month") }
						}
					</p>
				</div>
				<div id="calendar-agenda-list" hidden?={ len(agendaEvents) == 0 } class="min-h-0 flex-1 overflow-y-auto p-5">
					<div class="space-y-2">
						for _, event := range month.Events {
							<button type="button" hidden?={ event.SourceHidden } data-calendar-source-id={ event.SourceID } data-calendar-source-hidden={ strconv.FormatBool(event.SourceHidden) } data-calendar-response-state={ calendarEventResponseState(event) } data-calendar-agenda-event data-calendar-event-all-day={ strconv.FormatBool(event.AllDay) } data-calendar-event-start-date={ event.StartDate } data-calendar-event-end-date={ event.EndDate } data-calendar-event-start={ calendarEventTimestamp(event.StartAt) } data-calendar-event-end={ calendarEventTimestamp(event.EndAt) } class="group relative w-full rounded-xl border border-border bg-card px-3.5 py-3 text-left shadow-sm transition-colors hover:bg-accent/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label={ i18n.T(ctx, "calendar.open_event", "event", calendarEventResponseSummary(ctx, event)) } aria-haspopup="dialog" aria-controls="calendar-event-details-content" hx-get={ calendarEventDetailsURL(event.ID) } hx-target="#app-pane-dialogs" hx-swap="innerHTML" hx-sync="#app-pane-dialogs:replace" hx-disabled-elt="this" data-calendar-event-trigger>
								<div class="flex items-start gap-3">
									<div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
										if event.AllDay {
											@icon.CalendarDays(icon.Props{Class: "size-4"})
										} else {
											@icon.Clock3(icon.Props{Class: "size-4"})
										}
									</div>
									<div class="min-w-0 flex-1">
										<div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
											<div class="flex min-w-0 items-center gap-2">
												<span class="size-2 shrink-0 rounded-full" style={ calendarEventColorStyle(event) }></span>
												<h3 class="truncate text-sm font-bold text-foreground" data-calendar-event-summary>{ calendarEventSummary(ctx, event) }</h3>
											</div>
											<span class="shrink-0 text-[11px] font-semibold text-primary">{ calendarEventAgendaDateLabel(ctx, event, month.Month.Location()) }</span>
										</div>
										<div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
											<p class="text-xs text-muted-foreground">{ calendarEventAgendaTimeLabel(ctx, event, month.Month.Location()) }</p>
											@CalendarEventResponseIndicator(event, false)
										</div>
										if calendarEventMeta(event) != "" {
											<p class="mt-1 truncate text-[11px] text-muted-foreground">{ calendarEventMeta(event) }</p>
										}
									</div>
								</div>
							</button>
						}
					</div>
				</div>
			}
		</div>
	</section>
}

// The sidebar comes first, as in MailAppPartial.
templ CalendarAppPartial(accounts []models.Account, month CalendarMonthData, uiSettings map[string]string) {
	@CalendarSidebarBody(accounts)
	<div id="sidebar-sync-controls">
		@SidebarSyncControls(accounts, "calendar")
	</div>
	@CalendarMainPane(month, uiSettings)
	@CalendarAgendaPane(month)
	<div id="app-pane-dialogs"></div>
	@ComposeAccountData(accounts)
}

templ CalendarMainPartial(month CalendarMonthData) {
	@CalendarMainContent(month)
}

// CalendarDayDots marks a day with one dot per calendar that has events on it. Only
// small screens show them, in place of the event chips.
templ CalendarDayDots(events []CalendarEvent) {
	<span class="calendar-day-dots" aria-hidden="true">
		for _, event := range calendarDaySourceDots(events) {
			<span class="calendar-day-dot" hidden?={ event.SourceHidden } data-calendar-day-dot data-calendar-source-id={ event.SourceID } data-calendar-source-hidden={ strconv.FormatBool(event.SourceHidden) } style={ calendarEventColorStyle(event) }></span>
		}
	</span>
}

// CalendarContextMenu opens where an event is right-clicked. app.js asks the
// server what the event allows, then shows the items that apply: the edit
// and delete ones in the shape the details dialog offers them.
templ CalendarContextMenu() {
	@popover.Root(popover.RootProps{ID: "calendar-context-menu", Attributes: templ.Attributes{"data-calendar-context-menu": ""}}) {
		@popover.Trigger() {
			<span class="pointer-events-none fixed left-0 top-0 size-px" aria-hidden="true" data-point-popover-anchor></span>
		}
		@popover.Content(popover.ContentProps{
			Placement:  popover.PlacementBottomStart,
			Offset:     2,
			Class:      "z-50 w-52 rounded-md border border-border bg-popover p-1 shadow-md focus:outline-none",
			Attributes: templ.Attributes{"role": "menu", "aria-label": i18n.T(ctx, "calendar.context.label")},
		}) {
			@dropdown.Label(dropdown.LabelProps{Class: "truncate text-xs font-medium text-muted-foreground", Attributes: templ.Attributes{"data-calendar-context-title": ""}})
			@calendarContextItem("open", i18n.T(ctx, "calendar.context.open"), "") {
				@icon.CalendarDays(icon.Props{Class: "size-4"})
			}
			@calendarContextItem("join", i18n.T(ctx, "calendar.join_meeting"), "") {
				@icon.Video(icon.Props{Class: "size-4"})
			}
			@calendarContextItem("forward", i18n.T(ctx, "calendar.context.forward"), "") {
				@icon.Forward(icon.Props{Class: "size-4"})
			}
			// Shown only when the event's actions are slow to arrive.
			<div class="flex items-center gap-2 px-2 py-1.5 text-sm text-muted-foreground" role="status" data-calendar-context-loading hidden>
				@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})
				{ i18n.T(ctx, "calendar.context.loading") }
			</div>
			<div data-calendar-context-group="respond">
				@dropdown.Separator()
				@dropdown.Sub(dropdown.SubProps{ID: "calendar-context-respond"}) {
					@dropdown.SubTrigger() {
						<span class="flex items-center gap-2">
							@icon.CircleCheck(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "calendar.response.going") }
						</span>
					}
					@dropdown.SubContent(dropdown.SubContentProps{Class: "w-40", Attributes: templ.Attributes{"role": "menu", "aria-label": i18n.T(ctx, "calendar.response.respond")}}) {
						for _, status := range []string{"accepted", "tentative", "declined"} {
							@dropdown.Item(dropdown.ItemProps{Class: "aria-[current=true]:bg-accent aria-[current=true]:text-accent-foreground", Attributes: templ.Attributes{"role": "menuitem", "data-calendar-context-action": "respond", "data-calendar-context-response": status}}) {
								<span class="flex items-center gap-2">
									<span class="flex size-4 items-center justify-center">
										@CalendarResponseIcon(status)
									</span>
									{ calendarResponseChoiceLabel(ctx, status) }
								</span>
							}
						}
					}
				}
			</div>
			<div data-calendar-context-group="change">
				@dropdown.Separator()
				@calendarContextItem("edit", i18n.T(ctx, "calendar.context.edit"), "") {
					@icon.Pencil(icon.Props{Class: "size-4"})
				}
				@calendarContextItem("edit-series", i18n.T(ctx, "calendar.context.edit_series"), "") {
					@icon.Pencil(icon.Props{Class: "size-4"})
				}
				@dropdown.Sub(dropdown.SubProps{ID: "calendar-context-edit", Attributes: templ.Attributes{"data-calendar-context-sub": "edit"}}) {
					@dropdown.SubTrigger() {
						<span class="flex items-center gap-2">
							@icon.Pencil(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "calendar.edit") }
						</span>
					}
					@dropdown.SubContent(dropdown.SubContentProps{Class: "w-40", Attributes: templ.Attributes{"role": "menu", "aria-label": i18n.T(ctx, "calendar.edit")}}) {
						@calendarContextItem("edit-occurrence", i18n.T(ctx, "calendar.context.this_event"), "") {}
						@calendarContextItem("edit-whole-series", i18n.T(ctx, "calendar.context.entire_series"), "") {}
					}
				}
				@calendarContextItem("delete", i18n.T(ctx, "calendar.source.delete"), "text-destructive "+menuDestructiveClass) {
					@icon.Trash2(icon.Props{Class: "size-4"})
				}
				@calendarContextItem("delete-series", i18n.T(ctx, "calendar.context.delete_series"), "text-destructive "+menuDestructiveClass) {
					@icon.Trash2(icon.Props{Class: "size-4"})
				}
				@dropdown.Sub(dropdown.SubProps{ID: "calendar-context-delete", Attributes: templ.Attributes{"data-calendar-context-sub": "delete"}}) {
					@dropdown.SubTrigger(dropdown.SubTriggerProps{Class: "text-destructive " + menuDestructiveClass}) {
						<span class="flex items-center gap-2">
							@icon.Trash2(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "calendar.delete") }
						</span>
					}
					@dropdown.SubContent(dropdown.SubContentProps{Class: "w-40", Attributes: templ.Attributes{"role": "menu", "aria-label": i18n.T(ctx, "calendar.delete")}}) {
						@calendarContextItem("delete-occurrence", i18n.T(ctx, "calendar.context.this_event"), "text-destructive "+menuDestructiveClass) {}
						@calendarContextItem("delete-whole-series", i18n.T(ctx, "calendar.context.entire_series"), "text-destructive "+menuDestructiveClass) {}
					}
				}
			</div>
		}
	}
}

templ calendarContextItem(action string, label string, class string) {
	@dropdown.Item(dropdown.ItemProps{Class: class, Attributes: templ.Attributes{"role": "menuitem", "data-calendar-context-action": action}}) {
		<span class="flex items-center gap-2">
			{ children... }
			{ label }
		</span>
	}
}
