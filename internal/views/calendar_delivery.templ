package views

import (
	"net/url"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/icon"
)

templ CalendarDeliveryStatus(data CalendarDeliveryData) {
	<section id="calendar-event-delivery" class="mt-3 border-t border-border/60 pt-3 text-xs" aria-label="Invitation delivery and incoming replies">
		if len(data.Rows) == 0 {
			<p class="text-muted-foreground">{ data.EmptyNote }</p>
		} else {
			<div class="max-h-40 space-y-2 overflow-y-auto overscroll-contain" aria-live="polite" aria-atomic="false">
				for _, row := range data.Rows {
					<div class="flex items-start gap-2" data-calendar-delivery-state={ row.State }>
						<span class="mt-0.5 shrink-0" aria-hidden="true">
							if row.State == "pending" || row.State == "sending" || row.State == "processing" || row.State == "retry" {
								@icon.LoaderCircle(icon.Props{Class: "size-3.5 animate-spin text-muted-foreground"})
							} else if row.State == "sent" || row.State == "complete" {
								@icon.Check(icon.Props{Class: "size-3.5 text-emerald-600 dark:text-emerald-400"})
							} else {
								@icon.TriangleAlert(icon.Props{Class: "size-3.5 text-muted-foreground"})
							}
						</span>
						<div class="min-w-0 flex-1">
							<p class="font-medium">{ row.Label }</p>
							if row.Recipient != "" {
								<p class="truncate text-muted-foreground" title={ row.Recipient }>{ row.Recipient }</p>
							}
							<p class="mt-0.5 leading-relaxed text-muted-foreground">{ row.Note }</p>
						</div>
						if row.CanRetry {
							@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Class: "h-7 shrink-0 px-2 text-xs", Attributes: templ.Attributes{
								"hx-post": calendarEventDetailsURL(data.EventID) + "/delivery/" + url.PathEscape(row.ID) + "/retry",
								"hx-target": "#calendar-event-guests", "hx-swap": "outerHTML", "hx-sync": "#calendar-event-guests:replace",
								"hx-disabled-elt": "this", "hx-params": "none", "aria-label": "Retry invitation delivery to " + row.Recipient,
							}}) {
								<span class="[[disabled]_&]:hidden">Retry</span>
								<span class="hidden [[disabled]_&]:inline">Retrying…</span>
							}
						}
					</div>
				}
			</div>
			if data.HasEmailDelivery {
				<p class="mt-2 text-[11px] leading-relaxed text-muted-foreground">Sent means the mail server accepted the invitation—not that the guest accepted it.</p>
			}
		}
		if data.Error != "" {
			<p role="alert" class="mt-2 text-destructive">{ data.Error }</p>
		}
	</section>
}
