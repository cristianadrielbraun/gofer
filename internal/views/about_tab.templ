package views

import (
	"strconv"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/collapsible"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/attribution"
	"github.com/cristianadrielbraun/gofer/internal/buildinfo"
	"github.com/cristianadrielbraun/gofer/internal/updatecheck"
)

const goferRepositoryURL = "https://github.com/cristianadrielbraun/gofer"

// The About tab says which build of Gofer is running. Everyone can open it,
// whatever the mode or role.
templ SettingsAboutTab(info buildinfo.Info) {
	<div class="mt-6 space-y-6" data-settings-about>
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">Version</h3>
				<p class="text-xs text-muted-foreground leading-relaxed">
					if info.Release() {
						This is a release build of Gofer.
					} else {
						This copy of Gofer was built from source.
					}
				</p>
			</div>
			<dl class="settings-row border-t border-border/60 pt-5 grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 text-sm">
				if info.Release() {
					@aboutField("Release") {
						<a href={ templ.SafeURL(goferRepositoryURL + "/releases/tag/" + info.Version) } target="_blank" rel="noopener noreferrer" class="font-medium text-foreground hover:text-primary" data-about-version>{ info.Version }</a>
					}
				} else {
					@aboutField("Version") {
						<span class="font-medium text-foreground" data-about-version>Development build</span>
					}
				}
				if info.Branch != "" {
					@aboutField("Branch") {
						<span class="font-mono" data-about-branch>{ info.Branch }</span>
					}
				}
				if info.Commit != "" {
					@aboutField("Commit") {
						<a href={ templ.SafeURL(goferRepositoryURL + "/commit/" + info.Commit) } target="_blank" rel="noopener noreferrer" class="font-mono text-foreground hover:text-primary" title={ info.Commit } data-about-commit>{ info.ShortCommit() }</a>
						if info.Modified {
							<span class="ml-2 text-xs text-muted-foreground">with uncommitted changes</span>
						}
					}
				}
				if !info.CommitTime.IsZero() {
					@aboutField("Commit date") {
						<time datetime={ info.CommitTime.UTC().Format("2006-01-02T15:04:05Z") }>{ info.CommitTime.UTC().Format("January 2, 2006") }</time>
					}
				}
				if info.GoVersion != "" {
					@aboutField("Built with") {
						<span class="font-mono">{ info.GoVersion }</span>
					}
				}
			</dl>
			<div class="settings-row border-t border-border/60 pt-5">
				<a href={ templ.SafeURL(goferRepositoryURL) } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-foreground hover:text-primary">
					@icon.Github(icon.Props{Class: "size-4"})
					Gofer on GitHub
					@icon.ExternalLink(icon.Props{Class: "size-3.5 text-muted-foreground"})
				</a>
			</div>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">Updates</h3>
				<p class="text-xs text-muted-foreground leading-relaxed">
					if info.Release() {
						Gofer never checks on its own. Checking asks GitHub for the latest release.
					} else {
						Gofer never checks on its own. Checking asks GitHub for commits on { updatecheck.Base } that this build does not have, whichever branch it was built from.
					}
				</p>
			</div>
			@AboutUpdateCheck(nil, "")
		</div>
		@aboutLibraries(attribution.Bundled(), attribution.GoModules())
	</div>
}

templ aboutLibraries(bundled, modules []attribution.Library) {
	<div class="settings-card bg-card rounded-lg border p-6 space-y-5" data-about-libraries>
		<div>
			<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">Open-source software</h3>
			<p class="text-xs text-muted-foreground leading-relaxed">
				Gofer is built on the work of these projects.
				<a href="/settings/about/licenses" target="_blank" class="text-primary hover:underline">Read the full license texts</a>.
			</p>
		</div>
		<div class="settings-row border-t border-border/60 pt-5">
			@aboutLibraryList(bundled)
		</div>
		<div class="settings-row border-t border-border/60 pt-5">
			@collapsible.Collapsible() {
				@collapsible.Trigger(collapsible.TriggerProps{Class: "group cursor-pointer"}) {
					<button type="button" class="inline-flex items-center gap-1.5 text-sm text-foreground hover:text-primary">
						@icon.ChevronRight(icon.Props{Class: "size-4 transition-transform group-aria-expanded:rotate-90"})
						{ strconv.Itoa(len(modules)) } Go modules
					</button>
				}
				@collapsible.Content() {
					<div class="pt-4">
						@aboutLibraryList(modules)
					</div>
				}
			}
		</div>
	</div>
}

templ aboutLibraryList(libs []attribution.Library) {
	<ul class="space-y-2 text-sm">
		for _, lib := range libs {
			<li class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 min-w-0">
				<a href={ templ.URL(lib.URL) } target="_blank" rel="noopener noreferrer" class="text-foreground hover:text-primary break-all">{ lib.Name }</a>
				if lib.Version != "" {
					<span class="font-mono text-xs text-muted-foreground">{ lib.Version }</span>
				}
				<span class="ml-auto shrink-0 text-xs text-muted-foreground">{ lib.License }</span>
			</li>
		}
	</ul>
}

// AboutUpdateCheck is the check button with the last check's outcome, if
// any: result, or errMsg when the check failed.
templ AboutUpdateCheck(result *updatecheck.Result, errMsg string) {
	<div id="about-update-check" class="settings-row border-t border-border/60 pt-5 space-y-4">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
			<div class="min-w-0 text-sm" data-about-update-status>
				if errMsg != "" {
					<p class="text-destructive">{ errMsg }</p>
				} else if result == nil {
					<p class="text-muted-foreground">Not checked yet.</p>
				} else if result.Source {
					@aboutSourceStatus(*result)
				} else {
					@aboutReleaseStatus(*result)
				}
			</div>
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Class:   "shrink-0 group",
				Attributes: templ.Attributes{
					"hx-post":         "/api/settings/about/update-check",
					"hx-target":       "#about-update-check",
					"hx-swap":         "outerHTML",
					"hx-disabled-elt": "this",
				},
			}) {
				@icon.RefreshCw(icon.Props{Class: "size-3.5 group-[.htmx-request]:animate-spin"})
				if result == nil && errMsg == "" {
					Check for updates
				} else {
					Check again
				}
			}
		</div>
		if result != nil && !result.Source && result.Available && result.Latest.Notes != "" {
			<div class="rounded-md border border-border/60 bg-muted/30 p-3 max-h-64 overflow-y-auto">
				<p class="text-xs font-medium text-muted-foreground mb-2">Release notes</p>
				<div class="text-xs text-foreground whitespace-pre-wrap break-words leading-relaxed" data-about-release-notes>{ result.Latest.Notes }</div>
			</div>
		}
		if result != nil && result.Source && len(result.Commits) > 0 {
			<ul class="space-y-1.5 text-xs" data-about-commits>
				for _, c := range result.Commits {
					<li class="flex items-baseline gap-3 min-w-0">
						<a href={ templ.URL(c.URL) } target="_blank" rel="noopener noreferrer" class="font-mono text-muted-foreground hover:text-primary shrink-0">{ shortSHA(c.SHA) }</a>
						<span class="truncate text-foreground" title={ c.Title }>{ c.Title }</span>
						if !c.Date.IsZero() {
							<span class="ml-auto shrink-0 text-muted-foreground">{ c.Date.UTC().Format("Jan 2") }</span>
						}
					</li>
				}
			</ul>
		}
	</div>
}

templ aboutReleaseStatus(r updatecheck.Result) {
	if r.Latest.Tag == "" {
		<p class="text-muted-foreground">No releases are published yet.</p>
	} else if r.Available {
		<p class="font-medium text-foreground">
			<a href={ templ.URL(r.Latest.URL) } target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{ r.Latest.Tag }</a> is available.
		</p>
		if !r.Latest.PublishedAt.IsZero() {
			<p class="text-xs text-muted-foreground mt-0.5">Released { r.Latest.PublishedAt.UTC().Format("January 2, 2006") }</p>
		}
	} else {
		<p class="text-foreground">Gofer is up to date.</p>
	}
}

templ aboutSourceStatus(r updatecheck.Result) {
	if r.Unknown {
		<p class="text-foreground">This build has local commits that are not on GitHub, so it cannot be compared with { updatecheck.Base }.</p>
		if r.Head.SHA != "" {
			<p class="text-xs text-muted-foreground mt-1" data-about-master-head>
				Latest on { updatecheck.Base }:
				<a href={ templ.URL(r.Head.URL) } target="_blank" rel="noopener noreferrer" class="font-mono hover:text-primary">{ shortSHA(r.Head.SHA) }</a>
				{ r.Head.Title }
				if !r.Head.Date.IsZero() {
					· { r.Head.Date.UTC().Format("January 2, 2006") }
				}
			</p>
		}
	} else if r.Available {
		<p class="font-medium text-foreground">
			Compared with { updatecheck.Base }:
			if r.Behind == 1 {
				1 newer commit.
			} else {
				{ strconv.Itoa(r.Behind) } newer commits.
			}
			if r.CompareURL != "" {
				<a href={ templ.URL(r.CompareURL) } target="_blank" rel="noopener noreferrer" class="ml-1 font-normal text-primary hover:underline">See all changes</a>
			}
		</p>
		if r.Diverged {
			<p class="text-xs text-muted-foreground mt-0.5">This build also has commits that are not on { updatecheck.Base }.</p>
		}
	} else if r.Diverged {
		<p class="text-foreground">Compared with { updatecheck.Base }: this build has commits that are not on it, and nothing new there.</p>
	} else {
		<p class="text-foreground">Compared with { updatecheck.Base }: this build has everything on it.</p>
	}
}

func shortSHA(sha string) string {
	if len(sha) > 7 {
		return sha[:7]
	}
	return sha
}

templ aboutField(label string) {
	<dt class="text-muted-foreground">{ label }</dt>
	<dd class="min-w-0 text-foreground">{ children... }</dd>
}
