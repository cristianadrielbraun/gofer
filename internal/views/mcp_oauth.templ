package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// MCPConsentData is the page where a signed-in user lets an AI client reach
// Gofer's MCP server, choosing what it may do.
type MCPConsentData struct {
	ClientName string
	RedirectTo string
	Scopes     []string
	Mailboxes  []MCPMailboxChoice
	Requested  map[string]bool
	Hidden     map[string]string
	CSRF       string
	UserName   string
	Error      string
	FatalError string
}

templ MCPConsentPage(data MCPConsentData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "mcp.consent.title") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-md">
					<div class="text-center mb-6">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						if data.FatalError != "" {
							<h1 class="mt-6 text-2xl font-semibold">{ i18n.T(ctx, "mcp.consent.cannot_title") }</h1>
						} else {
							<h1 class="mt-6 text-2xl font-semibold">{ i18n.T(ctx, "mcp.consent.heading", "client", data.ClientName) }</h1>
							<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "mcp.consent.description", "user", data.UserName) }</p>
						}
					</div>
					if data.FatalError != "" {
						<div role="alert" class="bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm" data-mcp-consent-fatal>{ data.FatalError }</div>
					} else {
						if data.Error != "" {
							<div role="alert" class="bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm mb-4">{ data.Error }</div>
						}
						<form method="post" action="/oauth/authorize" class="space-y-4" data-mcp-consent>
							<input type="hidden" name="_csrf" value={ data.CSRF }/>
							for name, value := range data.Hidden {
								<input type="hidden" name={ name } value={ value }/>
							}
							<fieldset class="space-y-3 rounded-lg border border-border bg-card p-4">
								<legend class="px-1 text-sm font-medium">{ i18n.T(ctx, "mcp.consent.scopes") }</legend>
								for _, scope := range data.Scopes {
									<label class="flex cursor-pointer items-start gap-2 text-sm">
										@checkbox.Checkbox(checkbox.Props{Name: "scope", Value: scope, Checked: data.Requested[scope], Class: "mt-0.5", Attributes: templ.Attributes{"data-mcp-consent-scope": scope}})
										<span class="min-w-0">
											<span class="font-medium">{ mcpScopeLabel(ctx, scope) }</span>
											<span class="block text-xs text-muted-foreground">{ mcpScopeDescription(ctx, scope) }</span>
										</span>
									</label>
								}
							</fieldset>
							if len(data.Mailboxes) > 0 {
								<div class="rounded-lg border border-border bg-card p-4">
									@mcpMailboxChooser(data.Mailboxes, "mcp-consent")
								</div>
							}
							<p class="text-xs text-muted-foreground break-all">{ i18n.T(ctx, "mcp.consent.redirect", "to", data.RedirectTo) }</p>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "mcp.consent.revoke_hint") }</p>
							<div class="flex gap-2">
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeLg, Class: "flex-1", Attributes: templ.Attributes{"name": "decision", "value": "deny"}}) {
									{ i18n.T(ctx, "mcp.consent.deny") }
								}
								@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "flex-1", Attributes: templ.Attributes{"name": "decision", "value": "allow", "data-mcp-consent-allow": ""}}) {
									{ i18n.T(ctx, "mcp.consent.allow") }
								}
							</div>
						</form>
					}
				</div>
			</main>
		</body>
	</html>
}
