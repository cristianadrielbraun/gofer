package views

import (
	"context"
	"fmt"
	"strings"

	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/models"

	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/tooltip"
)

// The folder picker is the folder list the dialogs that choose folders
// share: a search field in the dialog's header, then each account under a
// header that stays in view, with its folders as a tree. A folder inside
// another one names the folders above it under its own name, and the search
// looks at the account and the whole path, so a parent's name finds the
// folders inside it too (folder-picker.js). Each dialog brings its own rows:
// checkboxes to choose several folders, or buttons to choose one.

// folderPickerContentClass makes a dialog's header and footer fixed bars
// with only the folder list between them scrolling. It is wide enough for
// deeply nested folders' names and at most 80% of the window's height.
const folderPickerContentClass = "sm:max-w-2xl max-h-[80dvh] [&>[data-tui-dialog-panel]]:flex [&>[data-tui-dialog-panel]]:max-h-[80dvh] [&>[data-tui-dialog-panel]]:min-h-0 [&>[data-tui-dialog-panel]]:flex-col [&>[data-tui-dialog-panel]]:gap-0 [&>[data-tui-dialog-panel]]:p-0"

// folderPickerSearch is the search field, for the dialog's header.
templ folderPickerSearch(label string, attrs templ.Attributes) {
	<div class="relative">
		@icon.Search(icon.Props{Class: "pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground"})
		<input type="search" placeholder={ label } aria-label={ label } autocomplete="off" class="h-9 w-full rounded-md border border-input bg-background pl-9 pr-3 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring" data-folder-picker-search { attrs... }/>
	</div>
}

// folderPickerList is the scrolling list of accounts. empty shows when the
// search matches no folder. The line above it is drawn over the list rather
// than as its border: at some zoom levels the line lands between two pixels,
// and the account header stuck to the top would cover half of it everywhere
// but beside the scrollbar, where it would look thicker.
templ folderPickerList(empty string, attrs templ.Attributes) {
	<div class="relative flex min-h-0 flex-1 flex-col">
		<div class="pointer-events-none absolute inset-x-0 top-0 z-20 h-px bg-border" aria-hidden="true"></div>
		<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain border-b border-border" data-folder-picker-list { attrs... }>
			{ children... }
			<p class="hidden px-6 py-4 text-sm text-muted-foreground" data-folder-picker-empty>{ empty }</p>
		</div>
	</div>
}

// folderPickerAccount is one account: its header, with an optional note at
// the right, and then its rows. A search that matches none of its folders
// hides it, unless it has a row marked data-folder-picker-keep.
templ folderPickerAccount(account models.Account, note string) {
	<section data-folder-picker-account>
		// One pixel above the top, so a dialog centered on a half pixel
		// shows no sliver of the scrolled rows above the header.
		<div class="sticky -top-px z-10 flex items-center gap-2 bg-muted px-6 py-2">
			<div class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(account.Color) }></div>
			<span class="min-w-0 truncate text-xs font-semibold text-foreground">{ accountTitle(account) }</span>
			if note != "" {
				<span class="ml-auto shrink-0 text-[11px] text-muted-foreground">{ note }</span>
			}
		</div>
		{ children... }
	</section>
}

// folderPickerName is a row's folder: its icon and name, as the sidebar
// shows them, and the folders above it. When the name or the path is cut
// short, a tooltip names the whole path (folder-picker.js switches it off
// for rows that fit).
templ folderPickerName(entry folderPickerEntry) {
	<span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
		@FolderAppearanceIcon(entry.Folder)
	</span>
	@tooltip.Tooltip() {
		@tooltip.Trigger(tooltip.TriggerProps{Attributes: templ.Attributes{"data-folder-picker-tip": ""}}) {
			<span class="min-w-0 flex-1 text-sm">
				<span class="block truncate">{ i18n.FolderName(ctx, entry.Folder.Role, entry.Folder.Name) }</span>
				if entry.Parent != "" {
					<span class="block truncate text-[11px] text-muted-foreground">{ entry.Parent }</span>
				}
			</span>
		}
		// It can't be clicked: in the search picker that would tick the
		// row's checkbox.
		@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "pointer-events-none px-3 py-1.5 text-xs"}) {
			{ entry.Path }
		}
	}
}

// folderPickerEntry is one folder of an account's tree, flattened.
type folderPickerEntry struct {
	Folder   models.Folder
	Depth    int
	ParentID string
	// Parent names the folders above it, "Inbox / Projects"; Path adds the
	// folder itself.
	Parent string
	Path   string
	// Search is what the search field looks in: the account and the path.
	Search string
}

// folderPickerEntries flattens an account's folders in tree order. Starred
// is a view, not a place, so only pickers that search it list it; the
// folders inside it are listed either way.
func folderPickerEntries(ctx context.Context, account models.Account, withStarred bool) []folderPickerEntry {
	var entries []folderPickerEntry
	var walk func([]models.Folder, int, string, string)
	walk = func(folders []models.Folder, depth int, parentID, parent string) {
		for _, folder := range folders {
			name := i18n.FolderName(ctx, folder.Role, folder.Name)
			path := name
			if parent != "" {
				path = parent + " / " + name
			}
			if withStarred || folder.Role != "starred" {
				search := accountTitle(account) + " " + path
				if name != folder.Name {
					search += " " + folder.Name
				}
				entries = append(entries, folderPickerEntry{Folder: folder, Depth: depth, ParentID: parentID, Parent: parent, Path: path, Search: strings.ToLower(search)})
			}
			walk(folder.Children, depth+1, folder.ID, path)
		}
	}
	walk(account.Folders, 0, "", "")
	return entries
}

// folderPickerIndent indents a row by its depth in the tree.
func folderPickerIndent(depth int) string {
	return fmt.Sprintf("padding-left: %dpx", 24+min(depth, 8)*16)
}
