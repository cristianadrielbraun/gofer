package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/calendar"
)

templ calendarDescriptionCommand(command, title string, glyph templ.Component) {
	@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-7 shrink-0 text-muted-foreground", Attributes: templ.Attributes{"aria-label": title, "title": title, "data-calendar-description-command": command, "data-on-click": onAction("calendarDescriptionExec", actionElement, actionData("calendarDescriptionCommand")), "data-on-mousedown": onAction("goferPreventDefault", actionEvent)}}) {
		@glyph
	}
}

templ CalendarDescriptionEditor(data CalendarCreateData) {
	{{ rich := data.DescriptionHTML; if rich == "" { rich = calendar.DescriptionHTML(data.Description) } }}
	<label for="calendar-create-description" class="sr-only">{ i18n.T(ctx, "calendar.description") }</label>
	<div data-calendar-description-slot>
		<div class="relative" data-calendar-description-editor>
			<div class="relative flex min-h-0 flex-col" data-calendar-description-content>
				<textarea name="description" hidden>{ data.Description }</textarea>
				<textarea name="description_html" hidden>{ rich }</textarea>
				<div class="relative flex shrink-0 flex-wrap items-center gap-0.5 border-b border-input px-1.5 py-1 pr-10" role="toolbar" aria-label={ i18n.T(ctx, "calendar.description.formatting") } data-calendar-description-toolbar>
					@calendarDescriptionCommand("bold", i18n.T(ctx, "calendar.format.bold"), icon.Bold(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("italic", i18n.T(ctx, "calendar.format.italic"), icon.Italic(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("underline", i18n.T(ctx, "calendar.format.underline"), icon.Underline(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("strikeThrough", i18n.T(ctx, "calendar.format.strikethrough"), icon.Strikethrough(icon.Props{Class: "size-3.5"}))
					<div class="mx-1 h-4 w-px bg-border"></div>
					@calendarDescriptionCommand("insertUnorderedList", i18n.T(ctx, "calendar.format.bulleted_list"), icon.List(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("insertOrderedList", i18n.T(ctx, "calendar.format.numbered_list"), icon.ListOrdered(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("createLink", i18n.T(ctx, "calendar.format.insert_link"), icon.Link(icon.Props{Class: "size-3.5"}))
					@dropdown.Dropdown() {
						@dropdown.Trigger() {
							@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-7 text-muted-foreground", Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "calendar.format.more"), "data-on-mousedown": onAction("goferPreventDefault", actionEvent)}}) {
								@icon.Ellipsis(icon.Props{Class: "size-3.5"})
								}
						}
						@dropdown.Content() {
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("calendarDescriptionExec", actionElement, "formatBlock", "p")}}) { { i18n.T(ctx, "calendar.format.paragraph") } }
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("calendarDescriptionExec", actionElement, "formatBlock", "h3")}}) { { i18n.T(ctx, "calendar.format.heading") } }
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("calendarDescriptionExec", actionElement, "formatBlock", "blockquote")}}) { { i18n.T(ctx, "calendar.format.quote") } }
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("calendarDescriptionExec", actionElement, "formatBlock", "pre")}}) { { i18n.T(ctx, "calendar.format.code") } }
							@dropdown.Separator()
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("calendarDescriptionExec", actionElement, "removeFormat")}}) { { i18n.T(ctx, "calendar.format.clear") } }
						}
					}
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "absolute top-1 right-1 size-7 text-muted-foreground", Attributes: templ.Attributes{"data-calendar-description-toggle": "", "aria-label": i18n.T(ctx, "calendar.description.expand"), "title": i18n.T(ctx, "calendar.description.expand"), "aria-controls": "calendar-create-description", "aria-expanded": "false", "data-on-click": onAction("toggleCalendarDescription", actionClosest("[data-calendar-create-form]"))}}) {
						<span data-calendar-description-expand>@icon.Maximize2(icon.Props{Class: "size-4"})</span>
						<span data-calendar-description-collapse hidden>@icon.Minimize2(icon.Props{Class: "size-4"})</span>
					}
				</div>
				<div class="relative min-h-0 max-h-56 flex-1 overflow-y-auto overscroll-contain px-3 py-2" data-calendar-description-scroll>
					<div id="calendar-create-description" class="compose-rich-editor calendar-rich-description min-h-24 outline-none" contenteditable="true" role="textbox" aria-multiline="true" aria-label={ i18n.T(ctx, "calendar.description") } data-calendar-rich-editor data-placeholder={ i18n.T(ctx, "calendar.description.add") } data-on-input='["syncCalendarDescription","$this"]' data-on-focus='["calendarDescriptionSelection","$this"]' data-on-keyup='["calendarDescriptionSelection","$this"]' data-on-mouseup='["calendarDescriptionSelection","$this"]' data-on-paste='["pasteCalendarDescription","$event"]' data-on-drop='["pasteCalendarDescription","$event"]'>
						@templ.Raw(calendar.SanitizeDescriptionHTML(rich))
					</div>
				</div>
			</div>
		</div>
	</div>
}
