package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/calendar"
)

templ calendarDescriptionCommand(command, title string, glyph templ.Component) {
	@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-7 shrink-0 text-muted-foreground", Attributes: templ.Attributes{"aria-label": title, "title": title, "data-calendar-description-command": command, "onclick": "calendarDescriptionExec(this, this.dataset.calendarDescriptionCommand)", "onmousedown": "event.preventDefault()"}}) {
		@glyph
	}
}

templ CalendarDescriptionEditor(data CalendarCreateData) {
	{{ rich := data.DescriptionHTML; if rich == "" { rich = calendar.DescriptionHTML(data.Description) } }}
	<label for="calendar-create-description" class="sr-only">Description</label>
	<div data-calendar-description-slot>
		<div class="relative" data-calendar-description-editor>
			<div class="relative flex min-h-0 flex-col" data-calendar-description-content>
				<textarea name="description" hidden>{ data.Description }</textarea>
				<textarea name="description_html" hidden>{ rich }</textarea>
				<div class="relative flex shrink-0 flex-wrap items-center gap-0.5 border-b border-input px-1.5 py-1 pr-10" role="toolbar" aria-label="Description formatting" data-calendar-description-toolbar>
					@calendarDescriptionCommand("bold", "Bold", icon.Bold(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("italic", "Italic", icon.Italic(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("underline", "Underline", icon.Underline(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("strikeThrough", "Strikethrough", icon.Strikethrough(icon.Props{Class: "size-3.5"}))
					<div class="mx-1 h-4 w-px bg-border"></div>
					@calendarDescriptionCommand("insertUnorderedList", "Bulleted list", icon.List(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("insertOrderedList", "Numbered list", icon.ListOrdered(icon.Props{Class: "size-3.5"}))
					@calendarDescriptionCommand("createLink", "Insert link", icon.Link(icon.Props{Class: "size-3.5"}))
					@dropdown.Dropdown() {
						@dropdown.Trigger() {
							@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-7 text-muted-foreground", Attributes: templ.Attributes{"aria-label": "More formatting", "onmousedown": "event.preventDefault()"}}) {
								@icon.Ellipsis(icon.Props{Class: "size-3.5"})
								}
						}
						@dropdown.Content() {
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"onclick": "calendarDescriptionExec(this, 'formatBlock', 'p')"}}) { Paragraph }
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"onclick": "calendarDescriptionExec(this, 'formatBlock', 'h3')"}}) { Heading }
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"onclick": "calendarDescriptionExec(this, 'formatBlock', 'blockquote')"}}) { Quote }
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"onclick": "calendarDescriptionExec(this, 'formatBlock', 'pre')"}}) { Code }
							@dropdown.Separator()
							@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"onclick": "calendarDescriptionExec(this, 'removeFormat')"}}) { Clear formatting }
						}
					}
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "absolute top-1 right-1 size-7 text-muted-foreground", Attributes: templ.Attributes{"data-calendar-description-toggle": "", "aria-label": "Expand description", "title": "Expand description", "aria-controls": "calendar-create-description", "aria-expanded": "false", "onclick": "toggleCalendarDescription(this.closest('[data-calendar-create-form]'))"}}) {
						<span data-calendar-description-expand>@icon.Maximize2(icon.Props{Class: "size-4"})</span>
						<span data-calendar-description-collapse hidden>@icon.Minimize2(icon.Props{Class: "size-4"})</span>
					}
				</div>
				<div class="relative min-h-0 max-h-56 flex-1 overflow-y-auto overscroll-contain px-3 py-2" data-calendar-description-scroll>
					<div id="calendar-create-description" class="compose-rich-editor calendar-rich-description min-h-24 outline-none" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Description" data-calendar-rich-editor data-placeholder="Add description" oninput="syncCalendarDescription(this)" onfocus="calendarDescriptionSelection(this)" onkeyup="calendarDescriptionSelection(this)" onmouseup="calendarDescriptionSelection(this)" onpaste="pasteCalendarDescription(event)" ondrop="pasteCalendarDescription(event)">
						@templ.Raw(calendar.SanitizeDescriptionHTML(rich))
					</div>
				</div>
			</div>
		</div>
	</div>
}
