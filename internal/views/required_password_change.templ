package views

import (
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

templ RequiredPasswordChangePage(message, csrf, logoutCSRF string) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "signin.title.change") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm space-y-6">
					<div>
						<h1 class="text-2xl font-bold">{ i18n.T(ctx, "signin.change.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "signin.change.description") }</p>
					</div>
					if message != "" {
						<p role="alert" class="text-sm text-destructive">{ message }</p>
					}
					<form method="post" action="/account/change-password" class="space-y-4">
						<input type="hidden" name="_csrf" value={ csrf }/>
						<div class="space-y-2">
							<label for="required-current-password" class="text-sm font-semibold">{ i18n.T(ctx, "signin.change.current") }</label>
							<input id="required-current-password" name="current_password" type="password" autocomplete="current-password" required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
						</div>
						<div class="space-y-2">
							<label for="required-new-password" class="text-sm font-semibold">{ i18n.T(ctx, "signin.change.new") }</label>
							<input id="required-new-password" name="new_password" type="password" autocomplete="new-password" required minlength="15" aria-describedby="required-password-help" class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
							<p id="required-password-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "signin.change.help") }</p>
						</div>
						<div class="space-y-2">
							<label for="required-confirm-password" class="text-sm font-semibold">{ i18n.T(ctx, "signin.change.confirm") }</label>
							<input id="required-confirm-password" name="confirm_password" type="password" autocomplete="new-password" required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							{ i18n.T(ctx, "signin.change.submit") }
						}
					</form>
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "signin.change.forgot") } <a href="/account/redeem" class="text-primary underline">{ i18n.T(ctx, "signin.change.use_token") }</a>.</p>
					<form method="post" action="/auth/logout">
						<input type="hidden" name="_csrf" value={ logoutCSRF }/>
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, FullWidth: true}) {
							{ i18n.T(ctx, "signin.sign_out") }
						}
					</form>
				</div>
			</main>
		</body>
	</html>
}
