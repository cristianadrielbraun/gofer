package views

import (
	"context"
	"fmt"
	"strings"

	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	"github.com/cristianadrielbraun/gofer/components/tabs"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

func adminMailSecurityEndpoint(item models.MailSecurityException) string {
	if item.Kind == models.MailSecurityExceptionHTTPDiscovery {
		return item.Host
	}
	return strings.ToUpper(item.Protocol) + " " + item.Host + ":" + fmt.Sprintf("%d", item.Port)
}

func adminMailSecurityKindLabel(ctx context.Context, item models.MailSecurityException) string {
	if item.Kind == models.MailSecurityExceptionHTTPDiscovery {
		return i18n.T(ctx, "admin.security.kind.http")
	}
	if item.Kind == models.MailSecurityExceptionPrivateTarget {
		return i18n.T(ctx, "admin.security.kind.private")
	}
	return i18n.T(ctx, "admin.security.kind.plaintext")
}

func adminMailSecurityAccounts(item models.MailSecurityException) string {
	accounts := make([]string, 0, len(item.Accounts))
	for _, account := range item.Accounts {
		accounts = append(accounts, account.Email)
	}
	return strings.Join(accounts, ", ")
}

templ AdminSecurityPage(data models.MailSecurityAdminData, verification ...AdminSecurityVerificationData) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="mb-7">
					<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.security") }</h2>
					<p class="mt-1 max-w-3xl text-sm text-muted-foreground">
						if data.Allowlist != nil {
							{ i18n.T(ctx, "admin.security.description_allowlist") }
						} else {
							{ i18n.T(ctx, "admin.security.description") }
						}
					</p>
				</div>
				if data.Allowlist != nil {
					@tabs.Tabs(tabs.Props{ID: "mail-security-tabs"}) {
						@tabs.List(tabs.ListProps{Class: "bg-card"}) {
							@tabs.Trigger(tabs.TriggerProps{Value: "allowlist", IsActive: data.Tab != "exceptions" && data.Tab != "proxies"}) {
								{ i18n.T(ctx, "admin.allowlist.tab") }
								if len(data.Allowlist.Refused) > 0 {
									<span class="rounded-full bg-red-500/12 px-1.5 text-[11px] font-semibold tabular-nums text-red-700 dark:text-red-300">{ i18n.T(ctx, "admin.allowlist.refused_count", "count", i18n.Number(ctx, len(data.Allowlist.Refused))) }</span>
								}
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "exceptions", IsActive: data.Tab == "exceptions"}) {
								{ i18n.T(ctx, "admin.security.exceptions_tab") }
								if len(data.Exceptions) > 0 {
									<span class="rounded-full bg-muted px-1.5 text-[11px] font-semibold tabular-nums text-muted-foreground">{ i18n.Number(ctx, len(data.Exceptions)) }</span>
								}
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "proxies", IsActive: data.Tab == "proxies"}) {
								{ i18n.T(ctx, "admin.proxies.tab") }
								if len(data.Proxies) > 0 {
									<span class="rounded-full bg-muted px-1.5 text-[11px] font-semibold tabular-nums text-muted-foreground">{ i18n.Number(ctx, len(data.Proxies)) }</span>
								}
							}
						}
						@tabs.Content(tabs.ContentProps{Value: "allowlist", IsActive: data.Tab != "exceptions" && data.Tab != "proxies", Class: "mt-6"}) {
							@MailAllowlistPanel(data, *data.Allowlist)
						}
						@tabs.Content(tabs.ContentProps{Value: "exceptions", IsActive: data.Tab == "exceptions", Class: "mt-6"}) {
							<p class="mb-4 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.exceptions_intro") }</p>
							if mailAllowlistServersLimited(*data.Allowlist) {
								<div class="mb-5 flex items-start gap-3 rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">
									@icon.Info(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
									<p>{ i18n.T(ctx, "admin.security.exceptions_limited") }</p>
								</div>
							}
							@MailSecurityExceptionsPanel(data)
						}
						@tabs.Content(tabs.ContentProps{Value: "proxies", IsActive: data.Tab == "proxies", Class: "mt-6"}) {
							@OutboundProxiesPanel(data)
						}
					}
				} else {
					@MailSecurityExceptionsPanel(data)
					<div class="mt-6">
						@OutboundProxiesPanel(data)
					</div>
				}
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

func mailAllowlistServersLimited(list models.MailAllowlistAdminData) bool {
	return len(list.Servers) > 0 || list.Gmail || list.Outlook
}

func mailAllowlistLimited(list models.MailAllowlistAdminData) bool {
	return mailAllowlistServersLimited(list) || len(list.Domains) > 0
}

// adminPeoplePickerProps describes a list of chosen people, each with a
// button that takes them off it, and a picker that adds one. Each change
// posts to Action with user_id and Field set to "true" (added) or "false"
// (taken off), and Hidden's fields.
type adminPeoplePickerProps struct {
	Title       string
	Detail      string
	Empty       string
	Chosen      []models.AdminWebmailUserOption
	Candidates  []models.AdminWebmailUserOption
	Action      string
	CSRFToken   string
	Field       string
	Hidden      map[string]string
	AddLabel    string
	RemoveLabel string
	Disabled    bool
}

templ adminPeoplePickerHidden(props adminPeoplePickerProps, value string) {
	if props.CSRFToken != "" {
		<input type="hidden" name="_csrf" value={ props.CSRFToken }/>
	}
	for name, hidden := range props.Hidden {
		<input type="hidden" name={ name } value={ hidden }/>
	}
	<input type="hidden" name={ props.Field } value={ value }/>
}

// adminPeoplePicker is the list of people a rule or proxy is chosen for.
templ adminPeoplePicker(props adminPeoplePickerProps) {
	if props.Title != "" {
		<div class="text-sm font-semibold text-foreground">{ props.Title }</div>
	}
	if props.Detail != "" {
		<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ props.Detail }</p>
	}
	if len(props.Chosen) == 0 {
		<div class="mt-3 rounded-md border border-dashed border-border px-3 py-4 text-center text-xs text-muted-foreground">{ props.Empty }</div>
	} else {
		<div class="mt-3 space-y-2">
			for _, user := range props.Chosen {
				<div class="flex items-center justify-between gap-3 rounded-md border border-border bg-card px-3 py-2">
					<span class="min-w-0 truncate text-sm font-semibold text-foreground">{ user.Username }</span>
					<form method="post" data-step-up action={ templ.URL(props.Action) }>
						@adminPeoplePickerHidden(props, "false")
						<input type="hidden" name="user_id" value={ user.ID }/>
						<button type="submit" class={ mailAllowlistRemoveButtonClass() } disabled?={ props.Disabled }>{ props.RemoveLabel }</button>
					</form>
				</div>
			}
		</div>
	}
	if len(props.Candidates) > 0 {
		<form method="post" data-step-up action={ templ.URL(props.Action) } class="mt-3 flex flex-col gap-2 sm:flex-row">
			@adminPeoplePickerHidden(props, "true")
			<div class="min-w-0 sm:flex-1">
				@selectbox.SelectBox() {
					@selectbox.Trigger(selectbox.TriggerProps{Name: "user_id", Class: "h-9 bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "admin.allowlist.user")}}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.allowlist.choose_user")})
					}
					@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "admin.allowlist.search_users")}) {
						for _, user := range props.Candidates {
							@selectbox.Item(selectbox.ItemProps{Value: user.ID}) {
								{ user.Username }
							}
						}
					}
				}
			</div>
			<button type="submit" class={ mailAllowlistAddButtonClass() } disabled?={ props.Disabled }>{ props.AddLabel }</button>
		</form>
	}
}

// MailAllowlistPanel limits the mail servers mailboxes connect to and the
// domains of their addresses, and says which mailboxes the limits refuse.
templ MailAllowlistPanel(data models.MailSecurityAdminData, list models.MailAllowlistAdminData) {
	<section class="rounded-lg border border-border bg-card p-5" id="allowed-mail">
		<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.allowlist.title") }</div>
		<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.description") }</p>
		<div class="mt-5 grid gap-5 lg:grid-cols-2">
			<div class="min-w-0 rounded-lg border border-border bg-background/45 p-4">
				<div class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.allowlist.servers") }</div>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.servers_detail") }</p>
				@mailAllowlistEntries(data, list.Servers, i18n.T(ctx, "admin.allowlist.servers_empty"))
				@mailAllowlistAddForm(data, "/servers", i18n.T(ctx, "admin.allowlist.or", "a", "imap.example.org", "b", "*.example.org"), i18n.T(ctx, "admin.allowlist.add_server"))
				<div class="mt-4 border-t border-border pt-4">
					<div class="text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.providers") }</div>
					<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.providers_detail") }</p>
					<div class="mt-2 space-y-2">
						@mailAllowlistProvider(data, "gmail", "Gmail", list.Gmail, mailAllowlistServersLimited(list))
						@mailAllowlistProvider(data, "outlook", "Outlook", list.Outlook, mailAllowlistServersLimited(list))
					</div>
				</div>
			</div>
			<div class="min-w-0 rounded-lg border border-border bg-background/45 p-4">
				<div class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.allowlist.domains") }</div>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.domains_detail") }</p>
				@mailAllowlistEntries(data, list.Domains, i18n.T(ctx, "admin.allowlist.domains_empty"))
				@mailAllowlistAddForm(data, "/domains", i18n.T(ctx, "admin.allowlist.or", "a", "example.org", "b", "*.example.org"), i18n.T(ctx, "admin.allowlist.add_domain"))
			</div>
		</div>
		<div class="mt-5 grid gap-5 lg:grid-cols-2">
			<div class="min-w-0 rounded-lg border border-border bg-background/45 p-4">
				@adminPeoplePicker(adminPeoplePickerProps{
					Title:        i18n.T(ctx, "admin.allowlist.exempt"),
					Detail:       i18n.T(ctx, "admin.allowlist.exempt_detail"),
					Empty:        i18n.T(ctx, "admin.allowlist.exempt_empty"),
					Chosen:       list.Exempt,
					Candidates:   list.Candidates,
					Action:       adminMailAllowlistBase + "/exempt",
					CSRFToken:    data.CSRFTokens[adminMailAllowlistBase+"/exempt"],
					Field:        "exempt",
					AddLabel:     i18n.T(ctx, "admin.allowlist.dont_apply"),
					RemoveLabel:  i18n.T(ctx, "admin.allowlist.apply"),
					Disabled:     data.ChangesDisabled(),
				})
			</div>
			<div class="min-w-0 rounded-lg border border-border bg-background/45 p-4">
				<div class="flex items-center justify-between gap-3">
					<div class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.allowlist.refused") }</div>
					if mailAllowlistLimited(list) {
						<span class="text-xs font-semibold tabular-nums text-muted-foreground">{ i18n.Number(ctx, len(list.Refused)) }</span>
					}
				</div>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.refused_detail") }</p>
				if !mailAllowlistLimited(list) {
					<div class="mt-3 rounded-md border border-dashed border-border px-3 py-4 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.unlimited") }</div>
				} else if len(list.Refused) == 0 {
					<div class="mt-3 rounded-md border border-dashed border-border px-3 py-4 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.all_within") }</div>
				} else {
					<div class="mt-3 space-y-2">
						for _, account := range list.Refused {
							<div class="rounded-md border border-red-500/20 bg-red-500/5 px-3 py-2">
								<div class="flex flex-wrap items-baseline justify-between gap-x-3">
									<span class="min-w-0 truncate text-sm font-semibold text-foreground">{ account.Email }</span>
									<span class="text-xs text-muted-foreground">{ account.Username }</span>
								</div>
								<div class="mt-0.5 text-xs font-medium text-red-700 dark:text-red-300">{ account.Reason }</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</section>
}

const adminMailAllowlistBase = "/admin/security/allowlist"

func mailAllowlistRemoveButtonClass() string {
	return "shrink-0 rounded-md border border-border bg-card px-2.5 py-1 text-xs font-semibold text-muted-foreground transition-colors hover:border-red-500/40 hover:bg-red-500/10 hover:text-red-700 disabled:cursor-not-allowed disabled:opacity-50 dark:hover:text-red-300"
}

func mailAllowlistAddButtonClass() string {
	return "h-9 shrink-0 rounded-md border border-border bg-card px-3 text-xs font-semibold text-foreground transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-50"
}

templ mailAllowlistEntries(data models.MailSecurityAdminData, entries []models.MailAllowlistAdminEntry, empty string) {
	if len(entries) == 0 {
		<div class="mt-3 rounded-md border border-dashed border-border px-3 py-4 text-center text-xs text-muted-foreground">{ empty }</div>
	} else {
		<div class="mt-3 space-y-2">
			for _, entry := range entries {
				<div class="flex items-center justify-between gap-3 rounded-md border border-border bg-card px-3 py-2">
					<span class="min-w-0 truncate font-mono text-sm font-bold text-foreground">{ entry.Value }</span>
					<form method="post" data-step-up action={ templ.URL(adminMailAllowlistBase + "/entries/" + entry.ID + "/delete") } data-confirm-action={ i18n.T(ctx, "admin.allowlist.remove") } data-confirm-destructive data-confirm={ i18n.T(ctx, "admin.allowlist.remove_confirm", "entry", entry.Value) }>
						<input type="hidden" name="_csrf" value={ data.CSRFTokens[adminMailAllowlistBase+"/entries/"+entry.ID+"/delete"] }/>
						<button type="submit" class={ mailAllowlistRemoveButtonClass() } disabled?={ data.ChangesDisabled() }>{ i18n.T(ctx, "admin.allowlist.remove") }</button>
					</form>
				</div>
			}
		</div>
	}
}

templ mailAllowlistAddForm(data models.MailSecurityAdminData, action, placeholder, label string) {
	<form method="post" data-step-up action={ templ.URL(adminMailAllowlistBase + action) } class="mt-3 flex flex-col gap-2 sm:flex-row">
		<input type="hidden" name="_csrf" value={ data.CSRFTokens[adminMailAllowlistBase+action] }/>
		<input name="value" type="text" required placeholder={ placeholder } aria-label={ label } class="h-9 min-w-0 sm:flex-1 rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
		<button type="submit" class={ mailAllowlistAddButtonClass() } disabled?={ data.ChangesDisabled() }>{ label }</button>
	</form>
}

templ mailAllowlistProvider(data models.MailSecurityAdminData, provider, name string, allowed, limited bool) {
	<div class="flex items-center justify-between gap-3 rounded-md border border-border bg-card px-3 py-2">
		<div class="min-w-0">
			<span class="text-sm font-semibold text-foreground">{ name }</span>
			<span class="ml-2 text-xs text-muted-foreground">
				if allowed {
					{ i18n.T(ctx, "admin.allowlist.allowed") }
				} else if limited {
					{ i18n.T(ctx, "admin.allowlist.refused_state") }
				} else {
					{ i18n.T(ctx, "admin.allowlist.allowed_unlimited") }
				}
			</span>
		</div>
		<form method="post" data-step-up action={ templ.URL(adminMailAllowlistBase + "/providers") }>
			<input type="hidden" name="_csrf" value={ data.CSRFTokens[adminMailAllowlistBase+"/providers"] }/>
			<input type="hidden" name="provider" value={ provider }/>
			<input type="hidden" name="allowed" value={ fmt.Sprintf("%t", !allowed) }/>
			if allowed {
				<button type="submit" class={ mailAllowlistRemoveButtonClass() } disabled?={ data.ChangesDisabled() }>{ i18n.T(ctx, "admin.allowlist.stop_allowing") }</button>
			} else {
				<button type="submit" class={ mailAllowlistRemoveButtonClass() } disabled?={ data.ChangesDisabled() }>{ i18n.T(ctx, "admin.allowlist.allow") }</button>
			}
		</form>
	</div>
}

// MailSecurityExceptionsPanel lists and adds the exceptions an administrator,
// or the owner in personal mode, has approved. Its forms post under data.ActionBase.
templ MailSecurityExceptionsPanel(data models.MailSecurityAdminData) {
	<div class="mb-6 rounded-lg border border-amber-500/30 bg-amber-500/10 p-4">
		<div class="flex items-start gap-3">
			@icon.TriangleAlert(icon.Props{Class: "mt-0.5 size-5 shrink-0 text-amber-700 dark:text-amber-300"})
			<div>
				<div class="text-sm font-bold text-amber-900 dark:text-amber-100">{ i18n.T(ctx, "admin.security.warning_title") }</div>
				<p class="mt-1 text-sm leading-relaxed text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "admin.security.warning") }</p>
			</div>
		</div>
	</div>
	<div class="grid gap-5">
		<section class="rounded-lg border border-border bg-card p-5">
			<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.security.kind.http") }</div>
			<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.http_detail") }</p>
			<form method="post" data-step-up action={ templ.URL(data.ActionBase + "/http-discovery") } class="mt-5 space-y-4" data-confirm-action={ i18n.T(ctx, "admin.security.http_confirm_action") } data-confirm={ i18n.T(ctx, "admin.security.http_confirm") }>
				if data.CSRFTokens[data.ActionBase+"/http-discovery"] != "" {
					<input type="hidden" name="_csrf" value={ data.CSRFTokens[data.ActionBase+"/http-discovery"] }/>
				}
				<div>
					<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.email_domain") }</label>
					<input name="domain" type="text" required placeholder="lab.example.test" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
				</div>
				<label class="flex items-start gap-2.5 rounded-md border border-amber-500/20 bg-amber-500/5 p-3 text-xs leading-relaxed text-muted-foreground">
					<input type="checkbox" name="acknowledge" value="yes" required class="mt-0.5 size-4 shrink-0 accent-amber-600"/>
					<span>{ i18n.T(ctx, "admin.security.http_ack") }</span>
				</label>
				<button type="submit" class="rounded-md border border-amber-500/35 bg-amber-500/10 px-3 py-2 text-xs font-semibold text-amber-800 transition-colors hover:bg-amber-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-amber-200" disabled?={ data.ChangesDisabled() }>{ i18n.T(ctx, "admin.security.http_add") }</button>
			</form>
		</section>
		<section class="rounded-lg border border-border bg-card p-5">
			<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.security.plaintext_title") }</div>
			<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.plaintext_detail") }</p>
			<form method="post" data-step-up action={ templ.URL(data.ActionBase + "/plaintext") } class="mt-5 space-y-4" data-confirm-action={ i18n.T(ctx, "admin.security.plaintext_confirm_action") } data-confirm-destructive data-confirm={ i18n.T(ctx, "admin.security.plaintext_confirm") }>
				if data.CSRFTokens[data.ActionBase+"/plaintext"] != "" {
					<input type="hidden" name="_csrf" value={ data.CSRFTokens[data.ActionBase+"/plaintext"] }/>
				}
				<div class="grid gap-3 sm:grid-cols-[8rem_minmax(0,1fr)_7rem]">
					<div>
						<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.protocol") }</label>
						@adminSecurityProtocolSelect([]string{"imap", "smtp", "http"})
					</div>
					<div>
						<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.host") }</label>
						<input name="host" type="text" required placeholder="mailhog.local" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
					</div>
					<div>
						<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.port") }</label>
						<input name="port" type="number" min="1" max="65535" required placeholder="1025" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
					</div>
				</div>
				<label class="flex items-start gap-2.5 rounded-md border border-red-500/20 bg-red-500/5 p-3 text-xs leading-relaxed text-muted-foreground">
					<input type="checkbox" name="acknowledge" value="yes" required class="mt-0.5 size-4 shrink-0 accent-red-600"/>
					<span>{ i18n.T(ctx, "admin.security.plaintext_ack") }</span>
				</label>
				<button type="submit" class="rounded-md border border-red-500/35 bg-red-500/10 px-3 py-2 text-xs font-semibold text-red-800 transition-colors hover:bg-red-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-red-200" disabled?={ data.ChangesDisabled() }>{ i18n.T(ctx, "admin.security.plaintext_add") }</button>
			</form>
		</section>
	</div>
	<section class="mt-5 rounded-lg border border-border bg-card p-5">
		<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.security.private_title") }</div>
		<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.private_detail") }</p>
		<form method="post" data-step-up action={ templ.URL(data.ActionBase + "/private-target") } class="mt-5 space-y-4" data-confirm-action={ i18n.T(ctx, "admin.security.private_confirm_action") } data-confirm={ i18n.T(ctx, "admin.security.private_confirm") }>
			if data.CSRFTokens[data.ActionBase+"/private-target"] != "" {
				<input type="hidden" name="_csrf" value={ data.CSRFTokens[data.ActionBase+"/private-target"] }/>
			}
			<div class="grid gap-3 sm:grid-cols-[8rem_minmax(0,1fr)_7rem]">
				<div>
					<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.protocol") }</label>
					@adminSecurityProtocolSelect([]string{"http", "https", "imap", "smtp", "proxy"})
				</div>
				<div>
					<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.host") }</label>
					<input name="host" type="text" required placeholder={ i18n.T(ctx, "admin.allowlist.or", "a", "127.0.0.1", "b", "mail.lab.test") } class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
				</div>
				<div>
					<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.port") }</label>
					<input name="port" type="number" min="1" max="65535" required placeholder="8080" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
				</div>
			</div>
			<label class="flex items-start gap-2.5 rounded-md border border-red-500/20 bg-red-500/5 p-3 text-xs leading-relaxed text-muted-foreground">
				<input type="checkbox" name="acknowledge" value="yes" required class="mt-0.5 size-4 shrink-0 accent-red-600"/>
				<span>{ i18n.T(ctx, "admin.security.private_ack") }</span>
			</label>
			<button type="submit" class="rounded-md border border-red-500/35 bg-red-500/10 px-3 py-2 text-xs font-semibold text-red-800 transition-colors hover:bg-red-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-red-200" disabled?={ data.ChangesDisabled() }>{ i18n.T(ctx, "admin.security.private_add") }</button>
		</form>
	</section>
	<section class="mt-6 rounded-lg border border-border bg-card p-5">
		<div class="flex items-end justify-between gap-4">
			<div>
				<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.security.approved") }</div>
				<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.approved_detail") }</p>
			</div>
			<div class="text-xs font-semibold tabular-nums text-muted-foreground">{ i18n.T(ctx, "admin.security.total", "count", i18n.Number(ctx, len(data.Exceptions))) }</div>
		</div>
		if len(data.Exceptions) == 0 {
			<div class="mt-4 rounded-lg border border-dashed border-border bg-background/35 px-4 py-8 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.none") }</div>
		} else {
			<div class="mt-4 space-y-3">
				for _, item := range data.Exceptions {
					<div class="flex flex-col gap-3 rounded-lg border border-border bg-background/45 p-4 sm:flex-row sm:items-start sm:justify-between">
						<div class="min-w-0">
							<div class="flex flex-wrap items-center gap-2">
								<span class="font-mono text-sm font-bold text-foreground">{ adminMailSecurityEndpoint(item) }</span>
								<span
									class={
										"rounded-md px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider",
										templ.KV("bg-amber-500/12 text-amber-800 dark:text-amber-200", item.Kind == models.MailSecurityExceptionHTTPDiscovery),
										templ.KV("bg-red-500/12 text-red-800 dark:text-red-200", item.Kind == models.MailSecurityExceptionPlaintextTransport),
										templ.KV("bg-red-500/12 text-red-800 dark:text-red-200", item.Kind == models.MailSecurityExceptionPrivateTarget),
									}
								>
									{ adminMailSecurityKindLabel(ctx, item) }
								</span>
								if item.OutsideAllowlist {
									<span class="rounded-md bg-muted px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.security.outside_allowlist") }</span>
								}
							</div>
							<div class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.security.added_by", "user", item.CreatedBy, "date", i18n.Dates(ctx).DateTime(item.CreatedAt.Local())) }</div>
							if len(item.Accounts) > 0 {
								<div class="mt-2 text-xs font-medium text-red-700 dark:text-red-300">
									{ i18n.T(ctx, "admin.security.used_by", "accounts", adminMailSecurityAccounts(item)) }
								</div>
							}
						</div>
						<form method="post" data-step-up action={ templ.URL(data.ActionBase + "/exceptions/" + item.ID + "/delete") } data-confirm-action={ i18n.T(ctx, "admin.security.revoke_action") } data-confirm-destructive data-confirm={ i18n.T(ctx, "admin.security.revoke_confirm") }>
							if action := data.ActionBase + "/exceptions/" + item.ID + "/delete"; data.CSRFTokens[action] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens[action] }/>
							}
							<button type="submit" class="rounded-md border border-border bg-card px-3 py-1.5 text-xs font-semibold text-muted-foreground transition-colors hover:border-red-500/40 hover:bg-red-500/10 hover:text-red-700 disabled:cursor-not-allowed disabled:opacity-50 dark:hover:text-red-300" disabled?={ data.ChangesDisabled() }>{ i18n.T(ctx, "admin.invite.revoke") }</button>
						</form>
					</div>
				}
			</div>
		}
	</section>
}

// adminSecurityProtocolSelect picks the protocol of a mail security exception;
// the first one starts selected.
// adminSecurityProtocolLabel names a protocol of an exception: its letters,
// or, for the proxy people add for their own accounts, the word.
func adminSecurityProtocolLabel(ctx context.Context, protocol string) string {
	if protocol == "proxy" {
		return i18n.T(ctx, "admin.security.protocol_proxy")
	}
	return strings.ToUpper(protocol)
}

templ adminSecurityProtocolSelect(protocols []string) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: "protocol", Class: "h-9 bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"value": protocols[0], "aria-label": i18n.T(ctx, "admin.security.protocol")}}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.security.protocol")})
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
			for i, protocol := range protocols {
				@selectbox.Item(selectbox.ItemProps{Value: protocol, Selected: i == 0}) {
					{ adminSecurityProtocolLabel(ctx, protocol) }
				}
			}
		}
	}
}
