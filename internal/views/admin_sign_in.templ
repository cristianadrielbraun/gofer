package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// adminPublicPage frames the admin pages shown before sign-in, with the head
// and dark classic look of the webmail's sign-in pages.
templ adminPublicPage(title string) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ title }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			{ children... }
		</body>
	</html>
}

// adminSignInHeading is the logo, the "Management" label and the page's
// title and description.
templ adminSignInHeading(title, description string) {
	<div class="text-center">
		<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
		<p class="mt-5 text-xs font-semibold uppercase tracking-[0.2em] text-primary">{ i18n.T(ctx, "admin.management") }</p>
		<h1 class="mt-2 text-2xl font-semibold">{ title }</h1>
		<p class="mt-2 text-sm text-muted-foreground">{ description }</p>
	</div>
}

// ManagementLoginPage signs administrators in with their username and
// password. Provider sign-in belongs to the webmail, which the page links to.
templ ManagementLoginPage(errorMessage, identifier string) {
	@adminPublicPage(i18n.T(ctx, "admin.login.page_title")) {
		<main class="min-h-screen flex items-center justify-center p-4">
			<div class="w-full max-w-sm">
				<div class="mb-8">
					@adminSignInHeading(i18n.T(ctx, "admin.login.title"), i18n.T(ctx, "admin.login.separate"))
				</div>
				if errorMessage != "" {
					<div id="admin-login-error" role="alert" aria-live="polite" class="mb-6 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ errorMessage }</div>
				}
				<form method="post" action="/admin/login" class="space-y-4">
					<div class="space-y-2">
						<label for="admin-login-identifier" class="text-sm font-medium">{ i18n.T(ctx, "identities.username") }</label>
						<input
							id="admin-login-identifier"
							name="identifier"
							type="text"
							value={ identifier }
							autocomplete="username"
							autocapitalize="none"
							spellcheck="false"
							required
							autofocus
							if errorMessage != "" {
								aria-invalid="true"
								aria-describedby="admin-login-error"
							}
							class={ signInFieldClass }
						/>
					</div>
					<div class="space-y-2">
						<label for="admin-login-password" class="text-sm font-medium">{ i18n.T(ctx, "identities.password") }</label>
						<input
							id="admin-login-password"
							name="password"
							type="password"
							autocomplete="current-password"
							required
							if errorMessage != "" {
								aria-invalid="true"
								aria-describedby="admin-login-error"
							}
							class={ signInFieldClass }
						/>
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
						{ i18n.T(ctx, "admin.login.submit") }
					}
				</form>
				<p class="mt-6 text-center text-xs text-muted-foreground">
					{ i18n.T(ctx, "admin.login.mailbox_q") } <a href="/login" class="font-semibold underline underline-offset-4 hover:text-foreground">{ i18n.T(ctx, "admin.login.webmail") }</a>.
				</p>
			</div>
		</main>
	}
}

// ManagementMFAContinuationPage asks an administrator for their
// authenticator code after the password.
templ ManagementMFAContinuationPage(errorMessage string) {
	@adminPublicPage(i18n.T(ctx, "admin.mfa.page_title")) {
		<main class="min-h-screen flex items-center justify-center p-4">
			<div class="w-full max-w-sm">
				@adminSignInHeading(i18n.T(ctx, "admin.mfa.title"), i18n.T(ctx, "admin.mfa.description"))
				if errorMessage != "" {
					<div id="admin-login-mfa-error" role="alert" aria-live="polite" class="mt-6 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ errorMessage }</div>
				}
				<form method="post" action="/login/mfa" class="mt-6 space-y-4">
					<div class="space-y-2">
						<label for="admin-login-mfa-code" class="block text-center text-sm font-medium">{ i18n.T(ctx, "admin.mfa.code") }</label>
						<input
							id="admin-login-mfa-code"
							name="code"
							type="text"
							inputmode="numeric"
							autocomplete="one-time-code"
							pattern="[0-9]{6}"
							minlength="6"
							maxlength="6"
							required
							autofocus
							if errorMessage != "" {
								aria-invalid="true"
								aria-describedby="admin-login-mfa-error"
							}
							class={ signInCodeFieldClass }
						/>
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
						{ i18n.T(ctx, "admin.mfa.submit") }
					}
				</form>
				<div class="mt-4">
					@button.Button(button.Props{Variant: button.VariantOutline, FullWidth: true, Href: "/admin/login"}) {
						{ i18n.T(ctx, "admin.mfa.restart") }
					}
				</div>
				<div class="mt-4 text-center">
					<a href="/login/mfa/recovery" class="text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground">{ i18n.T(ctx, "admin.mfa.recovery") }</a>
				</div>
			</div>
		</main>
	}
}
