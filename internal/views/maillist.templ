package views

import (
	"context"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"fmt"
	"strings"
	"time"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/calendar"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/popover"
	"github.com/cristianadrielbraun/gofer/components/radio"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
	"github.com/cristianadrielbraun/gofer/components/tooltip"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

templ MailList(accounts []models.Account, emails []models.Email, activeFolder string, selectedEmail *models.Email, totalCount int, scrollCount int, windowStart int, width string, senderDisplayMode string, viewMode string, navigationMode string, filters models.EmailFilters) {
	<div id="mail-list" class="w-full lg:flex flex-col border-r border-border bg-card h-full overflow-hidden" style={ "width:" + mailListWidthCSS(width) } data-panel-section="mail" data-mail-list-view={ mailListViewMode(viewMode) } data-mail-navigation-mode={ mailListNavigationMode(navigationMode) } data-mail-search-scope={ mailSearchScopeJSON(filters.SearchScope) } data-mail-search-results?={ filters.SearchScope != nil }>
		@MailListHeader(accounts, activeFolder, totalCount, filters)
		@MailListToolbar(accounts, activeFolder, mailListViewMode(viewMode), filters)
		@MailSelectAllBanner()
		@MailCardLayoutDialog()
		<hr class="divider-etched"/>
		<div class="relative min-h-0 flex-1 overflow-hidden" data-mail-list-body>
			@MailListEmails(accounts, emails, activeFolder, selectedEmail, totalCount, scrollCount, windowStart, senderDisplayMode, mailListViewMode(viewMode), mailListNavigationMode(navigationMode))
		</div>
		if mailListNavigationMode(navigationMode) == "pagination" && scrollCount >= 0 {
			@MailListPagination(scrollCount, windowStart, len(emails), mailListPaginationPageSize())
		}
		<button type="button" class="mobile-compose-fab" data-on-click='["openNewCompose"]' aria-label={ i18n.T(ctx, "mail.compose") }>
			@icon.Pen(icon.Props{Class: "size-5"})
		</button>
		@MailListContextMenu()
	</div>
}

// MailListContextMenu opens where a message in the list is right-clicked, with
// what can be done to it, or to the whole selection when it is part of one.
// app.js places it, shows the items that apply and names them.
templ MailListContextMenu() {
	@popover.Root(popover.RootProps{ID: "mail-context-menu", Attributes: templ.Attributes{"data-mail-context-menu": ""}}) {
		@popover.Trigger() {
			<span class="pointer-events-none fixed left-0 top-0 size-px" aria-hidden="true" data-point-popover-anchor></span>
		}
		@popover.Content(popover.ContentProps{
			Placement: popover.PlacementBottomStart,
			Offset:    2,
			Class:     "z-50 w-52 rounded-md border border-border bg-popover p-1 shadow-md focus:outline-none",
			Attributes: templ.Attributes{"role": "menu", "aria-label": i18n.T(ctx, "mail.actions.label")},
		}) {
			@dropdown.Label(dropdown.LabelProps{Class: "text-xs font-medium text-muted-foreground", Attributes: templ.Attributes{"data-mail-context-count": "", "hidden": true}})
			<div data-mail-context-group="reply">
				@mailContextItem("reply", i18n.T(ctx, "shortcuts.reply")) {
					@icon.Reply(icon.Props{Class: "size-4"})
				}
				@mailContextItem("reply-all", i18n.T(ctx, "shortcuts.reply_all")) {
					@icon.ReplyAll(icon.Props{Class: "size-4"})
				}
				@mailContextItem("forward", i18n.T(ctx, "shortcuts.forward")) {
					@icon.Forward(icon.Props{Class: "size-4"})
				}
				@dropdown.Separator()
			</div>
			@mailContextItem("read", i18n.T(ctx, "mail.actions.mark_read")) {
				<span data-mail-context-icon="read">
					@icon.MailOpen(icon.Props{Class: "size-4"})
				</span>
				<span data-mail-context-icon="unread" hidden>
					@icon.Mail(icon.Props{Class: "size-4"})
				</span>
			}
			@mailContextItem("star", i18n.T(ctx, "shortcuts.star")) {
				<span data-mail-context-icon="star">
					@icon.Star(icon.Props{Class: "size-4"})
				</span>
				<span data-mail-context-icon="unstar" hidden>
					@icon.StarOff(icon.Props{Class: "size-4"})
				</span>
			}
			@dropdown.Separator()
			@mailContextItem("archive", i18n.T(ctx, "shortcuts.archive")) {
				<span data-mail-context-icon="archive">
					@icon.Archive(icon.Props{Class: "size-4"})
				</span>
				<span data-mail-context-icon="unarchive" hidden>
					@icon.ArchiveRestore(icon.Props{Class: "size-4"})
				</span>
			}
			@mailContextItem("move", i18n.T(ctx, "mail.actions.move")) {
				@icon.FolderInput(icon.Props{Class: "size-4"})
			}
			@mailContextItem("labels", i18n.T(ctx, "mail.actions.labels")) {
				@icon.Tag(icon.Props{Class: "size-4"})
			}
			// Several messages have nothing else for More, so spam shows here.
			<div data-mail-context-group="spam">
				@mailContextSpamItems()
			</div>
			@dropdown.Separator()
			@mailContextItem("delete", i18n.T(ctx, "shortcuts.delete")) {
				@icon.Trash2(icon.Props{Class: "size-4"})
			}
			<div data-mail-context-group="more">
				@dropdown.Separator()
				@dropdown.Sub(dropdown.SubProps{ID: "mail-context-more"}) {
					@dropdown.SubTrigger() {
						<span class="flex items-center gap-2">
							@icon.Ellipsis(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "common.more") }
						</span>
					}
					@dropdown.SubContent(dropdown.SubContentProps{Class: "w-44", Attributes: templ.Attributes{"role": "menu", "aria-label": i18n.T(ctx, "mail.actions.more_label")}}) {
						@mailContextSpamItems()
						@dropdown.Separator()
						@mailContextItem("download", i18n.T(ctx, "mail.actions.download")) {
							@icon.Download(icon.Props{Class: "size-4"})
						}
						@mailContextItem("source", i18n.T(ctx, "mail.actions.source")) {
							@icon.FileCode(icon.Props{Class: "size-4"})
						}
						@mailContextItem("refetch", i18n.T(ctx, "mail.actions.refetch")) {
							@icon.RefreshCw(icon.Props{Class: "size-4"})
						}
					}
				}
			</div>
		}
	}
}

templ mailContextSpamItems() {
	@mailContextItem("spam", i18n.T(ctx, "mail.actions.report_spam")) {
		@icon.ShieldAlert(icon.Props{Class: "size-4"})
	}
	@mailContextItem("not-spam", i18n.T(ctx, "mail.actions.not_spam")) {
		@icon.ShieldCheck(icon.Props{Class: "size-4"})
	}
}

templ mailContextItem(action string, label string) {
	@dropdown.Item(dropdown.ItemProps{Class: mailContextItemClass(action), Attributes: templ.Attributes{"role": "menuitem", "data-mail-context-action": action}}) {
		<span class="flex items-center gap-2">
			{ children... }
			<span data-mail-context-label>{ label }</span>
		</span>
	}
}

func mailListFolderHeading(ctx context.Context, activeFolder string, filters models.EmailFilters) string {
	if filters.SearchScope != nil {
		return i18n.T(ctx, "mail.search.results")
	}
	if strings.TrimSpace(filters.Participant) != "" {
		return i18n.T(ctx, "mail.all_mail")
	}
	return folderDisplayName(ctx, activeFolder)
}

templ MailListHeader(accounts []models.Account, activeFolder string, totalCount int, filters models.EmailFilters) {
	<div class="mail-list-header px-4 py-4 space-y-3">
		<div class="mail-list-title-row flex items-center justify-between">
			<div class="mail-list-title flex items-center gap-2 min-w-0">
				<h2 id="mail-folder-name" data-mail-folder-default-name={ folderDisplayName(ctx, activeFolder) } class="text-lg font-bold tracking-tight" style="font-family: var(--font-serif)">{ mailListFolderHeading(ctx, activeFolder, filters) }</h2>
				if totalCount >= 0 {
					<span id="mail-folder-count" class="inline-flex h-5 min-w-10 items-center justify-center rounded-full bg-muted px-2 text-xs font-medium text-muted-foreground shadow-[0_1px_2px_rgba(0,0,0,0.06)]">{ fmt.Sprintf("%d", totalCount) }</span>
				} else {
					<span id="mail-folder-count" class="inline-flex h-5 min-w-10 items-center justify-center rounded-full bg-muted px-2 text-xs font-medium text-muted-foreground shadow-[0_1px_2px_rgba(0,0,0,0.06)] animate-pulse"></span>
				}
			</div>
		</div>
		<div class="mail-list-search-section">
			<div class="mail-list-search-primary">
				<button type="button" class="mail-list-search-close hidden" data-mail-search-close aria-label={ i18n.T(ctx, "mail.search.close") }>
					@icon.ArrowLeft(icon.Props{Class: "size-5"})
				</button>
				<div class="mail-list-search-input-wrap groove flex min-w-0 items-stretch rounded-lg border border-border/50 bg-background focus-within:ring-2 focus-within:ring-ring">
					@MailSearchScopeMenu(accounts, activeFolder, filters)
					@popover.Root(popover.RootProps{ID: "mail-search-suggest"}) {
						@popover.Trigger(popover.TriggerProps{TriggerType: popover.TriggerTypeManual, Class: "mail-list-search-field relative block min-w-0 flex-1"}) {
							@icon.Search(icon.Props{Class: "absolute left-2.5 top-1/2 -translate-y-1/2 size-3.5 text-muted-foreground"})
							<input
								type="text"
								name="q"
								placeholder={ i18n.T(ctx, "mail.search.label") }
								data-mobile-placeholder={ i18n.T(ctx, "mail.search.label") }
								class="h-9 w-full pl-8 pr-2 text-sm bg-transparent outline-none"
								data-mail-search-input
								autocomplete="off"
								role="combobox"
								aria-autocomplete="list"
								aria-controls="mail-search-suggestions"
								aria-expanded="false"
							/>
						}
						@MailSearchSuggestions(!filters.ByMessage)
					}
					@MailSearchHelp(!filters.ByMessage)
				</div>
				<div class="mail-list-search-actions">
					@MailFiltersPopover(accounts, !filters.ByMessage)
				</div>
			</div>
			@MailSearchControls(accounts)
			<div data-mail-active-filter-pills class="mail-active-filter-strip hidden" aria-label={ i18n.T(ctx, "mail.filters.active") }></div>
		</div>
	</div>
}

templ MailFilterTriState(name string, leftValue string, leftLabel string, rightValue string, rightLabel string) {
	<div class="mail-filter-tristate relative inline-grid h-7 w-full grid-cols-3 overflow-hidden border border-border bg-background p-0.5 text-[11px]" data-mail-tristate={ name } data-mail-tristate-value="">
		<div class="mail-filter-tristate-indicator" data-mail-tristate-indicator></div>
		<button type="button" data-mail-tristate-option={ leftValue } aria-pressed="false" class="relative z-10 px-1.5 text-muted-foreground hover:text-foreground">{ leftLabel }</button>
		<button type="button" data-mail-tristate-option="" aria-pressed="true" class="relative z-10 px-1.5 text-foreground">{ i18n.T(ctx, "mail.filters.any") }</button>
		<button type="button" data-mail-tristate-option={ rightValue } aria-pressed="false" class="relative z-10 px-1.5 text-muted-foreground hover:text-foreground">{ rightLabel }</button>
	</div>
}

// mailSortOrderOption is one half of the sort menu's two-way order switch.
templ mailSortOrderOption(value string, label string, checked bool) {
	<label class="relative z-10 flex cursor-pointer items-center justify-center gap-1 rounded-md text-xs font-medium text-muted-foreground transition-colors duration-200 hover:text-foreground has-[:checked]:text-foreground has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ring">
		@radio.Radio(radio.Props{Name: "sort_order", Value: value, Checked: checked, Class: "pointer-events-none absolute inset-0 size-full opacity-0"})
		if value == "asc" {
			@icon.ArrowUpNarrowWide(icon.Props{Class: "size-3.5"})
		} else {
			@icon.ArrowDownWideNarrow(icon.Props{Class: "size-3.5"})
		}
		{ label }
	</label>
}

// mailListDate renders a list date both ways; the list's "always show time"
// setting picks which one shows, so changing it needs no reload.
templ mailListDate(short string, withTime string) {
	<span data-mail-date-short>{ short }</span>
	if withTime != "" && withTime != short {
		<span data-mail-date-with-time>{ withTime }</span>
	}
}

func mailSortLabel(ctx context.Context, filters models.EmailFilters) string {
	switch filters.SortBy {
	case "sender", "subject", "size", "unread", "starred", "attachments":
		return i18n.T(ctx, "mail.sort."+filters.SortBy)
	default:
		return i18n.T(ctx, "mail.sort.date")
	}
}

templ MailListToolbar(accounts []models.Account, activeFolder string, viewMode string, filters models.EmailFilters) {
	<div class="mail-list-toolbar flex items-center gap-1 px-4 py-1.5">
		@MailSelectAllControl()
		@listSelectionClear(templ.Attributes{"data-mail-selection-clear": ""}, templ.Attributes{"data-mail-selection-summary": ""})

		<div class="inline-flex h-7 shrink-0 items-center rounded-lg border border-border bg-background p-0.5 gap-0.5" data-mail-list-view-capsule>
			<div class="relative inline-grid h-6 grid-cols-2 gap-0.5" data-mail-list-view-toggle>
				<div
					data-mail-list-view-indicator
					class="absolute inset-y-0 left-0 w-[calc(50%-1px)] rounded-md border border-border bg-card shadow-sm transition-transform duration-200 ease-out"
					style={ mailListViewIndicatorStyle(viewMode) }
				></div>
				<button
					type="button"
					data-mail-list-view-button="cards"
					aria-pressed={ fmt.Sprintf("%t", viewMode == "cards") }
					aria-label={ i18n.T(ctx, "mail.view.cards_label") }
					class={
						"relative z-10 inline-flex h-6 items-center justify-center gap-1 px-2 rounded-md text-xs font-medium transition-colors duration-200",
						templ.KV("text-foreground", viewMode == "cards"),
						templ.KV("text-muted-foreground hover:text-foreground", viewMode != "cards"),
					}
				>
					@icon.LayoutList(icon.Props{Class: "size-3.5"})
					<span class="mail-toolbar-collapsible" style="--collapse-gap: 0.25rem" data-mail-view-label>{ i18n.T(ctx, "mail.view.cards") }</span>
				</button>
				<button
					type="button"
					data-mail-list-view-button="table"
					aria-pressed={ fmt.Sprintf("%t", viewMode == "table") }
					aria-label={ i18n.T(ctx, "mail.view.table_label") }
					class={
						"relative z-10 inline-flex h-6 items-center justify-center gap-1 px-2 rounded-md text-xs font-medium transition-colors duration-200",
						templ.KV("text-foreground", viewMode == "table"),
						templ.KV("text-muted-foreground hover:text-foreground", viewMode != "table"),
					}
				>
					@icon.Table2(icon.Props{Class: "size-3.5"})
					<span class="mail-toolbar-collapsible" style="--collapse-gap: 0.25rem" data-mail-view-label>{ i18n.T(ctx, "mail.view.table") }</span>
				</button>
			</div>
			<div class="mx-0.5 h-4 w-px bg-border" data-mail-list-view-divider aria-hidden="true"></div>
			@MailListColumnSelector()
		</div>
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				<button type="button" class="mail-list-sort-trigger inline-flex h-7 shrink-0 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground" aria-label={ i18n.T(ctx, "mail.sort.label") } data-mail-sort-trigger>
					@icon.ArrowUpDown(icon.Props{Class: "size-3.5"})
					<span class="mail-toolbar-collapsible" style="--collapse-gap: 0.375rem" data-mail-sort-label>{ mailSortLabel(ctx, filters) }</span>
				</button>
			}
			@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "mobile-sheet w-64 normal-case tracking-normal p-3"}) {
				<form class="space-y-3" data-mail-sort-form>
					<div class="space-y-1 text-[11px] font-medium text-muted-foreground">
						<span>{ i18n.T(ctx, "mail.sort.order_by") }</span>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "sort_by", Class: "h-8 bg-background text-xs", DisableClear: true}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "mail.sort.date")})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
								@selectbox.Item(selectbox.ItemProps{Value: "date", Selected: filters.SortBy == "" || filters.SortBy == "date"}) {
									{ i18n.T(ctx, "mail.sort.date") }
								}
								@selectbox.Item(selectbox.ItemProps{Value: "sender", Selected: filters.SortBy == "sender"}) {
									{ i18n.T(ctx, "mail.sort.sender") }
								}
								@selectbox.Item(selectbox.ItemProps{Value: "subject", Selected: filters.SortBy == "subject"}) {
									{ i18n.T(ctx, "mail.sort.subject") }
								}
								@selectbox.Item(selectbox.ItemProps{Value: "size", Selected: filters.SortBy == "size"}) {
									{ i18n.T(ctx, "mail.sort.size") }
								}
								@selectbox.Item(selectbox.ItemProps{Value: "unread", Selected: filters.SortBy == "unread"}) {
									{ i18n.T(ctx, "mail.sort.unread") }
								}
								@selectbox.Item(selectbox.ItemProps{Value: "starred", Selected: filters.SortBy == "starred"}) {
									{ i18n.T(ctx, "mail.sort.starred") }
								}
								@selectbox.Item(selectbox.ItemProps{Value: "attachments", Selected: filters.SortBy == "attachments"}) {
									{ i18n.T(ctx, "mail.sort.attachments") }
								}
							}
						}
					</div>
					<div class="space-y-1 text-[11px] font-medium text-muted-foreground">
						<span>{ i18n.T(ctx, "mail.sort.order") }</span>
						<div class="mail-sort-order grid h-8 grid-cols-2 gap-0.5 rounded-lg border border-border bg-background p-0.5" role="radiogroup" aria-label={ i18n.T(ctx, "mail.sort.order") }>
							<div class="mail-sort-order-indicator rounded-md border border-border bg-card shadow-sm" aria-hidden="true"></div>
							@mailSortOrderOption("desc", i18n.T(ctx, "mail.sort.descending"), filters.SortOrder != "asc")
							@mailSortOrderOption("asc", i18n.T(ctx, "mail.sort.ascending"), filters.SortOrder == "asc")
						</div>
					</div>
					<button type="submit" class="inline-flex h-8 w-full items-center justify-center rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground hover:bg-primary/90">{ i18n.T(ctx, "mail.sort.apply") }</button>
				</form>
			}
		}
		<div class="mail-list-toolbar-spacer flex-1"></div>
		<div class="mail-delete-action items-center" data-mail-delete-action>
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:  button.VariantGhost,
						Size:     button.SizeIcon,
						Class:    mailDeleteActionClass("h-7 w-7", "", mailFolderIDIsTrash(activeFolder, accounts)),
						Disabled: mailDeleteAllFolder(activeFolder, accounts) == "",
						Attributes: templ.Attributes{
							"data-mail-selection-action":  "delete",
							"data-mail-delete-permanent":  fmt.Sprintf("%t", mailFolderIDIsTrash(activeFolder, accounts)),
							"data-mail-delete-all-folder": mailDeleteAllFolder(activeFolder, accounts),
							"data-mail-delete-all":        mailDeleteAllFolder(activeFolder, accounts) != "",
							"aria-label":                  mailDeleteAllLabel(ctx, mailDeleteAllFolder(activeFolder, accounts)),
						},
					}) {
						@icon.Trash2(icon.Props{Class: "size-3.5"})
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					<span data-mail-delete-tooltip>
						{ mailDeleteAllTooltip(ctx, mailDeleteAllFolder(activeFolder, accounts)) }
					</span>
				}
			}
		</div>
		<div class="items-center gap-1" data-mail-selection-actions>
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIcon,
						Class:      "h-7 w-7",
						Disabled:   true,
						Attributes: templ.Attributes{"data-mail-selection-action": "archive", "aria-label": mailArchiveSelectionLabel(ctx, mailFolderIDIsArchive(activeFolder, accounts))},
					}) {
						<span class={ mailHiddenClass("", mailFolderIDIsArchive(activeFolder, accounts)) } data-mail-archive-icon>
							@icon.Archive(icon.Props{Class: "size-3.5"})
						</span>
						<span class={ mailHiddenClass("", !mailFolderIDIsArchive(activeFolder, accounts)) } data-mail-unarchive-icon>
							@icon.ArchiveRestore(icon.Props{Class: "size-3.5"})
						</span>
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					<span data-mail-archive-tooltip>
						if mailFolderIDIsArchive(activeFolder, accounts) {
							{ i18n.T(ctx, "mail.actions.move_to_inbox") }
						} else {
							{ i18n.T(ctx, "shortcuts.archive") }
						}
					</span>
				}
			}
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIcon,
						Class:      "h-7 w-7",
						Disabled:   true,
						Attributes: templ.Attributes{"data-mail-selection-action": "read", "aria-label": i18n.T(ctx, "mail.selection.read")},
					}) {
						<span data-mail-read-icon>
							@icon.MailOpen(icon.Props{Class: "size-3.5"})
						</span>
						<span class="hidden" data-mail-unread-icon>
							@icon.Mail(icon.Props{Class: "size-3.5"})
						</span>
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					<span data-mail-read-tooltip>{ i18n.T(ctx, "mail.actions.mark_read") }</span>
				}
			}
			<div class="mail-toolbar-collapsible" data-mail-overflow-rank="3">
				@tooltip.Tooltip() {
					@tooltip.Trigger() {
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIcon,
							Class:      "h-7 w-7",
							Disabled:   true,
							Attributes: templ.Attributes{"data-mail-selection-action": "star", "aria-label": i18n.T(ctx, "mail.selection.star")},
						}) {
							<span data-mail-star-icon>
								@icon.Star(icon.Props{Class: "size-3.5"})
							</span>
							<span class="hidden" data-mail-unstar-icon>
								@icon.StarOff(icon.Props{Class: "size-3.5"})
							</span>
						}
					}
					@tooltip.Content(tooltip.ContentProps{
						Position:  tooltip.PositionBottom,
						ShowArrow: true,
					}) {
						<span data-mail-star-tooltip>{ i18n.T(ctx, "shortcuts.star") }</span>
					}
				}
			</div>
			<div class="mail-toolbar-collapsible" data-mail-overflow-rank="2">
				@tooltip.Tooltip() {
					@tooltip.Trigger() {
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIcon,
							Class:      "h-7 w-7",
							Disabled:   true,
							Attributes: templ.Attributes{"data-mail-selection-action": "labels", "aria-label": i18n.T(ctx, "mail.selection.labels")},
						}) {
							@icon.Tag(icon.Props{Class: "size-3.5"})
						}
					}
					@tooltip.Content(tooltip.ContentProps{
						Position:  tooltip.PositionBottom,
						ShowArrow: true,
					}) {
						{ i18n.T(ctx, "mail.actions.labels_short") }
					}
				}
			</div>
			@mailToolbarSpamButton(mailFolderIDIsSpam(activeFolder, accounts))
			<div class="mail-toolbar-collapsible" data-mail-collapsed data-mail-overflow-menu>
				@dropdown.Dropdown() {
					@dropdown.Trigger() {
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIcon,
							Class:      "h-7 w-7",
							Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "common.more_actions")},
						}) {
							@icon.EllipsisVertical(icon.Props{Class: "size-3.5"})
						}
					}
					@dropdown.Content(dropdown.ContentProps{Class: "mobile-sheet", Placement: dropdown.PlacementBottomEnd}) {
						@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-mail-selection-action": "star", "data-mail-overflow-rank": "3", "data-mail-overflow-menu-item": ""}}) {
							<span class="flex items-center gap-2">
								@icon.Star(icon.Props{Class: "size-4"})
								<span data-mail-star-menu-label>{ i18n.T(ctx, "shortcuts.star") }</span>
							</span>
						}
						@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-mail-selection-action": "labels", "data-mail-overflow-rank": "2", "data-mail-overflow-menu-item": ""}}) {
							<span class="flex items-center gap-2">
								@icon.Tag(icon.Props{Class: "size-4"})
								{ i18n.T(ctx, "mail.actions.labels") }
							</span>
						}
						@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-mail-selection-action": mailSpamAction(mailFolderIDIsSpam(activeFolder, accounts)), "data-mail-overflow-rank": "1", "data-mail-overflow-menu-item": "", "data-mail-spam-toggle": ""}}) {
							<span class="flex items-center gap-2 font-medium text-emerald-700 dark:text-emerald-300" data-mail-spam-variant="not-spam" hidden?={ !mailFolderIDIsSpam(activeFolder, accounts) }>
								@icon.ShieldCheck(icon.Props{Class: "size-4"})
								{ i18n.T(ctx, "mail.actions.not_spam") }
							</span>
							<span class="flex items-center gap-2" data-mail-spam-variant="spam" hidden?={ mailFolderIDIsSpam(activeFolder, accounts) }>
								@icon.ShieldAlert(icon.Props{Class: "size-4"})
								{ i18n.T(ctx, "mail.actions.report_spam") }
							</span>
						}
					}
				}
			</div>
		</div>
	</div>
}

// MailSelectAllControl is the list's select-all checkbox, with a menu that picks
// the loaded messages by state. app.js keeps it checked, mixed or empty.
templ MailSelectAllControl() {
	<div class="mail-select-all inline-flex h-7 shrink-0 items-center gap-0.5 rounded-md pl-1.5 transition-colors" data-mail-select-all>
		@checkbox.Checkbox(checkbox.Props{
			Class:      "mail-select-all-toggle",
			Attributes: templ.Attributes{"data-mail-select-all-toggle": "", "aria-label": i18n.T(ctx, "mail.select.all_messages")},
		})
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "h-7 w-5 text-muted-foreground hover:bg-transparent dark:hover:bg-transparent",
					Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "mail.select.by_state")},
				}) {
					@icon.ChevronDown(icon.Props{Class: "size-3.5"})
				}
			}
			@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomStart, Class: "mobile-sheet mail-select-all-menu w-44"}) {
				@mailSelectMenuItem("all", i18n.T(ctx, "mail.select.all"))
				@mailSelectMenuItem("none", i18n.T(ctx, "mail.select.none"))
				@dropdown.Separator()
				@mailSelectMenuItem("read", i18n.T(ctx, "mail.select.read"))
				@mailSelectMenuItem("unread", i18n.T(ctx, "mail.select.unread"))
				@mailSelectMenuItem("starred", i18n.T(ctx, "mail.select.starred"))
				@mailSelectMenuItem("unstarred", i18n.T(ctx, "mail.select.unstarred"))
				@dropdown.Separator()
				@mailSelectMenuItem("invert", i18n.T(ctx, "mail.select.invert"))
			}
		}
	</div>
}

templ mailSelectMenuItem(value string, label string) {
	@dropdown.Item(dropdown.ItemProps{Class: "text-xs", Attributes: templ.Attributes{"data-mail-select": value}}) {
		{ label }
	}
}

// MailSelectAllBanner says how much of the list is selected, and offers to
// extend the selection to every message the folder and filters match or to
// clear it. app.js fills and shows it.
templ MailSelectAllBanner() {
	<div data-mail-select-all-banner class="mail-selection-banner" aria-hidden="true">
		<div class="mail-selection-banner-inner">
			<div class="flex items-center justify-center gap-x-3 gap-y-0.5 flex-wrap border-t border-border/60 bg-accent/60 px-4 py-1.5 text-center text-xs text-muted-foreground">
				<span data-mail-select-all-banner-text></span>
				@button.Button(button.Props{
					Variant:    button.VariantLink,
					Size:       button.SizeSm,
					Class:      "h-auto p-0 text-xs",
					Attributes: templ.Attributes{"data-mail-select-all-banner-action": ""},
				})
				@button.Button(button.Props{
					Variant:    button.VariantLink,
					Size:       button.SizeSm,
					Class:      "h-auto p-0 text-xs text-muted-foreground hover:text-foreground",
					Attributes: templ.Attributes{"data-mail-select-all-banner-clear": ""},
				}) {
					{ i18n.T(ctx, "common.clear") }
				}
			</div>
		</div>
	</div>
}

// MailFiltersPopover offers filtering by conversation only while the list
// groups mail into conversations.
// raisedButtonClass makes the theme's standard outline button (raised in
// Classic) use the card color, for the toolbar buttons beside a list or
// calendar.
const raisedButtonClass = "bg-card dark:bg-card"

// mailListFilterButtonClass is the Filters button beside the mail and
// contacts searches.
const mailListFilterButtonClass = "mail-list-advanced-filter-button relative h-9 shrink-0 gap-1.5 rounded-lg px-2.5 text-xs font-semibold text-foreground has-[>svg]:px-2.5 data-[active=true]:bg-accent data-[active=true]:text-foreground " + raisedButtonClass

templ MailFiltersPopover(accounts []models.Account, conversations bool) {
	{{ accounts = mailAccounts(accounts) }}
	@popover.Root(popover.RootProps{ID: "mail-filters-popover", Class: "inline-flex"}) {
		@popover.Trigger() {
			@button.Button(button.Props{Variant: button.VariantOutline, Class: mailListFilterButtonClass, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "mail.filters.title"), "data-mail-filter-button": ""}}) {
				<span class="mail-list-filter-label">{ i18n.T(ctx, "mail.filters.title") }</span>
				@icon.SlidersHorizontal(icon.Props{Class: "size-3.5"})
				<span data-mail-filter-count class="hidden min-w-4 rounded-full bg-primary px-1 text-center text-[10px] leading-4 text-primary-foreground"></span>
			}
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, Offset: 8, Exclusive: true, Class: "mobile-sheet mail-filters-sheet z-[70] w-[min(36rem,calc(100vw-1.5rem))] max-w-none overflow-hidden p-0 [&::backdrop]:transition-colors [&::backdrop]:duration-150 data-[tui-popover-open=false]:[&::backdrop]:bg-black/0 data-[tui-popover-open=true]:[&::backdrop]:bg-black/25"}) {
			<div class="mail-filters-sheet-body flex h-[min(32.2rem,calc(100vh-2rem))] min-h-0 flex-col">
				<div class="shrink-0 border-b border-border px-4 py-3">
					<h2 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "mail.filters.title") }</h2>
					<p class="mail-filters-intro mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "mail.filters.intro") }</p>
					<button type="button" class="mail-filters-applied hidden" data-mail-filters-applied data-mail-filters-applied-open>
						<span data-mail-filters-applied-count></span>
						@icon.ChevronRight(icon.Props{Class: "size-4"})
					</button>
				</div>
				<form data-mail-advanced-filter-form class="flex min-h-0 flex-1 flex-col gap-3 overflow-hidden p-4">
					<div class="grid min-h-0 flex-1 grid-rows-[auto_minmax(0,1fr)] gap-3 sm:grid-cols-[9rem_minmax(0,1fr)] sm:grid-rows-[minmax(0,1fr)]">
						<nav class="flex shrink-0 gap-1 overflow-x-auto rounded-lg border border-border bg-muted/25 p-1.5 sm:self-start sm:flex-col sm:overflow-visible" aria-label={ i18n.T(ctx, "mail.filters.categories") }>
							@MailFilterCategoryButton("calendar", i18n.T(ctx, "mail.filters.date_range"), true)
							@MailFilterCategoryButton("audience", i18n.T(ctx, "mail.filters.cat.audience"), false)
							@MailFilterCategoryButton("content", i18n.T(ctx, "mail.filters.cat.content"), false)
							@MailFilterCategoryButton("files", i18n.T(ctx, "mail.filters.cat.files"), false)
							@MailFilterCategoryButton("status", i18n.T(ctx, "mail.filters.cat.status"), false)
						</nav>
						<div data-mail-filter-panel-box class="h-full min-h-0 overflow-y-auto overscroll-contain rounded-lg border border-border bg-background/35 p-4 transition-[height] duration-200 ease-out">
							<section data-mail-filter-panel="calendar" class="space-y-3">
								<div>
									<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "mail.filters.date_range") }</h3>
									<p class="mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "mail.filters.date_range_help") }</p>
								</div>
								<div class="grid gap-3">
									<div class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.after") }
										@MailFilterCalendarField("after_date", "mail-filter-after-calendar", i18n.T(ctx, "mail.filters.any_date"))
									</div>
									<div class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.before") }
										@MailFilterCalendarField("before_date", "mail-filter-before-calendar", i18n.T(ctx, "mail.filters.any_date"))
									</div>
								</div>
							</section>
							<section data-mail-filter-panel="audience" class="hidden space-y-3">
								<div>
									<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "mail.filters.people_title") }</h3>
									<p class="mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "mail.filters.people_help") }</p>
								</div>
								<div class="grid gap-3">
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.contact") }
										@selectbox.SelectBox(selectbox.Props{Attributes: templ.Attributes{"data-mail-contact-filter-select": ""}}) {
											@selectbox.Trigger(selectbox.TriggerProps{Name: "participant", Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}}) {
												@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "mail.filters.contact_placeholder")})
											}
											@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "mail.filters.contact_search"), DisableExclusive: true, Attributes: templ.Attributes{"data-mail-contact-filter-content": ""}}) {
												<div data-mail-contact-filter-options>
													<p class="px-2 py-3 text-center text-xs text-muted-foreground" data-mail-contact-filter-status>{ i18n.T(ctx, "mail.filters.contact_min") }</p>
												</div>
											}
										}
										<p class="text-[11px] font-normal text-muted-foreground">{ i18n.T(ctx, "mail.filters.contact_help") }</p>
									</label>
									if len(accounts) > 0 {
										<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
											{ i18n.T(ctx, "mail.filters.account") }
											@selectbox.SelectBox() {
												@selectbox.Trigger(selectbox.TriggerProps{Name: "account_id", Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}}) {
													@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "mail.filters.any_account")})
												}
												@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
													for _, account := range accounts {
														@selectbox.Item(selectbox.ItemProps{Value: account.ID}) {
															{ accountTitle(account) }
														}
													}
												}
											}
										</label>
									}
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.from") }
										@input.Input(input.Props{Name: "from", Placeholder: i18n.T(ctx, "mail.filters.name_or_email"), Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}})
									</label>
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.from_domain") }
										@input.Input(input.Props{Name: "from_domain", Placeholder: "example.com", Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}})
									</label>
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.recipients") }
										@input.Input(input.Props{Name: "to", Placeholder: i18n.T(ctx, "mail.filters.name_or_email"), Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}})
									</label>
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.recipient_type") }
										@selectbox.SelectBox() {
											@selectbox.Trigger(selectbox.TriggerProps{Name: "recipient_type", Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}}) {
												@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "mail.filters.any_type")})
											}
											@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
												@selectbox.Item(selectbox.ItemProps{Value: "to"}) {
													{ i18n.T(ctx, "mail.field.to") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "cc"}) {
													CC
												}
												@selectbox.Item(selectbox.ItemProps{Value: "bcc"}) {
													BCC
												}
											}
										}
									</label>
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.recipient_domain") }
										@input.Input(input.Props{Name: "recipient_domain", Placeholder: "example.com", Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}})
									</label>
								</div>
							</section>
							<section data-mail-filter-panel="content" class="hidden space-y-3">
								<div>
									<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "mail.filters.content_title") }</h3>
									<p class="mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "mail.filters.content_help") }</p>
								</div>
								<div class="grid gap-3">
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.subject") }
										@input.Input(input.Props{Name: "subject", Placeholder: i18n.T(ctx, "mail.filters.subject_placeholder"), Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}})
									</label>
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.body") }
										@input.Input(input.Props{Name: "body", Placeholder: i18n.T(ctx, "mail.filters.body_placeholder"), Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}})
									</label>
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.tag") }
										@input.Input(input.Props{Name: "tag", Placeholder: i18n.T(ctx, "mail.filters.tag_placeholder"), Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}})
									</label>
								</div>
							</section>
							<section data-mail-filter-panel="files" class="hidden space-y-3">
								<div>
									<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "mail.filters.files_title") }</h3>
									<p class="mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "mail.filters.files_help") }</p>
								</div>
								<div class="grid gap-3">
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.attachment_name") }
										@input.Input(input.Props{Name: "attachment", Placeholder: "receipt.pdf", Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}})
									</label>
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.attachment_type") }
										@selectbox.SelectBox() {
											@selectbox.Trigger(selectbox.TriggerProps{Name: "attachment_type", Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": ""}}) {
												@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "mail.filters.any_type")})
											}
											@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
												@selectbox.Item(selectbox.ItemProps{Value: "pdf"}) {
													PDF
												}
												@selectbox.Item(selectbox.ItemProps{Value: "image"}) {
													{ i18n.T(ctx, "mail.filters.type.images") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "document"}) {
													{ i18n.T(ctx, "mail.filters.type.documents") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "spreadsheet"}) {
													{ i18n.T(ctx, "mail.filters.type.spreadsheets") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "presentation"}) {
													{ i18n.T(ctx, "mail.filters.type.presentations") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "archive"}) {
													{ i18n.T(ctx, "mail.filters.type.archives") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "audio"}) {
													{ i18n.T(ctx, "mail.filters.type.audio") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "video"}) {
													{ i18n.T(ctx, "mail.filters.type.video") }
												}
												@selectbox.Item(selectbox.ItemProps{Value: "custom"}) {
													{ i18n.T(ctx, "mail.filters.custom_extension") }
												}
											}
										}
									</label>
									<label data-mail-attachment-extension-field class="hidden space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.custom_extension") }
										@input.Input(input.Props{Name: "attachment_extension", Placeholder: i18n.T(ctx, "mail.filters.extension_placeholder"), Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": "", "maxlength": "16", "pattern": "\\.?[A-Za-z0-9]+", "title": i18n.T(ctx, "mail.filters.extension_title")}})
									</label>
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.min_size") }
										@input.Input(input.Props{Name: "min_size_mb", Type: input.TypeNumber, Placeholder: "0 MB", Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": "", "min": "0", "step": "0.1"}})
									</label>
									<label class="space-y-1.5 text-xs font-medium text-muted-foreground">
										{ i18n.T(ctx, "mail.filters.max_size") }
										@input.Input(input.Props{Name: "max_size_mb", Type: input.TypeNumber, Placeholder: i18n.T(ctx, "mail.filters.any_size"), Class: "h-8", Attributes: templ.Attributes{"data-mail-advanced-filter-input": "", "min": "0", "step": "0.1"}})
									</label>
								</div>
							</section>
							<section data-mail-filter-panel="status" class="hidden space-y-3">
								<div>
									<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "mail.filters.status_title") }</h3>
									<p class="mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "mail.filters.status_help") }</p>
								</div>
								<div class="grid gap-3">
									<div class="space-y-1">
										<div class="text-[11px] font-medium text-muted-foreground">{ i18n.T(ctx, "mail.filters.read_status") }</div>
										@MailFilterTriState("status", "unread", i18n.T(ctx, "mail.select.unread"), "read", i18n.T(ctx, "mail.select.read"))
									</div>
									<div class="space-y-1">
										<div class="text-[11px] font-medium text-muted-foreground">{ i18n.T(ctx, "mail.filters.attachments") }</div>
										@MailFilterTriState("attachments", "no", i18n.T(ctx, "common.no"), "yes", i18n.T(ctx, "common.yes"))
									</div>
									<div class="space-y-1">
										<div class="text-[11px] font-medium text-muted-foreground">{ i18n.T(ctx, "mail.tags") }</div>
										@MailFilterTriState("tags", "no", i18n.T(ctx, "common.no"), "yes", i18n.T(ctx, "common.yes"))
									</div>
									if conversations {
										<div class="space-y-1">
											<div class="text-[11px] font-medium text-muted-foreground">{ i18n.T(ctx, "mail.filters.threads") }</div>
											@MailFilterTriState("threads", "no", i18n.T(ctx, "common.no"), "yes", i18n.T(ctx, "common.yes"))
										</div>
									}
								</div>
							</section>
						</div>
					</div>
					<div class="mt-auto flex items-center justify-between gap-2 border-t border-border pt-3">
						<button type="button" data-mail-advanced-filter-clear class="h-8 rounded-md px-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "mail.filters.clear_all") }</button>
						<div class="flex items-center gap-2">
							<button type="button" data-mail-filters-close class="h-8 rounded-md border border-border px-3 text-xs font-medium hover:bg-accent">{ i18n.T(ctx, "common.cancel") }</button>
							<button type="submit" class="inline-flex h-8 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground hover:bg-primary/90">
								<span>{ i18n.T(ctx, "common.apply") }</span>
								<span data-mail-advanced-filter-count class="hidden min-w-4 rounded-full bg-primary-foreground/15 px-1.5 py-0.5 text-center text-[10px] leading-none">0</span>
							</button>
						</div>
					</div>
				</form>
				<div class="mail-filters-applied-view" data-mail-filters-applied-view>
					<div class="mail-filters-applied-view-header">
						<button type="button" class="mail-filters-applied-back" data-mail-filters-applied-close aria-label={ i18n.T(ctx, "mail.filters.back") }>
							@icon.ArrowLeft(icon.Props{Class: "size-5"})
						</button>
						<h2 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "mail.filters.applied") }</h2>
					</div>
					<div class="mail-filters-applied-rows" data-mail-filters-applied-list></div>
				</div>
			</div>
		}
	}
}

templ MailFilterCategoryButton(value string, label string, active bool) {
	<button
		type="button"
		data-mail-filter-panel-button={ value }
		data-active={ fmt.Sprintf("%t", active) }
		aria-selected={ fmt.Sprintf("%t", active) }
		class="shrink-0 rounded-md px-2.5 py-2 text-left text-sm font-medium text-muted-foreground transition-colors hover:bg-background/70 hover:text-foreground data-[active=true]:bg-background data-[active=true]:text-foreground data-[active=true]:shadow-sm data-[active=true]:ring-1 data-[active=true]:ring-border sm:w-full"
	>
		{ label }
	</button>
}

templ MailFilterCalendarField(name string, id string, placeholder string) {
	@popover.Root() {
		@popover.Trigger() {
			<button type="button" class="flex h-8 w-full items-center justify-between rounded-md border border-input bg-input/30 px-3 text-sm font-normal text-foreground shadow-xs hover:bg-accent/50">
				<span data-mail-date-display={ name } class="truncate text-muted-foreground">{ placeholder }</span>
				@icon.Calendar(icon.Props{Class: "size-4 text-muted-foreground"})
			</button>
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, Exclusive: false, Class: "z-[80] w-auto p-3"}) {
			@calendar.Calendar(calendar.Props{ID: id, Name: name, Class: "[--cell-size:1.9rem]", HideHiddenInput: false, MinYear: 1970, MaxYear: time.Now().Year() + 1})
		}
	}
}

templ MailListEmails(accounts []models.Account, emails []models.Email, folderID string, selectedEmail *models.Email, totalCount int, scrollCount int, windowStart int, senderDisplayMode string, viewMode string, navigationMode string) {
	<div
		id="mail-list-scroll"
		class="h-full overflow-y-auto px-2 py-2"
		data-hydrate-dropin
		data-total-count={ fmt.Sprintf("%d", scrollCount) }
		data-display-total-count={ fmt.Sprintf("%d", totalCount) }
		data-folder-id={ folderID }
		data-view-mode={ mailListViewMode(viewMode) }
		data-navigation-mode={ mailListNavigationMode(navigationMode) }
		data-window-start={ fmt.Sprintf("%d", windowStart) }
		data-page-size={ fmt.Sprintf("%d", mailListPaginationPageSize()) }
		data-account-marker-style={ accountMarkerStyle(accounts) }
		data-load-folder?={ totalCount < 0 || scrollCount < 0 }
	>
		if totalCount < 0 || scrollCount < 0 {
			<div class="flex h-full items-center justify-center">
				<div class="flex items-center gap-2 text-sm text-muted-foreground">
					<div class="size-4 border-2 border-muted-foreground/30 border-t-muted-foreground rounded-full animate-spin"></div>
					<span>{ i18n.T(ctx, "common.loading_content") }</span>
				</div>
			</div>
		} else if mailListViewMode(viewMode) == "table" {
			@MailListTableHeader(accountMarkerStyle(accounts))
		}
		if scrollCount >= 0 {
			for i, email := range emails {
				@MailListItem(accounts, email, windowStart+i, selectedEmail, senderDisplayMode, mailListViewMode(viewMode))
			}
			if len(emails) == 0 {
				@MailListEmpty()
			}
		}
	</div>
}

templ MailListPagination(totalCount int, windowStart int, itemCount int, pageSize int) {
	<div class="border-t border-border/70 bg-card/95 px-3 py-2" data-mail-pagination data-page-size={ fmt.Sprintf("%d", pageSize) }>
		<div class="flex items-center justify-between gap-2">
			<div class="min-w-0 text-[11px] font-medium text-muted-foreground" data-mail-pagination-summary>{ mailListPaginationRangeLabel(ctx, windowStart, itemCount, totalCount) }</div>
			<div class="flex items-center gap-1.5">
				<button type="button" class="inline-flex h-7 items-center gap-1 rounded-md border border-border px-2 text-[11px] font-semibold text-foreground hover:bg-accent disabled:cursor-not-allowed disabled:opacity-45" data-mail-page-prev disabled?={ windowStart <= 0 }>
					@icon.ChevronLeft(icon.Props{Class: "size-3"})
					{ i18n.T(ctx, "common.previous") }
				</button>
				<span class="min-w-16 text-center text-[11px] font-medium text-muted-foreground" data-mail-pagination-page>{ fmt.Sprintf("%d / %d", mailListPaginationPage(windowStart, pageSize), mailListPaginationTotalPages(totalCount, pageSize)) }</span>
				<button type="button" class="inline-flex h-7 items-center gap-1 rounded-md border border-border px-2 text-[11px] font-semibold text-foreground hover:bg-accent disabled:cursor-not-allowed disabled:opacity-45" data-mail-page-next disabled?={ windowStart+itemCount >= totalCount || itemCount == 0 }>
					{ i18n.T(ctx, "common.next") }
					@icon.ChevronRight(icon.Props{Class: "size-3"})
				</button>
			</div>
		</div>
	</div>
}

templ MailListItem(accounts []models.Account, email models.Email, position int, selectedEmail *models.Email, senderDisplayMode string, viewMode string) {
	if mailListViewMode(viewMode) == "table" {
		@MailListTableItem(email, position, selectedEmail, senderDisplayMode)
	} else {
		@MailListCardItem(accounts, email, position, selectedEmail, senderDisplayMode)
	}
}

templ MailListTableHeader(markerStyle string) {
	<div class="mail-list-table-header mail-list-table-grid grid items-center gap-3 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground bg-card/95 border-b border-border/70 sticky top-0 z-20 backdrop-blur-sm">
		<div class="mail-list-table-heading flex items-center justify-center" data-mail-table-column="0" data-mail-table-column-id="accountMarker" data-mail-table-cell="accountMarker" title={ i18n.T(ctx, "mail.column.accountMarker") }>
			<span class="account-color-marker size-2.5" style={ markerStyle }></span><span class="mail-list-column-separator"></span>
		</div>
		<div class="mail-list-table-heading text-center" data-mail-table-column="1" data-mail-table-column-id="starred" data-mail-table-cell="starred" title={ i18n.T(ctx, "mail.column.starred") }>
			@icon.Star(icon.Props{Class: "size-3 mx-auto"})
			<span class="mail-list-column-separator"></span>
		</div>
		<div class="mail-list-table-heading text-center" data-mail-table-column="2" data-mail-table-column-id="attachment" data-mail-table-cell="attachment" title={ i18n.T(ctx, "mail.column.attachment") }>
			@icon.Paperclip(icon.Props{Class: "size-3 mx-auto"})
			<span class="mail-list-column-separator"></span>
		</div>
		<div class="mail-list-table-heading flex items-center justify-center" data-mail-table-column="3" data-mail-table-column-id="thread" data-mail-table-cell="thread" title={ i18n.T(ctx, "mail.column.thread") }>
			@icon.MessagesSquare(icon.Props{Class: "size-3"})
			<span class="mail-list-column-separator"></span>
		</div>
		<div class="mail-list-table-heading pl-1" data-mail-table-column="4" data-mail-table-column-id="from" data-mail-table-cell="from">{ i18n.T(ctx, "mail.column.from") }<span class="mail-list-column-resize" data-mail-table-resize="4"></span></div>
		<div class="mail-list-table-heading" data-mail-table-column="5" data-mail-table-column-id="to" data-mail-table-cell="to">{ i18n.T(ctx, "mail.column.to") }<span class="mail-list-column-resize" data-mail-table-resize="5"></span></div>
		<div class="mail-list-table-heading" data-mail-table-column="6" data-mail-table-column-id="subject" data-mail-table-cell="subject">{ i18n.T(ctx, "mail.column.subject") }<span class="mail-list-column-resize" data-mail-table-resize="6"></span></div>
		<div class="mail-list-table-heading min-w-12 text-right" data-mail-table-column="7" data-mail-table-column-id="date" data-mail-table-cell="date">{ i18n.T(ctx, "mail.column.date") }</div>
	</div>
}

templ MailListColumnSelector() {
	@ListLayoutSelector("data-mail-card-layout-dialog-open", "mail", []ListColumnOption{
		{ID: "accountMarker", Label: i18n.T(ctx, "mail.column.accountMarker")},
		{ID: "starred", Label: i18n.T(ctx, "mail.column.starred")},
		{ID: "attachment", Label: i18n.T(ctx, "mail.column.attachment")},
		{ID: "thread", Label: i18n.T(ctx, "mail.column.thread")},
		{ID: "from", Label: i18n.T(ctx, "mail.column.from")},
		{ID: "to", Label: i18n.T(ctx, "mail.column.to")},
		{ID: "subject", Label: i18n.T(ctx, "mail.column.subject")},
		{ID: "date", Label: i18n.T(ctx, "mail.column.date")},
	})
}

// ListColumnOption is a column the table column menu turns on and off.
type ListColumnOption struct {
	ID    string
	Label string
}

// ListLayoutSelector is the list toolbar's pair of display buttons: the card
// layout editor in the cards view, and the column menu in the table view
// (CSS shows the one for the view on screen). list names the list's column
// description in ui-settings.js.
templ ListLayoutSelector(cardOpenAttribute string, list string, columns []ListColumnOption) {
	<div data-mail-card-layout-trigger-wrapper>
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "h-6 w-6 rounded-md", Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "mail.card_layout.customize"), cardOpenAttribute: ""}}) {
					@icon.LayoutTemplate(icon.Props{Class: "size-3.5"})
				}
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionBottom, ShowArrow: true}) {
				{ i18n.T(ctx, "mail.card_layout.title") }
			}
		}
	</div>
	<div data-mail-table-column-trigger-wrapper>
		@dropdown.Dropdown() {
			@dropdown.Trigger(dropdown.TriggerProps{Attributes: templ.Attributes{"data-mail-list-display-menu-button": ""}}) {
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "h-6 w-6 rounded-md", Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "mail.columns.customize")}}) {
					@icon.Settings(icon.Props{Class: "size-3.5"})
				}
			}
			@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "normal-case tracking-normal", Attributes: templ.Attributes{"data-mail-list-display-menu": ""}}) {
				<div data-mail-table-column-menu data-table-columns-list={ list }>
					@dropdown.Label(dropdown.LabelProps{Class: "text-xs text-muted-foreground"}) {
						{ i18n.T(ctx, "mail.columns.title") }
					}
					for _, column := range columns {
						@MailListColumnOption(column.ID, column.Label)
					}
				</div>
			}
		}
	</div>
}

templ MailListColumnOption(value string, label string) {
	@dropdown.Item(dropdown.ItemProps{PreventClose: true, Class: "gap-2", Attributes: templ.Attributes{"data-mail-table-column-item": value}}) {
		<span class="w-4 shrink-0 text-primary opacity-0" data-mail-table-column-check={ value }>
			@icon.Check(icon.Props{Class: "size-4"})
		</span>
		<span class="flex-1 text-left">{ label }</span>
	}
}

templ MailCardLayoutDialog() {
	@CardLayoutDialog(CardLayoutDialogProps{
		ID:           "mail-card-layout-dialog",
		PreviewClass: "px-3.5 py-2.5",
		PreviewScope: "data-mail-card-layout-scope",
		IconRule:     i18n.T(ctx, "mail.card_layout.icon_fields_rule"),
		TextRule:     i18n.T(ctx, "mail.card_layout.text_fields_rule"),
		Options:      mailCardLayoutOptions(),
	}) {
		<div class="mail-list-card-zone mail-list-card-zone-rail-top" data-mail-card-zone="railTop" data-mail-card-layout-zone-items="railTop" data-mail-card-layout-dropzone="railTop">
			<span data-mail-card-field="avatar"><span class="inline-flex size-6 items-center justify-center rounded-full bg-primary/15 text-[10px] font-semibold text-primary shadow-[0_1px_3px_rgba(0,0,0,0.15)]">CB</span></span>
		</div>
		<div class="mail-list-card-zone mail-list-card-zone-rail-middle" data-mail-card-zone="railMiddle" data-mail-card-layout-zone-items="railMiddle" data-mail-card-layout-dropzone="railMiddle">
			<span data-mail-card-field="accountMarker" class="inline-flex items-center justify-center shrink-0">
				<span class="account-color-marker size-2.5 shrink-0 bg-primary"></span>
			</span>
		</div>
		<div class="mail-list-card-zone mail-list-card-zone-rail-bottom" data-mail-card-zone="railBottom" data-mail-card-layout-zone-items="railBottom" data-mail-card-layout-dropzone="railBottom">
			<span data-mail-card-field="thread" class="inline-flex items-center gap-0.5 text-[11px] text-muted-foreground">
				@icon.MessagesSquare(icon.Props{Class: "size-3"})
				3
			</span>
		</div>
		<div class="mail-list-card-zone mail-list-card-zone-header" data-mail-card-zone="header" data-mail-card-layout-zone-items="header" data-mail-card-layout-dropzone="header">
			<span data-mail-card-field="from" class="truncate text-sm font-semibold text-foreground">Cristian Braun</span>
			<span data-mail-card-field="date" class="text-xs font-medium tabular-nums text-primary">
				@mailListDate(i18n.T(ctx, "date.yesterday"), i18n.T(ctx, "date.pattern.date_time", "date", i18n.T(ctx, "date.yesterday"), "time", i18n.Dates(ctx).ClockTime(10, 42)))
			</span>
			<span data-mail-card-field="account" class="inline-flex min-w-0">
				<span class="mail-list-card-account inline-flex min-w-0 items-center gap-1 rounded-lg border border-border/70 bg-background/40 px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
					<span class="mail-list-card-account-marker account-color-marker size-2 shrink-0 bg-primary"></span>
					<span class="truncate">{ i18n.T(ctx, "mail.card_layout.sample_account") }</span>
				</span>
			</span>
		</div>
		<div class="mail-list-card-zone mail-list-card-zone-meta" data-mail-card-zone="meta" data-mail-card-layout-zone-items="meta" data-mail-card-layout-dropzone="meta">
			<span data-mail-card-field="attachment" class="inline-flex items-center gap-0.5 text-[11px] text-muted-foreground">
				@icon.Paperclip(icon.Props{Class: "size-3"})
				<span class="mail-list-card-attachment-count tabular-nums">2</span>
			</span>
			<span data-mail-card-field="unread" class="inline-flex size-4 shrink-0 items-center justify-center">
				<span class="size-2 rounded-full bg-primary shadow-[0_0_6px_rgba(199,123,48,0.4)]"></span>
			</span>
		</div>
		<div class="mail-list-card-zone mail-list-card-zone-body" data-mail-card-zone="body" data-mail-card-layout-zone-items="body" data-mail-card-layout-dropzone="body">
			<p data-mail-card-field="to" class="truncate text-[11px] leading-snug text-muted-foreground">
				<span class="font-medium text-muted-foreground">{ i18n.T(ctx, "mail.field.to") }</span>
				cristian@gofer.email
			</p>
			<p data-mail-card-field="cc" class="truncate text-[11px] leading-snug text-muted-foreground">
				<span class="font-medium text-muted-foreground">{ i18n.T(ctx, "mail.field.cc") }</span>
				design@gofer.email
			</p>
		</div>
		<div class="mail-list-card-zone mail-list-card-zone-body-bottom" data-mail-card-zone="bodyBottom" data-mail-card-layout-zone-items="bodyBottom" data-mail-card-layout-dropzone="bodyBottom">
			<p data-mail-card-field="subject" class="truncate text-[13px] font-medium text-foreground">{ i18n.T(ctx, "mail.card_layout.sample_subject") }</p>
		</div>
		<div class="mail-list-card-zone mail-list-card-zone-footer" data-mail-card-zone="footer" data-mail-card-layout-zone-items="footer" data-mail-card-layout-dropzone="footer">
			<p data-mail-card-field="preview" class="min-w-0 flex-1 truncate text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "mail.card_layout.sample_preview") }</p>
			<span class="mail-list-card-labels" data-mail-card-field="labels">
				<span class="shrink-0 rounded bg-primary/10 px-1.5 py-0.5 text-[10px] font-medium text-primary shadow-[0_1px_2px_rgba(0,0,0,0.08)]">{ i18n.T(ctx, "mail.card_layout.sample_label") }</span>
			</span>
		</div>
		<div class="mail-list-card-zone mail-list-card-zone-status" data-mail-card-zone="status" data-mail-card-layout-zone-items="status" data-mail-card-layout-dropzone="status"></div>
		<div class="mail-list-card-zone mail-list-card-zone-corner" data-mail-card-zone="corner" data-mail-card-layout-zone-items="corner" data-mail-card-layout-dropzone="corner">
			<span data-mail-card-field="starred">
				@icon.Star(icon.Props{Class: "size-3.5 shrink-0 fill-amber-500 text-amber-500 drop-shadow-[0_1px_1px_rgba(180,120,0,0.4)]"})
			</span>
		</div>
	}
}

// mailCardLayoutOptions are the mail card fields' own options, opened from a
// field's ⚙. Rendered as a popover so it sits above the dialog, next to the
// field.
templ mailCardLayoutOptions() {
	<div popover="manual" class="mail-card-layout-options" data-mail-card-layout-options>
		<div class="space-y-2" data-mail-card-layout-options-for="date">
			<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "mail.column.date") }</div>
			<div class="flex items-center justify-between gap-4">
				<span id="mail-card-option-date-time-label" class="text-xs text-muted-foreground">{ i18n.T(ctx, "mail.card_layout.always_time") }</span>
				@switchcomp.Switch(switchcomp.Props{
					ID:         "mail-card-option-date-time",
					Attributes: templ.Attributes{"aria-labelledby": "mail-card-option-date-time-label", "data-mail-card-option": "mail_card_date_time"},
				})
			</div>
		</div>
		<div class="space-y-2" data-mail-card-layout-options-for="account" hidden>
			<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "mail.filters.account") }</div>
			<div class="flex items-center justify-between gap-4">
				<span id="mail-card-option-account-marker-label" class="text-xs text-muted-foreground">{ i18n.T(ctx, "mail.card_layout.account_marker") }</span>
				@switchcomp.Switch(switchcomp.Props{
					ID:         "mail-card-option-account-marker",
					Attributes: templ.Attributes{"aria-labelledby": "mail-card-option-account-marker-label", "data-mail-card-option": "mail_card_account_marker"},
				})
			</div>
		</div>
	</div>
}

// CardLayoutDialogProps describe a list's card layout editor: its preview
// card (the dialog's children, one element per field in its default zone),
// the placement rules shown in its help, and its fields' options, if any.
type CardLayoutDialogProps struct {
	ID           string
	PreviewClass string
	// PreviewScope is the attribute the list's cards are laid out by, so the
	// preview takes the saved layout like they do.
	PreviewScope string
	IconRule     string
	TextRule     string
	Options      templ.Component
}

// CardLayoutDialog is the card layout editor of the mail and contacts lists;
// mail-card-layout.js drives it.
templ CardLayoutDialog(props CardLayoutDialogProps) {
	@dialog.Dialog(dialog.Props{ID: props.ID}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-5xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "mail.card_layout.title") }
				}
			}
			if props.Options != nil {
				@props.Options
			}
			<div class="mail-card-layout-dialog-grid grid gap-3">
				<div class="space-y-2 min-w-0">
					<div class="flex items-center justify-between gap-2">
						<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "mail.card_layout.card") }</div>
						<div class="flex items-center gap-2">
							<button type="button" data-mail-card-layout-reset class="inline-flex h-7 items-center gap-1.5 rounded-md border border-border bg-card px-2 text-[11px] font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">
								@icon.RotateCcw(icon.Props{Class: "size-3"})
								{ i18n.T(ctx, "mail.card_layout.reset") }
							</button>
							<div class="text-[11px] font-medium text-muted-foreground tabular-nums" data-mail-card-layout-limit></div>
						</div>
					</div>
					<div class="mail-card-layout-preview-shell rounded-lg border border-border bg-background/45 p-3">
						<div class={ "mail-card-layout-preview-card mail-list-card rounded-lg border border-border bg-card shadow-sm " + props.PreviewClass } data-mail-card-layout-preview { templ.Attributes{props.PreviewScope: ""}... }>
							{ children... }
							<div class="hidden" data-mail-card-zone="hidden"></div>
						</div>
					</div>
				</div>
				<div class="mail-card-layout-hidden-panel min-w-0 rounded-lg border border-border bg-background/45 p-2" data-mail-card-layout-dropzone="hidden">
					<div class="mb-1 flex items-center justify-between gap-2">
						<div class="flex min-w-0 items-center gap-1.5">
							<div class="truncate text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "mail.card_layout.available") }</div>
							@tooltip.Tooltip() {
								@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex shrink-0"}) {
									<button type="button" class="mail-card-layout-help-trigger" aria-label={ i18n.T(ctx, "mail.card_layout.rules") }>
										@icon.CircleQuestionMark(icon.Props{Class: "size-3.5"})
									</button>
								}
								@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "mail-card-layout-help-tooltip"}) {
									<p><strong>{ i18n.T(ctx, "mail.card_layout.text_fields") }</strong> { props.TextRule }</p>
									<p><strong>{ i18n.T(ctx, "mail.card_layout.icon_fields") }</strong> { props.IconRule }</p>
								}
							}
						</div>
					</div>
					<div class="mail-card-layout-available-list min-h-10 rounded-md border border-dashed border-border/80 bg-card/70 p-1.5" data-mail-card-layout-zone-items="hidden"></div>
				</div>
			</div>
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Class: "h-8 px-3 text-xs"}) {
						{ i18n.T(ctx, "common.done") }
					}
				}
			}
		}
	}
}

templ MailListCardItem(accounts []models.Account, email models.Email, position int, selectedEmail *models.Email, senderDisplayMode string) {
	<div class="mail-list-item" data-email-id={ email.ID } data-account-id={ email.AccountID } data-folder-id={ email.FolderID } data-position={ fmt.Sprintf("%d", position) } data-thread-id={ email.ThreadID } data-has-thread={ fmt.Sprintf("%t", email.ThreadCount > 1) } data-thread-count={ fmt.Sprintf("%d", email.ThreadCount) } data-is-read={ fmt.Sprintf("%t", email.IsRead) } data-starred={ fmt.Sprintf("%t", email.IsStarred) } data-is-draft={ fmt.Sprintf("%t", email.IsDraft) }
		if email.SearchLocation != "" {
			data-search-location={ email.SearchLocation }
		}
		data-search-group?={ email.SearchLocation != "" }
	>
		@mailRowCheck()
		<a
			href={ templ.URL(fmt.Sprintf("/?email=%s", email.ID)) }
			hx-get={ mailViewPartialURL(email.ID, email.FolderID, false) }
			hx-target="#mail-view"
			hx-swap="innerHTML"
			class={
				"mail-list-card px-3.5 py-2.5 rounded-lg cursor-pointer transition-all duration-200 group",
				templ.KV("envelope-active", selectedEmail != nil && selectedEmail.ID == email.ID),
				templ.KV("envelope", selectedEmail == nil || selectedEmail.ID != email.ID),
			}
			data-mail-card-layout-scope
		>
			// Search results name where each message is, across the card's top
			// edge. Every card has it; the table shows it once per run.
			if email.SearchLocation != "" {
				<div class="mail-search-location-strip" title={ email.SearchLocation } data-mail-search-location>
					@icon.Folder(icon.Props{Class: "size-3 shrink-0"})
					<span class="truncate">{ email.SearchLocation }</span>
				</div>
			}
			<div class="mail-list-card-zone mail-list-card-zone-rail-top" data-mail-card-zone="railTop">
				<div data-mail-card-field="avatar">
					@ContactAvatar(email.From, "size-6 rounded-full text-[10px] font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.15)]", contactAvatarListFallback(email.IsRead))
				</div>
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-rail-middle" data-mail-card-zone="railMiddle">
				<span data-mail-card-field="accountMarker" class="inline-flex items-center justify-center shrink-0">
					<span class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(email.AccountColor) }></span>
				</span>
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-rail-bottom" data-mail-card-zone="railBottom">
				if email.ThreadCount > 1 {
					<button type="button" data-thread-toggle={ email.ID } data-mail-card-field="thread" class="flex items-center gap-0.5 text-xs text-muted-foreground shrink-0 hover:text-foreground transition-colors cursor-pointer">
						@icon.MessagesSquare(icon.Props{Class: "size-3"})
						{ fmt.Sprintf("%d", email.ThreadCount) }
						@icon.ChevronRight(icon.Props{Class: "size-3 transition-transform thread-toggle-chevron"})
					</button>
				} else {
					<span data-mail-card-field="thread" class="mail-list-card-empty-icon-slot" aria-hidden="true"></span>
				}
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-header" data-mail-card-zone="header">
				<span
					class={
						"text-[15px] truncate",
						templ.KV("font-bold text-primary", !email.IsRead),
						templ.KV("text-black dark:text-foreground", email.IsRead),
					}
					data-mail-card-field="from"
				>
					{ senderDisplayPrimary(email.From, senderDisplayMode) }
					if suffix := senderDisplayAddressSuffix(email.From, senderDisplayMode); suffix != "" {
						<span class="mail-sender-address">{ suffix }</span>
					}
				</span>
				<span
					class={
						"text-[13px] tabular-nums",
						templ.KV("text-primary font-semibold", !email.IsRead),
						templ.KV("text-black dark:text-foreground", email.IsRead),
					}
					data-mail-card-field="date"
				>
					@mailListDate(email.Date, email.DateWithTime)
				</span>
				<span data-mail-card-field="account" class="mail-list-card-account inline-flex min-w-0 max-w-[42%] items-center gap-1 rounded-lg border border-border/70 bg-background/40 px-1.5 py-0.5 text-[11px] font-medium text-muted-foreground">
					<span class="mail-list-card-account-marker account-color-marker size-2 shrink-0" style={ accountColorStyle(email.AccountColor) }></span>
					<span class="truncate">{ mailListAccountDisplay(accounts, email.AccountID) }</span>
				</span>
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-meta" data-mail-card-zone="meta">
				if email.HasAttachment {
					<span data-mail-card-field="attachment" class="inline-flex items-center gap-0.5 text-xs text-muted-foreground">
						@icon.Paperclip(icon.Props{Class: "size-3"})
						// Absent when only another message in the thread has attachments.
						if email.AttachmentCount > 0 {
							<span class="mail-list-card-attachment-count tabular-nums">{ fmt.Sprintf("%d", email.AttachmentCount) }</span>
						}
					</span>
				} else {
					<span data-mail-card-field="attachment" class="mail-list-card-empty-icon-slot" aria-hidden="true"></span>
				}
				if !email.IsRead {
					<span data-mail-card-field="unread" class="inline-flex size-4 shrink-0 items-center justify-center">
						<span class="size-2 rounded-full bg-primary shadow-[0_0_6px_rgba(199,123,48,0.4)]"></span>
					</span>
				} else {
					<span data-mail-card-field="unread" class="mail-list-card-empty-icon-slot" aria-hidden="true"></span>
				}
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-body" data-mail-card-zone="body">
				if len(email.To) > 0 {
					<p data-mail-card-field="to" class="text-xs text-black dark:text-foreground truncate leading-snug">
						<span class="font-medium text-muted-foreground">{ i18n.T(ctx, "mail.field.to") }</span>
						{ contactsDisplay(email.To, senderDisplayMode) }
					</p>
				}
				if len(email.CC) > 0 {
					<p data-mail-card-field="cc" class="text-xs text-black dark:text-foreground truncate leading-snug">
						<span class="font-medium text-muted-foreground">{ i18n.T(ctx, "mail.field.cc") }</span>
						{ contactsDisplay(email.CC, senderDisplayMode) }
					</p>
				}
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-body-bottom" data-mail-card-zone="bodyBottom">
				<p
					class={
						"text-sm truncate",
						templ.KV("font-semibold text-primary", !email.IsRead),
						templ.KV("text-black dark:text-foreground", email.IsRead),
					}
					data-mail-card-field="subject"
				>{ i18n.Subject(ctx, email.Subject) }</p>
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-footer" data-mail-card-zone="footer">
				<p class="min-w-0 flex-1 text-[13px] text-black dark:text-foreground truncate leading-normal" data-mail-card-field="preview">
					{ i18n.Preview(ctx, email.Preview) }
				</p>
				if len(email.Labels) > 0 {
					// One field for all labels, so it moves and sizes as a unit.
					<span class="mail-list-card-labels" data-mail-card-field="labels">
						for _, label := range email.Labels {
							<span class={ "text-[11px] px-1.5 py-0.5 rounded font-medium shrink-0 shadow-[0_1px_2px_rgba(0,0,0,0.08)]", label.Color }>
								{ label.Name }
							</span>
						}
					</span>
				}
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-status" data-mail-card-zone="status"></div>
			<div class="mail-list-card-zone mail-list-card-zone-corner" data-mail-card-zone="corner">
				if email.IsStarred {
					<button class="star-btn shrink-0" data-email-id={ email.ID } data-mail-card-field="starred" aria-label={ i18n.T(ctx, "mail.actions.unstar") }>
						@icon.Star(icon.Props{Class: "size-3.5 text-amber-500 fill-amber-500 shrink-0 drop-shadow-[0_1px_1px_rgba(180,120,0,0.4)]"})
					</button>
				} else {
					<button class="opacity-0 group-hover:opacity-100 transition-opacity star-btn shrink-0" data-email-id={ email.ID } data-mail-card-field="starred">
						@icon.Star(icon.Props{Class: "size-3.5 text-muted-foreground opacity-70"})
					</button>
				}
			</div>
			<div class="hidden" data-mail-card-zone="hidden"></div>
		</a>
	</div>
}

templ MailListTableItem(email models.Email, position int, selectedEmail *models.Email, senderDisplayMode string) {
	<div class="mail-list-item mail-list-table-row" data-email-id={ email.ID } data-account-id={ email.AccountID } data-folder-id={ email.FolderID } data-position={ fmt.Sprintf("%d", position) } data-thread-id={ email.ThreadID } data-has-thread={ fmt.Sprintf("%t", email.ThreadCount > 1) } data-thread-count={ fmt.Sprintf("%d", email.ThreadCount) } data-is-read={ fmt.Sprintf("%t", email.IsRead) } data-starred={ fmt.Sprintf("%t", email.IsStarred) } data-is-draft={ fmt.Sprintf("%t", email.IsDraft) }
		if email.SearchLocation != "" {
			data-search-location={ email.SearchLocation }
		}
		data-search-group?={ email.SearchGroupStart }
	>
		@mailRowCheck()
		<a
			href={ templ.URL(fmt.Sprintf("/?email=%s", email.ID)) }
			hx-get={ mailViewPartialURL(email.ID, email.FolderID, false) }
			hx-target="#mail-view"
			hx-swap="innerHTML"
			class={
				"mail-list-table-grid grid items-center gap-3 px-3 py-1.5 rounded-md cursor-pointer transition-all duration-150 group text-xs",
				templ.KV("envelope-active", selectedEmail != nil && selectedEmail.ID == email.ID),
				templ.KV("envelope", selectedEmail == nil || selectedEmail.ID != email.ID),
			}
		>
			// Search results name where each message is in a band above the
			// row, across the columns, like the cards' strip; once above each
			// run of results from the same place.
			if email.SearchGroupStart {
				<div class="mail-search-location-strip" title={ email.SearchLocation } data-mail-search-location>
					@icon.Folder(icon.Props{Class: "size-3 shrink-0"})
					<span class="truncate">{ email.SearchLocation }</span>
				</div>
			}
			<div class="flex items-center justify-center" data-mail-table-cell="accountMarker">
				<span class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(email.AccountColor) }></span>
			</div>
			<div class="flex items-center justify-center text-muted-foreground" data-mail-table-cell="starred">
				if email.IsStarred {
					<button class="star-btn" data-email-id={ email.ID } aria-label={ i18n.T(ctx, "mail.actions.unstar") }>
						@icon.Star(icon.Props{Class: "size-3.5 text-amber-500 fill-amber-500"})
					</button>
				} else {
					<button class="opacity-0 group-hover:opacity-100 transition-opacity star-btn" data-email-id={ email.ID }>
						@icon.Star(icon.Props{Class: "size-3.5 text-muted-foreground opacity-70"})
					</button>
				}
			</div>
			<div class="flex items-center justify-center text-muted-foreground" data-mail-table-cell="attachment">
				if email.HasAttachment {
					@icon.Paperclip(icon.Props{Class: "size-3"})
				}
			</div>
			<div class="flex items-center justify-start min-w-0" data-mail-table-cell="thread">
				if email.ThreadCount > 1 {
					<button type="button" data-thread-toggle={ email.ID } class="flex items-center gap-0.5 text-[11px] text-muted-foreground shrink-0 hover:text-foreground transition-colors cursor-pointer">
						@icon.MessagesSquare(icon.Props{Class: "size-3"})
						{ fmt.Sprintf("%d", email.ThreadCount) }
						@icon.ChevronRight(icon.Props{Class: "size-3 transition-transform thread-toggle-chevron"})
					</button>
				}
			</div>
			<div class="flex items-center min-w-0" data-mail-table-cell="from">
				<span
					class={
						"truncate",
						templ.KV("font-semibold text-foreground", !email.IsRead),
						templ.KV("text-muted-foreground", email.IsRead),
					}
				>{ senderDisplay(email.From, senderDisplayMode) }</span>
			</div>
			<div class="flex items-center min-w-0" data-mail-table-cell="to">
				<span
					class={
						"truncate",
						templ.KV("font-medium text-muted-foreground", !email.IsRead),
						templ.KV("text-muted-foreground", email.IsRead),
					}
				>{ contactsDisplay(email.To, senderDisplayMode) }</span>
			</div>
			<div class="flex items-center gap-2 min-w-0" data-mail-table-cell="subject">
				<div class="min-w-0 overflow-hidden">
					<span
						class={
							"block truncate",
							templ.KV("font-medium text-foreground", !email.IsRead),
							templ.KV("text-muted-foreground", email.IsRead),
						}
					>{ i18n.Subject(ctx, email.Subject) }</span>
				</div>
				if len(email.Labels) > 0 {
					for _, label := range email.Labels {
						<span class={ "hidden xl:inline text-[10px] px-1.5 py-0.5 rounded font-medium shrink-0", label.Color }>
							{ label.Name }
						</span>
					}
				}
			</div>
			<div class="flex items-center justify-end gap-1.5 shrink-0 text-muted-foreground tabular-nums" data-mail-table-cell="date">
				if !email.IsRead {
					<span class="size-2 shrink-0 rounded-full bg-primary shadow-[0_0_6px_rgba(199,123,48,0.4)]" aria-label={ i18n.T(ctx, "mail.state.unread") }></span>
				}
				<span class={ templ.Classes("min-w-12 text-right", templ.KV("text-primary font-medium", !email.IsRead)) }>
					@mailListDate(email.Date, email.DateWithTime)
				</span>
			</div>
		</a>
	</div>
}

templ MailListEmpty() {
	<div class="flex flex-col items-center justify-center py-20 px-4 text-center">
		<div class="empty-icon-box size-16 rounded-2xl bg-muted/50 flex items-center justify-center mb-4 raised">
			@icon.Inbox(icon.Props{Class: "size-7 text-muted-foreground opacity-40"})
		</div>
		<h3 class="font-semibold text-sm mb-1">{ i18n.T(ctx, "mail.empty.title") }</h3>
		<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "mail.empty.description") }</p>
	</div>
}

templ MailListItemsFragment(accounts []models.Account, emails []models.Email, folderID string, windowStart, windowEnd, totalCount int, displayTotalCount int, nextCursor string, hasMore bool, selectedEmailId string, senderDisplayMode string, viewMode string) {
	<div
		data-total-count={ fmt.Sprintf("%d", totalCount) }
		data-display-total-count={ fmt.Sprintf("%d", displayTotalCount) }
		data-window-start={ fmt.Sprintf("%d", windowStart) }
		data-window-end={ fmt.Sprintf("%d", windowEnd) }
		data-next-cursor={ nextCursor }
		data-has-more={ fmt.Sprintf("%t", hasMore) }
		data-folder-id={ folderID }
		data-view-mode={ mailListViewMode(viewMode) }
	>
		for i, email := range emails {
			@MailListItem(accounts, email, windowStart+i, &models.Email{ID: selectedEmailId}, senderDisplayMode, mailListViewMode(viewMode))
		}
	</div>
}

templ MailListThreadSubItems(items []models.ThreadItem, senderDisplayMode string) {
	<div>
		for _, item := range items {
			<div class="thread-sub-item" data-sub-email-id={ item.ID }>
				@mailRowCheck()
				<a
					href={ templ.URL(fmt.Sprintf("/?email=%s", item.ID)) }
					hx-get={ mailViewPartialURL(item.ID, item.FolderID, true) }
					hx-target="#mail-view"
					hx-swap="innerHTML"
					class="flex items-start gap-2.5 px-3 py-1.5 cursor-pointer transition-colors hover:bg-muted/50"
				>
					<div class="flex items-center justify-center shrink-0" data-mail-table-cell="accountMarker">
						<span class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(item.AccountColor) }></span>
					</div>
					<div data-mail-table-cell="thread">
						@ContactAvatar(item.From, "size-5 rounded-full text-[9px] font-semibold shrink-0 mt-0.5", contactAvatarListFallback(item.IsRead))
					</div>
					<div class="flex-1 min-w-0">
						<div class="flex items-center justify-between gap-2">
							<span
								class={
									"text-xs truncate",
									templ.KV("font-medium text-foreground", !item.IsRead),
									templ.KV("text-muted-foreground", item.IsRead),
								}
								data-mail-table-cell="from"
							>{ senderDisplay(item.From, senderDisplayMode) }</span>
							<span
								class={
									"text-xs truncate",
									templ.KV("font-medium text-muted-foreground", !item.IsRead),
									templ.KV("text-muted-foreground", item.IsRead),
								}
								data-mail-table-cell="to"
							>{ contactsDisplay(item.To, senderDisplayMode) }</span>
							<div class="flex items-center justify-center shrink-0" data-mail-table-cell="attachment">
								if item.HasAttachment {
									@icon.Paperclip(icon.Props{Class: "size-3 text-muted-foreground"})
								}
							</div>
							<div class="flex items-center justify-center shrink-0" data-mail-table-cell="starred">
								if item.IsStarred {
									<button class="star-btn" data-email-id={ item.ID } aria-label={ i18n.T(ctx, "mail.actions.unstar") }>
										@icon.Star(icon.Props{Class: "size-3 text-amber-500 fill-amber-500 drop-shadow-[0_1px_1px_rgba(180,120,0,0.4)]"})
									</button>
								} else {
									<button class="opacity-0 group-hover:opacity-100 transition-opacity star-btn" data-email-id={ item.ID }>
										@icon.Star(icon.Props{Class: "size-3 text-muted-foreground opacity-70"})
									</button>
								}
							</div>
							<div class="flex items-center gap-1.5 shrink-0" data-mail-table-cell="date">
								<span class="text-[11px] text-muted-foreground tabular-nums">
									@mailListDate(item.Date, item.DateWithTime)
								</span>
							</div>
						</div>
						<p class="text-[11px] text-muted-foreground truncate leading-relaxed" data-mail-table-cell="subject">{ i18n.Preview(ctx, item.Preview) }</p>
					</div>
					if !item.IsRead {
						<div class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></div>
					}
				</a>
			</div>
		}
	</div>
}

// mailNotSpamButtonClass marks the toolbar's spam button as Not spam in a Spam
// folder, as the reading pane's does. app.js toggles it when the folder
// changes, reading it from the button.
const mailNotSpamButtonClass = "border border-amber-500/35 bg-amber-500/12 text-amber-700 shadow-[0_1px_2px_rgba(0,0,0,0.04)] hover:bg-amber-500/20 hover:text-amber-800 dark:border-amber-300/20 dark:bg-amber-300/10 dark:text-amber-300 dark:hover:text-amber-200"

func mailSpamButtonClass(spamFolder bool) string {
	if spamFolder {
		return "h-7 w-7 " + mailNotSpamButtonClass
	}
	return "h-7 w-7"
}

func mailSpamAction(spamFolder bool) string {
	if spamFolder {
		return "not-spam"
	}
	return "spam"
}

// mailToolbarSpamButton reports the selection as spam, or in a Spam folder
// marks it as not spam. The list switches folders without drawing the
// toolbar again, so app.js switches the button between the two.
templ mailToolbarSpamButton(spamFolder bool) {
	<div class="mail-toolbar-collapsible" data-mail-overflow-rank="1">
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				@button.Button(button.Props{
					Variant:  button.VariantGhost,
					Size:     button.SizeIcon,
					Class:    mailSpamButtonClass(spamFolder),
					Disabled: true,
					Attributes: templ.Attributes{
						"data-mail-selection-action": mailSpamAction(spamFolder),
						"aria-label":                 mailSpamLabel(ctx, spamFolder),
						"data-mail-spam-toggle":      "",
						"data-mail-not-spam-class":   mailNotSpamButtonClass,
					},
				}) {
					<span class="inline-flex" data-mail-spam-variant="not-spam" hidden?={ !spamFolder }>
						@icon.ShieldCheck(icon.Props{Class: "size-3.5"})
					</span>
					<span class="inline-flex" data-mail-spam-variant="spam" hidden?={ spamFolder }>
						@icon.ShieldAlert(icon.Props{Class: "size-3.5"})
					</span>
				}
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				<span data-mail-spam-tooltip>
					if spamFolder {
						{ i18n.T(ctx, "mail.actions.not_spam") }
					} else {
						{ i18n.T(ctx, "mail.actions.report_spam") }
					}
				</span>
			}
		}
	</div>
}

func mailSpamLabel(ctx context.Context, spamFolder bool) string {
	if spamFolder {
		return i18n.T(ctx, "mail.selection.not_spam")
	}
	return i18n.T(ctx, "mail.selection.spam")
}

// listSelectionClear is the phone selection bar's ✕ and count, the mail
// list's and the contacts list's; app.js shows it while selecting.
templ listSelectionClear(attrs templ.Attributes, summaryAttrs templ.Attributes) {
	@button.Button(button.Props{
		Variant:    button.VariantGhost,
		Size:       button.SizeSm,
		Class:      "hidden lg:hidden h-7 gap-1 px-2 text-xs font-semibold text-muted-foreground",
		Attributes: mergeTemplAttrs(templ.Attributes{"aria-label": i18n.T(ctx, "shortcuts.clear_selection")}, attrs),
	}) {
		<span class="mail-selection-clear-icon hidden" aria-hidden="true">
			@icon.X(icon.Props{Class: "size-5"})
		</span>
		<span { summaryAttrs... }>0</span>
	}
}

// mailRowCheck is a message row's checkbox (listRowCheck).
templ mailRowCheck() {
	@listRowCheck(i18n.T(ctx, "mail.select.message"))
}

// listRowCheck is a row's checkbox, shown left of the row while the list,
// mail's or contacts', is selecting. app.js keeps it checked and toggles the
// row when it is clicked.
templ listRowCheck(label string) {
	<div class="mail-row-check" data-mail-row-check>
		@checkbox.Checkbox(checkbox.Props{
			Class:      "mail-row-check-input",
			Attributes: templ.Attributes{"tabindex": "-1", "aria-label": label},
		})
	</div>
}
