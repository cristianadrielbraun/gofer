package views

import (
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// settingsSectionHref is where a Settings section's sidebar item leads.
func settingsSectionHref(value string) string {
	if value == "diagnostics" {
		return OwnerAvatarDiagnosticsPath
	}
	return "/settings/" + value
}

// OwnerDiagnosticsLayout is Settings → Diagnostics as a whole page: page
// is "avatars", "contacts" or "labels", and content its diagnostics.
templ OwnerDiagnosticsLayout(uiSettings map[string]string, page string, content templ.Component) {
	@SettingsSectionLayout(uiSettings, "diagnostics", i18n.T(ctx, "settings.section.diagnostics.title"), OwnerDiagnosticsPartial(page, content))
}

// OwnerDiagnosticsPartial is Settings → Diagnostics' content, for a page
// that's already open.
templ OwnerDiagnosticsPartial(page string, content templ.Component) {
	@settingsSectionContent("diagnostics", true, ownerDiagnostics(page, content))
}

templ ownerDiagnostics(page string, content templ.Component) {
	<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
		@linkTabs(i18n.T(ctx, "settings.diagnostics.pages")) {
			@ownerDiagnosticsTab(OwnerAvatarDiagnosticsPath, i18n.T(ctx, "admin.nav.avatars"), page == "avatars")
			@ownerDiagnosticsTab(OwnerDiagnosticsPath+"/contacts", i18n.T(ctx, "admin.nav.contacts"), page == "contacts")
			@ownerDiagnosticsTab(OwnerDiagnosticsPath+"/labels", i18n.T(ctx, "admin.nav.labels"), page == "labels")
		}
		<a href="/settings/operations" class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground" data-owner-diagnostics-operations>
			{ i18n.T(ctx, "settings.section.operations.title") }
			@icon.ArrowRight(icon.Props{Class: "size-3.5"})
		</a>
	</div>
	<div class="mt-6" data-owner-diagnostics={ page }>
		@content
	</div>
}

// ownerDiagnosticsTab opens one of the diagnostics in place, as the
// sidebar opens a section.
templ ownerDiagnosticsTab(href string, label string, active bool) {
	@linkTab(templ.URL(href), label, active, templ.Attributes{
		"hx-get": href, "hx-target": "#settings-content", "hx-select": "#settings-content",
		"hx-swap": "outerHTML", "hx-push-url": href,
	})
}
