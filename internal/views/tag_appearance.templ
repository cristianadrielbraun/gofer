package views

import (
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

templ TagAppearanceIcon(label models.Label) {
	<span class="inline-flex [&_svg]:size-3.5">
		@FolderAppearanceIcon(models.TagAppearanceFolder(label))
	</span>
}

templ TagAppearanceButton(label models.Label) {
	<button type="button" class="inline-flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-muted/60 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" title={ "Appearance of " + label.Name } aria-label={ "Appearance of " + label.Name } data-folder-action="folder-appearance" data-folder-id={ label.ID } data-folder-account={ label.AccountID } data-folder-name={ label.Name } data-tag-appearance data-tag-appearance-unified?={ label.IsUnified } data-on-click={ onAction("manageFolderAction", actionElement) }>
		@icon.Palette(icon.Props{Class: "size-3.5"})
	</button>
}

templ tagAppearanceSettingRow(label models.Label) {
	<div class="flex items-center gap-2.5 rounded-md px-2 py-1.5 hover:bg-muted/40">
		<span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
			@TagAppearanceIcon(label)
		</span>
		<span class="min-w-0 flex-1 truncate text-sm">{ label.Name }</span>
		@TagAppearanceButton(label)
	</div>
}

// Account tags retain their own appearance; the combined Tags list has its own preferences.
templ TagAppearanceSettings(accounts []models.Account, uiSettings map[string]string) {
	if len(unifiedSidebarLabels(accounts, uiSettings)) > 0 || hasAccountTags(accounts) {
		<div class="settings-card mt-6 space-y-4 rounded-lg border bg-card p-6" data-tag-appearance-settings>
			<div>
				<h3 class="mb-1 text-sm font-semibold uppercase tracking-wider text-muted-foreground">Tags</h3>
				<p class="text-xs text-muted-foreground">Choose icon colors and styles for account tags and unified tags.</p>
			</div>
			<div class="max-h-80 space-y-3 overflow-y-auto">
				{{ unified := unifiedSidebarLabels(accounts, uiSettings) }}
				if len(unified) > 0 {
					<div>
						<p class="px-2 pb-1 text-xs font-semibold text-muted-foreground">Unified tags</p>
						for _, label := range unified {
							@tagAppearanceSettingRow(label)
						}
					</div>
				}
				for _, account := range accounts {
					if !account.IsDeleting && len(account.Labels) > 0 {
						<div>
							<p class="truncate px-2 pb-1 text-xs font-semibold text-muted-foreground">{ tagAppearanceAccountName(account) }</p>
							for _, label := range account.Labels {
								@tagAppearanceSettingRow(label)
							}
						</div>
					}
				}
			</div>
		</div>
	}
}
