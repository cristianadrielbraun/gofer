package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

templ TagAppearanceIcon(label models.Label) {
	<span class="inline-flex [&_svg]:size-3.5">
		@FolderAppearanceIcon(models.TagAppearanceFolder(label))
	</span>
}

templ TagAppearanceButton(label models.Label) {
	<button type="button" class="inline-flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-muted/60 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" title={ i18n.T(ctx, "appearance.of", "name", label.Name) } aria-label={ i18n.T(ctx, "appearance.of", "name", label.Name) } data-folder-action="folder-appearance" data-folder-id={ label.ID } data-folder-account={ label.AccountID } data-folder-name={ label.Name } data-tag-appearance data-tag-appearance-unified?={ label.IsUnified } data-on-click={ onAction("manageFolderAction", actionElement) }>
		@icon.Palette(icon.Props{Class: "size-3.5"})
	</button>
}
