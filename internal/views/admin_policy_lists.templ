package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// AdminPolicyDialogList is the dialog of a list setting, such as the
// allowed mail servers: it adds or removes one entry at a time.
const AdminPolicyDialogList = "list"

// AdminPolicyListDialog changes one of a policy's lists. Every change posts
// to Action with op (add, remove, set or clear) and value, and comes back
// to the dialog.
type AdminPolicyListDialog struct {
	Key       string
	Title     string
	Help      string
	Action    string
	CSRFToken string
	// Named: a named policy's list, which it may leave to the policies
	// after it (Set false) or set, an empty list meaning no limit.
	Named bool
	Set   bool
	// Providers: Gmail and Outlook instead of entries; ServersLimited
	// says whether the policy's servers limit connections.
	Providers      bool
	Gmail          bool
	Outlook        bool
	ServersLimited bool
	Entries        []string
	Empty          string
	Placeholder    string
	AddLabel       string
	// Typed and Error are an entry that was refused, and why.
	Typed string
	Error string
}

// adminPolicyListDialog adds an entry to a list, or takes one off, and on
// a named policy sets the list or leaves it to the policies after it.
// Verification, when the session needs it, opens instead.
templ adminPolicyListDialog(d AdminPolicyListDialog, stepUpRequired bool) {
	@dialog.Dialog(dialog.Props{ID: adminPolicySettingDialogID, Open: !stepUpRequired}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg max-h-[calc(100vh-2rem)] overflow-y-auto"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ d.Title }
				}
				@dialog.Description() {
					{ d.Help }
				}
			}
			<div class="space-y-3" data-admin-policy-list={ d.Key }>
				if d.Named && !d.Set {
					<div class="rounded-md border border-dashed border-border px-3 py-4 text-sm" data-admin-policy-list-unset>
						<p class="font-semibold text-foreground">{ i18n.T(ctx, "admin.policies.not_set") }</p>
						<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.policies.not_set_detail") }</p>
						<form method="post" action={ templ.SafeURL(d.Action) } data-step-up class="mt-3">
							<input type="hidden" name="_csrf" value={ d.CSRFToken }/>
							<input type="hidden" name="op" value="set"/>
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Attributes: templ.Attributes{"data-admin-policy-list-set": ""}}) {
								{ i18n.T(ctx, "admin.policies.list.set") }
							}
						</form>
					</div>
				} else {
					if d.Named {
						<div class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-border bg-muted/35 px-3 py-2.5">
							<p class="min-w-0 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.policies.list.set_detail") }</p>
							<form method="post" action={ templ.SafeURL(d.Action) } data-step-up>
								<input type="hidden" name="_csrf" value={ d.CSRFToken }/>
								<input type="hidden" name="op" value="clear"/>
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-admin-policy-list-clear": ""}}) {
									{ i18n.T(ctx, "admin.policies.list.clear") }
								}
							</form>
						</div>
					}
					if d.Providers {
						<div class="space-y-2">
							@mailListProvider("gmail", "Gmail", d.Gmail, d.ServersLimited, d.Action, d.CSRFToken)
							@mailListProvider("outlook", "Outlook", d.Outlook, d.ServersLimited, d.Action, d.CSRFToken)
						</div>
					} else {
						@mailListEntries(d.Entries, d.Empty, d.Action, d.CSRFToken)
						@mailListAddForm(d.Action, d.CSRFToken, d.Placeholder, d.AddLabel, d.Typed, d.Error)
					}
				}
			</div>
			@dialog.Footer() {
				@dialog.Close(dialog.CloseProps{For: adminPolicySettingDialogID}) {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						{ i18n.T(ctx, "common.close") }
					}
				}
			}
		}
	}
}
