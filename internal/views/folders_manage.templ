package views

import (
	"fmt"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/models"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
)

// FoldersDialog lists an account's folders, from its settings, to make,
// rename and delete them where the sidebar's menu isn't at hand, as on a
// phone, and to put them in order. Gmail has labels instead, which it lists.
// The buttons run the sidebar's folder actions (app.js), which ask first;
// after each change the panel loads again. Each folder's handle drags it
// among the folders next to it (settings.js), each label's among the labels.
templ FoldersDialog(data models.FoldersData) {
	@dialog.Dialog(dialog.Props{ID: "folders-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "mobile-page-dialog sm:max-w-xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					if data.Account.Provider == "gmail" {
						{ i18n.T(ctx, "settings.account.labels") }
					} else {
						{ i18n.T(ctx, "settings.account.folders") }
					}
				}
				@dialog.Description() {
					if data.Account.Provider == "gmail" {
						{ i18n.T(ctx, "settings.folders.gmail_description") }
					} else {
						{ i18n.T(ctx, "settings.folders.description") }
					}
				}
			}
			@FoldersPanel(data)
		}
	}
}

templ FoldersPanel(data models.FoldersData) {
	<div
		id="folders-panel"
		class="min-w-0 space-y-3"
		data-folders-panel={ fmt.Sprintf("/api/accounts/%s/folders/manage?panel=1", data.Account.ID) }
		data-account-id={ data.Account.ID }
	>
		<div class="flex items-center gap-3">
			<div class="account-color-marker size-3 shrink-0" style={ accountColorStyle(data.Account.Color) } data-account-marker={ data.Account.ID }></div>
			<span class="min-w-0 flex-1 truncate text-sm font-medium">{ data.Account.Email }</span>
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Class:   "h-8 shrink-0 gap-1.5 px-3 text-xs",
				Attributes: templ.Attributes{
					"data-folder-action":  newFolderAction(data.Account.Provider),
					"data-folder-account": data.Account.ID,
					"data-on-click":       onAction("manageFolderAction", actionElement),
				},
			}) {
				if data.Account.Provider == "gmail" {
					@icon.Tag(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "settings.folders.new_label") }
				} else {
					@icon.FolderPlus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "settings.folders.new_folder") }
				}
			}
		</div>
		<div class="max-h-[60vh] overflow-y-auto rounded-lg border border-border bg-background/60 p-1" data-folders-list>
			if data.Account.Provider == "gmail" {
				if len(data.Labels) == 0 {
					<p class="px-3 py-6 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "settings.folders.no_labels") }</p>
				}
				<div data-tag-order-list data-account-id={ data.Account.ID }>
				for _, label := range data.Labels {
					<div class="flex items-center gap-2 rounded-md bg-background/60 px-2.5 py-1.5 transition-transform duration-200 ease-out hover:bg-accent" data-tag-order-item data-tag-id={ label.ID }>
						@OrderHandle("data-tag-order-handle", i18n.T(ctx, "settings.folders.reorder_label", "name", label.Name))
						<span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
							@TagAppearanceIcon(label)
						</span>
						<span class="min-w-0 flex-1 truncate text-sm">{ label.Name }</span>
						@TagAppearanceButton(label)
						@folderRowButton("rename-label", data.Account.ID, label.ID, label.Name, i18n.T(ctx, "settings.folders.rename_label", "name", label.Name), false) {
							@icon.Pencil(icon.Props{Class: "size-3.5"})
						}
						@folderRowButton("delete-label", data.Account.ID, label.ID, label.Name, i18n.T(ctx, "settings.folders.delete_label", "name", label.Name), true) {
							@icon.Trash2(icon.Props{Class: "size-3.5"})
						}
					</div>
				}
				</div>
			} else {
				@foldersOrderList(data.Account, data.Folders, 0, false)
			}
		</div>
	</div>
}

func newFolderAction(provider string) string {
	if provider == "gmail" {
		return "new-label"
	}
	return "new-folder"
}

// foldersOrderList holds folders next to each other, each with the folders
// inside it, so each can be put in order among them.
templ foldersOrderList(account models.Account, folders []models.Folder, depth int, inTrash bool) {
	<div data-folder-order-list data-account-id={ account.ID }>
		for _, folder := range folders {
			<div class="transition-transform duration-200 ease-out" data-folder-order-item data-folder-id={ folder.ID }>
				@foldersPanelRow(account, folder, depth, inTrash)
				if len(folder.Children) > 0 {
					@foldersOrderList(account, folder.Children, depth+1, inTrash || folder.Role == "trash")
				}
			</div>
		}
	</div>
}

// foldersPanelRow is one folder. Only folders without a role can be renamed
// or deleted; one inside Trash can be moved back out. Local folders' own can
// move anywhere in the account.
templ foldersPanelRow(account models.Account, folder models.Folder, depth int, inTrash bool) {
	{{ accountID := account.ID }}
	{{ custom := folder.Role == "custom" }}
	<div class="flex items-center gap-2 rounded-md bg-background/60 py-1.5 pr-1 hover:bg-accent" style={ mailMoveIndent(depth) } data-folder-order-row>
		@OrderHandle("data-folder-order-handle", i18n.T(ctx, "settings.folders.reorder_label", "name", i18n.FolderName(ctx, folder.Role, folder.Name)))
		<span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
			@FolderAppearanceIcon(folder)
		</span>
		<span class="min-w-0 flex-1 truncate text-sm">{ i18n.FolderName(ctx, folder.Role, folder.Name) }</span>
		if folder.Role != "starred" {
			@folderRowButton("folder-appearance", accountID, folder.ID, folder.Name, i18n.T(ctx, "settings.folders.appearance_label", "name", i18n.FolderName(ctx, folder.Role, folder.Name)), false) {
				@icon.Palette(icon.Props{Class: "size-3.5"})
			}
			@folderRowButton("new-subfolder", accountID, folder.ID, folder.Name, i18n.T(ctx, "settings.folders.new_in", "name", i18n.FolderName(ctx, folder.Role, folder.Name)), false) {
				@icon.FolderPlus(icon.Props{Class: "size-3.5"})
			}
		}
		if custom && inTrash {
			@folderRowButton("restore-folder", accountID, folder.ID, folder.Name, i18n.T(ctx, "settings.folders.restore_label", "name", folder.Name), false) {
				@icon.FolderOutput(icon.Props{Class: "size-3.5"})
			}
		}
		if custom && account.Provider == "local" {
			@folderRowButton("move-folder", accountID, folder.ID, folder.Name, i18n.T(ctx, "settings.folders.move_label", "name", folder.Name), false) {
				@icon.FolderInput(icon.Props{Class: "size-3.5"})
			}
		}
		if custom {
			@folderRowButton("rename-folder", accountID, folder.ID, folder.Name, i18n.T(ctx, "settings.folders.rename_label", "name", folder.Name), false) {
				@icon.Pencil(icon.Props{Class: "size-3.5"})
			}
			@folderRowButton("delete-folder", accountID, folder.ID, folder.Name, i18n.T(ctx, "settings.folders.delete_label", "name", folder.Name), true) {
				@icon.Trash2(icon.Props{Class: "size-3.5"})
			}
		}
	</div>
}

templ folderRowButton(action, accountID, id, name, label string, destructive bool) {
	<button
		type="button"
		class={ "flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground",
			templ.KV("hover:bg-destructive/10 hover:text-destructive", destructive) }
		title={ label }
		aria-label={ label }
		data-folder-action={ action }
		data-folder-account={ accountID }
		data-folder-id={ id }
		data-folder-name={ name }
		data-on-click={ onAction("manageFolderAction", actionElement) }
	>
		{ children... }
	</button>
}
