package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/label"
	"github.com/cristianadrielbraun/gofer/components/popover"
)

// AppDialogs are the dialogs the app asks questions with instead of the
// browser's own popups. window.goferConfirm and window.goferPrompt
// (actions.js) fill in their text and open them. The mailbox size dialog is
// here too, so every page can open it.
templ AppDialogs() {
	@MailboxSizeDialog()
	@dialog.Dialog(dialog.Props{ID: "app-confirm-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md", Attributes: templ.Attributes{"data-app-confirm": ""}}) {
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{Attributes: templ.Attributes{"data-app-confirm-title": ""}}) {
					Are you sure?
				}
				@dialog.Description(dialog.DescriptionProps{Attributes: templ.Attributes{"data-app-confirm-message": ""}})
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-app-confirm-cancel": ""}}) {
						Cancel
					}
				}
				@button.Button(button.Props{Attributes: templ.Attributes{"data-app-confirm-accept": ""}}) {
					Continue
				}
				@button.Button(button.Props{Variant: button.VariantDestructive, Attributes: templ.Attributes{"data-app-confirm-accept-destructive": "", "style": "display: none"}}) {
					Delete
				}
			}
		}
	}
	@dialog.Dialog(dialog.Props{ID: "app-prompt-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md", Attributes: templ.Attributes{"data-app-prompt": ""}}) {
			<form class="grid gap-4" data-app-prompt-form>
				@dialog.Header() {
					@dialog.Title(dialog.TitleProps{Attributes: templ.Attributes{"data-app-prompt-title": ""}})
					@dialog.Description(dialog.DescriptionProps{Attributes: templ.Attributes{"data-app-prompt-message": "", "hidden": ""}})
				}
				<div class="grid gap-2">
					@label.Label(label.Props{For: "app-prompt-input", Attributes: templ.Attributes{"data-app-prompt-label": ""}})
					@input.Input(input.Props{ID: "app-prompt-input", Attributes: templ.Attributes{"autocomplete": "off", "data-app-prompt-input": ""}})
				</div>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							Cancel
						}
					}
					@button.Button(button.Props{Type: "submit", Attributes: templ.Attributes{"data-app-prompt-accept": ""}}) {
						OK
					}
				}
			</form>
		}
	}
}

// pointPopover is a popover placed at a spot on the screen, such as where
// something was dropped, with an arrow pointing there when arrow is set. Its
// trigger is a one-pixel anchor that the script moves to that spot before
// opening it with tui.popover.open.
templ pointPopover(id string, placement popover.Placement, arrow bool, contentClass string, attributes templ.Attributes) {
	@popover.Root(popover.RootProps{ID: id, Attributes: attributes}) {
		@popover.Trigger() {
			<span class="pointer-events-none fixed left-0 top-0 size-px" aria-hidden="true" data-point-popover-anchor></span>
		}
		@popover.Content(popover.ContentProps{Placement: placement, ShowArrow: arrow, DisableClickAway: true, DisableESC: true, Class: contentClass, Attributes: templ.Attributes{"role": "dialog"}}) {
			{ children... }
		}
	}
}

// ComposeDropChoice asks, in the middle of a compose form, whether images
// dropped on it go in the message or become attachments. Each form has its
// own, inside it, so it works above the compose dialog.
templ ComposeDropChoice(id string) {
	@pointPopover(id, popover.PlacementBottom, false, "w-80 p-3", templ.Attributes{"data-compose-drop-choice": ""}) {
		<div class="space-y-3" aria-label="Choose how to add dropped images">
			<div>
				<p class="text-sm font-medium" data-compose-drop-label></p>
				<p class="mt-0.5 text-xs text-muted-foreground" data-compose-drop-limit></p>
			</div>
			<div class="flex justify-end gap-2">
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-compose-drop-action": "cancel"}}) {
					Cancel
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-compose-drop-action": "attach"}}) {
					Attach
				}
				@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-compose-drop-action": "inline"}}) {
					Insert inline
				}
			</div>
		</div>
	}
}

// CalendarMoveConfirm asks, next to where an event was dropped or resized,
// before it changes.
templ CalendarMoveConfirm() {
	@pointPopover("calendar-move-confirm", popover.PlacementBottomStart, true, "w-72 p-3", templ.Attributes{"data-calendar-move-confirm": ""}) {
		<p class="font-semibold" data-calendar-move-title></p>
		<p class="mt-1 text-xs text-muted-foreground" data-calendar-move-detail></p>
		<div class="mt-3 flex justify-end gap-2">
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-calendar-move-cancel": ""}}) {
				Cancel
			}
			@button.Button(button.Props{Size: button.SizeSm, Attributes: templ.Attributes{"data-calendar-move-confirm-button": ""}}) {
				Move
			}
		</div>
	}
}
