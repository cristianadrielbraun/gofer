package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"context"
	"fmt"
	"slices"
	"strconv"
	"time"

	"github.com/cristianadrielbraun/gofer/internal/mailrules"
	"github.com/cristianadrielbraun/gofer/internal/models"

	"github.com/cristianadrielbraun/gofer/components/badge"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/progress"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	"github.com/cristianadrielbraun/gofer/components/skeleton"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
	"github.com/cristianadrielbraun/gofer/components/tooltip"
)

// SettingsRulesTab loads the rules once the tab shows.
// The card's heading is drawn with the page; only the list loads after it,
// in the shape of rules, faded in only if it takes a while.
templ SettingsRulesTab() {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
					<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "rules.title") }</h3>
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "rules.intro") }</p>
				</div>
				<div class="flex shrink-0 items-center gap-2 self-start">
					<button
						type="button"
						class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-sm hover:bg-accent"
						hx-get={ mailRulePath("/activity") }
						hx-target="#mail-rule-dialog-container"
						hx-swap="innerHTML"
						data-mail-rule-activity
					>
						@icon.History(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "rules.activity") }
					</button>
					<button
						type="button"
						class="btn-skeuo inline-flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold"
						hx-get={ mailRulePath("/dialog?add=1") }
						hx-target="#mail-rule-dialog-container"
						hx-swap="innerHTML"
						data-mail-rule-add
					>
						@icon.Plus(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "rules.add") }
					</button>
				</div>
			</div>
			<div id="mail-rules-panel" hx-get="/api/settings/rules/panel" hx-trigger="load" hx-swap="outerHTML" aria-busy="true" data-mail-rules-loading>
				@mailRulesLoading()
			</div>
		</div>
		<div id="mail-rule-dialog-container"></div>
	</div>
}

// mailRulesLoading has the shape of one rule in the list, the least it
// shows, so the card grows to the list rather than shrinking to it.
templ mailRulesLoading() {
	<ul class="space-y-2">
		for range 1 {
			<li class="flex items-center gap-3 rounded-lg border border-border bg-background/60 p-3">
				@skeleton.Skeleton(skeleton.Props{Class: "size-4 shrink-0"})
				<div class="min-w-0 flex-1 space-y-1.5">
					<div class="flex h-5 items-center">
						@skeleton.Skeleton(skeleton.Props{Class: "h-3.5 w-40"})
					</div>
					<div class="flex h-4 items-center">
						@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-64 max-w-full"})
					</div>
				</div>
				@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-9 shrink-0 rounded-full"})
			</li>
		}
	</ul>
}

func mailRulePath(rest string) string {
	return "/api/settings/rules" + rest
}

const mailRuleIconButton = "inline-flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground disabled:pointer-events-none disabled:opacity-40"

// MailRulesPanel shows the rules. Every change to the list swaps the whole
// panel.
templ MailRulesPanel(data models.MailRulesData) {
	<div id="mail-rules-panel" class="min-w-0 space-y-4" data-mail-rules-panel>
		@mailRulesList(data)
	</div>
}

// MailRuleDialog adds or edits a rule, or runs one on mail already here.
// Changes made in it swap MailRuleDialogPanel; saving or running closes it
// and shows the list again. It is laid out like the data dialogs: the
// header stays at the top, the buttons in the footer at the bottom, and
// what is between them scrolls.
templ MailRuleDialog(data models.MailRulesData) {
	@dialog.Dialog(dialog.Props{ID: "mail-rule-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: mailRuleDialogWidth(data) + " max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:flex [&>[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:min-h-0 [&>[data-tui-dialog-panel]]:flex-col [&>[data-tui-dialog-panel]]:gap-0 [&>[data-tui-dialog-panel]]:p-0"}) {
			@dialog.Header(dialog.HeaderProps{Class: "shrink-0 px-6 pt-6 pb-4"}) {
				@dialog.Title() {
					if data.Run != nil {
						{ i18n.T(ctx, "rules.run.title", "name", data.Run.Rule.Name) }
					} else if data.Editing != nil && data.Editing.ID != "" {
						{ i18n.T(ctx, "rules.edit_title") }
					} else {
						{ i18n.T(ctx, "rules.new_title") }
					}
				}
				@dialog.Description() {
					if data.Run != nil {
						<span data-mail-rule-run-summary>{ mailRuleRunSummary(ctx, data.Run.Rule, data.Accounts) }</span>
					} else {
						{ i18n.T(ctx, "rules.description") }
					}
				}
			}
			@MailRuleDialogPanel(data)
		}
	}
}

// MailRuleDialogPanel is the inside of the rule dialog: the form, or the
// preview of a run.
templ MailRuleDialogPanel(data models.MailRulesData) {
	<div id="mail-rule-dialog-panel" class="flex min-h-0 min-w-0 flex-1 flex-col" data-mail-rule-dialog-panel>
		if data.Run != nil {
			@mailRuleRunView(data)
		} else if data.Editing != nil {
			@mailRuleForm(data, *data.Editing)
		}
	</div>
}

templ mailRulesList(data models.MailRulesData) {
	<div class="space-y-5">
		if data.Notice != "" {
			<p class="flex items-start gap-1.5 rounded-md border border-border/60 bg-background/60 px-3 py-2 text-xs text-foreground" role="status" data-mail-rule-notice>
				@icon.CircleCheck(icon.Props{Class: "mt-0.5 size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400"})
				{ data.Notice }
			</p>
		}
		if data.Error != "" {
			<p class="text-xs text-destructive" role="alert" data-mail-rule-error>{ data.Error }</p>
		}
		if len(data.Rules) == 0 {
			<div class="rounded-lg border border-dashed border-border p-6 text-center">
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "rules.empty") }</p>
			</div>
		} else {
			<ul class="space-y-2" data-mail-rule-order-list>
				for _, rule := range data.Rules {
					@mailRuleRow(data, rule)
				}
			</ul>
		}
	</div>
}

templ mailRuleRow(data models.MailRulesData, rule models.MailRule) {
	<li data-mail-rule-row data-mail-rule-id={ rule.ID }>
		<div class="mail-rule-card flex items-center gap-3 rounded-lg border border-border bg-background/60 p-3">
			<button
				type="button"
				data-mail-rule-order-handle
				class="-ml-1 flex h-8 shrink-0 cursor-grab touch-none items-center rounded px-0.5 text-muted-foreground/70 transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:cursor-grabbing"
				aria-label={ i18n.T(ctx, "rules.reorder", "name", rule.Name) }
				title={ i18n.T(ctx, "rules.drag") }
			>
				@icon.GripVertical(icon.Props{Class: "size-4"})
			</button>
			<div class="min-w-0 flex-1">
				<div class="flex h-5 min-w-0 items-center gap-2">
					<p class="min-w-0 truncate text-sm font-medium">{ rule.Name }</p>
					// Shown while the rule's switch is off; see input.css.
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "shrink-0 text-[10px]", Attributes: templ.Attributes{"data-mail-rule-inactive": ""}}) {
						{ i18n.T(ctx, "rules.inactive") }
					}
					if rule.StopProcessing {
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "shrink-0 text-[10px]"}) {
							{ i18n.T(ctx, "rules.stops_later") }
						}
					}
				</div>
				<p class="mt-0.5 flex min-w-0 items-center gap-1.5 text-xs text-muted-foreground" data-mail-rule-summary>
					if color := mailRuleAccountColor(rule, data.Accounts); color != "" {
						<span class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(color) }></span>
					}
					<span class="truncate">{ mailRuleListSummary(ctx, rule, data.Accounts) }</span>
				</p>
			</div>
			<div class="flex shrink-0 items-center gap-1">
				@switchcomp.Switch(switchcomp.Props{
					Name:    "enabled",
					Value:   "true",
					Checked: rule.Enabled,
					Attributes: templ.Attributes{
						"aria-label":             i18n.T(ctx, "rules.is_active", "name", rule.Name),
						"hx-post":                mailRulePath("/" + rule.ID + "/enabled"),
						"hx-trigger":             "change",
						"hx-swap":                "none",
						"data-mail-rule-enabled": rule.ID,
					},
				})
				<button
					type="button"
					class={ mailRuleIconButton }
					aria-label={ i18n.T(ctx, "rules.run_named", "name", rule.Name) }
					title={ i18n.T(ctx, "rules.run_now") }
					hx-get={ mailRulePath("/" + rule.ID + "/run") }
					hx-target="#mail-rule-dialog-container"
					hx-swap="innerHTML"
					data-mail-rule-run-open
				>
					@icon.Play(icon.Props{Class: "size-3.5"})
				</button>
				<button
					type="button"
					class={ mailRuleIconButton }
					aria-label={ i18n.T(ctx, "rules.edit_named", "name", rule.Name) }
					title={ i18n.T(ctx, "calendar.edit") }
					hx-get={ mailRulePath("/dialog?edit=" + rule.ID) }
					hx-target="#mail-rule-dialog-container"
					hx-swap="innerHTML"
					data-mail-rule-edit
				>
					@icon.Pencil(icon.Props{Class: "size-3.5"})
				</button>
				<button
					type="button"
					class="inline-flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-destructive/10 hover:text-destructive"
					aria-label={ i18n.T(ctx, "rules.delete_named", "name", rule.Name) }
					title={ i18n.T(ctx, "calendar.delete") }
					data-mail-rule-delete={ mailRulePath("/" + rule.ID) }
					data-mail-rule-name={ rule.Name }
				>
					@icon.Trash2(icon.Props{Class: "size-3.5"})
				</button>
			</div>
		</div>
	</li>
}

const mailRuleFieldLabelClass = "mb-1.5 block text-xs font-medium text-muted-foreground"

// mailRuleForm adds or edits a rule. Changing a choice that others depend
// on, or adding or removing a row, sends the form to be shown again; only
// Save stores it.
templ mailRuleForm(data models.MailRulesData, rule models.MailRule) {
	<form
		class={ dataDialogFormClass }
		hx-post={ mailRulePath("") }
		hx-target="#mail-rule-dialog-panel"
		hx-swap="outerHTML"
		data-mail-rule-form
	>
		@dataDialogScroll("pb-5") {
			<div
				class="space-y-5"
				hx-post={ mailRulePath("/form") }
				hx-trigger="mail-rule-rerender"
				hx-target="#mail-rule-dialog-panel"
				hx-swap="outerHTML"
				data-mail-rule-form-body
			>
				<input type="hidden" name="id" value={ rule.ID }/>
				<div class="grid gap-3 sm:grid-cols-2">
					<div>
						<label class={ mailRuleFieldLabelClass } for="mail-rule-name">{ i18n.T(ctx, "contacts.field.name") }</label>
						@input.Input(input.Props{ID: "mail-rule-name", Name: "name", Type: input.TypeText, Value: rule.Name, Placeholder: i18n.T(ctx, "rules.name_placeholder"), Required: true, Attributes: templ.Attributes{"maxlength": "120", "autocomplete": "off"}})
					</div>
					<div>
						<label class={ mailRuleFieldLabelClass }>{ i18n.T(ctx, "rules.for") }</label>
						@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "account_ids", Class: "bg-background", DisableClear: true, Multiple: true, ShowPills: true, SelectedCountText: i18n.T(ctx, "rules.accounts_selected"), Attributes: templ.Attributes{"data-mail-rule-accounts": "", "value": mailRuleAccountsValue(rule)}}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "rules.choose_accounts")})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: len(data.Accounts) < 8, Class: "mobile-sheet"}) {
								@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: !rule.AccountsChosen}) {
									{ i18n.T(ctx, "rules.accounts.all") }
								}
								for _, account := range data.Accounts {
									if mailRuleWatchable(account) {
										@selectbox.Item(selectbox.ItemProps{Value: account.ID, Selected: rule.AccountsChosen && slices.Contains(rule.AccountIDs, account.ID)}) {
											{ mailRuleAccountTitle(account) }
										}
									}
								}
							}
						}
					</div>
				</div>
				<fieldset class="space-y-3" data-mail-rule-conditions>
					<legend class="space-y-1">
						<span class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "rules.when") }</span>
						<span class="block text-xs text-muted-foreground">{ i18n.T(ctx, "rules.groups_note") }</span>
					</legend>
					<div>
						for g, group := range mailRuleConditionGroups(rule) {
							if g > 0 {
								<div class="flex justify-center py-1" aria-hidden="true" data-mail-rule-or>
									<span class="rounded-full border border-border bg-card px-2 text-[10px] font-semibold uppercase leading-4 tracking-wider text-muted-foreground">{ i18n.T(ctx, "rules.or") }</span>
								</div>
							}
							<div class="space-y-1 rounded-lg border border-border bg-background/40 p-1.5" data-mail-rule-condition-group={ strconv.Itoa(g) }>
								for k, item := range group {
									@mailRuleConditionRow(data, rule, item.index, item.condition, k > 0)
								}
								if mailRuleCanAddCondition(&rule) {
									<div class="sm:pl-9">
										@mailRuleAddConditionButton(g, i18n.T(ctx, "rules.and_condition"))
									</div>
								}
							</div>
						}
					</div>
					if mailRuleCanAddCondition(&rule) {
						@mailRuleAddConditionButton(-1, i18n.T(ctx, "rules.or_condition"))
					}
				</fieldset>
				<fieldset class="space-y-3" data-mail-rule-actions>
					<legend class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "rules.do_this") }</legend>
					<div class="space-y-2">
						for i, action := range rule.Actions {
							@mailRuleActionRow(data, rule, i, action)
						}
					</div>
					if mailRuleCanAddAction(&rule) {
						@mailRuleRowButton("add_action", 0, i18n.T(ctx, "rules.add_action"))
					}
				</fieldset>
				<div class="space-y-2 border-t border-border/60 pt-4">
					<label class="flex items-start gap-2 text-sm">
						@checkbox.Checkbox(checkbox.Props{Name: "stop_processing", Value: "true", Checked: rule.StopProcessing, Class: "mt-0.5"})
						<span>
							{ i18n.T(ctx, "rules.stop_here") }
							<span class="block text-xs text-muted-foreground">{ i18n.T(ctx, "rules.stop_here_note") }</span>
						</span>
					</label>
					<label class="flex items-start gap-2 text-sm">
						@checkbox.Checkbox(checkbox.Props{Name: "enabled", Value: "true", Checked: rule.Enabled, Class: "mt-0.5"})
						<span>
							{ i18n.T(ctx, "rules.active") }
							<span class="block text-xs text-muted-foreground">{ i18n.T(ctx, "rules.active_note") }</span>
						</span>
					</label>
				</div>
			</div>
		}
		@dataDialogFooter() {
			if data.Error != "" {
				<p class="text-xs text-destructive sm:mr-auto sm:self-center" role="alert" data-mail-rule-error>{ data.Error }</p>
			} else {
				<p class="text-xs text-muted-foreground sm:mr-auto sm:self-center">{ i18n.T(ctx, "rules.save_note") }</p>
			}
			@mailRuleFooterButtons() {
				@dialog.Close() {
					<button type="button" class={ mailRuleCancelButton }>{ i18n.T(ctx, "common.cancel") }</button>
				}
				<button type="submit" class={ mailRulePrimaryButton } data-mail-rule-save>
					@icon.Save(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "common.save") }
				</button>
			}
		}
	</form>
}

const (
	mailRuleCancelButton  = "inline-flex items-center rounded-lg px-3 py-1.5 text-sm text-muted-foreground hover:bg-accent hover:text-foreground"
	mailRulePrimaryButton = "btn-skeuo inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold"
)

// mailRuleFooterButtons keeps a footer's buttons together at its right.
templ mailRuleFooterButtons() {
	<div class="flex shrink-0 items-center justify-end gap-2">
		{ children... }
	</div>
}

// mailRuleAddConditionButton adds a condition to a group, or with group -1,
// in a new group after the others, keeping the rest of the form as it is.
templ mailRuleAddConditionButton(group int, label string) {
	<button
		type="button"
		class="inline-flex items-center gap-1 rounded-md px-1.5 py-0.5 text-xs text-muted-foreground hover:bg-accent hover:text-foreground"
		hx-post={ mailRulePath("/form") }
		hx-vals={ fmt.Sprintf(`{"op":"add_condition","group":%q}`, strconv.Itoa(group)) }
		hx-target="#mail-rule-dialog-panel"
		hx-swap="outerHTML"
		data-mail-rule-add-condition={ strconv.Itoa(group) }
	>
		@icon.Plus(icon.Props{Class: "size-3.5"})
		{ label }
	</button>
}

// mailRuleRowButton adds or removes a condition or an action, keeping the
// rest of the form as it is.
templ mailRuleRowButton(op string, index int, label string) {
	if op == "add_condition" || op == "add_action" {
		<button
			type="button"
			class="inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted-foreground hover:bg-accent hover:text-foreground"
			hx-post={ mailRulePath("/form") }
			hx-vals={ fmt.Sprintf(`{"op":%q}`, op) }
			hx-target="#mail-rule-dialog-panel"
			hx-swap="outerHTML"
			data-mail-rule-row-op={ op }
		>
			@icon.Plus(icon.Props{Class: "size-3.5"})
			{ label }
		</button>
	} else {
		<button
			type="button"
			class={ mailRuleIconButton }
			aria-label={ label }
			title={ label }
			hx-post={ mailRulePath("/form") }
			hx-vals={ fmt.Sprintf(`{"op":%q,"index":%q}`, op, strconv.Itoa(index)) }
			hx-target="#mail-rule-dialog-panel"
			hx-swap="outerHTML swap:220ms"
			data-mail-rule-row-op={ op }
		>
			@icon.X(icon.Props{Class: "size-3.5"})
		</button>
	}
}

// mailRuleConditionRow is one condition on one line, after "and" when
// another of its group comes before it.
templ mailRuleConditionRow(data models.MailRulesData, rule models.MailRule, index int, condition models.MailRuleCondition, and bool) {
	<div class={ "flex flex-col gap-1.5 sm:flex-row sm:items-center", templ.KV("border-t border-border/50 pt-1.5 sm:border-0 sm:pt-0", and) } data-mail-rule-condition>
		<input type="hidden" name="cond_group" value={ strconv.Itoa(condition.Group) }/>
		<span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground sm:w-7 sm:shrink-0 sm:text-right" aria-hidden="true">
			if and {
				{ i18n.T(ctx, "rules.and") }
			} else {
				<span class="hidden sm:inline">{ i18n.T(ctx, "rules.if") }</span>
			}
		</span>
		<div class="w-full sm:w-32 sm:shrink-0">
			@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
				@selectbox.Trigger(selectbox.TriggerProps{Name: "cond_field", Class: mailRuleCompactControl, DisableClear: true, Attributes: templ.Attributes{"data-mail-rule-rerender": "", "aria-label": i18n.T(ctx, "rules.what_to_test")}}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "rules.field.from")})
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
					for _, field := range mailRuleFields {
						@selectbox.Item(selectbox.ItemProps{Value: field, Selected: field == condition.Field}) {
							{ mailRuleFieldLabel(ctx, field) }
						}
					}
				}
			}
		</div>
		<div class="w-full sm:w-36 sm:shrink-0">
			@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
				@selectbox.Trigger(selectbox.TriggerProps{Name: "cond_op", Class: mailRuleCompactControl, DisableClear: true, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "rules.how_to_compare")}}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "rules.op.contains")})
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
					if condition.Field == models.MailRuleFieldFolder {
						@selectbox.Item(selectbox.ItemProps{Value: models.MailRuleOpIs, Selected: condition.Operator == models.MailRuleOpIs}) {
							{ i18n.T(ctx, "rules.op.is") }
						}
						@selectbox.Item(selectbox.ItemProps{Value: models.MailRuleOpIsNot, Selected: condition.Operator == models.MailRuleOpIsNot}) {
							{ i18n.T(ctx, "rules.op.is_not") }
						}
					} else {
						for _, operator := range MailRuleTextOperators {
							@selectbox.Item(selectbox.ItemProps{Value: operator, Selected: operator == condition.Operator}) {
								{ mailRuleOperatorLabel(ctx, operator) }
							}
						}
					}
				}
			}
		</div>
		<div class="min-w-0 flex-1">
			if condition.Field == models.MailRuleFieldFolder {
				<input type="hidden" name="cond_value" value=""/>
				@mailRuleFolderSelect("cond_folder", condition.Folder, data.Accounts, true, false)
			} else {
				<input type="hidden" name="cond_folder" value=""/>
				@input.Input(input.Props{Name: "cond_value", Type: input.TypeText, Class: mailRuleCompactControl, Value: condition.Value, Placeholder: mailRuleValuePlaceholder(ctx, condition), Attributes: templ.Attributes{"maxlength": "500", "autocomplete": "off", "aria-label": i18n.T(ctx, "rules.compare_with")}})
			}
		</div>
		if len(rule.Conditions) > 1 {
			@mailRuleRowButton("remove_condition", index, i18n.T(ctx, "rules.remove_condition"))
		}
	</div>
}

func mailRuleValuePlaceholder(ctx context.Context, condition models.MailRuleCondition) string {
	switch condition.Field {
	case models.MailRuleFieldFrom, models.MailRuleFieldTo, models.MailRuleFieldCC, models.MailRuleFieldRecipients:
		if condition.Operator == models.MailRuleOpMatches {
			return `@(news|offers)\.example$`
		}
		return "news@example.com"
	case models.MailRuleFieldListID:
		return "list.example.com"
	}
	if condition.Operator == models.MailRuleOpMatches {
		return `^\[weekly\]`
	}
	return i18n.T(ctx, "rules.value_placeholder")
}

// mailRuleFolderSelect picks a folder: first the ones every account has,
// which stand for that folder of the account the message is in, then each
// account's own folders, as its Folders dialog shows them. A folder of
// another account than the message's moves it there. withOwnMail offers
// Sent and Drafts too; forMove lists Local folders and offers new folders.
templ mailRuleFolderSelect(name string, target *models.MailRuleFolderTarget, accounts []models.MailRuleAccount, withOwnMail bool, forMove bool) {
	@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
		@selectbox.Trigger(selectbox.TriggerProps{Name: name, Class: mailRuleCompactControl, DisableClear: true, Attributes: mailRuleFolderTriggerAttributes(ctx, forMove)}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "transfer.choose_folder")})
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet max-h-80 overflow-y-auto"}) {
			@selectbox.Group() {
				@selectbox.Label(selectbox.LabelProps{Class: "text-xs text-muted-foreground"}) {
					{ i18n.T(ctx, "rules.in_message_account") }
				}
				for _, role := range []string{"inbox", "archive", "trash", "junk", "sent", "drafts"} {
					if withOwnMail || (role != "sent" && role != "drafts") {
						@selectbox.Item(selectbox.ItemProps{Value: "role:" + role, Selected: target != nil && target.Role == role}) {
							{ mailRuleRoleLabel(ctx, role) }
						}
					}
				}
			}
			for _, account := range accounts {
				if (forMove && (!account.Hidden || mailRuleTargetIn(target, account))) || (!forMove && mailRuleWatchable(account)) {
					{{ makes := forMove && account.Provider != "gmail" }}
					@selectbox.Group() {
						@selectbox.Label(selectbox.LabelProps{Class: "mt-1 flex items-center gap-2 border-t border-border/60 pt-2 text-xs text-muted-foreground"}) {
							<span class="account-color-marker size-2 shrink-0" style={ accountColorStyle(account.Color) }></span>
							<span class="truncate">{ mailRuleAccountTitle(account) }</span>
						}
						if makes {
							<button
								type="button"
								class="mb-1 flex w-full items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm text-muted-foreground outline-none hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground"
								data-mail-rule-new-folder={ account.ID }
							>
								@icon.FolderPlus(icon.Props{Class: "size-4 shrink-0"})
								<span class="flex-1 truncate">{ i18n.T(ctx, "mail.folder_menu.new_folder") }</span>
							</button>
						}
						for _, folder := range account.Tree {
							@mailRuleFolderTreeItem(folder, 0, target, account.ID, withOwnMail, makes)
						}
					}
				}
			}
		}
	}
}

// mailRuleFolderTreeItem is one folder of the folder picker, then the
// folders inside it. Starred is a view, not a folder, so it isn't offered.
// The new subfolder button sits beside the row, at its right, rather than in
// it: the picker shows a chosen row's text as the field's value.
templ mailRuleFolderTreeItem(folder models.Folder, depth int, target *models.MailRuleFolderTarget, accountID string, withOwnMail bool, makes bool) {
	if folder.Role != "starred" {
		{{ ownMail := folder.Role == "sent" || folder.Role == "drafts" }}
		{{ subfolder := makes && !(ownMail && !withOwnMail) }}
		<div class="relative">
			@selectbox.Item(selectbox.ItemProps{
				Value:      "id:" + folder.ID,
				Selected:   target != nil && target.Role == "" && target.FolderID == folder.ID,
				Disabled:   ownMail && !withOwnMail,
				Class:      mailRuleTreeItemPadding(subfolder),
				Attributes: templ.Attributes{"style": mailMoveIndent(depth)},
			}) {
				<span class="inline-flex min-w-0 items-center gap-2 align-middle">
					<span class="flex size-4 shrink-0 items-center justify-center text-muted-foreground">
						@FolderAppearanceIcon(folder)
					</span>
					<span class="min-w-0 truncate">{ folder.Name }</span>
				</span>
			}
			if subfolder {
				<div class="absolute right-7 top-1/2 -translate-y-1/2">
					@tooltip.Tooltip() {
						@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
							<button
								type="button"
								class="flex size-6 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground"
								aria-label={ i18n.T(ctx, "rules.new_subfolder", "folder", folder.Name) }
								data-mail-rule-new-folder={ accountID }
								data-mail-rule-new-folder-parent={ folder.ID }
								data-mail-rule-new-folder-parent-name={ folder.Name }
							>
								@icon.FolderPlus(icon.Props{Class: "size-3.5"})
							</button>
						}
						@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionLeft, ShowArrow: true, Class: "px-3 py-1.5 text-xs"}) {
							{ i18n.T(ctx, "rules.new_subfolder", "folder", folder.Name) }
						}
					}
				</div>
			}
		</div>
	}
	for _, child := range folder.Children {
		@mailRuleFolderTreeItem(child, depth+1, target, accountID, withOwnMail, makes)
	}
}

templ mailRuleActionRow(data models.MailRulesData, rule models.MailRule, index int, action models.MailRuleAction) {
	<div class="flex flex-col gap-2 rounded-md border border-border/60 bg-background/40 p-2 sm:flex-row sm:items-center" data-mail-rule-action>
		<div class="w-full sm:w-44 sm:shrink-0">
			@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
				@selectbox.Trigger(selectbox.TriggerProps{Name: "act_kind", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-mail-rule-rerender": "", "aria-label": i18n.T(ctx, "rules.action_label")}}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "rules.action.archive")})
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
					for _, kind := range mailRuleActionKinds {
						if MailRuleActionOffered(rule.Actions, index, kind) {
							@selectbox.Item(selectbox.ItemProps{Value: kind, Selected: kind == action.Kind}) {
								{ mailRuleActionLabel(ctx, kind) }
							}
						}
					}
				}
			}
		</div>
		<div class="min-w-0 flex-1">
			switch action.Kind {
				case models.MailRuleActionMove:
					<input type="hidden" name="act_label" value=""/>
					@mailRuleFolderSelect("act_folder", action.Folder, data.Accounts, false, true)
					if action.Folder != nil && action.Folder.FolderID != "" {
						<div class="mt-2">
							@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "act_for_good", Class: mailRuleCompactControl, DisableClear: true, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "rules.for_good_label"), "value": mailRuleForGoodValue(action.ForGood)}}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "rules.for_good_placeholder")})
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
									@selectbox.Item(selectbox.ItemProps{Value: "0", Selected: !action.ForGood}) {
										{ i18n.T(ctx, "rules.for_good.trash") }
									}
									@selectbox.Item(selectbox.ItemProps{Value: "1", Selected: action.ForGood}) {
										{ i18n.T(ctx, "rules.for_good.delete") }
									}
								}
							}
						</div>
					} else {
						<input type="hidden" name="act_for_good" value=""/>
					}
				case models.MailRuleActionLabel:
					<input type="hidden" name="act_folder" value=""/>
					<input type="hidden" name="act_for_good" value=""/>
					@input.Input(input.Props{Name: "act_label", Type: input.TypeText, Value: action.Label, Placeholder: i18n.T(ctx, "rules.label_placeholder"), Attributes: templ.Attributes{"maxlength": "500", "autocomplete": "off", "aria-label": i18n.T(ctx, "rules.label")}})
				default:
					<input type="hidden" name="act_folder" value=""/>
					<input type="hidden" name="act_label" value=""/>
					<input type="hidden" name="act_for_good" value=""/>
					<p class="px-1 text-xs text-muted-foreground">{ mailRuleActionHint(ctx, action.Kind) }</p>
			}
		</div>
		if len(rule.Actions) > 1 {
			@mailRuleRowButton("remove_action", index, i18n.T(ctx, "rules.remove_action"))
		}
	</div>
}

func mailRuleActionHint(ctx context.Context, kind string) string {
	switch kind {
	case models.MailRuleActionArchive:
		return i18n.T(ctx, "rules.hint.archive")
	case models.MailRuleActionTrash:
		return i18n.T(ctx, "rules.hint.trash")
	case models.MailRuleActionSpam:
		return i18n.T(ctx, "rules.hint.spam")
	case models.MailRuleActionMarkRead:
		return i18n.T(ctx, "rules.hint.mark_read")
	case models.MailRuleActionStar:
		return i18n.T(ctx, "rules.hint.star")
	}
	return ""
}

// mailRuleRunView previews running a rule on the mail already in a folder,
// and runs it once that is confirmed.
// mailRuleRunView runs a rule on the mail in a folder: it counts what the
// rule would change, then, once confirmed, changes it. Both go on in the
// background; settings.js follows them and draws this again when the state
// changes.
templ mailRuleRunView(data models.MailRulesData) {
	{{ run := data.Run }}
	{{ roles, own := mailRuleRunScopes(ctx, run.Rule, data.Accounts) }}
	<div class={ dataDialogFormClass } data-mail-rule-run={ run.JobID } data-mail-rule-run-state={ run.State } data-mail-rule-run-seq={ strconv.Itoa(run.Seq) }>
		@dataDialogScroll("space-y-5 pb-5") {
			<form
				class="flex flex-col gap-2 sm:flex-row sm:items-center"
				hx-post={ mailRulePath("/" + run.Rule.ID + "/run/scope") }
				hx-trigger="change"
				hx-target="#mail-rule-dialog-panel"
				hx-swap="outerHTML"
				data-mail-rule-run-scope
			>
				<label class="text-sm text-muted-foreground sm:shrink-0">{ i18n.T(ctx, "rules.run.on_mail_in") }</label>
				<div class="w-full sm:flex-1">
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "scope", Class: "bg-background", DisableClear: true, Disabled: !mailRuleRunScopeOpen(run), Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "rules.run.scope_label")}}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "folder.inbox")})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Group() {
								for _, role := range roles {
									@selectbox.Item(selectbox.ItemProps{Value: role.value, Selected: role.value == run.Scope}) {
										{ role.label }
									}
								}
							}
							for _, account := range own {
								@selectbox.Group() {
									@selectbox.Label(selectbox.LabelProps{Class: "text-xs text-muted-foreground"}) {
										{ account.Email }
									}
									for _, folder := range account.Folders {
										@selectbox.Item(selectbox.ItemProps{Value: "id:" + folder.ID, Selected: "id:"+folder.ID == run.Scope}) {
											{ mailRuleFolderChoiceName(folder) }
										}
									}
								}
							}
						}
					}
				</div>
			</form>
			<div class="space-y-2" aria-live="polite" data-mail-rule-run-status>
				switch run.State {
					case models.MailRuleRunCounting:
						@mailRuleRunProgress(run.Scanned, run.Total)
						<p class="text-sm text-muted-foreground">
							{ i18n.T(ctx, "rules.run.checking") } <span data-mail-rule-run-field="scanned">{ mailRuleCount(ctx, run.Scanned) }</span> { i18n.T(ctx, "rules.run.of") } <span data-mail-rule-run-field="total">{ mailRuleCount(ctx, run.Total) }</span>
						</p>
						<p class="text-xs text-muted-foreground"><span data-mail-rule-run-field="matches">{ mailRuleCount(ctx, run.Matches) }</span> { i18n.T(ctx, "rules.run.so_far") }</p>
					case models.MailRuleRunCounted:
						if run.Matches == 0 {
							<p class="text-sm text-muted-foreground" data-mail-rule-run-total="0">{ i18n.T(ctx, "rules.run.nothing", "scope", run.ScopeName, "messages", MailRuleMessages(ctx, run.Scanned)) }</p>
						} else {
							<p class="text-sm" data-mail-rule-run-total={ strconv.Itoa(run.Matches) }>
								<span class="text-2xl font-semibold tabular-nums">{ mailRuleCount(ctx, run.Matches) }</span>
								<span class="block text-muted-foreground">{ i18n.N(ctx, "rules.run.would_change", run.Matches, "scope", run.ScopeName, "checked", mailRuleCount(ctx, run.Scanned)) }</span>
							</p>
						}
					case models.MailRuleRunRunning:
						@mailRuleRunProgress(run.Processed, run.Matches)
						<p class="text-sm text-muted-foreground">
							{ i18n.T(ctx, "rules.run.changing") } <span data-mail-rule-run-field="processed">{ mailRuleCount(ctx, run.Processed) }</span> { i18n.T(ctx, "rules.run.of") } <span data-mail-rule-run-field="matches">{ mailRuleCount(ctx, run.Matches) }</span>
						</p>
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "rules.run.can_close") }</p>
					case models.MailRuleRunDone:
						<p class="flex items-start gap-1.5 text-sm" data-mail-rule-run-done>
							@icon.CircleCheck(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-emerald-600 dark:text-emerald-400"})
							{ MailRuleRunDoneNotice(ctx, *run) }
						</p>
					case models.MailRuleRunStopped:
						<p class="text-sm text-muted-foreground" data-mail-rule-run-stopped>
							if run.Processed > 0 || run.Changed > 0 {
								{ i18n.T(ctx, "rules.run.stopped_after", "messages", MailRuleMessages(ctx, run.Processed), "total", mailRuleCount(ctx, run.Matches)) }
							} else {
								{ i18n.T(ctx, "rules.run.stopped") }
							}
						</p>
					default:
						<p class="text-sm text-destructive" role="alert" data-mail-rule-error>{ i18n.Stored(ctx, "jobs.", run.Error) }</p>
				}
			</div>
		}
		@dataDialogFooter() {
			@mailRuleFooterButtons() {
				switch  {
					case run.State == models.MailRuleRunCounted && run.Matches > 0:
						@dialog.Close() {
							<button type="button" class={ mailRuleCancelButton }>{ i18n.T(ctx, "common.cancel") }</button>
						}
						<button
							type="button"
							class={ mailRulePrimaryButton }
							hx-post={ "/api/settings/rule-runs/" + run.JobID + "/start" }
							hx-target="#mail-rule-dialog-panel"
							hx-swap="outerHTML"
							hx-disabled-elt="this"
							data-mail-rule-run-start
						>
							@icon.Play(icon.Props{Class: "size-3.5"})
							{ i18n.T(ctx, "rules.run.start", "messages", MailRuleMessages(ctx, run.Matches)) }
						</button>
					case run.State == models.MailRuleRunCounting || run.State == models.MailRuleRunRunning:
						<button
							type="button"
							class={ mailRuleCancelButton }
							hx-post={ "/api/settings/rule-runs/" + run.JobID + "/stop" }
							hx-target="#mail-rule-dialog-panel"
							hx-swap="outerHTML"
							hx-disabled-elt="this"
							data-mail-rule-run-stop
						>{ i18n.T(ctx, "rules.run.stop") }</button>
						@dialog.Close() {
							<button type="button" class={ mailRulePrimaryButton }>{ i18n.T(ctx, "common.close") }</button>
						}
					default:
						@dialog.Close() {
							<button type="button" class={ mailRulePrimaryButton }>{ i18n.T(ctx, "common.close") }</button>
						}
				}
			}
		}
	</div>
}

// mailRuleRunProgress is a run's progress bar; settings.js moves it as the
// run goes.
templ mailRuleRunProgress(value, max int) {
	@progress.Progress(progress.Props{
		Value: value, Max: max, Size: progress.SizeSm,
		Attributes: templ.Attributes{"data-mail-rule-run-progress": "", "aria-label": i18n.T(ctx, "rules.run.progress")},
		BarClass:   "transition-[width] duration-200 ease-out",
	})
}

// MailRuleActivityDialog shows what the rules did, newest first. Filters,
// "Show more" and clearing swap MailRuleActivityList.
templ MailRuleActivityDialog(data models.MailRuleActivityData, now time.Time) {
	@dialog.Dialog(dialog.Props{ID: "mail-rule-activity-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:flex [&>[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:min-h-0 [&>[data-tui-dialog-panel]]:flex-col [&>[data-tui-dialog-panel]]:gap-0 [&>[data-tui-dialog-panel]]:p-0"}) {
			@dialog.Header(dialog.HeaderProps{Class: "shrink-0 px-6 pt-6 pb-4"}) {
				@dialog.Title() {
					{ i18n.T(ctx, "rules.activity.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "rules.activity.description", "count", i18n.Number(ctx, 2000)) }
				}
			}
			<div class={ dataDialogFormClass }>
				@dataDialogScroll("space-y-4 pb-5") {
					<form
						class="flex flex-col gap-3 sm:flex-row sm:items-center"
						hx-get={ mailRulePath("/activity/list") }
						hx-trigger="change"
						hx-target="#mail-rule-activity-list"
						hx-swap="outerHTML"
						data-mail-rule-activity-filters
					>
						<div class="w-full sm:w-64">
							@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "rule", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "rules.activity.rule")}}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "rules.activity.all")})
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: len(data.Rules) < 8, Class: "mobile-sheet"}) {
									@selectbox.Item(selectbox.ItemProps{Value: "", Selected: data.RuleID == ""}) {
										{ i18n.T(ctx, "rules.activity.all") }
									}
									for _, rule := range data.Rules {
										@selectbox.Item(selectbox.ItemProps{Value: rule.ID, Selected: rule.ID == data.RuleID}) {
											{ rule.Name }
										}
									}
								}
							}
						</div>
						<label class="flex items-center gap-2 text-sm">
							@checkbox.Checkbox(checkbox.Props{Name: "failed", Value: "1", Checked: data.FailedOnly})
							{ i18n.T(ctx, "rules.activity.failed_only") }
						</label>
					</form>
					@MailRuleActivityList(data, now)
				}
				@dataDialogFooter() {
					@mailRuleFooterButtons() {
						<button
							type="button"
							class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm text-muted-foreground hover:bg-destructive/10 hover:text-destructive"
							data-mail-rule-activity-clear={ mailRulePath("/activity/clear") }
						>
							@icon.Trash2(icon.Props{Class: "size-3.5"})
							{ i18n.T(ctx, "rules.activity.clear") }
						</button>
						@dialog.Close() {
							<button type="button" class={ mailRulePrimaryButton }>{ i18n.T(ctx, "common.close") }</button>
						}
					}
				}
			</div>
		}
	}
}

// MailRuleActivityList is the activity's entries as filtered. An entry for
// a message that is still there opens it.
templ MailRuleActivityList(data models.MailRuleActivityData, now time.Time) {
	<div id="mail-rule-activity-list" class="space-y-3" data-mail-rule-activity-list>
		if len(data.Runs) == 0 {
			<div class="rounded-lg border border-dashed border-border p-6 text-center">
				<p class="text-sm text-muted-foreground">
					if data.RuleID != "" || data.FailedOnly {
						{ i18n.T(ctx, "rules.activity.no_match") }
					} else {
						{ i18n.T(ctx, "rules.activity.empty") }
					}
				</p>
			</div>
		} else {
			<ul class="divide-y divide-border/60 rounded-lg border border-border bg-background/60">
				for _, run := range data.Runs {
					<li>
						if run.FolderID != "" {
							<a href={ templ.SafeURL(mailRuleActivityMessageURL(run)) } class="flex min-w-0 items-start gap-3 px-3 py-2.5 hover:bg-accent/50" data-mail-rule-activity-entry={ run.Status }>
								@mailRuleActivityEntry(run, now)
							</a>
						} else {
							<div class="flex min-w-0 items-start gap-3 px-3 py-2.5" data-mail-rule-activity-entry={ run.Status }>
								@mailRuleActivityEntry(run, now)
							</div>
						}
					</li>
				}
			</ul>
			if data.More {
				<div class="flex justify-center">
					<button
						type="button"
						class={ mailRuleCancelButton }
						hx-get={ mailRuleActivityMorePath(data) }
						hx-target="#mail-rule-activity-list"
						hx-swap="outerHTML"
						data-mail-rule-activity-more
					>{ i18n.T(ctx, "rules.activity.more") }</button>
				</div>
			}
		}
	</div>
}

templ mailRuleActivityEntry(run models.MailRuleRun, now time.Time) {
	<span class="mt-0.5 flex size-4 shrink-0 items-center justify-center">
		switch run.Status {
			case models.MailRuleRunApplied:
				@icon.CircleCheck(icon.Props{Class: "size-4 text-emerald-600 dark:text-emerald-400"})
			case models.MailRuleRunFailed:
				@icon.CircleAlert(icon.Props{Class: "size-4 text-destructive"})
			default:
				@icon.CircleMinus(icon.Props{Class: "size-4 text-muted-foreground"})
		}
	</span>
	<span class="min-w-0 flex-1">
		<span class="block truncate text-sm">
			if run.MessageID == 0 {
				{ mailRuleSentence(mailrules.DetailText(ctx, run.Detail)) }
			} else if run.Subject != "" {
				{ i18n.Subject(ctx, run.Subject) }
			} else {
				<span class="text-muted-foreground">{ i18n.T(ctx, "rules.activity.no_subject") }</span>
			}
		</span>
		<span class={ "block truncate text-xs", templ.KV("text-destructive", run.Status == models.MailRuleRunFailed), templ.KV("text-muted-foreground", run.Status != models.MailRuleRunFailed) }>
			{ mailRuleActivityDetail(ctx, run) }
		</span>
	</span>
	<time class="shrink-0 pt-0.5 text-xs text-muted-foreground tabular-nums" datetime={ run.CreatedAt.Format(time.RFC3339) }>{ mailRuleActivityTime(ctx, run.CreatedAt, now) }</time>
}
