package views

import (
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

type PersonalSetupData struct {
 Name string
 Username string
 Errors map[string]string
}

templ PersonalSetupPage(data PersonalSetupData) {
 <!DOCTYPE html>
 <html lang={ pageLang(ctx) } class="dark" data-theme="classic">
  <head>
   <meta charset="UTF-8"/>
   <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
   @I18nScripts()
   <title>{ i18n.T(ctx, "setup.title.personal") }</title>
   @AppIcon()
   <link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
  	<script src={ assetver.URL("/assets/js/actions.js") }></script>
  </head>
  <body class="bg-background text-foreground antialiased surface-desk">
    @PublicPageCorners()
   <main class="min-h-screen flex items-center justify-center p-4 py-10">
    <div class="w-full max-w-md">
     <div class="text-center mb-8">
      <img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
      <h1 class="mt-6 text-2xl font-semibold">{ i18n.T(ctx, "setup.personal.title") }</h1>
      <p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.personal.description") }</p>
     </div>
     if len(data.Errors) > 0 {
      <div role="alert" class="mb-6 rounded-lg border border-destructive/20 bg-destructive/10 p-4 text-sm text-destructive">
       for _, field := range []string{"form", "name", "username", "password", "confirmation"} {
        if data.Errors[field] != "" {
 <p>{ data.Errors[field] }</p>
 }
       }
      </div>
     }
     <form method="post" action="/setup/owner" class="space-y-4">
      <div class="space-y-2">
       <label for="personal-name" class="text-sm font-medium">{ i18n.T(ctx, "setup.personal.name") }</label>
       <input id="personal-name" name="name" autocomplete="name" value={ data.Name } required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
      </div>
      <div class="space-y-2">
       <label for="personal-username" class="text-sm font-medium">{ i18n.T(ctx, "setup.personal.username") }</label>
       <input id="personal-username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" value={ data.Username } required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
      </div>
      <div class="space-y-2">
       <label for="personal-password" class="text-sm font-medium">{ i18n.T(ctx, "signin.password") }</label>
       <input id="personal-password" name="password" type="password" autocomplete="new-password" required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
      </div>
      <div class="space-y-2">
       <label for="personal-password-confirmation" class="text-sm font-medium">{ i18n.T(ctx, "setup.password.confirm") }</label>
       <input id="personal-password-confirmation" name="password_confirmation" type="password" autocomplete="new-password" required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
      </div>
      <p class="text-sm text-muted-foreground">{ i18n.T(ctx, "setup.personal.security_hint") }</p>
      @button.Button(button.Props{Type:button.TypeSubmit, FullWidth:true}) {
 { i18n.T(ctx, "setup.personal.finish") }
 }
     </form>
    </div>
   </main>
  </body>
 </html>
}
