package views

import "github.com/cristianadrielbraun/gofer/components/button"

type PersonalSetupData struct {
 Name string
 Username string
 Errors map[string]string
}

templ PersonalSetupPage(data PersonalSetupData) {
 <!DOCTYPE html>
 <html lang="en" class="dark" data-theme="classic">
  <head>
   <meta charset="UTF-8"/>
   <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
   <title>Gofer — Personal setup</title>
   @AppIcon()
   <link rel="stylesheet" href="/assets/css/output.css"/>
  </head>
  <body class="bg-background text-foreground antialiased surface-desk">
   <main class="min-h-screen flex items-center justify-center p-4 py-10">
    <div class="w-full max-w-md">
     <div class="text-center mb-8">
      <img src="/assets/logo.svg" alt="Gofer" class="h-12 w-auto mx-auto"/>
      <h1 class="mt-6 text-2xl font-semibold">Protect your personal Gofer</h1>
      <p class="mt-2 text-sm text-muted-foreground">One profile for all your mailboxes. Existing mail and settings stay with this profile.</p>
     </div>
     if len(data.Errors) > 0 {
      <div role="alert" class="mb-6 rounded-lg border border-destructive/20 bg-destructive/10 p-4 text-sm text-destructive">
       for _, field := range []string{"form", "name", "username", "password", "confirmation"} {
        if data.Errors[field] != "" {
 <p>{ data.Errors[field] }</p>
 }
       }
      </div>
     }
     <form method="post" action="/setup/owner" class="space-y-4">
      <div class="space-y-2">
       <label for="personal-name" class="text-sm font-medium">Name</label>
       <input id="personal-name" name="name" autocomplete="name" value={ data.Name } required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
      </div>
      <div class="space-y-2">
       <label for="personal-username" class="text-sm font-medium">Sign-in username</label>
       <input id="personal-username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" value={ data.Username } required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
      </div>
      <div class="space-y-2">
       <label for="personal-password" class="text-sm font-medium">Password</label>
       <input id="personal-password" name="password" type="password" autocomplete="new-password" required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
      </div>
      <div class="space-y-2">
       <label for="personal-password-confirmation" class="text-sm font-medium">Confirm password</label>
       <input id="personal-password-confirmation" name="password_confirmation" type="password" autocomplete="new-password" required class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm"/>
      </div>
      <p class="text-sm text-muted-foreground">You can add a TOTP authenticator app or passkey in Security immediately after setup.</p>
      @button.Button(button.Props{Type:button.TypeSubmit, FullWidth:true}) {
 Finish setup
 }
     </form>
    </div>
   </main>
  </body>
 </html>
}
