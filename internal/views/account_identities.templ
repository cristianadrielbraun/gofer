package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"context"
	"fmt"
	"strings"
	"github.com/cristianadrielbraun/gofer/internal/models"

	"github.com/cristianadrielbraun/gofer/components/badge"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/radio"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
)

// AccountIdentitiesDialog lists the further From addresses of one account and
// edits them. Every change swaps AccountIdentitiesPanel.
templ AccountIdentitiesDialog(data models.AccountIdentitiesData) {
	@dialog.Dialog(dialog.Props{ID: "account-identities-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "mobile-page-dialog sm:max-w-2xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "identities.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "identities.description", "email", data.Account.Email) }
				}
			}
			@AccountIdentitiesPanel(data)
		}
	}
}


func accountIdentitiesPath(accountID string, rest string) string {
	return fmt.Sprintf("/api/accounts/%s/identities%s", accountID, rest)
}

// identityDetail says where replies to an identity go and which signature it
// uses.
func identityDetail(ctx context.Context, signatures []models.Signature, identity models.Identity) string {
	signature := i18n.T(ctx, "identities.uses_account_signature")
	for _, sig := range signatures {
		if sig.ID == identity.SignatureID {
			signature = i18n.T(ctx, "identities.signature_named", "name", sig.Name)
		}
	}
	if identity.ReplyTo == "" {
		return signature
	}
	return i18n.T(ctx, "identities.replies_to", "address", identity.ReplyTo) + " · " + signature
}

// AccountIdentitiesPanel shows either the account's identities or, while one
// is added or edited, only the form.
templ AccountIdentitiesPanel(data models.AccountIdentitiesData) {
	<div id="account-identities-panel" class="min-w-0 space-y-4" data-account-identities-panel data-account-id={ data.Account.ID }>
		if data.Adding || data.Editing.ID != "" {
			@accountIdentityForm(data)
		} else {
			@accountIdentitiesList(data)
		}
	</div>
}

templ accountIdentitiesList(data models.AccountIdentitiesData) {
		<div class="rounded-lg border border-border bg-background/60">
			<div class="flex items-center gap-3 border-b border-border/60 p-3">
				<div class="account-color-marker size-4 shrink-0" style={ accountColorStyle(data.Account.Color) } data-account-marker={ data.Account.ID }></div>
				<div class="min-w-0 flex-1">
					<p class="truncate text-sm font-medium">{ data.Account.Name } &lt;{ data.Account.Email }&gt;</p>
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "identities.own_address") }</p>
				</div>
				if data.ProviderListsIdentities {
					<button
						type="button"
						class="inline-flex shrink-0 items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted-foreground hover:bg-accent hover:text-foreground"
						hx-post={ accountIdentitiesPath(data.Account.ID, "/refresh") }
						hx-target="#account-identities-panel"
						hx-swap="outerHTML"
						hx-disabled-elt="this"
						data-account-identities-refresh
					>
						@icon.RefreshCw(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "identities.refresh_from", "provider", accountProviderName(data.Account.Provider)) }
					</button>
				}
			</div>
			if data.RefreshError != "" {
				<p class="border-b border-border/60 px-3 py-2 text-xs text-destructive" role="alert" data-account-identities-refresh-error>{ data.RefreshError }</p>
			}
			if len(data.Identities) == 0 {
				<p class="p-4 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "identities.empty") }</p>
			} else {
				<ul class="divide-y divide-border/60">
					for i, identity := range data.Identities {
						@accountIdentityRow(data, identity, i == 0, i == len(data.Identities)-1)
					}
				</ul>
			}
		</div>
		if data.Error != "" {
			<p class="text-xs text-destructive" role="alert" data-account-identity-error>{ data.Error }</p>
		}
		if data.CanAddIdentities {
			<div class="flex justify-end">
				<button
					type="button"
					class="btn-skeuo inline-flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold"
					hx-get={ accountIdentitiesPath(data.Account.ID, "/panel?add=1") }
					hx-target="#account-identities-panel"
					hx-swap="outerHTML"
					data-account-identity-add
				>
					@icon.Plus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "identities.add") }
				</button>
			</div>
		} else {
			@accountIdentityAddingUnavailable(data)
		}
}

// accountIdentityAddingUnavailable takes the place of the add form for an
// account whose provider sends only from addresses it lists.
templ accountIdentityAddingUnavailable(data models.AccountIdentitiesData) {
	<div class="rounded-lg border border-border bg-background/60 p-4 space-y-1.5" data-account-identity-adding-unavailable>
		<h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "identities.add_title") }</h3>
		if data.Account.Provider == "gmail" {
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "identities.gmail_cannot_add") }</p>
		} else {
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "identities.jmap_cannot_add") }</p>
		}
		if data.Error != "" {
			<p class="text-xs text-destructive" role="alert" data-account-identity-error>{ data.Error }</p>
		}
	</div>
}

// identityUnusableNote says why the provider will not send as a manual
// identity.
func identityUnusableNote(ctx context.Context, data models.AccountIdentitiesData) string {
	if data.Account.Provider == "gmail" {
		return i18n.T(ctx, "identities.unusable_gmail", "email", data.Account.Email)
	}
	return i18n.T(ctx, "identities.unusable_server")
}

templ accountIdentityRow(data models.AccountIdentitiesData, identity models.Identity, first bool, last bool) {
	<li class={ "flex items-center gap-3 p-3", templ.KV("bg-accent/40", identity.ID == data.Editing.ID) } data-account-identity={ identity.ID }>
		<div class="min-w-0 flex-1">
			<div class="flex min-w-0 items-center gap-2">
				<p class="min-w-0 truncate text-sm font-medium">
					if identity.Name != "" {
						{ identity.Name } &lt;{ identity.Email }&gt;
					} else {
						{ identity.Email }
					}
				</p>
				if identity.Source == models.IdentitySourceProvider {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "shrink-0 text-[10px]"}) {
						{ i18n.T(ctx, "identities.from_provider", "provider", accountProviderName(data.Account.Provider)) }
					}
				}
			</div>
			<p class="truncate text-xs text-muted-foreground">{ identityDetail(ctx, data.Signatures, identity) }</p>
			if identity.HasOwnSMTP() {
				<p class="truncate text-xs text-muted-foreground" data-account-identity-smtp>{ i18n.T(ctx, "identities.sends_through", "host", identity.SMTPHost) }</p>
				if !identity.HasSMTPPassword {
					<p class="text-xs text-destructive" data-account-identity-needs-password>{ i18n.T(ctx, "identities.needs_password") }</p>
				}
			}
			if data.Unusable[identity.ID] {
				<p class="text-xs text-destructive" data-account-identity-unusable>{ identityUnusableNote(ctx, data) }</p>
			}
		</div>
		<div class="flex shrink-0 items-center gap-1">
			<button
				type="button"
				class="inline-flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground disabled:pointer-events-none disabled:opacity-40"
				aria-label={ i18n.T(ctx, "identities.move_up", "email", identity.Email) }
				disabled?={ first }
				hx-post={ accountIdentitiesPath(data.Account.ID, "/"+identity.ID+"/move") }
				hx-vals='{"direction":"up"}'
				hx-target="#account-identities-panel"
				hx-swap="outerHTML"
			>
				@icon.ArrowUp(icon.Props{Class: "size-3.5"})
			</button>
			<button
				type="button"
				class="inline-flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground disabled:pointer-events-none disabled:opacity-40"
				aria-label={ i18n.T(ctx, "identities.move_down", "email", identity.Email) }
				disabled?={ last }
				hx-post={ accountIdentitiesPath(data.Account.ID, "/"+identity.ID+"/move") }
				hx-vals='{"direction":"down"}'
				hx-target="#account-identities-panel"
				hx-swap="outerHTML"
			>
				@icon.ArrowDown(icon.Props{Class: "size-3.5"})
			</button>
			<button
				type="button"
				class="inline-flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground"
				aria-label={ i18n.T(ctx, "identities.edit_named", "email", identity.Email) }
				hx-get={ accountIdentitiesPath(data.Account.ID, "/panel?edit="+identity.ID) }
				hx-target="#account-identities-panel"
				hx-swap="outerHTML"
			>
				@icon.Pencil(icon.Props{Class: "size-3.5"})
			</button>
			if identity.Source != models.IdentitySourceProvider {
				<button
					type="button"
					class="inline-flex size-7 items-center justify-center rounded-md text-muted-foreground hover:bg-destructive/10 hover:text-destructive"
					aria-label={ i18n.T(ctx, "identities.delete_named", "email", identity.Email) }
					hx-delete={ accountIdentitiesPath(data.Account.ID, "/"+identity.ID) }
					hx-target="#account-identities-panel"
					hx-swap="outerHTML"
				>
					@icon.Trash2(icon.Props{Class: "size-3.5"})
				</button>
			}
		</div>
	</li>
}

templ accountIdentityForm(data models.AccountIdentitiesData) {
	{{ editing := data.Editing }}
	{{ fromProvider := editing.Source == models.IdentitySourceProvider }}
	<form
		class="rounded-lg border border-border bg-background/60 p-4 space-y-3"
		hx-post={ accountIdentitiesPath(data.Account.ID, "") }
		hx-target="#account-identities-panel"
		hx-swap="outerHTML"
		data-account-identity-form
	>
		<div class="flex min-w-0 items-center gap-2">
			<button
				type="button"
				class="inline-flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground"
				aria-label={ i18n.T(ctx, "identities.back") }
				hx-get={ accountIdentitiesPath(data.Account.ID, "/panel") }
				hx-target="#account-identities-panel"
				hx-swap="outerHTML"
				data-account-identity-back
			>
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
			</button>
			<h3 class="min-w-0 truncate text-xs font-semibold uppercase tracking-wider text-muted-foreground">
				if editing.ID == "" {
					{ i18n.T(ctx, "identities.add_title") }
				} else {
					{ i18n.T(ctx, "identities.edit_named", "email", editing.Email) }
				}
			</h3>
		</div>
		if !fromProvider && len(data.CatchAllDomains) > 0 {
			<p class="text-xs text-muted-foreground" data-account-identity-catch-all>{ i18n.N(ctx, "identities.catch_all", len(data.CatchAllDomains), "domains", strings.Join(data.CatchAllDomains, ", ")) }</p>
		}
		if fromProvider {
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "identities.from_provider_note", "provider", accountProviderName(data.Account.Provider)) }</p>
		}
		<input type="hidden" name="id" value={ editing.ID }/>
		<div class="grid gap-3 sm:grid-cols-2">
			<div>
				<label class="mb-1.5 block text-xs font-medium text-muted-foreground" for="account-identity-name">{ i18n.T(ctx, "contacts.field.name") }</label>
				@input.Input(input.Props{ID: "account-identity-name", Name: "name", Type: input.TypeText, Value: editing.Name, Placeholder: data.Account.Name, Readonly: fromProvider})
			</div>
			<div>
				<label class="mb-1.5 block text-xs font-medium text-muted-foreground" for="account-identity-email">{ i18n.T(ctx, "identities.email") }</label>
				@input.Input(input.Props{ID: "account-identity-email", Name: "email", Type: input.TypeEmail, Value: editing.Email, Placeholder: "sales@example.com", Required: true, Readonly: fromProvider})
			</div>
			<div>
				<label class="mb-1.5 block text-xs font-medium text-muted-foreground" for="account-identity-reply-to">{ i18n.T(ctx, "identities.reply_to") } <span class="font-normal">{ i18n.T(ctx, "identities.optional") }</span></label>
				@input.Input(input.Props{ID: "account-identity-reply-to", Name: "reply_to", Type: input.TypeText, Value: editing.ReplyTo, Placeholder: i18n.T(ctx, "identities.reply_to_placeholder"), Readonly: fromProvider})
			</div>
			<div>
				<label class="mb-1.5 block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "identities.signature") }</label>
				@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
					@selectbox.Trigger(selectbox.TriggerProps{Name: "signature_id", Class: "bg-background", DisableClear: true}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "identities.use_account_signature")})
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
						@selectbox.Item(selectbox.ItemProps{Value: "", Selected: editing.SignatureID == ""}) { { i18n.T(ctx, "identities.use_account_signature") } }
						for _, sig := range data.Signatures {
							@selectbox.Item(selectbox.ItemProps{Value: sig.ID, Selected: sig.ID == editing.SignatureID}) { { sig.Name } }
						}
					}
				}
			</div>
		</div>
		if !fromProvider && data.CanUseOwnSMTP {
			@accountIdentitySendThrough(data)
		}
		<div class="flex items-center justify-between gap-3">
			if data.Error != "" {
				<p class="text-xs text-destructive" role="alert" data-account-identity-error>{ data.Error }</p>
			} else {
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "identities.send_as_note") }</p>
			}
			<button type="submit" class="btn-skeuo inline-flex shrink-0 items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold">
				if editing.ID == "" {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "contacts.edit.add") }
				} else {
					@icon.Save(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "common.save") }
				}
			</button>
		</div>
	</form>
}

// identityUsesOwnSMTP says whether the form starts on "Another SMTP server":
// the identity has one, or the account's way of sending wouldn't take the
// address.
func identityUsesOwnSMTP(data models.AccountIdentitiesData) bool {
	return data.Editing.HasOwnSMTP() || !data.AccountSendsAnyAddress || data.Unusable[data.Editing.ID]
}

func identitySMTPPortValue(identity models.Identity) string {
	if identity.SMTPPort == 0 {
		return "465"
	}
	return fmt.Sprint(identity.SMTPPort)
}

func identitySMTPTLSMode(identity models.Identity) string {
	if identity.SMTPTLSMode == "" {
		return "tls"
	}
	return identity.SMTPTLSMode
}

// accountIdentitySendThrough chooses how an identity's mail goes out: the
// account's way, or an SMTP server of its own.
templ accountIdentitySendThrough(data models.AccountIdentitiesData) {
	{{ editing := data.Editing }}
	{{ own := identityUsesOwnSMTP(data) }}
	<fieldset class="space-y-2" data-identity-send-through>
		<legend class="mb-1.5 text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "identities.send_through") }</legend>
		<div class="flex flex-wrap gap-x-5 gap-y-2">
			<label class={ "flex items-center gap-2 text-sm", templ.KV("opacity-50", !data.AccountSendsAnyAddress) }>
				@radio.Radio(radio.Props{Name: "send_through", Value: "account", Checked: !own, Disabled: !data.AccountSendsAnyAddress, Attributes: templ.Attributes{"data-on-change": onAction("toggleIdentitySMTP", actionElement)}})
				{ i18n.T(ctx, "identities.account_server") }
			</label>
			<label class="flex items-center gap-2 text-sm">
				@radio.Radio(radio.Props{Name: "send_through", Value: "smtp", Checked: own, Attributes: templ.Attributes{"data-on-change": onAction("toggleIdentitySMTP", actionElement)}})
				{ i18n.T(ctx, "identities.other_smtp") }
			</label>
		</div>
		if !data.AccountSendsAnyAddress && data.Account.Provider == "jmap" {
			<p class="text-xs text-muted-foreground" data-identity-send-through-jmap>{ i18n.T(ctx, "identities.jmap_send_through") }</p>
		} else if !data.AccountSendsAnyAddress {
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "identities.provider_send_through", "provider", accountProviderName(data.Account.Provider)) }</p>
		}
		<div class={ "grid gap-3 rounded-md border border-border/60 p-3 sm:grid-cols-2", templ.KV("hidden", !own) } data-identity-smtp-fields>
			<div class="sm:col-span-2">
				<label class="mb-1.5 block text-xs font-medium text-muted-foreground" for="account-identity-smtp-host">{ i18n.T(ctx, "identities.smtp_server") }</label>
				@input.Input(input.Props{ID: "account-identity-smtp-host", Name: "smtp_host", Type: input.TypeText, Value: editing.SMTPHost, Placeholder: "smtp.example.com"})
				<div data-server-check="smtp" class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
			</div>
			<div>
				<label class="mb-1.5 block text-xs font-medium text-muted-foreground" for="account-identity-smtp-port">{ i18n.T(ctx, "identities.port") }</label>
				@input.Input(input.Props{ID: "account-identity-smtp-port", Name: "smtp_port", Type: input.TypeNumber, Value: identitySMTPPortValue(editing), Placeholder: "465"})
			</div>
			<div>
				<label class="mb-1.5 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
					<span>{ i18n.T(ctx, "identities.encryption") }</span>
					@UnencryptedTransportWarning("identity-smtp-unencrypted-warning", identitySMTPTLSMode(editing) == "plaintext")
				</label>
				@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
					@selectbox.Trigger(selectbox.TriggerProps{Name: "smtp_tls_mode", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-on-change": onAction("toggleUnencryptedTransportWarning", actionElement)}}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: "TLS"})
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
						@selectbox.Item(selectbox.ItemProps{Value: "tls", Selected: identitySMTPTLSMode(editing) == "tls"}) { TLS }
						@selectbox.Item(selectbox.ItemProps{Value: "starttls", Selected: identitySMTPTLSMode(editing) == "starttls"}) { STARTTLS }
						@selectbox.Item(selectbox.ItemProps{Value: "plaintext", Selected: identitySMTPTLSMode(editing) == "plaintext"}) { { i18n.T(ctx, "identities.unencrypted") } }
					}
				}
			</div>
			<div>
				<label class="mb-1.5 block text-xs font-medium text-muted-foreground" for="account-identity-smtp-username">{ i18n.T(ctx, "identities.username") }</label>
				@input.Input(input.Props{ID: "account-identity-smtp-username", Name: "smtp_username", Type: input.TypeText, Value: editing.SMTPUsername, Placeholder: i18n.T(ctx, "identities.username_placeholder"), Attributes: templ.Attributes{"autocomplete": "off"}})
			</div>
			<div>
				<label class="mb-1.5 block text-xs font-medium text-muted-foreground" for="account-identity-smtp-password">{ i18n.T(ctx, "identities.password") }</label>
				if editing.HasSMTPPassword {
					@input.Input(input.Props{ID: "account-identity-smtp-password", Name: "smtp_password", Type: input.TypePassword, Placeholder: i18n.T(ctx, "identities.password_saved"), Attributes: templ.Attributes{"autocomplete": "new-password"}})
				} else {
					@input.Input(input.Props{ID: "account-identity-smtp-password", Name: "smtp_password", Type: input.TypePassword, Placeholder: "••••••••", Attributes: templ.Attributes{"autocomplete": "new-password"}})
				}
			</div>
			<div class="flex items-center gap-3 sm:col-span-2">
				<button
					type="button"
					class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border px-2.5 py-1 text-xs hover:bg-accent"
					hx-post={ accountIdentitiesPath(data.Account.ID, "/smtp-test") }
					hx-include="closest form"
					hx-target="#account-identity-smtp-test"
					hx-swap="innerHTML"
					hx-disabled-elt="this"
					data-account-identity-smtp-test
				>
					@icon.PlugZap(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "identities.test") }
				</button>
				<div id="account-identity-smtp-test" class="min-w-0 flex-1" aria-live="polite">
					if data.SMTPTest != nil {
						@AccountIdentitySMTPTestResult(*data.SMTPTest)
					}
				</div>
			</div>
		</div>
	</fieldset>
}

// AccountIdentitySMTPTestResult says how testing an identity's SMTP server
// went.
templ AccountIdentitySMTPTestResult(result models.ConnectionTestResult) {
	if result.Success {
		<p class="flex items-center gap-1.5 text-xs text-emerald-700 dark:text-emerald-300" data-account-identity-smtp-test-result="ok">
			@icon.CircleCheck(icon.Props{Class: "size-3.5 shrink-0"})
			{ result.Message }
		</p>
	} else {
		<p class="flex items-start gap-1.5 text-xs text-destructive" role="alert" data-account-identity-smtp-test-result="error">
			@icon.CircleX(icon.Props{Class: "mt-0.5 size-3.5 shrink-0"})
			<span class="min-w-0 break-words">{ result.Error }</span>
		</p>
	}
}
