package views

import (
	"fmt"
	"strings"
	"time"

	"github.com/cristianadrielbraun/gofer/components/badge"
	"github.com/cristianadrielbraun/gofer/components/calendar"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/popover"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	"github.com/cristianadrielbraun/gofer/components/tooltip"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

templ ComposeDialog(accounts []models.Account) {
	{{ accounts = mailAccounts(accounts) }}
	@dialog.Dialog(dialog.Props{
		ID: "compose-dialog",
		Class: "[&_[data-tui-dialog-panel]]:!flex [&_[data-tui-dialog-panel]]:flex-col [&_[data-tui-dialog-panel]]:h-full [&_[data-tui-dialog-panel]]:min-h-0 [&_[data-tui-dialog-panel]]:gap-3",
	}) {
		@dialog.Trigger() {
			<span></span>
		}
		@dialog.Content(dialog.ContentProps{
			Class:           "compose-dialog-content mobile-fullscreen-dialog sm:max-w-4xl w-full h-[80vh] min-h-[250px] flex flex-col max-lg:!h-dvh max-lg:!max-h-none max-lg:!w-screen max-lg:!max-w-none max-lg:!rounded-none max-lg:!border-0",
			HideCloseButton: true,
		}) {
			@dialog.Header() {
				@dialog.Title() {
					<span data-compose-title>New message</span>
				}
			}
			<div class="compose-dialog-corner absolute top-4 right-4 flex items-center gap-1">
				<button type="button" data-on-click='["expandToPane"]' class="hidden lg:inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-1.5 rounded-md hover:bg-accent" aria-label="Compose inline">
					@icon.PanelLeftOpen(icon.Props{Class: "size-3.5"})
					Compose inline
				</button>
				@tooltip.Tooltip() {
					@tooltip.Trigger() {
						<button type="button" data-on-click='["discardComposeDialog"]' class="flex items-center justify-center size-7 rounded text-muted-foreground opacity-70 transition-opacity hover:opacity-100 hover:bg-accent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 ring-offset-background [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4" aria-label="Discard draft">
							@icon.X()
							<span class="sr-only">Discard draft</span>
						</button>
					}
					@tooltip.Content(tooltip.ContentProps{
						Position:  tooltip.PositionBottom,
						ShowArrow: true,
					}) {
						Discard draft
					}
				}
			</div>
			<div id="compose-form" class="flex flex-col flex-1 min-h-0 gap-3 pt-2">
				@ComposeDropChoice("compose-drop-choice")
				@ComposeMobileBar()
				<input type="hidden" name="account_id" id="compose-account-id" value={ composeDefaultAccountID(accounts) }/>
				<input type="hidden" name="identity_id" id="compose-identity-id" value=""/>
				<input type="hidden" name="draft_id" id="compose-draft-id" value=""/>
				<input type="hidden" name="compose_mode" id="compose-mode" value="new"/>
				<input type="hidden" name="in_reply_to" id="compose-in-reply-to" value=""/>
				<input type="hidden" name="references" id="compose-references" value=""/>
				<div class="compose-dialog-fields space-y-1">
					<div class="compose-from-row flex items-center gap-2" data-compose-from-row>
						<label class="text-xs text-muted-foreground font-medium w-8 shrink-0">From</label>
						@dropdown.Dropdown() {
							@dropdown.Trigger() {
								<button type="button" id="compose-from-trigger" class="compose-from-trigger flex items-center gap-1 text-sm text-foreground transition-colors px-1.5 py-0.5 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background">
									<span id="compose-from-display">{ composeDefaultName(accounts) } &lt;{ composeDefaultEmail(accounts) }&gt;</span>
									@icon.ChevronDown(icon.Props{Class: "size-3 text-muted-foreground"})
								</button>
							}
							@dropdown.Content(dropdown.ContentProps{Class: "compose-from-menu max-h-[60vh] normal-case tracking-normal"}) {
								@composeFromMenuItems(accounts, "dialog")
							}
						}
					</div>
					@composeOneTimeFromRow(accounts, "dialog")
					<div class="compose-to-row">
						@ComposeField("To", "to", "recipient@example.com")
						@ComposeCcBccButtons()
					</div>
					<div id="cc-field" class="hidden">
						@ComposeField("Cc", "cc", "")
					</div>
					<div id="bcc-field" class="hidden">
						@ComposeField("Bcc", "bcc", "")
					</div>
				</div>
			<div class="compose-subject-row border-t pt-2">
				@input.Input(input.Props{
					Name:        "subject",
					Placeholder: "Subject",
					Class:       "compose-input h-8 font-semibold placeholder:font-normal",
				})
			</div>
			@ComposeToolbar()
			@ComposeRichEditor()
			@ComposeAttachments()
			</div>
			@dialog.Footer(dialog.FooterProps{Class: "compose-dialog-footer"}) {
				<div class="flex items-center justify-between w-full gap-3">
					<div class="flex items-center gap-2 min-w-0">
					<button type="button" data-on-click='["saveComposeDraft",false,false]' class="inline-flex min-w-28 items-center justify-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-all duration-200 px-3 py-1.5 rounded-md border border-border hover:bg-accent" data-compose-draft-button data-compose-draft-state="default">
						<span class="inline-flex transition-transform duration-200" data-compose-draft-icon>
							@icon.Save(icon.Props{Class: "size-3.5"})
						</span>
						<span data-compose-draft-label>Save Draft</span>
					</button>
					</div>
					<div class="flex items-center gap-2">
						@ComposeSchedulePopover(false, "inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border border-border text-muted-foreground hover:text-foreground hover:bg-accent transition-colors")
						<button type="button"
							class="btn-skeuo inline-flex items-center gap-1.5 text-sm font-semibold px-4 py-1.5 rounded-lg"
							id="compose-send-btn"
							data-on-click='["sendCompose"]'
						>
							@icon.Send(icon.Props{Class: "size-3.5"})
							Send
						</button>
					</div>
				</div>
			}
		}
	}
	@dialog.Dialog(dialog.Props{ID: "compose-close-choice-dialog"}) {
		@dialog.Trigger() {
			<span></span>
		}
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			@dialog.Header() {
				@dialog.Title() { Close compose? }
				@dialog.Description() { Keep this message as a draft, discard it permanently, or continue editing. }
			}
			@dialog.Footer() {
				<button type="button" data-compose-close-action="cancel" class="rounded-md px-3 py-2 text-sm font-semibold hover:bg-accent hover:text-accent-foreground">Cancel</button>
				<button type="button" data-compose-close-action="discard" class="rounded-md px-3 py-2 text-sm font-semibold hover:bg-accent hover:text-accent-foreground">Exit and discard</button>
				<button type="button" data-compose-close-action="keep" class="rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90">Exit and keep draft</button>
			}
		}
	}
}

// ComposeCcBccButtons reveal the Cc and Bcc fields. They sit below the To field on
// desktop and at the end of the To row on small screens.
templ ComposeCcBccButtons() {
	<div id="cc-bcc-buttons" class="flex items-center gap-2 pt-1">
		<button
			id="cc-btn"
			type="button"
			class="text-[11px] text-muted-foreground hover:text-foreground transition-colors px-1.5 py-0.5 rounded hover:bg-accent"
			data-on-click='["goferShowComposeRecipientField","cc-field","cc-btn"]'
		>Cc</button>
		<button
			id="bcc-btn"
			type="button"
			class="text-[11px] text-muted-foreground hover:text-foreground transition-colors px-1.5 py-0.5 rounded hover:bg-accent"
			data-on-click='["goferShowComposeRecipientField","bcc-field","bcc-btn"]'
		>Bcc</button>
	</div>
}

// ComposeMobileBar is the compose dialog's app bar on small screens: close, title,
// attach, send, and a menu for saving a draft or sending later. The footer buttons
// it replaces stay in the page (hidden) and keep their behaviour.
templ ComposeMobileBar() {
	<div class="compose-mobile-bar" data-compose-mobile-bar>
		<button type="button" class="compose-mobile-bar-button" data-on-click='["discardComposeDialog"]' aria-label="Close compose">
			@icon.X(icon.Props{Class: "size-5"})
		</button>
		<div class="compose-mobile-bar-heading">
			<span class="compose-mobile-bar-title" data-compose-title>New message</span>
			<span class="compose-mobile-bar-status" data-compose-mobile-status aria-live="polite"></span>
		</div>
		<button type="button" class="compose-mobile-bar-button" data-on-click='["triggerComposeAttachmentUpload","$this"]' aria-label="Attach files">
			@icon.Paperclip(icon.Props{Class: "size-5"})
		</button>
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				<button type="button" class="compose-mobile-bar-button" aria-label="More compose options">
					@icon.EllipsisVertical(icon.Props{Class: "size-5"})
				</button>
			}
			@dropdown.Content(dropdown.ContentProps{Class: "mobile-sheet"}) {
				@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("saveComposeDraft", false, false)}}) {
					<span class="flex items-center gap-2">
						@icon.Save(icon.Props{Class: "size-4"})
						Save draft
					</span>
				}
				@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-compose-mobile-send-later": ""}}) {
					<span class="flex items-center gap-2">
						@icon.CalendarClock(icon.Props{Class: "size-4"})
						Send later
					</span>
				}
			}
		}
		<button type="button" class="compose-mobile-bar-send" data-on-click='["sendCompose"]' aria-label="Send" data-compose-mobile-send>
			@icon.Send(icon.Props{Class: "size-5"})
		</button>
	</div>
}

templ ComposeToolbar() {
	<div class="flex items-center gap-0.5 border-t border-b py-1 -mx-1" data-compose-toolbar>
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-compose-command="bold" data-on-click='["composeExec","$this","bold"]'>
					@icon.Bold(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Bold
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-compose-command="italic" data-on-click='["composeExec","$this","italic"]'>
					@icon.Italic(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Italic
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-compose-command="underline" data-on-click='["composeExec","$this","underline"]'>
					@icon.Underline(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Underline
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-compose-command="strikeThrough" data-on-click='["composeExec","$this","strikeThrough"]'>
					@icon.Strikethrough(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Strikethrough
			}
		}
		<div class="w-px h-4 bg-border mx-0.5"></div>
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-compose-command="insertUnorderedList" data-on-click='["composeExec","$this","insertUnorderedList"]'>
					@icon.List(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Bullet list
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-compose-command="insertOrderedList" data-on-click='["composeExec","$this","insertOrderedList"]'>
					@icon.ListOrdered(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Numbered list
			}
		}
		<div class="w-px h-4 bg-border mx-0.5"></div>
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-on-click='["triggerComposeAttachmentUpload","$this"]' data-compose-toolbar-attach>
					@icon.Paperclip(icon.Props{Class: "size-3.5"})
				</button>
			}
		@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Attach file (max 25 MB each, 35 MB total)
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-on-click='["triggerComposeInlineImageUpload","$this"]'>
					@icon.Image(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Insert image
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-on-click='["composeCreateLink","$this"]'>
					@icon.Link(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Insert link
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-on-click='["showComposeSignaturePicker","$this"]'>
					@icon.Signature(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Insert signature
			}
		}
		<div class="w-px h-4 bg-border mx-0.5"></div>
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-on-click='["composeExec","$this","formatBlock","blockquote"]' aria-label="Quote">
					@icon.Quote(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Quote
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				<button type="button" class="flex items-center justify-center size-7 rounded text-muted-foreground hover:text-foreground hover:bg-accent transition-colors" data-on-click='["composeExec","$this","formatBlock","pre"]' aria-label="Code block">
					@icon.Code(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Code block
			}
		}
	</div>
}

templ ComposeRichEditor() {
	<div class="flex-1 min-h-0 overflow-y-auto rounded-md border border-border/60 bg-background/40">
		<textarea name="body" class="hidden" data-compose-plain></textarea>
		<textarea name="html_body" class="hidden" data-compose-html></textarea>
		<div
			class="compose-rich-editor min-h-[190px] h-full px-3 py-2 text-sm leading-6 outline-none"
			contenteditable="true"
			role="textbox"
			aria-label="Message body"
			data-compose-editor
			data-placeholder="Write your message..."
			data-on-input='["composeChanged","$this"]'
			data-on-keyup='["updateComposeToolbar","$this"]'
			data-on-mouseup='["updateComposeToolbar","$this"]'
			data-on-focus='["setActiveComposeEditor","$this"]'
			data-on-paste='["handleComposePaste","$event"]'
		></div>
	</div>
}

templ ComposeAttachments() {
	<div class="hidden rounded-md border border-border/60 bg-background/40 p-2" data-compose-attachments>
		<input type="file" multiple class="hidden" data-compose-attachment-input data-on-change='["uploadComposeAttachments","$files","$this"]'/>
		<input type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml,image/bmp,image/x-icon" class="hidden" data-compose-inline-input data-on-change='["uploadComposeInlineImages","$files","$this"]'/>
		<div class="mb-2 flex items-center justify-between gap-2 text-[11px] font-medium text-muted-foreground" data-compose-attachment-header>
			<span data-compose-attachment-summary>Max 25 MB per file, 35 MB total</span>
			<button type="button" class="rounded px-1.5 py-0.5 text-muted-foreground hover:bg-accent hover:text-foreground" data-on-click='["toggleComposeAttachments","$this"]' data-compose-attachment-toggle>Hide</button>
		</div>
		<div class="flex flex-wrap gap-2" data-compose-attachment-list></div>
	</div>
}

templ ComposeSchedulePopover(fromPane bool, buttonClass string) {
	{{ suffix := "" }}
	if fromPane {
		{{ suffix = "pane-" }}
	}
	@popover.Root(popover.RootProps{Class: "inline-flex"}) {
		@popover.Trigger() {
			if fromPane {
				<button type="button" data-on-click='["prepareComposeSchedule","$this",true]' class={ buttonClass } title="Schedule send">
					@icon.CalendarClock(icon.Props{Class: "size-3.5"})
					Send later
				</button>
			} else {
				<button type="button" data-on-click='["prepareComposeSchedule","$this",false]' class={ buttonClass } title="Schedule send">
					@icon.CalendarClock(icon.Props{Class: "size-3.5"})
					Send later
				</button>
			}
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementTopEnd, Offset: 10, Class: "mobile-sheet w-[16.5rem] max-w-[calc(100vw-1.5rem)] p-3"}) {
			<div data-compose-schedule-panel data-compose-schedule-pane?={ fromPane }>
				<div class="mb-2 flex items-center justify-between gap-3">
					<div>
						<div class="text-sm font-semibold text-popover-foreground">Schedule send</div>
						<p class="text-[11px] text-muted-foreground">Pick a date and local time.</p>
					</div>
					@icon.CalendarClock(icon.Props{Class: "size-4 text-muted-foreground"})
				</div>
				<div class="inline-flex rounded-lg border border-border/70 bg-background/35 p-2">
					@calendar.Calendar(calendar.Props{ID: "compose-" + suffix + "schedule-calendar", Name: "compose_" + suffix + "schedule_date", Class: "[--cell-size:1.75rem]", HideHiddenInput: false, MinYear: time.Now().Year(), MaxYear: time.Now().Year() + 10})
				</div>
				<label class="mt-3 block text-xs font-medium text-muted-foreground" for={ "compose-" + suffix + "schedule-hour" }>Send time</label>
				<div class="mt-1 flex items-center gap-2">
					<div class="flex shrink-0 items-center gap-1.5">
						@selectbox.SelectBox(selectbox.Props{ID: "compose-" + suffix + "schedule-hour", Class: "w-[4.25rem]", Attributes: templ.Attributes{"data-compose-schedule-hour": ""}}) {
							@selectbox.Trigger(selectbox.TriggerProps{DisableClear: true, Class: "h-9 px-2 font-mono text-sm tabular-nums"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "HH", Class: "font-mono text-sm tabular-nums"})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true, Class: "[&>div>div]:max-h-52"}) {
								@selectbox.Group(selectbox.GroupProps{Attributes: selectbox.LazyItems(scheduleTimeItems(24, 1))}) {
									@selectbox.Item(selectbox.ItemProps{Value: "00", Class: "font-mono text-sm tabular-nums"}) {
										00
									}
								}
							}
						}
						<span class="text-sm font-semibold text-muted-foreground">:</span>
						@selectbox.SelectBox(selectbox.Props{ID: "compose-" + suffix + "schedule-minute", Class: "w-[4.25rem]", Attributes: templ.Attributes{"data-compose-schedule-minute": ""}}) {
							@selectbox.Trigger(selectbox.TriggerProps{DisableClear: true, Class: "h-9 px-2 font-mono text-sm tabular-nums"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "MM", Class: "font-mono text-sm tabular-nums"})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true, Class: "[&>div>div]:max-h-52"}) {
								@selectbox.Group(selectbox.GroupProps{Attributes: selectbox.LazyItems(scheduleTimeItems(60, 5))}) {
									@selectbox.Item(selectbox.ItemProps{Value: "00", Class: "font-mono text-sm tabular-nums"}) {
										00
									}
								}
							}
						}
					</div>
					<div class="flex h-9 min-w-0 flex-1 items-center justify-end text-xs font-medium text-muted-foreground" title="Local timezone">
						<span class="truncate" data-compose-schedule-timezone>UTC</span>
					</div>
				</div>
				<div class="mt-3 flex items-center justify-end gap-2">
					<button type="button" class="rounded-md px-2.5 py-1.5 text-xs font-semibold text-muted-foreground hover:bg-accent hover:text-foreground" data-on-click='["closeComposeSchedulePopover","$this"]'>Cancel</button>
					if fromPane {
						<button type="button" class="btn-skeuo rounded-md px-3 py-1.5 text-xs font-semibold" data-on-click='["scheduleCompose",true,"$this"]'>Schedule</button>
					} else {
						<button type="button" class="btn-skeuo rounded-md px-3 py-1.5 text-xs font-semibold" data-on-click='["scheduleCompose",false,"$this"]'>Schedule</button>
					}
				</div>
			</div>
		}
	}
}

templ ComposeField(label string, name string, placeholder string) {
	<div class="flex items-center gap-2">
		<label class="text-xs text-muted-foreground font-medium w-8 shrink-0">{ label }</label>
		<input type="hidden" name={ name } data-compose-recipient-value/>
		<div class="compose-recipient-field relative min-h-9 flex flex-1 items-center gap-1.5 rounded-md border px-2 py-1.5 text-sm" data-compose-recipient-field data-recipient-name={ name } data-on-click='["focusComposeRecipientField","$this"]'>
			<span class="min-w-24 flex-1 outline-none empty:before:content-[attr(data-placeholder)] empty:before:text-muted-foreground" contenteditable="true" role="textbox" data-compose-recipient-input data-placeholder={ placeholder } data-on-keydown='["handleComposeRecipientKeydown","$event"]' data-on-input='["handleComposeRecipientInput","$this"]' data-on-blur='["finalizeComposeRecipientInput","$this"]'></span>
		</div>
	</div>
}

// composeFromMenuItems lists every account in a From menu as a group headed
// by its name and color: the account's own address first, marked "main",
// then its identities.
templ composeFromMenuItems(accounts []models.Account, scope string) {
	for i, acc := range accounts {
		if i > 0 {
			@dropdown.Separator()
		}
		@dropdown.Group(dropdown.GroupProps{Attributes: templ.Attributes{"data-compose-from-account": acc.ID}}) {
			@dropdown.Label(dropdown.LabelProps{Class: "flex items-center gap-1.5 px-2 pt-1.5 pb-0.5 text-[11px] font-medium text-muted-foreground"}) {
				<div class="account-color-marker size-2 shrink-0" style={ accountColorStyle(acc.Color) } data-account-marker={ acc.ID }></div>
				<span class="truncate">{ contactSidebarAccountName(acc) }</span>
			}
			@dropdown.Item(dropdown.ItemProps{
				Class: "compose-from-item select-item group relative justify-start gap-2 py-1 pr-3 text-[13px] font-normal outline-none transition-colors duration-150",
				Attributes: templ.Attributes{
					"data-compose-account-item":     "",
					"data-compose-account-scope":    scope,
					"data-compose-account-selected": fmt.Sprintf("%t", acc.ID == composeDefaultAccountID(accounts)),
					"data-account-id":               acc.ID,
					"data-account-email":            acc.Email,
					"data-account-name":             acc.Name,
					"data-on-click":                 onAction("selectComposeAccount", actionElement, scope == "pane"),
				},
			}) {
				@composeFromAddressText(acc.Name, acc.Email)
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "shrink-0 px-1.5 py-0 text-[10px] font-medium leading-4 opacity-80"}) {
					main
				}
			}
			for _, identity := range acc.Identities {
				@dropdown.Item(dropdown.ItemProps{
					Class: "compose-from-item select-item group relative justify-start py-1 pr-3 text-[13px] font-normal outline-none transition-colors duration-150",
					Attributes: templ.Attributes{
						"data-compose-account-item":     "",
						"data-compose-account-scope":    scope,
						"data-compose-account-selected": "false",
						"data-account-id":               acc.ID,
						"data-identity-id":              identity.ID,
						"data-identity-email":           identity.Email,
						"data-identity-name":            identity.Name,
						"data-on-click":                 onAction("selectComposeAccount", actionElement, scope == "pane"),
					},
				}) {
					@composeFromAddressText(identity.Name, identity.Email)
				}
			}
		}
	}
	if composeHasOneTimeFrom(accounts) {
		@dropdown.Separator()
		@dropdown.Item(dropdown.ItemProps{
			Class: "compose-from-item select-item group relative justify-start gap-2 py-1 pr-3 text-[13px] font-normal outline-none transition-colors duration-150",
			Attributes: templ.Attributes{
				"data-compose-one-time-item":    "",
				"data-compose-account-scope":    scope,
				"data-compose-account-selected": "false",
				"data-on-click":                 onAction("selectComposeOneTimeFrom", actionElement, scope == "pane"),
			},
		}) {
			@icon.PenLine(icon.Props{Class: "size-3.5 shrink-0 opacity-70"})
			<span class="min-w-0 truncate select-item-text">Custom From…</span>
		}
	}
}

// composeOneTimeFromRow is where a From for just this message is typed: its
// name, its address, and which server sends it. It shows once "Custom
// From…" is picked in the From menu.
templ composeOneTimeFromRow(accounts []models.Account, scope string) {
	if composeHasOneTimeFrom(accounts) {
		<div class="compose-one-time-from hidden" data-compose-one-time-from data-compose-account-scope={ scope }>
			<input type="hidden" name="one_time_from" value="" data-compose-one-time-active/>
			<input type="hidden" name="send_via" value="" data-compose-one-time-send-via/>
			<div class="flex items-start gap-2 pb-1">
				<span class="w-8 shrink-0" aria-hidden="true"></span>
				<div class="min-w-0 flex-1">
				<div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
					@input.Input(input.Props{
						Name:        "from_name",
						Placeholder: "Display name",
						Class:       "compose-input h-8",
						Attributes:  templ.Attributes{"aria-label": "Display name", "autocomplete": "off", "data-compose-one-time-name": "", "data-on-input": onAction("changeComposeOneTimeFrom", actionElement)},
					})
					@input.Input(input.Props{
						Name:        "from_email",
						Type:        input.TypeEmail,
						Placeholder: "Email address",
						Class:       "compose-input h-8",
						Attributes:  templ.Attributes{"aria-label": "Email address", "autocomplete": "off", "spellcheck": "false", "data-compose-one-time-email": "", "data-on-input": onAction("changeComposeOneTimeFrom", actionElement), "data-on-blur": onAction("checkComposeOneTimeFrom", actionElement)},
					})
					<div class="flex min-w-0 items-center gap-2 sm:col-span-2">
						<span class="shrink-0 text-xs text-muted-foreground">Send via</span>
						@selectbox.SelectBox(selectbox.Props{Class: "min-w-0 flex-1", Attributes: templ.Attributes{"data-compose-send-via": ""}}) {
							@selectbox.Trigger(selectbox.TriggerProps{Class: "h-8 text-[13px]", DisableClear: true, Required: true}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose a server", Class: "truncate"})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
								for i, acc := range accounts {
									@selectbox.Group() {
										@selectbox.Label(selectbox.LabelProps{Class: "flex items-center gap-1.5 px-2 pt-1.5 pb-0.5 text-[11px] font-medium text-muted-foreground"}) {
											<div class="account-color-marker size-2 shrink-0" style={ accountColorStyle(acc.Color) }></div>
											<span class="truncate">{ contactSidebarAccountName(acc) }</span>
										}
										for _, route := range composeFromRoutes(acc) {
											@selectbox.Item(selectbox.ItemProps{
												Value:    route.Key,
												Disabled: route.Reason != "",
												Class:    "text-[13px]",
												Attributes: templ.Attributes{
													"data-account-id":      route.AccountID,
													"data-identity-id":     route.IdentityID,
													"data-from-kind":       composeFromKindName(route.Rule.Kind),
													"data-from-domains":    route.Domains(),
													"data-from-note":       route.Note,
													"data-from-warns":      fmt.Sprintf("%t", route.Warns()),
												},
											}) {
												{ route.Label }
												<span class="opacity-60">
													· 
													if route.Reason != "" {
														{ route.Reason }
													} else {
														{ route.Detail }
													}
												</span>
											}
										}
									}
									if i < len(accounts)-1 {
										<div class="my-1 h-px bg-border"></div>
									}
								}
							}
						}
					</div>
				</div>
				<p class="hidden mt-1.5 text-xs leading-snug" data-compose-one-time-note></p>
				</div>
			</div>
		</div>
	}
}

// composeFromAddressText shows a From choice as its name with the address
// after it, quieter; an address alone when there is no name.
templ composeFromAddressText(name, email string) {
	<span class="min-w-0 truncate select-item-text">
		if strings.TrimSpace(name) != "" {
			{ name }
			<span class="opacity-60">{ email }</span>
		} else {
			{ email }
		}
	</span>
}

templ ComposePane(accounts []models.Account) {
	{{ accounts = mailAccounts(accounts) }}
	<div class="flex flex-col h-full p-2" data-compose-pane>
		<div class="surface-paper rounded-md flex flex-col h-full overflow-hidden">
			<div class="flex items-center justify-between px-6 py-2.5">
				<div class="flex items-center gap-2">
					<h2 class="font-semibold text-sm" data-compose-title>New message</h2>
				</div>
				<div class="flex items-center gap-1" id="compose-pane-size-buttons">
					@popover.Root(popover.RootProps{ID: "compose-pane-close-choice-popover"}) {
						@popover.Trigger(popover.TriggerProps{TriggerType: popover.TriggerTypeManual}) {
							<button type="button" data-on-click='["discardComposePane","$this"]' class="flex items-center justify-center size-8 rounded text-muted-foreground hover:text-destructive hover:bg-destructive/5 transition-colors" aria-label="Discard draft" title="Discard draft">
								@icon.Trash2(icon.Props{Class: "size-4"})
							</button>
						}
						@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, ShowArrow: true, Class: "w-[28rem] p-4"}) {
							<div class="compose-close-choice" data-compose-close-choice>
								<h2>Close compose?</h2>
								<p>Keep this message as a draft, discard it permanently, or continue editing.</p>
								<div class="compose-close-choice-actions compose-close-choice-actions-nowrap">
									<button type="button" class="compose-close-choice-primary" data-compose-close-action="keep">Exit and keep draft</button>
									<button type="button" data-compose-close-action="discard">Exit and discard</button>
									<button type="button" data-compose-close-action="cancel">Cancel</button>
								</div>
							</div>
						}
					}
					<span id="pane-btns-normal" class="flex items-center gap-1">
						<button type="button" data-on-click='["expandComposeFullWidth"]' class="flex items-center justify-center size-8 rounded text-muted-foreground hover:text-ink hover:bg-ink/5 transition-colors" title="Full width">
							@icon.UnfoldHorizontal(icon.Props{Class: "size-4 compose-pane-size-icon transition-transform"})
						</button>
						<button type="button" data-on-click='["collapseToDialog"]' class="flex items-center justify-center size-8 rounded text-muted-foreground hover:text-ink hover:bg-ink/5 transition-colors" title="Compose in dialog">
							@icon.SquareArrowOutUpLeft(icon.Props{Class: "size-4"})
						</button>
					</span>
					<span id="pane-btns-full" class="flex items-center gap-1" style="display:none">
						<button type="button" data-on-click='["collapseComposeFullWidth"]' class="flex items-center justify-center size-8 rounded text-muted-foreground hover:text-ink hover:bg-ink/5 transition-colors" title="Normal width">
							@icon.FoldHorizontal(icon.Props{Class: "size-4 compose-pane-size-icon transition-transform"})
						</button>
						<button type="button" data-on-click='["collapseToDialog"]' class="flex items-center justify-center size-8 rounded text-muted-foreground hover:text-ink hover:bg-ink/5 transition-colors" title="Compose in dialog">
							@icon.SquareArrowOutUpLeft(icon.Props{Class: "size-4"})
						</button>
					</span>
				</div>
			</div>
			<div class="h-px bg-gradient-to-r from-transparent via-amber-900/10 to-transparent"></div>
			<div class="flex-1 overflow-y-auto">
				<div id="compose-pane-content" class="mx-auto flex h-full flex-col px-8 py-4">
					<div id="compose-pane-form" class="flex flex-1 min-h-0 flex-col gap-3">
						@ComposeDropChoice("compose-pane-drop-choice")
						<input type="hidden" name="account_id" id="compose-pane-account-id" value={ composeDefaultAccountID(accounts) }/>
						<input type="hidden" name="identity_id" id="compose-pane-identity-id" value=""/>
						<input type="hidden" name="draft_id" id="compose-pane-draft-id" value=""/>
						<input type="hidden" name="compose_mode" id="compose-pane-mode" value="new"/>
						<input type="hidden" name="in_reply_to" id="compose-pane-in-reply-to" value=""/>
						<input type="hidden" name="references" id="compose-pane-references" value=""/>
					<div class="space-y-1">
						<div class="flex items-center gap-2" data-compose-from-row>
							<label class="text-xs text-muted-foreground font-medium w-8 shrink-0">From</label>
							@dropdown.Dropdown() {
								@dropdown.Trigger() {
									<button type="button" id="compose-pane-from-trigger" class="compose-from-trigger flex items-center gap-1 text-sm text-foreground transition-colors px-1.5 py-0.5 rounded focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background">
										<span id="compose-pane-from-display">{ composeDefaultName(accounts) } &lt;{ composeDefaultEmail(accounts) }&gt;</span>
										@icon.ChevronDown(icon.Props{Class: "size-3 text-muted-foreground"})
									</button>
								}
								@dropdown.Content(dropdown.ContentProps{Class: "compose-from-menu max-h-[60vh] normal-case tracking-normal"}) {
									@composeFromMenuItems(accounts, "pane")
								}
							}
						</div>
						@composeOneTimeFromRow(accounts, "pane")
						@ComposeField("To", "to", "recipient@example.com")
						<div id="pane-cc-field" class="hidden">
							@ComposeField("Cc", "cc", "")
						</div>
						<div id="pane-bcc-field" class="hidden">
							@ComposeField("Bcc", "bcc", "")
						</div>
							<div id="pane-cc-bcc-buttons" class="flex items-center gap-2 pt-1">
								<button
									id="pane-cc-btn"
									type="button"
									class="text-[11px] text-muted-foreground hover:text-foreground transition-colors px-1.5 py-0.5 rounded hover:bg-accent"
									data-on-click='["goferShowComposeRecipientField","pane-cc-field","pane-cc-btn"]'
								>Cc</button>
								<button
									id="pane-bcc-btn"
									type="button"
									class="text-[11px] text-muted-foreground hover:text-foreground transition-colors px-1.5 py-0.5 rounded hover:bg-accent"
									data-on-click='["goferShowComposeRecipientField","pane-bcc-field","pane-bcc-btn"]'
								>Bcc</button>
							</div>
						</div>
					<div class="border-t pt-2">
						@input.Input(input.Props{
							Name:        "subject",
							Placeholder: "Subject",
							Class:       "compose-input h-8 font-semibold placeholder:font-normal",
						})
					</div>
					@ComposeToolbar()
					@ComposeRichEditor()
					@ComposeAttachments()
					</div>
				</div>
			</div>
			<div class="px-6 py-3 border-t border-ink/6">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-2 min-w-0">
						<button type="button" data-on-click='["saveComposeDraft",true,false]' class="inline-flex min-w-28 items-center justify-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-all duration-200 px-3 py-1.5 rounded-md border border-border hover:bg-accent" data-compose-draft-button data-compose-draft-state="default">
							<span class="inline-flex transition-transform duration-200" data-compose-draft-icon>
								@icon.Save(icon.Props{Class: "size-3.5"})
							</span>
							<span data-compose-draft-label>Save Draft</span>
						</button>
					</div>
						<div class="flex items-center gap-2">
							@ComposeSchedulePopover(true, "inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-lg border border-border text-muted-foreground hover:text-ink hover:bg-ink/5 transition-colors")
							<button type="button"
								class="btn-skeuo inline-flex items-center gap-1.5 text-sm font-semibold px-4 py-1.5 rounded-lg"
								id="compose-pane-send-btn"
								data-on-click='["sendCompose",true]'
							>
								@icon.Send(icon.Props{Class: "size-3.5"})
								Send
							</button>
						</div>
				</div>
			</div>
		</div>
	</div>
}
