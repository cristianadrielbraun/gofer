func contactSourceLabel(ctx context.Context, source string, isManual bool, accounts []models.Account) string {
	if isManual {
		return i18n.T(ctx, "contacts.origin.manual")
	}
	if strings.HasPrefix(source, "synced:") {
		accountID := strings.TrimPrefix(source, "synced:")
		for _, account := range accounts {
			if account.ID == accountID {
				return i18n.T(ctx, "contacts.origin.imported_from", "source", accountContactOriginLabel(ctx, account))
			}
		}
		return i18n.T(ctx, "contacts.origin.imported_account")
	}
	if bookID, ok := strings.CutPrefix(source, "book:"); ok {
		for _, account := range accounts {
			for _, book := range account.ContactAddressBooks {
				if book.ID == bookID {
					return i18n.T(ctx, "contacts.origin.imported_from", "source", accountContactOriginLabel(ctx, account)+" / "+contactAddressBookDisplayName(ctx, book))
				}
			}
		}
		return i18n.T(ctx, "contacts.origin.imported_book")
	}
	switch source {
	case "observed":
		return i18n.T(ctx, "contacts.origin.observed")
	case "manual":
		return i18n.T(ctx, "contacts.origin.manual")
	case "synced":
		return i18n.T(ctx, "contacts.origin.imported_any")
	case "provider:gmail":
		return i18n.T(ctx, "contacts.origin.imported_from", "source", "Gmail")
	case "provider:outlook":
		return i18n.T(ctx, "contacts.origin.imported_from", "source", "Outlook")
	default:
		if source == "" {
			return i18n.T(ctx, "contacts.origin.local")
		}
		return strings.Title(source)
	}
}

func contactSaveTargetValue(account models.Account) string {
	return "account:" + account.ID
}

func contactBookTargetValue(book models.ContactAddressBook) string {
	return "book:" + book.ID
}

func accountContactSyncCapable(account models.Account) bool {
	return account.ContactSyncEnabled
}

func contactSaveTargetSelected(contact *models.Contact, target string) bool {
	if contact == nil || len(contact.SaveTargets) == 0 {
		return target == "local"
	}
	for _, selected := range contact.SaveTargets {
		if selected == target {
			return true
		}
	}
	return false
}

func accountContactSaveLabel(account models.Account) string {
	name := strings.TrimSpace(account.Name)
	email := strings.TrimSpace(account.Email)
	if name == "" {
		return email
	}
	if email == "" || strings.EqualFold(name, email) {
		return name
	}
	return fmt.Sprintf("%s <%s>", name, email)
}

func accountContactOriginLabel(ctx context.Context, account models.Account) string {
	name := strings.TrimSpace(account.Name)
	if name != "" {
		return name
	}
	if email := strings.TrimSpace(account.Email); email != "" {
		return email
	}
	return i18n.T(ctx, "contacts.origin.account")
}

func contactViewMode(mode string) string {
	if mode == "table" {
		return "table"
	}
	return "cards"
}

func contactViewIndicatorStyle(mode string) string {
	if contactViewMode(mode) == "table" {
		return "transform:translateX(100%)"
	}
	return "transform:translateX(0)"
}

// contactFiltersActiveCount is how many filters the Filters button counts.
func contactFiltersActiveCount(filters models.ContactFilters) int {
	count := 0
	for _, value := range []string{filters.Source, filters.StoredIn, filters.SaveTarget, filters.Activity} {
		if value != "" {
			count++
		}
	}
	return count
}

// contactAccountMarker is an account a contact syncs with: its name and
// color, and a title naming its address books too.
type contactAccountMarker struct {
	Name  string
	Color string
	Title string
}

// contactAccountMarkers gives one marker per account a contact syncs with,
// in the order its address books come, or for a contact imported from an
// account, that account's.
func contactAccountMarkers(ctx context.Context, contact models.Contact, accounts []models.Account) []contactAccountMarker {
	byID := make(map[string]models.Account, len(accounts))
	for _, account := range accounts {
		byID[account.ID] = account
	}
	var order []string
	books := make(map[string][]string)
	for _, book := range contact.SourceBooks {
		if _, known := byID[book.AccountID]; !known {
			continue
		}
		if _, seen := books[book.AccountID]; !seen {
			order = append(order, book.AccountID)
		}
		books[book.AccountID] = append(books[book.AccountID], contactAddressBookDisplayName(ctx, book))
	}
	if accountID, ok := strings.CutPrefix(contact.Source, "synced:"); ok && len(order) == 0 {
		if _, known := byID[accountID]; known {
			order = append(order, accountID)
		}
	}
	markers := make([]contactAccountMarker, 0, len(order))
	for _, id := range order {
		account := byID[id]
		title := accountContactOriginLabel(ctx, account)
		if names := books[id]; len(names) > 0 {
			title += " / " + strings.Join(names, ", ")
		}
		markers = append(markers, contactAccountMarker{Name: accountContactOriginLabel(ctx, account), Color: account.Color, Title: title})
	}
	return markers
}

// contactOrigin is where a contact card says the contact comes from.
type contactOrigin struct {
	Label string
	Title string
	// Color is the account's, for a contact one of them holds.
	Color string
}

// contactCardOrigin names the account a contact belongs to, the first and how
// many more when it is in several, or else how it got into Gofer: observed
// in mail, added by hand.
func contactCardOrigin(ctx context.Context, contact models.Contact, accounts []models.Account) contactOrigin {
	if markers := contactAccountMarkers(ctx, contact, accounts); len(markers) > 0 {
		origin := contactOrigin{Label: markers[0].Name, Color: markers[0].Color}
		titles := make([]string, 0, len(markers))
		for _, marker := range markers {
			titles = append(titles, marker.Title)
		}
		if len(markers) > 1 {
			origin.Label += fmt.Sprintf(" +%d", len(markers)-1)
		}
		origin.Title = strings.Join(titles, "\n")
		return origin
	}
	label := contactSourceLabel(ctx, contact.Source, contact.IsManual, accounts)
	title := label
	switch {
	case contact.IsManual || contact.Source == "manual":
		title = i18n.T(ctx, "contacts.origin.manual_title")
	case contact.Source == "observed":
		title = i18n.T(ctx, "contacts.origin.observed_title")
	}
	return contactOrigin{Label: label, Title: title}
}

// contactCardDate is the date a contact card shows: when the contact was last
// seen in mail, or else when it was added, with what it means.
func contactCardDate(ctx context.Context, contact models.Contact) (string, string) {
	if trashed := strings.TrimSpace(contact.TrashedAt); trashed != "" {
		return trashed, i18n.T(ctx, "contacts.card.trashed", "date", trashed, "purge", contact.TrashPurgeAt)
	}
	if seen := strings.TrimSpace(contact.LastSeenAt); seen != "" {
		return seen, i18n.T(ctx, "contacts.card.last_seen", "date", seen)
	}
	if added := strings.TrimSpace(contact.CreatedAt); added != "" {
		return added, i18n.T(ctx, "contacts.card.added", "date", added)
	}
	return "", ""
}

func contactMessageCountTitle(ctx context.Context, count int) string {
	return i18n.N(ctx, "contacts.card.messages", count)
}

func contactFiltersActive(filters models.ContactFilters) bool {
	return filters.Source != "" || filters.StoredIn != "" || filters.SaveTarget != "" || filters.Activity != ""
}

func contactFilterCount(filters models.ContactFilters) int {
	count := 0
	if filters.Source != "" {
		count++
	}
	if filters.StoredIn != "" {
		count++
	}
	if filters.SaveTarget != "" {
		count++
	}
	if filters.Activity != "" {
		count++
	}
	return count
}

func contactFilterValues(filters models.ContactFilters) url.Values {
	values := url.Values{}
	if filters.Trash {
		values.Set("trash", "1")
	}
	if strings.TrimSpace(filters.Query) != "" {
		values.Set("q", strings.TrimSpace(filters.Query))
	}
	if filters.Source != "" {
		values.Set("source", filters.Source)
	}
	if filters.StoredIn != "" {
		values.Set("stored_in", filters.StoredIn)
	}
	if filters.SaveTarget != "" {
		values.Set("save_target", filters.SaveTarget)
	}
	if filters.Activity != "" {
		values.Set("activity", filters.Activity)
	}
	if contactViewMode(filters.View) != "cards" {
		values.Set("view", contactViewMode(filters.View))
	}
	if filters.SortBy != "" && filters.SortBy != "updated" {
		values.Set("sort_by", filters.SortBy)
	}
	if filters.SortOrder == "asc" {
		values.Set("sort_order", "asc")
	}
	return values
}

func contactSortLabel(ctx context.Context, filters models.ContactFilters) string {
	switch filters.SortBy {
	case "name":
		return i18n.T(ctx, "contacts.sort.name")
	case "last_interaction":
		return i18n.T(ctx, "contacts.sort.last_interaction")
	default:
		return i18n.T(ctx, "contacts.sort.updated")
	}
}

func contactsViewURL(filters models.ContactFilters, mode string) string {
	filters.View = contactViewMode(mode)
	return contactsURL(filters, "")
}

func contactsURL(filters models.ContactFilters, contactID string) string {
	values := contactFilterValues(filters)
	if contactID != "" {
		values.Set("contact", contactID)
	}
	if encoded := values.Encode(); encoded != "" {
		return "/contacts?" + encoded
	}
	return "/contacts"
}

func contactsDetailURL(filters models.ContactFilters, contactID string) string {
	values := contactFilterValues(filters)
	values.Set("contact", contactID)
	values.Set("partial", "detail")
	return "/contacts?" + values.Encode()
}

func contactListTableGridStyle() string {
	return "--mail-list-table-columns:minmax(10rem,1.4fr) minmax(8rem,0.9fr) minmax(3.5rem,auto)"
}

func contactWindowEnd(start int, count int) int {
	if count <= 0 {
		return start - 1
	}
	return start + count - 1
}

func contactActivityHref(email models.Email) string {
	if email.FolderID == "" || email.ID == "" {
		return "#"
	}
	return "/folder/" + url.PathEscape(email.FolderID) + "/" + url.PathEscape(email.ID)
}

func contactActivityDirection(ctx context.Context, contact models.Contact, email models.Email) string {
	if strings.EqualFold(strings.TrimSpace(contact.Email), strings.TrimSpace(email.From.Email)) {
		return i18n.T(ctx, "mail.column.from")
	}
	return i18n.T(ctx, "mail.column.to")
}

func contactActivitySubject(ctx context.Context, email models.Email) string {
	if strings.TrimSpace(email.Subject) == "" {
		return i18n.T(ctx, "contacts.activity.no_subject")
	}
	return i18n.Subject(ctx, email.Subject)
}

func contactSaveTargetLabel(ctx context.Context, target string, accounts []models.Account) string {
	switch target {
	case "local":
		return i18n.T(ctx, "contacts.origin.local")
	case "":
		return i18n.T(ctx, "contacts.filters.any_location")
	}
	for _, account := range accounts {
		if target == contactSaveTargetValue(account) {
			return accountContactSaveLabel(account)
		}
		for _, book := range account.ContactAddressBooks {
			if target == contactBookTargetValue(book) {
				return accountContactOriginLabel(ctx, account) + " / " + contactAddressBookDisplayName(ctx, book)
			}
		}
	}
	return i18n.T(ctx, "contacts.origin.unavailable_account")
}

func contactAddressBookDisplayName(ctx context.Context, book models.ContactAddressBook) string {
	if strings.TrimSpace(book.Name) != "" {
		return strings.TrimSpace(book.Name)
	}
	return i18n.T(ctx, "contacts.address_book")
}

// contactOriginFilterLabel names an origin in the filter menu and pill. They
// already say "Origin", so accounts and books go without "Imported from".
func contactOriginFilterLabel(ctx context.Context, source string, accounts []models.Account) string {
	if source == "synced" {
		return i18n.T(ctx, "mail.filters.any_account")
	}
	if accountID, ok := strings.CutPrefix(source, "synced:"); ok {
		for _, account := range accounts {
			if account.ID == accountID {
				return accountContactOriginLabel(ctx, account)
			}
		}
		return i18n.T(ctx, "contacts.origin.unknown_account")
	}
	if bookID, ok := strings.CutPrefix(source, "book:"); ok {
		for _, account := range accounts {
			for _, book := range account.ContactAddressBooks {
				if book.ID == bookID {
					return accountContactOriginLabel(ctx, account) + " / " + contactAddressBookDisplayName(ctx, book)
				}
			}
		}
		return i18n.T(ctx, "contacts.origin.unknown_book")
	}
	return contactSourceLabel(ctx, source, source == "manual", accounts)
}

func contactSyncStatusLabel(ctx context.Context, status string) string {
	switch status {
	case "pending":
		return i18n.T(ctx, "contacts.sync.status.pending")
	case "running":
		return i18n.T(ctx, "contacts.sync.status.running")
	case "error":
		return i18n.T(ctx, "contacts.sync.status.error")
	case "done":
		return i18n.T(ctx, "contacts.sync.status.done")
	default:
		return ""
	}
}

func contactSyncStatusClass(status string) string {
	switch status {
	case "pending", "running":
		return "border-amber-500/20 bg-amber-500/10 text-amber-700 dark:text-amber-200"
	case "error":
		return "border-destructive/20 bg-destructive/10 text-destructive"
	case "done":
		return "border-emerald-500/20 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300"
	default:
		return "border-ink/10 bg-ink/[0.04] text-muted-foreground"
	}
}

func contactCardKindLabel(ctx context.Context, card models.ContactCard) string {
	switch card.Kind {
	case "local":
		return i18n.T(ctx, "contacts.card_kind.local")
	case "observed":
		return i18n.T(ctx, "contacts.card_kind.observed")
	case "provider":
		if card.Provider != "" {
			return i18n.T(ctx, "contacts.card_kind.provider_named", "provider", strings.Title(card.Provider))
		}
		return i18n.T(ctx, "contacts.card_kind.provider")
	case "target":
		return i18n.T(ctx, "contacts.card_kind.target")
	default:
		if card.Kind == "" {
			return i18n.T(ctx, "contacts.card_kind.card")
		}
		return strings.Title(card.Kind)
	}
}

func contactCardAccountLabel(ctx context.Context, card models.ContactCard, accounts []models.Account) string {
	for _, account := range accounts {
		if account.ID == card.AccountID {
			label := accountContactSaveLabel(account)
			if card.AddressBookID != "" {
				for _, book := range account.ContactAddressBooks {
					if book.ID == card.AddressBookID {
						return label + " / " + contactAddressBookDisplayName(ctx, book)
					}
				}
			}
			return label
		}
		for _, book := range account.ContactAddressBooks {
			if book.ID == card.AddressBookID {
				return accountContactOriginLabel(ctx, account) + " / " + contactAddressBookDisplayName(ctx, book)
			}
		}
	}
	if card.AccountID != "" {
		return i18n.T(ctx, "contacts.card_account.account", "id", card.AccountID)
	}
	if card.AddressBookID != "" {
		return i18n.T(ctx, "contacts.card_account.book", "id", card.AddressBookID)
	}
	return "Gofer"
}

func contactFieldKindLabel(ctx context.Context, kind string) string {
	switch strings.ToLower(strings.TrimSpace(kind)) {
	case "name":
		return i18n.T(ctx, "contacts.field.name")
	case "email":
		return i18n.T(ctx, "contacts.field.email")
	case "phone":
		return i18n.T(ctx, "contacts.field.phone")
	case "organization":
		return i18n.T(ctx, "contacts.field.organization")
	case "title":
		return i18n.T(ctx, "contacts.field.title")
	case "notes":
		return i18n.T(ctx, "contacts.field.notes")
	default:
		if kind == "" {
			return i18n.T(ctx, "contacts.field.field")
		}
		return strings.Title(kind)
	}
}

func contactFieldSourceLabel(ctx context.Context, source string) string {
	source = strings.TrimSpace(source)
	switch {
	case source == "manual":
		return i18n.T(ctx, "contacts.origin.manual")
	case source == "observed":
		return i18n.T(ctx, "contacts.origin.observed")
	case strings.HasPrefix(source, "synced:"):
		return i18n.T(ctx, "contacts.origin.synced")
	case source == "":
		return i18n.T(ctx, "contacts.origin.unknown")
	default:
		return strings.Title(source)
	}
}

func contactProfileValueFields(fields []models.ContactField) []models.ContactField {
	values := make([]models.ContactField, 0, len(fields))
	for _, field := range fields {
		kind := strings.ToLower(strings.TrimSpace(field.Kind))
		if (kind == "name" || kind == "email" || kind == "phone" || kind == "organization" || kind == "title" || kind == "notes") && strings.TrimSpace(field.Value) != "" {
			values = append(values, field)
		}
	}
	return values
}

func contactProfileResolverFields(fields []models.ContactField) []models.ContactField {
	valueFields := contactProfileValueFields(fields)
	valuesByKind := map[string]map[string]bool{}
	for _, field := range valueFields {
		kind := strings.ToLower(strings.TrimSpace(field.Kind))
		value := strings.ToLower(strings.TrimSpace(field.NormalizedValue))
		if value == "" {
			value = strings.ToLower(strings.TrimSpace(field.Value))
		}
		if value == "" {
			continue
		}
		if valuesByKind[kind] == nil {
			valuesByKind[kind] = map[string]bool{}
		}
		valuesByKind[kind][value] = true
	}
	needsChoice := map[string]bool{}
	for kind, values := range valuesByKind {
		if len(values) > 1 {
			needsChoice[kind] = true
		}
	}
	if len(needsChoice) == 0 {
		return nil
	}
	out := make([]models.ContactField, 0, len(valueFields))
	for _, field := range valueFields {
		if needsChoice[strings.ToLower(strings.TrimSpace(field.Kind))] {
			out = append(out, field)
		}
	}
	return out
}

func contactProfileResolverFieldKind(field models.ContactField) string {
	kind := strings.ToLower(strings.TrimSpace(field.Kind))
	if kind == "" {
		return "field"
	}
	return kind
}

func contactProfileResolverKinds(fields []models.ContactField) []string {
	kinds := []string{}
	seen := map[string]bool{}
	for _, wanted := range []string{"name", "email", "phone", "organization", "title", "notes"} {
		for _, field := range fields {
			if contactProfileResolverFieldKind(field) == wanted {
				kinds = append(kinds, wanted)
				seen[wanted] = true
				break
			}
		}
	}
	for _, field := range fields {
		kind := contactProfileResolverFieldKind(field)
		if seen[kind] {
			continue
		}
		seen[kind] = true
		kinds = append(kinds, kind)
	}
	return kinds
}

func contactProfileResolverFieldsForKind(fields []models.ContactField, kind string) []models.ContactField {
	kind = strings.ToLower(strings.TrimSpace(kind))
	out := []models.ContactField{}
	for _, field := range fields {
		if contactProfileResolverFieldKind(field) == kind {
			out = append(out, field)
		}
	}
	return out
}

func contactUnifiedStatusLabel(ctx context.Context, profile models.ContactProfile) string {
	return contactProfileSyncLabel(ctx, &profile)
}

func contactSyncMembershipLabel(ctx context.Context, membership models.ContactSyncMembership, accounts []models.Account) string {
	if membership.AddressBookID != "" { return contactSaveTargetLabel(ctx, "book:"+membership.AddressBookID, accounts) }
	return contactSaveTargetLabel(ctx, "account:"+membership.AccountID, accounts)
}

func contactEditorStatusLabel(ctx context.Context, contact *models.Contact, profile *models.ContactProfile, accounts []models.Account) string {
	if profile != nil {
		return contactUnifiedStatusLabel(ctx, *profile)
	}
	if contact == nil {
		return i18n.T(ctx, "contacts.origin.local")
	}
	if len(contact.SourceBooks) > 0 {
		return i18n.N(ctx, "contacts.origin.books", len(contact.SourceBooks))
	}
	return contactSourceLabel(ctx, contact.Source, contact.IsManual, accounts)
}

func contactProfileUserInsights(insights []models.ContactInsight) []models.ContactInsight {
	out := make([]models.ContactInsight, 0, len(insights))
	observedOnly := false
	for _, insight := range insights {
		if insight.Kind == "observed_only" {
			observedOnly = true
			break
		}
	}
	for _, insight := range insights {
		if observedOnly && insight.Kind == "provider_only_field" {
			continue
		}
		out = append(out, insight)
	}
	return out
}

func contactInsightDisplayTitle(ctx context.Context, insight models.ContactInsight) string {
	switch insight.Kind {
	case "observed_only":
		return i18n.T(ctx, "contacts.insight.observed_only")
	case "provider_only_field":
		return i18n.T(ctx, "contacts.insight.provider_only")
	case "field_conflict":
		if insight.Field != "" {
			return i18n.T(ctx, "contacts.insight.field_conflict", "field", contactFieldKindLabel(ctx, insight.Field))
		}
		return i18n.T(ctx, "contacts.insight.conflict")
	case "manual_override":
		if insight.Field != "" {
			return i18n.T(ctx, "contacts.insight.field_override", "field", strings.ToLower(contactFieldKindLabel(ctx, insight.Field)))
		}
		return i18n.T(ctx, "contacts.insight.override")
	case "multi_source":
		return i18n.T(ctx, "contacts.insight.multi_source")
	default:
		return insight.Title
	}
}

func contactInsightDisplayMessage(ctx context.Context, insight models.ContactInsight) string {
	switch insight.Kind {
	case "observed_only":
		return i18n.T(ctx, "contacts.insight.observed_only_detail")
	case "provider_only_field":
		return i18n.T(ctx, "contacts.insight.provider_only_detail")
	case "field_conflict":
		return i18n.T(ctx, "contacts.insight.conflict_detail")
	case "manual_override":
		return i18n.T(ctx, "contacts.insight.override_detail")
	case "multi_source":
		// Its counts come from the English message storage writes.
		return i18n.Stored(ctx, "contacts.insight.multi_source_detail", insight.Message)
	default:
		return insight.Message
	}
}

func contactFieldDisplayLabel(field models.ContactField) string {
	label := strings.ToLower(strings.TrimSpace(field.Label))
	if label == "" || label == "primary" || label == "alternate" {
		return ""
	}
	if label == "observed" && field.Source == "observed" {
		return ""
	}
	return label
}

func contactFieldSourceDisplay(ctx context.Context, source string, accounts []models.Account) string {
	source = strings.TrimSpace(source)
	switch {
	case source == "manual":
		return ""
	case source == "observed":
		return i18n.T(ctx, "contacts.source.found_in_mail")
	case strings.HasPrefix(source, "synced:"):
		accountID := strings.TrimPrefix(source, "synced:")
		for _, account := range accounts {
			if account.ID == accountID {
				return i18n.T(ctx, "contacts.source.from", "account", accountContactSaveLabel(account))
			}
		}
		return i18n.T(ctx, "contacts.source.from_synced")
	case source == "":
		return ""
	default:
		return strings.Title(source)
	}
}

func contactSourceDescription(ctx context.Context, card models.ContactCard, accounts []models.Account) string {
	switch card.Kind {
	case "observed":
		return i18n.T(ctx, "contacts.source.observed_detail")
	case "local":
		return i18n.T(ctx, "contacts.source.local_detail")
	case "provider":
		return i18n.T(ctx, "contacts.source.provider_detail", "account", contactCardAccountLabel(ctx, card, accounts))
	case "target":
		return contactCardAccountLabel(ctx, card, accounts)
	default:
		return contactCardAccountLabel(ctx, card, accounts)
	}
}

func contactInsightSeverityClass(severity string) string {
	switch severity {
	case "warning":
		return "border-amber-500/25 bg-amber-500/10 text-amber-800 dark:text-amber-200"
	case "notice":
		return "border-sky-500/20 bg-sky-500/10 text-sky-800 dark:text-sky-200"
	default:
		return "border-ink/10 bg-ink/[0.04] text-muted-foreground"
	}
}

templ ContactsPage(contacts []models.Contact, selected *models.Contact, selectedProfile *models.ContactProfile, showNew bool, syncQueued bool, filters models.ContactFilters, totalCount int, uiSettings map[string]string, accounts []models.Account) {
	<div id="main-content" class={ mailPaneLayoutClass(PaneLayout(uiSettings, "contacts")) + " bg-background" } data-mail-pane-layout={ PaneLayout(uiSettings, "contacts") }>
		@ContactsListPane(contacts, selected, filters, totalCount, PanelSetting(uiSettings, "contacts", "mail_list_width", "50%"), accounts)
		@ResizeHandle("maillist")
		@ContactsViewPane(selected, selectedProfile, showNew, syncQueued, accounts)
	</div>
}

templ ContactsListPane(contacts []models.Contact, selected *models.Contact, filters models.ContactFilters, totalCount int, width string, accounts []models.Account) {
	<section id="mail-list" class="w-full lg:flex flex-col border-r border-border bg-card h-full overflow-hidden" style={ "width:" + mailListWidthCSS(width) } data-view-mode={ contactViewMode(filters.View) } data-contact-list-shell data-panel-section="contacts">
		<div class="contacts-list-header px-4 py-4 space-y-3">
			<div class="contacts-list-title-row flex items-center justify-between">
				<div class="flex items-center gap-2">
					<h2 class="text-lg font-bold tracking-tight" style="font-family: var(--font-serif)" data-contacts-title>
						if filters.Trash {
							{ i18n.T(ctx, "folder.trash") }
						} else {
							{ i18n.T(ctx, "contacts.title") }
						}
					</h2>
					<span id="contacts-count" class="inline-flex h-5 min-w-10 items-center justify-center rounded-md bg-muted px-2 text-xs font-medium text-muted-foreground shadow-[0_1px_2px_rgba(0,0,0,0.06)]">{ fmt.Sprintf("%d", totalCount) }</span>
				</div>
				if filters.Trash {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeSm,
						Class:      "h-7 gap-1.5 px-2.5 text-xs " + menuDestructiveClass,
						Disabled:   totalCount == 0,
						Attributes: templ.Attributes{"data-contacts-empty-trash": ""},
					}) {
						@icon.Trash2(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "contacts.trash.empty") }
					}
				}
			</div>
			if filters.Trash {
				<p class="px-1 text-xs text-muted-foreground" data-contacts-trash-note>
					{ i18n.T(ctx, "contacts.trash.note", "days", models.ContactTrashRetentionDays) }
				</p>
			}
			<div>
			<div class="contacts-search-row flex items-center gap-2">
				<button type="button" class="mail-list-search-close hidden" data-mail-search-close aria-label={ i18n.T(ctx, "mail.search.close") }>
					@icon.ArrowLeft(icon.Props{Class: "size-5"})
				</button>
				<form action="/contacts" method="get" class="relative groove rounded-lg flex-1 min-w-0" data-contact-search-form>
					if filters.Trash {
						<input type="hidden" name="trash" value="1"/>
					}
					<input type="hidden" name="source" value={ filters.Source }/>
					<input type="hidden" name="stored_in" value={ filters.StoredIn }/>
					<input type="hidden" name="save_target" value={ filters.SaveTarget }/>
					<input type="hidden" name="activity" value={ filters.Activity }/>
					<input type="hidden" name="view" value={ contactViewMode(filters.View) }/>
					<input type="hidden" name="sort_by" value={ filters.SortBy }/>
					<input type="hidden" name="sort_order" value={ filters.SortOrder }/>
					@icon.Search(icon.Props{Class: "pointer-events-none absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground"})
					<input
						type="search"
						name="q"
						value={ filters.Query }
						placeholder={ i18n.T(ctx, "contacts.search") }
						data-contact-search-input
						class="h-9 w-full rounded-lg border border-border/50 bg-background pl-8 pr-3 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring"
					/>
				</form>
				// Beside the search, as the mail list's Filters.
				<div class="mail-list-search-actions">
					@dropdown.Dropdown() {
						@dropdown.Trigger() {
							@button.Button(button.Props{Variant: button.VariantOutline, Class: mailListFilterButtonClass, Attributes: templ.Attributes{"data-contact-filter-trigger": "", "data-active": fmt.Sprintf("%t", contactFiltersActive(filters)), "aria-label": i18n.T(ctx, "contacts.filters.label")}}) {
								<span class="mail-list-filter-label">{ i18n.T(ctx, "mail.filters.title") }</span>
								@icon.SlidersHorizontal(icon.Props{Class: "size-3.5"})
								if count := contactFiltersActiveCount(filters); count > 0 {
									<span class="min-w-4 rounded-full bg-primary px-1 text-center text-[10px] leading-4 text-primary-foreground">{ fmt.Sprint(count) }</span>
								}
							}
						}
						@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "mobile-sheet w-[26rem] max-w-[calc(100vw-2rem)] max-h-none normal-case tracking-normal p-3"}) {
							<form action="/contacts" method="get" class="space-y-3" data-contact-filter-form>
								if filters.Trash {
									<input type="hidden" name="trash" value="1"/>
								}
								<input type="hidden" name="q" value={ filters.Query }/>
								<input type="hidden" name="view" value={ contactViewMode(filters.View) }/>
								<input type="hidden" name="sort_by" value={ filters.SortBy }/>
								<input type="hidden" name="sort_order" value={ filters.SortOrder }/>
								<div class="flex items-center justify-end gap-2">
									<a href={ contactsURL(models.ContactFilters{Trash: filters.Trash, Query: filters.Query, View: filters.View, SortBy: filters.SortBy, SortOrder: filters.SortOrder}, "") } class="text-[11px] font-medium text-muted-foreground hover:text-foreground" data-contact-filter-clear>{ i18n.T(ctx, "common.clear") }</a>
								</div>
								<div class="space-y-1 text-[11px] font-medium text-muted-foreground">
									<span>{ i18n.T(ctx, "contacts.stored_in") }</span>
									@selectbox.SelectBox(selectbox.Props{Multiple: true}) {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "stored_in", Class: "h-8 bg-background text-xs", Multiple: true, ShowPills: true, DisableClear: true, SelectedCountText: i18n.T(ctx, "contacts.filters.selected_count")}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "contacts.filters.anywhere"), Multiple: true, Class: "text-left"})
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "local", Selected: models.ContactFilterHas(filters.StoredIn, "local")}) {
												{ i18n.T(ctx, "contacts.origin.local") }
											}
											for _, account := range accounts {
												if !account.IsDeleting && accountContactSyncCapable(account) {
													@selectbox.Item(selectbox.ItemProps{Value: contactSaveTargetValue(account), Selected: models.ContactFilterHas(filters.StoredIn, contactSaveTargetValue(account))}) {
														{ accountContactSaveLabel(account) }
													}
													for _, book := range account.ContactAddressBooks {
														@selectbox.Item(selectbox.ItemProps{Value: contactBookTargetValue(book), Selected: models.ContactFilterHas(filters.StoredIn, contactBookTargetValue(book))}) {
															{ accountContactOriginLabel(ctx, account) } / { contactAddressBookDisplayName(ctx, book) }
														}
													}
												}
											}
										}
									}
								</div>
								<div class="space-y-1 text-[11px] font-medium text-muted-foreground">
									<span>{ i18n.T(ctx, "contacts.filters.origin") }</span>
									@selectbox.SelectBox(selectbox.Props{Multiple: true}) {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "source", Class: "h-8 bg-background text-xs", Multiple: true, ShowPills: true, DisableClear: true, SelectedCountText: i18n.T(ctx, "contacts.filters.selected_count")}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "contacts.filters.any_origin"), Multiple: true, Class: "text-left"})
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "manual", Selected: models.ContactFilterHas(filters.Source, "manual")}) {
												{ i18n.T(ctx, "contacts.origin.manual") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "observed", Selected: models.ContactFilterHas(filters.Source, "observed")}) {
												{ i18n.T(ctx, "contacts.origin.observed") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "synced", Selected: models.ContactFilterHas(filters.Source, "synced")}) {
												{ contactOriginFilterLabel(ctx, "synced", accounts) }
											}
											for _, account := range accounts {
												if !account.IsDeleting && accountContactSyncCapable(account) {
													@selectbox.Item(selectbox.ItemProps{Value: "synced:" + account.ID, Selected: models.ContactFilterHas(filters.Source, "synced:"+account.ID)}) {
														{ contactOriginFilterLabel(ctx, "synced:"+account.ID, accounts) }
													}
													for _, book := range account.ContactAddressBooks {
														@selectbox.Item(selectbox.ItemProps{Value: "book:" + book.ID, Selected: models.ContactFilterHas(filters.Source, "book:"+book.ID)}) {
															{ contactOriginFilterLabel(ctx, "book:"+book.ID, accounts) }
														}
													}
												}
											}
										}
									}
								</div>
								<div class="space-y-1 text-[11px] font-medium text-muted-foreground">
									<span>{ i18n.T(ctx, "contacts.sync.locations") }</span>
									@selectbox.SelectBox(selectbox.Props{Multiple: true}) {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "save_target", Class: "h-8 bg-background text-xs", Multiple: true, ShowPills: true, DisableClear: true, SelectedCountText: i18n.T(ctx, "contacts.filters.selected_count")}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "contacts.filters.any_location"), Multiple: true, Class: "text-left"})
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "local", Selected: models.ContactFilterHas(filters.SaveTarget, "local")}) {
												{ i18n.T(ctx, "contacts.origin.local") }
											}
											for _, account := range accounts {
												if !account.IsDeleting && accountContactSyncCapable(account) {
													@selectbox.Item(selectbox.ItemProps{Value: contactSaveTargetValue(account), Selected: models.ContactFilterHas(filters.SaveTarget, contactSaveTargetValue(account))}) {
														{ accountContactSaveLabel(account) }
													}
													for _, book := range account.ContactAddressBooks {
														@selectbox.Item(selectbox.ItemProps{Value: contactBookTargetValue(book), Selected: models.ContactFilterHas(filters.SaveTarget, contactBookTargetValue(book))}) {
															{ accountContactOriginLabel(ctx, account) } / { contactAddressBookDisplayName(ctx, book) }
														}
													}
												}
											}
										}
									}
								</div>
								<div class="space-y-1 text-[11px] font-medium text-muted-foreground">
									<span>{ i18n.T(ctx, "contacts.filters.activity") }</span>
									@selectbox.SelectBox(selectbox.Props{Multiple: true}) {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "activity", Class: "h-8 bg-background text-xs", Multiple: true, ShowPills: true, DisableClear: true, SelectedCountText: i18n.T(ctx, "contacts.filters.selected_count")}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "contacts.filters.any_activity"), Multiple: true, Class: "text-left"})
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "seen", Selected: models.ContactFilterHas(filters.Activity, "seen")}) {
												{ i18n.T(ctx, "contacts.filters.seen") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "none", Selected: models.ContactFilterHas(filters.Activity, "none")}) {
												{ i18n.T(ctx, "contacts.filters.no_messages") }
											}
										}
									}
								</div>
							</form>
						}
					}
				</div>
			</div>
			// Under the search, as the mail list's active filter strip. It stays in
			// the page, collapsed, so the pills open and close it smoothly.
			<div data-contact-active-filter-pills class={ "mail-active-filter-strip contacts-active-filter-strip", templ.KV("hidden", !contactFiltersActive(filters)) } aria-label={ i18n.T(ctx, "mail.filters.active") }>
				if contactFiltersActive(filters) {
					<div class="mail-active-filter-visible">
						if filters.StoredIn != "" {
							@contactActiveFilterPill("stored_in", i18n.T(ctx, "contacts.filters.stored_in_pill", "place", contactPlaceFilterLabels(ctx, filters.StoredIn, accounts)))
						}
						if filters.Source != "" {
							@contactActiveFilterPill("source", i18n.T(ctx, "contacts.filters.origin_pill", "origin", contactOriginFilterLabels(ctx, filters.Source, accounts)))
						}
						if filters.SaveTarget != "" {
							@contactActiveFilterPill("save_target", contactPlaceFilterLabels(ctx, filters.SaveTarget, accounts))
						}
						if filters.Activity != "" {
							@contactActiveFilterPill("activity", contactActivityFilterLabels(ctx, filters.Activity))
						}
					</div>
				}
			</div>
			// app.js draws the pills again from this one as the filters change.
			<template data-contact-active-filter-pill-template>
				@contactActiveFilterPill("", "")
			</template>
			</div>
		</div>
		<div class="contacts-list-toolbar relative flex items-center gap-1 px-4 py-1.5">
			@ContactsSelectAllControl()
			<div class="relative inline-grid h-7 shrink-0 grid-cols-2 rounded-lg border border-border bg-background p-0.5 gap-0.5" data-contact-list-view-toggle>
				<div class="absolute top-0.5 bottom-0.5 left-0.5 w-[calc(50%-2px)] rounded-md border border-border bg-card shadow-sm transition-transform duration-200 ease-out" style={ contactViewIndicatorStyle(filters.View) } data-contact-list-view-indicator></div>
				<button
					type="button"
					data-contact-list-view-button="cards"
					aria-pressed={ fmt.Sprintf("%t", contactViewMode(filters.View) == "cards") }
					aria-label={ i18n.T(ctx, "mail.view.cards_label") }
					class={
						"relative z-10 inline-flex h-6 items-center justify-center gap-1 px-2 rounded-md text-xs font-medium transition-colors duration-200",
						templ.KV("text-foreground", contactViewMode(filters.View) == "cards"),
						templ.KV("text-muted-foreground hover:text-foreground", contactViewMode(filters.View) != "cards"),
					}
				>
					@icon.LayoutList(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "mail.view.cards") }
				</button>
				<button
					type="button"
					data-contact-list-view-button="table"
					aria-pressed={ fmt.Sprintf("%t", contactViewMode(filters.View) == "table") }
					aria-label={ i18n.T(ctx, "mail.view.table_label") }
					class={
						"relative z-10 inline-flex h-6 items-center justify-center gap-1 px-2 rounded-md text-xs font-medium transition-colors duration-200",
						templ.KV("text-foreground", contactViewMode(filters.View) == "table"),
						templ.KV("text-muted-foreground hover:text-foreground", contactViewMode(filters.View) != "table"),
					}
				>
					@icon.Table2(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "mail.view.table") }
				</button>
			</div>
			@dropdown.Dropdown() {
				@dropdown.Trigger() {
					<button type="button" data-contact-sort-trigger class="inline-flex h-7 shrink-0 items-center gap-1.5 rounded-md px-2 text-xs font-medium text-muted-foreground hover:bg-accent hover:text-foreground" aria-label={ i18n.T(ctx, "contacts.sort.label") }>
						@icon.ArrowUpDown(icon.Props{Class: "size-3.5"})
						<span class="hidden sm:inline">{ contactSortLabel(ctx, filters) }</span>
					</button>
				}
				@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "mobile-sheet w-64 normal-case tracking-normal p-3"}) {
					<form class="space-y-3" data-contact-sort-form>
						<div class="space-y-1 text-[11px] font-medium text-muted-foreground">
							<span>{ i18n.T(ctx, "mail.sort.order_by") }</span>
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "sort_by", Class: "h-8 bg-background text-xs", DisableClear: true}) { @selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "contacts.sort.updated")}) }
								@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
									@selectbox.Item(selectbox.ItemProps{Value: "updated", Selected: filters.SortBy == "" || filters.SortBy == "updated"}) { { i18n.T(ctx, "contacts.sort.updated") } }
									@selectbox.Item(selectbox.ItemProps{Value: "name", Selected: filters.SortBy == "name"}) { { i18n.T(ctx, "contacts.sort.name") } }
									@selectbox.Item(selectbox.ItemProps{Value: "last_interaction", Selected: filters.SortBy == "last_interaction"}) { { i18n.T(ctx, "contacts.sort.last_interaction") } }
								}
							}
						</div>
						<div class="space-y-1 text-[11px] font-medium text-muted-foreground">
							<span>{ i18n.T(ctx, "mail.sort.order") }</span>
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "sort_order", Class: "h-8 bg-background text-xs", DisableClear: true}) { @selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "mail.sort.descending")}) }
								@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true}) {
									@selectbox.Item(selectbox.ItemProps{Value: "desc", Selected: filters.SortOrder == "" || filters.SortOrder == "desc"}) { { i18n.T(ctx, "mail.sort.descending") } }
									@selectbox.Item(selectbox.ItemProps{Value: "asc", Selected: filters.SortOrder == "asc"}) { { i18n.T(ctx, "mail.sort.ascending") } }
								}
							}
						</div>
						<button type="submit" class="inline-flex h-8 w-full items-center justify-center rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground hover:bg-primary/90">{ i18n.T(ctx, "mail.sort.apply") }</button>
					</form>
				}
			}
			<div class="flex-1"></div>
			@ContactsSelectionActions(filters.Trash)
		</div>
		@ContactsSelectAllBanner()
		<hr class="divider-etched"/>
		<div
			id="contacts-list-scroll"
			class="flex-1 overflow-y-auto px-2 py-2"
			data-hydrate-dropin
			data-view-mode={ contactViewMode(filters.View) }
			data-total-count={ fmt.Sprintf("%d", totalCount) }
			data-window-start="0"
			data-window-end={ fmt.Sprintf("%d", contactWindowEnd(0, len(contacts))) }
			data-has-more={ fmt.Sprintf("%t", len(contacts) < totalCount) }
			data-query={ filters.Query }
			data-sort-by={ filters.SortBy }
			data-sort-order={ filters.SortOrder }
			data-source={ filters.Source }
			data-stored-in={ filters.StoredIn }
			data-save-target={ filters.SaveTarget }
			data-activity={ filters.Activity }
			if filters.Trash {
				data-trash="1"
			}
		>
			if totalCount < 0 {
				@NavigationLoadingContent()
			} else if len(contacts) == 0 && filters.Trash {
				<div class="flex flex-col items-center justify-center py-20 px-4 text-center">
					<div class="empty-icon-box size-16 rounded-2xl bg-muted/50 flex items-center justify-center mb-4 raised">
						@icon.Trash2(icon.Props{Class: "size-5"})
					</div>
					<h3 class="font-semibold text-sm mb-1">{ i18n.T(ctx, "contacts.trash.empty_title") }</h3>
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "contacts.trash.empty_detail", "days", models.ContactTrashRetentionDays) }</p>
				</div>
			} else if len(contacts) == 0 {
				<div class="flex flex-col items-center justify-center py-20 px-4 text-center">
					<div class="empty-icon-box size-16 rounded-2xl bg-muted/50 flex items-center justify-center mb-4 raised">
						@icon.BookUser(icon.Props{Class: "size-5"})
					</div>
					<h3 class="font-semibold text-sm mb-1">{ i18n.T(ctx, "contacts.empty.title") }</h3>
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "contacts.empty.detail") }</p>
				</div>
			} else if contactViewMode(filters.View) == "table" {
				@ContactListTableHeader()
				for i, contact := range contacts {
					@ContactListTableRow(contact, filters, selected, accounts, i)
				}
			} else {
				for i, contact := range contacts {
					@ContactListCard(contact, filters, selected, accounts, i)
				}
			}
		</div>
		<a href="/contacts?new=1" hx-get="/contacts?new=1" hx-target="#main-content" hx-swap="outerHTML" hx-push-url="/contacts?new=1" class="mobile-compose-fab" aria-label={ i18n.T(ctx, "contacts.new") }>
			@icon.UserPlus(icon.Props{Class: "size-5"})
		</a>
		@ContactsContextMenu(filters.Trash)
	</section>
}

// ContactsSelectAllControl is the contacts list's select-all checkbox, with a
// menu for all, none or the opposite of the selection. app.js keeps it
// checked, mixed or empty, as the mail list's.
templ ContactsSelectAllControl() {
	<div class="mail-select-all inline-flex h-7 shrink-0 items-center gap-0.5 rounded-md pl-1.5 transition-colors" data-contact-select-all>
		@checkbox.Checkbox(checkbox.Props{
			Class:      "mail-select-all-toggle",
			Attributes: templ.Attributes{"data-contact-select-all-toggle": "", "aria-label": i18n.T(ctx, "contacts.select.all")},
		})
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "h-7 w-5 text-muted-foreground hover:bg-transparent dark:hover:bg-transparent",
					Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "contacts.select.label")},
				}) {
					@icon.ChevronDown(icon.Props{Class: "size-3.5"})
				}
			}
			@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomStart, Class: "mobile-sheet mail-select-all-menu w-44"}) {
				@dropdown.Item(dropdown.ItemProps{Class: "text-xs", Attributes: templ.Attributes{"data-contact-select": "all"}}) {
					{ i18n.T(ctx, "mail.select.all") }
				}
				@dropdown.Item(dropdown.ItemProps{Class: "text-xs", Attributes: templ.Attributes{"data-contact-select": "none"}}) {
					{ i18n.T(ctx, "mail.select.none") }
				}
				@dropdown.Separator()
				@dropdown.Item(dropdown.ItemProps{Class: "text-xs", Attributes: templ.Attributes{"data-contact-select": "invert"}}) {
					{ i18n.T(ctx, "mail.select.invert") }
				}
			}
		}
	</div>
}

// ContactsSelectionActions act on the selected contacts. They show only
// while contacts are selected, fading in at the toolbar's right as the mail
// list's message actions do. In the Trash they restore or delete for good.
templ ContactsSelectionActions(trash bool) {
	if trash {
		<div class="items-center gap-1" data-contact-selection-actions>
			@contactSelectionAction("restore", i18n.T(ctx, "contacts.action.restore"), i18n.T(ctx, "contacts.selection.restore"), "") {
				@icon.Undo2(icon.Props{Class: "size-3.5"})
			}
			@contactSelectionAction("delete-forever", i18n.T(ctx, "contacts.action.delete_forever"), i18n.T(ctx, "contacts.selection.delete_forever"), "hover:bg-destructive/10 hover:text-destructive") {
				@icon.Trash2(icon.Props{Class: "size-3.5"})
			}
		</div>
	} else {
	<div class="items-center gap-1" data-contact-selection-actions>
		@contactSelectionAction("compose", i18n.T(ctx, "compose.new_message"), i18n.T(ctx, "contacts.selection.compose"), "") {
			@icon.Pen(icon.Props{Class: "size-3.5"})
		}
		@contactSelectionAction("export", i18n.T(ctx, "contacts.action.export_many"), i18n.T(ctx, "contacts.selection.export"), "") {
			@icon.Download(icon.Props{Class: "size-3.5"})
		}
		@contactSelectionAction("delete", i18n.T(ctx, "contacts.action.trash"), i18n.T(ctx, "contacts.selection.trash"), "hover:bg-destructive/10 hover:text-destructive") {
			@icon.Trash2(icon.Props{Class: "size-3.5"})
		}
	</div>
	}
}

templ contactSelectionAction(action, tip, label, class string) {
	@tooltip.Tooltip() {
		@tooltip.Trigger() {
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeIcon,
				Class:      "h-7 w-7 " + class,
				Disabled:   true,
				Attributes: templ.Attributes{"data-contact-selection-action": action, "aria-label": label},
			}) {
				{ children... }
			}
		}
		@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionBottom, ShowArrow: true}) {
			{ tip }
		}
	}
}

// ContactsSelectAllBanner says how much of the list is selected, and offers
// to extend the selection to every contact the filters match or to clear it.
// app.js fills and shows it.
templ ContactsSelectAllBanner() {
	<div data-contact-select-all-banner class="mail-select-all-banner hidden items-center justify-center gap-x-3 gap-y-0.5 flex-wrap border-t border-border/60 bg-accent/60 px-4 py-1.5 text-center text-xs text-muted-foreground">
		<span data-contact-select-all-banner-text></span>
		@button.Button(button.Props{
			Variant:    button.VariantLink,
			Size:       button.SizeSm,
			Class:      "h-auto p-0 text-xs",
			Attributes: templ.Attributes{"data-contact-select-all-banner-action": ""},
		})
		@button.Button(button.Props{
			Variant:    button.VariantLink,
			Size:       button.SizeSm,
			Class:      "h-auto p-0 text-xs",
			Attributes: templ.Attributes{"data-contact-selection-clear": ""},
		}) {
			{ i18n.T(ctx, "shortcuts.clear_selection") }
		}
	</div>
}

// ContactsContextMenu opens where a contact in the list is right-clicked,
// with what can be done to it. app.js places it and shows the items that
// apply: the email ones only for a contact with an address. In the Trash it
// restores or deletes for good.
templ ContactsContextMenu(trash bool) {
	@popover.Root(popover.RootProps{ID: "contacts-context-menu", Attributes: templ.Attributes{"data-contacts-context-menu": ""}}) {
		@popover.Trigger() {
			<span class="pointer-events-none fixed left-0 top-0 size-px" aria-hidden="true" data-point-popover-anchor></span>
		}
		@popover.Content(popover.ContentProps{
			Placement:  popover.PlacementBottomStart,
			Offset:     2,
			Class:      "z-50 w-52 rounded-md border border-border bg-popover p-1 shadow-md focus:outline-none",
			Attributes: templ.Attributes{"role": "menu", "aria-label": i18n.T(ctx, "contacts.actions")},
		}) {
			@dropdown.Label(dropdown.LabelProps{Class: "truncate text-xs font-medium text-muted-foreground", Attributes: templ.Attributes{"data-contacts-context-title": ""}})
			if trash {
				@contactsContextItem("restore", i18n.T(ctx, "contacts.action.restore"), "") {
					@icon.Undo2(icon.Props{Class: "size-4"})
				}
				@dropdown.Separator()
				@contactsContextItem("delete-forever", i18n.T(ctx, "contacts.action.delete_forever_menu"), "text-destructive "+menuDestructiveClass) {
					@icon.Trash2(icon.Props{Class: "size-4"})
				}
			} else {
			<div data-contacts-context-group="email">
				@contactsContextItem("compose", i18n.T(ctx, "compose.new_message"), "") {
					@icon.Pen(icon.Props{Class: "size-4"})
				}
				@contactsContextItem("copy-email", i18n.T(ctx, "contacts.action.copy_email"), "") {
					@icon.Copy(icon.Props{Class: "size-4"})
				}
				@contactsContextItem("messages", i18n.T(ctx, "contacts.action.messages"), "") {
					@icon.Mail(icon.Props{Class: "size-4"})
				}
				@dropdown.Separator()
			</div>
			@contactsContextItem("edit", i18n.T(ctx, "contacts.action.edit_menu"), "") {
				@icon.Pencil(icon.Props{Class: "size-4"})
			}
			@contactsContextItem("export", i18n.T(ctx, "contacts.action.export"), "") {
				@icon.Download(icon.Props{Class: "size-4"})
			}
			<div data-contacts-context-group="delete">
				@dropdown.Separator()
				@contactsContextItem("delete", i18n.T(ctx, "contacts.action.trash"), "text-destructive "+menuDestructiveClass) {
					@icon.Trash2(icon.Props{Class: "size-4"})
				}
			</div>
			}
		}
	}
}

templ contactsContextItem(action string, label string, class string) {
	@dropdown.Item(dropdown.ItemProps{Class: class, Attributes: templ.Attributes{"role": "menuitem", "data-contacts-context-action": action}}) {
		<span class="flex items-center gap-2">
			{ children... }
			{ label }
		</span>
	}
}

templ ContactsViewPane(selected *models.Contact, selectedProfile *models.ContactProfile, showNew bool, syncQueued bool, accounts []models.Account) {
	<section id="mail-view" class="hidden flex-1 min-w-0 bg-background surface-desk lg:flex lg:flex-col" data-mail-reader>
		@ContactsDetail(selected, selectedProfile, showNew, syncQueued, accounts)
	</section>
}

// ContactListCard is a contact in the list's cards view: two lines, the name
// with its organization and message count, then the address with the
// accounts it syncs with and when it was last seen. On a phone the list's own
// CSS lays it out as a 4rem row and leaves the date and preview fields out.
templ ContactListCard(contact models.Contact, filters models.ContactFilters, selected *models.Contact, accounts []models.Account, position int) {
	{{ contactHref := contactsURL(filters, contact.ID) }}
	{{ contactDetailHref := contactsDetailURL(filters, contact.ID) }}
	<div class="mail-list-item" data-contact-id={ contact.ID } data-position={ fmt.Sprintf("%d", position) } data-contact-row-email={ strings.TrimSpace(contact.Email) } data-contact-row-name={ contact.Name } data-contact-row-synced={ fmt.Sprintf("%t", len(contact.SourceBooks) > 0) }>
		<a
			href={ contactHref }
			hx-get={ templ.URL(contactDetailHref) }
			hx-target="#contacts-detail"
			hx-swap="outerHTML"
			hx-push-url={ contactHref }
			data-contact-list-item={ contact.ID }
			data-active={ fmt.Sprintf("%t", selected != nil && selected.ID == contact.ID) }
			class={
				"contact-list-item contact-card mail-list-card px-3.5 rounded-lg cursor-pointer transition-all duration-200 group",
				templ.KV("envelope-active", selected != nil && selected.ID == contact.ID),
				templ.KV("envelope", selected == nil || selected.ID != contact.ID),
			}
		>
			<div class="mail-list-card-zone mail-list-card-zone-rail-top" data-mail-card-zone="railTop">
				<div data-mail-card-field="avatar">
					@ContactAvatar(contact, "size-8 rounded-full text-[11px] font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.15)]", "bg-gradient-to-b from-amber-700/70 to-amber-900/70 text-amber-100")
				</div>
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-header" data-mail-card-zone="header">
				<span class="truncate text-sm text-foreground" data-mail-card-field="from">
					<span class="font-semibold" data-contact-name>{ contact.Name }</span>
					if org := strings.TrimSpace(contact.Organization); org != "" && org != strings.TrimSpace(contact.Name) {
						<span class="text-muted-foreground"> · { org }</span>
					}
				</span>
				if contact.MessageCount > 0 {
					<span class="ml-auto inline-flex shrink-0 items-center gap-1 text-xs tabular-nums text-muted-foreground" data-mail-card-field="date" title={ contactMessageCountTitle(ctx, contact.MessageCount) }>
						@icon.Mail(icon.Props{Class: "size-3"})
						{ fmt.Sprint(contact.MessageCount) }
					</span>
				}
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-body" data-mail-card-zone="body">
				<p class="truncate text-[13px] text-muted-foreground" data-contact-email data-mail-card-field="subject">{ contactListDetail(contact) }</p>
				<span class="ml-auto flex shrink-0 items-center gap-2" data-mail-card-field="preview">
					{{ origin := contactCardOrigin(ctx, contact, accounts) }}
					<span class="inline-flex max-w-[9rem] items-center gap-1 rounded-full border border-border bg-background px-1.5 py-px text-[10px] font-medium text-muted-foreground" title={ origin.Title }>
						if origin.Color != "" {
							<span class="account-color-marker size-2 shrink-0" style={ accountColorStyle(origin.Color) } aria-hidden="true"></span>
						}
						<span class="truncate">{ origin.Label }</span>
					</span>
					if date, label := contactCardDate(ctx, contact); date != "" {
						<span class="text-xs tabular-nums text-muted-foreground" title={ label }>{ date }</span>
					}
				</span>
			</div>
		</a>
	</div>
}

templ ContactListTableHeader() {
	<div class="mail-list-table-header mail-list-table-grid grid items-center gap-3 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground bg-card/95 border-b border-border/70 sticky top-0 z-20 backdrop-blur-sm" style={ contactListTableGridStyle() }>
		<div class="mail-list-table-heading">{ i18n.T(ctx, "contacts.field.name") }</div>
		<div class="mail-list-table-heading">{ i18n.T(ctx, "contacts.filters.origin") }</div>
		<div class="mail-list-table-heading min-w-12 text-right">{ i18n.T(ctx, "contacts.list.messages_short") }</div>
	</div>
}

templ ContactListTableRow(contact models.Contact, filters models.ContactFilters, selected *models.Contact, accounts []models.Account, position int) {
	{{ contactHref := contactsURL(filters, contact.ID) }}
	{{ contactDetailHref := contactsDetailURL(filters, contact.ID) }}
	<div class="mail-list-item mail-list-table-row" data-contact-id={ contact.ID } data-position={ fmt.Sprintf("%d", position) } data-contact-row-email={ strings.TrimSpace(contact.Email) } data-contact-row-name={ contact.Name } data-contact-row-synced={ fmt.Sprintf("%t", len(contact.SourceBooks) > 0) }>
		<a
			href={ contactHref }
			hx-get={ templ.URL(contactDetailHref) }
			hx-target="#contacts-detail"
			hx-swap="outerHTML"
			hx-push-url={ contactHref }
			data-contact-list-item={ contact.ID }
			data-active={ fmt.Sprintf("%t", selected != nil && selected.ID == contact.ID) }
			class={
				"contact-list-item mail-list-table-grid grid items-center gap-3 px-3.5 py-1.5 rounded-md cursor-pointer transition-all duration-150 group text-xs",
				templ.KV("envelope-active", selected != nil && selected.ID == contact.ID),
				templ.KV("envelope", selected == nil || selected.ID != contact.ID),
			}
			style={ contactListTableGridStyle() }
		>
			<div class="flex min-w-0 items-center gap-3">
				<div class="w-7 flex shrink-0 items-center justify-center">
					@ContactAvatar(contact, "size-6 rounded-full text-[10px] font-semibold", "bg-gradient-to-b from-amber-700/70 to-amber-900/70 text-amber-100")
				</div>
				<div class="min-w-0">
					<div class="truncate font-semibold text-foreground" data-contact-name>{ contact.Name }</div>
					<div class="truncate text-xs text-muted-foreground" data-contact-email>{ contactListDetail(contact) }</div>
				</div>
			</div>
			<div class="truncate text-xs text-muted-foreground">
				if len(contact.SourceBooks) > 0 {
					{ i18n.N(ctx, "contacts.list.books", len(contact.SourceBooks)) }
				} else {
					{ contactSourceLabel(ctx, contact.Source, contact.IsManual, accounts) }
				}
			</div>
			<div class="text-right text-xs tabular-nums text-muted-foreground">{ fmt.Sprintf("%d", contact.MessageCount) }</div>
		</a>
	</div>
}

templ ContactsItemsFragment(contacts []models.Contact, selected *models.Contact, filters models.ContactFilters, totalCount int, windowStart int, accounts []models.Account) {
	<div
		data-total-count={ fmt.Sprintf("%d", totalCount) }
		data-window-start={ fmt.Sprintf("%d", windowStart) }
		data-window-end={ fmt.Sprintf("%d", contactWindowEnd(windowStart, len(contacts))) }
		data-has-more={ fmt.Sprintf("%t", windowStart+len(contacts) < totalCount) }
		data-view-mode={ contactViewMode(filters.View) }
	>
		for i, contact := range contacts {
			if contactViewMode(filters.View) == "table" {
				@ContactListTableRow(contact, filters, selected, accounts, windowStart+i)
			} else {
				@ContactListCard(contact, filters, selected, accounts, windowStart+i)
			}
		}
	</div>
}

templ ContactsImportDialog(accounts []models.Account) {
	@dialog.Dialog(dialog.Props{ID: "contacts-import-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "contacts.import_vcard") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "contacts.import.description") }
				}
			}
			<form action="/api/contacts/import" method="post" enctype="multipart/form-data" class="space-y-4" data-contacts-import-form>
				<div class="space-y-1.5">
					<label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.import.file") }</label>
					<input type="file" name="vcard" accept=".vcf,text/vcard,text/x-vcard" required data-contacts-import-file class="block w-full rounded-lg border border-border bg-background px-3 py-2 text-sm text-foreground file:mr-3 file:rounded-md file:border-0 file:bg-primary file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-primary-foreground hover:file:bg-primary/90"/>
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "contacts.import.supports") }</p>
				</div>
				<div class="space-y-1.5">
					<label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.import.sync_with") }</label>
					@selectbox.SelectBox(selectbox.Props{Multiple: true}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "save_targets", Class: "h-10 bg-background", Multiple: true, ShowPills: true, DisableClear: true, SelectedCountText: i18n.T(ctx, "contacts.import.accounts_selected")}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "contacts.import.gofer_local"), Multiple: true, Class: "text-left"})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							@selectbox.Item(selectbox.ItemProps{Value: "local", Selected: true}) {
								{ i18n.T(ctx, "contacts.import.gofer_local") }
							}
							for _, account := range accounts {
								if !account.IsDeleting && accountContactSyncCapable(account) {
									if len(account.ContactAddressBooks) == 0 {
										@selectbox.Item(selectbox.ItemProps{Value: contactSaveTargetValue(account)}) {
											{ accountContactSaveLabel(account) }
										}
									}
									for _, book := range account.ContactAddressBooks {
										@selectbox.Item(selectbox.ItemProps{Value: contactBookTargetValue(book)}) {
											{ accountContactOriginLabel(ctx, account) } / { contactAddressBookDisplayName(ctx, book) }
										}
									}
								}
							}
						}
					}
				</div>
				// Once a file is chosen, Gofer counts its contacts already in
				// Gofer and asks what to do with them.
				<p class="text-xs text-muted-foreground" aria-live="polite" data-contacts-import-checking hidden>{ i18n.T(ctx, "contacts.import.checking") }</p>
				<div class="space-y-3 rounded-lg border border-border bg-muted/40 p-3" data-contacts-import-existing hidden>
					<p class="text-sm text-foreground" aria-live="polite" data-contacts-import-existing-summary></p>
					<div class="space-y-2" role="radiogroup" aria-label={ i18n.T(ctx, "contacts.import.existing_label") }>
						<label class="flex items-start gap-2.5 text-sm text-foreground">
							<span class="mt-0.5 flex shrink-0">
								@radio.Radio(radio.Props{Name: "existing", Value: "skip", Checked: true})
							</span>
							<span>
								<span class="font-medium">{ i18n.T(ctx, "contacts.import.existing_skip") }</span>
								<span class="block text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "contacts.import.existing_skip_detail") }</span>
							</span>
						</label>
						<label class="flex items-start gap-2.5 text-sm text-foreground">
							<span class="mt-0.5 flex shrink-0">
								@radio.Radio(radio.Props{Name: "existing", Value: "update"})
							</span>
							<span>
								<span class="font-medium">{ i18n.T(ctx, "contacts.import.existing_update") }</span>
								<span class="block text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "contacts.import.existing_update_detail") }</span>
							</span>
						</label>
					</div>
				</div>
				<div class="space-y-1.5" data-contacts-import-progress hidden>
					<div class="flex items-center justify-between gap-3 text-xs text-muted-foreground">
						<span data-contacts-import-progress-label aria-live="polite">{ i18n.T(ctx, "contacts.import.saving") }</span>
						<span class="tabular-nums" data-contacts-import-progress-count></span>
					</div>
					@progress.Progress(progress.Props{Max: 100, Value: 0, Size: progress.SizeSm, Attributes: templ.Attributes{"data-contacts-import-progress-bar": "", "aria-label": i18n.T(ctx, "contacts.import.progress")}})
				</div>
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: "contacts-import-dialog"}) {
						<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border px-3 text-sm font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "common.cancel") }</button>
					}
					<button type="submit" data-contacts-import-submit class="inline-flex h-9 items-center justify-center gap-1.5 rounded-md bg-primary px-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
						@icon.Upload(icon.Props{Class: "size-4"})
						<span data-contacts-import-submit-label>{ i18n.T(ctx, "contacts.import.submit") }</span>
					</button>
				}
			</form>
		}
	}
}

templ ContactsDetail(contact *models.Contact, profile *models.ContactProfile, showNew bool, syncQueued bool, accounts []models.Account) {
	<div
		id="contacts-detail"
		class="flex flex-col h-full p-2"
		if contact != nil {
			data-contact-detail-id={ contact.ID }
		}
		if contact == nil && !showNew {
			data-mail-view-empty
		}
	>
		if contact != nil || showNew {
			<button type="button" class="mobile-back-button mb-2 h-9 items-center gap-1.5 self-start rounded-md px-2 text-sm font-semibold text-muted-foreground hover:bg-muted" data-on-click='["closeMobileContactView"]'>
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "contacts.title") }
			</button>
			<div class="surface-paper rounded-md flex flex-col min-h-0 flex-1 overflow-hidden">
				@ContactEditor(contact, profile, syncQueued, accounts)
			</div>
		} else {
			@ContactsEmptyDetail()
		}
	</div>
}

templ ContactsEmptyDetail() {
	<div class="flex flex-col items-center justify-center h-full text-center">
		<div class="space-y-4 animate-fade-in">
			<div class="size-20 rounded-2xl bg-card flex items-center justify-center mx-auto raised">
				@icon.BookUser(icon.Props{Class: "size-9 text-muted-foreground opacity-30"})
			</div>
			<div>
				<h3 class="font-semibold mb-1">{ i18n.T(ctx, "contacts.view.empty_title") }</h3>
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "contacts.view.empty_detail") }</p>
			</div>
		</div>
	</div>
}

templ ContactEditor(contact *models.Contact, profile *models.ContactProfile, syncQueued bool, accounts []models.Account) {
	<div class="contact-editor flex h-full min-h-0 flex-col">
		@ContactEditorHeader(contact, profile, accounts)
		if contact != nil {
			<div class="flex-1 overflow-y-auto">
				@ContactReadOnlyView(*contact, profile, syncQueued, accounts)
			</div>
			if contact.TrashedAt == "" {
				@ContactEditDialog(*contact, profile, accounts)
			}
		} else {
			<div class="flex-1 overflow-y-auto">
				<form id="contact-editor-form" action={ contactFormAction(contact) } method="post" class="flex min-h-full flex-col" data-contact-editor-form>
					<div class="w-full flex-1 space-y-5 px-5 py-5 sm:px-7">
						@ContactEditorCoreFields(contact)
						@ContactLegacySourcePanel(contact, accounts)
					</div>
					@ContactEditorSaveActions()
				</form>
			</div>
		}
		if contact != nil && contact.TrashedAt == "" {
			<form id={ "delete-contact-" + contact.ID } action={ fmt.Sprintf("/api/contacts/%s/delete", contact.ID) } method="post" data-contact-delete-form={ contact.ID } data-contact-delete-name={ contact.Name } data-contact-delete-email={ strings.TrimSpace(contact.Email) } data-contact-delete-synced={ fmt.Sprintf("%t", len(contact.SourceBooks) > 0) }></form>
		}
	</div>
}

templ ContactReadOnlyView(contact models.Contact, profile *models.ContactProfile, syncQueued bool, accounts []models.Account) {
	<div class="contact-readonly w-full space-y-5 px-5 py-5 sm:px-7">
		if contact.TrashedAt != "" {
			<div class={ "flex items-start gap-2.5 rounded-md border px-3 py-2.5 text-sm " + contactInsightSeverityClass("warning") } data-contact-trash-notice>
				@icon.Trash2(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
				<p>
					{ i18n.T(ctx, "contacts.view.trash_notice", "date", contact.TrashedAt, "purge", contact.TrashPurgeAt) }
				</p>
			</div>
		}
		@ContactReadOnlyContactInfo(contact)
		@ContactReadOnlySyncInfo(contact, profile, syncQueued, accounts)
		@ContactReadOnlyActivityInfo(contact)
		@ContactRecentActivityLoader(contact)
	</div>
}

templ ContactReadOnlyContactInfo(contact models.Contact) {
	<section class="rounded-lg border border-ink/10 bg-ink/[0.02]">
		<div class="flex items-center gap-2 border-b border-ink/10 px-4 py-3">
			@icon.IdCard(icon.Props{Class: "size-3.5 text-muted-foreground"})
			<h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.view.contact") }</h2>
		</div>
		<div class="grid gap-x-6 px-4 lg:grid-cols-2">
			@ContactReadOnlyTextField(i18n.T(ctx, "contacts.field.name"), contact.Name)
			@ContactReadOnlyLinkedField(i18n.T(ctx, "contacts.field.email"), contact.Email, contact.EmailLabel, "mailto:")
			@ContactReadOnlyListField(i18n.T(ctx, "contacts.field.additional_emails"), contact.AdditionalEmails, contact.AdditionalEmailLabels, "alternate", "mailto:")
			@ContactReadOnlyLinkedField(i18n.T(ctx, "contacts.field.phone"), contact.Phone, contact.PhoneLabel, "tel:")
			@ContactReadOnlyListField(i18n.T(ctx, "contacts.field.additional_phones"), contact.AdditionalPhones, contact.AdditionalPhoneLabels, "alternate", "tel:")
			@ContactReadOnlyTextField(i18n.T(ctx, "contacts.field.title"), contact.Title)
			@ContactReadOnlyTextField(i18n.T(ctx, "contacts.field.organization"), contact.Organization)
			@ContactReadOnlyLongField(i18n.T(ctx, "contacts.field.notes"), contact.Notes)
		</div>
	</section>
}

templ ContactReadOnlySyncInfo(contact models.Contact, profile *models.ContactProfile, syncQueued bool, accounts []models.Account) {
	{{ originLabel := contactReadOnlyOriginLabel(ctx, contact, profile, accounts) }}
	{{ targetLabels := contactReadOnlyMirrorLabels(ctx, &contact, profile, accounts) }}
	{{ storedLabels := contactStoredInLabels(ctx, profile, accounts) }}
	<section class="rounded-lg border border-ink/10 bg-ink/[0.02]">
		<div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 px-4 py-3">
			<div class="flex flex-wrap items-center gap-2">
				@icon.Route(icon.Props{Class: "size-3.5 text-muted-foreground"})
				<h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.sync.title") }</h2>
				<span class={ contactSyncEnabledBadgeClass(contactProfileSyncEnabled(profile)) } data-contact-sync-enabled-status>{ contactProfileSyncLabel(ctx, profile) }</span>
			</div>
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size: button.SizeSm,
				Disabled: contact.TrashedAt != "" || !contactProfileSyncEnabled(profile) || contactSyncOperationActive(contact, syncQueued),
				Class: "h-7 gap-1.5 border-ink/10 bg-ink/[0.025] px-2.5 text-xs text-muted-foreground shadow-none",
				Attributes: templ.Attributes{"data-contact-sync-now": "", "data-contact-id": contact.ID, "aria-label": i18n.T(ctx, "contacts.sync.now_label")},
			}) {
				@icon.RefreshCw(icon.Props{Class: contactSyncNowIconClass(contact, syncQueued)})
				{ i18n.T(ctx, "contacts.sync.now") }
			}
		</div>
		<div class="grid gap-x-6 px-4 lg:grid-cols-2">
			@ContactReadOnlyPillListField(i18n.T(ctx, "contacts.stored_in"), storedLabels)
			@ContactReadOnlyPillListField(i18n.T(ctx, "contacts.sync.locations"), targetLabels)
			@ContactReadOnlyTextField(i18n.T(ctx, "contacts.filters.origin"), originLabel)
			@ContactReadOnlySyncStatusField(contactReadOnlySyncStatus(ctx, contact, syncQueued))
			@ContactReadOnlyTextField(i18n.T(ctx, "contacts.sync.updated"), contact.SyncUpdatedAt)
			@ContactReadOnlyLongField(i18n.T(ctx, "contacts.sync.error"), i18n.ServerText(ctx, contact.SyncError))
		</div>
	</section>
}

templ ContactReadOnlyActivityInfo(contact models.Contact) {
	<section class="rounded-lg border border-ink/10 bg-ink/[0.02]">
		<div class="flex items-center gap-2 border-b border-ink/10 px-4 py-3">
			@icon.Activity(icon.Props{Class: "size-3.5 text-muted-foreground"})
			<h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.filters.activity") }</h2>
		</div>
		<div class="grid gap-x-6 px-4 sm:grid-cols-2 xl:grid-cols-4">
			@ContactReadOnlyTextField(i18n.T(ctx, "contacts.activity.messages"), i18n.Number(ctx, contact.MessageCount))
			@ContactReadOnlyTextField(i18n.T(ctx, "contacts.activity.last_seen"), contact.LastSeenAt)
			@ContactReadOnlyTextField(i18n.T(ctx, "contacts.activity.added"), contact.CreatedAt)
			@ContactReadOnlyTextField(i18n.T(ctx, "contacts.activity.updated"), contact.UpdatedAt)
		</div>
	</section>
}

templ ContactReadOnlyTextField(label string, value string) {
	<div data-contact-field-empty?={ strings.TrimSpace(value) == "" } class="min-w-0 border-b border-ink/10 py-3 last:border-b-0 lg:[&:nth-last-child(-n+2)]:border-b-0 xl:last:border-b-0">
		<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		<div class={ "mt-1 min-h-5 truncate text-sm font-medium " + contactReadOnlyValueClass(value) }>{ contactReadOnlyValue(ctx, value) }</div>
	</div>
}

templ ContactReadOnlyLongField(label string, value string) {
	<div data-contact-field-empty?={ strings.TrimSpace(value) == "" } class="min-w-0 border-b border-ink/10 py-3 last:border-b-0 lg:[&:nth-last-child(-n+2)]:border-b-0 xl:last:border-b-0">
		<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		<div class={ "mt-1 min-h-5 whitespace-pre-wrap text-sm leading-relaxed " + contactReadOnlyValueClass(value) }>{ contactReadOnlyValue(ctx, value) }</div>
	</div>
}

templ ContactReadOnlyLinkedField(label string, value string, valueLabel string, hrefPrefix string) {
	<div data-contact-field-empty?={ strings.TrimSpace(value) == "" } class="min-w-0 border-b border-ink/10 py-3 last:border-b-0 lg:[&:nth-last-child(-n+2)]:border-b-0 xl:last:border-b-0">
		<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		if strings.TrimSpace(value) != "" {
			<div class="mt-1 flex min-h-5 min-w-0 flex-wrap items-center gap-2">
				<a href={ hrefPrefix + value } class="min-w-0 truncate text-sm font-medium text-ink hover:text-ink">{ value }</a>
				if contactReadOnlyLabelDisplay(ctx, valueLabel) != "" {
					<span class="rounded border border-ink/10 bg-ink/[0.04] px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ contactReadOnlyLabelDisplay(ctx, valueLabel) }</span>
				}
			</div>
		} else {
			<div class="mt-1 min-h-5 text-sm font-medium text-muted-foreground">{ i18n.T(ctx, "contacts.field.empty") }</div>
		}
	</div>
}

templ ContactReadOnlyListField(label string, values []string, labels []string, fallbackLabel string, hrefPrefix string) {
	<div data-contact-field-empty?={ !contactReadOnlyHasValues(values) } class="min-w-0 border-b border-ink/10 py-3 last:border-b-0 lg:[&:nth-last-child(-n+2)]:border-b-0 xl:last:border-b-0">
		<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		if contactReadOnlyHasValues(values) {
			<div class="mt-1 space-y-1.5">
				for i, value := range values {
					if strings.TrimSpace(value) != "" {
						<div class="flex min-w-0 flex-wrap items-center gap-2">
							<a href={ hrefPrefix + value } class="min-w-0 truncate text-sm font-medium text-ink hover:text-ink">{ value }</a>
							if contactReadOnlyLabelDisplay(ctx, contactReadOnlyLabelAt(labels, i, fallbackLabel)) != "" {
								<span class="rounded border border-ink/10 bg-ink/[0.04] px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ contactReadOnlyLabelDisplay(ctx, contactReadOnlyLabelAt(labels, i, fallbackLabel)) }</span>
							}
						</div>
					}
				}
			</div>
		} else {
			<div class="mt-1 min-h-5 text-sm font-medium text-muted-foreground">{ i18n.T(ctx, "contacts.field.empty") }</div>
		}
	</div>
}

templ ContactReadOnlyPillListField(label string, values []string) {
	<div data-contact-field-empty?={ len(values) == 0 } class="min-w-0 border-b border-ink/10 py-3 last:border-b-0 lg:col-span-2">
		<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		if len(values) > 0 {
			<div class="mt-1 flex min-h-5 flex-wrap items-center gap-1.5">
				for _, value := range values {
					<span class="rounded border border-ink/10 bg-ink/[0.04] px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ value }</span>
				}
			</div>
		} else {
			<div class="mt-1 min-h-5 text-sm font-medium text-muted-foreground">{ i18n.T(ctx, "contacts.field.empty") }</div>
		}
	</div>
}

templ ContactReadOnlySyncStatusField(value string) {
	<div class="min-w-0 border-b border-ink/10 py-3 last:border-b-0 lg:[&:nth-last-child(-n+2)]:border-b-0 xl:last:border-b-0">
		<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.sync.status_label") }</div>
		<div class={ "mt-1 min-h-5 truncate text-sm font-medium " + contactReadOnlyValueClass(value) } data-contact-sync-operation-status>{ contactReadOnlyValue(ctx, value) }</div>
	</div>
}

templ ContactEditorCoreFields(contact *models.Contact) {
	{{ hasAvatar := contact != nil && strings.TrimSpace(contact.AvatarURL) != "" }}
	<section class="rounded-lg border border-ink/10 bg-ink/[0.02]" data-contact-avatar-editor>
		<input type="hidden" name="avatar_action" value="preserve" data-contact-avatar-action/>
		<input type="hidden" name="avatar_data_url" value="" data-contact-avatar-data/>
		<input type="file" accept="image/jpeg,image/png,image/webp" class="hidden" data-contact-avatar-input/>
		<div class="flex min-h-14 items-center justify-between gap-3 border-b border-ink/10 px-4 py-2">
			<div class="flex min-w-0 items-center gap-3">
				<button type="button" class="group relative size-10 shrink-0 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-ink/20" data-contact-avatar-choose aria-label={ i18n.T(ctx, "contacts.avatar.choose") } title={ i18n.T(ctx, "contacts.avatar.change_tip") }>
					<span class="relative block size-10 overflow-hidden rounded-full bg-ink/[0.06] text-xs font-bold text-muted-foreground shadow-sm ring-1 ring-ink/10 transition group-hover:ring-ink/25" data-contact-avatar-edit-preview>
						<span class={ "h-full w-full items-center justify-center rounded-full " + contactEditAvatarFallbackClass(hasAvatar) } data-avatar-fallback>
							if contact != nil {
								{ contact.Initials }
							} else {
								@icon.UserPlus(icon.Props{Class: "size-4"})
							}
						</span>
						if hasAvatar {
							<img src={ contactAvatarRenderURL(contact.AvatarURL) } alt={ i18n.T(ctx, "contacts.avatar.contact_alt") } class="absolute inset-0 size-full object-cover" data-avatar-image/>
						}
						<span class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-full bg-ink/0 text-white opacity-0 transition group-hover:bg-ink/30 group-hover:opacity-100 group-focus-visible:bg-ink/30 group-focus-visible:opacity-100">
							@icon.ImagePlus(icon.Props{Class: "size-4 drop-shadow"})
						</span>
					</span>
				</button>
				<div class="min-w-0">
					<h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.view.contact") }</h2>
					<p class="mt-0.5 text-[11px] text-muted-foreground">{ i18n.T(ctx, "contacts.avatar.change_hint") }</p>
				</div>
			</div>
			<div class="flex shrink-0 items-center gap-2">
				<span class="hidden text-xs font-medium text-emerald-700" data-contact-avatar-status>{ i18n.T(ctx, "contacts.avatar.ready") }</span>
				<button type="button" class={ "h-7 items-center rounded-md px-2 text-[11px] font-semibold text-muted-foreground transition-colors hover:bg-destructive/10 hover:text-destructive " + contactEditAvatarRemoveClass(hasAvatar) } data-contact-avatar-remove>{ i18n.T(ctx, "contacts.avatar.remove") }</button>
			</div>
		</div>
		<div class="grid gap-6 p-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
			<div class="min-w-0 space-y-4">
				<div>
					<label class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.field.name") }</label>
					<input type="text" name="name" value={ contactFormName(contact) } placeholder={ i18n.T(ctx, "contacts.placeholder.name") } class="h-10 w-full rounded-lg border border-ink/10 bg-ink/[0.04] px-3 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10"/>
				</div>
				@ContactEmailFields(contact)
				@ContactPhoneFields(contact)
			</div>
			<div class="min-w-0 space-y-4">
				<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
					<div>
						<label class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.field.title") }</label>
						<input type="text" name="title" value={ contactFormTitle(contact) } placeholder={ i18n.T(ctx, "contacts.placeholder.title") } class="h-10 w-full rounded-lg border border-ink/10 bg-ink/[0.04] px-3 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10"/>
					</div>
					<div>
						<label class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.field.organization") }</label>
						<input type="text" name="organization" value={ contactFormOrganization(contact) } placeholder={ i18n.T(ctx, "contacts.placeholder.organization") } class="h-10 w-full rounded-lg border border-ink/10 bg-ink/[0.04] px-3 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10"/>
					</div>
				</div>
				<div>
					<label class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.field.notes") }</label>
					<textarea name="notes" rows="7" placeholder={ i18n.T(ctx, "contacts.placeholder.notes") } class="min-h-40 w-full resize-y rounded-lg border border-ink/10 bg-ink/[0.04] px-3 py-2 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10">{ contactFormNotes(contact) }</textarea>
				</div>
			</div>
		</div>
	</section>
}

templ ContactEmailFields(contact *models.Contact) {
	<div class="space-y-2">
		<div class="flex items-center justify-between gap-3">
			<label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.field.email") }</label>
			<button type="button" class="inline-flex h-7 items-center gap-1 rounded-md border border-ink/10 bg-ink/[0.025] px-2 text-[11px] font-medium text-muted-foreground hover:bg-ink/[0.06] hover:text-ink" data-contact-add-value="additional_emails" aria-label={ i18n.T(ctx, "contacts.edit.add_email") }>
				@icon.Plus(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "contacts.edit.add") }
			</button>
		</div>
		<template data-contact-value-template="additional_emails">
			<div class="flex items-center gap-2" data-contact-value-row>
				<input type="email" name="additional_emails" placeholder="jane@work.example" class="h-10 min-w-0 flex-1 rounded-lg border border-ink/10 bg-ink/[0.04] px-3 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10"/>
				@ContactLabelSelect("additional_email_labels", "other", contactEmailLabelOptions("other"), i18n.T(ctx, "contacts.edit.email_label"))
				<button type="button" class="size-8 shrink-0 rounded-md border border-ink/10 bg-ink/[0.025] text-muted-foreground hover:bg-ink/[0.06] hover:text-ink" data-contact-remove-value aria-label={ i18n.T(ctx, "contacts.edit.remove_email") }>
					@icon.X(icon.Props{Class: "mx-auto size-4"})
				</button>
			</div>
		</template>
		<div class="space-y-2" data-contact-value-list="additional_emails">
			<div class="flex items-center gap-2">
				<input type="email" name="email" value={ contactFormEmail(contact) } placeholder="jane@example.com" class="h-10 min-w-0 flex-1 rounded-lg border border-ink/10 bg-ink/[0.04] px-3 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10"/>
				@ContactLabelSelect("email_label", contactFormEmailLabel(contact), contactEmailLabelOptions(contactFormEmailLabel(contact)), i18n.T(ctx, "contacts.edit.email_label"))
			</div>
			for i, email := range contactAdditionalEmails(contact) {
				<div class="flex items-center gap-2" data-contact-value-row>
					<input type="email" name="additional_emails" value={ email } placeholder="jane@work.example" class="h-10 min-w-0 flex-1 rounded-lg border border-ink/10 bg-ink/[0.04] px-3 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10"/>
					@ContactLabelSelect("additional_email_labels", contactAdditionalEmailLabel(contact, i), contactEmailLabelOptions(contactAdditionalEmailLabel(contact, i)), i18n.T(ctx, "contacts.edit.email_label"))
					<button type="button" class="size-8 shrink-0 rounded-md border border-ink/10 bg-ink/[0.025] text-muted-foreground hover:bg-ink/[0.06] hover:text-ink" data-contact-remove-value aria-label={ i18n.T(ctx, "contacts.edit.remove_email") }>
						@icon.X(icon.Props{Class: "mx-auto size-4"})
					</button>
				</div>
			}
		</div>
	</div>
}

templ ContactPhoneFields(contact *models.Contact) {
	<div class="space-y-2">
		<div class="flex items-center justify-between gap-3">
			<label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.field.phone") }</label>
			<button type="button" class="inline-flex h-7 items-center gap-1 rounded-md border border-ink/10 bg-ink/[0.025] px-2 text-[11px] font-medium text-muted-foreground hover:bg-ink/[0.06] hover:text-ink" data-contact-add-value="additional_phones" aria-label={ i18n.T(ctx, "contacts.edit.add_phone") }>
				@icon.Plus(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "contacts.edit.add") }
			</button>
		</div>
		<template data-contact-value-template="additional_phones">
			<div class="flex items-center gap-2" data-contact-value-row>
				<input type="tel" name="additional_phones" placeholder="+1 555 0101" class="h-10 min-w-0 flex-1 rounded-lg border border-ink/10 bg-ink/[0.04] px-3 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10"/>
				@ContactLabelSelect("additional_phone_labels", "other", contactPhoneLabelOptions("other"), i18n.T(ctx, "contacts.edit.phone_label"))
				<button type="button" class="size-8 shrink-0 rounded-md border border-ink/10 bg-ink/[0.025] text-muted-foreground hover:bg-ink/[0.06] hover:text-ink" data-contact-remove-value aria-label={ i18n.T(ctx, "contacts.edit.remove_phone") }>
					@icon.X(icon.Props{Class: "mx-auto size-4"})
				</button>
			</div>
		</template>
		<div class="space-y-2" data-contact-value-list="additional_phones">
			<div class="flex items-center gap-2">
				<input type="tel" name="phone" value={ contactFormPhone(contact) } placeholder="+1 555 0100" class="h-10 min-w-0 flex-1 rounded-lg border border-ink/10 bg-ink/[0.04] px-3 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10"/>
				@ContactLabelSelect("phone_label", contactFormPhoneLabel(contact), contactPhoneLabelOptions(contactFormPhoneLabel(contact)), i18n.T(ctx, "contacts.edit.phone_label"))
			</div>
			for i, phone := range contactAdditionalPhones(contact) {
				<div class="flex items-center gap-2" data-contact-value-row>
					<input type="tel" name="additional_phones" value={ phone } placeholder="+1 555 0101" class="h-10 min-w-0 flex-1 rounded-lg border border-ink/10 bg-ink/[0.04] px-3 text-sm text-ink placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ink/10"/>
					@ContactLabelSelect("additional_phone_labels", contactAdditionalPhoneLabel(contact, i), contactPhoneLabelOptions(contactAdditionalPhoneLabel(contact, i)), i18n.T(ctx, "contacts.edit.phone_label"))
					<button type="button" class="size-8 shrink-0 rounded-md border border-ink/10 bg-ink/[0.025] text-muted-foreground hover:bg-ink/[0.06] hover:text-ink" data-contact-remove-value aria-label={ i18n.T(ctx, "contacts.edit.remove_phone") }>
						@icon.X(icon.Props{Class: "mx-auto size-4"})
					</button>
				</div>
			}
		</div>
	</div>
}

templ ContactEditorHeader(contact *models.Contact, profile *models.ContactProfile, accounts []models.Account) {
	<div class="contact-editor-header shrink-0 border-b border-ink/10 bg-paper/70 px-5 py-4 sm:px-7">
		<div class="contact-editor-header-inner flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
			<div class="contact-header-identity flex min-w-0 items-start gap-4">
				if contact != nil {
					@ContactHeaderAvatar(*contact)
				} else {
					<div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-ink/[0.06] text-muted-foreground shadow-[0_8px_22px_rgba(0,0,0,0.12)]">
						@icon.UserPlus(icon.Props{Class: "size-6"})
					</div>
				}
				<div class="min-w-0 pt-0.5">
					<div class="flex flex-wrap items-center gap-2">
						<h1 class="min-w-0 text-2xl font-bold leading-tight tracking-tight text-ink" style="font-family: var(--font-serif)">
							if contact != nil {
								{ contact.Name }
							} else {
								{ i18n.T(ctx, "contacts.new") }
							}
						</h1>
					</div>
					<div class="mt-1 text-sm text-muted-foreground">
						if contact != nil && contact.TrashedAt != "" {
							<span class="inline-flex items-center gap-1.5" data-contact-trash-status>
								@icon.Trash2(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "contacts.view.in_trash") }
							</span>
						} else if contact != nil {
							{ i18n.T(ctx, "contacts.view.entry") }
						} else {
							{ i18n.T(ctx, "contacts.view.new_hint") }
						}
					</div>
				</div>
			</div>
			<div class="contact-header-actions flex flex-wrap items-center gap-2 xl:justify-end">
				<button type="button" class="contact-header-back hidden" data-on-click='["closeMobileContactView"]' aria-label={ i18n.T(ctx, "contacts.view.back") }>
					@icon.ArrowLeft(icon.Props{Class: "size-5"})
				</button>
				<div class="contact-header-spacer hidden"></div>
				if contact != nil && contact.TrashedAt != "" {
					<div class="flex shrink-0 items-center gap-2">
					<button type="button" class="inline-flex h-9 items-center gap-1.5 rounded-md border border-ink/10 bg-ink/[0.025] px-3 text-sm font-semibold text-muted-foreground transition-colors hover:bg-ink/[0.06] hover:text-ink" data-contact-restore={ contact.ID } data-contact-name={ contact.Name }>
						@icon.Undo2(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "contacts.action.restore") }
					</button>
					<a href={ fmt.Sprintf("/api/contacts/%s/export", contact.ID) } class="size-9 rounded-md flex items-center justify-center text-muted-foreground hover:text-ink hover:bg-ink/5 transition-colors" aria-label={ i18n.T(ctx, "contacts.action.export") }>
						@icon.Download(icon.Props{Class: "size-4"})
					</a>
					<button type="button" class="inline-flex h-9 items-center gap-1.5 rounded-md px-3 text-sm font-semibold text-muted-foreground transition-colors hover:text-destructive hover:bg-destructive/10" data-contact-delete-forever={ contact.ID } data-contact-name={ contact.Name } data-contact-email={ strings.TrimSpace(contact.Email) } data-contact-synced={ fmt.Sprintf("%t", len(contact.SourceBooks) > 0) }>
						@icon.Trash2(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "contacts.action.delete_forever") }
					</button>
					</div>
				} else if contact != nil {
					{{ editDialogID := contactEditDialogID(*contact) }}
					@dialog.Trigger(dialog.TriggerProps{For: editDialogID}) {
						<button type="button" class="inline-flex h-9 items-center gap-1.5 rounded-md border border-ink/10 bg-ink/[0.025] px-3 text-sm font-semibold text-muted-foreground transition-colors hover:bg-ink/[0.06] hover:text-ink" aria-label={ i18n.T(ctx, "contacts.action.edit_label") } data-contact-edit-trigger data-contact-edit-dialog={ editDialogID }>
							@icon.Pencil(icon.Props{Class: "size-3.5"})
							{ i18n.T(ctx, "contacts.action.edit") }
						</button>
					}
					if strings.TrimSpace(contact.Email) != "" {
						<a href={ "mailto:" + contact.Email } class="size-9 rounded-md flex items-center justify-center text-muted-foreground hover:text-ink hover:bg-ink/5 transition-colors" aria-label={ i18n.T(ctx, "contacts.action.email") }>
							@icon.Mail(icon.Props{Class: "size-4"})
						</a>
					}
					<a href={ fmt.Sprintf("/api/contacts/%s/export", contact.ID) } class="size-9 rounded-md flex items-center justify-center text-muted-foreground hover:text-ink hover:bg-ink/5 transition-colors" aria-label={ i18n.T(ctx, "contacts.action.export") }>
						@icon.Download(icon.Props{Class: "size-4"})
					</a>
					<button type="submit" form={ "delete-contact-" + contact.ID } class="size-9 rounded-md flex items-center justify-center text-muted-foreground hover:text-destructive hover:bg-destructive/10 transition-colors" aria-label={ i18n.T(ctx, "contacts.action.trash") }>
						@icon.Trash2(icon.Props{Class: "size-4"})
					</button>
				}
			</div>
		</div>
	</div>
}

templ ContactEditDialog(contact models.Contact, profile *models.ContactProfile, accounts []models.Account) {
	{{ dialogID := contactEditDialogID(contact) }}
	@dialog.Dialog(dialog.Props{ID: dialogID, DisableClickAway: true, DisableESC: true}) {
		@dialog.Content(dialog.ContentProps{HideCloseButton: true, Class: "mobile-fullscreen-dialog max-h-[calc(100vh-2rem)] sm:max-w-3xl [&_[data-tui-dialog-panel]]:gap-0 [&_[data-tui-dialog-panel]]:p-0"}) {
			<form
				id={ "contact-edit-form-" + contact.ID }
				action={ contactFormAction(&contact) }
				method="post"
				class="grid max-h-[calc(100vh-2rem)] min-h-0 grid-rows-[auto_minmax(0,1fr)_auto]"
				data-contact-editor-form
				data-contact-edit-form
				data-contact-id={ contact.ID }
				data-contact-edit-dialog={ dialogID }
			>
				<div class="flex items-start justify-between gap-4 border-b border-ink/10 px-5 py-4 sm:px-6">
					@dialog.Header(dialog.HeaderProps{Class: "min-w-0"}) {
						@dialog.Title(dialog.TitleProps{Class: "truncate text-xl font-semibold text-ink"}) {
							{ i18n.T(ctx, "contacts.edit.title", "name", contactDisplay(contact)) }
						}
						@dialog.Description(dialog.DescriptionProps{Class: "text-sm text-muted-foreground"}) {
							{ i18n.T(ctx, "contacts.edit.description") }
						}
					}
					<button type="button" class="flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-ink/[0.06] hover:text-ink" aria-label={ i18n.T(ctx, "contacts.edit.close") } data-contact-editor-cancel>
						@icon.X(icon.Props{Class: "size-4"})
					</button>
				</div>
				<div class="min-h-0 space-y-5 overflow-y-auto px-5 py-5 sm:px-6">
					@ContactEditorCoreFields(&contact)
					@ContactEditSyncPanel(&contact, profile, accounts)
				</div>
				<div class="flex flex-col-reverse gap-2 border-t border-ink/10 bg-paper/90 px-5 py-3 backdrop-blur sm:flex-row sm:items-center sm:justify-end sm:px-6">
					<button type="button" class="inline-flex h-9 items-center justify-center rounded-lg border border-ink/10 bg-paper px-4 text-sm font-semibold text-muted-foreground transition-colors hover:bg-ink/[0.04] hover:text-ink" data-contact-editor-cancel>{ i18n.T(ctx, "common.cancel") }</button>
					<button type="submit" class="btn-skeuo inline-flex h-9 items-center justify-center gap-1.5 rounded-lg px-4 text-sm font-semibold">
						@icon.Save(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "contacts.edit.save") }
					</button>
				</div>
			</form>
		}
	}
}

templ ContactEditSyncPanel(contact *models.Contact, profile *models.ContactProfile, accounts []models.Account) {
	<section class="rounded-lg border border-ink/10 bg-ink/[0.02]">
		<div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 px-4 py-3">
			<div class="inline-flex items-center gap-2">
				@icon.Route(icon.Props{Class: "size-3.5 text-muted-foreground"})
				<h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.sync.title") }</h2>
			</div>
			<div class="flex items-center gap-2">
				<span class={ contactSyncEnabledBadgeClass(contactProfileSyncEnabled(profile)) } data-contact-sync-state-label>
					{ contactProfileSyncLabel(ctx, profile) }
				</span>
				@switchcomp.Switch(switchcomp.Props{
					ID: contactSyncEnabledID(contact),
					Name: "sync_enabled",
					Checked: contactProfileSyncEnabled(profile),
					Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "contacts.sync.enable"), "data-contact-sync-enabled": ""},
				})
			</div>
		</div>
		<div class="space-y-4 p-4">
			<div class="rounded-md border border-ink/10 bg-paper/35 px-3 py-2.5">
				<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.filters.origin") }</div>
				if profile != nil {
					<div class="mt-1 text-sm font-semibold text-ink">{ contactSourceLabel(ctx, profile.Origin, profile.Origin == "manual", accounts) }</div>
				} else {
					<div class="mt-1 text-sm font-semibold text-ink">{ i18n.T(ctx, "contacts.origin.manual") }</div>
				}
				<p class="mt-2 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "contacts.sync.origin_help") }</p>
			</div>
			<div class="w-full">@ContactSyncTargetsSelect(contact, accounts, contactProfileSyncEnabled(profile))</div>
		</div>
	</section>
}

templ ContactHeaderAvatar(contact models.Contact) {
	if strings.TrimSpace(contact.AvatarURL) != "" {
		{{ dialogID := contactAvatarPreviewDialogID(contact) }}
		@dialog.Trigger(dialog.TriggerProps{For: dialogID, Class: "inline-flex shrink-0"}) {
			<button
				type="button"
				class="group relative inline-flex size-14 shrink-0 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
				aria-label={ i18n.T(ctx, "contacts.avatar.view") }
				data-contact-avatar-preview-trigger
				data-contact-avatar-preview-dialog={ dialogID }
				data-contact-avatar-preview-alt={ i18n.T(ctx, "contacts.avatar.alt", "name", contactDisplay(contact)) }
				data-contact-avatar-preview-src={ contactAvatarRenderURL(contactAvatarPreviewURL(contact.AvatarURL)) }
			>
				<span class="relative block size-14 overflow-hidden rounded-full text-base font-bold shadow-[0_8px_22px_rgba(0,0,0,0.16)] ring-1 ring-ink/0 transition group-hover:ring-ink/20 group-focus-visible:ring-ink/25" data-contact-avatar data-avatar-hash={ contact.AvatarHash } data-avatar-email={ contact.Email }>
					<span class={ contactAvatarFallbackClass(contact, "bg-gradient-to-b from-amber-700/70 to-amber-900/70 text-amber-100") } data-avatar-fallback>{ contact.Initials }</span>
					<img
						src={ contactAvatarRenderURL(contact.AvatarURL) }
						alt={ contactDisplay(contact) }
						decoding="async"
						data-avatar-image
						data-avatar-source={ contact.AvatarSource }
						class={ contactAvatarImageClass(contact) }
					/>
					<span class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-full bg-ink/0 text-white opacity-0 transition group-hover:bg-ink/25 group-hover:opacity-100 group-focus-visible:bg-ink/25 group-focus-visible:opacity-100">
						@icon.Search(icon.Props{Class: "size-4 drop-shadow"})
					</span>
				</span>
			</button>
		}
		@ContactAvatarPreviewDialog(contact, dialogID)
	} else {
		@ContactAvatar(contact, "size-14 rounded-full text-base font-bold shrink-0 shadow-[0_8px_22px_rgba(0,0,0,0.16)]", "bg-gradient-to-b from-amber-700/70 to-amber-900/70 text-amber-100")
	}
}

templ ContactAvatarPreviewDialog(contact models.Contact, dialogID string) {
	@dialog.Dialog(dialog.Props{ID: dialogID}) {
		@dialog.Content(dialog.ContentProps{HideCloseButton: true, Class: "aspect-square w-[min(92vw,72vh,42rem)] max-w-[min(92vw,72vh,42rem)] overflow-visible border-0 bg-transparent p-0 text-ink shadow-none sm:max-w-[min(92vw,72vh,42rem)] [&_[data-tui-dialog-panel]]:!size-full [&_[data-tui-dialog-panel]]:!gap-0 [&_[data-tui-dialog-panel]]:!p-0"}) {
			@dialog.Title(dialog.TitleProps{Class: "sr-only"}) {
				{ i18n.T(ctx, "contacts.avatar.title") }
			}
			<div class="relative size-full">
				<div class="size-full overflow-hidden rounded-full bg-ink/5 shadow-[0_18px_45px_rgba(0,0,0,0.22)] ring-1 ring-ink/10">
					<img
						alt={ i18n.T(ctx, "contacts.avatar.alt", "name", contactDisplay(contact)) }
						decoding="async"
						data-contact-avatar-preview-image
						class="block size-full object-cover"
					/>
				</div>
				@dialog.Close(dialog.CloseProps{For: dialogID}) {
					<button type="button" class="absolute right-4 top-4 z-10 flex size-9 shrink-0 items-center justify-center rounded-full bg-paper/90 text-muted-foreground shadow-sm ring-1 ring-ink/10 backdrop-blur transition-colors hover:bg-paper hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-ink/20" aria-label={ i18n.T(ctx, "contacts.avatar.close") }>
						@icon.X(icon.Props{Class: "size-4"})
					</button>
				}
			</div>
		}
	}
}

templ ContactEditorSaveActions() {
	<div class="sticky bottom-0 z-10 flex items-center justify-end gap-3 border-t border-ink/10 bg-paper/90 px-5 py-3 backdrop-blur sm:px-7">
		<button type="submit" class="btn-skeuo inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-semibold">
			@icon.Save(icon.Props{Class: "size-4"})
			{ i18n.T(ctx, "contacts.edit.save_contact") }
		</button>
	</div>
}

templ ContactLegacySourcePanel(contact *models.Contact, accounts []models.Account) {
	<section class="rounded-lg border border-ink/10 bg-ink/[0.02]">
		<div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 px-4 py-3">
			<div class="inline-flex items-center gap-2">
				@icon.Route(icon.Props{Class: "size-3.5 text-muted-foreground"})
				<h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.sync.title") }</h2>
			</div>
			<div class="flex items-center gap-2">
				<span class={ contactSyncEnabledBadgeClass(contact != nil && contact.GoferSyncEnabled) } data-contact-sync-state-label>
					{ contactSyncLabel(ctx, contact) }
				</span>
				@switchcomp.Switch(switchcomp.Props{
					ID: contactSyncEnabledID(contact),
					Name: "sync_enabled",
					Checked: contact != nil && contact.GoferSyncEnabled,
					Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "contacts.sync.enable"), "data-contact-sync-enabled": ""},
				})
			</div>
		</div>
		<div class="space-y-4 p-4">
			<div class="rounded-md border border-ink/10 bg-paper/35 px-3 py-2.5">
				<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.sync.source") }</div>
				if contact != nil && len(contact.SourceBooks) > 0 {
					<div class="mt-2 flex flex-wrap gap-1.5">
						for _, book := range contact.SourceBooks {
							<span class="rounded border border-ink/10 bg-ink/[0.04] px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ book.AccountName } / { contactAddressBookDisplayName(ctx, book) }</span>
						}
					</div>
				} else {
					<div class="mt-1 text-sm font-medium text-ink">Gofer</div>
					<div class="mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "contacts.sync.local_editable") }</div>
				}
			</div>
			<div class="w-full">
				@ContactSyncTargetsSelect(contact, accounts, contact != nil && contact.GoferSyncEnabled)
			</div>
		</div>
	</section>
}

templ ContactProfileInsight(profile models.ContactProfile, contact *models.Contact, accounts []models.Account) {
	<section class="w-full rounded-lg border border-ink/10 bg-ink/[0.02]">
		<div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 px-4 py-3">
			<div class="inline-flex items-center gap-2">
				@icon.Route(icon.Props{Class: "size-3.5 text-muted-foreground"})
				<h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.sync.title") }</h2>
			</div>
			<span class={ contactSyncEnabledBadgeClass(profile.SyncEnabled) }>{ contactUnifiedStatusLabel(ctx, profile) }</span>
		</div>
		<div class="space-y-4 p-4">
			<div class="rounded-md border border-ink/10 bg-paper/35 px-3 py-2.5">
				<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.filters.origin") }</div>
				<div class="mt-1 text-sm font-semibold text-ink">{ contactSourceLabel(ctx, profile.Origin, profile.Origin == "manual", accounts) }</div>
				<p class="mt-2 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "contacts.sync.origin_help_profile") }</p>
			</div>
			<div class="w-full">@ContactSyncTargetsSelect(contact, accounts, profile.SyncEnabled)</div>
		</div>
	</section>
}

templ ContactSyncStatusNotice(contact models.Contact) {
	<div class={ "flex flex-col gap-1 rounded-lg border px-3 py-2 text-xs " + contactSyncStatusClass(contact.SyncStatus) }>
		<div class="flex items-center justify-between gap-3">
			<span class="font-semibold">{ contactSyncStatusLabel(ctx, contact.SyncStatus) }</span>
			if contact.SyncUpdatedAt != "" {
				<span class="text-[11px] opacity-70">{ contact.SyncUpdatedAt }</span>
			}
		</div>
		if contact.SyncStatus == "error" && contact.SyncError != "" {
			<p class="leading-relaxed opacity-80">{ i18n.ServerText(ctx, contact.SyncError) }</p>
		}
	</div>
}

templ ContactSyncTargetsSelect(contact *models.Contact, accounts []models.Account, syncEnabled bool) {
	<div class={ contactSyncTargetsClass(syncEnabled) } data-contact-sync-targets aria-disabled={ fmt.Sprintf("%t", !syncEnabled) }>
		<label class="mb-1.5 block text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.sync.locations") }</label>
		@selectbox.SelectBox(selectbox.Props{Multiple: true}) {
			@selectbox.Trigger(selectbox.TriggerProps{Name: "save_targets", Class: "h-10 border-ink/10 bg-ink/[0.04] text-ink", Multiple: true, ShowPills: true, DisableClear: true, SelectedCountText: i18n.T(ctx, "contacts.sync.locations_selected")}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "contacts.sync.no_locations"), Multiple: true, Class: "text-left"})
			}
			@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
				@selectbox.Item(selectbox.ItemProps{Value: "local", Selected: contactSaveTargetSelected(contact, "local")}) {
					{ i18n.T(ctx, "contacts.origin.local") }
				}
				for _, account := range accounts {
					if !account.IsDeleting && accountContactSyncCapable(account) {
						if len(account.ContactAddressBooks) == 0 {
							@selectbox.Item(selectbox.ItemProps{Value: contactSaveTargetValue(account), Selected: contactSaveTargetSelected(contact, contactSaveTargetValue(account))}) {
								{ accountContactSaveLabel(account) }
							}
						}
						for _, book := range account.ContactAddressBooks {
							@selectbox.Item(selectbox.ItemProps{Value: contactBookTargetValue(book), Selected: contactSaveTargetSelected(contact, contactBookTargetValue(book))}) {
								{ accountContactOriginLabel(ctx, account) } / { contactAddressBookDisplayName(ctx, book) }
							}
						}
					}
				}
			}
		}
		<p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "contacts.sync.locations_help") }</p>
	</div>
}

templ ContactSyncSetupDialog(setup models.ContactSyncSetup) {
	@dialog.Dialog(dialog.Props{ID: "contact-sync-setup-dialog", Open: true, DisableClickAway: true, DisableESC: true}) {
		@dialog.Content(dialog.ContentProps{HideCloseButton: true, Class: "max-h-[calc(100dvh-2rem)] overflow-hidden sm:max-w-4xl [&_[data-tui-dialog-panel]]:flex [&_[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] [&_[data-tui-dialog-panel]]:min-h-0 [&_[data-tui-dialog-panel]]:flex-col [&_[data-tui-dialog-panel]]:gap-0 [&_[data-tui-dialog-panel]]:overflow-hidden [&_[data-tui-dialog-panel]]:p-0"}) {
			@dialog.Header(dialog.HeaderProps{Class: "shrink-0 flex-row items-start justify-between gap-4 border-b border-ink/10 px-5 py-4 text-left sm:px-6"}) {
				<div>
					<div class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted-foreground">
						{ contactSyncSetupStep(ctx, setup.Phase) }
					</div>
					@dialog.Title(dialog.TitleProps{Class: "mt-1 text-lg text-ink"}) { { i18n.T(ctx, "contacts.setup.title") } }
					@dialog.Description(dialog.DescriptionProps{Class: "mt-1 max-w-2xl text-sm leading-relaxed text-muted-foreground"}) {
						if setup.Phase == "resolve" {
							{ i18n.T(ctx, "contacts.setup.resolve_description") }
						} else {
							{ i18n.T(ctx, "contacts.setup.discover_description") }
						}
					}
				</div>
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-8 shrink-0 text-muted-foreground hover:text-ink", Attributes: templ.Attributes{"data-contact-sync-setup-cancel": "", "aria-label": i18n.T(ctx, "contacts.setup.cancel")}}) {
					@icon.X(icon.Props{Class: "size-4"})
				}
			}
			<div class="flex min-h-0 flex-1 flex-col overflow-hidden" data-contact-sync-setup-body>
				if setup.Phase == "searching" {
					@ContactSyncSetupSearching(setup)
				} else if setup.Phase == "resolve" {
					@ContactSyncSetupResolve(setup)
				} else {
					@ContactSyncSetupDiscover(setup)
				}
			</div>
		}
	}
}

templ ContactSyncSetupSearching(setup models.ContactSyncSetup) {
	<div class="flex min-h-0 flex-1 items-center justify-center overflow-y-auto px-6 py-10" data-contact-sync-setup-auto-search={ fmt.Sprintf("/api/contacts/%s/sync-setup/findings?mode=automatic", setup.Contact.ID) }>
		<div class="max-w-sm text-center">
			<div class="mx-auto flex size-11 items-center justify-center rounded-full bg-ink/[0.04] text-muted-foreground">
				@icon.LoaderCircle(icon.Props{Class: "size-5 animate-spin"})
			</div>
			<div class="mt-4 text-sm font-semibold text-ink">{ i18n.T(ctx, "contacts.setup.searching") }</div>
			<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "contacts.setup.searching_detail") }</p>
		</div>
	</div>
}

templ ContactSyncSetupDiscover(setup models.ContactSyncSetup) {
	{{ selectionFormID := "contact-sync-setup-selection-" + setup.Contact.ID }}
	<div class="flex min-h-0 flex-1 flex-col">
		<div class="min-h-0 flex-1 overflow-y-auto px-5 py-5 sm:px-6">
			<form id={ selectionFormID } method="post" action={ fmt.Sprintf("/api/contacts/%s/sync-setup/preview", setup.Contact.ID) } class="space-y-3" data-contact-sync-setup-form>
			<div class="rounded-lg border border-ink/10 bg-paper/45 px-4 py-3">
				<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.origin.local") }</div>
				<div class="mt-1 text-sm font-semibold text-ink">{ contactDisplay(setup.Contact) }</div>
				<div class="text-xs text-muted-foreground">{ contactListDetail(setup.Contact) }</div>
			</div>
				for _, location := range setup.Locations {
					@ContactSyncSetupLocation(setup.Contact.ID, location)
				}
			</form>
		</div>
		@dialog.Footer(dialog.FooterProps{Class: "shrink-0 items-center justify-between bg-card px-5 py-4 sm:justify-between sm:px-6"}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Class: "text-muted-foreground", Attributes: templ.Attributes{"data-contact-sync-setup-cancel": ""}}) { { i18n.T(ctx, "contacts.setup.keep_disabled") } }
			@button.Button(button.Props{Type: button.TypeSubmit, Form: selectionFormID, Class: "btn-skeuo"}) {
				{ i18n.T(ctx, "contacts.setup.review") }
				@icon.ArrowRight(icon.Props{Class: "size-4"})
			}
		}
	</div>
}

templ ContactSyncSetupLocation(contactID string, location models.ContactSyncSetupLocation) {
	<div class="overflow-hidden rounded-lg border border-ink/10 bg-paper/45" data-contact-sync-setup-location={ location.AccountID }>
						<div class="flex items-center justify-between gap-3 border-b border-ink/10 px-4 py-3">
							<div>
								<div class="text-sm font-semibold text-ink">{ location.Label }</div>
								<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ location.Provider }</div>
							</div>
							<div class="flex items-center gap-2">
								if len(location.Candidates) == 0 {
									<span class="rounded-md bg-ink/[0.04] px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.setup.no_match") }</span>
								} else {
									<span class="rounded-md bg-ink/[0.04] px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.N(ctx, "contacts.setup.possible_matches", len(location.Candidates)) }</span>
								}
								@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Class: "text-xs text-muted-foreground", Attributes: templ.Attributes{"data-contact-sync-location-search-toggle": ""}}) {
									@icon.Search(icon.Props{Class: "size-3.5"})
									{ i18n.T(ctx, "contacts.setup.search_manually") }
								}
							</div>
						</div>
						<div class="hidden border-b border-ink/10 bg-ink/[0.02] px-4 py-3" data-contact-sync-location-search-panel data-contact-sync-location-search-url={ fmt.Sprintf("/api/contacts/%s/sync-setup/findings?mode=custom&account_id=%s", contactID, url.QueryEscape(location.AccountID)) }>
							<div class="flex flex-col gap-2 sm:flex-row">
								@input.Input(input.Props{Type: input.TypeSearch, Placeholder: i18n.T(ctx, "contacts.setup.search_placeholder"), Class: "h-9 bg-paper", Attributes: templ.Attributes{"data-contact-sync-location-search-query": ""}})
								@button.Button(button.Props{Variant: button.VariantOutline, Class: "text-muted-foreground", Attributes: templ.Attributes{"data-contact-sync-location-search-submit": ""}}) { { i18n.T(ctx, "contacts.setup.search_account") } }
							</div>
						</div>
					if location.Error != "" {
						<div class="border-b border-amber-500/15 bg-amber-500/[0.07] px-4 py-2 text-xs text-amber-800 dark:text-amber-200">{ location.Error }</div>
					}
					<div class="divide-y divide-ink/10">
						for index, candidate := range location.Candidates {
							<label class="grid cursor-pointer gap-3 px-4 py-3 transition-colors hover:bg-ink/[0.025] has-[:checked]:bg-primary/[0.045] sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-center">
								@radio.Radio(radio.Props{Name: "candidate_" + location.AccountID, Value: candidate.Key, Checked: contactSyncSetupCandidateChecked(location.Candidates, index)})
								<div class="min-w-0">
									<div class="truncate text-sm font-semibold text-ink">{ contactReadOnlyValue(ctx, candidate.Name) }</div>
									<div class="truncate text-xs text-muted-foreground">{ contactReadOnlyValue(ctx, candidate.Email) }</div>
									if candidate.Phone != "" || candidate.Organization != "" {
										<div class="mt-1 truncate text-[11px] text-muted-foreground">{ strings.Trim(strings.Join([]string{candidate.Phone, candidate.Organization}, " · "), " ·") }</div>
									}
								</div>
								<div class="flex flex-wrap items-center gap-1.5 sm:justify-end">
									if contactSyncSetupCandidateChecked(location.Candidates, index) {
										<span class="rounded-md bg-primary/10 px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-primary">{ i18n.T(ctx, "contacts.setup.recommended") }</span>
									}
									<span class="rounded-md border border-emerald-500/20 bg-emerald-500/10 px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-emerald-700">{ contactSyncSetupCandidateMatchLabel(ctx, candidate) }</span>
								</div>
							</label>
						}
						<label class="flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-ink/[0.025] has-[:checked]:bg-primary/[0.045]">
							@radio.Radio(radio.Props{Name: "candidate_" + location.AccountID, Value: "none", Checked: !contactSyncSetupHasRecommendedCandidate(location.Candidates)})
							<div class="min-w-0">
								if len(location.Candidates) == 0 {
									<div class="text-sm font-semibold text-ink/70">{ i18n.T(ctx, "contacts.setup.create_new") }</div>
								} else {
									<div class="text-sm font-semibold text-ink/70">{ i18n.T(ctx, "contacts.setup.none_same") }</div>
									<div class="mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "contacts.setup.none_same_detail") }</div>
								}
							</div>
						</label>
					</div>
	</div>
}

templ ContactSyncSetupResolve(setup models.ContactSyncSetup) {
	{{ resolverFields := contactProfileResolverFields(setup.ConflictFields) }}
	<form method="post" action={ fmt.Sprintf("/api/contacts/%s/sync-setup/confirm", setup.Contact.ID) } class="flex min-h-0 flex-1 flex-col" data-contact-sync-setup-confirm>
		<div class="min-h-0 overflow-y-auto px-5 py-5 sm:px-6">
			if len(resolverFields) == 0 {
				<div class="rounded-lg border border-emerald-500/20 bg-emerald-500/[0.07] px-4 py-5 text-center">
					@icon.CircleCheck(icon.Props{Class: "mx-auto size-6 text-emerald-700"})
					<div class="mt-2 text-sm font-semibold text-ink">{ i18n.T(ctx, "contacts.setup.no_conflicts") }</div>
					<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "contacts.setup.no_conflicts_detail") }</p>
				</div>
			} else {
				<div class="space-y-3">
					for _, kind := range contactProfileResolverKinds(resolverFields) {
						{{ groups := contactResolverValueGroups(resolverFields, kind) }}
						<div class="overflow-hidden rounded-lg border border-ink/10 bg-paper/45">
							<div class="border-b border-ink/10 px-4 py-3">
								<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ contactSyncSetupChoosePrimary(ctx, kind) }</div>
								<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ contactSyncSetupConflictHelp(ctx, kind) }</p>
							</div>
							<div class="divide-y divide-ink/10">
								for index, group := range groups {
									{{ inputID := fmt.Sprintf("contact-sync-primary-%s-%d", kind, index) }}
									{{ locationLabels := contactSyncSetupLocationLabels(ctx, group.Sources, setup.Locations) }}
									<div class="grid grid-cols-[auto_minmax(0,1fr)] items-start gap-3 px-4 py-3 transition-colors hover:bg-ink/[0.025] has-[:checked]:bg-primary/[0.045]">
										@radio.Radio(radio.Props{ID: inputID, Name: "preferred_" + kind, Value: group.Field.ID, Checked: contactResolverValueGroupChecked(groups, index), Class: "mt-0.5"})
										<div class="min-w-0">
											<label for={ inputID } class="block cursor-pointer break-all text-sm font-semibold leading-relaxed text-ink">{ group.Field.Value }</label>
											<div class="mt-1.5 flex flex-wrap items-center gap-2">
												if group.IsCanonicalPrimary {
													<span class="rounded-md border border-ink/10 bg-ink/[0.04] px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.setup.current_primary") }</span>
												}
												if len(locationLabels) > 0 {
													@ContactSyncSetupValueLocations(locationLabels)
												}
											</div>
										</div>
									</div>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>
		@dialog.Footer(dialog.FooterProps{Class: "shrink-0 items-center justify-between bg-card px-5 py-4 sm:justify-between sm:px-6"}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Class: "text-muted-foreground", Attributes: templ.Attributes{"data-contact-sync-setup-cancel": ""}}) { { i18n.T(ctx, "contacts.setup.keep_disabled") } }
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "btn-skeuo"}) {
				@icon.CloudSync(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "contacts.setup.confirm") }
			}
		}
	</form>
}

templ ContactSyncSetupValueLocations(labels []string) {
	@popover.Root(popover.RootProps{Class: "inline-flex"}) {
		@popover.Trigger() {
			<button type="button" class="inline-flex items-center gap-1 rounded-md px-1 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground transition-colors hover:bg-ink/[0.05] hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/20" aria-label={ i18n.T(ctx, "contacts.setup.found_in_show", "found", contactSyncSetupLocationCountLabel(ctx, len(labels))) }>
				@icon.MapPin(icon.Props{Class: "size-3 shrink-0"})
				{ contactSyncSetupLocationCountLabel(ctx, len(labels)) }
			</button>
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, Offset: 8, ShowArrow: true, Class: "w-72 border-ink/10 bg-card p-3 text-ink shadow-raised"}) {
			<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.setup.value_locations") }</div>
			<div class="mt-2 space-y-1.5">
				for _, label := range labels {
					<div class="flex min-w-0 items-start gap-2 rounded-md bg-ink/[0.035] px-2.5 py-2">
						@icon.MapPin(icon.Props{Class: "mt-0.5 size-3.5 shrink-0 text-muted-foreground"})
						<span class="min-w-0 break-words text-xs font-medium leading-relaxed text-ink/65">{ label }</span>
					</div>
				}
			</div>
		}
	}
}

templ ContactSyncQueuedNotice() {
	<div class="flex items-start gap-2 rounded-lg border border-emerald-500/20 bg-emerald-500/10 px-3 py-2 text-xs text-emerald-800">
		@icon.CloudSync(icon.Props{Class: "mt-0.5 size-3.5 shrink-0"})
		<div class="min-w-0">
			<div class="font-semibold">{ i18n.T(ctx, "contacts.sync.queued") }</div>
			<p class="mt-0.5 leading-relaxed opacity-80">{ i18n.T(ctx, "contacts.sync.queued_detail") }</p>
		</div>
	</div>
}

templ ContactLabelSelect(name string, value string, options []string, ariaLabel string) {
	<div class="w-24 shrink-0" aria-label={ ariaLabel }>
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{Name: name, Class: "h-10 border-ink/10 bg-ink/[0.04] px-2 text-xs font-medium uppercase tracking-wide text-muted-foreground", DisableClear: true}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: contactLabelName(ctx, value), Class: "text-xs font-medium uppercase tracking-wide text-muted-foreground"})
			}
			@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "min-w-24"}) {
				for _, option := range options {
					@selectbox.Item(selectbox.ItemProps{Value: option, Selected: option == value, Class: "text-xs uppercase tracking-wide"}) {
						{ contactLabelName(ctx, option) }
					}
				}
			}
		}
	</div>
}

templ ContactProfileInsights(insights []models.ContactInsight) {
	<div class="space-y-2">
		<div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
			@icon.Lightbulb(icon.Props{Class: "size-3.5"})
			{ i18n.T(ctx, "contacts.insight.title") }
		</div>
		<div class="grid gap-2">
			for _, insight := range insights {
				<div class={ "rounded-md border px-3 py-2.5 " + contactInsightSeverityClass(insight.Severity) }>
					<div class="flex items-start justify-between gap-3">
						<div class="min-w-0">
							<div class="text-sm font-semibold">{ contactInsightDisplayTitle(ctx, insight) }</div>
							if contactInsightDisplayMessage(ctx, insight) != "" {
								<p class="mt-0.5 text-xs leading-relaxed opacity-80">{ contactInsightDisplayMessage(ctx, insight) }</p>
							}
						</div>
						if insight.Count > 0 {
							<span class="shrink-0 rounded border border-current/15 px-1.5 py-0.5 text-[10px] font-semibold tabular-nums opacity-80">{ fmt.Sprintf("%d", insight.Count) }</span>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

templ ContactProfileSyncTargetRow(card models.ContactCard, accounts []models.Account) {
	<div class="rounded-md border border-ink/10 bg-paper/45 px-3 py-2.5">
		<div class="flex min-w-0 items-center gap-2">
			@icon.CloudUpload(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
			<div class="truncate text-sm font-semibold text-ink">{ contactCardAccountLabel(ctx, card, accounts) }</div>
		</div>
		<div class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "contacts.sync.target_help") }</div>
	</div>
}

templ ContactProfileSourceRow(card models.ContactCard, accounts []models.Account) {
	<div class="rounded-md border border-ink/10 bg-paper/45 px-3 py-2.5">
		<div class="flex min-w-0 items-center gap-2">
			if card.Kind == "provider" {
				@icon.CloudSync(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
			} else if card.Kind == "target" {
				@icon.Route(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
			} else if card.Kind == "observed" {
				@icon.MailSearch(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
			} else {
				@icon.IdCard(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
			}
			<div class="truncate text-sm font-semibold text-ink">
				if card.Kind == "provider" {
					{ contactCardAccountLabel(ctx, card, accounts) }
				} else {
					{ contactCardKindLabel(ctx, card) }
				}
			</div>
		</div>
		<div class="mt-1 text-xs leading-relaxed text-muted-foreground">{ contactSourceDescription(ctx, card, accounts) }</div>
	</div>
}

templ ContactProfileCardRow(card models.ContactCard, accounts []models.Account) {
	<div class="rounded-md border border-ink/10 bg-paper/35 px-3 py-2.5">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="flex min-w-0 items-center gap-2">
					if card.Kind == "provider" {
						@icon.CloudSync(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
					} else if card.Kind == "target" {
						@icon.Route(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
					} else {
						@icon.IdCard(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
					}
					<div class="truncate text-sm font-semibold text-ink">{ contactCardKindLabel(ctx, card) }</div>
				</div>
				<div class="mt-1 truncate text-xs text-muted-foreground">{ contactCardAccountLabel(ctx, card, accounts) }</div>
			</div>
			if card.Etag != "" {
				<span class="shrink-0 rounded border border-ink/10 bg-ink/[0.04] px-1.5 py-0.5 text-[10px] font-semibold text-muted-foreground">etag</span>
			}
		</div>
		if card.RemoteID != "" {
			<div class="mt-2 truncate rounded border border-ink/10 bg-ink/[0.025] px-2 py-1 font-mono text-[10px] text-muted-foreground">{ card.RemoteID }</div>
		}
	</div>
}

templ ContactProfileFieldRow(field models.ContactField, accounts []models.Account) {
	<div class="rounded-md border border-ink/10 bg-paper/35 px-3 py-2.5">
		<div class="flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="flex min-w-0 items-center gap-2">
					if field.Kind == "email" {
						@icon.Mail(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
					} else if field.Kind == "phone" {
						@icon.Phone(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
					} else {
						@icon.BadgeInfo(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
					}
					<div class="truncate text-sm font-semibold text-ink">{ field.Value }</div>
				</div>
				<div class="mt-1 flex flex-wrap items-center gap-1.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
					<span>{ contactFieldKindLabel(ctx, field.Kind) }</span>
					if contactFieldDisplayLabel(field) != "" {
						<span>{ contactLabelName(ctx, contactFieldDisplayLabel(field)) }</span>
					}
					if field.IsPrimary {
						<span class="rounded border border-emerald-500/20 bg-emerald-500/10 px-1.5 py-0.5 text-emerald-700">{ i18n.T(ctx, "contacts.label.primary") }</span>
					}
					<span class="rounded border border-ink/10 bg-ink/[0.04] px-1.5 py-0.5">{ contactFieldSourceDisplay(ctx, field.Source, accounts) }</span>
				</div>
			</div>
			<div class="flex shrink-0 items-center gap-1.5">
				<span class="text-[10px] tabular-nums text-muted-foreground">{ fmt.Sprintf("%.0f%%", field.Confidence*100) }</span>
			</div>
		</div>
	</div>
}

func contactRecentActivityURL(contactID string) string {
	values := url.Values{}
	values.Set("partial", "activity")
	values.Set("contact", contactID)
	return "/contacts?" + values.Encode()
}

func contactActivityMailURL(email string) string {
	values := url.Values{}
	values.Set("participant", strings.TrimSpace(email))
	return "/?" + values.Encode()
}

templ ContactRecentActivityHeader(contact models.Contact) {
	<div class="mb-3 flex items-center justify-between gap-3">
		<div>
			<h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.activity.recent") }</h2>
			<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "contacts.activity.recent_detail") }</p>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			<span class="rounded bg-ink/[0.05] px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "contacts.activity.top") }</span>
			if strings.TrimSpace(contact.Email) != "" {
				{{ activityURL := contactActivityMailURL(contact.Email) }}
				@button.Button(button.Props{
					Href: activityURL,
					Variant: button.VariantOutline,
					Size: button.SizeSm,
					Class: "h-7 gap-1.5 border-ink/10 bg-paper/45 px-2.5 text-xs text-muted-foreground shadow-none",
					Attributes: templ.Attributes{
						"data-sidebar-app-button": "mail",
						"hx-get": activityURL,
						"hx-target": "#mail-list",
						"hx-select": "#mail-list",
						"hx-select-oob": "#sidebar-app-body:outerHTML,#sidebar-sync-controls:outerHTML,#mail-view:outerHTML,#app-pane-dialogs:outerHTML",
						"hx-swap": "outerHTML",
						"hx-push-url": activityURL,
					},
				}) {
					{ i18n.T(ctx, "contacts.activity.see_all") }
					@icon.ArrowRight(icon.Props{Class: "size-3.5"})
				}
			}
		</div>
	</div>
}

templ ContactRecentActivityLoader(contact models.Contact) {
	<div
		class="w-full rounded-lg border border-ink/10 bg-ink/[0.025] p-4"
		hx-get={ templ.URL(contactRecentActivityURL(contact.ID)) }
		hx-trigger="load"
		hx-target="this"
		hx-swap="outerHTML"
		aria-busy="true"
		data-contact-recent-activity-loading
	>
		@ContactRecentActivityHeader(contact)
		<div class="overflow-hidden rounded-md border border-ink/10 bg-paper/35">
			for i := 0; i < 4; i++ {
				<div class="border-b border-ink/10 px-3 py-2.5 last:border-b-0">
					<div class="flex items-start justify-between gap-3">
						<div class="min-w-0 flex flex-1 items-center gap-2">
							<div class="h-5 w-9 shrink-0 rounded border border-ink/10 bg-ink/[0.04] animate-pulse"></div>
							<div class="h-3 min-w-0 flex-1 rounded bg-ink/5 animate-pulse"></div>
						</div>
						<div class="h-3 w-16 shrink-0 rounded bg-ink/5 animate-pulse"></div>
					</div>
					<div class="mt-2 h-3 w-4/5 rounded bg-ink/5 animate-pulse"></div>
				</div>
			}
		</div>
	</div>
}

templ ContactRecentActivity(contact models.Contact, emails []models.Email) {
	<div class="w-full rounded-lg border border-ink/10 bg-ink/[0.025] p-4">
		@ContactRecentActivityHeader(contact)
		if len(emails) == 0 {
			<div class="rounded-md border border-dashed border-ink/10 px-3 py-4 text-sm text-muted-foreground">{ i18n.T(ctx, "contacts.activity.none") }</div>
		} else {
			<div class="divide-y divide-ink/10 overflow-hidden rounded-md border border-ink/10 bg-paper/35">
				for _, email := range emails {
					<a href={ contactActivityHref(email) } class="group flex items-start gap-3 px-3 py-2.5 transition-colors hover:bg-ink/[0.035]">
						<div class="min-w-0 flex-1">
							<div class="flex items-start justify-between gap-3">
								<div class="min-w-0 flex items-center gap-2">
									<span class="shrink-0 rounded border border-ink/10 bg-ink/[0.04] px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-muted-foreground">{ contactActivityDirection(ctx, contact, email) }</span>
									<p class="truncate text-sm font-semibold text-ink group-hover:text-ink">{ contactActivitySubject(ctx, email) }</p>
								</div>
								<span class="shrink-0 text-xs tabular-nums text-muted-foreground">{ email.Date }</span>
							</div>
							if email.Preview != "" {
								<p class="mt-0.5 line-clamp-1 text-xs leading-relaxed text-muted-foreground">{ i18n.Preview(ctx, email.Preview) }</p>
							}
						</div>
					</a>
				}
			</div>
		}
	</div>
}

// contactActiveFilterPill is one active filter in the strip under the search,
// the mail list's pill. Choosing it removes that filter.
// contactActiveFilterPill is a pill that drops its filter, with a tooltip
// for the whole text, which a long pill cuts short.
templ contactActiveFilterPill(name string, text string) {
	@tooltip.Tooltip() {
		@tooltip.Trigger() {
			<button type="button" data-contact-active-filter-remove={ name } data-contact-active-filter-key={ name + ":" + text } aria-label={ i18n.T(ctx, "contacts.filters.remove_pill", "filter", text) } class="mail-active-filter-pill mail-active-filter-pill-stable">
				<span class="mail-active-filter-pill-label">{ text }</span>
				<span class="mail-active-filter-pill-remove">x</span>
			</button>
		}
		// The pill row keeps its text on one line; the tooltip wraps instead.
		@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionBottom, ShowArrow: true, Class: "max-w-[min(28rem,calc(100vw-2rem))] whitespace-normal break-words"}) {
			<span data-contact-active-filter-tooltip>{ text }</span>
		}
	}
}

// The filter pills name every value of their filter.
func contactPlaceFilterLabels(ctx context.Context, filter string, accounts []models.Account) string {
	var labels []string
	for _, value := range models.ContactFilterValues(filter) {
		labels = append(labels, contactSaveTargetLabel(ctx, value, accounts))
	}
	return strings.Join(labels, ", ")
}

func contactOriginFilterLabels(ctx context.Context, filter string, accounts []models.Account) string {
	var labels []string
	for _, value := range models.ContactFilterValues(filter) {
		labels = append(labels, contactOriginFilterLabel(ctx, value, accounts))
	}
	return strings.Join(labels, ", ")
}

func contactActivityFilterLabels(ctx context.Context, filter string) string {
	var labels []string
	for _, value := range models.ContactFilterValues(filter) {
		labels = append(labels, contactActivityFilterLabel(ctx, value))
	}
	return strings.Join(labels, ", ")
}

func contactActivityFilterLabel(ctx context.Context, activity string) string {
	if activity == "seen" {
		return i18n.T(ctx, "contacts.filters.seen")
	}
	return i18n.T(ctx, "contacts.filters.no_messages")
}
