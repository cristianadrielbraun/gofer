func contactFormAction(contact *models.Contact) string {
	if contact != nil && contact.ID != "" {
		return "/api/contacts?id=" + contact.ID
	}
	return "/api/contacts"
}

func contactAvatarPreviewDialogID(contact models.Contact) string {
	id := strings.TrimSpace(contact.ID)
	if id == "" {
		id = "selected"
	}
	return "contact-avatar-preview-" + id
}

func contactEditDialogID(contact models.Contact) string {
	id := strings.TrimSpace(contact.ID)
	if id == "" {
		id = "selected"
	}
	return "contact-edit-" + id
