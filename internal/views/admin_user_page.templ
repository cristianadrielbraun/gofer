package views

import (
	"context"
	"net/url"
	"time"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/tabs"
	"github.com/cristianadrielbraun/gofer/internal/audit"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// A person's page has a tab for each part of what the console knows about
// them; each tab is an address of its own.
const (
	AdminUserTabOverview = ""
	AdminUserTabSignIn   = "sign-in"
	AdminUserTabSessions  = "sessions"
	AdminUserTabMailboxes = "mailboxes"
	AdminUserTabActivity  = "activity"
)

// AdminUserPagePath is tab of the person with userID's page. list is the
// Users list it was opened from, which its way back returns to.
func AdminUserPagePath(userID, tab, list string) string {
	path := "/admin/users/" + userID
	if tab != AdminUserTabOverview {
		path += "/" + tab
	}
	if list != "" && list != "/admin/users" {
		path += "?list=" + url.QueryEscape(list)
	}
	return path
}

// AdminUserPageData is one person's page: the list's row, which the header
// and the actions menu are drawn from, and how they sign in.
type AdminUserPageData struct {
	User AdminUserData
	Tab  string
	// ListPath is the Users list the page was opened from.
	ListPath string
	Dialog   *AdminUserDialog
	// Invitation and CredentialReset are what a change made from the page
	// issued, shown once.
	Invitation      *AdminUserInvitationData
	CredentialReset *AdminUserCredentialResetData

	CreatedAt         time.Time
	DisabledAt        *time.Time
	DeletionStartedAt *time.Time

	PasswordChangedAt          *time.Time
	Passkeys                   int
	PasskeyLastUsedAt          *time.Time
	AuthenticatorAppSince      *time.Time
	AuthenticatorAppLastUsedAt *time.Time
	RecoveryCodesLeft          int
	Identities                 []AdminUserIdentityData
	WorkingSessions            int

	// Sessions are the places they're signed in, on the Sessions tab.
	Sessions []AdminUserSessionData
	// Mailboxes are the mail accounts they added, on the Mailboxes tab.
	// HasMailboxes is false for someone who has no mail of their own
	// (administrators) or whose data is being deleted.
	Mailboxes    []AdminUserMailboxData
	HasMailboxes bool
	// On the Activity tab: the newest sign-in and security events about
	// them, the administrative changes made to them and, for an
	// administrator, the ones they made.
	SecurityEvents []AdminSecurityActivityEventData
	Changes        []audit.Record
	ChangesMade    []audit.Record
	ShowChangesMade bool

	StepUpRequired bool
	// Groups are the groups they're in; administrators can't be in one.
	Groups []AdminGroupRef
}

// AdminUserMailboxData is one mail account the person added.
type AdminUserMailboxData struct {
	Provider    string
	Email       string
	DisplayName string
	// Servers are where it connects, one per service: "IMAP", "imap.example.org:993".
	Servers     []AdminUserMailboxServer
	SyncEnabled bool
	SyncError   string
	SyncErrorAt *time.Time
	Proxy       string
	Hidden      bool
	CreatedAt   time.Time
	// Refusal says why the allowed servers would refuse it; empty when
	// they allow it. Unlimited says the lists don't limit this person.
	Refusal   string
	Unlimited bool
}

// AdminUserMailboxServer is one service a mailbox connects to.
type AdminUserMailboxServer struct {
	Service string
	Address string
}

// AdminUserSessionData is one place the person is signed in.
type AdminUserSessionData struct {
	UserAgent       string
	Authentication  string
	Assurance       string
	AuthenticatedAt time.Time
	LastUsedAt      time.Time
	ExpiresAt       time.Time
	// SignOutPath ends this session alone; empty when the administrator
	// can't sign the person out.
	SignOutPath string
	CSRFToken   string
	DialogID    string
}

// AdminUserIdentityData is a sign-in provider account linked to the person.
type AdminUserIdentityData struct {
	Provider   string
	Email      string
	LinkedAt   time.Time
	LastUsedAt *time.Time
}

// AdminUserPage is a person's page in the console.
templ AdminUserPage(data AdminUserPageData, verification ...AdminSecurityVerificationData) {
	<div
		class="flex-1 flex flex-col min-w-0 overflow-hidden"
		data-admin-user-page
		if adminSecurityVerificationValue(verification).Required {
			hx-headers={ adminVerificationOnPageHeaders }
		}
	>
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<a href={ templ.SafeURL(adminUserPageBack(data.ListPath)) } class="mb-4 inline-flex items-center gap-1 text-sm font-medium text-muted-foreground hover:text-foreground" data-admin-user-back>
					@icon.ArrowLeft(icon.Props{Class: "size-4"})
					if data.ListPath == AdminAdministratorsPath {
						{ i18n.T(ctx, "admin.nav.administrators") }
					} else {
						{ i18n.T(ctx, "admin.user.back") }
					}
				</a>
				@adminPageHeader(adminPageHeaderProps{Title: adminUserUsername(ctx, data.User.Username), Actions: adminUserPageActions(data.User)})
				<div class="mt-2 flex flex-wrap items-center gap-2">
					@adminUserStatusBadge(data.User)
					@adminBadge(adminUserRoleTone(data.User.Role)) {
						{ adminValueLabel(ctx, data.User.Role) }
					}
					if data.User.Current {
						@adminTag(adminToneInfo) {
							{ i18n.T(ctx, "admin.users.you") }
						}
					}
				</div>
				@linkTabs(i18n.T(ctx, "admin.user.tabs")) {
					@linkTab(templ.SafeURL(AdminUserPagePath(data.User.ID, AdminUserTabOverview, data.ListPath)), i18n.T(ctx, "admin.user.tab.overview"), data.Tab == AdminUserTabOverview, nil)
					@linkTab(templ.SafeURL(AdminUserPagePath(data.User.ID, AdminUserTabSignIn, data.ListPath)), i18n.T(ctx, "admin.user.tab.sign_in"), data.Tab == AdminUserTabSignIn, nil)
					@linkTab(templ.SafeURL(AdminUserPagePath(data.User.ID, AdminUserTabSessions, data.ListPath)), i18n.T(ctx, "admin.user.tab.sessions"), data.Tab == AdminUserTabSessions, nil)
					@linkTab(templ.SafeURL(AdminUserPagePath(data.User.ID, AdminUserTabMailboxes, data.ListPath)), i18n.T(ctx, "admin.user.tab.mailboxes"), data.Tab == AdminUserTabMailboxes, nil)
					@linkTab(templ.SafeURL(AdminUserPagePath(data.User.ID, AdminUserTabActivity, data.ListPath)), i18n.T(ctx, "admin.user.tab.activity"), data.Tab == AdminUserTabActivity, nil)
				}
				<div id={ adminUserDialogSlotID }>
					if data.Dialog != nil {
						@AdminUserActionDialog(*data.Dialog)
					}
				</div>
				if data.Invitation != nil {
					@AdminUserInvitationResultDialog(data.Invitation)
				}
				if data.CredentialReset != nil {
					@AdminUserCredentialResetResultDialog(data.CredentialReset)
				}
				switch data.Tab {
					case AdminUserTabSignIn:
						@adminUserSignInTab(data)
					case AdminUserTabSessions:
						@adminUserSessionsTab(data)
					case AdminUserTabMailboxes:
						@adminUserMailboxesTab(data)
					case AdminUserTabActivity:
						@adminUserActivityTab(data, adminSecurityVerificationValue(verification))
					default:
						@adminUserOverviewTab(data)
				}
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

func adminUserPageBack(list string) string {
	if list == "" {
		return "/admin/users"
	}
	return list
}

// adminUserPageActions is the person's actions menu, as on their row.
templ adminUserPageActions(user AdminUserData) {
	if entries := adminUserMenuEntries(ctx, user); len(entries) > 0 {
		@adminUserActionsMenu(user, entries)
	}
}

templ adminUserStatusBadge(user AdminUserData) {
	@adminBadge(adminUserStatusTone(user.Status)) {
		if user.DeletionPending {
			{ i18n.T(ctx, "admin.users.deleting") }
		} else {
			{ adminValueLabel(ctx, user.Status) }
		}
	}
}

templ adminUserOverviewTab(data AdminUserPageData) {
	@adminSection(adminSectionProps{ID: "admin-user-account", Title: i18n.T(ctx, "admin.user.account")}) {
		@adminFacts() {
			@adminFact(i18n.T(ctx, "admin.col.status")) {
				@adminUserStatusBadge(data.User)
				if data.DeletionStartedAt != nil {
					<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.user.deletion_started", "date", adminUserDate(ctx, data.DeletionStartedAt)) }</p>
				} else if data.User.Status == "disabled" && data.DisabledAt != nil {
					<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.user.disabled_since", "date", adminUserDate(ctx, data.DisabledAt)) }</p>
				}
			}
			@adminFact(i18n.T(ctx, "admin.col.role")) {
				{ adminValueLabel(ctx, data.User.Role) }
			}
			@adminFact(i18n.T(ctx, "admin.col.groups")) {
				if data.User.administrator() {
					<span class="text-muted-foreground">{ i18n.T(ctx, "admin.user.groups_administrator") }</span>
				} else if len(data.Groups) == 0 {
					<span class="text-muted-foreground" data-admin-user-no-groups>{ i18n.T(ctx, "admin.user.no_groups") }</span>
				} else {
					@adminUserGroupTags(data.Groups, len(data.Groups))
				}
			}
			@adminFact(i18n.T(ctx, "admin.user.created")) {
				{ adminUserDate(ctx, &data.CreatedAt) }
			}
			@adminFact(i18n.T(ctx, "admin.col.last_sign_in")) {
				if data.User.LastSignInAt != nil {
					{ adminUserDate(ctx, data.User.LastSignInAt) }
				} else {
					{ i18n.T(ctx, "admin.users.never_signed_in") }
				}
			}
			if data.User.Status == "pending" && data.User.InvitationState != "" {
				@adminFact(i18n.T(ctx, "admin.col.invitation")) {
					@adminBadge(adminUserInvitationTone(data.User.InvitationState)) {
						{ adminUserInvitationStateLabel(ctx, data.User.InvitationState) }
					}
					if data.User.InvitationExpiresAt != nil {
						<p class="mt-1 text-xs text-muted-foreground">
							if data.User.InvitationState == "active" {
								{ i18n.T(ctx, "admin.invite.expires", "date", adminUserDate(ctx, data.User.InvitationExpiresAt)) }
							} else {
								{ i18n.T(ctx, "admin.invite.expired_at", "date", adminUserDate(ctx, data.User.InvitationExpiresAt)) }
							}
						</p>
					}
				}
			}
			@adminFact(i18n.T(ctx, "admin.user.requests")) {
				if data.User.PasswordResetRequestedAt == nil && !data.User.PasswordChangeRequired && !data.User.MFASetupPending {
					<span class="text-muted-foreground">{ i18n.T(ctx, "admin.user.no_requests") }</span>
				} else {
					<div class="flex flex-col items-start gap-2">
						if data.User.PasswordResetRequestedAt != nil {
							<div>
								@adminBadge(adminToneWarning) {
									{ i18n.T(ctx, "admin.users.reset_requested") }
								}
								<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.users.requested_at", "date", adminUserDate(ctx, data.User.PasswordResetRequestedAt)) }</p>
							</div>
						}
						if data.User.PasswordChangeRequired {
							@adminBadge(adminToneWarning) {
								{ i18n.T(ctx, "admin.users.password_change_required") }
							}
						}
						if data.User.MFASetupPending {
							@adminBadge(adminToneWarning) {
								{ i18n.T(ctx, "admin.user.mfa_setup_pending") }
							}
						}
					</div>
				}
			}
			@adminFact(i18n.T(ctx, "admin.col.user_id")) {
				<code class="break-all font-mono text-xs text-muted-foreground">{ data.User.ID }</code>
			}
		}
	}
}

templ adminUserSignInTab(data AdminUserPageData) {
	@adminSection(adminSectionProps{ID: "admin-user-methods", Title: i18n.T(ctx, "admin.user.methods")}) {
		@adminFacts() {
			@adminFact(i18n.T(ctx, "admin.user.password")) {
				if data.User.HasPassword {
					{ i18n.T(ctx, "admin.user.password_set") }
					if data.PasswordChangedAt != nil {
						<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.user.changed_at", "date", adminUserDate(ctx, data.PasswordChangedAt)) }</p>
					}
					if data.User.PasswordChangeRequired {
						<p class="mt-2">
							@adminBadge(adminToneWarning) {
								{ i18n.T(ctx, "admin.users.password_change_required") }
							}
						</p>
					}
				} else {
					<span class="text-muted-foreground">{ i18n.T(ctx, "admin.user.none") }</span>
				}
			}
			@adminFact(i18n.T(ctx, "admin.user.passkeys")) {
				if data.Passkeys == 0 {
					<span class="text-muted-foreground">{ i18n.T(ctx, "admin.user.none") }</span>
				} else {
					{ i18n.N(ctx, "admin.user.passkey_count", data.Passkeys, "count", i18n.Number(ctx, data.Passkeys)) }
					@adminUserLastUsed(data.PasskeyLastUsedAt)
				}
			}
			@adminFact(i18n.T(ctx, "admin.user.authenticator_app")) {
				if data.AuthenticatorAppSince == nil {
					<span class="text-muted-foreground">{ i18n.T(ctx, "admin.user.not_set_up") }</span>
				} else {
					{ i18n.T(ctx, "admin.user.set_up_at", "date", adminUserDate(ctx, data.AuthenticatorAppSince)) }
					@adminUserLastUsed(data.AuthenticatorAppLastUsedAt)
				}
			}
			@adminFact(i18n.T(ctx, "admin.user.recovery_codes")) {
				if data.RecoveryCodesLeft == 0 {
					<span class="text-muted-foreground">{ i18n.T(ctx, "admin.user.none") }</span>
				} else {
					{ i18n.N(ctx, "admin.user.recovery_left", data.RecoveryCodesLeft, "count", i18n.Number(ctx, data.RecoveryCodesLeft)) }
				}
			}
			@adminFact(i18n.T(ctx, "admin.col.mfa")) {
				@adminBadge(adminUserMFATone(data.User.MFALabel)) {
					{ adminValueLabel(ctx, data.User.MFALabel) }
				}
				<p class="mt-1 text-xs text-muted-foreground">{ adminValueLabel(ctx, data.User.MFADetail) }</p>
				if data.User.MFASetupPending {
					<p class="mt-2">
						@adminBadge(adminToneWarning) {
							{ i18n.T(ctx, "admin.users.mfa_not_set_up") }
						}
					</p>
				}
			}
			@adminFact(i18n.T(ctx, "admin.user.sessions")) {
				if data.WorkingSessions == 0 {
					<span class="text-muted-foreground">{ i18n.T(ctx, "admin.user.no_sessions") }</span>
				} else {
					<a href={ templ.SafeURL(AdminUserPagePath(data.User.ID, AdminUserTabSessions, data.ListPath)) } class="font-medium text-primary hover:underline">
						{ i18n.N(ctx, "admin.user.session_count", data.WorkingSessions, "count", i18n.Number(ctx, data.WorkingSessions)) }
					</a>
				}
			}
		}
	}
	@adminSection(adminSectionProps{ID: "admin-user-providers", Title: i18n.T(ctx, "admin.user.providers"), Aside: adminSectionNote(i18n.T(ctx, "admin.user.providers_detail"))}) {
		if len(data.Identities) == 0 {
			@adminEmptyState(i18n.T(ctx, "admin.user.no_providers"))
		} else {
			<div class="overflow-x-auto">
				<table class="w-full min-w-[40rem] text-left text-sm">
					<thead class="bg-muted/45 text-xs font-semibold text-muted-foreground">
						<tr>
							<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.provider") }</th>
							<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.provider_email") }</th>
							<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.linked") }</th>
							<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.last_used") }</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						for _, identity := range data.Identities {
							<tr class="bg-background/35">
								<td class="px-4 py-3 font-medium text-foreground">{ adminUserProviderLabel(ctx, identity.Provider) }</td>
								<td class="px-4 py-3 break-all">
									if identity.Email != "" {
										{ identity.Email }
									} else {
										<span class="text-muted-foreground">—</span>
									}
								</td>
								<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">{ adminUserDate(ctx, &identity.LinkedAt) }</td>
								<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">
									if identity.LastUsedAt != nil {
										{ adminUserDate(ctx, identity.LastUsedAt) }
									} else {
										{ i18n.T(ctx, "admin.users.never_signed_in") }
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ adminUserSessionsTab(data AdminUserPageData) {
	@adminSection(adminSectionProps{ID: "admin-user-sessions", Title: i18n.T(ctx, "admin.user.sessions_heading"), Aside: adminUserSignOutEverywhere(data)}) {
		if len(data.Sessions) == 0 {
			@adminEmptyState(i18n.T(ctx, "admin.user.no_sessions_detail"))
		} else {
			<div class="overflow-x-auto">
				<table class="w-full min-w-[52rem] text-left text-sm">
					<thead class="bg-muted/45 text-xs font-semibold text-muted-foreground">
						<tr>
							<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.session_client") }</th>
							<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.session_method") }</th>
							<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.session_started") }</th>
							<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.last_used") }</th>
							<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.session_ends") }</th>
							<th scope="col" class="px-4 py-3 text-right"><span class="sr-only">{ i18n.T(ctx, "admin.col.actions") }</span></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-border">
						for _, session := range data.Sessions {
							<tr class="bg-background/35 align-top" data-admin-user-session>
								<td class="px-4 py-3 font-medium text-foreground">
									if session.UserAgent == "" {
										{ ClientLabel(ctx, "") }
									} else {
										<span title={ session.UserAgent }>{ ClientLabel(ctx, session.UserAgent) }</span>
									}
								</td>
								<td class="px-4 py-3">
									{ session.Authentication }
									<p class="mt-1 text-xs text-muted-foreground">{ session.Assurance }</p>
								</td>
								<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">{ adminUserDate(ctx, &session.AuthenticatedAt) }</td>
								<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">{ adminUserDate(ctx, &session.LastUsedAt) }</td>
								<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">{ adminUserDate(ctx, &session.ExpiresAt) }</td>
								<td class="px-4 py-3 text-right">
									if session.SignOutPath != "" {
										@dialog.Trigger(dialog.TriggerProps{For: session.DialogID}) {
											@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"aria-haspopup": "dialog", "data-admin-user-session-sign-out": ""}}) {
												{ i18n.T(ctx, "admin.user.session_sign_out") }
											}
										}
										@adminUserSessionSignOutDialog(data, session)
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// adminUserSignOutEverywhere opens the actions menu's sign-out dialog,
// when there's more than one place to sign out of.
templ adminUserSignOutEverywhere(data AdminUserPageData) {
	if path := data.User.Path(AdminUserActionSignOut); path != "" && len(data.Sessions) > 1 {
		{{ path = adminUserActionFromList(path, data.User.ListPath) }}
		@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Href: path, Attributes: adminUserMenuItemAttributes(path)}) {
			{ i18n.T(ctx, "admin.users.sign_out") }
		}
	}
}

templ adminUserSessionSignOutDialog(data AdminUserPageData, session AdminUserSessionData) {
	@dialog.Dialog(dialog.Props{ID: session.DialogID}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.user.session_sign_out_title", "user", adminUserUsername(ctx, data.User.Username), "client", ClientLabel(ctx, session.UserAgent)) }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.user.session_sign_out_detail") }
				}
			}
			<form method="post" action={ templ.SafeURL(session.SignOutPath) } data-step-up>
				<input type="hidden" name="_csrf" value={ session.CSRFToken }/>
				<input type="hidden" name="list" value={ data.User.ListPath }/>
				@dialog.Footer() {
					@dialog.Close() {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						{ i18n.T(ctx, "admin.user.session_sign_out") }
					}
				}
			</form>
		}
	}
}

templ adminUserMailboxesTab(data AdminUserPageData) {
	@adminSection(adminSectionProps{ID: "admin-user-mailboxes", Title: i18n.T(ctx, "admin.user.mailboxes_heading"), Aside: adminSectionNote(i18n.T(ctx, "admin.user.mailboxes_detail"))}) {
		if !data.HasMailboxes {
			@adminEmptyState(i18n.T(ctx, "admin.user.no_mailbox_store"))
		} else if len(data.Mailboxes) == 0 {
			@adminEmptyState(i18n.T(ctx, "admin.user.no_mailboxes"))
		} else {
			<ul class="divide-y divide-border">
				for _, mailbox := range data.Mailboxes {
					<li class="px-4 py-4" data-admin-user-mailbox>
						<div class="flex flex-wrap items-start justify-between gap-2">
							<div class="min-w-0">
								<p class="break-all font-semibold text-foreground">
									if mailbox.Email != "" {
										{ mailbox.Email }
									} else {
										{ mailbox.DisplayName }
									}
								</p>
								<p class="mt-0.5 text-xs text-muted-foreground">
									{ adminUserMailboxProvider(ctx, mailbox.Provider) }
									if mailbox.Email != "" && mailbox.DisplayName != "" && mailbox.DisplayName != mailbox.Email {
										· { mailbox.DisplayName }
									}
									· { i18n.T(ctx, "admin.user.mailbox_added", "date", adminUserDate(ctx, &mailbox.CreatedAt)) }
								</p>
							</div>
							<div class="flex flex-wrap items-center gap-2">
								if mailbox.Hidden {
									@adminBadge(adminToneNeutral) {
										{ i18n.T(ctx, "admin.user.mailbox_hidden") }
									}
								}
								switch {
									case !mailbox.SyncEnabled:
										@adminBadge(adminToneNeutral) {
											{ i18n.T(ctx, "admin.user.mailbox_paused") }
										}
									case mailbox.SyncError != "":
										@adminBadge(adminToneDanger) {
											{ i18n.T(ctx, "admin.user.mailbox_failing") }
										}
									default:
										@adminBadge(adminToneSuccess) {
											{ i18n.T(ctx, "admin.user.mailbox_working") }
										}
								}
							</div>
						</div>
						if mailbox.SyncError != "" {
							<p class="mt-2 break-words rounded-md bg-destructive/10 px-3 py-2 text-xs text-destructive" data-admin-user-mailbox-error>
								{ mailbox.SyncError }
								if mailbox.SyncErrorAt != nil {
									<span class="mt-1 block text-muted-foreground">{ i18n.T(ctx, "admin.user.mailbox_error_at", "date", adminUserDate(ctx, mailbox.SyncErrorAt)) }</span>
								}
							</p>
						}
						<dl class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[10rem_1fr]">
							for _, server := range mailbox.Servers {
								<dt class="text-muted-foreground">{ server.Service }</dt>
								<dd class="min-w-0 break-all font-mono text-xs leading-5 text-foreground">{ server.Address }</dd>
							}
							<dt class="text-muted-foreground">{ i18n.T(ctx, "admin.user.mailbox_proxy") }</dt>
							<dd class="min-w-0 text-foreground">{ mailbox.Proxy }</dd>
							<dt class="text-muted-foreground">{ i18n.T(ctx, "admin.user.mailbox_allowlist") }</dt>
							<dd class="min-w-0">
								switch {
									case mailbox.Refusal != "":
										@adminBadge(adminToneDanger, templ.Attributes{"data-admin-user-mailbox-refused": ""}) {
											{ i18n.T(ctx, "admin.user.mailbox_refused") }
										}
										<p class="mt-1 text-xs text-muted-foreground">{ mailbox.Refusal }</p>
									case mailbox.Unlimited:
										<span class="text-muted-foreground">{ i18n.T(ctx, "admin.user.mailbox_unlimited") }</span>
									default:
										{ i18n.T(ctx, "admin.user.mailbox_allowed") }
								}
							</dd>
						</dl>
					</li>
				}
			</ul>
		}
	}
}

// AdminUserActivityLimit is how many of each kind of activity a person's
// page shows.
const AdminUserActivityLimit = 25

templ adminUserActivityTab(data AdminUserPageData, verification AdminSecurityVerificationData) {
	if data.StepUpRequired {
		<div role="alert" class="mt-6 rounded-lg border border-amber-500/30 bg-amber-500/10 px-5 py-5 text-amber-900 dark:text-amber-100" data-admin-user-activity-locked>
			<p class="font-semibold">{ i18n.T(ctx, "admin.verify.required") }</p>
			<p class="mt-1 text-sm">{ i18n.T(ctx, "admin.user.activity_verify") }</p>
			<div class="mt-4">
				@AdminSecurityVerificationTrigger(verification, i18n.T(ctx, "admin.verify.now"))
			</div>
		</div>
	} else {
		@tabs.Tabs(tabs.Props{ID: "admin-user-activity-tabs", Class: "mt-6"}) {
			@tabs.List(tabs.ListProps{Class: adminTabsListClass}) {
				@tabs.Trigger(tabs.TriggerProps{Value: "security", IsActive: true, Class: adminTabsTriggerClass}) {
					{ i18n.T(ctx, "admin.activity.tab.security") }
				}
				@tabs.Trigger(tabs.TriggerProps{Value: "changes", Class: adminTabsTriggerClass}) {
					{ i18n.T(ctx, "admin.user.changes") }
				}
				if data.ShowChangesMade {
					@tabs.Trigger(tabs.TriggerProps{Value: "changes-made", Class: adminTabsTriggerClass}) {
						{ i18n.T(ctx, "admin.user.changes_made") }
					}
				}
			}
			@tabs.Content(tabs.ContentProps{Value: "security", IsActive: true, Class: "mt-4"}) {
				@adminUserActivityCard(len(data.SecurityEvents), templ.SafeURL(AdminActivityPath)) {
					if len(data.SecurityEvents) == 0 {
						@adminEmptyState(i18n.T(ctx, "admin.user.no_security_events"))
					} else {
						@adminSecurityEventsTable(data.SecurityEvents)
					}
				}
			}
			@tabs.Content(tabs.ContentProps{Value: "changes", Class: "mt-4"}) {
				@adminUserActivityCard(len(data.Changes), templ.SafeURL(AdminAuditActivityPath)) {
					if len(data.Changes) == 0 {
						@adminEmptyState(i18n.T(ctx, "admin.user.no_changes"))
					} else {
						@adminAuditTable(data.Changes)
					}
				}
			}
			if data.ShowChangesMade {
				@tabs.Content(tabs.ContentProps{Value: "changes-made", Class: "mt-4"}) {
					@adminUserActivityCard(len(data.ChangesMade), templ.SafeURL(AdminAuditActivityPath)) {
						if len(data.ChangesMade) == 0 {
							@adminEmptyState(i18n.T(ctx, "admin.user.no_changes_made"))
						} else {
							@adminAuditTable(data.ChangesMade)
						}
					}
				}
			}
		}
	}
}

// adminUserActivityCard holds one of the Activity tab's lists, under a bar
// that says when it shows only the newest entries and leads to the whole
// record.
templ adminUserActivityCard(count int, all templ.SafeURL) {
	<div class="overflow-hidden rounded-lg border border-border bg-card">
		<div class="flex justify-end border-b border-border px-4 py-3">
			@adminUserActivityAside(count, all)
		</div>
		{ children... }
	</div>
}

// adminUserActivityAside says when a list shows only the newest entries,
// and leads to the whole record.
templ adminUserActivityAside(count int, all templ.SafeURL) {
	<span class="flex items-center gap-3 text-xs text-muted-foreground">
		if count >= AdminUserActivityLimit {
			{ i18n.T(ctx, "admin.user.activity_newest", "count", i18n.Number(ctx, AdminUserActivityLimit)) }
		}
		<a href={ all } class="font-semibold text-primary hover:underline">{ i18n.T(ctx, "admin.user.activity_all") }</a>
	</span>
}

func adminUserMailboxProvider(ctx context.Context, provider string) string {
	switch provider {
	case "gmail":
		return "Gmail"
	case "outlook":
		return "Outlook"
	case "jmap":
		return "JMAP"
	case "imap":
		return "IMAP"
	case "dav":
		return i18n.T(ctx, "admin.user.mailbox_dav")
	}
	return provider
}

templ adminUserLastUsed(at *time.Time) {
	<p class="mt-1 text-xs text-muted-foreground">
		if at != nil {
			{ i18n.T(ctx, "admin.user.last_used_at", "date", adminUserDate(ctx, at)) }
		} else {
			{ i18n.T(ctx, "admin.user.never_used") }
		}
	</p>
}

func adminUserDate(ctx context.Context, at *time.Time) string {
	if at == nil || at.IsZero() {
		return ""
	}
	return i18n.Dates(ctx).ShortDateTime(at.Local())
}

func adminUserProviderLabel(ctx context.Context, provider string) string {
	switch provider {
	case "google":
		return "Google"
	case "microsoft":
		return "Microsoft"
	case "oidc":
		return i18n.T(ctx, "admin.user.provider_oidc")
	}
	return provider
}
