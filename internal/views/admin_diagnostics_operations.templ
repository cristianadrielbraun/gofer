package views

import (
	"context"
	"fmt"
	"strings"
	"time"

	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

func adminMailPendingAge(ctx context.Context, t time.Time) string {
	if t.IsZero() {
		return i18n.T(ctx, "admin.none")
	}
	age := time.Since(t)
	if age < 0 {
		return i18n.T(ctx, "admin.age.future")
	}
	if age < time.Minute {
		return i18n.T(ctx, "admin.age.now")
	}
	if age < time.Hour {
		return i18n.T(ctx, "admin.age.minutes", "count", int(age/time.Minute))
	}
	if age < 24*time.Hour {
		return i18n.T(ctx, "admin.age.hours", "count", int(age/time.Hour))
	}
	return i18n.T(ctx, "admin.age.days", "count", int(age/(24*time.Hour)))
}

func adminSMTPProfileDuration(ctx context.Context, milliseconds int64) string {
	if milliseconds <= 0 {
		return "—"
	}
	if milliseconds < 1000 {
		return i18n.Number(ctx, int(milliseconds)) + " ms"
	}
	return strings.Replace(fmt.Sprintf("%.1f", float64(milliseconds)/1000), ".", i18n.T(ctx, "number.decimal"), 1) + " s"
}

func adminMailHealthStateLabel(ctx context.Context, state string) string {
	switch state {
	case "pending":
		return i18n.T(ctx, "admin.ops.state.pending")
	case "processing", "syncing", "copying", "sending":
		return i18n.T(ctx, "admin.ops.state.running")
	case "failed":
		return i18n.T(ctx, "admin.ops.state.failed")
	case "ambiguous":
		return i18n.T(ctx, "admin.ops.state.ambiguous")
	case "applied":
		return i18n.T(ctx, "admin.ops.state.applied")
	default:
		return state
	}
}

func adminMailHealthKindLabel(ctx context.Context, kind string) string {
	switch kind {
	case "read":
		return i18n.T(ctx, "admin.ops.kind.read")
	case "starred":
		return i18n.T(ctx, "admin.ops.kind.starred")
	case "move":
		return i18n.T(ctx, "admin.ops.kind.move")
	case "delete":
		return i18n.T(ctx, "admin.ops.kind.delete")
	default:
		return kind
	}
}

templ AdminMailHealthCard(label string, value int, warning bool, danger bool) {
	<div
		class={
			"rounded-lg border bg-card p-4",
			templ.KV("border-amber-500/30", warning && !danger),
			templ.KV("border-red-500/35", danger),
			templ.KV("border-border", !warning && !danger),
		}
	>
		<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		<div
			class={
				"mt-2 text-2xl font-bold tabular-nums",
				templ.KV("text-amber-700 dark:text-amber-300", warning && !danger),
				templ.KV("text-red-700 dark:text-red-300", danger),
				templ.KV("text-foreground", !warning && !danger),
			}
		>{ i18n.Number(ctx, value) }</div>
	</div>
}

templ AdminMailOperationsPage(status models.MailOperationsAdminStatus) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="mb-7 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.operations") }</h2>
						<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.ops.description") }</p>
					</div>
					@AdminWebmailScopeFilter(status.Scope, AdminOperationsPath)
				</div>
				<div class="grid gap-3 sm:grid-cols-2">
					<div class="rounded-lg border border-border bg-card p-4">
						<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.ops.retained") }</div>
						<div class="mt-2 text-2xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, status.Total) }</div>
					</div>
					<div
						class={
							"rounded-lg border bg-card p-4",
							templ.KV("border-amber-500/30", status.ActionRequired > 0),
							templ.KV("border-border", status.ActionRequired == 0),
						}
					>
						<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.ops.attention") }</div>
						<div
							class={
								"mt-2 text-2xl font-bold tabular-nums",
								templ.KV("text-amber-700 dark:text-amber-300", status.ActionRequired > 0),
								templ.KV("text-foreground", status.ActionRequired == 0),
							}
						>{ i18n.Number(ctx, status.ActionRequired) }</div>
					</div>
				</div>
				if status.Scope.SelectedUserID == "" {
					<section class="mt-5 rounded-lg border border-border bg-card p-5">
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div>
								<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.ops.retention") }</div>
								<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.retention_detail") }</p>
							</div>
							<div class="text-right text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.last_run", "date", adminTime(ctx, status.Retention.LastRunAt)) }</div>
						</div>
						<div class="mt-4 grid gap-2 sm:grid-cols-4">
							@AdminCompactMetric("retention_outgoing_sends", i18n.T(ctx, "admin.ops.pruned.sends"), status.Retention.LastPruned.OutgoingSends)
							@AdminCompactMetric("retention_message_mutations", i18n.T(ctx, "admin.ops.pruned.mutations"), status.Retention.LastPruned.MessageMutations)
							@AdminCompactMetric("retention_imap_drafts", i18n.T(ctx, "admin.ops.pruned.drafts"), status.Retention.LastPruned.IMAPDraftOperations)
							@AdminCompactMetric("retention_label_mutations", i18n.T(ctx, "admin.ops.pruned.labels"), status.Retention.LastPruned.LabelMutations)
							@AdminCompactMetric("retention_folder_states", i18n.T(ctx, "admin.ops.pruned.folders"), status.Retention.LastPruned.FolderStates)
							@AdminCompactMetric("retention_messages", i18n.T(ctx, "admin.ops.pruned.orphans"), status.Retention.LastPruned.Messages)
							@AdminCompactMetric("retention_threads", i18n.T(ctx, "admin.ops.pruned.threads"), status.Retention.LastPruned.Threads)
						</div>
						if status.Retention.LastError != "" {
							<div class="mt-3 rounded-md border border-amber-500/25 bg-amber-500/10 px-3 py-2 text-xs text-amber-800 dark:text-amber-200">{ status.Retention.LastError }</div>
						}
					</section>
				}
				<section class="mt-5 rounded-lg border border-border bg-card p-5">
					<div>
						<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.ops.queue") }</div>
						<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.queue_detail") }</p>
					</div>
					<div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-6">
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.out_active"), status.Health.Outgoing.Pending+status.Health.Outgoing.Sending, false, false)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.out_failed"), status.Health.Outgoing.Failed, status.Health.Outgoing.Failed > 0, false)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.out_ambiguous"), status.Health.Outgoing.Ambiguous, false, status.Health.Outgoing.Ambiguous > 0)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.copy_active"), status.Health.SentCopy.Pending+status.Health.SentCopy.Copying, false, false)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.copy_failed"), status.Health.SentCopy.Failed, status.Health.SentCopy.Failed > 0, false)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.copy_ambiguous"), status.Health.SentCopy.Ambiguous, false, status.Health.SentCopy.Ambiguous > 0)
					</div>
					<div class="mt-5 grid gap-5 lg:grid-cols-3">
						<section class="rounded-lg border border-border/70 bg-background/35 p-4">
							<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "admin.ops.mutations") }</div>
							if len(status.Health.MessageMutations) == 0 {
								<div class="mt-3 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.mutations_empty") }</div>
							} else {
								<div class="mt-3 space-y-1.5">
									for _, item := range status.Health.MessageMutations {
										<div class="flex items-center justify-between gap-3 text-xs">
											<span class="text-muted-foreground">{ adminMailHealthKindLabel(ctx, item.Kind) } · { adminMailHealthStateLabel(ctx, item.State) }</span>
											<span class="font-semibold tabular-nums text-foreground">{ i18n.Number(ctx, item.Count) }</span>
										</div>
									}
								</div>
							}
						</section>
						<section class="rounded-lg border border-border/70 bg-background/35 p-4">
							<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "admin.ops.labels_drafts") }</div>
							<div class="mt-3 space-y-1.5">
								for _, item := range status.Health.LabelMutations {
									<div class="flex items-center justify-between gap-3 text-xs">
										<span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.labels_state", "state", adminMailHealthStateLabel(ctx, item.State)) }</span>
										<span class="font-semibold tabular-nums text-foreground">{ i18n.Number(ctx, item.Count) }</span>
									</div>
								}
								for _, item := range status.Health.IMAPDraftOperations {
									<div class="flex items-center justify-between gap-3 text-xs">
										<span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.drafts_state", "state", adminMailHealthStateLabel(ctx, item.State)) }</span>
										<span class="font-semibold tabular-nums text-foreground">{ i18n.Number(ctx, item.Count) }</span>
									</div>
								}
								if len(status.Health.LabelMutations) == 0 && len(status.Health.IMAPDraftOperations) == 0 {
									<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.labels_drafts_empty") }</div>
								}
							</div>
						</section>
						<section class="rounded-lg border border-border/70 bg-background/35 p-4">
							<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "admin.ops.mailbox_health") }</div>
							<div class="mt-3 space-y-1.5 text-xs">
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">IDLE</span><span class="font-semibold tabular-nums text-foreground">{ i18n.T(ctx, "admin.ops.idle_counts", "configured", i18n.Number(ctx, status.Health.IDLE.Configured), "healthy", i18n.Number(ctx, status.Health.IDLE.Healthy), "fallback", i18n.Number(ctx, status.Health.IDLE.Fallback)) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.folder_sync") }</span><span class="font-semibold tabular-nums text-foreground">{ i18n.T(ctx, "admin.ops.folder_counts", "complete", i18n.Number(ctx, status.Health.FolderSync.Complete), "partial", i18n.Number(ctx, status.Health.FolderSync.Partial), "failed", i18n.Number(ctx, status.Health.FolderSync.Failed)) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.oldest") }</span><span class="font-semibold text-foreground">{ adminMailPendingAge(ctx, status.Health.OldestPendingAt) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.next_retry") }</span><span class="font-semibold text-foreground">{ adminTime(ctx, status.Health.NextRetryAt) }</span></div>
							</div>
						</section>
					</div>
					if status.Scope.SelectedUserID == "" {
						<section class="mt-5 rounded-lg border border-border/70 bg-background/35 p-4">
							<div class="flex items-baseline justify-between gap-3">
								<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "admin.ops.smtp") }</div>
								<div class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "admin.ops.smtp_lifetime") }</div>
							</div>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.smtp_detail") }</p>
							<div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-6">
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.smtp_attempts"), status.Health.SMTPProfile.Samples, false, false)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.smtp_successes"), status.Health.SMTPProfile.Successes, false, false)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.smtp_failed"), status.Health.SMTPProfile.Failures, status.Health.SMTPProfile.Failures > 0, false)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.smtp_ambiguous"), status.Health.SMTPProfile.Ambiguous, false, status.Health.SMTPProfile.Ambiguous > 0)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.connections"), status.Health.SMTPProfile.Connections, false, false)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.messages"), status.Health.SMTPProfile.Messages, false, false)
							</div>
							<div class="mt-4 grid gap-2 text-xs sm:grid-cols-2 xl:grid-cols-4">
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.avg_connect") }</span><span class="font-semibold tabular-nums text-foreground">{ adminSMTPProfileDuration(ctx, status.Health.SMTPProfile.AvgConnectAuthMs) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.avg_transaction") }</span><span class="font-semibold tabular-nums text-foreground">{ adminSMTPProfileDuration(ctx, status.Health.SMTPProfile.AvgDataMs) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.avg_total") }</span><span class="font-semibold tabular-nums text-foreground">{ adminSMTPProfileDuration(ctx, status.Health.SMTPProfile.AvgTotalMs) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.avg_queue") }</span><span class="font-semibold tabular-nums text-foreground">{ adminSMTPProfileDuration(ctx, status.Health.SMTPProfile.AvgQueueWaitMs) }</span></div>
							</div>
						</section>
					}
				</section>
				<div class="mt-5 grid gap-5 lg:grid-cols-2">
					<section class="rounded-lg border border-border bg-card p-5">
						<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.ops.by_type") }</div>
						if len(status.ByType) == 0 {
							<div class="mt-4 rounded-md border border-dashed border-border px-3 py-5 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.none") }</div>
						} else {
							<div class="mt-4 space-y-2">
								for _, item := range status.ByType {
									<div class="flex items-center justify-between gap-3 rounded-md border border-border/70 bg-background/40 px-3 py-2.5">
										<div class="min-w-0">
											<div class="text-xs font-semibold text-foreground">{ mailOperationKindLabel(ctx, item.Type) }</div>
											<div class="mt-0.5 text-[11px] text-muted-foreground">{ item.Provider }</div>
										</div>
										<div class="shrink-0 text-right text-xs tabular-nums text-muted-foreground">
											<div>{ i18n.T(ctx, "admin.security.total", "count", i18n.Number(ctx, item.Total)) }</div>
											if item.ActionRequired > 0 {
												<div class="mt-0.5 font-semibold text-amber-700 dark:text-amber-300">{ i18n.N(ctx, "admin.ops.need_attention", item.ActionRequired, "count", i18n.Number(ctx, item.ActionRequired)) }</div>
											}
										</div>
									</div>
								}
							</div>
						}
					</section>
					<section class="rounded-lg border border-border bg-card p-5">
						<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.ops.by_account") }</div>
						if len(status.ByAccount) == 0 {
							<div class="mt-4 rounded-md border border-dashed border-border px-3 py-5 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.none") }</div>
						} else {
							<div class="mt-4 space-y-2">
								for _, item := range status.ByAccount {
									<div class="flex items-center justify-between gap-3 rounded-md border border-border/70 bg-background/40 px-3 py-2.5">
										<div class="min-w-0">
											<div class="truncate text-xs font-semibold text-foreground">{ item.AccountLabel }</div>
											<div class="mt-0.5 text-[11px] text-muted-foreground">{ item.Provider }</div>
										</div>
										<div class="shrink-0 text-right text-xs tabular-nums text-muted-foreground">
											<div>{ i18n.T(ctx, "admin.security.total", "count", i18n.Number(ctx, item.Total)) }</div>
											if item.ActionRequired > 0 {
												<div class="mt-0.5 font-semibold text-amber-700 dark:text-amber-300">{ i18n.N(ctx, "admin.ops.need_attention", item.ActionRequired, "count", i18n.Number(ctx, item.ActionRequired)) }</div>
											}
										</div>
									</div>
								}
							</div>
						}
					</section>
				</div>
			</div>
		</div>
	</div>
}
