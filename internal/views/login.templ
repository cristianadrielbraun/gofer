package views

import (
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"fmt"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

type RecoveryRepairMFAData struct {
	QRCodeDataURL string
	ManualKey     string
	Algorithm     string
	Digits        int
	Period        int
	ErrorMessage  string
}

type RecoveryRepairCodesData struct {
	BatchID      string
	Codes        []string
	Generated    bool
	ErrorMessage string
}

type MFAEnrollmentData = RecoveryRepairMFAData
type MFAEnrollmentCodesData = RecoveryRepairCodesData

// LoginPageData is the sign-in page. It asks for the username first, then
// shows the password, and a passkey when the username has one. MethodsShown
// starts the page at that second step, as after a wrong password.
type LoginPageData struct {
	ShowGoogle    bool
	ShowMicrosoft bool
	OIDCName      string
	ErrorMessage  string
	Identifier    string
	Personal      bool
	MethodsShown  bool
	HasPasskey    bool
}

templ LoginPage(data LoginPageData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "signin.title.sign_in") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<div class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm">
					<div class="text-center mb-10">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="text-muted-foreground mt-2 text-sm">{ i18n.T(ctx, "signin.tagline") }</p>
					</div>
					if data.ErrorMessage != "" {
						<div id="login-error" role="alert" aria-live="polite" class="bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm mb-6">
							{ data.ErrorMessage }
						</div>
					}
					<div data-login-flow data-methods-path="/login/methods" data-methods-shown={ fmt.Sprint(data.MethodsShown) } data-identified={ loginIdentified(data) }>
						<form method="post" action="/login" data-login-form>
							<div class="space-y-2">
								<label for="login-identifier" class="text-sm font-medium">{ i18n.T(ctx, "signin.username") }</label>
								<input
									id="login-identifier"
									name="identifier"
									type="text"
									value={ data.Identifier }
									autocomplete="username"
									autocapitalize="none"
									spellcheck="false"
									required
									autofocus?={ !data.MethodsShown }
									if data.ErrorMessage != "" {
										aria-invalid="true"
										aria-describedby="login-error"
									}
									class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20"
								/>
							</div>
							<div class="login-reveal" data-login-reveal="password" data-open={ fmt.Sprint(data.MethodsShown) }>
								<div>
									<div class="space-y-2 pt-4">
										<div class="flex items-center justify-between gap-3">
											<label for="login-password" class="text-sm font-medium">{ i18n.T(ctx, "signin.password") }</label>
											if !data.Personal {
												<a href="/account/recover" class="text-xs font-semibold text-primary hover:underline hover:underline-offset-2">{ i18n.T(ctx, "signin.forgot") }</a>
											}
										</div>
										<input
											id="login-password"
											name="password"
											type="password"
											autocomplete="current-password"
											required
											disabled?={ !data.MethodsShown }
											autofocus?={ data.MethodsShown }
											if data.ErrorMessage != "" {
												aria-invalid="true"
												aria-describedby="login-error"
											}
											class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20"
										/>
									</div>
								</div>
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true, Class: "mt-4", Attributes: templ.Attributes{"data-login-submit": ""}}) {
								<span class="login-submit-labels">
									<span class="login-submit-label" data-login-submit-label="continue" data-shown={ fmt.Sprint(!data.MethodsShown) } aria-hidden={ fmt.Sprint(data.MethodsShown) }>{ i18n.T(ctx, "common.continue") }</span>
									<span class="login-submit-label" data-login-submit-label="sign-in" data-shown={ fmt.Sprint(data.MethodsShown) } aria-hidden={ fmt.Sprint(!data.MethodsShown) }>{ i18n.T(ctx, "signin.sign_in") }</span>
								</span>
							}
						</form>
						<div class="login-reveal" data-login-reveal="passkey" data-open={ fmt.Sprint(data.MethodsShown && data.HasPasskey) }>
							<div>
								<form
									data-passkey-authentication
									data-start-path="/login/passkey/start"
									data-finish-path="/login/passkey/finish"
									data-identifier-source="#login-identifier"
									data-fallback={ i18n.T(ctx, "signin.passkey.fallback") }
									class="space-y-3 pt-3"
								>
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, FullWidth: true}) {
										{ i18n.T(ctx, "signin.passkey.button") }
									}
									<p data-passkey-authentication-status role="status" aria-live="polite" class="text-center text-xs text-muted-foreground empty:hidden"></p>
									<noscript><p class="text-center text-xs text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "signin.passkey.noscript") }</p></noscript>
								</form>
							</div>
						</div>
					</div>
					if data.ShowGoogle || data.ShowMicrosoft || data.OIDCName != "" {
						<div class="relative my-6">
							<div class="absolute inset-0 flex items-center" aria-hidden="true"><div class="w-full border-t border-border"></div></div>
							<div class="relative flex justify-center"><span class="bg-background px-3 text-xs uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "signin.or") }</span></div>
						</div>
						<div class="space-y-3">
							if data.ShowGoogle {
								@button.Button(button.Props{Variant: button.VariantOutline, FullWidth: true, Href: "/auth/google"}) {
									<span class="flex items-center justify-center gap-3">
										<svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"></path>
											<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
											<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
											<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
										</svg>
										{ i18n.T(ctx, "signin.continue_google") }
									</span>
								}
							}
							if data.ShowMicrosoft {
								@button.Button(button.Props{Variant: button.VariantOutline, FullWidth: true, Href: "/auth/microsoft"}) {
									<span class="flex items-center justify-center gap-3">
										<svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true">
											<path d="M2 2h9v9H2z" fill="#f25022"></path>
											<path d="M13 2h9v9h-9z" fill="#7fba00"></path>
											<path d="M2 13h9v9H2z" fill="#00a4ef"></path>
											<path d="M13 13h9v9h-9z" fill="#ffb900"></path>
										</svg>
										{ i18n.T(ctx, "signin.continue_microsoft") }
									</span>
								}
							}
							if data.OIDCName != "" {
								@button.Button(button.Props{Variant: button.VariantOutline, FullWidth: true, Href: "/auth/oidc"}) {
									<span class="flex items-center justify-center gap-3">
										<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
											<circle cx="12" cy="12" r="9"></circle>
											<path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
										</svg>
										{ i18n.T(ctx, "signin.continue_with", "provider", data.OIDCName) }
									</span>
								}
							}
						</div>
					}
					if data.Personal {
						<p class="mt-6 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "signin.personal_lost") }</p>
					} else {
						<p class="mt-6 text-center text-sm text-muted-foreground">
						{ i18n.T(ctx, "signin.invitation") }
						<a href="/account/enroll" class="font-semibold text-primary hover:underline hover:underline-offset-2">{ i18n.T(ctx, "signin.invitation_link") }</a>
						</p>
					}
				</div>
			</div>
			<script src={ assetver.URL("/assets/js/passkey-authentication.js") }></script>
			<script src={ assetver.URL("/assets/js/login.js") }></script>
		</body>
	</html>
}

// loginIdentified is the username whose sign-in options are shown, so that
// changing it can go back to the username step.
func loginIdentified(data LoginPageData) string {
	if !data.MethodsShown {
		return ""
	}
	return data.Identifier
}

type LoginMFAFactors struct {
	PrimarySignIn string
	Username      string
	HasTOTP       bool
}

templ LoginMFAContinuationPage(errorMessage string, factors LoginMFAFactors) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "signin.title.mfa") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm">
					<div class="text-center">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<h1 class="mt-8 text-2xl font-semibold">{ i18n.T(ctx, "signin.mfa.title") }</h1>
						<p class="mt-3 text-sm text-muted-foreground">{ i18n.T(ctx, "signin.mfa.description") }</p>
					</div>
					if factors.PrimarySignIn != "" {
						<p role="status" class="mt-6 rounded-md border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-center text-sm font-medium text-emerald-800 dark:text-emerald-200">{ factors.PrimarySignIn } <span class="block mt-1 font-normal">{ i18n.T(ctx, "signin.mfa.finish_hint") }</span></p>
					}
					if errorMessage != "" {
						<div id="login-mfa-error" role="alert" aria-live="polite" class="mt-6 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">
							{ errorMessage }
						</div>
					}
					if factors.HasTOTP {
						<form method="post" action="/login/mfa" class="mt-6 space-y-4">
							<div class="space-y-2">
								<label for="login-mfa-code" class="block text-center text-sm font-medium">{ i18n.T(ctx, "signin.mfa.code_label") }</label>
								<input
									id="login-mfa-code"
									name="code"
									type="text"
									inputmode="numeric"
									autocomplete="one-time-code"
									pattern="[0-9]{6}"
									minlength="6"
									maxlength="6"
									required
									autofocus
									if errorMessage != "" {
										aria-invalid="true"
										aria-describedby="login-mfa-error"
									}
									class="flex h-12 w-full rounded-md border border-input bg-background px-3 py-2 text-center font-mono text-xl tracking-[0.35em] outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20"
								/>
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
								{ i18n.T(ctx, "signin.mfa.verify") }
							}
						</form>
					}
					<div class="mt-4">
						@button.Button(button.Props{Variant: button.VariantOutline, FullWidth: true, Href: "/login"}) {
							{ i18n.T(ctx, "signin.mfa.restart") }
						}
					</div>
					<div class="mt-4 text-center">
						<a href="/login/mfa/recovery" class="text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground">{ i18n.T(ctx, "signin.mfa.use_recovery") }</a>
					</div>
				</div>
			</main>
		</body>
	</html>
}

templ RecoveryCodeLoginPage(errorMessage string) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "signin.title.recovery") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm">
					<div class="text-center">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<h1 class="mt-8 text-2xl font-semibold">{ i18n.T(ctx, "signin.recovery.title") }</h1>
						<p class="mt-3 text-sm text-muted-foreground">{ i18n.T(ctx, "signin.recovery.description") }</p>
					</div>
					if errorMessage != "" {
						<div id="recovery-code-error" role="alert" aria-live="polite" class="mt-6 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ errorMessage }</div>
					}
					<form method="post" action="/login/mfa/recovery" class="mt-6 space-y-4">
						<div class="space-y-2">
							<label for="recovery-code" class="text-sm font-medium">{ i18n.T(ctx, "signin.recovery.code_label") }</label>
							<input
								id="recovery-code"
								name="code"
								type="text"
								autocomplete="one-time-code"
								autocapitalize="characters"
								spellcheck="false"
								maxlength="64"
								required
								autofocus
								if errorMessage != "" {
									aria-invalid="true"
									aria-describedby="recovery-code-error"
								}
								class="flex h-11 w-full rounded-md border border-input bg-background px-3 py-2 text-center font-mono text-sm uppercase tracking-wider outline-none transition-shadow focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"
							/>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							{ i18n.T(ctx, "signin.recovery.continue") }
						}
					</form>
					<div class="mt-4">
						@button.Button(button.Props{Variant: button.VariantOutline, FullWidth: true, Href: "/login/mfa"}) {
							{ i18n.T(ctx, "signin.recovery.use_authenticator") }
						}
					</div>
				</div>
			</main>
		</body>
	</html>
}

templ RecoveryRepairMFAPage(data RecoveryRepairMFAData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "signin.title.repair") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-lg">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-warning">{ i18n.T(ctx, "signin.repair.accepted") }</p>
						<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "signin.repair.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "signin.repair.description") }</p>
					</div>
					if data.ErrorMessage != "" {
						<div id="recovery-repair-mfa-error" role="alert" aria-live="polite" class="mb-4 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.ErrorMessage }</div>
					}
					<div class="rounded-xl border border-border bg-card p-6">
						<div class="flex justify-center rounded-lg bg-white p-4">
							<img src={ data.QRCodeDataURL } alt={ i18n.T(ctx, "signin.repair.qr_alt") } class="h-56 w-56"/>
						</div>
						<div class="mt-5">
							<p class="text-sm font-medium">{ i18n.T(ctx, "security.totp.manual_key") }</p>
							<p class="mt-2 break-all rounded-md border border-border bg-background px-3 py-2 text-center font-mono text-sm tracking-wider">{ data.ManualKey }</p>
							<p class="mt-2 text-xs text-muted-foreground">{ data.Algorithm } · { i18n.T(ctx, "signin.totp.digits", "count", data.Digits) } · { i18n.T(ctx, "signin.totp.period", "count", data.Period) }</p>
						</div>
					</div>
					<form method="post" action="/login/recovery/mfa" class="mt-4 space-y-4">
						<input type="hidden" name="action" value="confirm"/>
						<div class="space-y-2">
							<label for="recovery-repair-code" class="text-sm font-medium">{ i18n.T(ctx, "signin.repair.code_label") }</label>
							<input id="recovery-repair-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus class="flex h-12 w-full rounded-md border border-input bg-background px-3 py-2 text-center font-mono text-xl tracking-[0.35em] outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50"/>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							{ i18n.T(ctx, "signin.repair.verify") }
						}
					</form>
					<form method="post" action="/login/recovery/mfa" class="mt-2">
						<input type="hidden" name="action" value="restart"/>
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, FullWidth: true}) {
							{ i18n.T(ctx, "signin.totp.new_key") }
						}
					</form>
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "signin.repair.note") }</p>
				</div>
			</main>
		</body>
	</html>
}

templ MFAEnrollmentPage(data MFAEnrollmentData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "signin.title.enroll") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-lg">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-warning">{ i18n.T(ctx, "signin.enroll.required") }</p>
						<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "signin.enroll.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "signin.enroll.description") }</p>
					</div>
					if data.ErrorMessage != "" {
						<div id="mfa-enrollment-error" role="alert" aria-live="polite" class="mb-4 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.ErrorMessage }</div>
					}
					<div class="rounded-xl border border-border bg-card p-6">
						<div class="flex justify-center rounded-lg bg-white p-4">
							<img src={ data.QRCodeDataURL } alt={ i18n.T(ctx, "signin.enroll.qr_alt") } class="h-56 w-56"/>
						</div>
						<div class="mt-5">
							<p class="text-sm font-medium">{ i18n.T(ctx, "security.totp.manual_key") }</p>
							<p class="mt-2 break-all rounded-md border border-border bg-background px-3 py-2 text-center font-mono text-sm tracking-wider">{ data.ManualKey }</p>
							<p class="mt-2 text-xs text-muted-foreground">{ data.Algorithm } · { i18n.T(ctx, "signin.totp.digits", "count", data.Digits) } · { i18n.T(ctx, "signin.totp.period", "count", data.Period) }</p>
						</div>
					</div>
					<form method="post" action="/login/mfa/enroll" class="mt-4 space-y-4">
						<input type="hidden" name="action" value="confirm"/>
						<div class="space-y-2">
							<label for="mfa-enrollment-code" class="text-sm font-medium">{ i18n.T(ctx, "signin.enroll.code_label") }</label>
							<input id="mfa-enrollment-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus class="flex h-12 w-full rounded-md border border-input bg-background px-3 py-2 text-center font-mono text-xl tracking-[0.35em] outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50"/>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							{ i18n.T(ctx, "signin.totp.verify") }
						}
					</form>
					<form method="post" action="/login/mfa/enroll" class="mt-2">
						<input type="hidden" name="action" value="restart"/>
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, FullWidth: true}) {
							{ i18n.T(ctx, "signin.totp.new_key") }
						}
					</form>
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "signin.enroll.note") }</p>
				</div>
			</main>
		</body>
	</html>
}

templ MFAEnrollmentCodesPage(data MFAEnrollmentCodesData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "signin.title.codes") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-lg">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">{ i18n.T(ctx, "signin.codes.verified") }</p>
						<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "signin.codes.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "signin.codes.description") }</p>
					</div>
					if data.ErrorMessage != "" {
						<div id="mfa-enrollment-codes-error" role="alert" aria-live="polite" class="mb-4 rounded-lg border border-destructive/20 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.ErrorMessage }</div>
					}
					if len(data.Codes) > 0 {
						<div role="alert" class="rounded-lg border border-warning/30 bg-warning/10 px-4 py-3">
							<p class="text-sm font-medium text-warning">{ i18n.T(ctx, "signin.codes.shown_once") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "signin.codes.copy") }</p>
						</div>
						<div class="mt-4 grid gap-2 rounded-xl border border-border bg-card p-5 sm:grid-cols-2" aria-label={ i18n.T(ctx, "security.recovery.new_codes") }>
							for _, code := range data.Codes {
								<code class="rounded-md border border-border bg-background px-3 py-2 text-center font-mono text-sm">{ code }</code>
							}
						</div>
					} else if data.Generated {
						<div class="rounded-xl border border-border bg-card p-6">
							<p class="text-sm font-medium">{ i18n.T(ctx, "signin.codes.already_shown") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "signin.codes.regenerate_hint") }</p>
						</div>
					}
					if data.Generated {
						<form method="post" action="/login/mfa/enroll/codes" class="mt-4 space-y-4">
							<input type="hidden" name="action" value="complete"/>
							<input type="hidden" name="batch_id" value={ data.BatchID }/>
							<label class="flex items-start gap-3 rounded-lg border border-border bg-card p-4 text-sm">
								<input type="checkbox" name="saved" value="yes" required class="mt-0.5 h-4 w-4 rounded border-input"/>
								<span>{ i18n.T(ctx, "signin.codes.ack") }</span>
							</label>
							@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
								{ i18n.T(ctx, "signin.codes.finish") }
							}
						</form>
						<form method="post" action="/login/mfa/enroll/codes" class="mt-2">
							<input type="hidden" name="action" value="regenerate"/>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, FullWidth: true}) {
								{ i18n.T(ctx, "signin.codes.replace") }
							}
						</form>
					} else {
						<form method="post" action="/login/mfa/enroll/codes" class="mt-4">
							<input type="hidden" name="action" value="generate"/>
							@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
								{ i18n.T(ctx, "signin.codes.generate") }
							}
						</form>
					}
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "signin.codes.note") }</p>
				</div>
			</main>
		</body>
	</html>
}

