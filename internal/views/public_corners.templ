package views

import (
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"github.com/cristianadrielbraun/gofer/internal/buildinfo"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// PublicPageCorners sits in the corners of the pages shown before sign-in,
// away from their controls: a language picker at the top and Gofer's version
// at the bottom. A language picked here is saved as the user's language once
// they sign in.
templ PublicPageCorners() {
	<div class="absolute right-4 top-4 z-40" data-public-language>
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{Name: "public_language", Class: "h-8 min-w-28 bg-background/80 text-xs", DisableClear: true, Attributes: templ.Attributes{"data-public-language-input": "", "aria-label": i18n.T(ctx, "settings.regional.language.title")}}) {
				@selectbox.Value() {
					{ i18n.NativeName(i18n.FromContext(ctx)) }
				}
			}
			@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
				for _, locale := range i18n.Locales() {
					@selectbox.Item(selectbox.ItemProps{Value: string(locale), Selected: locale == i18n.FromContext(ctx), Attributes: templ.Attributes{"lang": string(locale)}}) {
						{ i18n.NativeName(locale) }
					}
				}
			}
		}
	</div>
	{{ info := buildinfo.Get() }}
	<a href={ templ.SafeURL(publicVersionURL(info)) } target="_blank" rel="noopener noreferrer" class="fixed bottom-3 right-4 z-30 font-mono text-[11px] text-muted-foreground/70 hover:text-foreground hover:underline underline-offset-2" data-public-version>
		{ publicVersionLabel(info) }
	</a>
	@selectbox.Script()
	<script src={ assetver.URL("/assets/js/public-language.js") } defer></script>
}

// publicVersionLabel is the short version shown before sign-in: the release,
// such as "Gofer v0.14.0", or the commit of a build from source, such as
// "Gofer dev · 7e36941".
func publicVersionLabel(info buildinfo.Info) string {
	if info.Release() {
		return "Gofer " + info.Version
	}
	if commit := info.ShortCommit(); commit != "" {
		return "Gofer dev · " + commit
	}
	return "Gofer dev"
}

// publicVersionURL links the version to its release on GitHub, or to its
// commit for a build from source. Gofer can't tell whether a local commit was
// pushed, so that link may not lead anywhere, as in the About tab.
func publicVersionURL(info buildinfo.Info) string {
	if info.Release() {
		return goferRepositoryURL + "/releases/tag/" + info.Version
	}
	if info.Commit != "" {
		return goferRepositoryURL + "/commit/" + info.Commit
	}
	return goferRepositoryURL
}
