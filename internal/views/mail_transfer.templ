package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"context"
	"fmt"
	"strings"

	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/radio"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
)

type MailTransferFolder struct {
	ID       string
	Path     string
	Role     string
	Messages int
	Target   string
	NewName  string
}

type MailTransferFormData struct {
	Sources  []MailImportAccount
	Targets  []MailImportAccount
	SourceID string
	TargetID string
	// Mode is "copy", "move" or "move-delete", as mailTransferMode names
	// them.
	Mode string
	// SourceEmail names the account moved messages are deleted from.
	SourceEmail string
	Folders     []MailTransferFolder
	Destination []MailImportFolder
	Message     string
}

// MailTransferJob is one transfer in the list. State is "running",
// "paused", "done" or "canceled".
type MailTransferJob struct {
	ID         string
	Source     string
	Target     string
	Move       bool
	ForGood    bool
	State      string
	Error      string
	Folder     string
	Waiting    bool
	Processed  int
	Total      int
	Copied     int
	Duplicates int
	Failed     int
	Deleted    int
	Started    string
	Skipped    []string
}

type MailTransferPanelData struct {
	Form MailTransferFormData
}

// MailTransferPanel is the Copy or move dialog's content.
templ MailTransferPanel(data MailTransferPanelData) {
	<div id="mail-transfer-form" class="flex min-h-0 flex-1 flex-col" data-mail-transfer-panel>
		@MailTransferForm(data.Form)
	</div>
}

templ mailTransferAccountSelect(name, label string, accounts []MailImportAccount, selected string) {
	<div class="flex min-w-0 flex-1 flex-col gap-1.5">
		<span class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</span>
		@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
			@selectbox.Trigger(selectbox.TriggerProps{
				Name:         name,
				Class:        "h-8 bg-background text-xs",
				DisableClear: true,
				Required:     true,
				Attributes: templ.Attributes{
					"value":                      selected,
					"aria-label":                 label,
					"hx-get":                     "/api/mail/transfers/new",
					"hx-trigger":                 "change",
					"hx-target":                  "#mail-transfer-form",
					"hx-swap":                    "innerHTML",
					"hx-include":                 "closest form",
					"data-mail-transfer-account": name,
				},
			}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "transfer.choose_account")})
			}
			@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
				@selectbox.Group() {
					for _, account := range accounts {
						@selectbox.Item(selectbox.ItemProps{Value: account.ID, Selected: account.ID == selected, Disabled: account.Problem != ""}) {
							{ mailTransferAccountLabel(account) }
						}
					}
				}
			}
		}
	</div>
}

func mailTransferAccountLabel(account MailImportAccount) string {
	label := account.Email
	if account.Name != "" && account.Name != account.Email {
		label = account.Name + " (" + account.Email + ")"
	}
	if account.Problem != "" {
		label += " — " + strings.TrimSuffix(account.Problem, ".")
	}
	return label
}

templ MailTransferForm(data MailTransferFormData) {
	<form
		hx-post="/api/mail/transfers"
		hx-target="#mail-transfer-dialog-body"
		hx-swap="innerHTML"
		class={ dataDialogFormClass }
		data-mail-transfer-form
	>
		@dataDialogScroll("space-y-4 pb-4") {
			if len(data.Sources) < 2 {
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "transfer.move.need_two") }</p>
			} else {
				<div class="flex flex-col gap-3 sm:flex-row sm:items-end">
					@mailTransferAccountSelect("from", i18n.T(ctx, "transfer.move.from"), data.Sources, data.SourceID)
					<span class="hidden pb-2 text-muted-foreground sm:block">
						@icon.ArrowRight(icon.Props{Class: "size-4"})
					</span>
					@mailTransferAccountSelect("to", i18n.T(ctx, "transfer.move.to"), data.Targets, data.TargetID)
				</div>
				<div class="space-y-2" role="radiogroup" aria-label={ i18n.T(ctx, "transfer.move.mode_label") }>
					<label class="flex items-start gap-2.5 text-sm text-foreground">
						<span class="mt-0.5 flex shrink-0">
							@radio.Radio(radio.Props{Name: "mode", Value: "copy", Checked: data.Mode != "move" && data.Mode != "move-delete"})
						</span>
						<span>
							<span class="font-medium">{ i18n.T(ctx, "mail.to_account.copy") }</span>
							<span class="block text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "transfer.move.copy_detail") }</span>
						</span>
					</label>
					<label class="flex items-start gap-2.5 text-sm text-foreground">
						<span class="mt-0.5 flex shrink-0">
							@radio.Radio(radio.Props{Name: "mode", Value: "move", Checked: data.Mode == "move"})
						</span>
						<span>
							<span class="font-medium">{ i18n.T(ctx, "mail.to_account.move") }</span>
							<span class="block text-xs text-muted-foreground mt-0.5">
								if data.SourceEmail != "" {
									{ i18n.T(ctx, "transfer.move.move_detail", "account", data.SourceEmail) }
								}
							</span>
						</span>
					</label>
					<label class="flex items-start gap-2.5 text-sm text-foreground">
						<span class="mt-0.5 flex shrink-0">
							@radio.Radio(radio.Props{Name: "mode", Value: "move-delete", Checked: data.Mode == "move-delete"})
						</span>
						<span>
							<span class="font-medium">{ i18n.T(ctx, "mail.to_account.move_delete") }</span>
							<span class="block text-xs text-muted-foreground mt-0.5">
								if data.SourceEmail != "" {
									{ i18n.T(ctx, "transfer.move.move_delete_detail", "account", data.SourceEmail) }
								}
							</span>
						</span>
					</label>
				</div>
				if data.Message != "" {
					<p class="text-xs text-destructive" role="alert" data-mail-transfer-error>{ data.Message }</p>
				}
				if data.SourceID != "" && data.TargetID != "" && data.SourceID != data.TargetID {
					if len(data.Folders) == 0 {
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "transfer.move.no_folders") }</p>
					} else {
						<div class="space-y-2">
							<label class="flex items-center gap-2.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
								@checkbox.Checkbox(checkbox.Props{Group: "mail-transfer-folders", GroupParent: true, Checked: true, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "transfer.all_folders")}})
								{ i18n.T(ctx, "transfer.move.folders") }
							</label>
							<div class="divide-y divide-border/60 rounded-md border border-border/60 bg-background">
								for _, folder := range data.Folders {
									@mailTransferFolderRow(folder, data.Destination)
								}
							</div>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "transfer.move.spam_trash") }</p>
						</div>
					}
				}
			}
		}
		if mailTransferCanStart(data) {
			@dataDialogFooter() {
				<button type="submit" class={ profilePrimaryButtonClass } data-mail-transfer-start>{ i18n.T(ctx, "transfer.move.start") }</button>
			}
		}
	</form>
}

func mailTransferCanStart(data MailTransferFormData) bool {
	return len(data.Sources) >= 2 && data.SourceID != "" && data.TargetID != "" && data.SourceID != data.TargetID && len(data.Folders) > 0
}

templ mailTransferFolderRow(folder MailTransferFolder, destination []MailImportFolder) {
	<div class="flex flex-col gap-2 p-2.5 sm:flex-row sm:items-center sm:gap-3" data-mail-transfer-folder={ folder.Path }>
		<label class="flex min-w-0 flex-1 items-center gap-2.5">
			@checkbox.Checkbox(checkbox.Props{Name: "folder", Value: folder.ID, Group: "mail-transfer-folders", Checked: mailExportFolderChecked(MailExportFolder{Role: folder.Role})})
			<span class="min-w-0">
				<span class="block truncate text-sm text-foreground">{ folder.Path }</span>
				<span class="block text-xs text-muted-foreground">{ mailExportCount(ctx, folder.Messages) }</span>
			</span>
		</label>
		<span class="flex min-w-0 flex-col gap-1.5 sm:w-64 sm:shrink-0">
			@mailFolderTargetSelect("target:"+folder.ID, i18n.T(ctx, "transfer.move.destination_for", "name", folder.Path), destination, folder.Target, false)
			<input
				type="text"
				name={ "new:" + folder.ID }
				value={ folder.NewName }
				placeholder={ i18n.T(ctx, "transfer.folder_name") }
				required?={ folder.Target == "new" }
				aria-label={ i18n.T(ctx, "transfer.new_folder_for", "name", folder.Path) }
				class={ "h-8 w-full rounded-md border border-input bg-background px-2 text-xs text-foreground outline-none focus:border-ring focus:ring-2 focus:ring-ring/30", templ.KV("hidden", folder.Target != "new") }
				data-mail-import-new-name
			/>
		</span>
	</div>
}

templ MailTransferJobs(jobs []MailTransferJob) {
	<div
		id="mail-transfer-jobs"
		class="space-y-2"
		if mailTransferJobsRunning(jobs) {
			hx-get="/api/mail/transfers/jobs"
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		if len(jobs) > 0 {
			<p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "transfer.move.jobs") }</p>
			for _, job := range jobs {
				@mailTransferJobRow(job)
			}
		}
	</div>
}

func mailTransferJobsRunning(jobs []MailTransferJob) bool {
	for _, job := range jobs {
		if job.State == "running" {
			return true
		}
	}
	return false
}

templ mailTransferJobRow(job MailTransferJob) {
	<div class="space-y-2 rounded-lg border border-border/60 bg-background/40 p-3" data-mail-transfer-job={ job.ID } data-mail-transfer-state={ job.State }>
		<div class="flex flex-wrap items-start gap-3">
			<span class="min-w-0 flex-1">
				<span class="flex min-w-0 items-center gap-1.5 text-sm font-medium text-foreground">
					<span class="truncate">{ job.Source }</span>
					@icon.ArrowRight(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
					<span class="truncate">{ job.Target }</span>
				</span>
				<span class="block text-xs text-muted-foreground">{ mailTransferJobStatus(ctx, job) }</span>
			</span>
			<span class="flex shrink-0 flex-wrap gap-2">
				switch job.State {
					case "running":
						<button type="button" class={ profileButtonClass } hx-post={ "/api/mail/transfers/" + job.ID + "/cancel" } hx-target="#mail-transfer-jobs" hx-swap="outerHTML">{ i18n.T(ctx, "common.cancel") }</button>
					case "paused":
						<button type="button" class={ profilePrimaryButtonClass } hx-post={ "/api/mail/transfers/" + job.ID + "/resume" } hx-target="#mail-transfer-jobs" hx-swap="outerHTML">{ i18n.T(ctx, "common.continue") }</button>
						<button type="button" class={ profileButtonClass } hx-post={ "/api/mail/transfers/" + job.ID + "/delete" } hx-target="#mail-transfer-jobs" hx-swap="outerHTML">{ i18n.T(ctx, "transfer.remove") }</button>
					default:
						<button type="button" class={ profileButtonClass } hx-post={ "/api/mail/transfers/" + job.ID + "/delete" } hx-target="#mail-transfer-jobs" hx-swap="outerHTML">{ i18n.T(ctx, "transfer.remove") }</button>
				}
			</span>
		</div>
		if job.State == "running" || job.State == "paused" {
			<div class="h-1.5 w-full overflow-hidden rounded-full bg-secondary">
				<div class="h-full rounded-full bg-primary transition-all" style={ mailTransferProgressStyle(job) }></div>
			</div>
		}
		if job.Error != "" {
			<p class="text-xs text-destructive">{ i18n.Stored(ctx, "jobs.", job.Error) }</p>
		}
		if len(job.Skipped) > 0 && job.State != "running" {
			<details class="text-xs text-muted-foreground">
				<summary class="cursor-pointer">{ mailExportCountOf(ctx, "transfer.move.failed_summary", job.Failed) }</summary>
				<ul class="mt-1 list-disc space-y-0.5 pl-5">
					for _, skipped := range job.Skipped {
						<li>{ skipped }</li>
					}
				</ul>
			</details>
		}
	</div>
}

func mailTransferProgressStyle(job MailTransferJob) templ.SafeCSS {
	percent := 0
	if job.Total > 0 {
		percent = job.Processed * 100 / job.Total
	}
	return templ.SafeCSS(fmt.Sprintf("width: %d%%;", percent))
}

func mailTransferJobStatus(ctx context.Context, job MailTransferJob) string {
	var parts []string
	switch job.State {
	case "running":
		switch {
		case job.Waiting:
			parts = append(parts, i18n.T(ctx, "transfer.move.status.waiting"))
		case job.Folder != "":
			key := "transfer.move.status.copying"
			if job.Move {
				key = "transfer.move.status.moving"
			}
			parts = append(parts, i18n.T(ctx, key, "folder", job.Folder, "done", i18n.Number(ctx, job.Processed), "total", mailExportCount(ctx, job.Total)))
		default:
			parts = append(parts, i18n.T(ctx, "transfer.status.starting"))
		}
	case "paused":
		parts = append(parts, mailTransferPausedStatus(ctx, job.Processed, job.Total))
	case "canceled":
		parts = append(parts, i18n.T(ctx, "transfer.status.canceled_after", "total", mailExportCount(ctx, job.Copied)))
	default:
		parts = append(parts, mailExportCountOf(ctx, "transfer.move.status.copied", job.Copied))
		if job.Duplicates > 0 {
			parts = append(parts, mailExportCountOf(ctx, "transfer.status.already_there", job.Duplicates))
		}
		if job.Failed > 0 {
			parts = append(parts, mailExportCountOf(ctx, "transfer.move.status.failed", job.Failed))
		}
	}
	if job.Move && job.Deleted > 0 {
		key := "transfer.move.status.deleted"
		if job.ForGood {
			key = "transfer.move.status.deleted_for_good"
		}
		parts = append(parts, i18n.N(ctx, key, job.Deleted, "count", i18n.Number(ctx, job.Deleted), "account", job.Source))
	}
	parts = append(parts, i18n.T(ctx, "transfer.status.started", "date", job.Started))
	return strings.Join(parts, " · ")
}
