package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/audit"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// AdminActivityPath is the Activity page's first tab, sign-in and security.
const AdminActivityPath = "/admin/activity"

// adminActivityTabs switches between the Activity page's two records. They
// are pages of their own, so the tabs are links, drawn like templui's tabs.
templ adminActivityTabs(active string) {
	<nav class="mt-6 inline-flex h-9 w-fit items-center justify-center rounded-lg bg-muted p-[3px] text-muted-foreground" aria-label={ i18n.T(ctx, "admin.activity.records") }>
		@adminActivityTab(templ.URL(AdminActivityPath), i18n.T(ctx, "admin.activity.tab.security"), active == "security")
		@adminActivityTab(templ.URL(AdminAuditActivityPath), i18n.T(ctx, "admin.activity.tab.administration"), active == "administration")
	</nav>
}

templ adminActivityTab(href templ.SafeURL, label string, active bool) {
	<a
		href={ href }
		data-admin-navigation-link
		data-admin-navigation-label={ label }
		if active {
			aria-current="page"
		}
		class="inline-flex h-[calc(100%-1px)] items-center justify-center rounded-md border border-transparent px-3 py-1 text-sm font-medium whitespace-nowrap text-foreground transition-[color,box-shadow] dark:text-muted-foreground aria-[current=page]:bg-background aria-[current=page]:shadow-sm dark:aria-[current=page]:border-input dark:aria-[current=page]:bg-input/30 dark:aria-[current=page]:text-foreground"
	>{ label }</a>
}

templ adminAuditKindLink(data AdminAuditActivityData, kind string, label string) {
	@adminActivityPill(adminAuditActivityPagePath(kind, 0), label, data.Kind == kind)
}

// AdminAuditActivityPage is the Activity page's administration tab: every
// administrative change, newest first.
templ AdminAuditActivityPage(data AdminAuditActivityData, verification ...AdminSecurityVerificationData) {
	<div class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden" data-admin-audit-activity>
		<div class="min-h-0 flex-1 overflow-y-auto">
			<div class="max-w-7xl px-6 py-8 lg:px-8 lg:py-10">
				@adminPageHeader(adminPageHeaderProps{Title: i18n.T(ctx, "admin.nav.activity_short"), Description: i18n.T(ctx, "admin.audit.description"), Actions: adminAuditHeaderActionsFor(data)})
				if data.ManagedMode {
					@adminActivityTabs("administration")
				}
				if !data.ManagedMode {
					<div role="status" class="mt-6 rounded-lg border border-border bg-card px-5 py-8 text-center">
						<p class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.activity.unmanaged_title") }</p>
						<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.activity.unmanaged") }</p>
					</div>
				} else if data.StepUpRequired {
					<div role="alert" class="mt-6 rounded-lg border border-amber-500/30 bg-amber-500/10 px-5 py-5 text-amber-900 dark:text-amber-100" data-admin-audit-activity-locked>
						<p class="font-semibold">{ i18n.T(ctx, "admin.verify.required") }</p>
						<p class="mt-1 text-sm">{ i18n.T(ctx, "admin.audit.verify") }</p>
						<div class="mt-4">
							@AdminSecurityVerificationTrigger(adminSecurityVerificationValue(verification), i18n.T(ctx, "admin.verify.now"))
						</div>
					</div>
				} else {
					@adminRetentionDialog(adminRetentionSetting{
						ID: "admin-audit-retention-dialog", InputID: "admin-audit-retention-days", FormAttribute: "data-admin-audit-retention",
						Action: AdminAuditActivityPath + "/retention", CSRFToken: data.RetentionCSRFToken,
						Days: data.RetentionDays, Minimum: data.RetentionMinimum, Maximum: data.RetentionMaximum, Open: data.RetentionOpen,
						Title: i18n.T(ctx, "admin.audit.retention.title"), Current: i18n.N(ctx, "admin.audit.retention.current", data.RetentionDays), Note: i18n.T(ctx, "admin.audit.retention.note"),
					})
					<nav class="mt-6 flex flex-wrap gap-2" aria-label={ i18n.T(ctx, "admin.audit.filter_label") }>
						@adminAuditKindLink(data, "", i18n.T(ctx, "admin.audit.filter.all"))
						for _, kind := range AdminAuditKinds {
							@adminAuditKindLink(data, kind, i18n.T(ctx, "admin.audit.filter."+kind))
						}
					</nav>
					@adminSection(adminSectionProps{ID: "admin-audit-heading", Title: i18n.T(ctx, "admin.audit.heading")}) {
						if len(data.Records) == 0 {
							if data.Kind == "" && data.Before == 0 {
								@adminEmptyState(i18n.T(ctx, "admin.audit.empty"))
							} else {
								@adminEmptyState(i18n.T(ctx, "admin.audit.empty_filter"))
							}
						} else {
							<div class="overflow-x-auto">
								<table class="w-full min-w-[60rem] text-left text-sm" aria-label={ i18n.T(ctx, "admin.audit.heading") }>
									<thead class="bg-muted/45 text-xs font-semibold text-muted-foreground">
										<tr>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.time") }</th>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.event") }</th>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.status") }</th>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.actor") }</th>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.client") }</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-border">
										for _, record := range data.Records {
											@adminAuditRow(record)
										}
									</tbody>
								</table>
							</div>
						}
					}
					if data.Before > 0 || data.Next > 0 {
						<nav class="mt-4 flex items-center justify-end gap-2" aria-label={ i18n.T(ctx, "admin.activity.pagination") }>
							if data.Before > 0 {
								<a href={ adminAuditActivityPagePath(data.Kind, 0) } data-admin-navigation-link class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent">{ i18n.T(ctx, "admin.audit.newest") }</a>
							}
							if data.Next > 0 {
								<a href={ adminAuditActivityPagePath(data.Kind, data.Next) } data-admin-navigation-link class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent">{ i18n.T(ctx, "admin.audit.older") }</a>
							}
						</nav>
					}
					<p class="mt-5 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.audit.privacy") }</p>
				}
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

templ adminAuditRow(record audit.Record) {
	<tr class="bg-background/35 align-top hover:bg-accent/35" data-audit-action={ record.Action }>
		<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">{ adminAuditTime(ctx, record.OccurredAt) }</td>
		<td class="px-4 py-3 font-medium text-foreground">{ adminAuditSentence(ctx, record) }</td>
		<td class="px-4 py-3">
			@adminBadge(adminOutcomeTone(record.Outcome != audit.OutcomeDenied)) {
				if record.Outcome == audit.OutcomeDenied {
					{ i18n.T(ctx, "admin.audit.denied") }
				} else {
					{ i18n.T(ctx, "admin.audit.done") }
				}
			}
		</td>
		<td class="px-4 py-3 text-foreground">{ adminAuditActor(ctx, record) }</td>
		<td class="max-w-xs break-words px-4 py-3 text-xs text-muted-foreground">
			if record.Client.UserAgent == "" {
				—
			} else {
				<span title={ record.Client.UserAgent }>{ ClientLabel(ctx, record.Client.UserAgent) }</span>
			}
		</td>
	</tr>
}

// adminAuditHeaderActionsFor exports the tab's changes and opens its
// settings, for a session that may read them.
func adminAuditHeaderActionsFor(data AdminAuditActivityData) templ.Component {
	if !data.ManagedMode || data.StepUpRequired {
		return nil
	}
	return adminAuditHeaderActions(data)
}

templ adminAuditHeaderActions(data AdminAuditActivityData) {
	@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Href: string(adminAuditExportPath(data.Kind, "csv")), Attributes: templ.Attributes{"download": ""}}) {
		@icon.Download(icon.Props{Class: "size-4"})
		{ i18n.T(ctx, "admin.audit.export_csv") }
	}
	@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Href: string(adminAuditExportPath(data.Kind, "jsonl")), Attributes: templ.Attributes{"download": ""}}) {
		@icon.Download(icon.Props{Class: "size-4"})
		{ i18n.T(ctx, "admin.audit.export_jsonl") }
	}
	@dialog.Trigger(dialog.TriggerProps{For: "admin-audit-retention-dialog"}) {
		@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"aria-haspopup": "dialog"}}) {
			@icon.Settings(icon.Props{Class: "size-4"})
			{ i18n.T(ctx, "admin.activity.settings") }
		}
	}
}
