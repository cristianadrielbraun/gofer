package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"strconv"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
)

templ CalendarResponseForm(data CalendarResponseData) {
	<form class="space-y-1.5" data-calendar-response-form data-calendar-event-id={ data.EventID } data-calendar-response-scope={ data.Scope } data-calendar-response-ready={ strconv.FormatBool(data.Ready) } hx-post={ calendarEventDetailsURL(data.EventID) + "/response" } hx-params="version,scope,response" hx-swap="none" hx-sync="this:drop">
		<input type="hidden" name="version" value={ data.Version }/>
		<input type="hidden" name="scope" value={ data.Scope }/>
		<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
			<div class="flex items-center gap-3">
				<h3 id="calendar-event-response-label" class="text-sm font-medium">{ i18n.T(ctx, "calendar.response.going") }</h3>
				@dropdown.Dropdown() {
					@dropdown.Trigger() {
						@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantOutline, Disabled: !data.Ready, Attributes: templ.Attributes{"data-calendar-response-trigger": "", "aria-haspopup": "menu", "aria-labelledby": "calendar-event-response-label calendar-event-response-value"}}) {
							if data.Ready {
								@CalendarResponseIcon(data.Status)
							} else {
								@icon.LoaderCircle(icon.Props{Class: "size-3.5 animate-spin text-muted-foreground"})
							}
							<span id="calendar-event-response-value" data-calendar-response-status>
								if data.Ready {
									{ calendarResponseLabel(ctx, data.Status) }
								} else {
									{ i18n.T(ctx, "calendar.response.checking") }
								}
							</span>
							@icon.ChevronDown(icon.Props{Class: "size-3.5 text-muted-foreground"})
						}
					}
					@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementTopStart, Class: "mobile-sheet w-44", Attributes: templ.Attributes{"role": "menu", "aria-label": i18n.T(ctx, "calendar.response.respond")}}) {
						for _, status := range []string{"accepted", "tentative", "declined"} {
							@dropdown.Item(dropdown.ItemProps{Disabled: !data.Ready, Class: "justify-start gap-2 aria-[current=true]:bg-accent aria-[current=true]:text-accent-foreground", Attributes: templ.Attributes{"type": "submit", "name": "response", "value": status, "data-calendar-response-choice": status, "aria-current": strconv.FormatBool(data.Status == status)}}) {
								@CalendarResponseIcon(status)
								if status == "accepted" {
									{ i18n.T(ctx, "calendar.response.accept") }
								} else if status == "tentative" {
									{ i18n.T(ctx, "calendar.response.maybe") }
								} else {
									{ i18n.T(ctx, "calendar.response.decline") }
								}
							}
						}
					}
				}
			</div>
			if data.HasOccurrence {
				<div class="ml-auto inline-flex rounded-md border border-border bg-background/60 p-0.5" role="group" aria-label={ i18n.T(ctx, "calendar.response.scope") }>
					for _, scope := range []string{"occurrence", "series"} {
						@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantGhost, Class: "h-7 rounded-[5px] px-2.5 text-xs font-medium text-muted-foreground hover:bg-transparent aria-pressed:bg-accent aria-pressed:text-accent-foreground aria-pressed:shadow-xs", Attributes: templ.Attributes{
							"data-calendar-response-load": "", "aria-pressed": strconv.FormatBool(scope == data.Scope),
							"hx-get": calendarEventDetailsURL(data.EventID) + "/response?scope=" + scope,
							"hx-target": "closest [data-calendar-response-container]", "hx-swap": "innerHTML", "hx-params": "none", "hx-sync": "closest [data-calendar-response-container]:replace",
						}}) {
							if scope == "series" {
								{ i18n.T(ctx, "calendar.entire_series") }
							} else {
								{ i18n.T(ctx, "calendar.this_event") }
							}
						}
					}
				</div>
			}
		</div>
		<p class="text-[11px] leading-4 text-muted-foreground" data-calendar-response-progress role="status" aria-live="polite">
			if data.Delivery == "email" {
				{ i18n.T(ctx, "calendar.response.email_note") }
			} else if data.Scope == "series" {
				{ i18n.T(ctx, "calendar.response.series_note") }
			} else if data.Scope == "occurrence" {
				{ i18n.T(ctx, "calendar.response.occurrence_note") }
			} else {
				{ i18n.T(ctx, "calendar.response.sent_note") }
			}
		</p>
		<p hidden data-calendar-response-error role="alert" tabindex="-1" class="text-xs text-destructive"></p>
		if !data.Ready {
			@button.Button(button.Props{Size: button.SizeSm, Variant: button.VariantGhost, Attributes: templ.Attributes{
				"data-calendar-response-load": "", "hx-get": calendarEventDetailsURL(data.EventID) + "/response?scope=" + data.Scope,
				"hx-trigger": "load, click", "hx-target": "closest [data-calendar-response-container]", "hx-swap": "innerHTML", "hx-params": "none", "hx-sync": "closest [data-calendar-response-container]:replace",
			}}) {
				@icon.RefreshCw(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "calendar.response.check") }
			}
		}
	</form>
}

templ CalendarResponseIcon(status string) {
	if status == "accepted" {
		@icon.Check(icon.Props{Class: "size-3.5 text-emerald-600 dark:text-emerald-400"})
	} else if status == "tentative" {
		@icon.Minus(icon.Props{Class: "size-3.5 text-amber-600 dark:text-amber-400"})
	} else if status == "declined" {
		@icon.X(icon.Props{Class: "size-3.5 text-destructive"})
	}
}

templ CalendarReplyStatus(data CalendarReplyData) {
	<div class="space-y-3" data-calendar-reply-status={ data.State } hx-get={ "/api/calendar/replies/"+data.ID } hx-target="this" hx-swap="outerHTML" hx-sync="this:drop"
		if data.State == "pending" && (data.SendStatus == "pending" || data.SendStatus == "sending" || data.SendStatus == "sent") {
			hx-trigger="every 3s"
		} else {
			hx-trigger="none"
		}
	>
		<h3 class="text-sm font-medium">{ i18n.T(ctx, "calendar.reply.title") }</h3>
		<p class="flex items-start gap-2 text-xs leading-5" role="status" aria-live="polite">
			if data.State == "complete" {
				@icon.Check(icon.Props{Class:"mt-0.5 size-4 shrink-0 text-emerald-600 dark:text-emerald-400"})
				{ i18n.T(ctx, "calendar.reply.complete") }
			} else if data.State == "conflict" || data.State == "dismissed" {
				@icon.TriangleAlert(icon.Props{Class:"mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400"})
				{ i18n.T(ctx, "calendar.reply.conflict") }
			} else if data.State == "canceled" || data.SendStatus == "canceled" {
				{ i18n.T(ctx, "calendar.reply.canceled") }
			} else if data.SendStatus == "ambiguous" {
				@icon.TriangleAlert(icon.Props{Class:"mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400"})
				{ i18n.T(ctx, "calendar.reply.ambiguous") }
			} else if data.SendStatus == "failed" {
				@icon.X(icon.Props{Class:"mt-0.5 size-4 shrink-0 text-destructive"})
				{ i18n.T(ctx, "calendar.reply.failed") }
			} else {
				@icon.LoaderCircle(icon.Props{Class:"mt-0.5 size-4 shrink-0 animate-spin text-muted-foreground"})
				if data.SendStatus == "sent" {
					{ i18n.T(ctx, "calendar.reply.sent") }
				} else if data.SendStatus == "sending" {
					{ i18n.T(ctx, "calendar.reply.sending") }
				} else {
					{ i18n.T(ctx, "calendar.reply.queued") }
				}
			}
		</p>
			if data.Note != "" {
				<p class="text-xs text-destructive" role="alert">{data.Note}</p>
			}
		if data.State == "pending" && (data.SendStatus == "failed" || data.SendStatus == "pending") {
			<form class="flex gap-2" hx-post={ "/api/calendar/replies/"+data.ID } hx-target="closest [data-calendar-reply-status]" hx-swap="outerHTML" hx-disabled-elt="find button" hx-sync="closest [data-calendar-reply-status]:drop">
				if data.SendStatus == "failed" {
						@button.Button(button.Props{Type:button.TypeSubmit,Size:button.SizeSm,Variant:button.VariantOutline,Attributes:templ.Attributes{"name":"action","value":"retry"}}) {
							{ i18n.T(ctx, "calendar.reply.retry") }
						}
				}
					@button.Button(button.Props{Type:button.TypeSubmit,Size:button.SizeSm,Variant:button.VariantGhost,Attributes:templ.Attributes{"name":"action","value":"cancel"}}) {
						{ i18n.T(ctx, "calendar.reply.cancel") }
					}
			</form>
		}
		if data.State == "pending" && data.SendStatus == "ambiguous" {
			<form class="flex flex-wrap gap-2" hx-post={ "/api/calendar/replies/"+data.ID } hx-target="closest [data-calendar-reply-status]" hx-swap="outerHTML" hx-disabled-elt="find button" hx-sync="closest [data-calendar-reply-status]:drop">
				@button.Button(button.Props{Type:button.TypeSubmit,Size:button.SizeSm,Variant:button.VariantOutline,Attributes:templ.Attributes{"name":"action","value":"confirm-sent"}}) {
					{ i18n.T(ctx, "calendar.reply.confirm_sent") }
				}
				@button.Button(button.Props{Type:button.TypeSubmit,Size:button.SizeSm,Variant:button.VariantGhost,Attributes:templ.Attributes{"name":"action","value":"resend-confirmed"}}) {
					{ i18n.T(ctx, "calendar.reply.resend") }
				}
			</form>
		}
		if data.State == "conflict" {
			<form hx-post={ "/api/calendar/replies/"+data.ID } hx-target="closest [data-calendar-reply-status]" hx-swap="outerHTML" hx-disabled-elt="find button">
				@button.Button(button.Props{Type:button.TypeSubmit,Size:button.SizeSm,Variant:button.VariantGhost,Attributes:templ.Attributes{"name":"action","value":"dismiss"}}) {
					{ i18n.T(ctx, "calendar.reply.dismiss") }
				}
			</form>
		}
		if data.State != "pending" && data.State != "conflict" {
				@button.Button(button.Props{Size:button.SizeSm,Variant:button.VariantGhost,Attributes:templ.Attributes{"hx-get":calendarEventDetailsURL(data.EventID)+"/response?scope="+data.Scope,"hx-target":"closest [data-calendar-response-container]","hx-swap":"innerHTML","hx-params":"none"}}) {
					{ i18n.T(ctx, "calendar.response.check_invitation") }
				}
		}
	</div>
}
