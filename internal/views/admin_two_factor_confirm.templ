package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// adminTwoFactorConfirmDialogID is the dialog that confirms a change that
// newly requires two-factor sign-in of people.
const adminTwoFactorConfirmDialogID = "admin-two-factor-confirm"

// AdminTwoFactorConfirm asks before a change that newly requires
// two-factor sign-in of people, through a policy: who it reaches, and
// whether to sign them out now. It sends the change's form again to Action.
type AdminTwoFactorConfirm struct {
	Action    string
	CSRFToken string
	Fields    []AdminFormField
	People    AdminSignInData
	Count     int
}

// AdminFormField is one field of a form sent again.
type AdminFormField struct {
	Name  string
	Value string
}

templ AdminTwoFactorConfirmDialog(d AdminTwoFactorConfirm) {
	@dialog.Dialog(dialog.Props{ID: adminTwoFactorConfirmDialogID, Open: true}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg max-h-[calc(100vh-2rem)] overflow-y-auto"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.N(ctx, "admin.two_factor.confirm_title", d.Count, "count", i18n.Number(ctx, d.Count)) }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.two_factor.confirm_detail") }
				}
			}
			<form method="post" action={ templ.SafeURL(d.Action) } class="space-y-4" data-step-up data-admin-two-factor-confirm>
				<input type="hidden" name="_csrf" value={ d.CSRFToken }/>
				for _, field := range d.Fields {
					<input type="hidden" name={ field.Name } value={ field.Value }/>
				}
				<input type="hidden" name="confirm_two_factor" value="1"/>
				<div class="space-y-3 text-sm">
					@adminTwoFactorWithoutApp(d.People)
				</div>
				if d.People.SessionsToEnd > 0 {
					<label for="admin-two-factor-sign-out" class="flex cursor-pointer items-start gap-3 rounded-md border border-border px-3 py-2.5 hover:bg-accent/35">
						@checkbox.Checkbox(checkbox.Props{ID: "admin-two-factor-sign-out", Name: "sign_out", Value: "1", Class: "mt-0.5"})
						<span class="min-w-0 text-sm">
							<span class="block font-semibold text-foreground">{ i18n.T(ctx, "admin.two_factor.sign_out") }</span>
							<span class="mt-0.5 block text-xs text-muted-foreground">{ i18n.N(ctx, "admin.two_factor.sign_out_detail", d.People.SessionsToEnd, "count", i18n.Number(ctx, d.People.SessionsToEnd)) }</span>
						</span>
					</label>
				} else {
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.two_factor.no_sessions") }</p>
				}
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: adminTwoFactorConfirmDialogID}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ i18n.T(ctx, "admin.two_factor.confirm") }
					}
				}
			</form>
		}
	}
}
