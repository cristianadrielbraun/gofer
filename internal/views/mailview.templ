package views

import (
	"fmt"
	"strings"
	"github.com/cristianadrielbraun/gofer/internal/models"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/copybutton"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/popover"
	"github.com/cristianadrielbraun/gofer/components/tabs"
	"github.com/cristianadrielbraun/gofer/components/tooltip"

	"github.com/dustin/go-humanize"
)

func contactDisplay(c models.Contact) string {
	if c.Name != "" {
		return c.Name
	}
	return c.Email
}

templ MailViewAvatar(contact models.Contact, messageID string, class string, fallbackClass string) {
	if strings.TrimSpace(contact.AvatarURL) != "" {
		{{ dialogID := "mail-avatar-preview-" + messageID }}
		@dialog.Trigger(dialog.TriggerProps{For: dialogID, Class: "inline-flex shrink-0"}) {
			<button
				type="button"
				class="group relative inline-flex shrink-0 rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-ink/25 focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
				aria-label="View profile picture"
				data-contact-avatar-preview-trigger
				data-contact-avatar-preview-dialog={ dialogID }
				data-contact-avatar-preview-alt={ contactDisplay(contact) + " profile picture" }
				data-contact-avatar-preview-src={ contactAvatarRenderURL(contactAvatarPreviewURL(contact.AvatarURL)) }
			>
				@ContactAvatar(contact, class, fallbackClass)
				<span class="pointer-events-none absolute inset-0 flex items-center justify-center rounded-full bg-ink/0 text-white opacity-0 transition group-hover:bg-ink/25 group-hover:opacity-100 group-focus-visible:bg-ink/25 group-focus-visible:opacity-100">
					@icon.Search(icon.Props{Class: "size-4 drop-shadow"})
				</span>
			</button>
		}
		@ContactAvatarPreviewDialog(contact, dialogID)
	} else {
		@ContactAvatar(contact, class, fallbackClass)
	}
}

func threadAwareAction(singleFn, threadFn string, email *models.Email) string {
	if email.ThreadCount > 1 {
		return onAction(threadFn, email.ID)
	}
	return onAction(singleFn, email.ID)
}

func threadAwareLabel(single, thread string, email *models.Email) string {
	if email.ThreadCount > 1 {
		return thread
	}
	return single
}

// mailViewReadAttributes makes the toolbar read toggle act on the whole thread. Each thread
// message keeps its own toggle in its action row.
func mailViewReadAttributes(email *models.Email, thread []models.ThreadItem) templ.Attributes {
	read := fmt.Sprintf("%t", mailViewRead(email, thread))
	if email.ThreadCount > 1 {
		return templ.Attributes{"data-on-click": onAction("toggleThreadRead", email.ID), "data-read-thread": email.ID, "data-read-thread-id": email.ThreadID, "data-is-read": read}
	}
	return templ.Attributes{"data-on-click": onAction("toggleRead", email.ID), "data-read-email": email.ID, "data-is-read": read}
}

// mailViewRead reports whether the toolbar shows the message as read: for a thread, when
// every message in it is read.
func mailViewRead(email *models.Email, thread []models.ThreadItem) bool {
	if email.ThreadCount <= 1 || len(thread) == 0 {
		return email.IsRead
	}
	for _, item := range thread {
		if !item.IsRead {
			return false
		}
	}
	return true
}

// mailViewStarAttributes makes the toolbar star act on the whole thread, like the other
// toolbar actions. Each thread message keeps its own star in its action row.
func mailViewStarAttributes(email *models.Email) templ.Attributes {
	if email.ThreadCount > 1 {
		return templ.Attributes{"data-on-click": onAction("toggleThreadStar", email.ID), "data-star-thread": email.ID, "data-star-thread-id": email.ThreadID}
	}
	return templ.Attributes{"data-on-click": onAction("toggleStar", email.ID), "data-star-email": email.ID}
}

// mailViewStarred reports whether the toolbar star is filled: for a thread, when any of
// its messages is starred.
func mailViewStarred(email *models.Email, thread []models.ThreadItem) bool {
	if email.ThreadCount <= 1 || len(thread) == 0 {
		return email.IsStarred
	}
	for _, item := range thread {
		if item.IsStarred {
			return true
		}
	}
	return false
}

func formatContacts(contacts []models.Contact) string {
	parts := make([]string, len(contacts))
	for i, c := range contacts {
		if c.Name != "" {
			parts[i] = fmt.Sprintf("%s <%s>", c.Name, c.Email)
		} else {
			parts[i] = c.Email
		}
	}
	return strings.Join(parts, ", ")
}

func shouldShowAttachment(att models.Attachment) bool {
	if !att.Inline {
		return true
	}
	ct := strings.ToLower(att.ContentType)
	name := strings.ToLower(att.Filename)
	return !(strings.HasPrefix(ct, "image/") || strings.HasSuffix(name, ".png") || strings.HasSuffix(name, ".jpg") || strings.HasSuffix(name, ".jpeg") || strings.HasSuffix(name, ".gif") || strings.HasSuffix(name, ".webp") || strings.HasSuffix(name, ".svg"))
}

templ MailView(email *models.Email, thread []models.ThreadItem) {
	<div id="mail-view" class="hidden lg:flex flex-1 flex-col min-w-0 bg-background surface-desk" data-mail-reader>
		if email != nil {
			@MailViewContent(email, thread)
		} else {
			@MailViewEmpty()
		}
	</div>
}

// MailViewLoading draws the reader as a single message (see MailViewContent) with
// placeholders where its details go. Keep it in step with showMailViewLoading in
// app.js, which draws the same sheet with what the list row already knows.
templ MailViewLoading() {
	<div id="mail-view" class="hidden lg:flex flex-1 flex-col min-w-0 bg-background surface-desk" data-mail-reader>
		<div class="mail-view-frame flex flex-col h-full" aria-busy="true" aria-label="Loading message">
			<div class="surface-paper rounded-md flex flex-col h-full overflow-hidden">
				<div class="mail-view-toolbar flex items-center justify-between px-6 py-2.5">
					<div class="mail-view-actions flex items-center gap-1 min-w-0">
						<button type="button" class="mobile-back-button h-9 w-9 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-ink/5" data-on-click='["closeMobileMailView"]' aria-label="Back to list">
							@icon.ArrowLeft(icon.Props{Class: "size-5"})
						</button>
						@mailViewLoadingToolbarButton() {
							@icon.Trash2(icon.Props{Class: "size-4"})
						}
						@mailViewLoadingToolbarButton() {
							@icon.Archive(icon.Props{Class: "size-4"})
						}
						<div>
							<button type="button" disabled tabindex="-1" data-mail-action="spam" class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-ink opacity-25">
								@icon.ShieldAlert(icon.Props{Class: "size-4"})
							</button>
						</div>
						@mailViewLoadingToolbarButton() {
							@icon.Star(icon.Props{Class: "size-4"})
						}
						@mailViewLoadingToolbarButton() {
							@icon.Mail(icon.Props{Class: "size-4"})
						}
					</div>
					<div class="mail-view-meta flex items-center gap-2">
						<span class="mail-view-date h-3 w-32 rounded bg-ink/5 animate-pulse"></span>
						@mailViewLoadingToolbarButton() {
							@icon.EllipsisVertical(icon.Props{Class: "size-4"})
						}
					</div>
				</div>
				<div class="h-px bg-gradient-to-r from-transparent via-amber-900/10 to-transparent"></div>
				<div class="flex-1 overflow-y-auto">
					<div class="mail-view-content mx-auto px-8 py-6">
						<div class="mail-view-sender flex items-start gap-4">
							<div class="mail-view-avatar size-11 rounded-full bg-gradient-to-b from-amber-700/40 to-amber-900/40 shrink-0 animate-pulse"></div>
							<div class="flex-1 min-w-0">
								<div class="flex items-center gap-2 flex-wrap min-h-6">
									<span class="h-4 w-40 rounded bg-ink/5 animate-pulse"></span>
									<span class="mail-view-address h-3 w-48 rounded bg-ink/5 animate-pulse"></span>
								</div>
								<div class="mt-1.5 h-3 w-28 rounded bg-ink/5 animate-pulse"></div>
							</div>
						</div>
						<div class="mail-view-subject-row flex items-start justify-between gap-4 mt-5">
							<div class="h-6 w-2/3 rounded bg-ink/5 animate-pulse"></div>
						</div>
						<div class="h-px bg-gradient-to-r from-transparent via-ink/10 to-transparent my-6"></div>
						<div class="mb-3 flex justify-end lg:justify-between">
							<div class="hidden lg:block h-7 w-48 shrink-0 rounded-lg bg-ink/[0.04] animate-pulse"></div>
							<div class="h-7 w-32 rounded-md border border-ink/10 bg-ink/[0.04] animate-pulse"></div>
						</div>
						<div class="space-y-3 py-2">
							<div class="h-4 w-full rounded bg-ink/5 animate-pulse"></div>
							<div class="h-4 w-11/12 rounded bg-ink/5 animate-pulse"></div>
							<div class="h-4 w-4/5 rounded bg-ink/5 animate-pulse"></div>
							<div class="h-4 w-2/3 rounded bg-ink/5 animate-pulse"></div>
						</div>
					</div>
				</div>
				<div class="px-6 py-3 border-t border-ink/6">
					<div class="mail-view-reply-actions flex items-center gap-2">
						@mailViewLoadingReplyButton("Reply") {
							@icon.Reply(icon.Props{Class: "size-4"})
						}
						@mailViewLoadingReplyButton("Reply All") {
							@icon.ReplyAll(icon.Props{Class: "size-4"})
						}
						@mailViewLoadingReplyButton("Forward") {
							@icon.Forward(icon.Props{Class: "size-4"})
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ mailViewLoadingToolbarButton() {
	<button type="button" disabled tabindex="-1" class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-ink opacity-25">
		{ children... }
	</button>
}

templ mailViewLoadingReplyButton(label string) {
	<button type="button" disabled tabindex="-1" class="inline-flex flex-1 h-9 items-center justify-center rounded-md border border-ink/10 text-ink/35">
		<span class="flex items-center gap-2 text-[13px]">
			{ children... }
			{ label }
		</span>
	</button>
}

templ MailViewContent(email *models.Email, thread []models.ThreadItem) {
	<div class="mail-view-frame flex flex-col h-full">
		if len(thread) > 1 {
			@MailViewThreadContent(email, thread)
		} else {
			<div class="surface-paper rounded-md flex flex-col h-full overflow-hidden">
				@MailViewHeader(email, thread)
				<div class="h-px bg-gradient-to-r from-transparent via-amber-900/10 to-transparent"></div>
				<div class="flex-1 overflow-y-auto">
					<div class="mail-view-content mx-auto px-8 py-6">
						@MailViewSender(email)
						<div class="mail-view-mobile-tools mail-view-message-actions mt-2 -mr-1 flex items-center justify-end gap-0.5 lg:hidden">
							@EmailBodyStyleCycleButton(email.ID)
							@EmailTranslateIconButton(email.ID)
						</div>
						<div class="h-px bg-gradient-to-r from-transparent via-ink/10 to-transparent my-6"></div>
						@MailViewBody(email)
					</div>
				</div>
				<div id={"mail-calendar-footer-"+email.ID} data-mail-calendar-footer class="max-h-[35dvh] shrink-0 overflow-y-auto" hx-get={"/api/mail/"+email.ID+"/calendar"} hx-trigger="load" hx-swap="innerHTML" hx-sync="this:replace"></div>
				if email.IsDraft {
					@MailViewDraftBar(email)
				} else {
					@MailViewReplyBar(email)
				}
			</div>
		}
	</div>
}

// MailViewThreadContent shows a thread as a stack of message sheets, each as wide
// as a single message's sheet. The toolbar, subject and thread-wide controls stay
// in their own sheet on top while the messages scroll beneath it.
templ MailViewThreadContent(email *models.Email, thread []models.ThreadItem) {
	<div class="mail-view-thread-frame flex flex-col h-full">
		<div class="mail-view-thread-toolbar surface-paper rounded-md shrink-0">
			@MailViewHeader(email, thread)
			<div class="h-px bg-gradient-to-r from-transparent via-amber-900/10 to-transparent"></div>
			<div class="mail-view-content mx-auto px-8 pt-4 pb-3">
				<div class="mail-view-subject-row flex items-start justify-between gap-4 mb-1">
					<h1 class="text-xl font-bold tracking-tight text-ink min-w-0" style="font-family: var(--font-serif)">{ email.Subject }</h1>
					@MailViewMobileLabels(email)
				</div>
				<div class="flex items-center gap-2">
					@icon.MessagesSquare(icon.Props{Class: "size-3.5 text-muted-foreground"})
					<span class="text-xs font-medium text-muted-foreground" data-thread-count>{ fmt.Sprintf("%d messages in this thread", len(thread)) }</span>
					<span class="text-xs text-ink/20">|</span>
					<button type="button" data-thread-expand-all class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-ink transition-colors cursor-pointer">
						@icon.ChevronsUpDown(icon.Props{Class: "size-3.5"})
						<span data-thread-expand-all-label>Expand all</span>
					</button>
				</div>
			</div>
		</div>
		<div data-thread-list class="mail-view-thread-scroll flex-1 min-h-0 overflow-y-auto flex flex-col gap-2">
			for _, item := range thread {
				<div class="shrink-0" data-thread-slot>
					<article class="mail-thread-card surface-paper rounded-md" data-thread-card={ item.ID }>
						<div class="mail-view-content mx-auto px-8 py-6">
							@MailViewThreadItemSender(email, &item)
							@MailViewThreadItemMiniHeader(&item)
							if len(item.Attachments) > 0 {
								@MailViewThreadItemAttachments(&item)
							}
							<details open?={ item.ID == email.ID } data-thread-details class="mt-4 group">
								<summary class="flex items-center gap-3 cursor-pointer list-none marker:hidden text-xs text-muted-foreground transition-colors select-none">
									<span class="flex items-center gap-1.5 hover:text-ink transition-colors">
										@icon.ChevronsDown(icon.Props{Class: "size-3.5 transition-transform group-open:rotate-180"})
										<span class="group-open:hidden">Show email</span>
										<span class="hidden group-open:inline">Hide email</span>
									</span>
									<span class="group-open:hidden">
										<span class="text-ink/20">|</span>
										<button type="button" data-thread-show-exclusive class="ml-1 text-muted-foreground hover:text-ink transition-colors cursor-pointer">Show and hide others</button>
									</span>
									<span class="hidden group-open:inline">
										<span class="text-ink/20">|</span>
										<button type="button" data-thread-hide-others class="ml-1 text-muted-foreground hover:text-ink transition-colors cursor-pointer">Hide all others</button>
									</span>
								</summary>
								<div class="thread-details-content mt-3">
									@MailViewBodyByID(item.ID)
								</div>
							</details>
						</div>
					</article>
				</div>
			}
		</div>
		<div id={"mail-calendar-footer-"+email.ID} data-mail-calendar-footer class="surface-paper rounded-md max-h-[35dvh] shrink-0 overflow-y-auto empty:hidden mt-2" hx-get={"/api/mail/"+email.ID+"/calendar"} hx-trigger="load" hx-swap="innerHTML" hx-sync="this:replace"></div>
	</div>
}

templ MailViewThreadItemSender(email *models.Email, item *models.ThreadItem) {
	<div class="mail-view-thread-sender flex items-start gap-4" data-thread-selected?={ item.ID == email.ID }>
		@MailViewAvatar(item.From, item.ID, "mail-view-avatar size-11 rounded-full text-sm font-bold shrink-0 shadow-[0_2px_6px_rgba(0,0,0,0.2)]", contactAvatarThreadFallback(item.ID == email.ID))
		<div class="flex-1 min-w-0">
			<div class="flex items-center gap-2 flex-wrap">
				<span class="font-semibold text-ink">{ item.From.Name }</span>
				<span class="mail-view-address text-xs text-muted-foreground">&lt;{ item.From.Email }&gt;</span>
				if item.FolderName != "" {
					<span class="text-[10px] font-medium text-muted-foreground bg-ink/[0.04] px-1.5 py-0.5 rounded shrink-0">{ item.FolderName }</span>
				}
				for _, label := range item.Labels {
					<span class={ "text-[10px] px-1.5 py-0.5 rounded font-medium shrink-0", label.Color }>{ label.Name }</span>
				}
				if item.ID == email.ID {
					<span class="mail-view-current-marker text-[10px] font-medium text-amber-700 bg-amber-100 px-1.5 py-0.5 rounded shrink-0">Current</span>
				}
			</div>
			<div class="text-xs text-muted-foreground mt-0.5">
				if len(item.To) > 0 {
					to { contactDisplay(item.To[0]) }
					if len(item.To) > 1 {
						{ fmt.Sprintf(" and %d more", len(item.To)-1) }
					}
				}
				if len(item.CC) > 0 {
					, cc { contactDisplay(item.CC[0]) }
					if len(item.CC) > 1 {
						{ fmt.Sprintf(" and %d more", len(item.CC)-1) }
					}
				}
			</div>
			<div class="text-xs text-muted-foreground mt-0.5">{ item.DateFull }</div>
		</div>
		@popover.Root() {
			@popover.Trigger() {
				<button type="button" class="shrink-0 size-7 rounded flex items-center justify-center text-icon hover:text-ink hover:bg-ink/5 transition-colors mt-0.5">
					@icon.EllipsisVertical(icon.Props{Class: "size-3.5"})
				</button>
			}
			@popover.Content(popover.ContentProps{
				Placement: popover.PlacementBottomEnd,
				Offset:    8,
				Class:     "w-80 p-0",
			}) {
				<div class="p-4 space-y-3">
					<div class="flex items-start gap-3">
						@ContactAvatar(item.From, "size-10 rounded-full text-xs font-bold shrink-0 shadow-[0_2px_6px_rgba(0,0,0,0.2)]", "bg-gradient-to-b from-amber-700/70 to-amber-900/70 text-amber-100")
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2">
								<span class="font-semibold text-sm text-ink truncate">{ item.From.Name }</span>
								@copybutton.CopyButton(copybutton.Props{
									TargetID: "detail-from-email-" + item.ID,
									Class:    "h-5 w-5",
								})
							</div>
							<p id={ "detail-from-email-" + item.ID } class="text-xs text-muted-foreground truncate">{ item.From.Email }</p>
						</div>
					</div>
					if len(item.To) > 0 {
						<div>
							<span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider">To</span>
							<div class="mt-1 space-y-0.5">
								for _, c := range item.To {
									<div class="flex items-center gap-2">
										<span class="text-sm text-ink truncate">{ contactDisplay(c) }</span>
										<span class="text-xs text-muted-foreground truncate">&lt;{ c.Email }&gt;</span>
									</div>
								}
							</div>
						</div>
					}
					if len(item.CC) > 0 {
						<div>
							<span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider">Cc</span>
							<div class="mt-1 space-y-0.5">
								for _, c := range item.CC {
									<div class="flex items-center gap-2">
										<span class="text-sm text-ink truncate">{ contactDisplay(c) }</span>
										<span class="text-xs text-muted-foreground truncate">&lt;{ c.Email }&gt;</span>
									</div>
								}
							</div>
						</div>
					}
					if item.DateFull != "" {
						<div class="pt-2 border-t border-ink/6">
							<div class="flex items-center gap-2 text-xs text-muted-foreground">
								@icon.Clock(icon.Props{Class: "size-3.5 shrink-0"})
								<span>{ item.DateFull }</span>
							</div>
						</div>
					}
				</div>
			}
		}
	</div>
}

templ MailViewThreadItemAttachments(item *models.ThreadItem) {
	<div class="mt-5 space-y-2">
		for _, att := range item.Attachments {
			if shouldShowAttachment(att) {
				<div class="mail-view-attachment flex items-center gap-3 px-4 py-2.5 rounded-lg border border-ink/8 shadow-[0_1px_3px_rgba(0,0,0,0.04)]">
					<div class="flex items-center justify-center size-9 rounded-md bg-ink/[0.03] shadow-[0_1px_2px_rgba(0,0,0,0.06)_inset]">
						@icon.File(icon.Props{Class: "size-4 text-muted-foreground"})
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-sm font-medium text-ink truncate">{ att.Filename }</p>
						<p class="text-[11px] text-muted-foreground">{ humanize.Bytes(uint64(att.SizeBytes)) }</p>
					</div>
					<a href={ fmt.Sprintf("/api/attachments/%d/download", att.ID) } download>
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Class:   "shrink-0 border-ink/10 text-muted-foreground hover:text-ink",
						}) {
							<span class="flex items-center gap-1.5">
								@icon.Download(icon.Props{Class: "size-3.5"})
								Download
							</span>
						}
					</a>
				</div>
			}
		}
	</div>
}

templ MailViewThreadItemMiniHeader(item *models.ThreadItem) {
	<div class="mail-view-message-actions flex items-center gap-0.5 mt-2 -ml-1 max-lg:-mr-1 max-lg:ml-0 max-lg:justify-end">
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      mailDeleteActionClass("h-7 w-7", "text-icon hover:text-ink hover:bg-ink/5", mailThreadItemIsTrash(item)),
					Attributes: templ.Attributes{"data-on-click": onAction("deleteMessage", item.ID)},
				}) {
					@icon.Trash2(icon.Props{Class: "size-3.5"})
				}
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				if mailThreadItemIsTrash(item) {
					Permanently delete
				} else {
					Delete
				}
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "h-7 w-7",
					Attributes: templ.Attributes{"data-on-click": onAction("toggleStar", item.ID), "data-star-email": item.ID},
				}) {
					if item.IsStarred {
						@icon.Star(icon.Props{Class: "size-3.5 text-amber-500 fill-amber-500 drop-shadow-[0_1px_1px_rgba(180,120,0,0.3)]"})
					} else {
						@icon.Star(icon.Props{Class: "size-3.5 text-icon"})
					}
				}
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				Star
			}
		}
		@tooltip.Tooltip() {
			@tooltip.Trigger() {
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "h-7 w-7 text-icon hover:text-ink hover:bg-ink/5",
					Attributes: templ.Attributes{"data-on-click": onAction("toggleRead", item.ID), "data-read-email": item.ID, "data-is-read": fmt.Sprintf("%t", item.IsRead)},
				}) {
					if item.IsRead {
						@icon.Mail(icon.Props{Class: "size-3.5"})
					} else {
						@icon.MailOpen(icon.Props{Class: "size-3.5"})
					}
				}
			}
			@tooltip.Content(tooltip.ContentProps{
				Position:  tooltip.PositionBottom,
				ShowArrow: true,
			}) {
				if item.IsRead {
					Mark as unread
				} else {
					Mark as read
				}
			}
		}
		<div class="flex items-center gap-0.5 lg:hidden">
			@EmailBodyStyleCycleButton(item.ID)
			@EmailTranslateIconButton(item.ID)
		</div>
		@MailViewThreadItemQuickReply(item)
	</div>
}

// Reply and forward stay reachable while a thread message is collapsed.
templ MailViewThreadItemQuickReply(item *models.ThreadItem) {
	if item.IsDraft {
		// A draft in a thread is picked up again here, like a draft opened on
		// its own.
		<div class="mail-view-thread-quick-reply ml-auto flex items-center gap-1 max-lg:ml-0" data-thread-draft-actions>
			@mailViewThreadDraftButton(onAction("continueEditingDraft", item.ID), "Continue editing", "hover:text-ink hover:border-ink/20") {
				@icon.Pencil(icon.Props{Class: "size-3.5"})
			}
			@mailViewThreadDraftButton(onAction("discardReadPaneDraft", item.ID), "Discard draft", "hover:text-destructive hover:border-destructive/20") {
				@icon.Trash2(icon.Props{Class: "size-3.5"})
			}
		</div>
	} else {
		@mailViewThreadReplyButtons(item)
	}
}

templ mailViewThreadReplyButtons(item *models.ThreadItem) {
	<div class="mail-view-thread-quick-reply ml-auto flex items-center gap-1 max-lg:ml-0" data-thread-reply-data data-message-id={ item.InternetMessageID } data-account-id={ item.AccountID }>
		@mailViewThreadQuickReplyButton("reply", "Reply") {
			@icon.Reply(icon.Props{Class: "size-3.5"})
		}
		@mailViewThreadQuickReplyButton("reply-all", "Reply all") {
			@icon.ReplyAll(icon.Props{Class: "size-3.5"})
		}
		@mailViewThreadQuickReplyButton("forward", "Forward") {
			@icon.Forward(icon.Props{Class: "size-3.5"})
		}
	</div>
}

templ mailViewThreadDraftButton(action string, label string, hover string) {
	@button.Button(button.Props{
		Variant:    button.VariantOutline,
		Class:      "h-7 px-2 max-lg:w-7 max-lg:px-0 border-ink/10 text-muted-foreground " + hover,
		Attributes: templ.Attributes{"data-on-click": action, "aria-label": label, "title": label},
	}) {
		<span class="flex items-center gap-1.5 text-xs">
			{ children... }
			<span class="mail-view-thread-quick-reply-label max-lg:hidden">{ label }</span>
		</span>
	}
}

templ mailViewThreadQuickReplyButton(mode string, label string) {
	@button.Button(button.Props{
		Variant:    button.VariantOutline,
		Class:      "h-7 px-2 max-lg:w-7 max-lg:px-0 border-ink/10 text-muted-foreground hover:text-ink hover:border-ink/20",
		Attributes: templ.Attributes{"data-on-click": onAction("handleReply", actionElement, mode), "aria-label": label, "title": label},
	}) {
		<span class="flex items-center gap-1.5 text-xs">
			{ children... }
			<span class="mail-view-thread-quick-reply-label max-lg:hidden">{ label }</span>
		</span>
	}
}

templ EmailBodyStyleTabs(emailID string, global bool, listHeight string, triggerHeight string) {
	@tabs.Tabs(tabs.Props{Class: "gap-0 shrink-0", Attributes: templ.Attributes{"data-email-body-style-toggle": emailID, "data-force-email-scheme": emailID, "aria-label": "Change email body style"}}) {
		@tabs.List(tabs.ListProps{Class: "bg-card p-0.5 " + listHeight}) {
			@tabs.Trigger(tabs.TriggerProps{Class: "gap-1 px-1.5 py-0 text-[11px] " + triggerHeight, Value: "dark", IsActive: true, Attributes: templ.Attributes{"data-email-body-mode-button": "dark", "data-email-body-mode-global": global, "aria-label": "Use dark email body"}}) {
				@icon.Moon(icon.Props{Class: "size-3"})
				Dark
			}
			@tabs.Trigger(tabs.TriggerProps{Class: "gap-1 px-1.5 py-0 text-[11px] " + triggerHeight, Value: "light", Attributes: templ.Attributes{"data-email-body-mode-button": "light", "data-email-body-mode-global": global, "aria-label": "Use light email body"}}) {
				@icon.Sun(icon.Props{Class: "size-3"})
				Light
			}
			@tabs.Trigger(tabs.TriggerProps{Class: "gap-1 px-1.5 py-0 text-[11px] " + triggerHeight, Value: "original", Attributes: templ.Attributes{"data-email-body-mode-button": "original", "data-email-body-mode-global": global, "aria-label": "View original email style"}}) {
				@icon.FileText(icon.Props{Class: "size-3"})
				Original
			}
		}
		@tabs.Content(tabs.ContentProps{Value: "dark", IsActive: true, Class: "sr-only"}) {}
		@tabs.Content(tabs.ContentProps{Value: "light", Class: "sr-only"}) {}
		@tabs.Content(tabs.ContentProps{Value: "original", Class: "sr-only"}) {}
	}
}

// EmailBodyStyleCycleButton steps the message body through dark, light and original. Small
// screens show it beside the message's other small actions.
templ EmailBodyStyleCycleButton(emailID string) {
	@button.Button(button.Props{
		Variant: button.VariantGhost,
		Size:    button.SizeIcon,
		Class:   "email-body-mode-cycle h-7 w-7 text-icon hover:text-ink hover:bg-ink/5",
		Attributes: templ.Attributes{
			"data-on-click": onAction("toggleEmailBodySchemeById", emailID),
			"data-email-body-mode-cycle": emailID,
			"data-email-body-mode":       "dark",
			"aria-label":                 "Change email body style",
		},
	}) {
		<span class="contents" data-email-body-mode-icon="dark">
			@icon.Moon(icon.Props{Class: "size-3.5"})
		</span>
		<span class="contents" data-email-body-mode-icon="light">
			@icon.Sun(icon.Props{Class: "size-3.5"})
		</span>
		<span class="contents" data-email-body-mode-icon="original">
			@icon.FileText(icon.Props{Class: "size-3.5"})
		</span>
	}
}

// EmailTranslateIconButton is the small-screen version of the translation control: an icon
// that translates the message or shows the original again, and a menu of languages. It
// shares the desktop control's behavior and its colors while a translation is shown.
templ EmailTranslateIconButton(emailID string) {
	<div data-translate-email-icon-shell={ emailID } data-translated="false" class="inline-flex h-7 overflow-hidden rounded-md text-icon transition-colors data-[translated=true]:bg-copper/10 data-[translated=true]:text-copper">
		<button type="button" data-translate-email-icon={ emailID } data-translated="false" aria-pressed="false" aria-label="Translate" class="inline-flex h-full items-center pl-1.5 pr-0.5 transition-colors hover:text-ink">
			@icon.Languages(icon.Props{Class: "size-3.5"})
		</button>
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				<button type="button" class="email-translation-language-trigger inline-flex h-full w-5 items-center justify-center pr-0.5 transition-colors hover:text-ink" aria-label="Choose translation language">
					@icon.ChevronDown(icon.Props{Class: "size-3"})
				</button>
			}
			@dropdown.Content(dropdown.ContentProps{
				Placement: dropdown.PlacementBottomEnd,
				Class:     "mobile-sheet email-translation-language-menu w-40 normal-case tracking-normal",
			}) {
				@dropdown.Label(dropdown.LabelProps{Class: "text-xs text-muted-foreground"}) { Translate to }
				for _, language := range translationLanguageOptions() {
					@dropdown.Item(dropdown.ItemProps{
						Class: "email-translation-language-item text-xs group relative justify-start pr-8 font-light outline-none transition-colors duration-150",
						Attributes: templ.Attributes{
							"data-translate-email-language":     emailID,
							"data-translation-language":          language.Value,
							"data-translation-language-selected": "false",
						},
					}) {
						<span>{ language.Label }</span>
					}
				}
			}
		}
	</div>
}

templ MailViewHeader(email *models.Email, thread []models.ThreadItem) {
	<div class="mail-view-toolbar flex items-center justify-between px-6 py-2.5">
		<div class="mail-view-actions flex items-center gap-1 min-w-0">
			<button type="button" class="mobile-back-button h-9 w-9 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-ink/5" data-on-click='["closeMobileMailView"]' aria-label="Back to list">
				@icon.ArrowLeft(icon.Props{Class: "size-5"})
			</button>
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIcon,
						Class:      mailDeleteActionClass("h-8 w-8", "text-icon hover:text-ink hover:bg-ink/5", mailEmailIsTrash(email)),
						Attributes: templ.Attributes{"data-on-click": threadAwareAction("deleteMessage", "deleteThread", email)},
					}) {
						@icon.Trash2(icon.Props{Class: "size-4"})
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					if mailEmailIsTrash(email) {
						{ threadAwareLabel("Permanently delete", "Permanently delete thread", email) }
					} else {
						{ threadAwareLabel("Delete", "Delete thread", email) }
					}
				}
				}
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					if mailEmailIsArchived(email) {
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIcon,
							Class:      "h-8 w-8 text-icon hover:text-ink hover:bg-ink/5",
							Attributes: templ.Attributes{"data-on-click": onAction("unarchiveThread", email.ID)},
						}) {
							@icon.ArchiveRestore(icon.Props{Class: "size-4"})
						}
					} else {
						@button.Button(button.Props{
							Variant:    button.VariantGhost,
							Size:       button.SizeIcon,
							Class:      "h-8 w-8 text-icon hover:text-ink hover:bg-ink/5",
							Attributes: templ.Attributes{"data-on-click": onAction("archiveThread", email.ID)},
						}) {
							@icon.Archive(icon.Props{Class: "size-4"})
						}
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					if mailEmailIsArchived(email) {
						{ threadAwareLabel("Move to Inbox", "Move thread to Inbox", email) }
					} else {
						{ threadAwareLabel("Archive", "Archive thread", email) }
					}
				}
			}
				@tooltip.Tooltip() {
					@tooltip.Trigger() {
						if mailEmailIsSpam(email) {
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeIcon,
								Class:      "h-8 w-8 border border-amber-500/35 bg-amber-500/12 text-amber-700 shadow-[0_1px_2px_rgba(0,0,0,0.04)] hover:bg-amber-500/20 hover:text-amber-800 dark:border-amber-300/20 dark:bg-amber-300/10 dark:text-amber-300 dark:hover:text-amber-200",
								Attributes: templ.Attributes{"data-on-click": threadAwareAction("markNotSpam", "markThreadNotSpam", email), "data-mail-action": "spam"},
							}) {
								@icon.ShieldCheck(icon.Props{Class: "size-4"})
							}
						} else {
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeIcon,
								Class:      "h-8 w-8 text-icon hover:text-ink hover:bg-ink/5",
								Attributes: templ.Attributes{"data-on-click": threadAwareAction("markSpam", "markThreadSpam", email), "data-mail-action": "spam"},
							}) {
								@icon.ShieldAlert(icon.Props{Class: "size-4"})
							}
						}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					if mailEmailIsSpam(email) {
						{ threadAwareLabel("Not spam", "Mark thread as not spam", email) }
					} else {
						{ threadAwareLabel("Report spam", "Report thread as spam", email) }
					}
				}
			}
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIcon,
						Class:      "h-8 w-8",
						Attributes: mailViewStarAttributes(email),
					}) {
						if mailViewStarred(email, thread) {
							@icon.Star(icon.Props{Class: "size-4 text-amber-500 fill-amber-500 drop-shadow-[0_1px_1px_rgba(180,120,0,0.3)]"})
						} else {
							@icon.Star(icon.Props{Class: "size-4 text-icon"})
						}
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					{ threadAwareLabel("Star", "Star thread", email) }
				}
			}
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					@button.Button(button.Props{
						Variant:    button.VariantGhost,
						Size:       button.SizeIcon,
						Class:      "h-8 w-8 text-icon hover:text-ink hover:bg-ink/5",
						Attributes: mailViewReadAttributes(email, thread),
					}) {
						if mailViewRead(email, thread) {
							@icon.Mail(icon.Props{Class: "size-4"})
						} else {
							@icon.MailOpen(icon.Props{Class: "size-4"})
						}
					}
				}
				@tooltip.Content(tooltip.ContentProps{
					Position:  tooltip.PositionBottom,
					ShowArrow: true,
				}) {
					if mailViewRead(email, thread) {
						{ threadAwareLabel("Mark as unread", "Mark thread as unread", email) }
					} else {
						{ threadAwareLabel("Mark as read", "Mark thread as read", email) }
					}
				}
			}
		</div>
		<div class="mail-view-meta flex items-center gap-2">
			if len(email.Labels) > 0 {
				for _, label := range email.Labels {
					<span class={ "inline-flex items-center gap-1 text-[11px] pl-2 pr-1 py-0.5 rounded font-medium shadow-[0_1px_2px_rgba(0,0,0,0.06)]", label.Color }>
						{ label.Name }
						<button
							type="button"
							class="inline-flex size-4 items-center justify-center rounded text-current/60 transition-colors hover:bg-background/60 hover:text-current focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							aria-label={ "Remove label " + label.Name }
							{ templ.Attributes{"data-on-click": onAction("removeLabelMessage", email.ID, label.Name, email.ThreadCount > 1)}... }
						>
							@icon.X(icon.Props{Class: "size-3"})
						</button>
					</span>
				}
			}
			<span class="mail-view-date text-xs text-muted-foreground tabular-nums">{ email.DateFull }</span>
			@dropdown.Dropdown() {
				@dropdown.Trigger() {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeIcon,
						Class:   "h-8 w-8 text-icon hover:text-ink",
					}) {
						@icon.EllipsisVertical(icon.Props{Class: "size-4"})
					}
				}
				@dropdown.Content(dropdown.ContentProps{Class: "mobile-sheet"}) {
					if email.IsDraft {
						@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("continueEditingDraft", email.ID)}}) {
							<span class="flex items-center gap-2">
								@icon.Pencil(icon.Props{Class: "size-4"})
								Continue editing
							</span>
						}
						@dropdown.Item(dropdown.ItemProps{Class: menuDestructiveClass, Attributes: templ.Attributes{"data-on-click": onAction("discardReadPaneDraft", email.ID)}}) {
							<span class="flex items-center gap-2 text-destructive">
								@icon.Trash2(icon.Props{Class: "size-4"})
								Discard draft
							</span>
						}
						@dropdown.Separator()
					} else {
						@dropdown.Item(dropdown.ItemProps{Class: "max-lg:hidden"}) {
							<span class="flex items-center gap-2">
								@icon.Reply(icon.Props{Class: "size-4"})
								Reply
							</span>
						}
						@dropdown.Item(dropdown.ItemProps{Class: "max-lg:hidden"}) {
							<span class="flex items-center gap-2">
								@icon.Forward(icon.Props{Class: "size-4"})
								Forward
							</span>
						}
						@dropdown.Separator(dropdown.SeparatorProps{Class: "max-lg:hidden"})
					}
					@MailViewMobileMenuItems(email)
					@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("openMessageLabels", email.ID, email.ThreadCount > 1)}}) {
						<span class="flex items-center gap-2">
							@icon.Tag(icon.Props{Class: "size-4"})
							Labels…
						</span>
					}
					@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("openMoveDialog", email.ID, email.ThreadCount > 1)}}) {
						<span class="flex items-center gap-2">
							@icon.FolderInput(icon.Props{Class: "size-4"})
							Move to...
						</span>
					}
					@dropdown.Separator()
					@dropdown.Item(dropdown.ItemProps{Href: "/api/messages/" + email.ID + "/source?download=1"}) {
						<span class="flex items-center gap-2">
							@icon.Download(icon.Props{Class: "size-4"})
							Download
						</span>
					}
					@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": onAction("openMessageSource", email.ID)}}) {
						<span class="flex items-center gap-2">
							@icon.FileCode(icon.Props{Class: "size-4"})
							View source
						</span>
					}
					@dropdown.Item() {
						<span class="flex items-center gap-2">
							@icon.Printer(icon.Props{Class: "size-4"})
							Print
						</span>
					}
					@dropdown.Item() {
						<span class="flex items-center gap-2" data-refetch-email={ email.ID }>
							@icon.RefreshCw(icon.Props{Class: "size-4"})
							Re-fetch
						</span>
					}
				}
			}
		</div>
	</div>
}

templ MailViewSender(email *models.Email) {
	<div class="mail-view-sender flex items-start gap-4">
		@MailViewAvatar(email.From, email.ID, "mail-view-avatar size-11 rounded-full text-sm font-bold shrink-0 shadow-[0_2px_6px_rgba(0,0,0,0.2)]", "bg-gradient-to-b from-amber-700/70 to-amber-900/70 text-amber-100")
		<div class="flex-1 min-w-0">
			<div class="flex items-center gap-2 flex-wrap">
				<span class="font-semibold text-ink">{ email.From.Name }</span>
				<span class="mail-view-address text-xs text-muted-foreground">&lt;{ email.From.Email }&gt;</span>
			</div>
			<div class="text-xs text-muted-foreground mt-0.5">
				if len(email.To) > 0 {
					to { contactDisplay(email.To[0]) }
					if len(email.To) > 1 {
						{ fmt.Sprintf(" and %d more", len(email.To)-1) }
					}
				}
				if len(email.CC) > 0 {
					, cc { contactDisplay(email.CC[0]) }
					if len(email.CC) > 1 {
						{ fmt.Sprintf(" and %d more", len(email.CC)-1) }
					}
				}
			</div>
			<div class="mail-view-mobile-date text-xs text-muted-foreground mt-0.5 tabular-nums">{ email.DateFull }</div>
		</div>
		@popover.Root() {
			@popover.Trigger() {
				<button type="button" class="shrink-0 size-7 rounded flex items-center justify-center text-icon hover:text-ink hover:bg-ink/5 transition-colors mt-0.5">
					@icon.EllipsisVertical(icon.Props{Class: "size-3.5"})
				</button>
			}
			@popover.Content(popover.ContentProps{
				Placement: popover.PlacementBottomEnd,
				Offset:    8,
				Class:     "w-80 p-0",
			}) {
				<div class="p-4 space-y-3">
					<div class="flex items-start gap-3">
						@ContactAvatar(email.From, "size-10 rounded-full text-xs font-bold shrink-0 shadow-[0_2px_6px_rgba(0,0,0,0.2)]", "bg-gradient-to-b from-amber-700/70 to-amber-900/70 text-amber-100")
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2">
								<span class="font-semibold text-sm text-ink truncate">{ email.From.Name }</span>
								@copybutton.CopyButton(copybutton.Props{
									TargetID: "detail-from-email",
									Class:    "h-5 w-5",
								})
							</div>
							<p id="detail-from-email" class="text-xs text-muted-foreground truncate">{ email.From.Email }</p>
						</div>
					</div>
					if len(email.To) > 0 {
						<div>
							<span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider">To</span>
							<div class="mt-1 space-y-0.5">
								for _, c := range email.To {
									<div class="flex items-center gap-2">
										<span class="text-sm text-ink truncate">{ contactDisplay(c) }</span>
										<span class="text-xs text-muted-foreground truncate">&lt;{ c.Email }&gt;</span>
									</div>
								}
							</div>
						</div>
					}
					if len(email.CC) > 0 {
						<div>
							<span class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider">Cc</span>
							<div class="mt-1 space-y-0.5">
								for _, c := range email.CC {
									<div class="flex items-center gap-2">
										<span class="text-sm text-ink truncate">{ contactDisplay(c) }</span>
										<span class="text-xs text-muted-foreground truncate">&lt;{ c.Email }&gt;</span>
									</div>
								}
							</div>
						</div>
					}
					if email.DateFull != "" {
						<div class="pt-2 border-t border-ink/6">
							<div class="flex items-center gap-2 text-xs text-muted-foreground">
								@icon.Clock(icon.Props{Class: "size-3.5 shrink-0"})
								<span>{ email.DateFull }</span>
							</div>
						</div>
					}
				</div>
			}
		}
	</div>
	<div class="mail-view-subject-row flex items-start justify-between gap-4 mt-5">
		<h1 class="text-xl font-bold tracking-tight text-ink min-w-0" style="font-family: var(--font-serif)">{ email.Subject }</h1>
@MailViewMobileLabels(email)
	</div>
	@MailViewAttachments(email)
}

templ MailViewAttachments(email *models.Email) {
	if len(email.Attachments) > 0 {
		<div class="mt-5 space-y-2">
			for _, att := range email.Attachments {
				if shouldShowAttachment(att) {
					<div class="mail-view-attachment flex items-center gap-3 px-4 py-2.5 rounded-lg border border-ink/8 shadow-[0_1px_3px_rgba(0,0,0,0.04)]">
						<div class="flex items-center justify-center size-9 rounded-md bg-ink/[0.03] shadow-[0_1px_2px_rgba(0,0,0,0.06)_inset]">
							@icon.File(icon.Props{Class: "size-4 text-muted-foreground"})
						</div>
						<div class="flex-1 min-w-0">
							<p class="text-sm font-medium text-ink truncate">{ att.Filename }</p>
							<p class="text-[11px] text-muted-foreground">{ humanize.Bytes(uint64(att.SizeBytes)) }</p>
						</div>
						<a href={ fmt.Sprintf("/api/attachments/%d/download", att.ID) } download>
							@button.Button(button.Props{
								Variant: button.VariantOutline,
								Size:    button.SizeSm,
								Class:   "shrink-0 border-ink/10 text-muted-foreground hover:text-ink",
							}) {
								<span class="flex items-center gap-1.5">
									@icon.Download(icon.Props{Class: "size-3.5"})
									Download
								</span>
							}
						</a>
					</div>
				}
			}
		</div>
	}
}

templ MailViewBody(email *models.Email) {
	@MailViewBodyByID(email.ID)
}

templ MailViewBodyByID(emailID string) {
	<div data-remote-content-banner={ emailID } class="hidden mb-3 w-full px-3 py-2.5 rounded-lg border border-amber-600/20 bg-amber-50/50 dark:bg-amber-900/10 flex items-center gap-3">
			<div class="size-7 rounded-md bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center shrink-0">
				@icon.ImageOff(icon.Props{Class: "size-3.5 text-amber-600 dark:text-amber-400"})
			</div>
			<span class="min-w-0 flex-1 text-xs text-muted-foreground">Remote content is blocked to protect your privacy</span>
			<div class="flex shrink-0 items-center">
				<button type="button" data-load-remote={ emailID } class="text-xs font-medium text-amber-700 dark:text-amber-400 hover:text-amber-800 dark:hover:text-amber-300 transition-colors cursor-pointer whitespace-nowrap">
					Show content
				</button>
				@dropdown.Dropdown() {
					@dropdown.Trigger() {
						<button type="button" class="ml-0.5 size-5 rounded flex items-center justify-center text-amber-600 dark:text-amber-400 hover:bg-amber-100 dark:hover:bg-amber-900/30 transition-colors cursor-pointer">
							@icon.ChevronDown(icon.Props{Class: "size-3"})
						</button>
					}
					@dropdown.Content(dropdown.ContentProps{
						Placement: dropdown.PlacementBottomEnd,
					}) {
						@dropdown.Item(dropdown.ItemProps{
							Attributes: templ.Attributes{"data-allow-remote": emailID, "data-allow-mode": "email"},
						}) {
							<span class="flex items-center gap-2">
								@icon.Mail(icon.Props{Class: "size-3.5"})
								<span class="text-xs">Always for this email</span>
							</span>
						}
						@dropdown.Item(dropdown.ItemProps{
							Attributes: templ.Attributes{"data-allow-remote": emailID, "data-allow-mode": "sender"},
						}) {
							<span class="flex items-center gap-2">
								@icon.User(icon.Props{Class: "size-3.5"})
								<span class="text-xs">Always for this sender</span>
							</span>
						}
					}
				}
			</div>
	</div>
	<div data-email-translation-shell={ emailID } class="mb-3">
		<div class="flex flex-wrap items-center justify-between gap-2">
			@EmailBodyStyleTabs(emailID, false, "h-7", "h-6")
			<div data-email-translation-control>
				<div data-email-translation-button={ emailID } data-translated="false" class="inline-flex h-7 overflow-hidden rounded-md border border-ink/10 bg-background text-xs font-medium text-muted-foreground shadow-xs transition-colors hover:border-ink/20 hover:bg-accent hover:text-ink dark:border-input dark:bg-input/30 dark:hover:bg-input/50 data-[translated=true]:border-copper/40 data-[translated=true]:bg-copper/10 data-[translated=true]:text-copper data-[translated=true]:hover:border-copper/50 data-[translated=true]:hover:bg-copper/15">
						<button type="button" data-translate-email={ emailID } data-translated="false" aria-pressed="false" class="inline-flex h-full items-center gap-1 px-2 text-[11px] transition-colors data-[translated=true]:text-copper">
							@icon.Languages(icon.Props{Class: "size-3"})
							<span data-translate-email-label={ emailID }>Translate</span>
						</button>
						@dropdown.Dropdown() {
							@dropdown.Trigger() {
								<button type="button" class="email-translation-language-trigger inline-flex h-full w-6 items-center justify-center border-l border-ink/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 ring-offset-background" aria-label="Choose translation language">
									@icon.ChevronDown(icon.Props{Class: "size-3"})
								</button>
							}
							@dropdown.Content(dropdown.ContentProps{
								Placement: dropdown.PlacementBottomEnd,
								Class:     "email-translation-language-menu w-40 normal-case tracking-normal",
							}) {
								@dropdown.Label(dropdown.LabelProps{Class: "text-xs text-muted-foreground"}) { Translate to }
								for _, language := range translationLanguageOptions() {
									@dropdown.Item(dropdown.ItemProps{
										Class: "email-translation-language-item text-xs group relative justify-start pr-8 font-light outline-none transition-colors duration-150",
										Attributes: templ.Attributes{
											"data-translate-email-language":     emailID,
											"data-translation-language":          language.Value,
											"data-translation-language-selected": "false",
										},
									}) {
										<span>{ language.Label }</span>
									}
								}
							}
						}
				</div>
			</div>
		</div>
	</div>
	<div data-email-body-loading={ emailID } class="space-y-3 py-2" aria-label="Loading email body">
		<div class="h-4 w-full rounded bg-ink/5 animate-pulse"></div>
		<div class="h-4 w-11/12 rounded bg-ink/5 animate-pulse"></div>
		<div class="h-4 w-4/5 rounded bg-ink/5 animate-pulse"></div>
		<div class="h-4 w-2/3 rounded bg-ink/5 animate-pulse"></div>
	</div>
	<iframe id={ "email-body-frame-" + emailID }
		sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox"
		class="w-full border-0 min-h-[100px] overflow-hidden opacity-0 transition-opacity duration-150"
		data-email-body-frame
		data-email-id={ emailID }>
	</iframe>
}

templ MailViewReplyBar(email *models.Email) {
	<div class="px-6 py-3 border-t border-ink/6" id="reply-bar" data-message-id={ email.InternetMessageID } data-references={ email.References } data-subject={ email.Subject } data-from-email={ email.From.Email } data-from-name={ email.From.Name } data-account-id={ email.AccountID } data-date={ email.DateFull } data-to={ formatContacts(email.To) } data-cc={ formatContacts(email.CC) } data-body={ email.TextBody }>
		<div class="mail-view-reply-actions flex items-center gap-2">
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "flex-1 h-9 border-ink/10 text-muted-foreground hover:text-ink hover:border-ink/20",
				Attributes: templ.Attributes{"data-on-click": onAction("handleReply", actionElement, "reply")},
			}) {
				<span class="flex items-center gap-2 text-[13px]">
					@icon.Reply(icon.Props{Class: "size-4"})
					Reply
				</span>
			}
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "flex-1 h-9 border-ink/10 text-muted-foreground hover:text-ink hover:border-ink/20",
				Attributes: templ.Attributes{"data-on-click": onAction("handleReply", actionElement, "reply-all")},
			}) {
				<span class="flex items-center gap-2 text-[13px]">
					@icon.ReplyAll(icon.Props{Class: "size-4"})
					Reply All
				</span>
			}
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "flex-1 h-9 border-ink/10 text-muted-foreground hover:text-ink hover:border-ink/20",
				Attributes: templ.Attributes{"data-on-click": onAction("handleReply", actionElement, "forward")},
			}) {
				<span class="flex items-center gap-2 text-[13px]">
					@icon.Forward(icon.Props{Class: "size-4"})
					Forward
				</span>
			}
		</div>
	</div>
}

templ MailViewDraftBar(email *models.Email) {
	<div class="px-6 py-3 border-t border-ink/6" id="reply-bar">
		<div class="mail-view-reply-actions flex items-center gap-2">
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "flex-1 h-9 border-ink/10 text-muted-foreground hover:text-ink hover:border-ink/20",
				Attributes: templ.Attributes{"data-on-click": onAction("continueEditingDraft", email.ID)},
			}) {
				<span class="flex items-center gap-2 text-[13px]">
					@icon.Pencil(icon.Props{Class: "size-4"})
					Continue editing
				</span>
			}
			@button.Button(button.Props{
				Variant:    button.VariantOutline,
				Class:      "flex-1 h-9 border-ink/10 text-muted-foreground hover:text-destructive hover:border-destructive/20",
				Attributes: templ.Attributes{"data-on-click": onAction("discardReadPaneDraft", email.ID)},
			}) {
				<span class="flex items-center gap-2 text-[13px]">
					@icon.Trash2(icon.Props{Class: "size-4"})
					Discard draft
				</span>
			}
		</div>
	</div>
}

templ MailViewEmpty() {
	<div class="flex flex-col items-center justify-center h-full text-center" data-mail-view-empty>
		<div class="space-y-4 animate-fade-in">
			<div class="mail-empty-tile relative size-20 rounded-2xl bg-card flex items-center justify-center mx-auto raised" data-on-click='["wolfEmptyPaneClick", "$this"]'>
				@icon.Mail(icon.Props{Class: "mail-empty-icon size-9 text-muted-foreground opacity-30"})
			</div>
			<div>
				<h3 class="font-semibold mb-1">Select an email</h3>
				<p class="text-sm text-muted-foreground">Choose an email from the list to read it</p>
			</div>
		</div>
	</div>
}

// MailViewMobileMenuItems holds the actions small screens move out of the toolbar and the
// subject row and into the message menu.
templ MailViewMobileMenuItems(email *models.Email) {
	<div class="lg:hidden">
		if mailEmailIsSpam(email) {
			@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": threadAwareAction("markNotSpam", "markThreadNotSpam", email)}}) {
				<span class="flex items-center gap-2">
					@icon.ShieldCheck(icon.Props{Class: "size-4"})
					{ threadAwareLabel("Not spam", "Mark thread as not spam", email) }
				</span>
			}
		} else {
			@dropdown.Item(dropdown.ItemProps{Attributes: templ.Attributes{"data-on-click": threadAwareAction("markSpam", "markThreadSpam", email)}}) {
				<span class="flex items-center gap-2">
					@icon.ShieldAlert(icon.Props{Class: "size-4"})
					{ threadAwareLabel("Report spam", "Report thread as spam", email) }
				</span>
			}
		}
		@dropdown.Separator()
	</div>
}

templ MailViewMobileLabels(email *models.Email) {
	if len(email.Labels) > 0 {
		<div class="mail-view-mobile-labels flex flex-wrap gap-1.5">
			for _, label := range email.Labels {
				<span class={ "text-[11px] px-2 py-0.5 rounded font-medium", label.Color }>{ label.Name }</span>
			}
		</div>
	}
}

// MailMoveDialog lists every account with its folders. Clicking a folder
// selects it; Move does the move. A folder of another account asks first,
// since that copies the email there and deletes it here.
templ MailMoveDialog(email *models.Email, accounts []models.Account) {
	@dialog.Dialog(dialog.Props{ID: "mail-move-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ threadAwareLabel("Move to", "Move thread to", email) }
				}
				<input
					type="search"
					class="h-8 w-full rounded-md border border-input bg-background px-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring"
					placeholder="Search folders"
					aria-label="Search folders"
					autocomplete="off"
					data-mail-move-search
					data-on-input={ onAction("filterMoveFolders", actionElement) }
				/>
			}
			<div class="h-[50vh] max-h-96 overflow-y-auto rounded-md border border-border bg-muted/50 p-1" role="listbox" aria-label="Folders" data-mail-move-list data-mail-move-source-account={ email.AccountID }>
				for _, account := range accounts {
					{{ own := account.ID == email.AccountID }}
					{{ problem := mailMoveAccountProblem(account, own) }}
					<div class="mb-2 last:mb-0" data-mail-move-account>
						<div class="flex items-center gap-2 px-2.5 pt-1 pb-1">
							<div class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(account.Color) }></div>
							<span class="truncate text-xs font-semibold text-foreground">{ account.Email }</span>
							if problem != "" {
								<span class="ml-auto shrink-0 text-[11px] text-muted-foreground">{ problem }</span>
							} else if !own {
								<span class="ml-auto shrink-0 text-[11px] text-muted-foreground">Other account</span>
							}
						</div>
						// A new folder can go in any account the email can move to,
						// at the top or inside a folder. Gmail's labels aren't places
						// to move to, so its own account offers a new label instead.
						if problem == "" && account.Provider != "gmail" {
							@mailMoveNewRow(account)
						} else if own && account.Provider == "gmail" {
							<button
								type="button"
								class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-1.5 text-left text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground"
								data-mail-move-new-row
								data-on-click={ onAction("createMoveLabel", email.ID, email.ThreadCount > 1) }
							>
								<span class="flex size-5 shrink-0 items-center justify-center">
									@icon.Tag(icon.Props{Class: "size-4"})
								</span>
								<span class="flex-1 truncate">New label…</span>
							</button>
						}
						for _, target := range mailMoveTargets(account.Folders) {
							{{ current := target.Folder.ID == email.FolderID }}
							<div class="group flex items-center rounded-md" data-mail-move-row>
								<button
									type="button"
									role="option"
									aria-selected="false"
									disabled?={ problem != "" || current || (!own && !mailMoveTakesOtherAccounts(account, target.Folder)) }
									class="flex min-w-0 flex-1 items-center gap-2.5 rounded-md px-2.5 py-1.5 text-left text-sm enabled:hover:bg-accent enabled:hover:text-accent-foreground aria-selected:bg-primary/10 aria-selected:text-primary disabled:cursor-default disabled:opacity-50"
									style={ mailMoveIndent(target.Depth) }
									data-mail-move-folder={ target.Folder.ID }
									data-mail-move-account={ account.ID }
									data-mail-move-depth={ fmt.Sprintf("%d", target.Depth) }
									data-mail-move-name={ strings.ToLower(target.Folder.Name) }
									data-on-click={ onAction("selectMoveFolder", actionElement) }
								>
									<span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
										@SidebarFolderIcon(target.Folder.Icon)
									</span>
									<span class="flex-1 truncate">{ target.Folder.Name }</span>
									if current {
										<span class="shrink-0 text-[11px] text-muted-foreground">Current folder</span>
									}
								</button>
								if problem == "" && account.Provider != "gmail" {
									<button
										type="button"
										class="ml-0.5 flex size-7 shrink-0 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground focus-visible:opacity-100 sm:opacity-0 sm:group-hover:opacity-100"
										title={ "New folder in " + target.Folder.Name }
										aria-label={ "New folder in " + target.Folder.Name }
										data-mail-move-create-account={ account.ID }
										data-mail-move-create-parent={ target.Folder.ID }
										data-mail-move-create-depth={ fmt.Sprintf("%d", target.Depth+1) }
										data-on-click={ onAction("startMoveFolderCreate", actionElement) }
									>
										@icon.FolderPlus(icon.Props{Class: "size-3.5"})
									</button>
								}
							</div>
						}
					</div>
				}
				<p class="hidden px-2.5 py-6 text-center text-sm text-muted-foreground" data-mail-move-empty>No folders match.</p>
			</div>
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "h-8 px-3 text-xs"}) {
						Cancel
					}
				}
				@button.Button(button.Props{
					Class:      "h-8 px-3 text-xs",
					Disabled:   true,
					Attributes: templ.Attributes{"data-mail-move-confirm": "", "data-on-click": onAction("confirmMoveDialog", email.ID, email.ThreadCount > 1)},
				}) {
					Move
				}
			}
		}
	}
}

// MailLabelsDialog adds and removes labels on one or more emails. Each label
// is checked when all the emails have it and partly checked when some do;
// Apply sends only what was changed. Typing a name that doesn't exist yet
// offers to create it.
// mailMoveNewRow is the Move dialog's row that starts a new folder at the
// top of an account.
templ mailMoveNewRow(account models.Account) {
	<button
		type="button"
		class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-1.5 text-left text-sm text-muted-foreground hover:bg-accent hover:text-accent-foreground"
		aria-label={ "New folder in " + account.Email }
		data-mail-move-new-row
		data-mail-move-create-account={ account.ID }
		data-mail-move-create-parent=""
		data-mail-move-create-depth="0"
		data-on-click={ onAction("startMoveFolderCreate", actionElement) }
	>
		<span class="flex size-5 shrink-0 items-center justify-center">
			@icon.FolderPlus(icon.Props{Class: "size-4"})
		</span>
		<span class="flex-1 truncate">New folder…</span>
	</button>
}

templ MailLabelsDialog(options []MailLabelOption) {
	@dialog.Dialog(dialog.Props{ID: "mail-labels-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-sm"}) {
			@dialog.Header() {
				@dialog.Title() {
					Labels
				}
				<input
					type="search"
					class="h-8 w-full rounded-md border border-input bg-background px-2.5 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring"
					placeholder="Search or create a label"
					aria-label="Search or create a label"
					autocomplete="off"
					data-mail-labels-search
					data-on-input={ onAction("filterLabelsDialog") }
					data-on-keydown={ onAction("labelsDialogSearchKeydown", actionEvent) }
				/>
			}
			<div class="h-[40vh] max-h-80 overflow-y-auto rounded-md border border-border bg-muted/50 p-1" role="group" aria-label="Labels" data-mail-label-list>
				<button
					type="button"
					class="hidden w-full items-center gap-2.5 rounded-md px-2 py-1.5 text-left text-sm hover:bg-accent hover:text-accent-foreground [&:not(.hidden)]:flex"
					data-mail-labels-create
					data-on-click={ onAction("createLabelFromSearch") }
				>
					@icon.Plus(icon.Props{Class: "size-4 shrink-0 text-muted-foreground"})
					<span class="min-w-0 flex-1 truncate">Create “<span data-mail-labels-create-name></span>”</span>
				</button>
				<div data-mail-labels-rows>
					for _, option := range options {
						@mailLabelsDialogRow(option.Name, option.State)
					}
				</div>
				<p class={ "px-2.5 py-6 text-center text-sm text-muted-foreground", templ.KV("hidden", len(options) > 0) } data-mail-labels-empty>
					No labels yet. Type a name to create one.
				</p>
			</div>
			<template data-mail-labels-row-template>
				@mailLabelsDialogRow("", MailLabelOnNone)
			</template>
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "h-8 px-3 text-xs"}) {
						Cancel
					}
				}
				@button.Button(button.Props{
					Class:      "h-8 px-3 text-xs",
					Disabled:   true,
					Attributes: templ.Attributes{"data-mail-labels-apply": "", "data-on-click": onAction("applyLabelsDialog")},
				}) {
					Apply
				}
			}
		}
	}
}

templ mailLabelsDialogRow(name string, state string) {
	<label
		class="flex w-full cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 text-sm hover:bg-accent hover:text-accent-foreground"
		data-mail-label-option={ name }
		data-mail-labels-key={ strings.ToLower(name) }
	>
		@checkbox.Checkbox(checkbox.Props{
			Checked: state == MailLabelOnAll,
			Attributes: templ.Attributes{
				"data-mail-labels-check": "",
				"data-initial":           state,
				"data-state":             state,
				"data-on-click":          onAction("cycleLabelOption", actionElement),
			},
		})
		@icon.Tag(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
		<span class="min-w-0 flex-1 truncate" data-mail-labels-name>{ name }</span>
	</label>
}
