package views

import (
	"context"
	"net/url"
	"strconv"
	"time"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// A named policy's page has a tab for each category of the settings it can
// set, one for who it's assigned to, and one for its name and deletion.
const (
	AdminNamedPolicyTabAssigned = "assigned"
	AdminNamedPolicyTabDetails  = "details"
)

// The dialogs of the Policies list and a named policy's page.
const (
	adminPolicyCreateDialogID = "admin-policy-create"
	adminPolicyAssignDialogID = "admin-policy-assign"
	adminPolicyDeleteDialogID = "admin-policy-delete"
	adminPolicyLookupDialogID = "admin-policy-lookup"
)

// AdminPolicyLookupPath opens the dialog that finds someone to see their
// settings.
const AdminPolicyLookupPath = AdminPoliciesPath + "/effective"

// AdminPolicyLookupSearchPath is the lookup, searching for search.
func AdminPolicyLookupSearchPath(search string) string {
	if search == "" {
		return AdminPolicyLookupPath
	}
	return AdminPolicyLookupPath + "?q=" + url.QueryEscape(search)
}

// AdminPolicyPath is tab of the policy with policyID's page. The Default
// policy has its own page.
func AdminPolicyPath(policyID, tab string) string {
	if policyID == "default" {
		return AdminDefaultPolicyTabPath(tab)
	}
	path := AdminPoliciesPath + "/" + url.PathEscape(policyID)
	if tab != "" {
		path += "/" + tab
	}
	return path
}

// AdminNamedPolicySettingPath opens the dialog that changes setting key on
// the policy with policyID.
func AdminNamedPolicySettingPath(policyID, key string) string {
	return AdminPolicyPath(policyID, "settings/"+url.PathEscape(key))
}

// AdminPolicyAssignPath opens the Assign dialog, searching for search.
func AdminPolicyAssignPath(policyID, search string) string {
	path := AdminPolicyPath(policyID, "assign")
	if search != "" {
		path += "?q=" + url.QueryEscape(search)
	}
	return path
}

// AdminPoliciesData is the Policies list: the named policies in order,
// the Default policy last.
type AdminPoliciesData struct {
	Policies []AdminPolicyRow
	Default  AdminPolicyRow
	// Form is the New policy dialog, open again after a refusal.
	Form           AdminGroupForm
	CreateOpen     bool
	CreateCSRF     string
	StepUpRequired bool
	// The Check a person dialog: open, what was searched, and who matches.
	LookupOpen   bool
	LookupSearch string
	LookupPeople []AdminPolicyTarget
	LookupMore   bool
}

// AdminPolicyRow is one policy on the list.
type AdminPolicyRow struct {
	ID          string
	Name        string
	Description string
	Priority    int
	Settings    int
	Groups      int
	People      int
	First       bool
	Last        bool
	MoveAction  string
	MoveCSRF    string
}

// AdminNamedPolicyData is a named policy's page.
type AdminNamedPolicyData struct {
	ID          string
	Name        string
	Description string
	Priority    int
	// Version is the policy as it was loaded; a change names it.
	Version   int64
	Tab       string
	Tabs      []AdminPolicyTab
	CreatedAt time.Time
	CreatedBy string
	UpdatedAt time.Time
	UpdatedBy string
	// Settings are the current tab's settings, when it's a category.
	Settings []AdminPolicySetting
	Dialog   *AdminNamedPolicySettingDialog
	// ListDialog is a list setting's dialog, when one is open.
	ListDialog *AdminPolicyListDialog
	// Assigned are the groups and people it applies to.
	Assigned []AdminPolicyTarget
	// The Assign dialog: open, what was searched, and what can be chosen.
	AssignOpen     bool
	AssignSearch   string
	Candidates     []AdminPolicyTarget
	CandidatesMore bool
	Details        AdminGroupForm
	DeleteOpen     bool
	CSRF           AdminNamedPolicyCSRF
	StepUpRequired bool
}

// AdminNamedPolicyCSRF are the page's forms' tokens.
type AdminNamedPolicyCSRF struct {
	Assign, Unassign, Details, Delete string
}

// AdminPolicyTarget is a group or person a policy is, or can be, assigned
// to. Value is how forms name it: "group:ID" or "user:ID".
type AdminPolicyTarget struct {
	Value   string
	Group   bool
	ID      string
	Name    string
	Status  string
	AddedAt time.Time
	AddedBy string
}

// AdminNamedPolicySettingDialog sets, changes or clears one setting on a
// named policy.
type AdminNamedPolicySettingDialog struct {
	Key       string
	Title     string
	Help      string
	Action    string
	CSRFToken string
	Version   int64
	// Choices are what it can be set to; Current is the chosen one, or ""
	// when the policy doesn't set it.
	Choices []AdminPolicyChoice
	Current string
	// NotApplied: the setting is saved, but doesn't take effect per person
	// yet.
	NotApplied bool
}

// AdminPolicyChoice is one value a setting can be set to.
type AdminPolicyChoice struct {
	Value string
	Label string
}

func (target AdminPolicyTarget) path() string {
	if target.Group {
		return AdminGroupPath(target.ID, AdminGroupTabMembers)
	}
	return AdminUserPagePath(url.PathEscape(target.ID), AdminUserTabOverview, "")
}

templ AdminPoliciesPage(data AdminPoliciesData, verification ...AdminSecurityVerificationData) {
	<div
		class="flex-1 flex flex-col min-w-0 overflow-hidden"
		data-admin-policies
		if adminSecurityVerificationValue(verification).Required {
			hx-headers={ adminVerificationOnPageHeaders }
		}
	>
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-5xl px-6 py-8 lg:px-8 lg:py-10">
				@adminPageHeader(adminPageHeaderProps{Title: i18n.T(ctx, "admin.nav.policies"), Description: i18n.T(ctx, "admin.policies.list_description"), Actions: adminPoliciesHeaderActions()})
				@adminPolicyCreateDialog(data)
				@adminPolicyLookupDialog(data)
				@adminSection(adminSectionProps{ID: "admin-policies-heading", Title: i18n.T(ctx, "admin.policies.order_heading"), Aside: adminSectionNote(i18n.T(ctx, "admin.policies.order_note"))}) {
					<ol class="divide-y divide-border">
						for _, row := range data.Policies {
							@adminPolicyListRow(row, false)
						}
						@adminPolicyListRow(data.Default, true)
					</ol>
				}
				if len(data.Policies) == 0 {
					<p class="mt-4 text-sm text-muted-foreground" data-admin-policies-none>{ i18n.T(ctx, "admin.policies.none") }</p>
				}
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

templ adminPoliciesHeaderActions() {
	<div class="flex flex-wrap items-center gap-2">
		@button.Button(button.Props{Variant: button.VariantOutline, Href: AdminPolicyLookupPath, Attributes: templ.Attributes{"data-admin-policy-lookup": ""}}) {
			@icon.UserSearch(icon.Props{Class: "size-4"})
			{ i18n.T(ctx, "admin.policies.lookup") }
		}
		@dialog.Trigger(dialog.TriggerProps{For: adminPolicyCreateDialogID}) {
			@button.Button(button.Props{Attributes: templ.Attributes{"data-admin-policy-create": ""}}) {
				@icon.Plus(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "admin.policies.create") }
			}
		}
	</div>
}

// adminPolicyLookupDialog finds someone by username and leads to their
// settings: each value, and which policy it comes from.
templ adminPolicyLookupDialog(data AdminPoliciesData) {
	@dialog.Dialog(dialog.Props{ID: adminPolicyLookupDialogID, Open: data.LookupOpen}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg max-h-[calc(100vh-2rem)]"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.policies.lookup_title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.policies.lookup_detail") }
				}
			}
			<form
				method="get"
				action={ templ.SafeURL(AdminPolicyLookupPath) }
				role="search"
				hx-get={ AdminPolicyLookupPath }
				hx-target="#admin-policy-lookup-people"
				hx-select="#admin-policy-lookup-people"
				hx-swap="outerHTML"
				hx-trigger="submit, input changed delay:300ms from:find input[name='q']"
			>
				<div class="relative">
					@icon.Search(icon.Props{Class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground"})
					@input.Input(input.Props{
						Type: input.TypeSearch, Name: "q", Value: data.LookupSearch, Placeholder: i18n.T(ctx, "admin.users.search"), Class: "pl-9",
						Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "admin.users.search"), "autocomplete": "off", "autofocus": true},
					})
				</div>
			</form>
			<div id="admin-policy-lookup-people" class="mt-3 max-h-72 overflow-y-auto rounded-md border border-border">
				if len(data.LookupPeople) == 0 {
					<p class="px-3 py-6 text-center text-sm text-muted-foreground" data-admin-policy-lookup-nobody>
						if data.LookupSearch == "" {
							{ i18n.T(ctx, "admin.policies.lookup_nobody") }
						} else {
							{ i18n.T(ctx, "admin.policies.lookup_no_match") }
						}
					</p>
				} else {
					<ul class="divide-y divide-border">
						for _, person := range data.LookupPeople {
							<li>
								<a href={ templ.SafeURL(AdminUserPolicyPath(person.ID, "")) } class="flex items-center gap-3 px-3 py-2 text-sm hover:bg-accent/35" data-admin-policy-lookup-person={ person.ID }>
									<span class="text-muted-foreground" aria-hidden="true">
										@icon.User(icon.Props{Class: "size-4"})
									</span>
									<span class="min-w-0 flex-1 truncate font-medium text-foreground">{ person.Name }</span>
									if person.Status != "active" {
										@adminBadge(adminUserStatusTone(person.Status)) {
											{ adminValueLabel(ctx, person.Status) }
										}
									}
									@icon.ChevronRight(icon.Props{Class: "size-4 text-muted-foreground"})
								</a>
							</li>
						}
					</ul>
					if data.LookupMore {
						<p class="border-t border-border px-3 py-2 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.group.candidates_more") }</p>
					}
				}
			</div>
			@dialog.Footer() {
				@dialog.Close(dialog.CloseProps{For: adminPolicyLookupDialogID}) {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						{ i18n.T(ctx, "common.close") }
					}
				}
			}
		}
	}
}

templ adminPolicyListRow(row AdminPolicyRow, isDefault bool) {
	<li class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between" data-admin-policy-row={ row.ID }>
		<div class="flex min-w-0 items-start gap-3">
			<span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-xs font-semibold tabular-nums text-muted-foreground" aria-hidden="true">
				if isDefault {
					@icon.Globe(icon.Props{Class: "size-3.5"})
				} else {
					{ strconv.Itoa(row.Priority) }
				}
			</span>
			<div class="min-w-0">
				<a href={ templ.SafeURL(AdminPolicyPath(row.ID, "")) } class="font-semibold text-foreground hover:underline">{ row.Name }</a>
				if row.Description != "" {
					<p class="mt-0.5 line-clamp-2 text-xs text-muted-foreground">{ row.Description }</p>
				}
				<p class="mt-1 text-xs text-muted-foreground">
					if isDefault {
						{ i18n.T(ctx, "admin.policies.applies_everyone") }
					} else {
						{ i18n.N(ctx, "admin.policies.settings_count", row.Settings, "count", i18n.Number(ctx, row.Settings)) }
						·
						{ adminPolicyAssignedSummary(ctx, row.Groups, row.People) }
					}
				</p>
			</div>
		</div>
		if !isDefault {
			<form method="post" action={ templ.SafeURL(row.MoveAction) } class="flex shrink-0 items-center gap-1" data-step-up data-admin-policy-move={ row.ID }>
				<input type="hidden" name="_csrf" value={ row.MoveCSRF }/>
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Disabled: row.First, Attributes: templ.Attributes{"name": "move", "value": "up", "aria-label": i18n.T(ctx, "admin.policies.move_up", "policy", row.Name)}}) {
					@icon.ArrowUp(icon.Props{Class: "size-4"})
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Disabled: row.Last, Attributes: templ.Attributes{"name": "move", "value": "down", "aria-label": i18n.T(ctx, "admin.policies.move_down", "policy", row.Name)}}) {
					@icon.ArrowDown(icon.Props{Class: "size-4"})
				}
			</form>
		}
	</li>
}

func adminPolicyAssignedSummary(ctx context.Context, groups, people int) string {
	if groups == 0 && people == 0 {
		return i18n.T(ctx, "admin.policies.assigned_nobody")
	}
	return i18n.T(ctx, "admin.policies.assigned_summary", "who", adminPolicyWho(ctx, groups, people))
}

// adminPolicyWho counts groups and people, leaving out whichever is none.
func adminPolicyWho(ctx context.Context, groups, people int) string {
	groupText := i18n.N(ctx, "admin.policies.groups_count", groups, "count", i18n.Number(ctx, groups))
	peopleText := i18n.N(ctx, "admin.groups.member_count", people, "count", i18n.Number(ctx, people))
	switch {
	case people == 0:
		return groupText
	case groups == 0:
		return peopleText
	}
	return i18n.T(ctx, "admin.policies.who_both", "groups", groupText, "people", peopleText)
}

templ adminPolicyCreateDialog(data AdminPoliciesData) {
	@dialog.Dialog(dialog.Props{ID: adminPolicyCreateDialogID, Open: data.CreateOpen && !data.StepUpRequired}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.policies.create") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.policies.create_detail") }
				}
			}
			<form method="post" action={ templ.SafeURL(AdminPoliciesPath) } class="space-y-4" data-step-up>
				<input type="hidden" name="_csrf" value={ data.CreateCSRF }/>
				@adminNameFields("admin-policy-create", data.Form, i18n.T(ctx, "admin.policies.description_help"))
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: adminPolicyCreateDialogID}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ i18n.T(ctx, "admin.policies.create_submit") }
					}
				}
			</form>
		}
	}
}

templ AdminNamedPolicyPage(data AdminNamedPolicyData, verification ...AdminSecurityVerificationData) {
	<div
		class="flex-1 flex flex-col min-w-0 overflow-hidden"
		data-admin-named-policy
		if adminSecurityVerificationValue(verification).Required {
			hx-headers={ adminVerificationOnPageHeaders }
		}
	>
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-5xl px-6 py-8 lg:px-8 lg:py-10">
				<a href={ templ.SafeURL(AdminPoliciesPath) } class="mb-4 inline-flex items-center gap-1 text-sm font-medium text-muted-foreground hover:text-foreground" data-admin-policy-back>
					@icon.ArrowLeft(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "admin.nav.policies") }
				</a>
				@adminPageHeader(adminPageHeaderProps{Title: data.Name, Description: data.Description})
				<p class="mt-2 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.policies.priority", "priority", i18n.Number(ctx, data.Priority)) }</p>
				@linkTabs(i18n.T(ctx, "admin.policies.policy_tabs")) {
					for _, tab := range data.Tabs {
						@linkTab(templ.SafeURL(AdminPolicyPath(data.ID, tab.Tab)), tab.Label, data.Tab == tab.Tab, nil)
					}
				}
				switch data.Tab {
					case AdminNamedPolicyTabAssigned:
						@adminPolicyAssignedTab(data)
					case AdminNamedPolicyTabDetails:
						@adminPolicyDetailsTab(data)
					default:
						@adminSection(adminSectionProps{ID: "admin-named-policy-settings-heading", Title: adminNamedPolicyTabLabel(data)}) {
							<ul class="divide-y divide-border">
								for _, setting := range data.Settings {
									@adminPolicySettingRow(setting)
								}
							</ul>
						}
						if data.Dialog != nil {
							@adminNamedPolicySettingDialog(*data.Dialog, data.StepUpRequired)
						}
						if data.ListDialog != nil {
							@adminPolicyListDialog(*data.ListDialog, data.StepUpRequired)
						}
				}
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

func adminNamedPolicyTabLabel(data AdminNamedPolicyData) string {
	for _, tab := range data.Tabs {
		if tab.Tab == data.Tab {
			return tab.Label
		}
	}
	return ""
}

// adminNamedPolicySettingDialog sets a setting on the policy, or leaves it
// to the policies after it and the Default policy.
templ adminNamedPolicySettingDialog(d AdminNamedPolicySettingDialog, stepUpRequired bool) {
	@dialog.Dialog(dialog.Props{ID: adminPolicySettingDialogID, Open: !stepUpRequired}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg max-h-[calc(100vh-2rem)] overflow-y-auto"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ d.Title }
				}
				@dialog.Description() {
					{ d.Help }
				}
			}
			<form method="post" action={ templ.SafeURL(d.Action) } class="space-y-4" data-step-up data-admin-policy-form={ d.Key }>
				<input type="hidden" name="_csrf" value={ d.CSRFToken }/>
				<input type="hidden" name="version" value={ strconv.FormatInt(d.Version, 10) }/>
				<fieldset class="space-y-2">
					<legend class="sr-only">{ d.Title }</legend>
					@adminPolicyChoice("admin-policy-value-unset", "", i18n.T(ctx, "admin.policies.not_set"), i18n.T(ctx, "admin.policies.not_set_detail"), d.Current == "")
					for _, choice := range d.Choices {
						@adminPolicyChoice("admin-policy-value-"+choice.Value, choice.Value, choice.Label, "", d.Current == choice.Value)
					}
				</fieldset>
				if d.NotApplied {
					<p class="rounded-md border border-amber-500/30 bg-amber-500/10 px-3 py-2.5 text-xs leading-relaxed text-amber-900 dark:text-amber-100" data-admin-policy-not-applied>
						{ i18n.T(ctx, "admin.policies.not_applied_detail") }
					</p>
				}
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: adminPolicySettingDialogID}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ i18n.T(ctx, "common.save") }
					}
				}
			</form>
		}
	}
}

templ adminPolicyAssignedTab(data AdminNamedPolicyData) {
	@adminPolicyAssignDialog(data)
	@adminSection(adminSectionProps{ID: "admin-policy-assigned-heading", Title: i18n.T(ctx, "admin.policies.assigned_heading"), Aside: adminPolicyAssignedActions(data)}) {
		if len(data.Assigned) == 0 {
			@adminEmptyState(i18n.T(ctx, "admin.policies.assigned_none"))
		} else {
			<form id="admin-policy-unassign" method="post" action={ templ.SafeURL(AdminPolicyPath(data.ID, "unassign")) } data-step-up>
				<input type="hidden" name="_csrf" value={ data.CSRF.Unassign }/>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[36rem] text-left text-sm">
						<thead class="bg-muted/45 text-xs font-semibold text-muted-foreground">
							<tr>
								<th scope="col" class="w-10 px-4 py-3">
									@checkbox.Checkbox(checkbox.Props{ID: "admin-policy-assigned-all", Group: "admin-policy-assigned", GroupParent: true, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "admin.group.select_all")}})
								</th>
								<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.policies.col.target") }</th>
								<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.policies.col.assigned") }</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							for _, target := range data.Assigned {
								<tr class="bg-background/35 align-top hover:bg-accent/35" data-admin-policy-target={ target.Value }>
									<td class="px-4 py-3">
										@checkbox.Checkbox(checkbox.Props{
											ID: "admin-policy-target-" + target.Value, Name: "target", Value: target.Value, Group: "admin-policy-assigned",
											Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "admin.group.select_person", "user", target.Name)},
										})
									</td>
									<td class="px-4 py-3">
										@adminPolicyTargetName(target)
									</td>
									<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">
										if target.AddedBy != "" {
											{ i18n.T(ctx, "admin.group.added_by", "when", adminTime(ctx, target.AddedAt), "user", target.AddedBy) }
										} else {
											{ adminTime(ctx, target.AddedAt) }
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</form>
		}
	}
}

templ adminPolicyTargetName(target AdminPolicyTarget) {
	<span class="inline-flex items-center gap-2">
		<span class="text-muted-foreground" aria-hidden="true">
			if target.Group {
				@icon.UsersRound(icon.Props{Class: "size-4"})
			} else {
				@icon.User(icon.Props{Class: "size-4"})
			}
		</span>
		<a href={ templ.SafeURL(target.path()) } class="font-semibold text-foreground hover:underline">{ target.Name }</a>
		<span class="sr-only">
			if target.Group {
				{ i18n.T(ctx, "admin.policies.kind.group") }
			} else {
				{ i18n.T(ctx, "admin.policies.kind.person") }
			}
		</span>
	</span>
}

templ adminPolicyAssignedActions(data AdminNamedPolicyData) {
	<div class="flex flex-wrap items-center gap-2">
		if len(data.Assigned) > 0 {
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Form: "admin-policy-unassign", Attributes: templ.Attributes{"data-admin-policy-unassign": ""}}) {
				@icon.X(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "admin.policies.unassign") }
			}
		}
		@button.Button(button.Props{Size: button.SizeSm, Href: AdminPolicyAssignPath(data.ID, ""), Attributes: templ.Attributes{"data-admin-policy-assign": ""}}) {
			@icon.Plus(icon.Props{Class: "size-4"})
			{ i18n.T(ctx, "admin.policies.assign") }
		}
	</div>
}

// adminPolicyAssignDialog finds groups by name and people by username, and
// assigns the policy to the ones chosen.
templ adminPolicyAssignDialog(data AdminNamedPolicyData) {
	@dialog.Dialog(dialog.Props{ID: adminPolicyAssignDialogID, Open: data.AssignOpen && !data.StepUpRequired}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg max-h-[calc(100vh-2rem)]"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.policies.assign_title", "policy", data.Name) }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.policies.assign_detail") }
				}
			}
			<form
				method="get"
				action={ templ.SafeURL(AdminPolicyAssignPath(data.ID, "")) }
				role="search"
				hx-get={ AdminPolicyAssignPath(data.ID, "") }
				hx-target="#admin-policy-candidates"
				hx-select="#admin-policy-candidates"
				hx-swap="outerHTML"
				hx-trigger="submit, input changed delay:300ms from:find input[name='q']"
			>
				<div class="relative">
					@icon.Search(icon.Props{Class: "pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground"})
					@input.Input(input.Props{
						Type: input.TypeSearch, Name: "q", Value: data.AssignSearch, Placeholder: i18n.T(ctx, "admin.policies.assign_search"), Class: "pl-9",
						Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "admin.policies.assign_search"), "autocomplete": "off", "autofocus": true},
					})
				</div>
			</form>
			<form method="post" action={ templ.SafeURL(AdminPolicyPath(data.ID, "assign")) } data-step-up class="mt-3">
				<input type="hidden" name="_csrf" value={ data.CSRF.Assign }/>
				<div id="admin-policy-candidates" class="max-h-72 overflow-y-auto rounded-md border border-border">
					if len(data.Candidates) == 0 {
						<p class="px-3 py-6 text-center text-sm text-muted-foreground" data-admin-policy-no-candidates>
							if data.AssignSearch == "" {
								{ i18n.T(ctx, "admin.policies.no_candidates") }
							} else {
								{ i18n.T(ctx, "admin.policies.no_candidates_match") }
							}
						</p>
					} else {
						<ul class="divide-y divide-border">
							for _, target := range data.Candidates {
								<li>
									<label for={ "admin-policy-candidate-" + target.Value } class="flex cursor-pointer items-center gap-3 px-3 py-2 text-sm hover:bg-accent/35" data-admin-policy-candidate={ target.Value }>
										@checkbox.Checkbox(checkbox.Props{ID: "admin-policy-candidate-" + target.Value, Name: "target", Value: target.Value})
										<span class="text-muted-foreground" aria-hidden="true">
											if target.Group {
												@icon.UsersRound(icon.Props{Class: "size-4"})
											} else {
												@icon.User(icon.Props{Class: "size-4"})
											}
										</span>
										<span class="min-w-0 flex-1 truncate font-medium text-foreground">{ target.Name }</span>
										if target.Group {
											<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.policies.kind.group") }</span>
										} else if target.Status != "active" {
											@adminBadge(adminUserStatusTone(target.Status)) {
												{ adminValueLabel(ctx, target.Status) }
											}
										}
									</label>
								</li>
							}
						</ul>
						if data.CandidatesMore {
							<p class="border-t border-border px-3 py-2 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.group.candidates_more") }</p>
						}
					}
				</div>
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: adminPolicyAssignDialogID}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ i18n.T(ctx, "admin.policies.assign_submit") }
					}
				}
			</form>
		}
	}
}

templ adminPolicyDetailsTab(data AdminNamedPolicyData) {
	@adminSection(adminSectionProps{ID: "admin-policy-details-heading", Title: i18n.T(ctx, "admin.group.settings")}) {
		<form method="post" action={ templ.SafeURL(AdminPolicyPath(data.ID, AdminNamedPolicyTabDetails)) } class="space-y-4 px-4 py-4" data-step-up data-admin-policy-details>
			<input type="hidden" name="_csrf" value={ data.CSRF.Details }/>
			<input type="hidden" name="version" value={ strconv.FormatInt(data.Version, 10) }/>
			<div class="max-w-xl space-y-4">
				@adminNameFields("admin-policy-details", data.Details, i18n.T(ctx, "admin.policies.description_help"))
			</div>
			<div class="flex justify-end">
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					{ i18n.T(ctx, "common.save") }
				}
			</div>
		</form>
	}
	@adminSection(adminSectionProps{ID: "admin-policy-changes-heading", Title: i18n.T(ctx, "admin.group.details")}) {
		@adminFacts() {
			@adminFact(i18n.T(ctx, "admin.group.created")) {
				@adminGroupWhen(data.CreatedAt, data.CreatedBy)
			}
			@adminFact(i18n.T(ctx, "admin.group.changed")) {
				@adminGroupWhen(data.UpdatedAt, data.UpdatedBy)
			}
		}
	}
	@adminSection(adminSectionProps{ID: "admin-policy-delete-heading", Title: i18n.T(ctx, "admin.policies.delete"), Class: "border-destructive/30"}) {
		<div class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "admin.policies.delete_detail") }</p>
			@button.Button(button.Props{Variant: button.VariantDestructive, Href: AdminPolicyPath(data.ID, "delete"), Attributes: templ.Attributes{"data-admin-policy-delete": ""}}) {
				@icon.Trash2(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "admin.policies.delete") }
			}
		</div>
	}
	@dialog.Dialog(dialog.Props{ID: adminPolicyDeleteDialogID, Open: data.DeleteOpen && !data.StepUpRequired}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.policies.delete_title", "policy", data.Name) }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.group.delete_description") }
				}
			}
			<div class="rounded-lg border border-destructive/25 bg-destructive/5 px-4 py-3 text-sm text-foreground" data-admin-policy-delete-preview>
				if len(data.Assigned) == 0 {
					{ i18n.T(ctx, "admin.policies.delete_unassigned") }
				} else {
					{ i18n.T(ctx, "admin.policies.delete_assigned", "who", adminPolicyWho(ctx, adminPolicyGroupCount(data.Assigned), len(data.Assigned)-adminPolicyGroupCount(data.Assigned))) }
				}
			</div>
			<form method="post" action={ templ.SafeURL(AdminPolicyPath(data.ID, "delete")) } data-step-up class="mt-5">
				<input type="hidden" name="_csrf" value={ data.CSRF.Delete }/>
				<input type="hidden" name="version" value={ strconv.FormatInt(data.Version, 10) }/>
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: adminPolicyDeleteDialogID}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						{ i18n.T(ctx, "admin.policies.delete") }
					}
				}
			</form>
		}
	}
}

func adminPolicyGroupCount(targets []AdminPolicyTarget) int {
	count := 0
	for _, target := range targets {
		if target.Group {
			count++
		}
	}
	return count
}
