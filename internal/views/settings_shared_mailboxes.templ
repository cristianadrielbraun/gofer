package views

import (
	"context"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/sharedmailbox"
)

// SharedMailboxSettingsCard holds the choices for the mailboxes an IMAP
// account can open besides its own (sharedmailbox.Settings). Each is saved
// as it changes.
templ SharedMailboxSettingsCard(uiSettings map[string]string) {
	{{ settings := sharedmailbox.SettingsFrom(uiSettings) }}
	<div class="settings-card bg-card rounded-lg border p-6 space-y-5" data-shared-mailbox-settings>
		<div>
			<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.shared_mailboxes.title") }</h3>
			<p class="text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.shared_mailboxes.description") }</p>
		</div>
		@sharedMailboxSwitch(sharedmailbox.KeyAutoIdentities, settings.AutoIdentities, "settings.shared_mailboxes.auto_identities_title", "settings.shared_mailboxes.auto_identities_description")
		<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
			<div class="min-w-0">
				<span id="shared-mailboxes-prefix-mode-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.shared_mailboxes.prefix_title") }</span>
				<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.shared_mailboxes.prefix_description") }</p>
			</div>
			<div class="w-full sm:w-56 shrink-0 space-y-2">
				@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
					@selectbox.Trigger(selectbox.TriggerProps{ID: "shared-mailboxes-prefix-mode", Name: sharedmailbox.KeyPrefixMode, Class: "bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"aria-labelledby": "shared-mailboxes-prefix-mode-label", "data-ui-setting-input": sharedmailbox.KeyPrefixMode}}) {
						@selectbox.Value(selectbox.ValueProps{}) {
							{ sharedMailboxPrefixLabel(ctx, settings.PrefixMode) }
						}
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
						for _, mode := range []string{sharedmailbox.PrefixServer, sharedmailbox.PrefixDomain, sharedmailbox.PrefixNone, sharedmailbox.PrefixCustom} {
							@selectbox.Item(selectbox.ItemProps{Value: mode, Selected: settings.PrefixMode == mode}) {
								{ sharedMailboxPrefixLabel(ctx, mode) }
							}
						}
					}
				}
				@input.Input(input.Props{
					ID:          "shared-mailboxes-custom-prefix",
					Value:       settings.CustomPrefix,
					Placeholder: i18n.T(ctx, "settings.shared_mailboxes.prefix_placeholder"),
					Attributes:  templ.Attributes{"aria-label": i18n.T(ctx, "settings.shared_mailboxes.prefix_custom"), "maxlength": "60", "data-ui-setting-input": sharedmailbox.KeyCustomPrefix},
				})
			</div>
		</div>
		@sharedMailboxSwitch(sharedmailbox.KeyVerifySender, settings.VerifySender, "settings.shared_mailboxes.verify_title", "settings.shared_mailboxes.verify_description")
		@sharedMailboxSwitch(sharedmailbox.KeyDisableRemoved, settings.DisableRemoved, "settings.shared_mailboxes.disable_removed_title", "settings.shared_mailboxes.disable_removed_description")
		@sharedMailboxSwitch(sharedmailbox.KeyShowAddress, settings.ShowAddress, "settings.shared_mailboxes.show_address_title", "settings.shared_mailboxes.show_address_description")
		@sharedMailboxSwitch(sharedmailbox.KeyInUnified, settings.InUnified, "settings.shared_mailboxes.in_unified_title", "settings.shared_mailboxes.in_unified_description")
	</div>
}

templ sharedMailboxSwitch(key string, checked bool, titleKey string, descriptionKey string) {
	<div class="settings-row border-t border-border/60 pt-5 flex items-start justify-between gap-6">
		<div class="min-w-0">
			<span id={ key + "-label" } class="text-sm font-medium text-foreground">{ i18n.T(ctx, titleKey) }</span>
			<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, descriptionKey) }</p>
		</div>
		@switchcomp.Switch(switchcomp.Props{
			ID:         key,
			Name:       key,
			Checked:    checked,
			Attributes: templ.Attributes{"aria-labelledby": key + "-label", "data-ui-setting-switch": key},
		})
	</div>
}

// sharedMailboxPrefixLabel names a way of choosing the name before a shared
// mailbox's identities.
func sharedMailboxPrefixLabel(ctx context.Context, mode string) string {
	switch mode {
	case sharedmailbox.PrefixNone:
		return i18n.T(ctx, "settings.shared_mailboxes.prefix_none")
	case sharedmailbox.PrefixCustom:
		return i18n.T(ctx, "settings.shared_mailboxes.prefix_custom")
	case sharedmailbox.PrefixServer:
		return i18n.T(ctx, "settings.shared_mailboxes.prefix_server")
	default:
		return i18n.T(ctx, "settings.shared_mailboxes.prefix_domain")
	}
}
