package views

import (
	"strconv"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/input"
)

templ CalendarCreateDialog(data CalendarCreateData) {
	@dialog.Dialog(dialog.Props{ID: "calendar-create-dialog"}) {
		@dialog.Content(dialog.ContentProps{
			HideCloseButton: true,
			Class: "w-[calc(100vw_-_2rem)] max-w-[calc(100vw_-_2rem)] sm:max-w-lg [&_[data-tui-dialog-panel]]:flex [&_[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] [&_[data-tui-dialog-panel]]:min-h-0 [&_[data-tui-dialog-panel]]:flex-col [&_[data-tui-dialog-panel]]:gap-0 [&_[data-tui-dialog-panel]]:p-0",
			Attributes: templ.Attributes{"aria-labelledby": "calendar-create-title"},
		}) {
			<header class="flex shrink-0 items-center justify-between gap-4 border-b border-border px-5 py-4">
				@dialog.Title(dialog.TitleProps{ID: "calendar-create-title", Class: "text-lg font-semibold"}) {
					New event
				}
				<button type="button" data-tui-dialog-close class="flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label="Close new event">@icon.X(icon.Props{Class: "size-4"})</button>
			</header>
			<form id="calendar-create-form" data-calendar-create-form data-request-id={ data.RequestID } class="flex min-h-0 flex-col" action="/api/calendar/events" method="post">
				<input type="hidden" name="request_id" value={ data.RequestID }/>
				<div class="min-h-0 space-y-4 overflow-y-auto px-5 py-5">
					<div class="space-y-1.5">
						<label for="calendar-create-source" class="text-sm font-medium">Calendar</label>
						<select id="calendar-create-source" name="source_id" required disabled?={ len(data.Sources) == 0 } class="flex h-9 w-full min-w-0 rounded-md border border-input bg-input/30 px-3 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] disabled:opacity-50">
							if len(data.Sources) == 0 {
								<option value="">No configured calendars</option>
							}
							for _, source := range data.Sources {
								<option value={ source.ID } selected?={ source.ID == data.SourceID } disabled?={ !source.Writable } data-calendar-source-writable={ strconv.FormatBool(source.Writable) } data-calendar-source-authorized={ strconv.FormatBool(source.Authorized) }>
									{ source.Name } · { source.AccountName }
										if !source.Writable {
											· Read-only
										}
								</option>
							}
						</select>
						<p data-calendar-create-access hidden class="text-xs leading-relaxed text-muted-foreground"></p>
					</div>
					<div class="space-y-1.5">
						<label for="calendar-create-summary" class="text-sm font-medium">Title</label>
						@input.Input(input.Props{ID: "calendar-create-summary", Name: "summary", Placeholder: "Event title", Required: true, Attributes: templ.Attributes{"maxlength": "255", "autocomplete": "off"}})
					</div>
					<label for="calendar-create-all-day" class="inline-flex items-center gap-2 text-sm font-medium">
						@checkbox.Checkbox(checkbox.Props{ID: "calendar-create-all-day", Name: "all_day", Value: "true"}) All day
					</label>
					<div class="grid grid-cols-2 gap-3">
						<div class="space-y-1.5">
							<label for="calendar-create-start-date" class="text-sm font-medium">Starts</label>
							@input.Input(input.Props{ID: "calendar-create-start-date", Name: "start_date", Type: input.TypeDate, Value: data.Date, Required: true})
							<div data-calendar-create-time>@input.Input(input.Props{ID: "calendar-create-start-time", Name: "start_time", Type: input.TypeTime, Value: data.StartTime, Required: true, Attributes: templ.Attributes{"aria-label": "Start time"}})</div>
						</div>
						<div class="space-y-1.5">
							<label for="calendar-create-end-date" class="text-sm font-medium">Ends</label>
							@input.Input(input.Props{ID: "calendar-create-end-date", Name: "end_date", Type: input.TypeDate, Value: data.EndDate, Required: true})
							<div data-calendar-create-time>@input.Input(input.Props{ID: "calendar-create-end-time", Name: "end_time", Type: input.TypeTime, Value: data.EndTime, Required: true, Attributes: templ.Attributes{"aria-label": "End time"}})</div>
						</div>
					</div>
					<p data-calendar-create-date-help hidden class="text-xs text-muted-foreground">The end date is included in an all-day event.</p>
					<div class="space-y-1.5" data-calendar-create-timezone>
						<label for="calendar-create-timezone" class="text-sm font-medium">Time zone</label>
						@input.Input(input.Props{ID: "calendar-create-timezone", Name: "timezone", Value: data.TimeZone, Required: true, Placeholder: "Europe/Prague", Attributes: templ.Attributes{"list": "calendar-create-timezones", "autocomplete": "off", "maxlength": "100"}})
						<datalist id="calendar-create-timezones"></datalist>
					</div>
					<div class="space-y-1.5">
						<label for="calendar-create-location" class="text-sm font-medium">Location <span class="text-xs font-normal text-muted-foreground">optional</span></label>
						@input.Input(input.Props{ID: "calendar-create-location", Name: "location", Attributes: templ.Attributes{"maxlength": "1024"}})
					</div>
					<div class="space-y-1.5">
						<label for="calendar-create-description" class="text-sm font-medium">Description <span class="text-xs font-normal text-muted-foreground">optional</span></label>
						<textarea id="calendar-create-description" name="description" rows="3" maxlength="16384" class="flex min-h-20 w-full resize-y rounded-md border border-input bg-input/30 px-3 py-2 text-sm shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]"></textarea>
					</div>
					<p data-calendar-create-error role="alert" hidden class="text-sm leading-relaxed text-destructive"></p>
				</div>
				<footer class="flex shrink-0 items-center justify-end gap-2 border-t border-border px-5 py-3">
					<button type="button" data-tui-dialog-close class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold transition-colors hover:bg-accent">Cancel</button>
					<button type="submit" data-calendar-create-submit class="btn-skeuo inline-flex h-9 items-center justify-center gap-2 rounded-md px-4 text-sm font-semibold disabled:cursor-not-allowed disabled:opacity-50">
						<span data-calendar-create-spinner hidden>@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})</span><span data-calendar-create-submit-label>Create event</span>
						</button>
				</footer>
			</form>
		}
	}
}
