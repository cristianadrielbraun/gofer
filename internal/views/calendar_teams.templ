package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/label"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
	"strconv"
)

templ CalendarTeamsOption(data CalendarTeamsData) {
	{{ available := data.State == "available" || data.State == "available-default" }}
	{{ name := "teams_meeting" }}
	{{ title := i18n.T(ctx, "calendar.teams.title") }}
	{{ id := "calendar-create-teams" }}
	{{ retryLabel := i18n.T(ctx, "calendar.teams.retry") }}
	if data.Provider == "gmail" {
		{{ name, title, id = "google_meet_meeting", i18n.T(ctx, "calendar.meet.title"), "calendar-create-google-meet" }}
		{{ retryLabel = i18n.T(ctx, "calendar.meet.retry") }}
	}
	// An existing Meet conference can be removed: the switch drives a hidden
	// field so turning it off submits false. Teams cannot be turned off.
	{{ removable := data.State == "existing" && data.Provider == "gmail" }}
	{{ replaceable := data.State == "existing" && data.Provider == "outlook" && data.Replaceable }}
	if data.State == "existing" || data.State == "other-online" {
		{{ name = "" }}
	}
	@calendarDialogRow(icon.Video(icon.Props{Class: "size-4"}), "pt-0.5") {
		<div class="flex items-center justify-between gap-3">
			@label.Label(label.Props{For: id, Class: "font-normal"}) {
				{ title }
			}
			<div class="flex items-center gap-2">
				if data.State == "error" || data.State == "checking" {
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-7", Attributes: templ.Attributes{"data-calendar-teams-retry": "", "hidden": data.State != "error", "aria-label": retryLabel, "title": retryLabel, "data-on-click": onAction("retryCalendarTeams", actionClosest("[data-calendar-create-form]"))}}) {
						@icon.RefreshCw(icon.Props{Class: "size-3.5"})
					}
				}
				if removable {
					<input type="hidden" name="google_meet_meeting" value="true" data-calendar-meet-existing/>
					@switchcomp.Switch(switchcomp.Props{ID: id, Value: "true", Checked: true, Attributes: templ.Attributes{"data-calendar-teams-toggle": "", "data-calendar-teams-available": "true", "data-on-change": onAction("toggleCalendarMeetRemoval", actionElement)}})
				} else if replaceable {
					@switchcomp.Switch(switchcomp.Props{ID: id, Value: "true", Checked: true, Attributes: templ.Attributes{"data-calendar-teams-toggle": "", "data-calendar-teams-available": "true", "data-calendar-teams-replace-toggle": "", "data-on-change": onAction("toggleCalendarTeamsReplacement", actionElement)}})
				} else {
					@switchcomp.Switch(switchcomp.Props{ID: id, Name: name, Value: "true", Checked: data.State == "existing", Disabled: !available, Attributes: templ.Attributes{"data-calendar-teams-toggle": "", "data-calendar-teams-available": strconv.FormatBool(available)}})
				}
			</div>
		</div>
		if available && (data.Provider == "gmail" || data.EventID == "") {
   {{ draftName, retryAction := "google_meet_draft_id", onAction("retryCalendarMeetPreview", actionClosest("[data-calendar-create-form]")) }}
   if data.Provider != "gmail" {
    {{ draftName, retryAction = "teams_draft_id", onAction("retryCalendarTeamsPreview", actionClosest("[data-calendar-create-form]")) }}
   }
			<div data-calendar-meet-preview data-calendar-meeting-provider={ name } hidden class="mt-2 space-y-2">
				<input type="hidden" name={ draftName } value=""/>
				<p data-calendar-meet-status role="status" aria-live="polite" class="text-xs text-muted-foreground"></p>
				<div data-calendar-meet-link hidden class="flex min-w-0 items-center gap-2">
					<a data-calendar-meet-url target="_blank" rel="noopener noreferrer" class="min-w-0 break-all text-sm underline underline-offset-4"></a>
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{"data-calendar-meet-copy": "", "data-on-click": onAction("copyCalendarMeetLink", actionElement)}}) {
						{ i18n.T(ctx, "calendar.meet.copy_link") }
					}
				</div>
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{"data-calendar-meet-prepare-retry": "", "hidden": true, "data-on-click": retryAction}}) {
					{ i18n.T(ctx, "calendar.retry") }
				}
			</div>
		} else if data.Provider == "gmail" && data.JoinURL != "" {
			<a data-calendar-meet-existing-link href={ templ.SafeURL(data.JoinURL) } target="_blank" rel="noopener noreferrer" class="mt-2 block break-all text-sm underline underline-offset-4">{ data.JoinURL }</a>
		}
		if removable {
			<p data-calendar-meet-removal hidden role="status" class="mt-2 text-xs text-muted-foreground">{ i18n.T(ctx, "calendar.meet.removal") }</p>
		}
		if replaceable {
			<div data-calendar-teams-replace hidden role="status" class="mt-2 space-y-2 rounded-md border border-border bg-muted/40 p-3 text-xs leading-relaxed text-muted-foreground">
				<p class="font-medium text-foreground">{ i18n.T(ctx, "calendar.teams.replace.title") }</p>
				<p>{ i18n.T(ctx, "calendar.teams.replace.intro") }</p>
				<ul class="list-disc space-y-1 pl-4">
					<li>{ i18n.T(ctx, "calendar.teams.replace.guests") }</li>
					if data.Series {
						<li>{ i18n.T(ctx, "calendar.teams.replace.series") }</li>
					}
					<li>{ i18n.T(ctx, "calendar.teams.replace.description") }</li>
				</ul>
				<label class="flex items-start gap-2 text-foreground">
					<input type="checkbox" class="mt-0.5" data-calendar-teams-replace-confirm/>
					<span>{ i18n.T(ctx, "calendar.teams.replace.confirm") }</span>
				</label>
			</div>
		}
	}
}
