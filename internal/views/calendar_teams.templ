package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/label"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
	"strconv"
)

templ CalendarTeamsOption(data CalendarTeamsData) {
	{{ available := data.State == "available" || data.State == "available-default" }}
	{{ name := "teams_meeting" }}
	if data.State == "existing" || data.State == "other-online" {
		{{ name = "" }}
	}
	@calendarDialogRow(icon.Video(icon.Props{Class: "size-4"}), "pt-0.5") {
		<div class="flex items-center justify-between gap-3">
			@label.Label(label.Props{For: "calendar-create-teams", Class: "font-normal"}) {
				Teams meeting
			}
			<div class="flex items-center gap-2">
				if data.State == "error" || data.State == "checking" {
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-7", Attributes: templ.Attributes{"data-calendar-teams-retry": "", "hidden": data.State != "error", "aria-label": "Retry Teams availability check", "title": "Retry Teams availability check", "onclick": "retryCalendarTeams(this.closest('[data-calendar-create-form]'))"}}) {
						@icon.RefreshCw(icon.Props{Class: "size-3.5"})
					}
				}
				@switchcomp.Switch(switchcomp.Props{ID: "calendar-create-teams", Name: name, Value: "true", Checked: data.State == "existing", Disabled: !available, Attributes: templ.Attributes{"data-calendar-teams-toggle": "", "data-calendar-teams-available": strconv.FormatBool(available)}})
			</div>
		</div>
	}
}
