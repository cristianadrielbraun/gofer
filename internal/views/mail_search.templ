package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"strings"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/popover"
	"github.com/cristianadrielbraun/gofer/components/tooltip"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

// MailSearchScopeMenu is the start of the search bar: where a search looks.
templ MailSearchScopeMenu(accounts []models.Account, activeFolder string, filters models.EmailFilters) {
	{{ scope := filters.SearchScope }}
	<div class="mail-search-scope flex shrink-0" data-mail-search-controls data-current-folder={ activeFolder }>
		// Choosing in the menu leaves it open; a click outside or Escape closes it.
		@dropdown.Dropdown(dropdown.Props{ID: "mail-search-scope-menu"}) {
			@dropdown.Trigger() {
				// The search bar's left part, in the card color and slightly raised
				// over the sunken field.
				<button type="button" class="mail-search-scope-trigger relative flex h-full items-center gap-1.5 rounded-l-lg border-r border-border/60 bg-card pl-2.5 pr-2 text-xs font-semibold text-foreground shadow-[inset_0_1px_0_rgba(255,255,255,0.35),1px_0_3px_rgba(0,0,0,0.08)] hover:bg-accent focus-visible:bg-accent focus-visible:outline-none" aria-label={ i18n.T(ctx, "mail.search.scope.label", "scope", mailSearchScopeLabel(ctx, accounts, scope)) } data-mail-scope-trigger>
					@mailSearchScopeIcon(scope)
					<span class="mail-search-scope-label max-w-[9rem] truncate">{ mailSearchScopeLabel(ctx, accounts, scope) }</span>
					@icon.ChevronDown(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
				</button>
			}
			@dropdown.Content(dropdown.ContentProps{Class: "mobile-sheet w-64 max-h-none overflow-visible", Attributes: templ.Attributes{"role": "menu", "aria-label": i18n.T(ctx, "mail.search.scope.menu")}}) {
				// The scope choices scroll on their own, so the footer below them
				// always shows.
				<div class="max-h-[min(24rem,70dvh)] overflow-y-auto overflow-x-hidden">
				@mailSearchScopeItem("current", i18n.T(ctx, "mail.search.scope.current"), scope == nil)
				@mailSearchScopeItem("all", i18n.T(ctx, "mail.search.scope.all"), scope != nil && scope.Kind == models.MailSearchAll)
				@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"data-mail-scope-option": "folders"}}) {
					@icon.FolderTree(icon.Props{Class: "size-4 shrink-0 text-muted-foreground"})
					<span class="min-w-0 flex-1 truncate" data-mail-scope-folders-label>
						if scope != nil && scope.Kind == models.MailSearchFolders {
							{ i18n.T(ctx, "mail.search.scope.edit_folders", "folders", mailSearchFolderSelectionLabel(ctx, scope)) }
						} else {
							{ i18n.T(ctx, "mail.search.scope.choose_folders") }
						}
					</span>
				}
				if len(accounts) > 0 {
					@dropdown.Label(dropdown.LabelProps{Class: "px-2 pt-2 pb-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground"}) {
						{ i18n.T(ctx, "settings.section.accounts.title") }
					}
					for _, account := range accounts {
						if !account.Hidden {
							@mailSearchScopeItem("account:"+account.ID, accountTitle(account), scope != nil && scope.Kind == models.MailSearchAccount && scope.AccountID == account.ID)
						}
					}
				}
				</div>
				// The footer: choices that refine any scope, held below the
				// scrolling ones so they needn't be scrolled to.
				@dropdown.Separator()
				// Spam and Trash only matter when the search reaches past one folder.
				@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2 transition-opacity duration-200 ease-out aria-disabled:pointer-events-none aria-disabled:opacity-50 motion-reduce:transition-none", PreventClose: true, Attributes: templ.Attributes{"role": "menuitemcheckbox", "aria-checked": mailSearchBool(scope != nil && scope.ExcludeSpamTrash), "aria-disabled": mailSearchBool(scope == nil), "data-mail-scope-exclude": ""}}) {
					<span class="flex size-4 shrink-0 items-center justify-center rounded-sm border border-input">
						<span class={ mailSearchShown("flex", scope != nil && scope.ExcludeSpamTrash) } data-mail-scope-check>
							@icon.Check(icon.Props{Class: "size-3"})
						</span>
					</span>
					{ i18n.T(ctx, "mail.search.scope.exclude") }
				}
				if disabledLocalFolders(accounts) {
					// Disabled Local folders stay out of every search unless asked for.
					// The choice only applies to All accounts, so it shows only then.
					// It folds open and shut, the menu growing and shrinking with it.
					{{ localShown := scope != nil && scope.Kind == models.MailSearchAll }}
					<div class="grid grid-rows-[1fr] opacity-100 transition-[grid-template-rows,opacity] duration-200 ease-out data-[shown=false]:grid-rows-[0fr] data-[shown=false]:opacity-0 motion-reduce:transition-none" data-shown={ mailSearchBool(localShown) } inert?={ !localShown } data-mail-scope-include-local-row>
					<div class="min-h-0 overflow-hidden">
					@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", PreventClose: true, Attributes: templ.Attributes{"role": "menuitemcheckbox", "aria-checked": mailSearchBool(scope != nil && scope.IncludeLocal), "data-mail-scope-include-local": ""}}) {
						<span class="flex size-4 shrink-0 items-center justify-center rounded-sm border border-input">
							<span class={ mailSearchShown("flex", scope != nil && scope.IncludeLocal) } data-mail-scope-check>
								@icon.Check(icon.Props{Class: "size-3"})
							</span>
						</span>
						<span class="min-w-0 flex-1">{ i18n.T(ctx, "mail.search.scope.include_local") }</span>
						@tooltip.Tooltip() {
							@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
								<span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground" aria-label={ i18n.T(ctx, "mail.search.scope.local_about") }>
									@icon.Info(icon.Props{Class: "size-3.5"})
								</span>
							}
							@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionLeft, ShowArrow: true, Class: "max-w-56 px-3 py-1.5 text-xs"}) {
								{ i18n.T(ctx, "mail.search.scope.local_help") }
							}
						}
					}
					</div>
					</div>
				}
			}
		}
	</div>
}

templ mailSearchScopeItem(value string, label string, checked bool) {
	@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", PreventClose: true, Attributes: templ.Attributes{"role": "menuitemradio", "aria-checked": mailSearchBool(checked), "data-mail-scope-option": value}}) {
		<span class="flex size-4 shrink-0 items-center justify-center">
			<span class={ mailSearchShown("flex", checked) } data-mail-scope-check>
				@icon.Check(icon.Props{Class: "size-3.5"})
			</span>
		</span>
		<span class="min-w-0 flex-1 truncate">{ label }</span>
	}
}

// mailSearchScopeIcon renders every scope's icon and shows the scope's, so
// the page can show a scope chosen before there's anything to search.
templ mailSearchScopeIcon(scope *models.MailSearchScope) {
	{{ kind := mailSearchScopeKind(scope) }}
	<span class={ mailSearchShown("flex shrink-0", kind == "current") } data-mail-scope-icon="current">
		@icon.Folder(icon.Props{Class: "size-3.5 text-muted-foreground"})
	</span>
	<span class={ mailSearchShown("flex shrink-0", kind == "all") } data-mail-scope-icon="all">
		@icon.Layers(icon.Props{Class: "size-3.5 text-muted-foreground"})
	</span>
	<span class={ mailSearchShown("flex shrink-0", kind == "account") } data-mail-scope-icon="account">
		@icon.AtSign(icon.Props{Class: "size-3.5 text-muted-foreground"})
	</span>
	<span class={ mailSearchShown("flex shrink-0", kind == "folders") } data-mail-scope-icon="folders">
		@icon.FolderTree(icon.Props{Class: "size-3.5 text-muted-foreground"})
	</span>
}

// mailSearchCommand is one search command the help lists: what to type, an
// example, and what it finds. Conversations commands only show while mail
// is grouped into conversations.
type mailSearchCommand struct {
	Insert        string
	Example       string
	Meaning       string // a message key
	Conversations bool
}

type mailSearchCommandGroup struct {
	Title    string // a message key
	Commands []mailSearchCommand
}

var mailSearchCommandGroups = []mailSearchCommandGroup{
	{"mail.search.group.people", []mailSearchCommand{
		{Insert: "from:", Example: "from:anna", Meaning: "mail.search.cmd.from"},
		{Insert: "to:", Example: "to:sales@example.com", Meaning: "mail.search.cmd.to"},
		{Insert: "cc:", Example: "cc:anna", Meaning: "mail.search.cmd.cc"},
		{Insert: "bcc:", Example: "bcc:anna", Meaning: "mail.search.cmd.bcc"},
		{Insert: "contact:", Example: "contact:anna", Meaning: "mail.search.cmd.contact"},
		{Insert: "domain:", Example: "domain:example.com", Meaning: "mail.search.cmd.domain"},
		{Insert: "to-domain:", Example: "to-domain:example.com", Meaning: "mail.search.cmd.to_domain"},
	}},
	{"mail.search.group.content", []mailSearchCommand{
		{Insert: "subject:", Example: "subject:invoice", Meaning: "mail.search.cmd.subject"},
		{Insert: "body:", Example: "body:receipt", Meaning: "mail.search.cmd.body"},
		{Insert: "attachment:", Example: "attachment:report.pdf", Meaning: "mail.search.cmd.attachment"},
		{Insert: "filetype:", Example: "filetype:pdf", Meaning: "mail.search.cmd.filetype"},
		{Insert: "tag:", Example: "tag:work", Meaning: "mail.search.cmd.tag"},
	}},
	{"mail.search.group.size", []mailSearchCommand{
		{Insert: "larger:", Example: "larger:5mb", Meaning: "mail.search.cmd.larger"},
		{Insert: "smaller:", Example: "smaller:500kb", Meaning: "mail.search.cmd.smaller"},
	}},
	{"mail.search.group.where", []mailSearchCommand{
		{Insert: "account:", Example: "account:me@example.com", Meaning: "mail.search.cmd.account"},
		{Insert: "after:", Example: "after:2026-10-01", Meaning: "mail.search.cmd.after"},
		{Insert: "before:", Example: "before:2026-10-31", Meaning: "mail.search.cmd.before"},
	}},
	{"mail.search.group.state", []mailSearchCommand{
		{Insert: "is:unread", Example: "is:unread", Meaning: "mail.search.cmd.is_unread"},
		{Insert: "is:read", Example: "is:read", Meaning: "mail.search.cmd.is_read"},
		{Insert: "is:starred", Example: "is:starred", Meaning: "mail.search.cmd.is_starred"},
		{Insert: "has:attachment", Example: "has:attachment", Meaning: "mail.search.cmd.has_attachment"},
		{Insert: "no:attachment", Example: "no:attachment", Meaning: "mail.search.cmd.no_attachment"},
		{Insert: "has:tags", Example: "has:tags", Meaning: "mail.search.cmd.has_tags"},
		{Insert: "no:tags", Example: "no:tags", Meaning: "mail.search.cmd.no_tags"},
		{Insert: "has:thread", Example: "has:thread", Meaning: "mail.search.cmd.has_thread", Conversations: true},
		{Insert: "no:thread", Example: "no:thread", Meaning: "mail.search.cmd.no_thread", Conversations: true},
	}},
}

// MailSearchHelp ends the search bar: the commands a search understands.
// Choosing one types it into the field.
templ MailSearchHelp(conversations bool) {
	@popover.Root(popover.RootProps{ID: "mail-search-help", Class: "flex shrink-0"}) {
		@popover.Trigger(popover.TriggerProps{Class: "flex"}) {
			<button type="button" class="mail-search-help-trigger flex h-full items-center rounded-r-lg px-2.5 text-muted-foreground hover:bg-accent hover:text-foreground focus-visible:bg-accent focus-visible:outline-none" aria-label={ i18n.T(ctx, "mail.search.commands") } data-mail-search-help>
				@icon.CircleQuestionMark(icon.Props{Class: "size-3.5"})
			</button>
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, Offset: 8, Exclusive: true, Class: "mobile-sheet z-[70] w-[min(28rem,calc(100vw-1.5rem))] max-h-[min(32rem,75dvh)] overflow-y-auto p-0", Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "mail.search.commands")}}) {
			<div class="border-b border-border px-4 py-3">
				<h3 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "mail.search.commands") }</h3>
				<p class="mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "mail.search.commands_help") }</p>
			</div>
			// One grid for every row, so all the meanings start in one column.
			<div class="grid grid-cols-[auto_minmax(0,1fr)] gap-y-3 p-2">
				for _, group := range mailSearchCommandGroups {
					<section class="col-span-2 grid grid-cols-subgrid">
						<h4 class="col-span-2 px-2 pb-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, group.Title) }</h4>
						for _, command := range group.Commands {
							if command.Conversations && !conversations {
								continue
							}
							<button type="button" class="col-span-2 grid grid-cols-subgrid items-baseline gap-x-4 rounded-md px-2 py-1.5 text-left hover:bg-accent focus-visible:bg-accent focus-visible:outline-none" data-mail-search-command={ command.Insert }>
								<code class="whitespace-nowrap font-mono text-xs text-foreground">{ command.Example }</code>
								<span class="text-xs text-muted-foreground">{ i18n.T(ctx, command.Meaning) }</span>
							</button>
						}
					</section>
				}
			</div>
		}
	}
}

// MailSearchSuggestions lists the search commands that match what is being
// typed, under the search field. Script shows the matching ones (and values
// for some commands, like file types and accounts) and types the chosen one in.
templ MailSearchSuggestions(conversations bool) {
	@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, Offset: 6, DisableESC: true, Class: "z-[70] max-w-[calc(100vw-1.5rem)] p-1", Attributes: templ.Attributes{"data-mail-search-suggest-content": ""}}) {
		<div id="mail-search-suggestions" role="listbox" aria-label={ i18n.T(ctx, "mail.search.commands") } class="max-h-[min(20rem,50dvh)] overflow-y-auto" data-mail-search-suggestions>
			for _, group := range mailSearchCommandGroups {
				for _, command := range group.Commands {
					if command.Conversations && !conversations {
						continue
					}
					@mailSearchSuggestion(command.Insert, i18n.T(ctx, command.Meaning))
				}
			}
		</div>
	}
}

templ mailSearchSuggestion(insert string, meaning string) {
	<button type="button" role="option" tabindex="-1" aria-selected="false" class="hidden w-full items-baseline gap-3 rounded-md px-2 py-1.5 text-left hover:bg-accent aria-selected:bg-accent [&:not(.hidden)]:flex" data-mail-search-suggestion={ insert }>
		<code class="shrink-0 whitespace-nowrap font-mono text-xs text-foreground">{ insert }</code>
		<span class="min-w-0 truncate text-xs text-muted-foreground">{ meaning }</span>
	</button>
}

// MailSearchControls holds what the scope menu opens: the folder picker.
templ MailSearchControls(accounts []models.Account) {
	{{ accounts = mailAccounts(accounts) }}
	<a href="/mail/search" class="hidden" data-mail-scope-navigation aria-hidden="true" tabindex="-1"></a>
	@dialog.Dialog(dialog.Props{ID: "mail-search-folders-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:flex [&>[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:min-h-0 [&>[data-tui-dialog-panel]]:flex-col [&>[data-tui-dialog-panel]]:gap-0 [&>[data-tui-dialog-panel]]:p-0", Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "mail.search.folders.title")}}) {
			@dialog.Header(dialog.HeaderProps{Class: "shrink-0 px-6 pt-6 pb-4"}) {
				@dialog.Title() {
					{ i18n.T(ctx, "mail.search.folders.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "mail.search.folders.help") }
				}
				<div class="relative">
					@icon.Search(icon.Props{Class: "absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground"})
					<input type="search" placeholder={ i18n.T(ctx, "mail.search.folders.find") } aria-label={ i18n.T(ctx, "mail.search.folders.find") } autocomplete="off" class="h-9 w-full rounded-md border border-input bg-background pl-9 pr-3 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring" data-mail-scope-folder-search/>
				</div>
			}
			<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain border-y border-border" data-mail-scope-folder-list>
				for _, account := range moveTargetAccounts(accounts, "") {
					<section data-mail-scope-account>
						<div class="sticky top-0 z-10 flex items-center gap-2 bg-muted px-6 py-2">
							<div class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(account.Color) }></div>
							<span class="truncate text-xs font-semibold text-foreground">{ accountTitle(account) }</span>
						</div>
						for _, folder := range account.Folders {
							@MailSearchFolderChoice(folder, account.ID, account.Email, "", "", 0)
						}
					</section>
				}
				<p class="hidden px-6 py-4 text-sm text-muted-foreground" data-mail-scope-folder-empty>{ i18n.T(ctx, "mail.search.folders.none") }</p>
			</div>
			@dialog.Footer(dialog.FooterProps{Class: "shrink-0 flex-col items-stretch px-6 py-4 sm:items-center sm:justify-between"}) {
				<div class="min-w-0 space-y-1">
					<label class="flex items-center gap-2 text-sm">
						@checkbox.Checkbox(checkbox.Props{Checked: true, Attributes: templ.Attributes{"data-mail-scope-descendants": ""}})
						{ i18n.T(ctx, "mail.search.folders.descendants") }
					</label>
					<p class="text-xs text-muted-foreground" role="status" data-mail-scope-folder-status>{ i18n.T(ctx, "mail.search.folders.status") }</p>
				</div>
				<div class="flex shrink-0 justify-end gap-2">
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-mail-scope-cancel": ""}}) {
						{ i18n.T(ctx, "common.cancel") }
					}
					@button.Button(button.Props{Disabled: true, Attributes: templ.Attributes{"data-mail-scope-apply": ""}}) {
						{ i18n.T(ctx, "mail.search.folders.apply") }
					}
				</div>
			}
		}
	}
}

// MailSearchFolderChoice is one folder in the picker. Its account and parent
// also tell an open search which folders' sync events reach it.
templ MailSearchFolderChoice(folder models.Folder, accountID string, accountEmail string, parent string, parentID string, depth int) {
	{{ path := folder.Name; if parent != "" { path = parent + " / " + folder.Name } }}
	<label class="flex cursor-pointer items-center gap-2.5 py-1.5 pr-6 hover:bg-accent/50" style={ mailSearchFolderIndent(depth) } title={ path } data-mail-scope-folder-row data-search-text={ strings.ToLower(accountEmail + " " + path) }>
		@checkbox.Checkbox(checkbox.Props{Value: folder.ID, Attributes: templ.Attributes{"data-mail-scope-folder": "", "data-account-id": accountID, "data-parent-id": parentID}})
		@icon.Folder(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
		<span class="min-w-0 text-sm">
			<span class="block truncate">{ folder.Name }</span>
			if parent != "" {
				<span class="block truncate text-[11px] text-muted-foreground">{ parent }</span>
			}
		</span>
	</label>
	for _, child := range folder.Children {
		@MailSearchFolderChoice(child, accountID, accountEmail, path, folder.ID, depth+1)
	}
}
