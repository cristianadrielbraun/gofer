package views

import (
	"strings"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/popover"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

// MailSearchScopeMenu is the start of the search bar: where a search looks.
templ MailSearchScopeMenu(accounts []models.Account, activeFolder string, filters models.EmailFilters) {
	{{ scope := filters.SearchScope }}
	<div class="mail-search-scope flex shrink-0" data-mail-search-controls data-current-folder={ activeFolder }>
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				<button type="button" class="mail-search-scope-trigger flex h-full items-center gap-1.5 rounded-l-lg border-r border-border/60 pl-2.5 pr-2 text-xs font-semibold text-foreground hover:bg-accent focus-visible:bg-accent focus-visible:outline-none" aria-label={ "Search in: " + mailSearchScopeLabel(accounts, scope) } data-mail-scope-trigger>
					@mailSearchScopeIcon(scope)
					<span class="mail-search-scope-label max-w-[9rem] truncate">{ mailSearchScopeLabel(accounts, scope) }</span>
					@icon.ChevronDown(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
				</button>
			}
			@dropdown.Content(dropdown.ContentProps{Class: "mobile-sheet w-64 max-h-[min(24rem,70dvh)]", Attributes: templ.Attributes{"role": "menu", "aria-label": "Search in"}}) {
				@mailSearchScopeItem("current", "This folder", scope == nil)
				@mailSearchScopeItem("all", "All accounts", scope != nil && scope.Kind == models.MailSearchAll)
				if len(accounts) > 0 {
					@dropdown.Label(dropdown.LabelProps{Class: "px-2 pt-2 pb-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground"}) {
						Accounts
					}
					for _, account := range accounts {
						@mailSearchScopeItem("account:"+account.ID, account.Email, scope != nil && scope.Kind == models.MailSearchAccount && scope.AccountID == account.ID)
					}
				}
				@dropdown.Separator()
				@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"data-mail-scope-option": "folders"}}) {
					@icon.FolderTree(icon.Props{Class: "size-4 shrink-0 text-muted-foreground"})
					<span class="min-w-0 flex-1 truncate">
						if scope != nil && scope.Kind == models.MailSearchFolders {
							Edit folders ({ mailSearchFolderSelectionLabel(scope) })
						} else {
							Choose folders…
						}
					</span>
				}
				@dropdown.Separator()
				// Spam and Trash only matter when the search reaches past one folder.
				@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Disabled: scope == nil, Attributes: templ.Attributes{"role": "menuitemcheckbox", "aria-checked": mailSearchBool(scope != nil && scope.ExcludeSpamTrash), "data-mail-scope-exclude": ""}}) {
					<span class="flex size-4 shrink-0 items-center justify-center rounded-sm border border-input">
						if scope != nil && scope.ExcludeSpamTrash {
							@icon.Check(icon.Props{Class: "size-3"})
						}
					</span>
					Leave out Spam and Trash
				}
			}
		}
	</div>
}

templ mailSearchScopeItem(value string, label string, checked bool) {
	@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"role": "menuitemradio", "aria-checked": mailSearchBool(checked), "data-mail-scope-option": value}}) {
		<span class="flex size-4 shrink-0 items-center justify-center">
			if checked {
				@icon.Check(icon.Props{Class: "size-3.5"})
			}
		</span>
		<span class="min-w-0 flex-1 truncate">{ label }</span>
	}
}

templ mailSearchScopeIcon(scope *models.MailSearchScope) {
	if scope == nil {
		@icon.Folder(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
	} else if scope.Kind == models.MailSearchAll {
		@icon.Layers(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
	} else if scope.Kind == models.MailSearchAccount {
		@icon.AtSign(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
	} else {
		@icon.FolderTree(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
	}
}

// mailSearchCommand is one search command the help lists: what to type, an
// example, and what it finds. Conversations commands only show while mail
// is grouped into conversations.
type mailSearchCommand struct {
	Insert        string
	Example       string
	Meaning       string
	Conversations bool
}

type mailSearchCommandGroup struct {
	Title    string
	Commands []mailSearchCommand
}

var mailSearchCommandGroups = []mailSearchCommandGroup{
	{"People", []mailSearchCommand{
		{Insert: "from:", Example: "from:anna", Meaning: "Sender's name or address"},
		{Insert: "to:", Example: "to:sales@example.com", Meaning: "A recipient in To"},
		{Insert: "cc:", Example: "cc:anna", Meaning: "A recipient in Cc"},
		{Insert: "bcc:", Example: "bcc:anna", Meaning: "A recipient in Bcc"},
		{Insert: "contact:", Example: "contact:anna", Meaning: "Mail to or from a contact"},
		{Insert: "domain:", Example: "domain:example.com", Meaning: "Sender's domain"},
		{Insert: "to-domain:", Example: "to-domain:example.com", Meaning: "A recipient's domain"},
	}},
	{"Content", []mailSearchCommand{
		{Insert: "subject:", Example: "subject:invoice", Meaning: "Words in the subject"},
		{Insert: "body:", Example: "body:receipt", Meaning: "Words in the message"},
		{Insert: "attachment:", Example: "attachment:report.pdf", Meaning: "An attachment's file name"},
		{Insert: "filetype:", Example: "filetype:pdf", Meaning: "pdf, image, document, spreadsheet, presentation, archive, audio, video, or any extension"},
		{Insert: "tag:", Example: "tag:work", Meaning: "A tag or label"},
	}},
	{"Size", []mailSearchCommand{
		{Insert: "larger:", Example: "larger:5mb", Meaning: "At least this size; MB unless it says KB or GB"},
		{Insert: "smaller:", Example: "smaller:500kb", Meaning: "At most this size"},
	}},
	{"Where and when", []mailSearchCommand{
		{Insert: "account:", Example: "account:me@example.com", Meaning: "One of your accounts"},
		{Insert: "after:", Example: "after:2026-10-01", Meaning: "On or after a date"},
		{Insert: "before:", Example: "before:2026-10-31", Meaning: "On or before a date"},
	}},
	{"State", []mailSearchCommand{
		{Insert: "is:unread", Example: "is:unread", Meaning: "Unread"},
		{Insert: "is:read", Example: "is:read", Meaning: "Read"},
		{Insert: "is:starred", Example: "is:starred", Meaning: "Starred"},
		{Insert: "has:attachment", Example: "has:attachment", Meaning: "With attachments"},
		{Insert: "no:attachment", Example: "no:attachment", Meaning: "Without attachments"},
		{Insert: "has:tags", Example: "has:tags", Meaning: "With any tag or label"},
		{Insert: "no:tags", Example: "no:tags", Meaning: "Without tags or labels"},
		{Insert: "has:thread", Example: "has:thread", Meaning: "In a conversation", Conversations: true},
		{Insert: "no:thread", Example: "no:thread", Meaning: "Not in a conversation", Conversations: true},
	}},
}

// MailSearchHelp ends the search bar: the commands a search understands.
// Choosing one types it into the field.
templ MailSearchHelp(conversations bool) {
	@popover.Root(popover.RootProps{ID: "mail-search-help", Class: "flex shrink-0"}) {
		@popover.Trigger(popover.TriggerProps{Class: "flex"}) {
			<button type="button" class="mail-search-help-trigger flex h-full items-center rounded-r-lg px-2.5 text-muted-foreground hover:bg-accent hover:text-foreground focus-visible:bg-accent focus-visible:outline-none" aria-label="Search commands" data-mail-search-help>
				@icon.CircleQuestionMark(icon.Props{Class: "size-3.5"})
			</button>
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, Offset: 8, Exclusive: true, Class: "mobile-sheet z-[70] w-[min(28rem,calc(100vw-1.5rem))] max-h-[min(32rem,75dvh)] overflow-y-auto p-0", Attributes: templ.Attributes{"aria-label": "Search commands"}}) {
			<div class="border-b border-border px-4 py-3">
				<h3 class="text-sm font-semibold text-foreground">Search commands</h3>
				<p class="mt-0.5 text-xs text-muted-foreground">Type them in the search, then press Enter. Put values with spaces in quotes.</p>
			</div>
			// One grid for every row, so all the meanings start in one column.
			<div class="grid grid-cols-[auto_minmax(0,1fr)] gap-y-3 p-2">
				for _, group := range mailSearchCommandGroups {
					<section class="col-span-2 grid grid-cols-subgrid">
						<h4 class="col-span-2 px-2 pb-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ group.Title }</h4>
						for _, command := range group.Commands {
							if command.Conversations && !conversations {
								continue
							}
							<button type="button" class="col-span-2 grid grid-cols-subgrid items-baseline gap-x-4 rounded-md px-2 py-1.5 text-left hover:bg-accent focus-visible:bg-accent focus-visible:outline-none" data-mail-search-command={ command.Insert }>
								<code class="whitespace-nowrap font-mono text-xs text-foreground">{ command.Example }</code>
								<span class="text-xs text-muted-foreground">{ command.Meaning }</span>
							</button>
						}
					</section>
				}
			</div>
		}
	}
}

// MailSearchControls holds what the scope menu opens: the folder picker.
templ MailSearchControls(accounts []models.Account) {
	<a href="/mail/search" class="hidden" data-mail-scope-navigation aria-hidden="true" tabindex="-1"></a>
	@dialog.Dialog(dialog.Props{ID: "mail-search-folders-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:flex [&>[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:min-h-0 [&>[data-tui-dialog-panel]]:flex-col [&>[data-tui-dialog-panel]]:gap-0 [&>[data-tui-dialog-panel]]:p-0", Attributes: templ.Attributes{"aria-label": "Choose folders to search"}}) {
			@dialog.Header(dialog.HeaderProps{Class: "shrink-0 px-6 pt-6 pb-4"}) {
				@dialog.Title() {
					Choose folders to search
				}
				@dialog.Description() {
					Pick folders from any of your accounts.
				}
				<div class="relative">
					@icon.Search(icon.Props{Class: "absolute left-3 top-1/2 -translate-y-1/2 size-4 text-muted-foreground"})
					<input type="search" placeholder="Find a folder or account" aria-label="Find a folder or account" autocomplete="off" class="h-9 w-full rounded-md border border-input bg-background pl-9 pr-3 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring" data-mail-scope-folder-search/>
				</div>
			}
			<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain border-y border-border" data-mail-scope-folder-list>
				for _, account := range accounts {
					<section data-mail-scope-account>
						<div class="sticky top-0 z-10 flex items-center gap-2 bg-muted px-6 py-2">
							<div class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle(account.Color) }></div>
							<span class="truncate text-xs font-semibold text-foreground">{ account.Email }</span>
						</div>
						for _, folder := range account.Folders {
							@MailSearchFolderChoice(folder, account.Email, "", 0)
						}
					</section>
				}
				<p class="hidden px-6 py-4 text-sm text-muted-foreground" data-mail-scope-folder-empty>No matching folders.</p>
			</div>
			@dialog.Footer(dialog.FooterProps{Class: "shrink-0 flex-col items-stretch px-6 py-4 sm:items-center sm:justify-between"}) {
				<div class="min-w-0 space-y-1">
					<label class="flex items-center gap-2 text-sm">
						@checkbox.Checkbox(checkbox.Props{Checked: true, Attributes: templ.Attributes{"data-mail-scope-descendants": ""}})
						Include subfolders
					</label>
					<p class="text-xs text-muted-foreground" role="status" data-mail-scope-folder-status>Select up to 200 folders. Only locally synced mail is searched.</p>
				</div>
				<div class="flex shrink-0 justify-end gap-2">
					@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"data-mail-scope-cancel": ""}}) {
						Cancel
					}
					@button.Button(button.Props{Disabled: true, Attributes: templ.Attributes{"data-mail-scope-apply": ""}}) {
						Search selected folders
					}
				</div>
			}
		}
	}
}

templ MailSearchFolderChoice(folder models.Folder, accountEmail string, parent string, depth int) {
	{{ path := folder.Name; if parent != "" { path = parent + " / " + folder.Name } }}
	<label class="flex cursor-pointer items-center gap-2.5 py-1.5 pr-6 hover:bg-accent/50" style={ mailSearchFolderIndent(depth) } title={ path } data-mail-scope-folder-row data-search-text={ strings.ToLower(accountEmail + " " + path) }>
		@checkbox.Checkbox(checkbox.Props{Value: folder.ID, Attributes: templ.Attributes{"data-mail-scope-folder": ""}})
		@icon.Folder(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
		<span class="min-w-0 text-sm">
			<span class="block truncate">{ folder.Name }</span>
			if parent != "" {
				<span class="block truncate text-[11px] text-muted-foreground">{ parent }</span>
			}
		</span>
	</label>
	for _, child := range folder.Children {
		@MailSearchFolderChoice(child, accountEmail, path, depth+1)
	}
}
