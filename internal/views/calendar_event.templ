package views

import (
	"time"
	"strconv"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/popover"
)

templ CalendarEventDialog(details CalendarEventDetails, location *time.Location) {
	{{
		event := details.Event
		split := details.Description != "" || len(details.Attendees) > 0
		dialogClass := "w-[calc(100vw_-_2rem)] max-w-[calc(100vw_-_2rem)] max-h-[calc(100dvh-2rem)] sm:max-w-xl md:max-h-[min(44rem,calc(100dvh-4rem))] [&_[data-tui-dialog-panel]]:flex [&_[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] md:[&_[data-tui-dialog-panel]]:max-h-[min(44rem,calc(100dvh-4rem))] [&_[data-tui-dialog-panel]]:min-h-0 [&_[data-tui-dialog-panel]]:flex-col [&_[data-tui-dialog-panel]]:gap-0 [&_[data-tui-dialog-panel]]:p-0"
		if split { dialogClass += " md:max-w-5xl" }
	}}
	@dialog.Dialog(dialog.Props{ID: "calendar-event-details-dialog"}) {
		@dialog.Content(dialog.ContentProps{
			HideCloseButton: true,
			Class: dialogClass,
			Attributes: templ.Attributes{"id": "calendar-event-details-content", "aria-labelledby": "calendar-event-details-title"},
		}) {
			<header class="flex shrink-0 items-start justify-between gap-4 border-b border-border px-5 py-4 md:px-6">
				<div class="min-w-0 flex-1">
					<p class="text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">Event details</p>
					@dialog.Title(dialog.TitleProps{ID: "calendar-event-details-title", Class: "mt-1.5 break-words text-xl font-semibold leading-snug"}) {
						{ calendarEventSummary(event) }
					}
					if event.SourceName != "" {
						<p class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
							<span class="size-2 shrink-0 rounded-full" style={ calendarEventColorStyle(event) }></span>
							<span class="break-words">{ event.SourceName }</span>
						</p>
					}
				</div>
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-8 text-muted-foreground", Attributes: templ.Attributes{"data-tui-dialog-close": "", "aria-label": "Close event details"}}) {
					@icon.X(icon.Props{Class: "size-4"})
				}
			</header>
			<div class="min-h-0 overflow-y-auto md:flex md:flex-col md:overflow-hidden" data-calendar-event-details-body>
				<div class={ "grid min-h-0 gap-5 px-5 py-5 md:grid-rows-[minmax(0,1fr)] md:overflow-hidden md:px-6", templ.KV("md:grid-cols-2 md:gap-0 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]", split) } data-calendar-event-columns>
					<div class={ "min-h-0 min-w-0 space-y-5 [overflow-wrap:anywhere] md:overflow-y-auto md:overscroll-contain", templ.KV("md:pr-6", split) } role="region" aria-label="Event information" tabindex="0" data-calendar-event-overview>
						<dl class="space-y-4 text-sm">
							<div class="flex items-start gap-3">
								@icon.Clock3(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-muted-foreground"})
								<div class="min-w-0">
									<dt class="sr-only">When</dt>
									<dd class="font-semibold">{ calendarEventDetailsDate(event, location) }</dd>
									<dd class="mt-1 text-muted-foreground">{ calendarEventAgendaTimeLabel(event, location) }</dd>
									if timezone := calendarEventDetailsTimeZone(event, location); timezone != "" {
										<dd class="mt-1 text-xs text-muted-foreground">{ timezone }</dd>
									}
								</div>
							</div>
							if event.Location != "" {
								<div class="flex items-start gap-3">
									@icon.MapPin(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-muted-foreground"})
									<div class="min-w-0">
										<dt class="text-xs font-semibold text-muted-foreground">Location</dt>
										<dd class="mt-1 whitespace-pre-wrap break-words">{ event.Location }</dd>
									</div>
								</div>
							}
							if calendarParticipantName(details.Organizer) != "" {
								<div class="flex items-start gap-3">
									@icon.User(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-muted-foreground"})
									<div class="min-w-0">
										<dt class="text-xs font-semibold text-muted-foreground">Organizer</dt>
										<dd class="mt-1">
											@CalendarParticipantIdentity(details.Organizer)
										</dd>
									</div>
								</div>
							}
						</dl>
						if details.Description != "" && len(details.Attendees) > 0 {
							@CalendarEventGuests(details.Attendees, "border-t border-border pt-4")
						}
					</div>
					if details.Description != "" {
						<section class="min-h-0 min-w-0 border-t border-border pt-4 md:flex md:flex-col md:border-t-0 md:border-l md:pt-0 md:pl-6" aria-labelledby="calendar-event-description-heading">
							<h3 id="calendar-event-description-heading" class="shrink-0 text-xs font-semibold text-muted-foreground">Description</h3>
							<div class="mt-3 min-h-0 md:overflow-y-auto md:overscroll-contain" role="region" aria-labelledby="calendar-event-description-heading" tabindex="0" data-calendar-event-description-scroll>
								<p class="whitespace-pre-wrap text-sm leading-relaxed [overflow-wrap:anywhere]">{ details.Description }</p>
							</div>
						</section>
					} else if len(details.Attendees) > 0 {
						@CalendarEventGuests(details.Attendees, "min-h-0 min-w-0 border-t border-border pt-4 md:overflow-y-auto md:overscroll-contain md:border-t-0 md:border-l md:pt-0 md:pl-6")
					}
				</div>
				if details.Response != nil {
					<div id="calendar-event-response" class="shrink-0 px-5 pb-4 md:max-h-[40dvh] md:overflow-y-auto md:px-6" data-calendar-response-root>
						@CalendarResponseForm(*details.Response)
					</div>
				}
			</div>
			<footer class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-t border-border px-5 py-3 md:px-6">
				if details.CanEdit {
					<p class="text-[11px] text-muted-foreground">Cached event</p>
				} else {
					<div class="text-[11px] text-muted-foreground">
						<p>
							if details.Response != nil {
								Meeting details are read-only · Cached event
							} else {
								Read-only · Cached event
							}
						</p>
						<p data-calendar-edit-unavailable>
							if details.EditUnavailableReason != "" {
								{ details.EditUnavailableReason }
							} else {
								Editing is unavailable for this event.
							}
						</p>
					</div>
				}
				<div class="ml-auto flex shrink-0 items-center gap-2">
					if details.CanDelete {
						{{
							deleteAttrs := templ.Attributes{"data-calendar-delete-trigger": "", "aria-haspopup": "dialog", "aria-controls": "calendar-event-delete-confirmation-content"}
							if details.DeleteSeries && !details.HasOccurrence {
								deleteAttrs["data-calendar-delete-load"] = ""
								deleteAttrs["hx-get"] = calendarEventDetailsURL(event.ID) + "/delete-series-confirmation"
								deleteAttrs["hx-target"] = "#calendar-event-delete-confirmation-body"
								deleteAttrs["hx-swap"] = "innerHTML"
								deleteAttrs["hx-sync"] = "closest [data-tui-popover-root]:replace"
							}
						}}
						@popover.Root(popover.RootProps{ID: "calendar-event-delete-confirmation"}) {
							@popover.Trigger() {
								@button.Button(button.Props{Variant: button.VariantGhost, Class: "font-semibold text-destructive hover:text-destructive", Attributes: deleteAttrs}) {
									@icon.Trash2(icon.Props{Class: "size-4"})
									if details.DeleteSeries && !details.HasOccurrence {
										Delete series
									} else {
										Delete
									}
								}
							}
							@popover.Content(popover.ContentProps{ID: "calendar-event-delete-confirmation-content", Placement: popover.PlacementTopEnd, Class: "w-80 p-4", Attributes: templ.Attributes{"role": "dialog", "aria-labelledby": "calendar-event-delete-title", "aria-describedby": "calendar-event-delete-description"}}) {
								<div id="calendar-event-delete-confirmation-body">
									{{ confirmation := details }}
									if details.HasOccurrence {
										{{ confirmation.DeleteSeries, confirmation.DeleteOccurrence = false, true }}
									}
									@CalendarEventDeleteConfirmation(confirmation)
								</div>
							}
						}
					}
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "font-semibold", Attributes: templ.Attributes{"data-tui-dialog-close": ""}}) {
						Close
					}
					if details.CanEdit {
						if details.HasOccurrence {
							@popover.Root() {
								@popover.Trigger() {
									@button.Button(button.Props{Class: "btn-skeuo font-semibold", Attributes: templ.Attributes{"data-calendar-edit-trigger": ""}}) {
										Edit
										@icon.ChevronDown(icon.Props{Class: "size-3.5"})
									}
								}
								@popover.Content(popover.ContentProps{Placement: popover.PlacementTopEnd, Class: "w-48 p-1"}) {
									@CalendarEventEditAction(details, "This event", "occurrence", true)
									@CalendarEventEditAction(details, "Entire series", "series", true)
								}
							}
						} else if details.EditSeries {
							@CalendarEventEditAction(details, "Edit series", "series", false)
						} else {
							@CalendarEventEditAction(details, "Edit", "", false)
							}
					}
				</div>
			</footer>
		}
	}
}

templ CalendarEventGuests(attendees []CalendarEventParticipant, class string) {
	<section class={ class } aria-labelledby="calendar-event-guests-heading" tabindex="0">
		<h3 id="calendar-event-guests-heading" class="text-xs font-semibold text-muted-foreground">Guests ({ len(attendees) })</h3>
		<ul class="mt-3 space-y-3">
			for _, person := range attendees {
				<li class="flex items-start justify-between gap-3 text-sm [overflow-wrap:anywhere]">
					<div class="min-w-0">
						@CalendarParticipantIdentity(person)
						if person.Optional {
							<p class="mt-0.5 text-[11px] text-muted-foreground">Optional</p>
						}
					</div>
					<span class={ calendarParticipantResponseClass(person) }>{ calendarParticipantResponse(person) }</span>
				</li>
			}
		</ul>
	</section>
}

templ CalendarEventEditAction(details CalendarEventDetails, text, scope string, menu bool) {
	{{
		endpoint := calendarEventDetailsURL(details.Event.ID) + "/edit"
		if scope != "" { endpoint += "?scope=" + scope }
		variant, class := button.VariantDefault, "btn-skeuo font-semibold"
		if menu { variant, class = button.VariantGhost, "w-full justify-start font-medium" }
	}}
	@button.Button(button.Props{Variant: variant, Class: class, Attributes: templ.Attributes{
		"data-calendar-create-trigger": "", "data-calendar-edit-trigger": "",
		"hx-get": endpoint, "hx-target": "#app-pane-dialogs", "hx-swap": "innerHTML",
		"hx-sync": "#app-pane-dialogs:replace", "hx-disabled-elt": "this",
		"aria-haspopup": "dialog", "aria-controls": "calendar-create-dialog",
	}}) {
		{ text }
	}
}

templ CalendarEventDeleteConfirmation(details CalendarEventDetails) {
	{{
		params, title, submitLabel := "version", "Delete this event?", "Delete event"
		ready := details.DeleteVersion != ""
		if details.DeleteSeries {
			params, title, submitLabel = "version,scope,series_id", "Delete the entire series?", "Delete series"
		} else if details.DeleteOccurrence {
			params, title = "version,scope", "Delete this occurrence?"
		}
	}}
	<form data-calendar-delete-form data-calendar-event-id={ details.Event.ID } data-calendar-delete-series={ strconv.FormatBool(details.DeleteSeries) } data-calendar-delete-occurrence={ strconv.FormatBool(details.DeleteOccurrence) } data-calendar-delete-series-id={ details.DeleteSeriesID } data-calendar-delete-ready={ strconv.FormatBool(ready) } hx-delete={ calendarEventDetailsURL(details.Event.ID) } hx-params={ params } hx-swap="none" hx-sync="this:drop">
		if details.HasOccurrence {
			<div class="mb-3 grid grid-cols-2 gap-2" role="group" aria-label="Delete scope">
				for _, scope := range []string{"occurrence", "series"} {
					{{
						selected := (scope == "series") == details.DeleteSeries
						class := ""
						if selected { class = "bg-accent text-accent-foreground" }
					}}
					@button.Button(button.Props{Type: button.TypeButton, Variant: button.VariantOutline, Size: button.SizeSm, Class: class, Attributes: templ.Attributes{
						"aria-pressed": strconv.FormatBool(selected), "data-calendar-delete-load": "",
						"hx-get": calendarEventDetailsURL(details.Event.ID) + "/delete-" + scope + "-confirmation",
						"hx-target": "#calendar-event-delete-confirmation-body", "hx-swap": "innerHTML",
						"hx-sync": "closest [data-tui-popover-root]:replace",
					}}) {
						if scope == "series" {
							Entire series
						} else {
							This event
						}
					}
				}
			</div>
		}
		<input type="hidden" name="version" value={ details.DeleteVersion }/>
		if details.DeleteSeries {
			<input type="hidden" name="scope" value="series"/>
			<input type="hidden" name="series_id" value={ details.DeleteSeriesID }/>
		} else if details.DeleteOccurrence {
			<input type="hidden" name="scope" value="occurrence"/>
		}
		<h3 id="calendar-event-delete-title" class="font-semibold">{ title }</h3>
		<p class="mt-2 break-words text-sm font-medium">{ calendarEventSummary(details.Event) }</p>
		<p id="calendar-event-delete-description" class="mt-2 text-xs leading-relaxed text-muted-foreground">
			if details.DeleteSeries {
				This deletes all occurrences, including past and future events, from your calendar provider—not just Gofer. You can’t undo this in Gofer.
			} else if details.DeleteOccurrence {
				Only this occurrence will be removed from your calendar provider. The rest of the series stays unchanged. You can’t undo this in Gofer.
			} else {
				This deletes the event from your calendar provider, not just Gofer. You can’t undo this in Gofer.
			}
		</p>
		<p data-calendar-delete-check hidden?={ ready } role="status" class="mt-3 flex items-center gap-2 text-xs text-muted-foreground">
			@icon.LoaderCircle(icon.Props{Class: "size-3 animate-spin"})
			Checking the selection…
		</p>
		<p data-calendar-delete-error hidden role="alert" tabindex="-1" class="mt-3 text-xs leading-relaxed text-destructive"></p>
		<div class="mt-4 flex justify-end gap-2">
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Attributes: templ.Attributes{"data-calendar-delete-cancel": ""}}) {
				Cancel
			}
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive, Size: button.SizeSm, Disabled: !ready, Attributes: templ.Attributes{"data-calendar-delete-submit": ""}}) {
				<span data-calendar-delete-spinner hidden>
					@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})
				</span>
				<span data-calendar-delete-label aria-live="polite">{ submitLabel }</span>
			}
		</div>
	</form>
}

templ CalendarParticipantIdentity(person CalendarEventParticipant) {
	<p class="break-words font-medium">{ calendarParticipantName(person) }</p>
	if person.Name != "" && person.Email != "" && person.Name != person.Email {
		<p class="mt-0.5 break-all text-xs text-muted-foreground">{ person.Email }</p>
	}
}
