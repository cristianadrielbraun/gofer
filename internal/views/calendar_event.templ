package views

import (
	"time"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
)

templ CalendarEventDialog(details CalendarEventDetails, location *time.Location) {
	{{ event := details.Event }}
	@dialog.Dialog(dialog.Props{ID: "calendar-event-details-dialog"}) {
		@dialog.Content(dialog.ContentProps{
			HideCloseButton: true,
			Class: "w-[calc(100vw_-_2rem)] max-w-[calc(100vw_-_2rem)] max-h-[calc(100dvh-2rem)] sm:max-w-xl [&_[data-tui-dialog-panel]]:flex [&_[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] [&_[data-tui-dialog-panel]]:min-h-0 [&_[data-tui-dialog-panel]]:flex-col [&_[data-tui-dialog-panel]]:gap-0 [&_[data-tui-dialog-panel]]:p-0",
			Attributes: templ.Attributes{"id": "calendar-event-details-content", "aria-labelledby": "calendar-event-details-title"},
		}) {
			<header class="flex shrink-0 items-start justify-between gap-4 border-b border-border px-5 py-4">
				<div class="min-w-0 flex-1">
					<p class="text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">Event details</p>
					@dialog.Title(dialog.TitleProps{ID: "calendar-event-details-title", Class: "mt-1.5 break-words text-xl font-semibold leading-snug"}) {
						{ calendarEventSummary(event) }
					}
					if event.SourceName != "" {
						<p class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
							<span class="size-2 shrink-0 rounded-full" style={ calendarEventColorStyle(event) }></span>
							<span class="break-words">{ event.SourceName }</span>
						</p>
					}
				</div>
				<button type="button" data-tui-dialog-close class="flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label="Close event details">
					@icon.X(icon.Props{Class: "size-4"})
				</button>
			</header>
			<div class="min-h-0 space-y-5 overflow-y-auto px-5 py-5" data-calendar-event-details-body>
				<dl class="space-y-4 text-sm">
					<div class="flex items-start gap-3">
						@icon.Clock3(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-muted-foreground"})
						<div class="min-w-0">
							<dt class="sr-only">When</dt>
							<dd class="font-semibold">{ calendarEventDetailsDate(event, location) }</dd>
							<dd class="mt-1 text-muted-foreground">{ calendarEventAgendaTimeLabel(event, location) }</dd>
							if timezone := calendarEventDetailsTimeZone(event, location); timezone != "" {
								<dd class="mt-1 text-xs text-muted-foreground">{ timezone }</dd>
							}
						</div>
					</div>
					if event.Location != "" {
						<div class="flex items-start gap-3">
							@icon.MapPin(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-muted-foreground"})
							<div class="min-w-0">
								<dt class="text-xs font-semibold text-muted-foreground">Location</dt>
								<dd class="mt-1 whitespace-pre-wrap break-words">{ event.Location }</dd>
							</div>
						</div>
					}
					if calendarParticipantName(details.Organizer) != "" {
						<div class="flex items-start gap-3">
							@icon.User(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-muted-foreground"})
							<div class="min-w-0">
								<dt class="text-xs font-semibold text-muted-foreground">Organizer</dt>
								<dd class="mt-1">
									@CalendarParticipantIdentity(details.Organizer)
								</dd>
							</div>
						</div>
					}
				</dl>
				if details.Description != "" {
					<section class="border-t border-border pt-4" aria-labelledby="calendar-event-description-heading">
						<h3 id="calendar-event-description-heading" class="text-xs font-semibold text-muted-foreground">Description</h3>
						<p class="mt-2 whitespace-pre-wrap break-words text-sm leading-relaxed">{ details.Description }</p>
					</section>
				}
				if len(details.Attendees) > 0 {
					<section class="border-t border-border pt-4" aria-labelledby="calendar-event-guests-heading">
						<h3 id="calendar-event-guests-heading" class="text-xs font-semibold text-muted-foreground">Guests ({ len(details.Attendees) })</h3>
						<ul class="mt-3 space-y-3">
							for _, person := range details.Attendees {
								<li class="flex items-start justify-between gap-3 text-sm">
									<div class="min-w-0">
										@CalendarParticipantIdentity(person)
										if person.Optional {
											<p class="mt-0.5 text-[11px] text-muted-foreground">Optional</p>
										}
									</div>
									<span class={ calendarParticipantResponseClass(person) }>{ calendarParticipantResponse(person) }</span>
								</li>
							}
						</ul>
					</section>
				}
			</div>
			<footer class="flex shrink-0 items-center justify-between gap-3 border-t border-border px-5 py-3">
				<p class="text-[11px] text-muted-foreground">Read-only · Cached event</p>
				<button type="button" data-tui-dialog-close class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Close</button>
			</footer>
		}
	}
}

templ CalendarParticipantIdentity(person CalendarEventParticipant) {
	<p class="break-words font-medium">{ calendarParticipantName(person) }</p>
	if person.Name != "" && person.Email != "" && person.Name != person.Email {
		<p class="mt-0.5 break-all text-xs text-muted-foreground">{ person.Email }</p>
	}
}
