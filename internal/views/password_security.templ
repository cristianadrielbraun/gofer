package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"context"
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"fmt"
	"strings"

	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/tooltip"
	"github.com/cristianadrielbraun/gofer/internal/models"
	"github.com/cristianadrielbraun/gofer/utils"
)

type TOTPManagementData struct {
	QRCodeDataURL string
	ManualKey     string
	Algorithm     string
	Digits        int
	Period        int
	IsReplacement bool
}

type PasskeySecurityData struct {
	ID           string
	Name         string
	Details      string
	CreatedAt    string
	LastUsedAt   string
	CanRemove    bool
	RemoveReason string
}

type FederatedIdentityData struct {
	ID           string
	Provider     string
	Email        string
	LinkedAt     string
	LastUsedAt   string
	CanUnlink    bool
	UnlinkReason string
	UnlinkPath   string
}

type SecuritySessionData struct {
	Client         string
	Authentication string
	Assurance      string
	SignedInAt     string
	LastActiveAt   string
	EndedAt        string
	RevokePath     string
	Current        bool
	Active         bool
}

type SecurityEventData struct {
	Title      string
	Detail     string
	OccurredAt string
	Client     string
	Status     string
	Successful bool
}

type SecurityActivityPageData struct {
	Events       []SecurityEventData
	TotalEvents  int64
	Page         int64
	TotalPages   int64
	FirstEvent   int64
	LastEvent    int64
	PreviousPage int64
	NextPage     int64
	HasPrevious  bool
	HasNext      bool
}

type PasswordSecurityData struct {
	LoginUsername              string
	HasPassword                bool
	HasTOTP                    bool
	HasPasskey                 bool
	RequiresMFA                bool
	Passkeys                   []PasskeySecurityData
	FederatedIdentities        []FederatedIdentityData
	Sessions                   []SecuritySessionData
	SessionsTruncated          bool
	CanRevokeOtherSessions     bool
	SecurityEventCount         int64
	GoogleLoginAvailable       bool
	MicrosoftLoginAvailable    bool
	OIDCLoginAvailable         bool
	OIDCLoginName              string
	RecoveryCodesRemaining     int
	StepUpFresh                bool
	CanDisableTOTP             bool
	DisableTOTPReason          string
	TOTPManagement             *TOTPManagementData
	RecoveryReplacementPending bool
	RecoveryBatchID            string
	RecoveryCodes              []string
	Message                    string
	MessageIsError             bool
	CSRFToken                  string
	CSRFTokens                 map[string]string
	// MailSecurity is set in personal mode, where the owner has no admin area
	// and manages mail security exceptions here instead.
	MailSecurity *models.MailSecurityAdminData
	// OwnProxies is set on a managed installation whose administrator lets
	// people add proxies for their own accounts.
	OwnProxies *models.MailSecurityAdminData
}

type PasswordSecurityVerificationData struct {
	HasTOTP        bool
	HasPasskey     bool
	Message        string
	MessageIsError bool
	CSRFTokens     map[string]string
}

func passwordSecurityMessageRole(isError bool) string {
	if isError {
		return "alert"
	}
	return "status"
}

func localLoginIdentifierDisplay(ctx context.Context, value string) string {
	if strings.TrimSpace(value) == "" {
		return i18n.T(ctx, "security.username.not_set")
	}
	return value
}

func securityEventCountLabel(ctx context.Context, count int64) string {
	return i18n.N(ctx, "security.events.count", int(count), "count", i18n.Number(ctx, int(count)))
}

func securityActivityPagePath(page int64) string {
	return fmt.Sprintf("/settings/security/activity?page=%d", page)
}

// totpManagementText is the message key+".replace" while an authenticator
// is replaced, key+".new" while the first one is set up.
func totpManagementText(ctx context.Context, key string, isReplacement bool) string {
	if isReplacement {
		return i18n.T(ctx, key+".replace")
	}
	return i18n.T(ctx, key+".new")
}

func federatedIdentityProviderLabel(provider, oidcName string) string {
	if provider == "microsoft" {
		return "Microsoft"
	}
	if provider == "google" {
		return "Google"
	}
	if oidcName != "" {
		return oidcName
	}
	return "OpenID Connect"
}

func federatedIdentityDisplay(ctx context.Context, identity FederatedIdentityData, oidcName string) string {
	if identity.Email != "" {
		return identity.Email
	}
	return i18n.T(ctx, "security.identity_of", "provider", federatedIdentityProviderLabel(identity.Provider, oidcName))
}

templ PasswordSecurityVerificationLayout(uiSettings map[string]string, data PasswordSecurityVerificationData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class={ themeClass(uiSettings) } data-theme={ themeStyle(uiSettings) } { themeLookAttributes(uiSettings)... }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "page.title", "page", i18n.T(ctx, "security.page_title")) }</title>
			@AppIcon()
			@SavedPanelSizeStyle()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			@ThemeColorsStyle(uiSettings)
			@SettingsComponentScripts()
			@AppSidebarResponsiveStyle()
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk" data-ui-settings={ uiSettingsJSON(uiSettings) }>
			<div id="app-shell" class="app-shell flex h-screen overflow-hidden">
				@MobileTopBar()
				@SettingsSidebar("security", uiSettingGet(uiSettings, "sidebar_width", "256px"))
				@ResizeHandle("sidebar")
				@PasswordSecurityVerificationPartial(data)
			</div>
			@CalendarLoadingTemplates(nil, uiSettings)
			@AppSwitchEmptyPaneTemplates()
			@AppNavigationTemplates(uiSettings)
			<div id="app-pane-dialogs"></div>
			@SettingsRuntime(nil)
			@AppNavigationScripts()
			@AppDialogs()
		</body>
	</html>
}

templ PasswordSecurityVerificationPartial(data PasswordSecurityVerificationData) {
	<div id="main-content" class="flex flex-1 min-h-0 min-w-0 overflow-hidden">
		<div class="flex-1 flex flex-col min-h-0 min-w-0 overflow-hidden" data-settings-page>
			<div class="flex-1 min-h-0 overflow-y-auto overscroll-contain">
				<div id="settings-content" class="max-w-3xl px-8 pt-10 pb-6">
					@SettingsSectionHeader("security")
					@PasswordSecurityVerification(data)
				</div>
			</div>
		</div>
	</div>
}

templ PasswordSecurityVerification(data PasswordSecurityVerificationData) {
	<div class="mt-6 space-y-6" data-password-security-verification>
		if data.Message != "" {
			<div
				role={ passwordSecurityMessageRole(data.MessageIsError) }
				class={
					"rounded-md border px-4 py-3 text-sm",
					templ.KV("border-destructive/30 bg-destructive/10 text-destructive", data.MessageIsError),
					templ.KV("border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200", !data.MessageIsError),
				}
			>
				{ data.Message }
			</div>
		}
		<div class="rounded-lg border border-amber-500/30 bg-amber-500/5 p-6" data-security-step-up>
			<div class="mb-5">
				<h3 class="text-base font-semibold text-foreground">{ i18n.T(ctx, "security.verify.title") }</h3>
				<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "security.verify.description") }</p>
			</div>
			if data.HasTOTP || data.HasPasskey {
				<div
					class={
						templ.Classes(
							"grid gap-5",
							templ.KV("md:grid-cols-2", data.HasPasskey && data.HasTOTP),
							templ.KV("max-w-sm", !data.HasPasskey || !data.HasTOTP),
						),
					}
				>
					if data.HasPasskey {
						<form
							data-passkey-authentication
							data-start-path="/settings/security/passkeys/step-up/start"
							data-finish-path="/settings/security/passkeys/step-up/finish"
							data-start-csrf={ data.CSRFTokens["/settings/security/passkeys/step-up/start"] }
							data-finish-csrf={ data.CSRFTokens["/settings/security/passkeys/step-up/finish"] }
							data-fallback={ i18n.T(ctx, "security.verify.fallback") }
							class="space-y-3 rounded-md border border-border bg-background/60 p-4"
						>
							<p class="text-sm font-medium text-foreground">{ i18n.T(ctx, "security.passkey") }</p>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.verify.passkey_detail") }</p>
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60">{ i18n.T(ctx, "security.verify.passkey_button") }</button>
							<p data-passkey-authentication-status role="status" aria-live="polite" class="text-xs text-muted-foreground"></p>
						</form>
					}
					if data.HasTOTP {
						<form method="post" action="/settings/security/step-up" autocomplete="on" class="space-y-4 rounded-md border border-border bg-background/60 p-4">
							if data.CSRFTokens["/settings/security/step-up"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/step-up"] }/>
							}
							<div class="space-y-1.5">
								<label for="security-totp-code" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "security.verify.code") }</label>
								<input
									id="security-totp-code"
									autofocus
									aria-label={ i18n.T(ctx, "security.verify.code") }
									name="code"
									type="text"
									inputmode="numeric"
									autocomplete="one-time-code"
									pattern="[0-9]{6}"
									minlength="6"
									maxlength="6"
									required
									class="h-10 w-full rounded-md border border-input bg-background px-3 font-mono text-sm tracking-[0.25em] text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
								/>
							</div>
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground shadow-sm transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">{ i18n.T(ctx, "security.verify.code_button") }</button>
						</form>
					}
				</div>
			} else {
				<div class="space-y-4">
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "security.verify.sign_in_again_note") }</p>
					<form method="post" action="/auth/logout" class="flex justify-end">
						if data.CSRFTokens["/auth/logout"] != "" {
							<input type="hidden" name="_csrf" value={ data.CSRFTokens["/auth/logout"] }/>
						}
						<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">{ i18n.T(ctx, "security.sign_in_again") }</button>
					</form>
				</div>
			}
		</div>
	</div>
}

templ PasswordSecurityLayout(uiSettings map[string]string, data PasswordSecurityData) {
	@SecuritySettingsLayout(uiSettings, PasswordSecurityPartial(data))
}

templ OpenSecurityLayout(uiSettings map[string]string, data models.MailSecurityAdminData) {
	@SecuritySettingsLayout(uiSettings, OpenSecurityPartial(data))
}

templ SecuritySettingsLayout(uiSettings map[string]string, partial templ.Component) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class={ themeClass(uiSettings) } data-theme={ themeStyle(uiSettings) } { themeLookAttributes(uiSettings)... }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "page.title", "page", i18n.T(ctx, "security.page_title")) }</title>
			@AppIcon()
			@SavedPanelSizeStyle()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			@ThemeColorsStyle(uiSettings)
			@SettingsComponentScripts()
			@AppSidebarResponsiveStyle()
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk" data-ui-settings={ uiSettingsJSON(uiSettings) }>
			<div id="app-shell" class="app-shell flex h-screen overflow-hidden">
				@MobileTopBar()
				@SettingsSidebar("security", uiSettingGet(uiSettings, "sidebar_width", "256px"))
				@ResizeHandle("sidebar")
				@partial
			</div>
			@CalendarLoadingTemplates(nil, uiSettings)
			@AppSwitchEmptyPaneTemplates()
			@AppNavigationTemplates(uiSettings)
			<div id="app-pane-dialogs"></div>
			@SettingsRuntime(nil)
			@AppNavigationScripts()
			@AppDialogs()
		</body>
	</html>
}

templ PasswordSecurityPartial(data PasswordSecurityData) {
	@securitySettingsContent("security", PasswordSecuritySettings(data))
}

templ OpenSecurityPartial(data models.MailSecurityAdminData) {
	@securitySettingsContent("security-open", OpenSecuritySettings(data))
}

templ securitySettingsContent(section string, settings templ.Component) {
	<div id="main-content" class="flex flex-1 min-h-0 min-w-0 overflow-hidden">
		<div class="flex-1 flex flex-col min-h-0 min-w-0 overflow-hidden" data-settings-page>
			<div class="flex-1 min-h-0 overflow-y-auto overscroll-contain">
				<div id="settings-content" class="max-w-3xl px-8 pt-10 pb-6">
					@SettingsSectionHeader(section)
					@settings
				</div>
			</div>
		</div>
	</div>
}

templ PasswordSecuritySettings(data PasswordSecurityData) {
	<div class="mt-6 space-y-6" data-password-security-settings>
		if data.Message != "" {
			<div
				role={ passwordSecurityMessageRole(data.MessageIsError) }
				class={
					"rounded-md border px-4 py-3 text-sm",
					templ.KV("border-destructive/30 bg-destructive/10 text-destructive", data.MessageIsError),
					templ.KV("border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200", !data.MessageIsError),
				}
			>
				{ data.Message }
			</div>
		}
		<div class="settings-card rounded-lg border bg-card p-6" data-local-login-identifiers>
			<div class="mb-5">
				<h3 class="text-base font-semibold text-foreground">{ i18n.T(ctx, "security.local.title") }</h3>
				<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "security.local.description") }</p>
			</div>
			<dl aria-label={ i18n.T(ctx, "security.local.identifier") }>
				<div class="settings-item rounded-lg border border-border/60 bg-background/40 px-4 py-3">
					<dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "identities.username") }</dt>
					<dd class="mt-1 break-all text-sm font-semibold text-foreground" data-local-login-username>{ localLoginIdentifierDisplay(ctx, data.LoginUsername) }</dd>
				</div>
			</dl>
			<p class="mt-3 text-xs text-muted-foreground">{ i18n.T(ctx, "security.local.note") }</p>
		</div>
		<div class="settings-card rounded-lg border bg-card p-6" data-password-settings>
			@securityCardHeader(i18n.T(ctx, "identities.password"), passwordStatusLabel(ctx, data.HasPassword), passwordDescription(ctx, data.HasPassword), data.HasPassword) {
				if data.HasPassword && (!data.RequiresMFA || data.StepUpFresh) {
					@dialog.Trigger(dialog.TriggerProps{For: "security-password-change"}) {
						<button type="button" class={ securityCardActionClass }>{ i18n.T(ctx, "security.password.change") }</button>
					}
					@dialog.Dialog(dialog.Props{ID: "security-password-change"}) {
						@dialog.Content() {
							@dialog.Header() {
								@dialog.Title() {
									{ i18n.T(ctx, "security.password.change") }
								}
								@dialog.Description() {
									{ i18n.T(ctx, "security.password.change_description") }
								}
							}
							<form method="post" action="/settings/security/password" class="space-y-4">
								if data.CSRFToken != "" {
									<input type="hidden" name="_csrf" value={ data.CSRFToken }/>
								}
								<div class="space-y-1.5">
									<label for="current-password" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "security.password.current") }</label>
									<input
										id="current-password"
										name="current_password"
										type="password"
										autocomplete="current-password"
										required
										class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
									/>
								</div>
								<div class="space-y-1.5">
									<label for="new-password" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "security.password.new") }</label>
									<input
										id="new-password"
										name="new_password"
										type="password"
										autocomplete="new-password"
										minlength="15"
										maxlength="256"
										required
										aria-describedby="new-password-help"
										class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
									/>
									<p id="new-password-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.password.help") }</p>
								</div>
								<div class="space-y-1.5">
									<label for="confirm-password" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "security.password.confirm") }</label>
									<input
										id="confirm-password"
										name="confirm_password"
										type="password"
										autocomplete="new-password"
										minlength="15"
										maxlength="256"
										required
										class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
									/>
								</div>
								@dialog.Footer() {
									@dialog.Close() {
										<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-sm font-semibold text-foreground transition-colors hover:bg-accent">{ i18n.T(ctx, "common.cancel") }</button>
									}
									<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-3 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">{ i18n.T(ctx, "security.password.change") }</button>
								}
							</form>
						}
					}
				}
			}
			if data.HasPassword && data.RequiresMFA && !data.StepUpFresh {
				@securityVerifyNote(i18n.T(ctx, "security.password.verify_note"))
			}
		</div>
		<div class="settings-card rounded-lg border bg-card p-6" data-passkey-security-settings>
			@securityCardHeader(i18n.T(ctx, "security.passkeys.title"), passkeyStatusLabel(ctx, len(data.Passkeys)), i18n.T(ctx, "security.passkeys.description"), len(data.Passkeys) > 0) {
				if data.StepUpFresh {
					@dialog.Trigger(dialog.TriggerProps{For: "security-passkey-add"}) {
						<button type="button" class={ securityCardActionClass }>{ i18n.T(ctx, "security.passkeys.add") }</button>
					}
					@dialog.Dialog(dialog.Props{ID: "security-passkey-add"}) {
						@dialog.Content() {
							@dialog.Header() {
								@dialog.Title() {
									{ i18n.T(ctx, "security.passkeys.add") }
								}
								@dialog.Description() {
									{ i18n.T(ctx, "security.passkeys.add_description") }
								}
							}
							<form
								data-passkey-registration
								data-start-path="/settings/security/passkeys/start"
								data-finish-path="/settings/security/passkeys/finish"
								data-start-csrf={ data.CSRFTokens["/settings/security/passkeys/start"] }
								data-finish-csrf={ data.CSRFTokens["/settings/security/passkeys/finish"] }
								class="space-y-4"
							>
								<div class="space-y-1.5">
									<label for="passkey-name" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "security.passkeys.name") }</label>
									<input id="passkey-name" name="name" type="text" autocomplete="off" maxlength="64" required placeholder={ i18n.T(ctx, "security.passkeys.name_placeholder") } class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"/>
								</div>
								<p data-passkey-status role="status" aria-live="polite" class="text-xs text-muted-foreground empty:hidden"></p>
								<noscript><p class="text-xs text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "security.passkeys.noscript") }</p></noscript>
								@dialog.Footer() {
									@dialog.Close() {
										<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-sm font-semibold text-foreground transition-colors hover:bg-accent">{ i18n.T(ctx, "common.cancel") }</button>
									}
									<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-3 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60">{ i18n.T(ctx, "security.passkeys.add") }</button>
								}
							</form>
						}
					}
				}
			}
			if len(data.Passkeys) > 0 {
				<ul class="mt-5 settings-item divide-y divide-border/60 rounded-lg border border-border/60 bg-background/40" aria-label={ i18n.T(ctx, "security.passkeys.registered") }>
					for index, passkey := range data.Passkeys {
						<li class="flex flex-wrap items-center justify-between gap-4 px-4 py-3">
							<div class="min-w-0">
								<p class="truncate text-sm font-semibold text-foreground">{ passkey.Name }</p>
								<p class="mt-1 text-xs text-muted-foreground">
									{ i18n.T(ctx, "security.passkeys.details", "details", passkey.Details, "date", passkey.CreatedAt) }
									if passkey.LastUsedAt != "" {
										<span>{ i18n.T(ctx, "security.last_used", "date", passkey.LastUsedAt) }</span>
									}
								</p>
							</div>
							if data.StepUpFresh && passkey.CanRemove {
								@securityActionConfirmationDialog(fmt.Sprintf("security-passkey-remove-%d", index), "/settings/security/passkeys/"+passkey.ID+"/remove", data.CSRFTokens["/settings/security/passkeys/"+passkey.ID+"/remove"], i18n.T(ctx, "security.passkeys.remove"), i18n.T(ctx, "security.passkeys.remove_confirm", "name", passkey.Name))
							} else if !passkey.CanRemove && passkey.RemoveReason != "" {
								@securityUnavailableAction(fmt.Sprintf("security-passkey-blocked-%d", index), i18n.T(ctx, "security.passkeys.remove"), passkey.RemoveReason)
							}
						</li>
					}
				</ul>
			}
			if !data.StepUpFresh {
				@securityVerifyNote(i18n.T(ctx, "security.passkeys.verify_note"))
			}
		</div>
		<div class="settings-card rounded-lg border bg-card p-6" data-federated-identity-settings>
			@securityCardHeader(i18n.T(ctx, "security.apps.title"), applicationSignInStatusLabel(ctx, len(data.FederatedIdentities)), i18n.T(ctx, "security.apps.description"), len(data.FederatedIdentities) > 0) {
				if data.OIDCLoginAvailable && data.StepUpFresh {
					<form method="post" action="/settings/security/identities/oidc/link">
						if data.CSRFTokens["/settings/security/identities/oidc/link"] != "" {
							<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/identities/oidc/link"] }/>
						}
						<button type="submit" class={ securityCardActionClass }>{ i18n.T(ctx, "security.apps.connect_named", "name", data.OIDCLoginName) }</button>
					</form>
				}
			}
			<ul class="mt-5 settings-item divide-y divide-border/60 rounded-lg border border-border/60 bg-background/40" aria-label={ i18n.T(ctx, "security.apps.providers") }>
				@applicationSignInProviderRow(data, "google", "Google", "gmail", data.GoogleLoginAvailable)
				@applicationSignInProviderRow(data, "microsoft", "Microsoft", "outlook", data.MicrosoftLoginAvailable)
			</ul>
			if len(signInProviderIdentities(data.FederatedIdentities, "oidc")) > 0 {
				<ul class="mt-3 settings-item divide-y divide-border/60 rounded-lg border border-border/60 bg-background/40" aria-label={ i18n.T(ctx, "security.apps.connected_identities") }>
					for _, identity := range signInProviderIdentities(data.FederatedIdentities, "oidc") {
						<li class="flex flex-wrap items-center justify-between gap-4 px-4 py-3">
							<div class="min-w-0">
								<p class="truncate text-sm font-semibold text-foreground">{ federatedIdentityDisplay(ctx, identity, data.OIDCLoginName) }</p>
								<p class="mt-1 text-xs text-muted-foreground">
									{ i18n.T(ctx, "security.apps.connected_on", "provider", federatedIdentityProviderLabel(identity.Provider, data.OIDCLoginName), "date", identity.LinkedAt) }
									if identity.LastUsedAt != "" {
										<span>{ i18n.T(ctx, "security.last_used", "date", identity.LastUsedAt) }</span>
									}
								</p>
							</div>
							<div class="flex max-w-64 flex-col items-end gap-2 text-right">
								<span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-200">{ i18n.T(ctx, "security.apps.connected") }</span>
								if data.StepUpFresh && identity.CanUnlink && identity.UnlinkPath != "" {
									<form method="post" action={ templ.URL(identity.UnlinkPath) } data-confirm-action={ i18n.T(ctx, "security.apps.disconnect") } data-confirm-destructive data-confirm={ i18n.T(ctx, "security.apps.disconnect_confirm") }>
										if data.CSRFTokens[identity.UnlinkPath] != "" {
											<input type="hidden" name="_csrf" value={ data.CSRFTokens[identity.UnlinkPath] }/>
										}
										<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-destructive/40 bg-background px-3 text-xs font-semibold text-destructive hover:bg-destructive/10">{ i18n.T(ctx, "security.apps.disconnect") }</button>
									</form>
								} else if !identity.CanUnlink && identity.UnlinkReason != "" {
									<p class="text-xs text-muted-foreground">{ identity.UnlinkReason }</p>
								} else if !data.StepUpFresh && identity.UnlinkPath != "" {
									<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.apps.verify_disconnect") }</p>
								}
							</div>
						</li>
					}
				</ul>
			}
			if !data.StepUpFresh && (data.GoogleLoginAvailable || data.MicrosoftLoginAvailable || data.OIDCLoginAvailable) {
				@securityVerifyNote(i18n.T(ctx, "security.apps.verify_note"))
			}
			if !data.GoogleLoginAvailable && !data.MicrosoftLoginAvailable && !data.OIDCLoginAvailable {
				<p class="mt-3 text-xs text-muted-foreground">{ i18n.T(ctx, "security.apps.not_configured") }</p>
			}
			<div class="mt-3">
				@tooltip.Tooltip(tooltip.Props{ID: "application-sign-in-scope"}) {
					@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
						<button type="button" class="inline-flex items-center gap-1.5 rounded-sm text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" aria-label={ i18n.T(ctx, "security.apps.learn") }>
							<span>{ i18n.T(ctx, "security.apps.only_sign_in") }</span>
							@icon.Info(icon.Props{Class: "size-3.5 shrink-0"})
						</button>
					}
					@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "w-80 px-3 py-2 text-left text-xs leading-relaxed"}) {
						{ i18n.T(ctx, "security.apps.scope") }
					}
				}
			</div>
		</div>
		<div class="settings-card rounded-lg border bg-card p-6" data-totp-security-settings>
			@securityCardHeader(i18n.T(ctx, "security.totp.title"), twoFactorStatusLabel(ctx, data.HasTOTP), twoFactorDescription(ctx, data.HasTOTP), data.HasTOTP) {
				if data.TOTPManagement == nil && data.StepUpFresh {
					<form method="post" action="/settings/security/totp/start">
						if data.CSRFTokens["/settings/security/totp/start"] != "" {
							<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/totp/start"] }/>
						}
						if data.HasTOTP {
							<button type="submit" class={ securityCardActionClass }>{ i18n.T(ctx, "security.totp.submit.replace") }</button>
						} else {
							<button type="submit" class={ securityCardActionClass }>{ i18n.T(ctx, "security.totp.set_up") }</button>
						}
					</form>
					if data.HasTOTP && data.CanDisableTOTP {
						@securityActionConfirmationDialog("security-totp-disable", "/settings/security/totp/disable", data.CSRFTokens["/settings/security/totp/disable"], i18n.T(ctx, "security.totp.turn_off"), i18n.T(ctx, "security.totp.turn_off_confirm"))
					} else if data.HasTOTP && data.DisableTOTPReason != "" {
						@securityUnavailableAction("security-totp-blocked", i18n.T(ctx, "security.totp.turn_off"), data.DisableTOTPReason)
					}
				}
			}
			if data.TOTPManagement != nil {
				<div class="mt-5 rounded-lg border border-primary/25 bg-primary/5 p-5" data-totp-management>
					<h4 class="text-sm font-semibold text-foreground">{ totpManagementText(ctx, "security.totp.verify_title", data.TOTPManagement.IsReplacement) }</h4>
					<p class="mt-1 text-xs text-muted-foreground">{ totpManagementText(ctx, "security.totp.verify_description", data.TOTPManagement.IsReplacement) }</p>
					<div class="mt-5 grid gap-5 sm:grid-cols-[auto_1fr] sm:items-center">
						<div class="rounded-lg bg-white p-3">
							<img src={ data.TOTPManagement.QRCodeDataURL } alt={ totpManagementText(ctx, "security.totp.qr_alt", data.TOTPManagement.IsReplacement) } width="176" height="176" class="h-44 w-44"/>
						</div>
						<div class="space-y-3">
							<div>
								<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "security.totp.manual_key") }</p>
								<code class="mt-1.5 block break-all rounded-md border border-border bg-background px-3 py-2 font-mono text-xs" aria-label={ totpManagementText(ctx, "security.totp.manual_key_label", data.TOTPManagement.IsReplacement) }>{ data.TOTPManagement.ManualKey }</code>
							</div>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.totp.parameters", "algorithm", data.TOTPManagement.Algorithm, "digits", data.TOTPManagement.Digits, "period", data.TOTPManagement.Period) }</p>
						</div>
					</div>
					<form method="post" action="/settings/security/totp/confirm" class="mt-5 space-y-4">
						if data.CSRFTokens["/settings/security/totp/confirm"] != "" {
							<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/totp/confirm"] }/>
						}
						<div class="max-w-sm space-y-1.5">
							<label for="managed-totp-code" class="text-sm font-medium text-foreground">{ totpManagementText(ctx, "security.totp.code_label", data.TOTPManagement.IsReplacement) }</label>
							<input id="managed-totp-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required class="h-10 w-full rounded-md border border-input bg-background px-3 font-mono text-sm tracking-[0.25em] text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"/>
						</div>
						<div class="flex justify-end"><button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">{ totpManagementText(ctx, "security.totp.submit", data.TOTPManagement.IsReplacement) }</button></div>
					</form>
					<div class="mt-3 flex flex-wrap justify-end gap-2">
						<form method="post" action="/settings/security/totp/start">
							if data.CSRFTokens["/settings/security/totp/start"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/totp/start"] }/>
							}
							<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent">{ i18n.T(ctx, "security.start_over") }</button>
						</form>
						@SecurityManagementCancelForm(data)
					</div>
				</div>
			} else if !data.StepUpFresh {
				@securityVerifyNote(i18n.T(ctx, "security.totp.verify_note"))
			}
		</div>
		<div class="settings-card rounded-lg border bg-card p-6" data-recovery-code-security-settings>
			<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
				<div>
					<h3 class="text-base font-semibold text-foreground">{ i18n.T(ctx, "security.recovery.title") }</h3>
					<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "security.recovery.description") }</p>
				</div>
				<span class="rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "security.recovery.remaining", "count", data.RecoveryCodesRemaining) }</span>
			</div>
			if data.RecoveryReplacementPending {
				<div class="rounded-lg border border-primary/25 bg-primary/5 p-5" data-recovery-code-replacement>
					<h4 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "security.recovery.save_title") }</h4>
					if len(data.RecoveryCodes) > 0 {
						<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "security.recovery.shown_once") }</p>
						<ol class="mt-4 grid gap-2 sm:grid-cols-2" aria-label={ i18n.T(ctx, "security.recovery.new_codes") }>
							for _, code := range data.RecoveryCodes {
								<li><code class="block rounded-md border border-border bg-background px-3 py-2 text-center font-mono text-sm tracking-wide">{ code }</code></li>
							}
						</ol>
					} else {
						<p class="mt-1 text-xs text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "security.recovery.already_shown") }</p>
					}
					<form method="post" action="/settings/security/recovery/complete" class="mt-5 space-y-4">
						if data.CSRFTokens["/settings/security/recovery/complete"] != "" {
							<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/recovery/complete"] }/>
						}
						<input type="hidden" name="batch_id" value={ data.RecoveryBatchID }/>
						<label class="flex items-start gap-2 text-sm text-foreground">
							<input type="checkbox" name="saved" value="yes" required class="mt-0.5 h-4 w-4 rounded border-input"/>
							<span>{ i18n.T(ctx, "security.recovery.saved_check") }</span>
						</label>
						<div class="flex justify-end"><button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90">{ i18n.T(ctx, "security.recovery.replace") }</button></div>
					</form>
					<div class="mt-3 flex flex-wrap justify-end gap-2">
						<form method="post" action="/settings/security/recovery/start">
							if data.CSRFTokens["/settings/security/recovery/start"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/recovery/start"] }/>
							}
							<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent">{ i18n.T(ctx, "security.recovery.different_batch") }</button>
						</form>
						@SecurityManagementCancelForm(data)
					</div>
				</div>
			} else if data.HasTOTP {
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "security.recovery.generate_note") }</p>
				if data.StepUpFresh {
					<div class="mt-4 flex flex-wrap justify-end gap-2">
						<form method="post" action="/settings/security/recovery/start">
							if data.CSRFTokens["/settings/security/recovery/start"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/recovery/start"] }/>
							}
							<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90">{ i18n.T(ctx, "security.recovery.generate") }</button>
						</form>
						if data.RecoveryCodesRemaining > 0 {
							<form method="post" action="/settings/security/recovery/revoke" data-confirm-action={ i18n.T(ctx, "security.recovery.revoke_action") } data-confirm-destructive data-confirm={ i18n.T(ctx, "security.recovery.revoke_confirm") }>
								if data.CSRFTokens["/settings/security/recovery/revoke"] != "" {
									<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/recovery/revoke"] }/>
								}
								<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md border border-destructive/40 bg-background px-4 text-sm font-semibold text-destructive hover:bg-destructive/10">{ i18n.T(ctx, "security.recovery.revoke") }</button>
							</form>
						}
					</div>
				} else {
					<p class="mt-3 text-xs font-medium text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "security.recovery.verify_note") }</p>
				}
			} else {
				<div class="settings-item rounded-lg border border-border/60 bg-background/40 px-4 py-3 text-sm text-muted-foreground">{ i18n.T(ctx, "security.recovery.unavailable") }</div>
			}
		</div>
		<div class="settings-card rounded-lg border bg-card p-6" data-security-sessions>
			<div class="mb-5 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
				<div class="min-w-0">
					<h3 class="text-base font-semibold text-foreground">{ i18n.T(ctx, "security.sessions.title") }</h3>
					<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "security.sessions.description") }</p>
				</div>
				if data.CanRevokeOtherSessions {
					@securityActionConfirmationDialog("security-sessions-revoke-others", "/settings/security/sessions/revoke-others", data.CSRFTokens["/settings/security/sessions/revoke-others"], i18n.T(ctx, "security.sessions.revoke_others"), i18n.T(ctx, "security.sessions.revoke_others_confirm"))
				}
			</div>
			if len(data.Sessions) > 0 {
				@securitySessionRows(data.Sessions, data.CSRFTokens, "security")
				if data.SessionsTruncated {
					<div class="mt-4 flex justify-end">
						@dialog.Trigger(dialog.TriggerProps{For: "security-session-history-dialog"}) {
							<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-sm font-semibold text-foreground hover:bg-accent" hx-get="/settings/security/sessions/history?page=2" hx-target="#security-session-history-body" hx-swap="innerHTML">{ i18n.T(ctx, "security.sessions.show_older") }</button>
						}
					</div>
					@dialog.Dialog(dialog.Props{ID: "security-session-history-dialog"}) {
						@dialog.Content(dialog.ContentProps{Class: "sm:max-w-3xl max-h-[calc(100vh-2rem)]"}) {
							@dialog.Header() {
								@dialog.Title() {
									{ i18n.T(ctx, "security.sessions.older") }
								}
								@dialog.Description() {
									{ i18n.T(ctx, "security.sessions.older_description") }
								}
							}
							<div id="security-session-history-body" aria-live="polite">
								<p class="py-6 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "security.sessions.loading_older") }</p>
							</div>
						}
					}
				}
			} else {
				<div class="settings-item rounded-lg border border-border/60 bg-background/40 px-4 py-3 text-sm text-muted-foreground">{ i18n.T(ctx, "security.sessions.none") }</div>
			}
			<p class="mt-3 text-xs text-muted-foreground">{ i18n.T(ctx, "security.sessions.retention") }</p>
		</div>
		<div class="settings-card rounded-lg border bg-card p-6" data-security-events>
			<div class="flex items-start justify-between gap-4">
				<div class="min-w-0">
					<h3 class="text-base font-semibold text-foreground">{ i18n.T(ctx, "security.activity.title") }</h3>
					<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "security.activity.description") }</p>
				</div>
				<span class="shrink-0 rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{ securityEventCountLabel(ctx, data.SecurityEventCount) }</span>
			</div>
			<div class="mt-4 flex justify-end">
				@dialog.Trigger(dialog.TriggerProps{For: "security-activity-dialog"}) {
					<button
						type="button"
						class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-sm font-semibold text-foreground transition-colors hover:bg-accent"
						hx-get="/settings/security/activity?page=1"
						hx-target="#security-activity-dialog-body"
						hx-swap="innerHTML"
					>
						{ i18n.T(ctx, "security.activity.view") }
					</button>
				}
			</div>
			@dialog.Dialog(dialog.Props{ID: "security-activity-dialog"}) {
				@dialog.Content(dialog.ContentProps{Class: "sm:max-w-3xl max-h-[calc(100vh-2rem)]"}) {
					@dialog.Header() {
						@dialog.Title() {
							{ i18n.T(ctx, "security.activity.title") }
						}
						@dialog.Description() {
							{ i18n.T(ctx, "security.activity.dialog_description") }
						}
					}
					<div id="security-activity-dialog-body" class="min-h-24" aria-live="polite">
						<div class="flex min-h-24 items-center justify-center text-sm text-muted-foreground">{ i18n.T(ctx, "security.activity.loading") }</div>
					</div>
				}
			}
		</div>
		if data.MailSecurity != nil {
			@MailSecuritySettingsCard(*data.MailSecurity)
		}
		if data.OwnProxies != nil {
			@OwnProxiesSettingsCard(*data.OwnProxies)
		}
	</div>
}

// OwnProxiesSettingsCard is where a person keeps the proxies they added for
// their own accounts.
templ OwnProxiesSettingsCard(data models.MailSecurityAdminData) {
	<div class="settings-card rounded-lg border bg-card p-6" data-own-proxies>
		if data.Notice != "" {
			<div role="status" class="mb-4 rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm font-medium text-emerald-800 dark:text-emerald-200">{ data.Notice }</div>
		}
		if data.Error != "" {
			<div role="alert" class="mb-4 rounded-lg border border-red-500/25 bg-red-500/10 px-4 py-3 text-sm font-medium text-red-800 dark:text-red-200">{ data.Error }</div>
		}
		@OutboundProxiesPanel(data)
	</div>
}

// MailSecuritySettingsCard is where the owner approves mail security
// exceptions in personal and open mode.
templ MailSecuritySettingsCard(data models.MailSecurityAdminData) {
	<div id="mail-security" class="settings-card rounded-lg border bg-card p-6" data-mail-security>
		<h3 class="text-base font-semibold text-foreground">{ i18n.T(ctx, "security.mail.title") }</h3>
		<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "security.mail.description") }</p>
		if data.Notice != "" {
			<div role="status" class="mt-4 rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm font-medium text-emerald-800 dark:text-emerald-200">{ data.Notice }</div>
		}
		if data.Error != "" {
			<div role="alert" class="mt-4 rounded-lg border border-red-500/25 bg-red-500/10 px-4 py-3 text-sm font-medium text-red-800 dark:text-red-200">{ data.Error }</div>
		}
		<div class="mt-5">
			@MailSecurityExceptionsPanel(data)
		</div>
		<div class="mt-5">
			@OutboundProxiesPanel(data)
		</div>
	</div>
}

// OpenSecuritySettings is the Security tab when Gofer runs without sign-in:
// there are no sign-in methods or sessions, only mail security.
templ OpenSecuritySettings(data models.MailSecurityAdminData) {
	<div class="mt-6 space-y-6" data-open-security-settings>
		@MailSecuritySettingsCard(data)
	</div>
}

templ SecurityActivityDialogPage(data SecurityActivityPageData) {
	<div class="space-y-4" data-security-activity-page>
		if len(data.Events) > 0 {
			<div class="max-h-[min(32rem,calc(100vh-14rem))] overflow-y-auto settings-item rounded-lg border border-border/60 bg-background/40">
				<ul class="divide-y divide-border" aria-label={ i18n.T(ctx, "security.activity.events") }>
					for _, event := range data.Events {
						<li class="grid gap-3 px-4 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
							<div class="min-w-0">
								<p class="break-words text-sm font-semibold text-foreground">{ event.Title }</p>
								<p class="mt-1 text-xs text-muted-foreground">{ event.Detail }</p>
								<p class="mt-2 text-xs text-muted-foreground">
									{ event.OccurredAt }
									if event.Client != "" {
										<span aria-hidden="true">· </span><span>{ i18n.T(ctx, "security.activity.from", "client", event.Client) }</span>
									}
								</p>
							</div>
							if event.Successful {
								<span class="w-fit rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-200">{ event.Status }</span>
							} else {
								<span class="w-fit rounded-full border border-destructive/30 bg-destructive/10 px-2.5 py-1 text-xs font-semibold text-destructive">{ event.Status }</span>
							}
						</li>
					}
				</ul>
			</div>
			<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.activity.showing", "first", i18n.Number(ctx, int(data.FirstEvent)), "last", i18n.Number(ctx, int(data.LastEvent)), "total", i18n.Number(ctx, int(data.TotalEvents))) }</p>
				<div class="flex items-center gap-2">
					if data.HasPrevious {
						<button type="button" class="inline-flex h-8 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent" hx-get={ securityActivityPagePath(data.PreviousPage) } hx-target="#security-activity-dialog-body" hx-swap="innerHTML">{ i18n.T(ctx, "security.previous") }</button>
					} else {
						<button type="button" class="inline-flex h-8 items-center justify-center rounded-md border border-border bg-muted px-3 text-xs font-semibold text-muted-foreground opacity-60" disabled>{ i18n.T(ctx, "security.previous") }</button>
					}
					<span class="min-w-20 text-center text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "security.page_of", "page", data.Page, "pages", data.TotalPages) }</span>
					if data.HasNext {
						<button type="button" class="inline-flex h-8 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent" hx-get={ securityActivityPagePath(data.NextPage) } hx-target="#security-activity-dialog-body" hx-swap="innerHTML">{ i18n.T(ctx, "common.next") }</button>
					} else {
						<button type="button" class="inline-flex h-8 items-center justify-center rounded-md border border-border bg-muted px-3 text-xs font-semibold text-muted-foreground opacity-60" disabled>{ i18n.T(ctx, "common.next") }</button>
					}
				</div>
			</div>
		} else {
			<div class="settings-item rounded-lg border border-border/60 bg-background/40 px-4 py-6 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "security.activity.none") }</div>
		}
		<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.activity.note") }</p>
	</div>
}

templ SecurityManagementCancelForm(data PasswordSecurityData) {
	<form method="post" action="/settings/security/management/cancel">
		if data.CSRFTokens["/settings/security/management/cancel"] != "" {
			<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/management/cancel"] }/>
		}
		<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "common.cancel") }</button>
	</form>
}

// securityCardActionClass is the look of the main actions on a security card.
const securityCardActionClass = "inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground shadow-sm transition-colors hover:bg-accent"

// securityCardHeader is the top of a security card: the title with its
// status, a short description, and the card's actions, always on the right.
templ securityCardHeader(title, status, description string, statusOn bool) {
	<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-3">
		<div class="min-w-0">
			<div class="flex flex-wrap items-center gap-2">
				<h3 class="text-base font-semibold text-foreground">{ title }</h3>
				if statusOn {
					<span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-200">{ status }</span>
				} else {
					<span class="rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{ status }</span>
				}
			</div>
			<p class="mt-1 text-sm text-muted-foreground">{ description }</p>
		</div>
		<div class="flex flex-wrap items-center justify-end gap-2">
			{ children... }
		</div>
	</div>
}

templ securityVerifyNote(text string) {
	<p class="mt-3 text-xs font-medium text-amber-800 dark:text-amber-200">{ text }</p>
}

func passwordStatusLabel(ctx context.Context, set bool) string {
	if set {
		return i18n.T(ctx, "security.password.set")
	}
	return i18n.T(ctx, "security.password.not_set")
}

func passwordDescription(ctx context.Context, set bool) string {
	if set {
		return i18n.T(ctx, "security.password.has")
	}
	return i18n.T(ctx, "security.password.none")
}

func passkeyStatusLabel(ctx context.Context, count int) string {
	if count == 0 {
		return i18n.T(ctx, "security.passkeys.none")
	}
	return i18n.N(ctx, "security.passkeys.count", count)
}

func applicationSignInStatusLabel(ctx context.Context, count int) string {
	if count == 0 {
		return i18n.T(ctx, "security.apps.none")
	}
	return i18n.N(ctx, "security.apps.count", count)
}

func twoFactorStatusLabel(ctx context.Context, on bool) string {
	if on {
		return i18n.T(ctx, "security.totp.on")
	}
	return i18n.T(ctx, "security.totp.off")
}

func twoFactorDescription(ctx context.Context, on bool) string {
	if on {
		return i18n.T(ctx, "security.totp.on_description")
	}
	return i18n.T(ctx, "security.totp.off_description")
}

templ securityActionConfirmationDialog(id, action, csrf, label, description string, classes ...string) {
	@dialog.Trigger(dialog.TriggerProps{For: id}) {
		<button type="button" class={ utils.TwMerge("inline-flex h-9 items-center justify-center rounded-md border border-destructive/40 bg-background px-3 text-xs font-semibold text-destructive transition-colors hover:bg-destructive/10", strings.Join(classes, " ")) }>{ label }</button>
	}
	@dialog.Dialog(dialog.Props{ID: id}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					{ label }
				}
				@dialog.Description() {
					{ description }
				}
			}
			<form method="post" action={ templ.URL(action) }>
				if csrf != "" {
					<input type="hidden" name="_csrf" value={ csrf }/>
				}
				@dialog.Footer() {
					@dialog.Close() {
						<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-sm font-semibold text-foreground transition-colors hover:bg-accent">{ i18n.T(ctx, "common.cancel") }</button>
					}
					<button type="submit" class={ utils.TwMerge("inline-flex h-9 items-center justify-center rounded-md border border-destructive/40 bg-background px-3 text-xs font-semibold text-destructive transition-colors hover:bg-destructive/10", strings.Join(classes, " ")) }>{ label }</button>
				}
			</form>
		}
	}
}

// Keep the unavailable action focusable so its explanation also works with a keyboard or touch.
// This button only opens help; it has no form action or credential mutation handler.
templ securityUnavailableAction(id, label, reason string, classes ...string) {
	@tooltip.Tooltip(tooltip.Props{ID: id}) {
		@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
			<button type="button" aria-disabled="true" aria-describedby={ id + "-reason" } data-on-click={ onAction("window.tui.popover.open", id) } class={ utils.TwMerge("inline-flex h-9 items-center justify-center rounded-md border border-border bg-muted px-3 text-xs font-semibold text-muted-foreground opacity-60 cursor-not-allowed", strings.Join(classes, " ")) }>{ label }</button>
		}
		@tooltip.Content(tooltip.ContentProps{ID: id + "-reason", Position: tooltip.PositionTop, ShowArrow: true, Class: "w-80 px-3 py-2 text-left text-xs leading-relaxed"}) {
			{ reason }
		}
	}
}

func signInProviderIdentities(identities []FederatedIdentityData, provider string) []FederatedIdentityData {
	var result []FederatedIdentityData
	for _, identity := range identities {
		if identity.Provider == provider {
			result = append(result, identity)
		}
	}
	return result
}

templ applicationSignInProviderRow(data PasswordSecurityData, provider, label, iconProvider string, available bool) {
	{{ identities := signInProviderIdentities(data.FederatedIdentities, provider) }}
	{{ linkPath := "/settings/security/identities/" + provider + "/link" }}
	<li class="px-4 py-4" data-sign-in-provider={ provider }>
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex items-center gap-3">
				@AccountProviderIcon(iconProvider, "size-4 shrink-0")
				<p class="text-sm font-semibold text-foreground">{ label }</p>
			</div>
			if !available {
				<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.apps.not_configured_short") }</span>
			} else if len(identities) > 0 {
				<span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-200">{ i18n.T(ctx, "security.apps.connected") }</span>
			} else {
				<div class="flex items-center gap-3">
					<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.apps.not_connected") }</span>
					if data.StepUpFresh {
						<form method="post" action={ templ.URL(linkPath) }>
							<input type="hidden" name="_csrf" value={ data.CSRFTokens[linkPath] }/>
							<button type="submit" aria-label={ i18n.T(ctx, "security.apps.connect_named", "name", label) } class={ securityCardActionClass }>{ i18n.T(ctx, "security.apps.connect") }</button>
						</form>
					}
				</div>
			}
		</div>
		if len(identities) > 1 {
			<p class="mt-3 text-xs text-muted-foreground">{ i18n.T(ctx, "security.apps.keep_one", "provider", label) }</p>
		}
		for index, identity := range identities {
			<div class="mt-3 flex flex-wrap items-center justify-between gap-3">
				<div class="min-w-0">
					<p class="break-all text-sm text-foreground">{ federatedIdentityDisplay(ctx, identity, data.OIDCLoginName) }</p>
					<p class="mt-1 text-xs text-muted-foreground">
						{ i18n.T(ctx, "security.apps.connected_on", "provider", label, "date", identity.LinkedAt) }
						if identity.LastUsedAt != "" {
							<span>{ i18n.T(ctx, "security.last_used", "date", identity.LastUsedAt) }</span>
						}
					</p>
				</div>
				if data.StepUpFresh && identity.CanUnlink && identity.UnlinkPath != "" {
					@securityActionConfirmationDialog(fmt.Sprintf("security-%s-disconnect-%d", provider, index), identity.UnlinkPath, data.CSRFTokens[identity.UnlinkPath], i18n.T(ctx, "security.apps.disconnect"), i18n.T(ctx, "security.apps.disconnect_confirm"))
				} else if !identity.CanUnlink && identity.UnlinkReason != "" {
					@securityUnavailableAction(fmt.Sprintf("security-%s-disconnect-blocked-%d", provider, index), i18n.T(ctx, "security.apps.disconnect"), identity.UnlinkReason)
				} else if !data.StepUpFresh && identity.UnlinkPath != "" {
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.apps.verify_disconnect") }</p>
				}
			</div>
		}
	</li>
}

templ securitySessionRows(sessions []SecuritySessionData, csrf map[string]string, prefix string) {
	<ul class="settings-item divide-y divide-border/60 rounded-lg border border-border/60 bg-background/40" aria-label={ i18n.T(ctx, "security.sessions.list") }>
		for index, session := range sessions {
			<li class="grid gap-3 px-4 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
				<div class="min-w-0">
					<p class="break-words text-sm font-semibold text-foreground">{ session.Client }</p>
					<p class="mt-1 text-xs text-muted-foreground">{ session.Authentication } · { session.Assurance }</p>
					<dl class="mt-3 grid gap-1.5 text-xs text-muted-foreground sm:grid-cols-2">
						<div>
							<dt class="sr-only">{ i18n.T(ctx, "security.sessions.signed_in") }</dt>
							<dd>{ i18n.T(ctx, "security.sessions.signed_in_at", "date", session.SignedInAt) }</dd>
						</div>
						<div>
							<dt class="sr-only">{ i18n.T(ctx, "security.sessions.last_active") }</dt>
							<dd>{ i18n.T(ctx, "security.sessions.last_active_at", "date", session.LastActiveAt) }</dd>
						</div>
						if !session.Active && session.EndedAt != "" {
							<div class="sm:col-span-2">
								<dt class="sr-only">{ i18n.T(ctx, "security.sessions.signed_out") }</dt>
								<dd>{ i18n.T(ctx, "security.sessions.signed_out_at", "date", session.EndedAt) }</dd>
							</div>
						}
					</dl>
				</div>
				<div class="flex flex-col items-start gap-2 sm:items-end">
					if session.Current {
						<span class="w-fit rounded-full border border-primary/30 bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">{ i18n.T(ctx, "security.sessions.current") }</span>
					} else if session.Active {
						<span class="w-fit rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-200">{ i18n.T(ctx, "security.sessions.active") }</span>
						if session.RevokePath != "" {
							@securityActionConfirmationDialog(fmt.Sprintf("%s-session-revoke-%d", prefix, index), session.RevokePath, csrf[session.RevokePath], i18n.T(ctx, "security.sessions.sign_out"), i18n.T(ctx, "security.sessions.sign_out_confirm", "client", session.Client))
						}
					} else {
						<span class="w-fit rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "security.sessions.signed_out") }</span>
					}
				</div>
			</li>
		}
	</ul>
}

templ SecuritySessionHistoryPage(sessions []SecuritySessionData, csrf map[string]string, page, totalPages int64) {
	<div class="space-y-4" data-security-session-history>
		if len(sessions) > 0 {
			<div class="max-h-[60vh] overflow-y-auto">
				@securitySessionRows(sessions, csrf, "history")
			</div>
			<div class="flex items-center justify-between gap-3">
				if page > 2 {
					<button type="button" class="h-8 rounded-md border border-border px-3 text-xs hover:bg-accent" hx-get={ fmt.Sprintf("/settings/security/sessions/history?page=%d", page-1) } hx-target="#security-session-history-body" hx-swap="innerHTML">{ i18n.T(ctx, "security.previous") }</button>
				} else {
					<button type="button" class="h-8 rounded-md border border-border px-3 text-xs opacity-60" disabled>{ i18n.T(ctx, "security.previous") }</button>
				}
				<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "security.page_of", "page", page-1, "pages", totalPages-1) }</span>
				if page < totalPages {
					<button type="button" class="h-8 rounded-md border border-border px-3 text-xs hover:bg-accent" hx-get={ fmt.Sprintf("/settings/security/sessions/history?page=%d", page+1) } hx-target="#security-session-history-body" hx-swap="innerHTML">{ i18n.T(ctx, "common.next") }</button>
				} else {
					<button type="button" class="h-8 rounded-md border border-border px-3 text-xs opacity-60" disabled>{ i18n.T(ctx, "common.next") }</button>
				}
			</div>
		} else {
			<p class="py-6 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "security.sessions.no_older") }</p>
		}
	</div>
}
