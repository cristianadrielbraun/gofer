package views

import (
	"fmt"
	"strings"

	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/tooltip"
)

type TOTPManagementData struct {
	QRCodeDataURL string
	ManualKey     string
	Algorithm     string
	Digits        int
	Period        int
	IsReplacement bool
}

type PasskeySecurityData struct {
	ID           string
	Name         string
	Details      string
	CreatedAt    string
	LastUsedAt   string
	CanRemove    bool
	RemoveReason string
}

type FederatedIdentityData struct {
	ID           string
	Provider     string
	Email        string
	LinkedAt     string
	LastUsedAt   string
	CanUnlink    bool
	UnlinkReason string
	UnlinkPath   string
}

type SecuritySessionData struct {
	Client         string
	Authentication string
	Assurance      string
	SignedInAt     string
	LastActiveAt   string
	EndedAt        string
	RevokePath     string
	Current        bool
	Active         bool
}

type SecurityEventData struct {
	Title      string
	Detail     string
	OccurredAt string
	Client     string
	Status     string
	Successful bool
}

type PasswordSecurityData struct {
	LoginUsername              string
	LoginEmail                 string
	HasPassword                bool
	HasTOTP                    bool
	HasPasskey                 bool
	RequiresMFA                bool
	Passkeys                   []PasskeySecurityData
	FederatedIdentities        []FederatedIdentityData
	Sessions                   []SecuritySessionData
	SessionsTruncated          bool
	CanRevokeOtherSessions     bool
	SecurityEvents             []SecurityEventData
	SecurityEventsTruncated    bool
	GoogleLoginAvailable       bool
	MicrosoftLoginAvailable    bool
	OIDCLoginAvailable         bool
	OIDCLoginName              string
	RecoveryCodesRemaining     int
	StepUpFresh                bool
	CanDisableTOTP             bool
	DisableTOTPReason          string
	TOTPManagement             *TOTPManagementData
	RecoveryReplacementPending bool
	RecoveryBatchID            string
	RecoveryCodes              []string
	Message                    string
	MessageIsError             bool
	CSRFToken                  string
	CSRFTokens                 map[string]string
}

type PasswordSecurityVerificationData struct {
	HasTOTP        bool
	HasPasskey     bool
	Message        string
	MessageIsError bool
	CSRFTokens     map[string]string
}

func passwordSecurityMessageRole(isError bool) string {
	if isError {
		return "alert"
	}
	return "status"
}

func localLoginIdentifierDisplay(value string) string {
	if strings.TrimSpace(value) == "" {
		return "Not set"
	}
	return value
}

func totpManagementTitle(isReplacement bool) string {
	if isReplacement {
		return "Verify the replacement authenticator"
	}
	return "Verify the new authenticator"
}

func totpManagementDescription(isReplacement bool) string {
	if isReplacement {
		return "The current authenticator remains active until this replacement is verified."
	}
	return "Scan this code and enter the current six-digit code. The authenticator is not enabled until the code is verified."
}

func totpManagementQRCodeAlt(isReplacement bool) string {
	if isReplacement {
		return "QR code containing the replacement Gofer authenticator key"
	}
	return "QR code containing the new Gofer authenticator key"
}

func totpManagementManualKeyLabel(isReplacement bool) string {
	if isReplacement {
		return "Replacement authenticator manual setup key"
	}
	return "New authenticator manual setup key"
}

func totpManagementCodeLabel(isReplacement bool) string {
	if isReplacement {
		return "Code from the new authenticator"
	}
	return "Code from your authenticator app"
}

func totpManagementSubmitLabel(isReplacement bool) string {
	if isReplacement {
		return "Replace authenticator"
	}
	return "Enable authenticator"
}

func federatedIdentityProviderLabel(provider, oidcName string) string {
	if provider == "microsoft" {
		return "Microsoft"
	}
	if provider == "google" {
		return "Google"
	}
	if oidcName != "" {
		return oidcName
	}
	return "OpenID Connect"
}

func federatedIdentityDisplay(identity FederatedIdentityData, oidcName string) string {
	if identity.Email != "" {
		return identity.Email
	}
	return federatedIdentityProviderLabel(identity.Provider, oidcName) + " identity"
}

templ PasswordSecurityVerificationLayout(uiSettings map[string]string, data PasswordSecurityVerificationData) {
	<!DOCTYPE html>
	<html lang="en" class={ themeClass(uiSettings) } data-theme={ themeStyle(uiSettings) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Security settings — Gofer</title>
			@AppIcon()
			@SavedPanelSizeStyle()
			<link rel="stylesheet" href="/assets/css/output.css"/>
			@SettingsComponentScripts()
			@AppSidebarResponsiveStyle()
		</head>
		<body class="bg-background text-foreground antialiased surface-desk" data-ui-settings={ uiSettingsJSON(uiSettings) }>
			<div id="app-shell" class="flex h-screen overflow-hidden">
				@SettingsSidebar("security", uiSettingGet(uiSettings, "sidebar_width", "256px"))
				@ResizeHandle("sidebar")
				@PasswordSecurityVerificationPartial(data)
			</div>
			@SettingsRuntime(nil)
		</body>
	</html>
}

templ PasswordSecurityVerificationPartial(data PasswordSecurityVerificationData) {
	<div id="main-content" class="flex flex-1 min-w-0">
		<div class="flex-1 flex flex-col min-w-0 overflow-hidden" data-settings-page>
			<div class="flex-1 overflow-y-auto">
				<div id="settings-content" class="max-w-3xl px-8 py-10">
					<div class="mb-6">
						<h2 class="text-2xl font-bold text-foreground mb-1" style="font-family: var(--font-serif)">Settings</h2>
						<p class="text-sm text-muted-foreground">Manage your accounts and preferences</p>
					</div>
					@PasswordSecurityVerification(data)
				</div>
			</div>
		</div>
	</div>
}

templ PasswordSecurityVerification(data PasswordSecurityVerificationData) {
	<div class="mt-6 space-y-6" data-password-security-verification>
		if data.Message != "" {
			<div
				role={ passwordSecurityMessageRole(data.MessageIsError) }
				class={
					"rounded-md border px-4 py-3 text-sm",
					templ.KV("border-destructive/30 bg-destructive/10 text-destructive", data.MessageIsError),
					templ.KV("border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200", !data.MessageIsError),
				}
			>
				{ data.Message }
			</div>
		}
		<div class="rounded-lg border border-amber-500/30 bg-amber-500/5 p-6" data-security-step-up>
			<div class="mb-5">
				<h3 class="text-base font-semibold text-foreground">Verify it’s you</h3>
				<p class="mt-1 text-sm text-muted-foreground">For your protection, Gofer has not loaded your security details yet. Verify this session to request and view them.</p>
			</div>
			if data.HasTOTP || data.HasPasskey {
				<div
					class={
						templ.Classes(
							"grid gap-5",
							templ.KV("md:grid-cols-2", data.HasPasskey && data.HasTOTP),
							templ.KV("max-w-sm", !data.HasPasskey || !data.HasTOTP),
						),
					}
				>
					if data.HasPasskey {
						<form
							data-passkey-authentication
							data-start-path="/settings/security/passkeys/step-up/start"
							data-finish-path="/settings/security/passkeys/step-up/finish"
							data-start-csrf={ data.CSRFTokens["/settings/security/passkeys/step-up/start"] }
							data-finish-csrf={ data.CSRFTokens["/settings/security/passkeys/step-up/finish"] }
							data-fallback="Use your authenticator code instead."
							class="space-y-3 rounded-md border border-border bg-background/60 p-4"
						>
							<p class="text-sm font-medium text-foreground">Passkey</p>
							<p class="text-xs text-muted-foreground">Verify with this device, another device, or a security key.</p>
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60">Verify with a passkey</button>
							<p data-passkey-authentication-status role="status" aria-live="polite" class="text-xs text-muted-foreground"></p>
						</form>
					}
					if data.HasTOTP {
						<form method="post" action="/settings/security/step-up" class="space-y-4 rounded-md border border-border bg-background/60 p-4">
							if data.CSRFTokens["/settings/security/step-up"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/step-up"] }/>
							}
							<div class="space-y-1.5">
								<label for="security-step-up-code" class="text-sm font-medium text-foreground">Authenticator code</label>
								<input
									id="security-step-up-code"
									name="code"
									type="text"
									inputmode="numeric"
									autocomplete="one-time-code"
									pattern="[0-9]{6}"
									minlength="6"
									maxlength="6"
									required
									class="h-10 w-full rounded-md border border-input bg-background px-3 font-mono text-sm tracking-[0.25em] text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
								/>
							</div>
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground shadow-sm transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">Verify code</button>
						</form>
					}
				</div>
			} else {
				<div class="max-w-sm space-y-4">
					<p class="text-sm text-muted-foreground">Sign in again to securely load and view your security settings.</p>
					<form method="post" action="/auth/logout">
						if data.CSRFTokens["/auth/logout"] != "" {
							<input type="hidden" name="_csrf" value={ data.CSRFTokens["/auth/logout"] }/>
						}
						<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">Sign in again</button>
					</form>
				</div>
			}
		</div>
	</div>
}

templ PasswordSecurityLayout(uiSettings map[string]string, data PasswordSecurityData) {
	<!DOCTYPE html>
	<html lang="en" class={ themeClass(uiSettings) } data-theme={ themeStyle(uiSettings) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Security settings — Gofer</title>
			@AppIcon()
			@SavedPanelSizeStyle()
			<link rel="stylesheet" href="/assets/css/output.css"/>
			@SettingsComponentScripts()
			@AppSidebarResponsiveStyle()
		</head>
		<body class="bg-background text-foreground antialiased surface-desk" data-ui-settings={ uiSettingsJSON(uiSettings) }>
			<div id="app-shell" class="flex h-screen overflow-hidden">
				@SettingsSidebar("security", uiSettingGet(uiSettings, "sidebar_width", "256px"))
				@ResizeHandle("sidebar")
				@PasswordSecurityPartial(data)
			</div>
			@SettingsRuntime(nil)
		</body>
	</html>
}

templ PasswordSecurityPartial(data PasswordSecurityData) {
	<div id="main-content" class="flex flex-1 min-w-0">
		<div class="flex-1 flex flex-col min-w-0 overflow-hidden" data-settings-page>
			<div class="flex-1 overflow-y-auto">
				<div id="settings-content" class="max-w-3xl px-8 py-10">
					<div class="mb-6">
						<h2 class="text-2xl font-bold text-foreground mb-1" style="font-family: var(--font-serif)">Settings</h2>
						<p class="text-sm text-muted-foreground">Manage your accounts and preferences</p>
					</div>
					@PasswordSecuritySettings(data)
				</div>
			</div>
		</div>
	</div>
}

templ PasswordSecuritySettings(data PasswordSecurityData) {
	<div class="mt-6 space-y-6" data-password-security-settings>
		if data.Message != "" {
			<div
				role={ passwordSecurityMessageRole(data.MessageIsError) }
				class={
					"rounded-md border px-4 py-3 text-sm",
					templ.KV("border-destructive/30 bg-destructive/10 text-destructive", data.MessageIsError),
					templ.KV("border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200", !data.MessageIsError),
				}
			>
				{ data.Message }
			</div>
		}
		<div class="rounded-lg border bg-card p-6" data-local-login-identifiers>
			<div class="mb-5">
				<h3 class="text-base font-semibold text-foreground">Local sign-in</h3>
				<p class="mt-1 text-sm text-muted-foreground">These identify this Gofer account on the sign-in page. They are separate from mailbox addresses and external sign-in identities.</p>
			</div>
			<dl class="grid gap-3 sm:grid-cols-2" aria-label="Local sign-in identifiers">
				<div class="rounded-md border border-border bg-background/60 px-4 py-3">
					<dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Username</dt>
					<dd class="mt-1 break-all text-sm font-semibold text-foreground" data-local-login-username>{ localLoginIdentifierDisplay(data.LoginUsername) }</dd>
				</div>
				<div class="rounded-md border border-border bg-background/60 px-4 py-3">
					<dt class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Account email</dt>
					<dd class="mt-1 break-all text-sm font-semibold text-foreground" data-local-login-email>{ localLoginIdentifierDisplay(data.LoginEmail) }</dd>
				</div>
			</dl>
			<p class="mt-3 text-xs text-muted-foreground">An identifier is not a credential. Local sign-in still requires this account’s password or passkey.</p>
		</div>
		<div class="rounded-lg border bg-card p-6">
			<div class="mb-5">
				<h3 class="text-base font-semibold text-foreground">Password</h3>
				<p class="mt-1 text-sm text-muted-foreground">Change the password used to sign in to this Gofer account.</p>
			</div>
			if data.HasPassword && (!data.RequiresMFA || data.StepUpFresh) {
				<form method="post" action="/settings/security/password" class="max-w-xl space-y-4">
					if data.CSRFToken != "" {
						<input type="hidden" name="_csrf" value={ data.CSRFToken }/>
					}
					<div class="space-y-1.5">
						<label for="current-password" class="text-sm font-medium text-foreground">Current password</label>
						<input
							id="current-password"
							name="current_password"
							type="password"
							autocomplete="current-password"
							required
							autofocus?={ data.MessageIsError }
							class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
						/>
					</div>
					<div class="space-y-1.5">
						<label for="new-password" class="text-sm font-medium text-foreground">New password</label>
						<input
							id="new-password"
							name="new_password"
							type="password"
							autocomplete="new-password"
							minlength="15"
							maxlength="256"
							required
							aria-describedby="new-password-help"
							class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
						/>
						<p id="new-password-help" class="text-xs text-muted-foreground">Use at least 15 characters. Gofer checks common and account-related passwords locally.</p>
					</div>
					<div class="space-y-1.5">
						<label for="confirm-password" class="text-sm font-medium text-foreground">Confirm new password</label>
						<input
							id="confirm-password"
							name="confirm_password"
							type="password"
							autocomplete="new-password"
							minlength="15"
							maxlength="256"
							required
							class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
						/>
					</div>
					<div class="rounded-md border border-amber-500/25 bg-amber-500/10 px-4 py-3 text-xs leading-relaxed text-amber-900 dark:text-amber-100">
						Changing your password signs out every other browser and device. This browser receives a fresh session.
					</div>
					<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
						Change password
					</button>
				</form>
			} else if !data.HasPassword {
				<div class="rounded-md border border-border bg-background/60 px-4 py-3 text-sm text-muted-foreground">
					This account does not have a local password. Password enrollment will be available through the account enrollment flow.
				</div>
			} else {
				<div class="rounded-md border border-amber-500/25 bg-amber-500/10 px-4 py-3 text-sm text-amber-900 dark:text-amber-100">
					Verify this session above before changing the password. For an account requiring MFA, the current password alone is not sufficient verification.
				</div>
			}
		</div>
		<div class="rounded-lg border bg-card p-6" data-federated-identity-settings>
			<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
				<div>
					<h3 class="text-base font-semibold text-foreground">Application sign-in</h3>
					<p class="mt-1 text-sm text-muted-foreground">Connect an external identity that may sign in to this Gofer account.</p>
				</div>
				<span class="rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{ fmt.Sprintf("%d connected", len(data.FederatedIdentities)) }</span>
			</div>
			if len(data.FederatedIdentities) > 0 {
				<ul class="mb-5 divide-y divide-border rounded-md border border-border" aria-label="Connected sign-in identities">
					for _, identity := range data.FederatedIdentities {
						<li class="flex flex-wrap items-center justify-between gap-4 px-4 py-3">
							<div class="min-w-0">
								<p class="truncate text-sm font-semibold text-foreground">{ federatedIdentityDisplay(identity, data.OIDCLoginName) }</p>
								<p class="mt-1 text-xs text-muted-foreground">
									{ federatedIdentityProviderLabel(identity.Provider, data.OIDCLoginName) } · connected { identity.LinkedAt }
									if identity.LastUsedAt != "" {
										<span>· last used { identity.LastUsedAt }</span>
									}
								</p>
							</div>
							<div class="flex max-w-64 flex-col items-end gap-2 text-right">
								<span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-200">Connected</span>
								if data.StepUpFresh && identity.CanUnlink && identity.UnlinkPath != "" {
									<form method="post" action={ templ.URL(identity.UnlinkPath) } onsubmit="return confirm('Disconnect this sign-in identity? This removes only this identity as a way to sign in to Gofer and does not disconnect any mailbox.')">
										if data.CSRFTokens[identity.UnlinkPath] != "" {
											<input type="hidden" name="_csrf" value={ data.CSRFTokens[identity.UnlinkPath] }/>
										}
										<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-destructive/40 bg-background px-3 text-xs font-semibold text-destructive hover:bg-destructive/10">Disconnect</button>
									</form>
								} else if !identity.CanUnlink && identity.UnlinkReason != "" {
									<p class="text-xs text-muted-foreground">{ identity.UnlinkReason }</p>
								} else if !data.StepUpFresh && identity.UnlinkPath != "" {
									<p class="text-xs text-muted-foreground">Verify this session before disconnecting.</p>
								}
							</div>
						</li>
					}
				</ul>
			}
			if data.StepUpFresh && (data.GoogleLoginAvailable || data.MicrosoftLoginAvailable) {
				<div
					data-application-sign-in-actions
					class={
						templ.Classes(
							"grid gap-3",
							templ.KV("sm:grid-cols-2", data.GoogleLoginAvailable && data.MicrosoftLoginAvailable),
							templ.KV("max-w-sm", data.GoogleLoginAvailable != data.MicrosoftLoginAvailable),
						),
					}
				>
					if data.GoogleLoginAvailable {
						<form method="post" action="/settings/security/identities/google/link">
							if data.CSRFTokens["/settings/security/identities/google/link"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/identities/google/link"] }/>
							}
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center gap-2.5 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">
								@AccountProviderIcon("gmail", "size-4 shrink-0")
								Connect Google sign-in
							</button>
						</form>
					}
					if data.MicrosoftLoginAvailable {
						<form method="post" action="/settings/security/identities/microsoft/link">
							if data.CSRFTokens["/settings/security/identities/microsoft/link"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/identities/microsoft/link"] }/>
							}
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center gap-2.5 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">
								@AccountProviderIcon("outlook", "size-4 shrink-0")
								Connect Microsoft sign-in
							</button>
						</form>
					}
				</div>
			}
			if data.OIDCLoginAvailable && data.StepUpFresh {
				<form method="post" action="/settings/security/identities/oidc/link" class="mt-3">
					if data.CSRFTokens["/settings/security/identities/oidc/link"] != "" {
						<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/identities/oidc/link"] }/>
					}
					<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">Connect { data.OIDCLoginName } sign-in</button>
				</form>
			}
			if !data.StepUpFresh && (data.GoogleLoginAvailable || data.MicrosoftLoginAvailable || data.OIDCLoginAvailable) {
				<p class="text-xs font-medium text-amber-800 dark:text-amber-200">Verify this session above before connecting another sign-in method. If no verification form is shown, sign in again first.</p>
			}
			if !data.GoogleLoginAvailable && !data.MicrosoftLoginAvailable && !data.OIDCLoginAvailable {
				<p class="text-xs text-muted-foreground">External application sign-in is not configured for this Gofer installation.</p>
			}
			<div class="mt-3">
				@tooltip.Tooltip(tooltip.Props{ID: "application-sign-in-scope"}) {
					@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
						<button type="button" class="inline-flex items-center gap-1.5 rounded-sm text-xs text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" aria-label="Learn what application sign-in authorizes">
							<span>For Gofer sign-in only</span>
							@icon.Info(icon.Props{Class: "size-3.5 shrink-0"})
						</button>
					}
					@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "w-80 px-3 py-2 text-left text-xs leading-relaxed"}) {
						Connecting Google, Microsoft, or another OpenID Connect identity adds only a way to sign in to Gofer. It does not connect a Gmail or Outlook mailbox or grant Gofer access to mail, contacts, calendars, or other provider resources.
					}
				}
			</div>
		</div>
		<div class="rounded-lg border bg-card p-6" data-passkey-security-settings>
			<div class="mb-5 grid grid-cols-[minmax(0,1fr)_auto] items-start gap-3">
				<div class="min-w-0">
					<h3 class="text-base font-semibold text-foreground">Passkeys</h3>
					<p class="mt-1 text-sm text-muted-foreground">Use your device, security key, fingerprint, or screen lock for phishing-resistant authentication.</p>
				</div>
				<span class="rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{ fmt.Sprintf("%d registered", len(data.Passkeys)) }</span>
			</div>
			if len(data.Passkeys) > 0 {
				<ul class="mb-5 divide-y divide-border rounded-md border border-border" aria-label="Registered passkeys">
					for _, passkey := range data.Passkeys {
						<li class="flex flex-wrap items-center justify-between gap-4 px-4 py-3">
							<div class="min-w-0">
								<p class="truncate text-sm font-semibold text-foreground">{ passkey.Name }</p>
								<p class="mt-1 text-xs text-muted-foreground">
									{ passkey.Details } · added { passkey.CreatedAt }
									if passkey.LastUsedAt != "" {
										<span>· last used { passkey.LastUsedAt }</span>
									}
								</p>
							</div>
							if data.StepUpFresh && passkey.CanRemove {
								<form method="post" action={ templ.SafeURL("/settings/security/passkeys/" + passkey.ID + "/remove") } onsubmit="return confirm('Remove this passkey? It will stop working for this account.')">
									if data.CSRFTokens["/settings/security/passkeys/" + passkey.ID + "/remove"] != "" {
										<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/passkeys/"+passkey.ID+"/remove"] }/>
									}
									<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-destructive/40 bg-background px-3 text-xs font-semibold text-destructive hover:bg-destructive/10">Remove</button>
								</form>
							} else if !passkey.CanRemove && passkey.RemoveReason != "" {
								<span class="max-w-56 text-right text-xs text-muted-foreground">{ passkey.RemoveReason }</span>
							}
						</li>
					}
				</ul>
			}
			if data.StepUpFresh {
				<form
					data-passkey-registration
					data-start-path="/settings/security/passkeys/start"
					data-finish-path="/settings/security/passkeys/finish"
					data-start-csrf={ data.CSRFTokens["/settings/security/passkeys/start"] }
					data-finish-csrf={ data.CSRFTokens["/settings/security/passkeys/finish"] }
					class="max-w-xl"
				>
					<div class="space-y-1.5">
						<label for="passkey-name" class="text-sm font-medium text-foreground">Passkey name</label>
						<input id="passkey-name" name="name" type="text" autocomplete="off" maxlength="64" required placeholder="Laptop, phone, or security key" class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"/>
					</div>
					<button type="submit" class="mt-3 inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60">Add passkey</button>
					<p data-passkey-status role="status" aria-live="polite" class="mt-3 text-xs text-muted-foreground empty:hidden"></p>
					<noscript><p class="mt-3 text-xs text-amber-800 dark:text-amber-200">JavaScript is required to communicate with a passkey authenticator.</p></noscript>
				</form>
			} else {
				<p class="text-xs font-medium text-amber-800 dark:text-amber-200">Verify this session above before adding or removing passkeys. If no authenticator form is shown, sign in again to refresh password verification.</p>
			}
		</div>
		<div class="rounded-lg border bg-card p-6" data-totp-security-settings>
			<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
				<div>
					<h3 class="text-base font-semibold text-foreground">Authenticator app</h3>
					<p class="mt-1 text-sm text-muted-foreground">Use a standards-compatible authenticator as the strong factor for sign-in and recovery.</p>
				</div>
				if data.HasTOTP {
					<span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-200">Enrolled</span>
				} else {
					<span class="rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">Not enrolled</span>
				}
			</div>
			if data.TOTPManagement != nil {
				<div class="rounded-lg border border-primary/25 bg-primary/5 p-5" data-totp-management>
					<h4 class="text-sm font-semibold text-foreground">{ totpManagementTitle(data.TOTPManagement.IsReplacement) }</h4>
					<p class="mt-1 text-xs text-muted-foreground">{ totpManagementDescription(data.TOTPManagement.IsReplacement) }</p>
					<div class="mt-5 grid gap-5 sm:grid-cols-[auto_1fr] sm:items-center">
						<div class="rounded-lg bg-white p-3">
							<img src={ data.TOTPManagement.QRCodeDataURL } alt={ totpManagementQRCodeAlt(data.TOTPManagement.IsReplacement) } width="176" height="176" class="h-44 w-44"/>
						</div>
						<div class="space-y-3">
							<div>
								<p class="text-xs font-medium text-muted-foreground">Manual setup key</p>
								<code class="mt-1.5 block break-all rounded-md border border-border bg-background px-3 py-2 font-mono text-xs" aria-label={ totpManagementManualKeyLabel(data.TOTPManagement.IsReplacement) }>{ data.TOTPManagement.ManualKey }</code>
							</div>
							<p class="text-xs text-muted-foreground">{ data.TOTPManagement.Algorithm }, { fmt.Sprintf("%d digits", data.TOTPManagement.Digits) }, every { fmt.Sprintf("%d seconds", data.TOTPManagement.Period) }</p>
						</div>
					</div>
					<form method="post" action="/settings/security/totp/confirm" class="mt-5 max-w-sm space-y-4">
						if data.CSRFTokens["/settings/security/totp/confirm"] != "" {
							<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/totp/confirm"] }/>
						}
						<div class="space-y-1.5">
							<label for="managed-totp-code" class="text-sm font-medium text-foreground">{ totpManagementCodeLabel(data.TOTPManagement.IsReplacement) }</label>
							<input id="managed-totp-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required class="h-10 w-full rounded-md border border-input bg-background px-3 font-mono text-sm tracking-[0.25em] text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"/>
						</div>
						<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">{ totpManagementSubmitLabel(data.TOTPManagement.IsReplacement) }</button>
					</form>
					<div class="mt-3 flex flex-wrap gap-2">
						<form method="post" action="/settings/security/totp/start">
							if data.CSRFTokens["/settings/security/totp/start"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/totp/start"] }/>
							}
							<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent">Start over</button>
						</form>
						@SecurityManagementCancelForm(data)
					</div>
				</div>
			} else if data.HasTOTP {
				<div class="space-y-4">
					<p class="text-sm text-muted-foreground">Replacing the authenticator is atomic: the current one keeps working until a code from the new enrollment is accepted.</p>
					if data.StepUpFresh {
						<div class="flex flex-wrap gap-2">
							<form method="post" action="/settings/security/totp/start">
								if data.CSRFTokens["/settings/security/totp/start"] != "" {
									<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/totp/start"] }/>
								}
								<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90">Replace authenticator</button>
							</form>
							if data.CanDisableTOTP {
								<form method="post" action="/settings/security/totp/disable" onsubmit="return confirm('Disable this authenticator? Unused recovery codes will also be revoked and other signed-in devices will be signed out.')">
									if data.CSRFTokens["/settings/security/totp/disable"] != "" {
										<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/totp/disable"] }/>
									}
									<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md border border-destructive/40 bg-background px-4 text-sm font-semibold text-destructive hover:bg-destructive/10">Disable authenticator</button>
								</form>
							}
						</div>
						if !data.CanDisableTOTP && data.DisableTOTPReason != "" {
							<p class="text-xs text-muted-foreground">{ data.DisableTOTPReason }</p>
						}
					} else {
						<p class="text-xs font-medium text-amber-800 dark:text-amber-200">Verify this session above before replacing or disabling the authenticator.</p>
					}
				</div>
			} else {
				<div class="space-y-4">
					<p class="text-sm text-muted-foreground">No authenticator app is enrolled for this account. Add one to use time-based codes as a strong sign-in factor.</p>
					if data.StepUpFresh {
						<form method="post" action="/settings/security/totp/start">
							if data.CSRFTokens["/settings/security/totp/start"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/totp/start"] }/>
							}
							<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90">Set up authenticator</button>
						</form>
					} else {
						<p class="text-xs font-medium text-amber-800 dark:text-amber-200">Sign in again to verify this session before setting up an authenticator.</p>
					}
				</div>
			}
		</div>
		<div class="rounded-lg border bg-card p-6" data-recovery-code-security-settings>
			<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
				<div>
					<h3 class="text-base font-semibold text-foreground">Recovery codes</h3>
					<p class="mt-1 text-sm text-muted-foreground">Single-use codes restore access when the authenticator is unavailable.</p>
				</div>
				<span class="rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{ fmt.Sprintf("%d remaining", data.RecoveryCodesRemaining) }</span>
			</div>
			if data.RecoveryReplacementPending {
				<div class="rounded-lg border border-primary/25 bg-primary/5 p-5" data-recovery-code-replacement>
					<h4 class="text-sm font-semibold text-foreground">Save the new recovery codes</h4>
					if len(data.RecoveryCodes) > 0 {
						<p class="mt-1 text-xs text-muted-foreground">These plaintext codes are shown once. The previous batch remains active until you confirm that this set is saved.</p>
						<ol class="mt-4 grid gap-2 sm:grid-cols-2" aria-label="New recovery codes">
							for _, code := range data.RecoveryCodes {
								<li><code class="block rounded-md border border-border bg-background px-3 py-2 text-center font-mono text-sm tracking-wide">{ code }</code></li>
							}
						</ol>
					} else {
						<p class="mt-1 text-xs text-amber-800 dark:text-amber-200">This pending batch was already displayed. If it was not saved, start over to generate a different batch before confirming.</p>
					}
					<form method="post" action="/settings/security/recovery/complete" class="mt-5 space-y-4">
						if data.CSRFTokens["/settings/security/recovery/complete"] != "" {
							<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/recovery/complete"] }/>
						}
						<input type="hidden" name="batch_id" value={ data.RecoveryBatchID }/>
						<label class="flex items-start gap-2 text-sm text-foreground">
							<input type="checkbox" name="saved" value="yes" required class="mt-0.5 h-4 w-4 rounded border-input"/>
							<span>I saved this exact recovery-code batch in a secure place.</span>
						</label>
						<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90">Replace old recovery codes</button>
					</form>
					<div class="mt-3 flex flex-wrap gap-2">
						<form method="post" action="/settings/security/recovery/start">
							if data.CSRFTokens["/settings/security/recovery/start"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/recovery/start"] }/>
							}
							<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent">Generate a different batch</button>
						</form>
						@SecurityManagementCancelForm(data)
					</div>
				</div>
			} else if data.HasTOTP {
				<p class="text-sm text-muted-foreground">Generating a new batch does not revoke the current codes until the new plaintext set is explicitly acknowledged.</p>
				if data.StepUpFresh {
					<div class="mt-4 flex flex-wrap gap-2">
						<form method="post" action="/settings/security/recovery/start">
							if data.CSRFTokens["/settings/security/recovery/start"] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/recovery/start"] }/>
							}
							<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm hover:bg-primary/90">Generate new recovery codes</button>
						</form>
						if data.RecoveryCodesRemaining > 0 {
							<form method="post" action="/settings/security/recovery/revoke" onsubmit="return confirm('Revoke every unused recovery code? This cannot be undone.')">
								if data.CSRFTokens["/settings/security/recovery/revoke"] != "" {
									<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/recovery/revoke"] }/>
								}
								<button type="submit" class="inline-flex h-10 items-center justify-center rounded-md border border-destructive/40 bg-background px-4 text-sm font-semibold text-destructive hover:bg-destructive/10">Revoke recovery codes</button>
							</form>
						}
					</div>
				} else {
					<p class="mt-3 text-xs font-medium text-amber-800 dark:text-amber-200">Verify this session above before generating or revoking recovery codes.</p>
				}
			} else {
				<div class="rounded-md border border-border bg-background/60 px-4 py-3 text-sm text-muted-foreground">Recovery-code management becomes available after an authenticator is enrolled.</div>
			}
		</div>
		<div class="rounded-lg border bg-card p-6" data-security-sessions>
			<div class="mb-5 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
				<div class="min-w-0">
					<h3 class="text-base font-semibold text-foreground">Sessions</h3>
					<p class="mt-1 text-sm text-muted-foreground">Review browsers and devices currently or recently signed in to this Gofer account.</p>
				</div>
				if data.CanRevokeOtherSessions {
					<form method="post" action="/settings/security/sessions/revoke-others" onsubmit="return confirm('Sign out every other active session? Your current session will remain signed in.')">
						if data.CSRFTokens["/settings/security/sessions/revoke-others"] != "" {
							<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/sessions/revoke-others"] }/>
						}
						<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-destructive/40 bg-background px-3 text-xs font-semibold text-destructive transition-colors hover:bg-destructive/10">Sign out all other sessions</button>
					</form>
				}
			</div>
			if len(data.Sessions) > 0 {
				<ul class="divide-y divide-border rounded-md border border-border" aria-label="Current and recent sessions">
					for _, session := range data.Sessions {
						<li class="grid gap-3 px-4 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
							<div class="min-w-0">
								<p class="break-words text-sm font-semibold text-foreground">{ session.Client }</p>
								<p class="mt-1 text-xs text-muted-foreground">{ session.Authentication } · { session.Assurance }</p>
								<dl class="mt-3 grid gap-1.5 text-xs text-muted-foreground sm:grid-cols-2">
									<div>
										<dt class="sr-only">Signed in</dt>
										<dd>Signed in { session.SignedInAt }</dd>
									</div>
									<div>
										<dt class="sr-only">Last active</dt>
										<dd>Last active { session.LastActiveAt }</dd>
									</div>
									if !session.Active && session.EndedAt != "" {
										<div class="sm:col-span-2">
											<dt class="sr-only">Signed out</dt>
											<dd>Signed out { session.EndedAt }</dd>
										</div>
									}
								</dl>
							</div>
							<div class="flex flex-col items-start gap-2 sm:items-end">
								if session.Current {
									<span class="w-fit rounded-full border border-primary/30 bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary">Current</span>
								} else if session.Active {
									<span class="w-fit rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-200">Active</span>
									if session.RevokePath != "" {
										<form method="post" action={ templ.URL(session.RevokePath) } onsubmit="return confirm('Sign out this session?')">
											if data.CSRFTokens[session.RevokePath] != "" {
												<input type="hidden" name="_csrf" value={ data.CSRFTokens[session.RevokePath] }/>
											}
											<button type="submit" class="inline-flex h-8 items-center justify-center rounded-md border border-destructive/40 bg-background px-2.5 text-xs font-semibold text-destructive transition-colors hover:bg-destructive/10">Sign out</button>
										</form>
									}
								} else {
									<span class="w-fit rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">Signed out</span>
								}
							</div>
						</li>
					}
				</ul>
				if data.SessionsTruncated {
					<p class="mt-3 text-xs text-muted-foreground">Showing the 50 most relevant sessions. Older signed-out history is omitted.</p>
				}
			} else {
				<div class="rounded-md border border-border bg-background/60 px-4 py-3 text-sm text-muted-foreground">No session history is available.</div>
			}
			<p class="mt-3 text-xs text-muted-foreground">Signed-out sessions are retained for up to 30 days. Session tokens and internal identifiers are never shown. Signing out another session does not change its credentials.</p>
		</div>
		<div class="rounded-lg border bg-card p-6" data-security-events>
			<div class="mb-5">
				<h3 class="text-base font-semibold text-foreground">Security activity</h3>
				<p class="mt-1 text-sm text-muted-foreground">Review recent authentication and account-security events affecting this Gofer account.</p>
			</div>
			if len(data.SecurityEvents) > 0 {
				<ul class="divide-y divide-border rounded-md border border-border" aria-label="Recent security activity">
					for _, event := range data.SecurityEvents {
						<li class="grid gap-3 px-4 py-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
							<div class="min-w-0">
								<p class="break-words text-sm font-semibold text-foreground">{ event.Title }</p>
								<p class="mt-1 text-xs text-muted-foreground">{ event.Detail }</p>
								<p class="mt-2 text-xs text-muted-foreground">
									{ event.OccurredAt }
									if event.Client != "" {
										<span aria-hidden="true">· </span><span>From { event.Client }</span>
									}
								</p>
							</div>
							if event.Successful {
								<span class="w-fit rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:text-emerald-200">{ event.Status }</span>
							} else {
								<span class="w-fit rounded-full border border-destructive/30 bg-destructive/10 px-2.5 py-1 text-xs font-semibold text-destructive">{ event.Status }</span>
							}
						</li>
					}
				</ul>
				if data.SecurityEventsTruncated {
					<p class="mt-3 text-xs text-muted-foreground">Showing the 50 most recent security events. Older activity is omitted.</p>
				}
			} else {
				<div class="rounded-md border border-border bg-background/60 px-4 py-3 text-sm text-muted-foreground">No security activity is available yet.</div>
			}
			<p class="mt-3 text-xs text-muted-foreground">Only events affecting this Gofer account are shown. Raw audit metadata and internal identifiers are not displayed.</p>
		</div>
	</div>
}

templ SecurityManagementCancelForm(data PasswordSecurityData) {
	<form method="post" action="/settings/security/management/cancel">
		if data.CSRFTokens["/settings/security/management/cancel"] != "" {
			<input type="hidden" name="_csrf" value={ data.CSRFTokens["/settings/security/management/cancel"] }/>
		}
		<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">Cancel</button>
	</form>
}
