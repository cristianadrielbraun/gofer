package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"strconv"
)

templ MailCalendarFooter(emailID string, events []MailCalendarEventData) {
	if len(events) > 0 {
		<section class="border-t border-ink/10 px-6 py-3 space-y-4" aria-label={ i18n.T(ctx, "calendar.mail.events") }>
			for _, event := range events {
				<div class="space-y-2 text-sm text-ink">
					<div class="flex items-start gap-3">
						@icon.CalendarDays(icon.Props{Class: "mt-0.5 size-5 shrink-0 text-muted-foreground"})
						<div class="min-w-0 flex-1">
							<p class="text-[11px] font-medium text-muted-foreground">{ event.Kind }</p>
							<h2 class="font-semibold break-words">{ event.Summary }</h2>
						</div>
						<button type="button" class="shrink-0 text-xs text-muted-foreground hover:text-ink" hx-get={ "/api/mail/" + emailID + "/calendar?refresh=1" } hx-target="closest [data-mail-calendar-footer]" hx-swap="innerHTML" hx-sync="closest [data-mail-calendar-footer]:replace" hx-disabled-elt="this" aria-label={ i18n.T(ctx, "calendar.mail.refresh_label") }>{ i18n.T(ctx, "calendar.mail.refresh") }</button>
					</div>
					<div class="space-y-1 text-xs text-muted-foreground break-words">
						if event.Date != "" {
							<p>{ event.Date }</p>
						}
						if event.Time != "" {
							<p>{ event.Time }</p>
						}
						if event.Organizer != "" {
							<p>
								{ i18n.T(ctx, "calendar.mail.organizer") }
								if event.OrganizerName != "" {
									{ event.OrganizerName }
									·
								}
								{ event.Organizer }
							</p>
						}
						if event.Location != "" && event.Location != event.JoinURL {
							<p>{ event.Location }</p>
						}
						if event.Status != "" {
							<p class="font-medium text-ink" role="status">{ event.Status }</p>
						}
					</div>
					if event.JoinURL != "" || event.EventID != "" {
						<div class="flex flex-wrap items-center gap-3 text-xs">
							if event.JoinURL != "" {
								<a class="font-medium underline underline-offset-2" href={ templ.SafeURL(event.JoinURL) } target="_blank" rel="noopener noreferrer">{ i18n.T(ctx, "calendar.join_meeting") }</a>
							}
							if event.EventID != "" {
								<button type="button" class="font-medium underline underline-offset-2" data-calendar-event-trigger hx-get={ calendarEventDetailsURL(event.EventID) } hx-target="#app-pane-dialogs" hx-swap="innerHTML" hx-sync="#app-pane-dialogs:replace" hx-disabled-elt="this" aria-haspopup="dialog">{ i18n.T(ctx, "calendar.mail.open_event") }</button>
							}
						</div>
					}
					if event.Invitation != nil {
						<div class="space-y-1 text-xs" data-mail-calendar-invitation>
							if event.Invitation.Note != "" {
								<p class="text-muted-foreground">{ event.Invitation.Note }</p>
							}
							<button type="button" class="font-medium underline underline-offset-2" hx-post={ "/api/mail/" + emailID + "/calendar/invitation" } hx-vals={ mailCalendarInvitationValues(*event.Invitation) } hx-target="closest [data-mail-calendar-footer]" hx-swap="innerHTML" hx-sync="closest [data-mail-calendar-footer]:replace" hx-disabled-elt="this">{ event.Invitation.Label }</button>
						</div>
					}
					if event.Response != nil {
						<div data-mail-calendar-response data-calendar-response-container>
							@MailCalendarResponseForm(*event.Response)
						</div>
					} else if event.Note != "" {
						<p class="text-xs text-muted-foreground">{ event.Note }</p>
					}
				</div>
			}
		</section>
	}
}

templ MailCalendarResponseForm(data CalendarResponseData) {
	<form class="space-y-2" data-calendar-response-form data-calendar-event-id={ data.EventID } data-calendar-response-scope={ data.Scope } data-calendar-response-ready={ strconv.FormatBool(data.Ready) } hx-post={ calendarEventDetailsURL(data.EventID) + "/response" } hx-params="version,scope,response" hx-swap="none" hx-sync="this:drop">
		<input type="hidden" name="version" value={ data.Version }/>
		<input type="hidden" name="scope" value={ data.Scope }/>
		<div class="flex flex-wrap items-center gap-2" data-mail-calendar-response-summary hidden?={ mailCalendarResponseMessage(ctx, data.Status) == "" || data.MailResponseEditing }>
			<p class="text-sm" role="status" data-mail-calendar-response-message>{ mailCalendarResponseMessage(ctx, data.Status) }</p>
			<button type="button" class="text-xs text-muted-foreground underline underline-offset-2" data-mail-calendar-response-edit disabled?={ !data.Ready }>{ i18n.T(ctx, "calendar.mail.edit_response") }</button>
		</div>
		<div data-mail-calendar-response-editor hidden?={ mailCalendarResponseMessage(ctx, data.Status) != "" && !data.MailResponseEditing }>
			<div class="flex flex-wrap items-center gap-2" role="group" aria-label={ i18n.T(ctx, "calendar.response.respond") }>
				for _, status := range []string{"accepted", "tentative", "declined"} {
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantOutline, Disabled: !data.Ready, Attributes: templ.Attributes{"name": "response", "value": status, "data-calendar-response-choice": status, "data-mail-calendar-response-message": mailCalendarResponseMessage(ctx, status), "aria-pressed": strconv.FormatBool(data.Status == status)}}) {
						@CalendarResponseIcon(status)
						if status == "accepted" {
							{ i18n.T(ctx, "calendar.response.accept") }
						} else if status == "tentative" {
							{ i18n.T(ctx, "calendar.response.maybe") }
						} else {
							{ i18n.T(ctx, "calendar.response.reject") }
						}
					}
				}
				if mailCalendarResponseMessage(ctx, data.Status) != "" {
					<button type="button" class="text-xs text-muted-foreground underline underline-offset-2" data-mail-calendar-response-cancel disabled?={ !data.Ready }>{ i18n.T(ctx, "common.cancel") }</button>
				}
			</div>
			if data.HasOccurrence {
				<div class="flex flex-wrap gap-2" role="group" aria-label={ i18n.T(ctx, "calendar.response.scope") }>
					for _, scope := range []string{"occurrence", "series"} {
						<button type="button" data-calendar-response-load aria-pressed={ strconv.FormatBool(scope == data.Scope) } class="text-xs underline underline-offset-2 aria-pressed:font-semibold" hx-get={ calendarEventDetailsURL(data.EventID) + "/response?scope=" + scope + "&mail_id=" + data.MailMessageID + "&edit=1" } hx-target="closest [data-mail-calendar-response]" hx-swap="innerHTML" hx-params="none" hx-sync="closest [data-mail-calendar-response]:replace">
							if scope == "series" {
								{ i18n.T(ctx, "calendar.entire_series") }
							} else {
								{ i18n.T(ctx, "calendar.this_event") }
							}
						</button>
					}
				</div>
			} else if data.Scope == "series" {
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "calendar.mail.series_note") }</p>
			}
		</div>
		<p class="text-xs text-muted-foreground" data-calendar-response-progress role="status" aria-live="polite" hidden?={ mailCalendarResponseMessage(ctx, data.Status) != "" && !data.MailResponseEditing }>{ i18n.T(ctx, "calendar.response.sent_note") }</p>
		<p hidden data-calendar-response-error role="alert" tabindex="-1" class="text-xs text-destructive"></p>
		if !data.Ready {
			<button type="button" data-calendar-response-load class="text-xs text-muted-foreground underline underline-offset-2" hx-get={ calendarEventDetailsURL(data.EventID) + "/response?scope=" + data.Scope + "&mail_id=" + data.MailMessageID + mailCalendarResponseEditQuery(data.MailResponseEditing) } hx-trigger="load, click" hx-target="closest [data-mail-calendar-response]" hx-swap="innerHTML" hx-params="none" hx-sync="closest [data-mail-calendar-response]:replace">{ i18n.T(ctx, "calendar.response.check_invitation") }</button>
		}
	</form>
}
