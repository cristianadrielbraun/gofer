package views

import (
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// AdminOverviewPage is the console's front page.
templ AdminOverviewPage(data AdminOverviewData) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden" data-admin-overview>
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				@adminPageHeader(adminPageHeaderProps{Title: i18n.T(ctx, "admin.nav.overview"), Description: i18n.T(ctx, "admin.overview.description")})
				<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label={ i18n.T(ctx, "admin.users.summary") }>
					@adminStatCard(i18n.T(ctx, "admin.users.stat.active"), data.Active)
					@adminStatCard(i18n.T(ctx, "admin.users.stat.pending"), data.Pending)
					@adminStatCard(i18n.T(ctx, "admin.users.stat.disabled"), data.Disabled)
					@adminStatCard(i18n.T(ctx, "admin.users.stat.admins"), data.Administrators)
				</div>
				@adminSection(adminSectionProps{ID: "admin-overview-attention", Title: i18n.T(ctx, "admin.overview.attention")}) {
					if len(data.Attention) == 0 {
						<div class="flex items-center gap-3 px-4 py-6 text-sm text-muted-foreground">
							@icon.CircleCheck(icon.Props{Class: "size-5 text-emerald-600 dark:text-emerald-400"})
							{ i18n.T(ctx, "admin.overview.nothing") }
						</div>
					} else {
						<ul class="divide-y divide-border">
							for _, item := range data.Attention {
								<li>
									<a href={ templ.URL(item.Href) } data-admin-navigation-link class="flex items-center justify-between gap-4 px-4 py-3 text-sm text-foreground hover:bg-accent/35" data-admin-overview-item={ item.Key }>
										<span>{ i18n.N(ctx, "admin.overview.attention."+item.Key, item.Count, "count", i18n.Number(ctx, item.Count)) }</span>
										@icon.ChevronRight(icon.Props{Class: "size-4 shrink-0 text-muted-foreground"})
									</a>
								</li>
							}
						</ul>
					}
				}
				@adminSection(adminSectionProps{ID: "admin-overview-recent", Title: i18n.T(ctx, "admin.overview.recent"), Aside: adminOverviewAllChanges()}) {
					if data.RecentLocked {
						@adminEmptyState(i18n.T(ctx, "admin.overview.recent_locked"))
					} else if len(data.Recent) == 0 {
						@adminEmptyState(i18n.T(ctx, "admin.audit.empty"))
					} else {
						<div class="overflow-x-auto">
							<table class="w-full min-w-[48rem] text-left text-sm" aria-label={ i18n.T(ctx, "admin.overview.recent") }>
								<thead class="bg-muted/45 text-xs font-semibold text-muted-foreground">
									<tr>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.time") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.event") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.status") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.actor") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.client") }</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-border">
									for _, record := range data.Recent {
										@adminAuditRow(record)
									}
								</tbody>
							</table>
						</div>
					}
				}
			</div>
		</div>
	</div>
}

// adminOverviewAllChanges leads from the latest changes to all of them.
templ adminOverviewAllChanges() {
	<a href={ templ.URL(AdminAuditActivityPath) } data-admin-navigation-link class="shrink-0 whitespace-nowrap text-xs font-semibold text-primary hover:underline">{ i18n.T(ctx, "admin.overview.all_changes") }</a>
}
