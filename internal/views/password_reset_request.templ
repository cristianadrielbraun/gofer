package views

import "github.com/cristianadrielbraun/gofer/components/button"

// PasswordResetRequestData deliberately carries no submitted identifier into
// the generic confirmation state.
type PasswordResetRequestData struct {
	Submitted bool
	Message   string
}

templ PasswordResetRequestPage(data PasswordResetRequestData) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gofer — Request Password Reset</title>
			@AppIcon()
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm">
					<div class="text-center mb-8">
						<img src="/assets/logo.svg" alt="Gofer" class="h-12 w-auto mx-auto"/>
						if data.Submitted {
							<h1 class="mt-6 text-2xl font-semibold">Request received</h1>
							<p class="mt-2 text-sm text-muted-foreground">If that username belongs to a webmail user, an administrator can now issue a password-reset token.</p>
						} else {
							<h1 class="mt-6 text-2xl font-semibold">Request a password reset</h1>
							<p class="mt-2 text-sm text-muted-foreground">Enter your Gofer username. An administrator must issue the private reset token; Gofer will not send one by email.</p>
						}
					</div>
					if data.Message != "" {
						<div id="password-reset-request-error" role="alert" aria-live="polite" class="bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm mb-6">
							{ data.Message }
						</div>
					}
					if data.Submitted {
						<div role="status" class="rounded-lg border border-success/25 bg-success/10 px-5 py-5 text-sm leading-relaxed text-muted-foreground">
							For privacy, this confirmation is the same for every submitted username. Ask your administrator for the token, then enter it on the password page.
						</div>
						<div class="mt-6 space-y-3">
							@button.Button(button.Props{Href: "/account/redeem", FullWidth: true}) {
								Enter reset token
							}
							@button.Button(button.Props{Href: "/login", Variant: button.VariantOutline, FullWidth: true}) {
								Back to sign in
							}
						</div>
					} else {
						<form method="post" action="/account/recover" class="space-y-4">
							<div class="space-y-2">
								<label for="password-reset-identifier" class="text-sm font-medium">Username</label>
								<input
									id="password-reset-identifier"
									name="identifier"
									type="text"
									autocomplete="username"
									autocapitalize="none"
									spellcheck="false"
									required
									autofocus
									if data.Message != "" {
										aria-invalid="true"
										aria-describedby="password-reset-request-error"
									}
									class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20"
								/>
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
								Request password reset token
							}
						</form>
						<div class="relative my-6">
							<div class="absolute inset-0 flex items-center" aria-hidden="true"><div class="w-full border-t border-border"></div></div>
							<div class="relative flex justify-center"><span class="bg-background px-3 text-xs uppercase tracking-wide text-muted-foreground">or</span></div>
						</div>
						<div class="space-y-3">
							@button.Button(button.Props{Href: "/account/redeem", Variant: button.VariantOutline, FullWidth: true}) {
								I already have a reset token
							}
							@button.Button(button.Props{Href: "/login", Variant: button.VariantOutline, FullWidth: true}) {
								Back to sign in
							}
						</div>
					}
				</div>
			</main>
		</body>
	</html>
}
