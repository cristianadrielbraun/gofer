package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"fmt"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

// SettingsLocalFoldersCard is Local folders in the Accounts settings list:
// its place and color, whether it's enabled, and a reminder that its mail
// is kept only on this server. Disabled, it leaves the sidebar, the unified
// folders, search and the places mail can go, but keeps its mail.
templ SettingsLocalFoldersCard(account models.Account) {
	<div
		id={ fmt.Sprintf("account-card-%s", account.ID) }
		data-settings-account-card
		data-local-folders-card
		data-account-id={ account.ID }
		data-account-deleting="false"
		class="transition-[opacity,transform] duration-200 ease-out"
	>
		<div class="settings-account-card settings-item rounded-lg border border-border/60 bg-background/40 p-4 space-y-3">
			<div class="flex items-start justify-between gap-3">
				<div class="flex min-w-0 items-start gap-3">
					@SettingsAccountOrderHandle(account)
					@AccountColorPopover(account)
					<div class="min-w-0">
						<p class="truncate text-sm font-semibold text-foreground">{ account.Name }</p>
						<p class="mt-0.5 text-xs text-muted-foreground">{ i18n.T(ctx, "settings.local_folders.description") }</p>
					</div>
				</div>
				<div class="flex shrink-0 items-center gap-3" data-account-actions>
					<form
						hx-post={ fmt.Sprintf("/api/accounts/%s/shown", account.ID) }
						hx-trigger="change"
						hx-swap="none"
					>
						<div class="flex items-center gap-2 text-xs text-muted-foreground">
							<span class="hidden sm:inline">{ i18n.T(ctx, "settings.switch.enabled") }</span>
							@switchcomp.Switch(switchcomp.Props{
								Name:       "shown",
								Value:      "true",
								Checked:    !account.Hidden,
								Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "settings.local_folders.enable", "name", account.Name)},
							})
						</div>
					</form>
					@dropdown.Dropdown(dropdown.Props{ID: fmt.Sprintf("account-actions-menu-%s", account.ID)}) {
						@dropdown.Trigger() {
							@button.Button(button.Props{
								Variant:    button.VariantOutline,
								Size:       button.SizeIcon,
								Class:      "account-action-btn size-[30px] text-muted-foreground hover:text-foreground shadow-none",
								Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "settings.local_folders.more_actions", "name", account.Name)},
							}) {
								@icon.EllipsisVertical(icon.Props{Class: "size-4"})
							}
						}
						@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "mobile-sheet w-48 normal-case tracking-normal", Attributes: templ.Attributes{"data-account-actions-menu": account.ID}}) {
							@SettingsAccountMoveItem("up")
							@SettingsAccountMoveItem("down")
						}
					}
				</div>
			</div>
			<div class="flex items-start gap-2.5 rounded-md border border-border/60 bg-muted/40 p-3 text-xs leading-relaxed text-muted-foreground">
				@icon.Info(icon.Props{Class: "mt-0.5 size-3.5 shrink-0"})
				<p>
					{ i18n.T(ctx, "settings.local_folders.stored") }
					<a
						href="/settings/export-import"
						hx-get="/settings/export-import"
						hx-target="#settings-content"
						hx-select="#settings-content"
						hx-swap="outerHTML"
						hx-push-url="/settings/export-import"
						class="font-medium text-foreground underline underline-offset-2 hover:no-underline"
					>{ i18n.T(ctx, "settings.local_folders.export") }</a> { i18n.T(ctx, "settings.local_folders.backup") }
				</p>
			</div>
		</div>
	</div>
}
