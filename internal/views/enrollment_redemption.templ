package views

import (
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

type InvitationEnrollmentData struct {
	Message              string
	GoogleLoginAvailable bool
}

type CredentialRedemptionData struct {
	Message string
}

templ InvitationEnrollmentPage(data InvitationEnrollmentData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "signin.title.invite") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<h1 class="mt-6 text-2xl font-semibold">{ i18n.T(ctx, "signin.enroll_invite.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "signin.enroll_invite.description") }</p>
					</div>
					if data.Message != "" {
						<div id="enrollment-error" role="alert" aria-live="polite" class="bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm mb-6">
							{ data.Message }
						</div>
					}
					<form method="post" action="/account/enroll" class="space-y-4">
						<div class="space-y-2">
							<label for="enrollment-token" class="text-sm font-medium">{ i18n.T(ctx, "signin.enroll_invite.token") }</label>
							<input
								id="enrollment-token"
								name="token"
								type="password"
								autocomplete="one-time-code"
								autocapitalize="none"
								spellcheck="false"
								required
								autofocus
								if data.Message != "" {
									aria-invalid="true"
									aria-describedby="enrollment-error enrollment-token-help"
								} else {
									aria-describedby="enrollment-token-help"
								}
								class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20"
							/>
							<p id="enrollment-token-help" class="text-xs leading-relaxed text-muted-foreground"><span class="font-semibold text-foreground">{ i18n.T(ctx, "signin.enroll_invite.token_required") }</span> { i18n.T(ctx, "signin.enroll_invite.token_help") }</p>
						</div>
						<p class="pt-2 text-sm font-semibold">{ i18n.T(ctx, "signin.enroll_invite.choose") }</p>
						<div class="space-y-2">
							<label for="enrollment-password" class="text-sm font-medium">{ i18n.T(ctx, "signin.enroll_invite.create_password") }</label>
							<input
								id="enrollment-password"
								name="new_password"
								type="password"
								autocomplete="new-password"
								minlength="15"
								maxlength="256"
								required
								aria-describedby="enrollment-password-help"
								class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50"
							/>
							<p id="enrollment-password-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "signin.password_help") }</p>
						</div>
						<div class="space-y-2">
							<label for="enrollment-password-confirmation" class="text-sm font-medium">{ i18n.T(ctx, "setup.password.confirm") }</label>
							<input
								id="enrollment-password-confirmation"
								name="confirm_password"
								type="password"
								autocomplete="new-password"
								minlength="15"
								maxlength="256"
								required
								class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50"
							/>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							{ i18n.T(ctx, "signin.enroll_invite.with_password") }
						}
						if data.GoogleLoginAvailable {
							<div class="relative py-1" aria-hidden="true">
								<div class="absolute inset-0 flex items-center"><div class="w-full border-t border-border"></div></div>
								<div class="relative flex justify-center"><span class="bg-background px-3 text-xs uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "signin.or") }</span></div>
							</div>
							@button.Button(button.Props{
								Type: button.TypeSubmit, Variant: button.VariantOutline, FullWidth: true,
								Attributes: templ.Attributes{"formaction": "/account/enroll/google", "formnovalidate": true},
							}) {
								{ i18n.T(ctx, "signin.enroll_invite.with_google") }
							}
							<p class="text-xs leading-relaxed text-muted-foreground">
								{ i18n.T(ctx, "signin.enroll_invite.google_note") }
							</p>
						}
					</form>
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "signin.enroll_invite.note") }</p>
					<div class="mt-4">
						@button.Button(button.Props{Href: "/login", Variant: button.VariantOutline, FullWidth: true}) {
							{ i18n.T(ctx, "signin.back") }
						}
					</div>
				</div>
			</main>
		</body>
	</html>
}

templ CredentialRedemptionPage(data CredentialRedemptionData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "signin.title.redeem") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<h1 class="mt-6 text-2xl font-semibold">{ i18n.T(ctx, "signin.redeem.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "signin.redeem.description") }</p>
					</div>
					if data.Message != "" {
						<div id="redemption-error" role="alert" aria-live="polite" class="bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm mb-6">
							{ data.Message }
						</div>
					}
					<form method="post" action="/account/redeem" class="space-y-4">
						<div class="space-y-2">
							<label for="redemption-token" class="text-sm font-medium">{ i18n.T(ctx, "signin.redeem.token") }</label>
							<input
								id="redemption-token"
								name="token"
								type="password"
								autocomplete="one-time-code"
								autocapitalize="none"
								spellcheck="false"
								required
								autofocus
								if data.Message != "" {
									aria-invalid="true"
									aria-describedby="redemption-error"
								}
								class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20"
							/>
						</div>
						<div class="space-y-2">
							<label for="redemption-password" class="text-sm font-medium">{ i18n.T(ctx, "signin.change.new") }</label>
							<input
								id="redemption-password"
								name="new_password"
								type="password"
								autocomplete="new-password"
								minlength="15"
								maxlength="256"
								required
								aria-describedby="redemption-password-help"
								class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50"
							/>
							<p id="redemption-password-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "signin.password_help") }</p>
						</div>
						<div class="space-y-2">
							<label for="redemption-password-confirmation" class="text-sm font-medium">{ i18n.T(ctx, "signin.change.confirm") }</label>
							<input
								id="redemption-password-confirmation"
								name="confirm_password"
								type="password"
								autocomplete="new-password"
								minlength="15"
								maxlength="256"
								required
								class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50"
							/>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							{ i18n.T(ctx, "signin.redeem.submit") }
						}
					</form>
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "signin.redeem.note") }</p>
					<div class="mt-4">
						@button.Button(button.Props{Href: "/login", Variant: button.VariantOutline, FullWidth: true}) {
							{ i18n.T(ctx, "signin.back") }
						}
					</div>
				</div>
			</main>
		</body>
	</html>
}

templ InvitationEnrollmentCompletePage() {
	@passwordTokenCompletePage(i18n.T(ctx, "signin.enroll_invite.done_title"), i18n.T(ctx, "signin.enroll_invite.done"))
}

templ CredentialRedemptionCompletePage() {
	@passwordTokenCompletePage(i18n.T(ctx, "signin.redeem.done_title"), i18n.T(ctx, "signin.redeem.done"))
}

templ passwordTokenCompletePage(title string, message string) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>Gofer - { title }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm text-center">
					<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
					<div role="status" class="mt-8 rounded-lg border border-success/25 bg-success/10 px-5 py-6">
						<h1 class="text-2xl font-semibold">{ title }</h1>
						<p class="mt-3 text-sm text-muted-foreground">{ message }</p>
					</div>
					<div class="mt-8">
						@button.Button(button.Props{Href: "/login", FullWidth: true}) {
							{ i18n.T(ctx, "signin.back") }
						}
					</div>
				</div>
			</main>
		</body>
	</html>
}
