package views

import (
	"fmt"
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/skeleton"
	"github.com/cristianadrielbraun/gofer/internal/models"
	"sort"
	"strings"
)

// MailboxSizeDialog is filled with an account's MailboxSizeDetails when a
// [data-mailbox-size-account] control is clicked (actions.js). The loading
// state shows only when the details weren't loaded ahead.
templ MailboxSizeDialog() {
	@dialog.Dialog(dialog.Props{ID: "mailbox-size-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
			@dialog.Header() {
				@dialog.Title() {
					Mailbox size
				}
				@dialog.Description(dialog.DescriptionProps{Attributes: templ.Attributes{"data-mailbox-size-account-name": ""}})
			}
			// The panel is a grid; without min-w-0 a long folder path widens it
			// instead of being cut short.
			<div class="min-w-0" data-mailbox-size-body></div>
			<template data-mailbox-size-loading>
				@mailboxSizeLoading()
			</template>
			<template data-mailbox-size-error>
				<p class="text-sm text-muted-foreground">Couldn't add up this account's size. Try again in a moment.</p>
			</template>
		}
	}
}

// mailboxSizeLoading has the shape of MailboxSizeDetails.
templ mailboxSizeLoading() {
	<div class="space-y-4" aria-busy="true">
		<div class="rounded-lg border border-border bg-muted/30 px-4 py-3">
			<div class="flex h-8 items-center">
				@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-28"})
			</div>
			<div class="mt-0.5 flex h-4 items-center">
				@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-48"})
			</div>
		</div>
		<div>
			<div class="mb-1.5 flex h-4 items-center">
				@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-32"})
			</div>
			<ul class="-mx-1 max-h-[45vh] space-y-1 overflow-hidden px-1">
				for range 6 {
					<li class="px-2 py-2">
						<div class="flex h-5 items-center gap-2.5">
							@skeleton.Skeleton(skeleton.Props{Class: "mx-0.5 size-4 shrink-0"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-3.5 w-36"})
							@skeleton.Skeleton(skeleton.Props{Class: "ml-auto h-3.5 w-14"})
						</div>
						@skeleton.Skeleton(skeleton.Props{Class: "mt-1.5 ml-[30px] h-1"})
					</li>
				}
			</ul>
		</div>
		<div class="flex h-4 items-center">
			@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-4/5"})
		</div>
	</div>
}

// MailboxSizeDetails marks no folder; actions.js sets data-mailbox-size-marked
// on the folder the dialog was opened from.
templ MailboxSizeDetails(size models.MailboxSize) {
	{{ rows := mailboxSizeRows(size) }}
	<div class="space-y-4" data-mailbox-size-details data-account-name={ mailboxSizeAccountName(size.Account) }>
		<div class="flex items-end justify-between gap-4 rounded-lg border border-border bg-muted/30 px-4 py-3">
			<div class="min-w-0">
				<p class="text-2xl font-semibold tabular-nums">{ formatMailboxBytes(size.Total.Bytes) }</p>
				<p class="mt-0.5 text-xs text-muted-foreground">on the mail server · { mailExportCount(size.Total.Messages, "message", "messages") }</p>
			</div>
			if size.HasLocal {
				<div class="shrink-0 text-right">
					<p class="text-lg font-semibold tabular-nums">{ formatMailboxBytes(size.Total.LocalBytes) }</p>
					<p class="mt-0.5 text-xs text-muted-foreground">on this device</p>
				</div>
			}
		</div>
		if size.Total.Unmeasured > 0 {
			<p class="flex items-start gap-1.5 text-xs text-muted-foreground">
				@icon.Info(icon.Props{Class: "mt-0.5 size-3.5 shrink-0"})
				<span>{ mailboxSizeUnmeasuredNote(size.Total.Unmeasured) }</span>
			</p>
		}
		if len(rows) > 0 {
			<div>
				<p class="mb-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Folders, largest first</p>
				<ul class="-mx-1 max-h-[45vh] space-y-1 overflow-y-auto px-1">
					for _, row := range rows {
						@mailboxSizeFolderRow(row, size.Total.Bytes)
					}
				</ul>
				if size.LocalOutsideFolders > 0 {
					<p class="mt-1.5 px-2 text-[11px] text-muted-foreground">
						Not in any folder: <span class="tabular-nums">{ formatMailboxBytes(size.LocalOutsideFolders) }</span> on this device
					</p>
				}
			</div>
		}
		<p class="text-xs leading-relaxed text-muted-foreground">
			Server sizes are what the mail server reports. On this device is what Gofer has downloaded: message bodies, attachments and images.
			if mailboxSizeFoldersOverlap(size, rows) {
				A message in more than one folder counts in each, so the folders add up to more than the total.
			}
		</p>
	</div>
}

templ mailboxSizeFolderRow(row mailboxSizeRow, totalBytes int64) {
	<li
		class="rounded-md px-2 py-2 data-[mailbox-size-marked]:bg-accent data-[mailbox-size-marked]:ring-1 data-[mailbox-size-marked]:ring-primary/30"
		data-mailbox-size-folder={ row.Folder.ID }
	>
		<div class="flex items-center gap-2.5">
			<span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
				@SidebarFolderIcon(row.Folder.Icon)
			</span>
			<span class="flex min-w-0 flex-1 items-baseline gap-1.5">
				<span class="min-w-0 truncate text-sm">{ row.Path }</span>
				if row.Count.Messages > 0 {
					<span class="shrink-0 text-[11px] text-muted-foreground tabular-nums">· { mailExportCount(row.Count.Messages, "message", "messages") }</span>
				}
			</span>
			if row.Count.Messages == 0 {
				<span class="shrink-0 text-xs text-muted-foreground">Empty</span>
			} else {
				if row.Count.LocalBytes > 0 {
					<span class="shrink-0 text-[11px] text-muted-foreground tabular-nums">{ formatMailboxBytes(row.Count.LocalBytes) } locally ·</span>
				}
				<span class="shrink-0 text-sm font-medium tabular-nums">{ formatMailboxBytes(row.Count.Bytes) }</span>
			}
		</div>
		if row.Count.Messages > 0 {
			<div class="mt-1.5 h-1 overflow-hidden rounded-full bg-secondary ml-[30px]">
				<div class="h-full rounded-full bg-primary" style={ mailboxSizeBarStyle(row.Count.Bytes, totalBytes) }></div>
			</div>
		}
	</li>
}

// AccountMailboxSizeSummary is the line on an account's settings card. It
// brings the account's details along, so See usage opens them at once.
templ AccountMailboxSizeSummary(size models.MailboxSize) {
	@accountMailboxSizeLine(size.Account.ID, &size, nil)
}

// SettingsAccountMailboxSize loads the account's size after the settings page
// shows, so a large mailbox doesn't hold the page up. Until then the line
// shows with only its numbers missing; actions.js slides them in.
templ SettingsAccountMailboxSize(account models.Account) {
	<div class="mt-3 flex items-center gap-3 border-t border-border/60 pt-2.5">
		<p class="shrink-0 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">Mailbox size</p>
		@accountMailboxSizeLine(account.ID, nil, templ.Attributes{
			"data-mailbox-size-loading": "",
			"aria-busy":                 "true",
			"hx-get":                    fmt.Sprintf("/api/accounts/%s/mailbox-size?view=summary", account.ID),
			"hx-trigger":                "load",
			"hx-swap":                   "outerHTML",
		})
	</div>
}

// accountMailboxSizeLine shows skeletons for the numbers while size is nil.
// It expects room on this device to be counted, as it is for the owner's
// accounts.
templ accountMailboxSizeLine(accountID string, size *models.MailboxSize, attrs templ.Attributes) {
	<div class="flex h-6 min-w-0 flex-1 items-center justify-between gap-2" data-account-mailbox-size={ accountID } { attrs... }>
		{{ server, local := "", "" }}
		if size != nil {
			{{ server, local = formatMailboxBytes(size.Total.Bytes), formatMailboxBytes(size.Total.LocalBytes) }}
		}
		<div class="min-w-0 truncate text-xs text-muted-foreground">
			@accountMailboxSizeNumber("server", server)
			<span class="hidden sm:inline">{ " on the server" }</span>
			if size == nil || size.HasLocal {
				<span class="hidden sm:inline">
					{ " · " }
					@accountMailboxSizeNumber("local", local)
					{ " on this device" }
				</span>
			}
		</div>
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Size:       button.SizeSm,
			Class:      "h-6 shrink-0 gap-1 px-2 text-xs",
			Attributes: templ.Attributes{"data-mailbox-size-account": accountID},
		}) {
			@icon.ChartPie(icon.Props{Class: "size-3.5"})
			See usage
		}
		if size != nil {
			<template data-mailbox-size-prefetched={ accountID }>
				@MailboxSizeDetails(*size)
			</template>
		}
	</div>
}

// accountMailboxSizeNumber is a skeleton while text is empty.
templ accountMailboxSizeNumber(name, text string) {
	<span class="inline-block whitespace-nowrap align-baseline font-semibold text-foreground tabular-nums" data-mailbox-size-number={ name }>
		if text == "" {
			@skeleton.Skeleton(skeleton.Props{Class: "inline-block h-3 w-12 align-[-1px]"})
		} else {
			{ text }
		}
	</span>
}

type mailboxSizeRow struct {
	Folder models.Folder
	Path   string
	Count  models.MailboxSizeCount
}

// mailboxSizeRows lists the folders of the sidebar's tree, largest first.
func mailboxSizeRows(size models.MailboxSize) []mailboxSizeRow {
	var rows []mailboxSizeRow
	var walk func(folders []models.Folder, parent string)
	walk = func(folders []models.Folder, parent string) {
		for _, folder := range folders {
			path := folder.Name
			if parent != "" {
				path = parent + " / " + folder.Name
			}
			rows = append(rows, mailboxSizeRow{Folder: folder, Path: path, Count: size.Folders[folder.ID]})
			walk(folder.Children, path)
		}
	}
	walk(size.Account.Folders, "")
	sort.SliceStable(rows, func(i, j int) bool {
		if rows[i].Count.Bytes != rows[j].Count.Bytes {
			return rows[i].Count.Bytes > rows[j].Count.Bytes
		}
		return rows[i].Count.Messages > rows[j].Count.Messages
	})
	return rows
}

func mailboxSizeFoldersOverlap(size models.MailboxSize, rows []mailboxSizeRow) bool {
	messages := 0
	for _, row := range rows {
		messages += row.Count.Messages
	}
	return messages > size.Total.Messages
}

func mailboxSizeAccountName(account models.Account) string {
	name := strings.TrimSpace(account.Name)
	if name == "" || strings.EqualFold(name, account.Email) {
		return account.Email
	}
	return name + " · " + account.Email
}

func mailboxSizeUnmeasuredNote(n int) string {
	if n == 1 {
		return "1 message hasn't been measured yet, so the mailbox is a little larger than this."
	}
	return mailExportNumber(n) + " messages haven't been measured yet, so the mailbox is a little larger than this."
}

func mailboxSizeBarStyle(bytes, total int64) string {
	percent := 0.0
	if total > 0 {
		percent = float64(bytes) * 100 / float64(total)
	}
	// Tiny folders still show a sliver.
	if bytes > 0 && percent < 0.5 {
		percent = 0.5
	}
	return fmt.Sprintf("width: %.1f%%", percent)
}

func formatMailboxBytes(n int64) string {
	switch {
	case n >= 1<<30:
		return fmt.Sprintf("%.1f GB", float64(n)/(1<<30))
	case n >= 1<<20:
		return fmt.Sprintf("%.1f MB", float64(n)/(1<<20))
	case n >= 1<<10:
		return fmt.Sprintf("%d KB", n>>10)
	}
	return fmt.Sprintf("%d B", n)
}
