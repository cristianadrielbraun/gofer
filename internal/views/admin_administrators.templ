package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// AdminAdministratorsPath lists the console's administrators.
const AdminAdministratorsPath = "/admin/administrators"

// AdminAdministratorsData is the Administrators page: everyone who runs
// this Gofer, with how they sign in, and what the page is showing over the
// list.
type AdminAdministratorsData struct {
	Administrators []AdminAdministratorData
	// Invitation is the invitation dialog's state; it always invites an
	// administrator from here.
	Invitation AdminUsersData
	Dialog          *AdminUserDialog
	Result          *AdminUserInvitationData
	CredentialReset *AdminUserCredentialResetData
	// StepUpRequired is a session that must verify again before a change.
	StepUpRequired bool
}

// AdminAdministratorData is one administrator: their row on the Users
// list, which the actions menu is drawn from, and how they sign in.
type AdminAdministratorData struct {
	User              AdminUserData
	HasSecondFactor   bool
	Passkeys          int
	RecoveryCodesLeft int
	WorkingSessions   int
}

templ AdminAdministratorsPage(data AdminAdministratorsData, verification ...AdminSecurityVerificationData) {
	<div
		class="flex-1 flex flex-col min-w-0 overflow-hidden"
		data-admin-administrators
		if adminSecurityVerificationValue(verification).Required {
			hx-headers={ adminVerificationOnPageHeaders }
		}
	>
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				@adminPageHeader(adminPageHeaderProps{Title: i18n.T(ctx, "admin.nav.administrators"), Description: i18n.T(ctx, "admin.administrators.description"), Actions: adminAdministratorsHeaderActions()})
				@AdminUserInvitationDialog(data.Invitation)
				if data.Result != nil {
					@AdminUserInvitationResultDialog(data.Result)
				}
				if data.CredentialReset != nil {
					@AdminUserCredentialResetResultDialog(data.CredentialReset)
				}
				<div id={ adminUserDialogSlotID }>
					if data.Dialog != nil {
						@AdminUserActionDialog(*data.Dialog)
					}
				</div>
				@adminSection(adminSectionProps{ID: "admin-administrators-heading", Title: i18n.T(ctx, "admin.administrators.heading"), Aside: adminSectionNote(i18n.N(ctx, "admin.administrators.count", len(data.Administrators), "count", i18n.Number(ctx, len(data.Administrators))))}) {
					<div class="overflow-x-auto">
						<table class="w-full min-w-[56rem] text-left text-sm">
							<thead class="bg-muted/45 text-xs font-semibold text-muted-foreground">
								<tr>
									<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.administrators.col.administrator") }</th>
									<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.status") }</th>
									<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.methods") }</th>
									<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.last_sign_in") }</th>
									<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.user.sessions") }</th>
									<th scope="col" class="px-4 py-3 text-right">{ i18n.T(ctx, "admin.col.actions") }</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-border">
								for _, administrator := range data.Administrators {
									@adminAdministratorRow(administrator)
								}
							</tbody>
						</table>
					</div>
				}
				<p class="mt-4 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.administrators.note") }</p>
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

templ adminAdministratorsHeaderActions() {
	@dialog.Trigger(dialog.TriggerProps{For: "admin-user-invitation-dialog"}) {
		@button.Button() {
			@icon.UserPlus(icon.Props{Class: "size-4"})
			{ i18n.T(ctx, "admin.administrators.invite") }
		}
	}
}

templ adminAdministratorRow(administrator AdminAdministratorData) {
	{{ user := administrator.User }}
	<tr class="bg-background/35 align-top hover:bg-accent/35" data-admin-administrator>
		<td class="px-4 py-3">
			<div class="flex flex-wrap items-center gap-2">
				<a href={ templ.SafeURL(AdminUserPagePath(user.ID, AdminUserTabOverview, AdminAdministratorsPath)) } class="whitespace-nowrap font-semibold text-foreground hover:underline">{ adminUserUsername(ctx, user.Username) }</a>
				if user.Current {
					@adminTag(adminToneInfo) {
						{ i18n.T(ctx, "admin.users.you") }
					}
				}
			</div>
		</td>
		<td class="px-4 py-3">
			@adminUserStatusBadge(user)
			if user.Status == "pending" && user.InvitationState != "" {
				<p class="mt-2">
					@adminBadge(adminUserInvitationTone(user.InvitationState)) {
						{ adminUserInvitationStateLabel(ctx, user.InvitationState) }
					}
				</p>
				if user.InvitationExpiresAt != nil {
					<p class="mt-1 whitespace-nowrap text-xs text-muted-foreground">
						if user.InvitationState == "active" {
							{ i18n.T(ctx, "admin.invite.expires", "date", adminUserDate(ctx, user.InvitationExpiresAt)) }
						} else {
							{ i18n.T(ctx, "admin.invite.expired_at", "date", adminUserDate(ctx, user.InvitationExpiresAt)) }
						}
					</p>
				}
			}
		</td>
		<td class="px-4 py-3">
			if user.Status == "pending" {
				<span class="text-xs text-muted-foreground">—</span>
			} else {
				<div class="flex flex-col items-start gap-1.5">
					if administrator.HasSecondFactor {
						@adminBadge(adminToneSuccess) {
							{ i18n.T(ctx, "admin.user.authenticator_app") }
						}
					} else {
						@adminBadge(adminToneWarning, templ.Attributes{"data-admin-administrator-no-2fa": ""}) {
							{ i18n.T(ctx, "admin.administrators.no_second_factor") }
						}
					}
					<p class="whitespace-nowrap text-xs text-muted-foreground">
						{ i18n.N(ctx, "admin.user.passkey_count", administrator.Passkeys, "count", i18n.Number(ctx, administrator.Passkeys)) }
						· { i18n.N(ctx, "admin.administrators.recovery_left", administrator.RecoveryCodesLeft, "count", i18n.Number(ctx, administrator.RecoveryCodesLeft)) }
					</p>
				</div>
			}
		</td>
		<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">
			if user.LastSignInAt != nil {
				{ adminUserDate(ctx, user.LastSignInAt) }
			} else {
				{ i18n.T(ctx, "admin.users.never_signed_in") }
			}
		</td>
		<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">
			if administrator.WorkingSessions == 0 {
				{ i18n.T(ctx, "admin.user.no_sessions") }
			} else {
				<a href={ templ.SafeURL(AdminUserPagePath(user.ID, AdminUserTabSessions, AdminAdministratorsPath)) } class="font-medium text-primary hover:underline">
					{ i18n.N(ctx, "admin.user.session_count", administrator.WorkingSessions, "count", i18n.Number(ctx, administrator.WorkingSessions)) }
				</a>
			}
		</td>
		<td class="px-4 py-3 text-right">
			if entries := adminUserMenuEntries(ctx, user); len(entries) == 0 {
				<span class="text-xs text-muted-foreground">—</span>
			} else {
				@adminUserActionsMenu(user, entries)
			}
		</td>
	</tr>
}
