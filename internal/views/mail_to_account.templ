package views

import (
	"context"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"strings"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/radio"
)

// MailToAccountDialogData describes emails about to go into a folder of
// another account. Problem, when set, says why they can't. ToLocal says the
// folder is in Local folders, where moving them is mostly to free space on
// the server, so deleting them there for good is offered first.
type MailToAccountDialogData struct {
	Count   int
	Sources []string
	Target  string
	Folder  string
	Problem string
	ToLocal bool
}

// MailToAccountDialog asks before emails go into another account, and
// whether they then leave the account they're in.
templ MailToAccountDialog(data MailToAccountDialogData) {
	{{ mode := mailToAccountDefaultMode(data) }}
	@dialog.Dialog(dialog.Props{ID: "mail-to-account-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg", Attributes: templ.Attributes{"data-mail-to-account-dialog": ""}}) {
			@dialog.Header() {
				@dialog.Title() {
					if data.Problem != "" {
						{ i18n.T(ctx, "mail.to_account.cannot") }
					} else {
						{ i18n.T(ctx, "mail.to_account.title") }
					}
				}
			}
			if data.Problem != "" {
				<p class="min-w-0 text-sm text-muted-foreground [overflow-wrap:anywhere]" data-mail-to-account-problem>{ data.Problem }</p>
			} else {
				<div class="min-w-0 space-y-3 text-sm text-foreground [overflow-wrap:anywhere]">
					<div class="flex items-start gap-2.5 rounded-md border border-amber-500/40 bg-amber-500/10 p-3">
						@icon.TriangleAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400"})
						<p>
							{ mailToAccountSummary(ctx, data) }
						</p>
					</div>
					<div class="space-y-2" role="radiogroup" aria-label={ i18n.T(ctx, "mail.to_account.mode_label") } data-mail-to-account-modes>
						{{ sources := mailToAccountSources(ctx, data.Sources) }}
						@mailToAccountMode("move", i18n.T(ctx, "mail.to_account.move"), i18n.T(ctx, "mail.to_account.move_detail", "target", data.Target, "sources", sources), mode)
						@mailToAccountMode("move-delete", i18n.T(ctx, "mail.to_account.move_delete"), i18n.T(ctx, "mail.to_account.move_delete_detail", "target", data.Target, "sources", sources), mode)
						@mailToAccountMode("copy", i18n.T(ctx, "mail.to_account.copy"), i18n.T(ctx, "mail.to_account.copy_detail", "target", data.Target, "sources", sources), mode)
					</div>
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "mail.to_account.background") }</p>
				</div>
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "h-8 px-3 text-xs"}) {
						{ i18n.T(ctx, "common.cancel") }
					}
				}
				if data.Problem == "" {
					@button.Button(button.Props{
						Class:      "h-8 px-3 text-xs",
						Attributes: templ.Attributes{"data-mail-to-account-confirm": "", "data-on-click": onAction("confirmMessagesToAccount")},
					}) {
						{ mailToAccountModeButton(ctx, mode) }
					}
				}
			}
		}
	}
}

templ mailToAccountMode(value, label, detail, selected string) {
	<label class="flex items-start gap-2.5 text-sm text-foreground">
		<span class="mt-0.5 flex shrink-0">
			@radio.Radio(radio.Props{
				Name:       "mail-to-account-mode",
				Value:      value,
				Checked:    value == selected,
				Attributes: templ.Attributes{"data-mail-to-account-mode": value, "data-mail-to-account-button": mailToAccountModeButton(ctx, value), "data-on-change": onAction("chooseMessagesToAccountMode", actionElement)},
			})
		</span>
		<span>
			<span class="font-medium">{ label }</span>
			<span class="block text-xs text-muted-foreground mt-0.5">{ detail }</span>
		</span>
	</label>
}

// mailToAccountDefaultMode is the choice the dialog opens with: a plain move,
// or for Local folders a move that deletes the emails for good.
func mailToAccountDefaultMode(data MailToAccountDialogData) string {
	if data.ToLocal {
		return "move-delete"
	}
	return "move"
}

// mailToAccountModeButton is the confirm button's label for a choice.
func mailToAccountModeButton(ctx context.Context, mode string) string {
	switch mode {
	case "move-delete":
		return i18n.T(ctx, "mail.to_account.button_move_delete")
	case "copy":
		return i18n.T(ctx, "mail.to_account.copy")
	}
	return i18n.T(ctx, "mail.to_account.move")
}

// mailToAccountSources joins the accounts the emails come from: "a and b".
func mailToAccountSources(ctx context.Context, sources []string) string {
	if len(sources) < 2 {
		return strings.Join(sources, "")
	}
	return i18n.T(ctx, "mail.to_account.and", "first", settingsJoinComma(ctx, sources[:len(sources)-1]), "last", sources[len(sources)-1])
}

func mailToAccountSummary(ctx context.Context, data MailToAccountDialogData) string {
	args := []any{"sources", mailToAccountSources(ctx, data.Sources), "folder", data.Folder, "target", data.Target}
	if data.Count <= 0 {
		return i18n.T(ctx, "mail.to_account.summary_some", args...)
	}
	return i18n.N(ctx, "mail.to_account.summary", data.Count, append(args, "count", i18n.Number(ctx, data.Count))...)
}
