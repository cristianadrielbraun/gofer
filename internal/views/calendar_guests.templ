package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/internal/models"
	"net/mail"
)

templ CalendarGuestSuggestions(contacts []models.Contact) {
	for _, contact := range contacts {
		if contact.Email != "" {
			@button.Button(button.Props{ID: "calendar-guest-" + contact.ID, Type: button.TypeButton, Variant: button.VariantGhost, Class: "h-auto w-full justify-start gap-2 rounded-sm px-2 py-1.5 text-left font-normal data-[calendar-guest-active=true]:bg-accent data-[calendar-guest-active=true]:text-accent-foreground", Attributes: templ.Attributes{"role": "option", "tabindex": "-1", "aria-selected": "false", "data-calendar-guest-value": (&mail.Address{Name: contact.Name, Address: contact.Email}).String(), "onclick": "selectCalendarGuest(this)"}}) {
				<span class="truncate font-semibold">{ contact.Name }</span>
				<span class="truncate text-xs text-muted-foreground">{ contact.Email }</span>
			}
		}
	}
}
