package views

import (
	"context"
	"fmt"
	"strings"

	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	"github.com/cristianadrielbraun/gofer/components/tabs"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

func adminChecked(total, pending int) int {
	checked := total - pending
	if checked < 0 {
		return 0
	}
	return checked
}

func adminLatestAvatarError(ctx context.Context, status models.AvatarStatus) string {
	for _, attempt := range status.RecentErrors {
		if attempt.Message != "" {
			return attempt.Message
		}
	}
	return adminError(ctx, status.Backfill.LastError)
}

templ AdminPage(status models.AvatarStatus, activeTab string) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="mb-7 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.avatars") }</h2>
						<p class="mt-1 max-w-2xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.avatars.description") }</p>
					</div>
					<div class="flex w-full shrink-0 flex-col items-end gap-3 lg:w-auto">
						@AdminWebmailScopeFilter(status.Scope, "/admin/avatars/"+activeTab)
						<div class="flex flex-wrap items-center justify-end gap-2">
							<form method="post" action="/admin/avatar-backfill/recheck">
								<button
									type="submit"
									class="rounded-md border border-amber-500/35 bg-amber-500/10 px-3 py-2 text-xs font-semibold text-amber-800 transition-colors hover:bg-amber-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-amber-200"
									disabled?={ status.Backfill.InProgress }
								>
									{ i18n.T(ctx, "admin.avatars.force") }
								</button>
							</form>
							<form method="post" action="/admin/avatar-backfill/cancel">
								<button
									type="submit"
									class="rounded-md border border-red-500/35 bg-red-500/10 px-3 py-2 text-xs font-semibold text-red-700 transition-colors hover:bg-red-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-red-300"
									disabled?={ !status.Backfill.InProgress || status.Backfill.CancelRequested }
									data-avatar-cancel-button
								>
									{ i18n.T(ctx, "admin.avatars.cancel") }
								</button>
							</form>
							<a href={ adminScopeURL("/api/admin/avatars/status", status.Scope) } class="whitespace-nowrap rounded-md border border-border bg-card px-3 py-2 text-xs font-semibold text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "admin.raw_json") }</a>
						</div>
					</div>
				</div>
				@tabs.Tabs(tabs.Props{ID: "avatar-admin-tabs", Attributes: templ.Attributes{"data-avatar-admin": ""}}) {
					@tabs.List(tabs.ListProps{Class: "bg-card"}) {
						@tabs.Trigger(tabs.TriggerProps{Value: "overview", IsActive: activeTab == "overview"}) {
							{ i18n.T(ctx, "admin.tab.overview") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "senders", IsActive: activeTab == "senders"}) {
							{ i18n.T(ctx, "admin.avatars.tab.senders") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "providers", IsActive: activeTab == "providers"}) {
							{ i18n.T(ctx, "admin.avatars.tab.providers") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "events", IsActive: activeTab == "events"}) {
							{ i18n.T(ctx, "admin.tab.events") }
						}
					}
					@tabs.Content(tabs.ContentProps{Value: "overview", IsActive: activeTab == "overview", Class: "mt-6 space-y-5", Attributes: templ.Attributes{"data-avatar-tab-panel": "overview"}}) {
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.avatars.run_title") }</div>
									<p class="mt-1 text-sm text-muted-foreground" data-avatar-run-description>{ adminAvatarRunDescription(ctx, status.Backfill) }</p>
								</div>
								<span
									class={
										"inline-flex w-fit shrink-0 items-center rounded-md px-2.5 py-1 text-[11px] font-semibold",
										templ.KV("bg-red-500/12 text-red-700 dark:text-red-300", status.Backfill.CancelRequested || status.Backfill.Canceled),
										templ.KV("bg-amber-500/12 text-amber-700 dark:text-amber-300", status.Backfill.InProgress && !status.Backfill.CancelRequested),
										templ.KV("bg-emerald-500/12 text-emerald-700 dark:text-emerald-300", !status.Backfill.InProgress && !status.Backfill.Canceled),
									}
									data-avatar-state
								>
									if status.Backfill.CancelRequested {
										{ i18n.T(ctx, "admin.avatars.state.canceling") }
									} else if status.Backfill.InProgress {
										{ adminAvatarRunLabel(ctx, status.Backfill.Mode) }
									} else if status.Backfill.Canceled {
										{ i18n.T(ctx, "admin.avatars.state.canceled") }
									} else {
										{ i18n.T(ctx, "admin.state.idle") }
									}
								</span>
							</div>
							<div class="mt-2 flex items-center justify-between gap-4">
								<div class="text-sm font-medium text-foreground" data-avatar-progress-text>{ i18n.T(ctx, "admin.progress", "done", i18n.Number(ctx, status.Backfill.Processed), "total", i18n.Number(ctx, status.Backfill.Total)) }</div>
								<div class="text-sm font-semibold tabular-nums text-foreground" data-avatar-progress-percent>{ fmt.Sprintf("%d%%", adminPercent(status.Backfill.Processed, status.Backfill.Total)) }</div>
							</div>
							<div class="mt-4 h-2 overflow-hidden rounded-md bg-muted shadow-inner">
								<div class="h-full rounded-md bg-primary transition-all duration-500" style={ fmt.Sprintf("width:%d%%", adminPercent(status.Backfill.Processed, status.Backfill.Total)) } data-avatar-progress-bar></div>
							</div>
						</div>
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="mb-3">
								<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.avatars.provider_activity") }</div>
								<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.avatars.provider_activity_detail") }</p>
							</div>
							<div class="space-y-2">
								for _, provider := range status.Backfill.ProviderStats {
									@AdminRunProviderCard(provider)
								}
							</div>
						</div>
						<div class="grid gap-4 lg:grid-cols-2">
							<div class="rounded-lg border border-border bg-card p-4">
								<div class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.outcomes") }</div>
								<div class="flex min-h-[10.75rem] flex-col justify-between gap-3">
									@AdminCompactMetric("total", i18n.T(ctx, "admin.avatars.metric.total"), status.Cache.Total)
									@AdminCompactMetric("found", i18n.T(ctx, "admin.avatars.metric.found"), status.Cache.Found)
									@AdminCompactMetric("missing", i18n.T(ctx, "admin.avatars.metric.missing"), status.Cache.Missing)
									@AdminCompactMetric("checked", i18n.T(ctx, "admin.avatars.metric.checked"), adminChecked(status.Cache.Total, status.Cache.Pending))
									@AdminCompactMetric("pending", i18n.T(ctx, "admin.avatars.metric.pending"), status.Cache.Pending)
								</div>
							</div>
							<div class="rounded-lg border border-border bg-card p-4">
								<div class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.run_status") }</div>
								<div class="space-y-3">
									@AdminCompactDetail("started", i18n.T(ctx, "admin.started"), adminTime(ctx, status.Backfill.StartedAt))
									@AdminCompactDetail("finished", i18n.T(ctx, "admin.finished"), adminTime(ctx, status.Backfill.FinishedAt))
									@AdminCompactMetric("due", i18n.T(ctx, "admin.avatars.metric.due"), status.Cache.Due)
									@AdminCompactMetric("error", i18n.T(ctx, "admin.errors"), status.Cache.Error)
									@AdminErrorDetail("last_error", i18n.T(ctx, "admin.latest_error"), adminLatestAvatarError(ctx, status))
								</div>
							</div>
						</div>
					}
					@tabs.Content(tabs.ContentProps{Value: "senders", IsActive: activeTab == "senders", Class: "mt-6", Attributes: templ.Attributes{"data-avatar-tab-panel": "senders"}}) {
						<div class="rounded-lg border border-border bg-card p-4" data-avatar-explorer>
							<div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
								<div>
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.avatars.tab.senders") }</div>
									<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.avatars.senders_detail") }</p>
								</div>
								<div class="flex flex-col gap-2 lg:items-end">
									@AdminTableUpdateControls()
								</div>
							</div>
							<div class="grid gap-3 lg:grid-cols-[minmax(16rem,1fr)_10rem_10rem_auto]">
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.sender_search") }</span>
									@input.Input(input.Props{Type: input.TypeSearch, Placeholder: "sender@example.com", Class: "bg-background", Attributes: templ.Attributes{"data-avatar-filter": "query"}})
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.provider_checked") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-filter": "provider"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.avatars.all_providers")}) {
												{ i18n.T(ctx, "admin.avatars.all_providers") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: true}) {
												{ i18n.T(ctx, "admin.avatars.all_providers") }
											}
											for _, provider := range status.Cache.ProviderStats {
												@selectbox.Item(selectbox.ItemProps{Value: provider.Provider}) {
													{ adminProviderLabel(ctx, provider.Provider) }
												}
											}
										}
									}
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.final_status") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-filter": "status"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.avatars.all_statuses")}) {
												{ i18n.T(ctx, "admin.avatars.all_statuses") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: true}) {
												{ i18n.T(ctx, "admin.avatars.all_statuses") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "found"}) {
												{ i18n.T(ctx, "admin.avatars.found") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "missing"}) {
												{ i18n.T(ctx, "admin.avatars.missing") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "skipped"}) {
												{ i18n.T(ctx, "admin.avatars.skipped") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "error"}) {
												{ i18n.T(ctx, "admin.avatars.error") }
											}
										}
									}
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.errors_only") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-filter": "errors"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "common.no")}) {
												{ i18n.T(ctx, "common.no") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "false", Selected: true}) {
												{ i18n.T(ctx, "common.no") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "true"}) {
												{ i18n.T(ctx, "common.yes") }
											}
										}
									}
								</label>
							</div>
							<div class="mt-3 text-xs font-medium text-muted-foreground" data-avatar-log-count>{ i18n.T(ctx, "admin.avatars.loading_senders") }</div>
							<div class="mt-4 overflow-x-auto rounded-lg border border-border bg-muted/25 shadow-inner">
								<div class="min-w-[48rem]">
									<div class="grid gap-2 border-b border-border bg-muted/70 px-4 py-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground" data-avatar-sender-header>
										<div>{ i18n.T(ctx, "admin.avatars.col.sender") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.col.in_use") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.tab.providers") }</div>
									</div>
									<div class="h-[34rem] overflow-y-auto" data-avatar-log-viewport></div>
								</div>
							</div>
						</div>
					}
					@tabs.Content(tabs.ContentProps{Value: "providers", IsActive: activeTab == "providers", Class: "mt-6 space-y-5", Attributes: templ.Attributes{"data-avatar-tab-panel": "providers"}}) {
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
								<div>
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.avatars.source_mix") }</div>
									<p class="mt-1 max-w-xl text-sm leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.avatars.source_mix_detail") }</p>
									<div class="mt-5 grid gap-3 sm:grid-cols-3">
										@AdminMetric("providers_total", i18n.T(ctx, "admin.avatars.tab.providers"), len(status.Cache.ProviderStats))
										@AdminMetric("provider_assignments", i18n.T(ctx, "admin.avatars.metric.assigned"), adminProviderInUseTotal(status.Cache.ProviderStats))
										@AdminMetric("other_found", i18n.T(ctx, "admin.avatars.metric.other"), status.Cache.OtherFound)
									</div>
								</div>
								<div class="rounded-lg border border-border bg-background/35 p-4">
									<div class="mb-3 flex items-center justify-between gap-3">
										<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.usage") }</div>
										<div class="text-xs font-semibold tabular-nums text-muted-foreground">{ i18n.T(ctx, "admin.avatars.assigned_count", "count", i18n.Number(ctx, adminProviderInUseTotal(status.Cache.ProviderStats))) }</div>
									</div>
									<div class="space-y-3">
										for _, provider := range status.Cache.ProviderStats {
											@AdminProviderUsageRow(provider, status.Cache.Found)
										}
									</div>
								</div>
							</div>
						</div>
						<div class="grid gap-4 xl:grid-cols-3">
							for _, provider := range status.Cache.ProviderStats {
								@AdminProviderCard(provider)
							}
						</div>
					}
					@tabs.Content(tabs.ContentProps{Value: "events", IsActive: activeTab == "events", Class: "mt-6 space-y-4", Attributes: templ.Attributes{"data-avatar-tab-panel": "events"}}) {
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
								<div>
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.tab.events") }</div>
									<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.avatars.events_detail") }</p>
								</div>
								<div class="flex flex-col gap-2 lg:items-end">
									@AdminTableUpdateControls()
								</div>
							</div>
							<div class="grid gap-3 lg:grid-cols-[minmax(16rem,1fr)_10rem_10rem_auto]">
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.sender_search") }</span>
									@input.Input(input.Props{Type: input.TypeSearch, Placeholder: "sender@example.com", Class: "bg-background", Attributes: templ.Attributes{"data-avatar-event-filter": "query"}})
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.provider") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-event-filter": "provider"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.avatars.all_providers")}) {
												{ i18n.T(ctx, "admin.avatars.all_providers") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: true}) {
												{ i18n.T(ctx, "admin.avatars.all_providers") }
											}
											for _, provider := range status.Cache.ProviderStats {
												@selectbox.Item(selectbox.ItemProps{Value: provider.Provider}) {
													{ adminProviderLabel(ctx, provider.Provider) }
												}
											}
										}
									}
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.outcome") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-event-filter": "status"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.avatars.all_outcomes")}) {
												{ i18n.T(ctx, "admin.avatars.all_outcomes") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: true}) {
												{ i18n.T(ctx, "admin.avatars.all_outcomes") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "found"}) {
												{ i18n.T(ctx, "admin.avatars.found") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "missing"}) {
												{ i18n.T(ctx, "admin.avatars.missing") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "skipped"}) {
												{ i18n.T(ctx, "admin.avatars.skipped") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "error"}) {
												{ i18n.T(ctx, "admin.avatars.error") }
											}
										}
									}
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.errors_only") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-event-filter": "errors"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "common.no")}) {
												{ i18n.T(ctx, "common.no") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "false", Selected: true}) {
												{ i18n.T(ctx, "common.no") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "true"}) {
												{ i18n.T(ctx, "common.yes") }
											}
										}
									}
								</label>
							</div>
							<div class="mt-3 text-xs font-medium text-muted-foreground" data-avatar-event-count>{ i18n.T(ctx, "admin.avatars.loading_events") }</div>
							<div class="mt-4 overflow-x-auto rounded-lg border border-border bg-muted/25 shadow-inner">
								<div class="min-w-[58rem]">
									<div class="grid grid-cols-[10rem_minmax(15rem,1fr)_8rem_8rem_minmax(18rem,1.3fr)] gap-3 border-b border-border bg-muted/70 px-4 py-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
										<div>{ i18n.T(ctx, "admin.col.time") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.col.sender") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.provider") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.outcome") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.col.details") }</div>
									</div>
									<div class="h-[34rem] overflow-y-auto" data-avatar-event-viewport></div>
								</div>
							</div>
						</div>
					}
				}
			</div>
		</div>
	</div>
}

func adminAvatarRunLabel(ctx context.Context, mode string) string {
	if mode == "manual" {
		return i18n.T(ctx, "admin.avatars.state.full")
	}
	return i18n.T(ctx, "admin.avatars.state.due")
}

func adminAvatarRunDescription(ctx context.Context, state models.AvatarBackfillState) string {
	if state.CancelRequested {
		return i18n.T(ctx, "admin.avatars.run.canceling")
	}
	if state.InProgress && state.Mode == "manual" {
		return i18n.T(ctx, "admin.avatars.run.full")
	}
	if state.InProgress {
		return i18n.T(ctx, "admin.avatars.run.due")
	}
	if state.Canceled {
		return i18n.T(ctx, "admin.avatars.run.canceled")
	}
	return i18n.T(ctx, "admin.avatars.run.idle")
}

func adminProviderLabel(ctx context.Context, provider string) string {
	switch strings.ToLower(strings.TrimSpace(provider)) {
	case "bimi":
		return "BIMI"
	case "gravatar":
		return "Gravatar"
	case "libravatar":
		return "Libravatar"
	case "domain_icon":
		return i18n.T(ctx, "admin.provider.domain_icon")
	case "":
		return i18n.T(ctx, "admin.unknown")
	default:
		label := strings.ReplaceAll(provider, "_", " ")
		return strings.Title(label)
	}
}

func adminProviderRole(ctx context.Context, provider string) string {
	switch strings.ToLower(strings.TrimSpace(provider)) {
	case "gravatar":
		return i18n.T(ctx, "admin.provider.role.gravatar")
	case "libravatar":
		return i18n.T(ctx, "admin.provider.role.libravatar")
	case "bimi":
		return i18n.T(ctx, "admin.provider.role.bimi")
	case "domain_icon":
		return i18n.T(ctx, "admin.provider.role.domain_icon")
	default:
		return i18n.T(ctx, "admin.provider.role.custom")
	}
}

func adminProviderMetricKey(provider string, metric string) string {
	provider = strings.ToLower(strings.TrimSpace(provider))
	provider = strings.ReplaceAll(provider, "-", "_")
	provider = strings.ReplaceAll(provider, " ", "_")
	if provider == "" {
		provider = "unknown"
	}
	return provider + "_" + metric
}

func adminRunProviderMetricKey(provider string, metric string) string {
	return "run_" + adminProviderMetricKey(provider, metric)
}

func adminProviderInUseTotal(stats []models.AvatarProviderStats) int {
	total := 0
	for _, stat := range stats {
		total += stat.InUse
	}
	return total
}

func adminProviderAttemptTotal(stat models.AvatarProviderStats) int {
	return stat.Checked + stat.Skipped
}

func adminProviderPercent(part, total int) int {
	return adminPercent(part, total)
}

templ AdminProviderUsageRow(provider models.AvatarProviderStats, totalFound int) {
	<div>
		<div class="mb-1.5 flex items-center justify-between gap-3 text-sm">
			<div class="min-w-0">
				<div class="truncate font-semibold text-foreground">{ adminProviderLabel(ctx, provider.Provider) }</div>
				<div class="text-xs text-muted-foreground">{ adminProviderRole(ctx, provider.Provider) }</div>
			</div>
			<div class="shrink-0 text-right text-xs font-semibold tabular-nums text-foreground" data-admin-metric={ adminProviderMetricKey(provider.Provider, "in_use") }><span data-admin-metric-value>{ fmt.Sprintf("%d", provider.InUse) }</span></div>
		</div>
		<div class="h-2 overflow-hidden rounded-md bg-muted shadow-inner">
			<div class="h-full rounded-md bg-primary/80" style={ fmt.Sprintf("width:%d%%", adminProviderPercent(provider.InUse, totalFound)) }></div>
		</div>
	</div>
}

templ AdminRunProviderCard(provider models.AvatarProviderStats) {
	<div class="flex flex-col gap-3 rounded-lg border border-border bg-background/35 px-3 py-2 sm:flex-row sm:items-center sm:justify-between">
		<div class="min-w-36 shrink-0">
			<div class="min-w-0 truncate text-sm font-semibold text-foreground">{ adminProviderLabel(ctx, provider.Provider) }</div>
		</div>
		<div class="grid flex-1 grid-cols-5 gap-2">
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "checked"), i18n.T(ctx, "admin.avatars.checked"), provider.Checked)
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "found"), i18n.T(ctx, "admin.avatars.metric.found_short"), provider.Found)
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "missing"), i18n.T(ctx, "admin.avatars.metric.missing_short"), provider.Missing)
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "skipped"), i18n.T(ctx, "admin.skipped"), provider.Skipped)
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "error"), i18n.T(ctx, "admin.errors"), provider.Error)
		</div>
	</div>
}

templ AdminProviderCard(provider models.AvatarProviderStats) {
	<div class="rounded-lg border border-border bg-card p-4 transition-colors hover:bg-accent/20">
		<div class="mb-4 flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="truncate text-base font-bold text-foreground" style="font-family: var(--font-serif)">{ adminProviderLabel(ctx, provider.Provider) }</div>
				<div class="mt-0.5 text-xs font-medium text-muted-foreground">{ adminProviderRole(ctx, provider.Provider) }</div>
			</div>
			<div class="rounded-md border border-border bg-background px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ provider.Provider }</div>
		</div>
		<div class="grid gap-3 sm:grid-cols-2">
			@AdminMetric(adminProviderMetricKey(provider.Provider, "in_use"), i18n.T(ctx, "admin.avatars.col.in_use"), provider.InUse)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "checked"), i18n.T(ctx, "admin.avatars.checked"), provider.Checked)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "found"), i18n.T(ctx, "admin.avatars.metric.found_short"), provider.Found)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "missing"), i18n.T(ctx, "admin.avatars.metric.missing_short"), provider.Missing)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "skipped"), i18n.T(ctx, "admin.skipped"), provider.Skipped)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "error"), i18n.T(ctx, "admin.errors"), provider.Error)
		</div>
		<div class="mt-4 border-t border-border pt-3">
			<div class="mb-1 flex items-center justify-between text-xs">
				<span class="font-medium text-muted-foreground">{ i18n.T(ctx, "admin.avatars.found_rate") }</span>
				<span class="font-semibold tabular-nums text-foreground">{ fmt.Sprintf("%d%%", adminProviderPercent(provider.Found, provider.Checked)) }</span>
			</div>
			<div class="h-1.5 overflow-hidden rounded-md bg-muted">
				<div class="h-full rounded-md bg-emerald-500/80" style={ fmt.Sprintf("width:%d%%", adminProviderPercent(provider.Found, provider.Checked)) }></div>
			</div>
			<div class="mt-2 text-[11px] text-muted-foreground">{ i18n.N(ctx, "admin.avatars.lookups", adminProviderAttemptTotal(provider), "count", i18n.Number(ctx, adminProviderAttemptTotal(provider))) }</div>
		</div>
	</div>
}
