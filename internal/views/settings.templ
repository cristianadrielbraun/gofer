package views

import (
	"context"
	"fmt"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/googlefonts"
	"github.com/cristianadrielbraun/gofer/internal/buildinfo"
	"github.com/cristianadrielbraun/gofer/internal/models"
	"github.com/cristianadrielbraun/gofer/internal/providers"
	"github.com/cristianadrielbraun/gofer/internal/themebuilder"
	"github.com/cristianadrielbraun/gofer/internal/themecolors"
	"net/url"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/checkbox"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/dropdown"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/popover"
	"github.com/cristianadrielbraun/gofer/components/radio"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
	"github.com/cristianadrielbraun/gofer/components/tabs"
	"github.com/cristianadrielbraun/gofer/components/tooltip"
)

templ SettingsPage(accounts []models.Account, syncSettings models.SyncSettings, activeTab string, uiSettings map[string]string, signatureData []models.AccountSignatureData) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden" data-settings-page>
		<div class="flex-1 overflow-y-auto">
			<div id="settings-content" class="max-w-3xl px-8 py-10">
				@SettingsSectionHeader(activeTab)
				if activeTab == "accounts" {
					@SettingsAccountsTab(accounts)
				} else if activeTab == "sync" {
					@SettingsSyncTab(syncSettings, uiSettings)
				} else if activeTab == "rules" {
					@SettingsRulesTab()
				} else if activeTab == "operations" {
					@SettingsOperationsTab()
				} else if activeTab == "contacts" {
					@SettingsContactsTab(accounts, uiSettings)
				} else if activeTab == "appearance" {
					@SettingsAppearanceTab(uiSettings)
					@TagAppearanceSettings(accounts, uiSettings)
				} else if activeTab == "regional" {
					@SettingsRegionalTab(uiSettings)
				} else if activeTab == "compose-display" {
					@SettingsComposeDisplayTab(uiSettings, signatureData)
				} else if activeTab == "advanced" {
					@SettingsAdvancedTab(uiSettings)
				} else if activeTab == "export-import" {
					@SettingsExportImportTab()
				} else if activeTab == "about" {
					@SettingsAboutTab(buildinfo.Get())
				}
			</div>
		</div>
	</div>
}

// settingsSectionHeading returns a settings section's title and description.
// The open-mode Security page has its own description.
func settingsSectionHeading(ctx context.Context, section string) (string, string) {
	switch section {
	case "accounts", "sync", "rules", "operations", "contacts", "appearance", "regional", "compose-display", "security", "advanced", "export-import", "about":
		return i18n.T(ctx, "settings.section."+section+".title"), i18n.T(ctx, "settings.section."+section+".description")
	case "security-open":
		return i18n.T(ctx, "settings.section.security.title"), i18n.T(ctx, "settings.section.security-open.description")
	default:
		return i18n.T(ctx, "settings.section.default.title"), i18n.T(ctx, "settings.section.default.description")
	}
}

templ SettingsSectionHeader(section string) {
	{{ title, description := settingsSectionHeading(ctx, section) }}
	<div class="settings-section-header mb-6">
		<h2 class="text-2xl font-bold text-foreground mb-1" style="font-family: var(--font-serif)" data-settings-title>{ title }</h2>
		<p class="text-sm text-muted-foreground">{ description }</p>
	</div>
}

// settingsSwitchBox holds a switch with a short label beside it. It looks
// active while the switch is on and fades while it is off.
templ settingsSwitchBox(label string) {
	<div class="flex items-center justify-between gap-3 rounded-md border border-border bg-background px-3 py-2 text-foreground shadow-xs transition-colors has-[input[role=switch]:not(:checked)]:border-border/60 has-[input[role=switch]:not(:checked)]:bg-background/40 has-[input[role=switch]:not(:checked)]:text-muted-foreground has-[input[role=switch]:not(:checked)]:shadow-none">
		<span class="text-xs font-medium">{ label }</span>
		{ children... }
	</div>
}

templ SettingsComposeDisplayTab(uiSettings map[string]string, signatureData []models.AccountSignatureData) {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.compose.title") }</h3>
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.compose.description") }</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.compose.new_title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.compose.new_description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-compose-view-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "default_new_compose_view", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.compose.view.dialog")}) {
								{ composeViewOptionLabel(ctx, uiSettingGet(uiSettings, "default_new_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog"))) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Item(selectbox.ItemProps{Value: "dialog", Selected: uiSettingGet(uiSettings, "default_new_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "dialog"}) { { i18n.T(ctx, "settings.compose.view.dialog") } }
							@selectbox.Item(selectbox.ItemProps{Value: "pane", Selected: uiSettingGet(uiSettings, "default_new_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "pane"}) { { i18n.T(ctx, "settings.compose.view.pane") } }
							@selectbox.Item(selectbox.ItemProps{Value: "full", Selected: uiSettingGet(uiSettings, "default_new_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "full"}) { { i18n.T(ctx, "settings.compose.view.full") } }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.compose.reply_title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.compose.reply_description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-compose-view-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "default_reply_compose_view", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.compose.view.dialog")}) {
								{ composeViewOptionLabel(ctx, uiSettingGet(uiSettings, "default_reply_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog"))) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Item(selectbox.ItemProps{Value: "dialog", Selected: uiSettingGet(uiSettings, "default_reply_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "dialog"}) { { i18n.T(ctx, "settings.compose.view.dialog") } }
							@selectbox.Item(selectbox.ItemProps{Value: "pane", Selected: uiSettingGet(uiSettings, "default_reply_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "pane"}) { { i18n.T(ctx, "settings.compose.view.pane") } }
							@selectbox.Item(selectbox.ItemProps{Value: "full", Selected: uiSettingGet(uiSettings, "default_reply_compose_view", uiSettingGet(uiSettings, "default_compose_view", "dialog")) == "full"}) { { i18n.T(ctx, "settings.compose.view.full") } }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
					<span id="compose-autosave-enabled-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.compose.autosave.title") }</span>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.compose.autosave.description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0 space-y-3" data-compose-autosave-controls>
					@settingsSwitchBox(i18n.T(ctx, "settings.compose.autosave.enable")) {
						@switchcomp.Switch(switchcomp.Props{
							ID:      "compose-autosave-enabled",
							Name:    "compose_autosave_enabled",
							Checked: uiSettingGet(uiSettings, "compose_autosave_enabled", "true") != "false",
							Attributes: templ.Attributes{"aria-labelledby": "compose-autosave-enabled-label", "data-compose-autosave-setting": "enabled"},
						})
					}
					<div data-compose-autosave-dependent>
						<input type="hidden" name="compose_autosave_conditions" value={ uiSettingGet(uiSettings, "compose_autosave_conditions", "chars,attachment") } data-compose-autosave-conditions-value/>
						@dropdown.Dropdown() {
							@dropdown.Trigger() {
								@button.Button(button.Props{Variant: button.VariantOutline, Class: "settings-select select-trigger w-full h-9 justify-between bg-background", Disabled: uiSettingGet(uiSettings, "compose_autosave_enabled", "true") == "false", Attributes: templ.Attributes{"data-compose-autosave-conditions-button": ""}}) {
									<span data-compose-autosave-conditions-label>{ autosaveConditionsLabel(ctx, uiSettings) }</span>
									@icon.ChevronDown(icon.Props{Class: "size-4 text-muted-foreground"})
								}
							}
							@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "mobile-sheet w-64 normal-case tracking-normal", Attributes: templ.Attributes{"data-compose-autosave-conditions-menu": ""}}) {
								@dropdown.Label(dropdown.LabelProps{Class: "text-xs text-muted-foreground"}) { { i18n.T(ctx, "settings.compose.autosave.when") } }
								<div class="flex items-center gap-2 rounded-sm px-2 py-0.5 text-sm transition-colors duration-150 hover:bg-accent hover:text-accent-foreground" data-compose-autosave-condition-item="chars">
									<span class={ "w-4 shrink-0 text-primary", templ.KV("opacity-0", !uiSettingCSVHas(uiSettings, "compose_autosave_conditions", "chars,attachment", "chars")) } data-compose-autosave-condition-check="chars">@icon.Check(icon.Props{Class: "size-4"})</span>
									<span class="flex-1 text-left">{ i18n.T(ctx, "settings.compose.autosave.min_chars") }</span>
									<input type="text" inputmode="numeric" pattern="[0-9]*" value={ uiSettingGet(uiSettings, "compose_autosave_min_chars", "30") } class="h-7 w-14 rounded-md border border-border bg-background px-2 text-xs text-foreground outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25 disabled:opacity-50" data-compose-autosave-min-chars disabled?={ uiSettingGet(uiSettings, "compose_autosave_enabled", "true") == "false" || !uiSettingCSVHas(uiSettings, "compose_autosave_conditions", "chars,attachment", "chars") }/>
								</div>
								@dropdown.Item(dropdown.ItemProps{PreventClose: true, Class: "gap-2 transition-colors duration-150", Attributes: templ.Attributes{"data-compose-autosave-condition-item": "attachment"}}) {
									<span class={ "w-4 shrink-0 text-primary", templ.KV("opacity-0", !uiSettingCSVHas(uiSettings, "compose_autosave_conditions", "chars,attachment", "attachment")) } data-compose-autosave-condition-check="attachment">@icon.Check(icon.Props{Class: "size-4"})</span>
									<span class="flex-1 text-left">{ i18n.T(ctx, "settings.compose.autosave.has_attachment") }</span>
								}
								@dropdown.Item(dropdown.ItemProps{PreventClose: true, Class: "gap-2 transition-colors duration-150", Attributes: templ.Attributes{"data-compose-autosave-condition-item": "to"}}) {
									<span class={ "w-4 shrink-0 text-primary", templ.KV("opacity-0", !uiSettingCSVHas(uiSettings, "compose_autosave_conditions", "chars,attachment", "to")) } data-compose-autosave-condition-check="to">@icon.Check(icon.Props{Class: "size-4"})</span>
									<span class="flex-1 text-left">{ i18n.T(ctx, "settings.compose.autosave.has_recipient") }</span>
								}
							}
						}
					</div>
					<div data-compose-autosave-dependent>
						@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "compose_autosave_debounce", Class: "bg-background", DisableClear: true, Disabled: uiSettingGet(uiSettings, "compose_autosave_enabled", "true") == "false"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.N(ctx, "settings.compose.autosave.seconds", 5)}) {
									{ autosaveDebounceLabel(ctx, uiSettingGet(uiSettings, "compose_autosave_debounce", "5")) }
								}
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
								@selectbox.Item(selectbox.ItemProps{Value: "1", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "1"}) { { i18n.N(ctx, "settings.compose.autosave.seconds", 1) } }
								@selectbox.Item(selectbox.ItemProps{Value: "3", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "3"}) { { i18n.N(ctx, "settings.compose.autosave.seconds", 3) } }
								@selectbox.Item(selectbox.ItemProps{Value: "5", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "5"}) { { i18n.N(ctx, "settings.compose.autosave.seconds", 5) } }
								@selectbox.Item(selectbox.ItemProps{Value: "10", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "10"}) { { i18n.N(ctx, "settings.compose.autosave.seconds", 10) } }
								@selectbox.Item(selectbox.ItemProps{Value: "15", Selected: uiSettingGet(uiSettings, "compose_autosave_debounce", "5") == "15"}) { { i18n.N(ctx, "settings.compose.autosave.seconds", 15) } }
							}
						}
					</div>
				</div>
			</div>
		</div>
		@AccountSignaturesSettings(signatureData)
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.list.title") }</h3>
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.list.description") }</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.list.navigation.title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.list.navigation.description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-mail-list-navigation-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "mail_list_navigation", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.list.navigation.infinite")}) {
								{ listNavigationLabel(ctx, uiSettingGet(uiSettings, "mail_list_navigation", "infinite")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Item(selectbox.ItemProps{Value: "infinite", Selected: uiSettingGet(uiSettings, "mail_list_navigation", "infinite") != "pagination"}) { { i18n.T(ctx, "settings.list.navigation.infinite") } }
							@selectbox.Item(selectbox.ItemProps{Value: "pagination", Selected: uiSettingGet(uiSettings, "mail_list_navigation", "infinite") == "pagination"}) { { i18n.T(ctx, "settings.list.navigation.pagination") } }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.list.sender.title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.list.sender.description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-sender-display-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "sender_display", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.list.sender.name")}) {
								{ senderDisplayLabel(ctx, uiSettingGet(uiSettings, "sender_display", "name")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Item(selectbox.ItemProps{Value: "name", Selected: uiSettingGet(uiSettings, "sender_display", "name") == "name"}) { { i18n.T(ctx, "settings.list.sender.name") } }
							@selectbox.Item(selectbox.ItemProps{Value: "email", Selected: uiSettingGet(uiSettings, "sender_display", "name") == "email"}) { { i18n.T(ctx, "settings.list.sender.email") } }
							@selectbox.Item(selectbox.ItemProps{Value: "both", Selected: uiSettingGet(uiSettings, "sender_display", "name") == "both"}) { { i18n.T(ctx, "settings.list.sender.both") } }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.list.mark_read.title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.list.mark_read.description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-auto-mark-read-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "auto_mark_read_after", Class: "bg-background", DisableClear: true}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.list.mark_read.immediately")}) {
								{ autoMarkReadLabel(ctx, uiSettingGet(uiSettings, "auto_mark_read_after", "0")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Item(selectbox.ItemProps{Value: "0", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "0"}) { { i18n.T(ctx, "settings.list.mark_read.immediately") } }
							@selectbox.Item(selectbox.ItemProps{Value: "2", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "2"}) { { i18n.N(ctx, "settings.list.mark_read.after", 2) } }
							@selectbox.Item(selectbox.ItemProps{Value: "5", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "5"}) { { i18n.N(ctx, "settings.list.mark_read.after", 5) } }
							@selectbox.Item(selectbox.ItemProps{Value: "10", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "10"}) { { i18n.N(ctx, "settings.list.mark_read.after", 10) } }
							@selectbox.Item(selectbox.ItemProps{Value: "never", Selected: uiSettingGet(uiSettings, "auto_mark_read_after", "0") == "never"}) { { i18n.T(ctx, "settings.list.mark_read.never") } }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
					<span id="group-conversations-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.list.group.title") }</span>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.list.group.description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0">
					@settingsSwitchBox(i18n.T(ctx, "settings.switch.enabled")) {
						@switchcomp.Switch(switchcomp.Props{
							ID:      "group-conversations",
							Name:    "group_conversations",
							Checked: GroupConversations(uiSettings),
							Attributes: templ.Attributes{"aria-labelledby": "group-conversations-label", "data-group-conversations-setting": ""},
						})
					}
				</div>
			</div>
			<div data-setting-depends-on="group-conversations" class={ "settings-row flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between transition-opacity", templ.KV("opacity-50", !GroupConversations(uiSettings)) }>
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.list.thread_order.title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.list.thread_order.description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-thread-order-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "thread_order", Class: "bg-background", DisableClear: true, Disabled: !GroupConversations(uiSettings)}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.list.thread_order.newest")}) {
								{ threadOrderLabel(ctx, uiSettingGet(uiSettings, "thread_order", "newest")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Item(selectbox.ItemProps{Value: "newest", Selected: ThreadNewestFirst(uiSettings)}) { { i18n.T(ctx, "settings.list.thread_order.newest") } }
							@selectbox.Item(selectbox.ItemProps{Value: "oldest", Selected: !ThreadNewestFirst(uiSettings)}) { { i18n.T(ctx, "settings.list.thread_order.oldest") } }
						}
					}
				</div>
			</div>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.translation.title") }</h3>
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.translation.description") }</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
					<span id="translation-button-enabled-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.translation.button_title") }</span>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.translation.button_description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0">
					@settingsSwitchBox(i18n.T(ctx, "settings.switch.enabled")) {
						@switchcomp.Switch(switchcomp.Props{
							ID:      "translation-button-enabled",
							Name:    "translation_button_enabled",
							Checked: uiSettingGet(uiSettings, "translation_button_enabled", "true") != "false",
							Attributes: templ.Attributes{"aria-labelledby": "translation-button-enabled-label", "data-translation-setting": "enabled"},
						})
					}
				</div>
			</div>
			<div data-setting-depends-on="translation-button-enabled" class={ "settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between transition-opacity", templ.KV("opacity-50", uiSettingGet(uiSettings, "translation_button_enabled", "true") == "false") }>
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.translation.service_title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.translation.service_description") }</p>
				</div>
				<div class="w-full sm:w-64 shrink-0" data-translation-provider-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "translation_provider", Class: "bg-background", DisableClear: true, Disabled: uiSettingGet(uiSettings, "translation_button_enabled", "true") == "false"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.translation.google_basic")}) {
								{ translationProviderLabel(ctx, uiSettingGet(uiSettings, "translation_provider", "google_web_basic")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Item(selectbox.ItemProps{Value: "google_web_basic", Selected: translationProviderSettingValue(uiSettingGet(uiSettings, "translation_provider", "google_web_basic")) == "google_web_basic", Class: "items-start py-2 pr-8"}) {
								<span class="flex min-w-0 flex-col whitespace-normal">
									<span class="font-medium leading-tight">{ i18n.T(ctx, "settings.translation.google_basic") }</span>
									<span class="mt-0.5 text-[11px] leading-snug text-muted-foreground group-hover:text-accent-foreground/75">{ i18n.T(ctx, "settings.translation.google_basic_description") }</span>
								</span>
							}
						}
					}
				</div>
			</div>
			<div data-setting-depends-on="translation-button-enabled" class={ "settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between transition-opacity", templ.KV("opacity-50", uiSettingGet(uiSettings, "translation_button_enabled", "true") == "false") }>
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.translation.target_title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.translation.target_description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0" data-translation-language-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "translation_target_language", Class: "bg-background", DisableClear: true, Disabled: uiSettingGet(uiSettings, "translation_button_enabled", "true") == "false"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.LanguageName(ctx, "en")}) {
								{ translationLanguageSettingLabel(ctx, uiSettingGet(uiSettings, "translation_target_language", "en")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "settings.translation.search_languages"), Class: "mobile-sheet"}) {
							for _, language := range translationLanguageOptions(ctx) {
								@selectbox.Item(selectbox.ItemProps{Value: language.Value, Selected: uiSettingGet(uiSettings, "translation_target_language", "en") == language.Value}) { { language.Label } }
							}
						}
					}
				</div>
			</div>
		</div>
	</div>
}

templ SettingsAppearanceTab(uiSettings map[string]string) {
		<div class="mt-6 space-y-6">
			<div class="settings-card bg-card rounded-lg border p-6 space-y-6">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
					<div>
						<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.appearance.style_title") }</h3>
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.appearance.style_description") }</p>
					</div>
					<div class="space-y-1 sm:text-right" data-mode-picker>
						<h4 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "settings.appearance.mode_title") }</h4>
						<div class="inline-flex rounded-lg border border-border bg-background p-0.5 gap-0.5">
							<button
								type="button"
								data-mode="light"
								disabled?={ themeStyle(uiSettings) == themebuilder.StyleName }
								class={
									"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200",
									templ.KV("bg-background text-foreground shadow-sm", themeClass(uiSettings) != "dark"),
									templ.KV("text-muted-foreground hover:text-foreground", themeClass(uiSettings) == "dark"),
								}
							>
								<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
								{ i18n.T(ctx, "settings.appearance.mode.light") }
							</button>
							@tooltip.Tooltip() {
								@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
									<button
										type="button"
										data-mode="dark"
										disabled?={ themeStyle(uiSettings) == "express" || themeStyle(uiSettings) == themebuilder.StyleName }
										class={
											"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200",
											templ.KV("bg-background text-foreground shadow-sm", themeClass(uiSettings) == "dark"),
											templ.KV("text-muted-foreground hover:text-foreground", themeClass(uiSettings) != "dark"),
										}
									>
										<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></svg>
										{ i18n.T(ctx, "settings.appearance.mode.dark") }
									</button>
								}
								@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionBottom, Attributes: templ.Attributes{"data-mode-dark-tip": ""}}) {
									{ i18n.T(ctx, "settings.appearance.express_no_dark") }
								}
							}
						</div>
						<p class={ "text-xs text-muted-foreground", templ.KV("hidden", themeStyle(uiSettings) != themebuilder.StyleName) } data-mode-custom-note>{ i18n.T(ctx, "settings.appearance.mode_custom") }</p>
					</div>
				</div>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-2xl" data-theme-picker>
					<div class="group/theme relative flex" data-theme-card="classic">
					<label class="relative flex flex-1 flex-col rounded-lg border-2 p-3 cursor-pointer transition-all duration-200 text-left hover:shadow-md group border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "theme_style", Value: "classic", Checked: uiSettingGet(uiSettings, "theme_style", "classic") == "classic", Class: "absolute right-2.5 bottom-2.5 z-10"})
						<div data-theme="classic" data-theme-preview class={ "overflow-hidden h-36 mb-2 flex", templ.KV("dark", uiSettingGet(uiSettings, "theme", "dark") == "dark") } style="background:var(--background); border-radius:12px">
							<div class="w-1/4 p-2 flex flex-col gap-1.5" style="background:var(--sidebar)">
								<div style="height:3px; width:70%; background:var(--sidebar-foreground); opacity:0.5; border-radius:10px"></div>
								<div style="height:3px; width:90%; background:var(--sidebar-foreground); opacity:0.3; border-radius:10px"></div>
								<div style="height:3px; width:50%; background:var(--primary); opacity:0.7; border-radius:10px"></div>
								<div style="height:3px; width:80%; background:var(--sidebar-foreground); opacity:0.3; border-radius:10px"></div>
								<div style="height:3px; width:60%; background:var(--sidebar-foreground); opacity:0.3; border-radius:10px"></div>
							</div>
							<div class="flex-1 p-2 flex flex-col gap-1.5" style="background:var(--background)">
								<div style="height:3px; width:60%; background:var(--foreground); opacity:0.3; border-radius:10px; margin-bottom:2px"></div>
								<div class="flex-1 p-2 flex flex-col" style="background:var(--card); border:1px solid var(--border); border-radius:12px">
									<div style="height:2px; width:75%; background:var(--foreground); opacity:0.4; border-radius:10px; margin-bottom:3px"></div>
									<div style="height:2px; width:50%; background:var(--muted-foreground); opacity:0.3; border-radius:10px; margin-bottom:3px"></div>
									<div style="height:2px; width:85%; background:var(--foreground); opacity:0.2; border-radius:10px; margin-bottom:3px"></div>
									<div style="height:2px; width:60%; background:var(--foreground); opacity:0.15; border-radius:10px; margin-bottom:3px"></div>
									<div style="height:2px; width:90%; background:var(--foreground); opacity:0.1; border-radius:10px; margin-bottom:3px"></div>
									<div style="height:2px; width:40%; background:var(--foreground); opacity:0.15; border-radius:10px; margin-bottom:3px"></div>
									<div style="height:2px; width:70%; background:var(--foreground); opacity:0.1; border-radius:10px; margin-bottom:3px"></div>
									<div style="flex:1; width:100%; background:var(--secondary); border-radius:6px; margin-bottom:3px"></div>
									<div style="display:inline-flex; gap:4px; margin-top:auto">
										<div style="height:10px; width:28px; background:var(--primary); border-radius:8px"></div>
										<div style="height:10px; width:28px; background:var(--card); border:1px solid var(--border); border-radius:8px"></div>
									</div>
								</div>
							</div>
						</div>
						<span class="text-sm font-medium text-foreground leading-tight">{ i18n.T(ctx, "settings.appearance.classic") }</span>
						<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.appearance.classic_description") }</span>
					</label>
					@ThemeColorsCardActions(uiSettings, "classic")
					</div>

					<div class="group/theme relative flex" data-theme-card="minimal">
					<label class="relative flex flex-1 flex-col rounded-lg border-2 p-3 cursor-pointer transition-all duration-200 text-left hover:shadow-md group border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "theme_style", Value: "minimal", Checked: uiSettingGet(uiSettings, "theme_style", "classic") == "minimal", Class: "absolute right-2.5 bottom-2.5 z-10"})
						<div data-theme="minimal" data-theme-preview class={ "overflow-hidden h-36 mb-2 flex", templ.KV("dark", uiSettingGet(uiSettings, "theme", "dark") == "dark") } style="background:var(--background); border-radius:0">
							<div class="w-1/4 p-2 flex flex-col gap-1.5" style="background:var(--sidebar); border-right:1px solid var(--sidebar-border)">
								<div style="height:3px; width:70%; background:var(--sidebar-foreground); opacity:0.4; border-radius:0"></div>
								<div style="height:3px; width:90%; background:var(--sidebar-foreground); opacity:0.25; border-radius:0"></div>
								<div style="height:3px; width:50%; background:var(--primary); opacity:0.7; border-radius:0"></div>
								<div style="height:3px; width:80%; background:var(--sidebar-foreground); opacity:0.25; border-radius:0"></div>
								<div style="height:3px; width:60%; background:var(--sidebar-foreground); opacity:0.25; border-radius:0"></div>
							</div>
							<div class="flex-1 p-2 flex flex-col gap-1.5" style="background:var(--background)">
								<div style="height:3px; width:60%; background:var(--foreground); opacity:0.2; border-radius:0; margin-bottom:2px"></div>
								<div class="flex-1 p-2 flex flex-col" style="background:var(--card); border:1px solid var(--border); border-radius:0">
									<div style="height:2px; width:75%; background:var(--foreground); opacity:0.3; border-radius:0; margin-bottom:3px"></div>
									<div style="height:2px; width:50%; background:var(--muted-foreground); opacity:0.2; border-radius:0; margin-bottom:3px"></div>
									<div style="height:2px; width:85%; background:var(--foreground); opacity:0.12; border-radius:0; margin-bottom:3px"></div>
									<div style="height:2px; width:60%; background:var(--foreground); opacity:0.08; border-radius:0; margin-bottom:3px"></div>
									<div style="height:2px; width:90%; background:var(--foreground); opacity:0.05; border-radius:0; margin-bottom:3px"></div>
									<div style="height:2px; width:40%; background:var(--foreground); opacity:0.08; border-radius:0; margin-bottom:3px"></div>
									<div style="height:2px; width:70%; background:var(--foreground); opacity:0.05; border-radius:0; margin-bottom:3px"></div>
									<div style="flex:1; width:100%; background:var(--secondary); border-radius:0; margin-bottom:3px"></div>
									<div style="display:inline-flex; gap:4px; margin-top:auto">
										<div style="height:10px; width:28px; background:var(--primary); border-radius:0"></div>
										<div style="height:10px; width:28px; background:var(--card); border:1px solid var(--border); border-radius:0"></div>
									</div>
								</div>
							</div>
						</div>
						<span class="text-sm font-medium text-foreground leading-tight">{ i18n.T(ctx, "settings.appearance.minimal") }</span>
						<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.appearance.minimal_description") }</span>
					</label>
					@ThemeColorsCardActions(uiSettings, "minimal")
					</div>

					<label class="relative flex flex-col rounded-lg border-2 p-3 cursor-pointer transition-all duration-200 text-left hover:shadow-md group border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
						@radio.Radio(radio.Props{Name: "theme_style", Value: "express", Checked: uiSettingGet(uiSettings, "theme_style", "classic") == "express", Class: "absolute right-2.5 bottom-2.5 z-10"})
						<div data-theme="express" data-theme-preview class="overflow-hidden h-36 mb-2 flex flex-col" style="background:var(--xp-face); border-radius:0; box-shadow:var(--xp-bevel-out); padding:3px">
							<div style="height:8px; background:var(--xp-title); margin-bottom:3px"></div>
							<div class="flex gap-1 px-1 mb-1">
								<div style="height:9px; width:16px; background:var(--xp-face); box-shadow:var(--xp-bevel-out)"></div>
								<div style="height:9px; width:16px; background:var(--xp-face); box-shadow:var(--xp-bevel-out)"></div>
								<div style="height:9px; width:16px; background:var(--xp-face); box-shadow:var(--xp-bevel-out)"></div>
							</div>
							<div class="flex flex-1 gap-1 min-h-0">
								<div class="w-1/4 p-1.5 flex flex-col gap-1.5" style="background:var(--sidebar); box-shadow:var(--xp-bevel-in)">
									<div style="height:3px; width:70%; background:var(--sidebar-foreground); opacity:0.5"></div>
									<div style="height:5px; width:90%; background:var(--xp-select)"></div>
									<div style="height:3px; width:60%; background:var(--sidebar-foreground); opacity:0.5"></div>
									<div style="height:3px; width:80%; background:var(--sidebar-foreground); opacity:0.5"></div>
								</div>
								<div class="flex-1 flex flex-col gap-1 min-w-0">
									<div class="p-1.5 flex flex-col gap-1" style="background:var(--card); box-shadow:var(--xp-bevel-in); height:45%">
										<div style="height:2px; width:80%; background:var(--foreground); opacity:0.5"></div>
										<div style="height:5px; width:100%; background:var(--xp-select)"></div>
										<div style="height:2px; width:70%; background:var(--foreground); opacity:0.5"></div>
										<div style="height:2px; width:85%; background:var(--foreground); opacity:0.5"></div>
									</div>
									<div class="flex-1 p-1.5 flex flex-col gap-1" style="background:var(--paper); box-shadow:var(--xp-bevel-in)">
										<div style="height:2px; width:60%; background:var(--foreground); opacity:0.4"></div>
										<div style="height:2px; width:90%; background:var(--foreground); opacity:0.25"></div>
										<div style="height:2px; width:75%; background:var(--foreground); opacity:0.25"></div>
									</div>
								</div>
							</div>
						</div>
						<span class="text-sm font-medium text-foreground leading-tight">{ i18n.T(ctx, "settings.appearance.express") }</span>
						<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.appearance.express_description") }</span>
					</label>
				</div>
				@customThemesSection(uiSettings)
				@ThemeColorsDialog()
				@ThemeColorsDiscardDialog()
				@CustomThemeDialog()
				@CustomThemeDeleteDialog()
			</div>
			if googlefonts.Enabled() {
				@fontSettingsCard(uiSettings)
			}
			<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
				<div>
					<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.messages.title") }</h3>
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.messages.description") }</p>
				</div>
				{{ bodyStyle := EmailBodyStyle(uiSettings) }}
				<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
					<div class="min-w-0">
						<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.messages.style.title") }</h4>
						<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.messages.style.description") }</p>
					</div>
					<div class="w-full sm:w-44 shrink-0" data-email-body-style-picker>
						@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "email_body_style", Class: "bg-background", DisableClear: true}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.messages.style.theme")}) {
									{ bodyStyleLabel(ctx, bodyStyle) }
								}
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
								@selectbox.Item(selectbox.ItemProps{Value: "theme", Selected: bodyStyle == "theme"}) { { i18n.T(ctx, "settings.messages.style.theme") } }
								@selectbox.Item(selectbox.ItemProps{Value: "dark", Selected: bodyStyle == "dark"}) { { i18n.T(ctx, "mail.body_style.dark") } }
								@selectbox.Item(selectbox.ItemProps{Value: "light", Selected: bodyStyle == "light"}) { { i18n.T(ctx, "mail.body_style.light") } }
								@selectbox.Item(selectbox.ItemProps{Value: "original", Selected: bodyStyle == "original"}) { { i18n.T(ctx, "mail.body_style.original") } }
							}
						}
					</div>
				</div>
			</div>
			<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
				<div>
					<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.panes.title") }</h3>
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.panes.description") }</p>
				</div>
				@paneLayoutSettingRow("mail_pane_layout", i18n.T(ctx, "settings.panes.mail"), i18n.T(ctx, "settings.panes.mail_description"), PaneLayout(uiSettings, "mail")) {
					@mailSingleClickOpenSetting(uiSettings)
				}
				@paneLayoutSettingRow("contacts_pane_layout", i18n.T(ctx, "settings.panes.contacts"), i18n.T(ctx, "settings.panes.contacts_description"), PaneLayout(uiSettings, "contacts"))
				@paneLayoutSettingRow("calendar_pane_layout", i18n.T(ctx, "settings.panes.calendar"), i18n.T(ctx, "settings.panes.calendar_description"), PaneLayout(uiSettings, "calendar"))
			</div>
		</div>
}

// fontSettingsCard picks the text and heading fonts from the Google Fonts
// library for every style but Express, which keeps its own font.
templ fontSettingsCard(uiSettings map[string]string) {
	{{ express := themeStyle(uiSettings) == "express" }}
	<div class="settings-card bg-card rounded-lg border p-6 space-y-5" data-font-settings>
		<div>
			<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.appearance.fonts.title") }</h3>
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.appearance.fonts.description") }</p>
			<p class={ "mt-2 text-xs text-muted-foreground", templ.KV("hidden", !express) } data-font-settings-express>{ i18n.T(ctx, "settings.appearance.fonts.express") }</p>
		</div>
		@fontSettingRow(googlefonts.BodySetting, i18n.T(ctx, "settings.appearance.fonts.body"), i18n.T(ctx, "settings.appearance.fonts.body_description"), "Nunito Sans", uiSettingGet(uiSettings, googlefonts.BodySetting, ""), express)
		@fontSettingRow(googlefonts.HeadingSetting, i18n.T(ctx, "settings.appearance.fonts.heading"), i18n.T(ctx, "settings.appearance.fonts.heading_description"), "Fraunces", uiSettingGet(uiSettings, googlefonts.HeadingSetting, ""), express)
	</div>
}

// fontSettingRow is one font's picker. The page sends the built-in font and
// the chosen one; settings-page.js adds the rest of the library when it has
// the list, and draws each name in its font as it comes into view. The
// built-in font is "default" in the menu and "" when saved.
templ fontSettingRow(setting, title, description, builtIn, value string, disabled bool) {
	{{ defaultLabel := i18n.T(ctx, "settings.appearance.fonts.default", "font", builtIn) }}
	<div class={ "settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between", templ.KV("opacity-50", disabled) } data-font-setting-row>
		<div class="min-w-0">
			<h4 class="text-sm font-medium text-foreground">{ title }</h4>
			<p class="text-xs text-muted-foreground mt-1">{ description }</p>
		</div>
		<div class="w-full shrink-0 sm:w-64" data-font-picker>
			@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
				@selectbox.Trigger(selectbox.TriggerProps{Name: setting, Class: "bg-background", DisableClear: true, Required: true, Disabled: disabled, Attributes: templ.Attributes{"data-font-setting": setting, "value": fontPickerValue(value)}}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: defaultLabel}) {
						if value == "" {
							{ defaultLabel }
						} else {
							{ value }
						}
					}
				}
				@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "settings.appearance.fonts.search"), Class: "mobile-sheet", ListClass: "max-h-[min(900px,60vh)]"}) {
					@selectbox.Group(selectbox.GroupProps{Attributes: templ.Attributes{"data-font-options": "", "data-font-builtin": builtIn}}) {
						@selectbox.Item(selectbox.ItemProps{Value: "default", Selected: value == ""}) { { defaultLabel } }
						if value != "" {
							@selectbox.Item(selectbox.ItemProps{Value: value, Selected: true}) { { value } }
						}
					}
				}
			}
		</div>
	</div>
}

templ mailSingleClickOpenSetting(uiSettings map[string]string) {
	<div class="mt-4 flex items-start justify-between gap-6 data-[disabled]:opacity-50" data-mail-single-click-open-row data-disabled?={ PaneLayout(uiSettings, "mail") != "list" }>
		<div class="min-w-0">
			<span id="mail-single-click-open-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.panes.single_click_title") }</span>
			<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.panes.single_click_description") }<br/>{ i18n.T(ctx, "settings.panes.single_click_only_list") }</p>
		</div>
		@switchcomp.Switch(switchcomp.Props{
			ID:         "mail-single-click-open",
			Name:       "mail_single_click_open",
			Checked:    uiSettingGet(uiSettings, "mail_single_click_open", "false") == "true",
			Disabled:   PaneLayout(uiSettings, "mail") != "list",
			Attributes: templ.Attributes{"aria-labelledby": "mail-single-click-open-label", "data-ui-setting-switch": "mail_single_click_open"},
		})
	</div>
}

templ paneLayoutSettingRow(name string, title string, description string, layout string) {
	<div class="settings-row border-t border-border/60 pt-5">
	<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<div class="min-w-0">
			<h4 class="text-sm font-medium text-foreground">{ title }</h4>
			<p class="text-xs text-muted-foreground mt-1">{ description }</p>
		</div>
		<div class="w-full sm:w-44 shrink-0" data-pane-layout-picker>
			@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
				@selectbox.Trigger(selectbox.TriggerProps{Name: name, Class: "bg-background", DisableClear: true}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.panes.side")}) {
						{ paneLayoutLabel(ctx, layout) }
					}
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
					@selectbox.Item(selectbox.ItemProps{Value: "side", Selected: layout == "side"}) { { i18n.T(ctx, "settings.panes.side") } }
					@selectbox.Item(selectbox.ItemProps{Value: "stacked", Selected: layout == "stacked"}) { { i18n.T(ctx, "settings.panes.stacked") } }
					if name == "mail_pane_layout" {
						@selectbox.Item(selectbox.ItemProps{Value: "list", Selected: layout == "list"}) { { i18n.T(ctx, "settings.panes.list") } }
					}
				}
			}
		</div>
	</div>
	{ children... }
	</div>
}

templ SettingsRegionalTab(uiSettings map[string]string) {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.regional.card.title") }</h3>
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.regional.card.description") }</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.regional.language.title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.regional.language.description") }</p>
				</div>
				<div class="w-full shrink-0 sm:w-64" data-language-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: i18n.SettingKey, Class: "bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"data-language-input": ""}}) {
							@selectbox.Value() {
								{ languageSettingLabel(ctx, uiSettingGet(uiSettings, i18n.SettingKey, "auto")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Item(selectbox.ItemProps{Value: "auto", Selected: languageSettingValue(uiSettingGet(uiSettings, i18n.SettingKey, "auto")) == "auto"}) {
								{ i18n.T(ctx, "settings.regional.language.auto") }
							}
							for _, locale := range i18n.Locales() {
								@selectbox.Item(selectbox.ItemProps{Value: string(locale), Selected: languageSettingValue(uiSettingGet(uiSettings, i18n.SettingKey, "auto")) == string(locale), Attributes: templ.Attributes{"lang": string(locale)}}) {
									{ i18n.NativeName(locale) }
								}
							}
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.regional.date_format.title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.regional.date_format.description") }</p>
				</div>
				<div class="w-full shrink-0 sm:w-64" data-date-format-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: i18n.DateFormatSettingKey, Class: "bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"data-date-format-input": ""}}) {
							@selectbox.Value() {
								{ dateFormatLabel(ctx, dateFormatSetting(uiSettings)) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							for _, format := range i18n.DateFormats() {
								@selectbox.Item(selectbox.ItemProps{Value: format.ID, Selected: format.ID == dateFormatSetting(uiSettings)}) {
									{ dateFormatLabel(ctx, format.ID) }
								}
							}
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.regional.time_format.title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.regional.time_format.description") }</p>
				</div>
				<div class="w-full shrink-0 sm:w-64" data-time-format-picker>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: i18n.TimeFormatSettingKey, Class: "bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"data-time-format-input": ""}}) {
							@selectbox.Value() {
								{ timeFormatLabel(ctx, timeFormatSetting(uiSettings)) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							for _, format := range i18n.TimeFormats() {
								@selectbox.Item(selectbox.ItemProps{Value: format, Selected: format == timeFormatSetting(uiSettings)}) {
									{ timeFormatLabel(ctx, format) }
								}
							}
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.regional.timezone.title") }</h4>
					<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.regional.timezone.description") }</p>
				</div>
				<div class="w-full shrink-0 sm:w-64" data-timezone-picker data-current-timezone={ uiSettingGet(uiSettings, "timezone", "local") }>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "timezone", Class: "bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"data-timezone-input": ""}}) {
							@selectbox.Value() {
								{ uiSettingGet(uiSettings, "timezone", i18n.T(ctx, "settings.regional.timezone.detecting")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "settings.regional.timezone.search"), Class: "mobile-sheet w-72", Attributes: templ.Attributes{"data-timezone-options": ""}}) {
							@selectbox.Group() {
								@selectbox.Item(selectbox.ItemProps{Value: uiSettingGet(uiSettings, "timezone", "local"), Disabled: true}) {
									{ i18n.T(ctx, "settings.regional.timezone.loading") }
								}
							}
						}
					}
				</div>
			</div>
		</div>
	</div>
}

// languageSettingValue is the picker value for a saved language setting:
// a language Gofer has, or "auto".
func languageSettingValue(setting string) string {
	if locale, ok := i18n.FromSetting(setting); ok {
		return string(locale)
	}
	return "auto"
}

func languageSettingLabel(ctx context.Context, setting string) string {
	if locale, ok := i18n.FromSetting(setting); ok {
		return i18n.NativeName(locale)
	}
	return i18n.T(ctx, "settings.regional.language.auto")
}

// The date and time format choices are shown as a sample, so people pick
// what they see. December 31 shows whether the day or the month comes first.
func formatSampleTime() time.Time {
	return time.Date(time.Now().Year(), time.December, 31, 21, 30, 0, 0, time.UTC)
}

// dateFormatSetting is the saved date_format, or "auto" for one Gofer
// doesn't have.
func dateFormatSetting(uiSettings map[string]string) string {
	setting := uiSettingGet(uiSettings, i18n.DateFormatSettingKey, "auto")
	for _, format := range i18n.DateFormats() {
		if format.ID == setting {
			return setting
		}
	}
	return "auto"
}

func dateFormatLabel(ctx context.Context, id string) string {
	sample := i18n.NewDateFormatter(i18n.FromContext(ctx), id, "auto").Date(formatSampleTime())
	if id == "auto" {
		return i18n.T(ctx, "settings.regional.format.auto", "sample", sample)
	}
	return sample
}

// timeFormatSetting is the saved time_format, or "auto".
func timeFormatSetting(uiSettings map[string]string) string {
	setting := uiSettingGet(uiSettings, i18n.TimeFormatSettingKey, "auto")
	if setting == "12h" || setting == "24h" {
		return setting
	}
	return "auto"
}

func timeFormatLabel(ctx context.Context, id string) string {
	sample := i18n.NewDateFormatter(i18n.FromContext(ctx), "auto", id).Time(formatSampleTime())
	return i18n.T(ctx, "settings.regional.time_format."+id, "sample", sample)
}

templ SettingsAdvancedTab(uiSettings map[string]string) {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.advanced.title") }</h3>
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.advanced.description") }</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex items-start justify-between gap-6">
				<div class="min-w-0">
					<span id="prefetch-on-hover-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.advanced.prefetch_title") }</span>
					<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.advanced.prefetch_description") }</p>
				</div>
				@switchcomp.Switch(switchcomp.Props{
					ID:      "prefetch-on-hover",
					Name:    "prefetch_on_hover",
					Checked: uiSettingGet(uiSettings, "prefetch_on_hover", "true") != "false",
					Attributes: templ.Attributes{"aria-labelledby": "prefetch-on-hover-label", "data-ui-setting-switch": "prefetch_on_hover"},
				})
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
				<div class="min-w-0">
					<span id="desktop-notifications-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.notifications.title") }</span>
					<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.notifications.description") }</p>
					<p class="text-xs text-muted-foreground mt-2" data-desktop-notifications-status>{ i18n.T(ctx, "settings.notifications.permission_note") }</p>
					<p class="text-xs font-medium text-muted-foreground mt-1" data-notification-active-method>{ i18n.T(ctx, "settings.notifications.active_method") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0 space-y-3">
					@settingsSwitchBox(i18n.T(ctx, "settings.switch.enable")) {
						@switchcomp.Switch(switchcomp.Props{
							ID:      "desktop-notifications",
							Name:    "desktop_notifications",
							Checked: uiSettingGet(uiSettings, "desktop_notifications", "false") == "true",
							Attributes: templ.Attributes{"aria-labelledby": "desktop-notifications-label", "data-ui-setting-switch": "desktop_notifications", "data-desktop-notifications-switch": ""},
						})
					}
					<div>
						@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "notification_mode", Class: "bg-background", DisableClear: true}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.notifications.mode.auto")}) {
									{ notificationModeLabel(ctx, uiSettingGet(uiSettings, "notification_mode", "auto")) }
								}
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
								@selectbox.Item(selectbox.ItemProps{Value: "auto", Selected: uiSettingGet(uiSettings, "notification_mode", "auto") == "auto"}) { { i18n.T(ctx, "settings.notifications.mode.auto") } }
								@selectbox.Item(selectbox.ItemProps{Value: "web_push", Selected: uiSettingGet(uiSettings, "notification_mode", "auto") == "web_push"}) { { i18n.T(ctx, "settings.notifications.mode.web_push") } }
								@selectbox.Item(selectbox.ItemProps{Value: "browser_tab", Selected: uiSettingGet(uiSettings, "notification_mode", "auto") == "browser_tab"}) { { i18n.T(ctx, "settings.notifications.mode.browser_tab") } }
								@selectbox.Item(selectbox.ItemProps{Value: "off", Selected: uiSettingGet(uiSettings, "notification_mode", "auto") == "off"}) { { i18n.T(ctx, "settings.notifications.mode.off") } }
							}
						}
					</div>
					<button type="button" class="inline-flex h-8 w-full shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input bg-background px-3 text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50" data-desktop-notifications-test disabled title={ i18n.T(ctx, "settings.notifications.test_title") }>
						@icon.BellRing(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "settings.notifications.test") }
					</button>
				</div>
			</div>

			<div class="settings-row border-t border-border/60 pt-5 space-y-4" data-notification-appearance>
				<div>
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.notifications.appearance_title") }</h4>
					<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.notifications.appearance_description") }</p>
				</div>
				<div class="grid gap-4 sm:grid-cols-3">
					<div class="min-w-0 space-y-2">
						<span id="notification_title-label" class="text-xs font-medium text-foreground">{ i18n.T(ctx, "settings.notifications.title_field") }</span>
						@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "notification_title", Class: "bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"aria-labelledby": "notification_title-label"}}) {
								@selectbox.Value(selectbox.ValueProps{}) {
									{ notificationAppearanceLabel(ctx, "title", uiSettingGet(uiSettings, "notification_title", "auto")) }
								}
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
								@selectbox.Item(selectbox.ItemProps{Value: "auto", Selected: uiSettingGet(uiSettings, "notification_title", "auto") == "auto"}) { { i18n.T(ctx, "settings.notifications.title.auto") } }
								@selectbox.Item(selectbox.ItemProps{Value: "sender", Selected: uiSettingGet(uiSettings, "notification_title", "auto") == "sender"}) { { i18n.T(ctx, "settings.notifications.title.sender") } }
								@selectbox.Item(selectbox.ItemProps{Value: "gofer", Selected: uiSettingGet(uiSettings, "notification_title", "auto") == "gofer"}) { Gofer }
								@selectbox.Item(selectbox.ItemProps{Value: "count", Selected: uiSettingGet(uiSettings, "notification_title", "auto") == "count"}) { { i18n.T(ctx, "settings.notifications.title.count") } }
							}
						}
					</div>
					<div class="min-w-0 space-y-2">
						<span id="notification_content-label" class="text-xs font-medium text-foreground">{ i18n.T(ctx, "settings.notifications.content_field") }</span>
						@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "notification_content", Class: "bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"aria-labelledby": "notification_content-label"}}) {
								@selectbox.Value(selectbox.ValueProps{}) {
									{ notificationAppearanceLabel(ctx, "content", uiSettingGet(uiSettings, "notification_content", "subject")) }
								}
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
								@selectbox.Item(selectbox.ItemProps{Value: "subject", Selected: uiSettingGet(uiSettings, "notification_content", "subject") == "subject"}) { { i18n.T(ctx, "settings.notifications.content.subject") } }
								@selectbox.Item(selectbox.ItemProps{Value: "preview", Selected: uiSettingGet(uiSettings, "notification_content", "subject") == "preview"}) { { i18n.T(ctx, "settings.notifications.content.preview") } }
								@selectbox.Item(selectbox.ItemProps{Value: "hidden", Selected: uiSettingGet(uiSettings, "notification_content", "subject") == "hidden"}) { { i18n.T(ctx, "settings.notifications.content.hidden") } }
							}
						}
					</div>
					<div class="min-w-0 space-y-2">
						<span id="notification_icon-label" class="text-xs font-medium text-foreground">{ i18n.T(ctx, "settings.notifications.icon_field") }</span>
						@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "notification_icon", Class: "bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"aria-labelledby": "notification_icon-label"}}) {
								@selectbox.Value(selectbox.ValueProps{}) {
									{ notificationAppearanceLabel(ctx, "icon", uiSettingGet(uiSettings, "notification_icon", "avatar")) }
								}
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
								@selectbox.Item(selectbox.ItemProps{Value: "avatar", Selected: uiSettingGet(uiSettings, "notification_icon", "avatar") == "avatar"}) { { i18n.T(ctx, "settings.notifications.icon.avatar") } }
								@selectbox.Item(selectbox.ItemProps{Value: "gofer", Selected: uiSettingGet(uiSettings, "notification_icon", "avatar") == "gofer"}) { { i18n.T(ctx, "settings.notifications.icon.gofer") } }
							}
						}
					</div>

				</div>
				<div>
					<p class="text-xs text-muted-foreground mb-2">{ i18n.T(ctx, "settings.notifications.example") }</p>
					<div class="flex items-start gap-3 rounded-md border border-border bg-background p-4" aria-live="polite">
						<img src="/assets/logo.png" alt="" class="size-10 shrink-0 rounded-md" data-notification-preview-logo/>
						<div class="shrink-0" data-notification-preview-avatar hidden>
							@ContactAvatar(models.Contact{Name: "Alex Smith", Initials: "AS", AvatarURL: "/assets/notification-avatar.png"}, "size-10 rounded-full bg-white ring-1 ring-ink/10 shadow-[0_2px_6px_rgba(0,0,0,0.2)] [&_img]:object-top [&_img]:translate-y-1 [&_img]:scale-[0.85]", "bg-muted text-foreground")
						</div>
						<div class="min-w-0">
							<p class="text-sm font-medium text-foreground" data-notification-preview-title>Alex Smith</p>
							<p class="text-xs text-muted-foreground whitespace-pre-line break-words mt-1" data-notification-preview-body>{ i18n.T(ctx, "js.notify.example_subject") }</p>
						</div>
					</div>
					<p class="text-xs text-muted-foreground mt-2">{ i18n.T(ctx, "settings.notifications.sample_avatar") } <a href="https://github.com/golang-samples/gopher-vector" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">{ i18n.T(ctx, "settings.notifications.sample_avatar_credit") }</a> · <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">CC BY 3.0</a>.</p>
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
				<div class="min-w-0">
					<span id="title_unread_count-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.title_unread.title") }</span>
					<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.title_unread.description") }</p>
				</div>
				<div class="w-full sm:w-44 shrink-0">
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "title_unread_count", Class: "bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"aria-labelledby": "title_unread_count-label"}}) {
							@selectbox.Value(selectbox.ValueProps{}) {
								{ titleUnreadCountLabel(ctx, uiSettingGet(uiSettings, "title_unread_count", "inboxes")) }
							}
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Item(selectbox.ItemProps{Value: "inboxes", Selected: uiSettingGet(uiSettings, "title_unread_count", "inboxes") == "inboxes"}) { { i18n.T(ctx, "settings.title_unread.inboxes") } }
							@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: uiSettingGet(uiSettings, "title_unread_count", "inboxes") == "all"}) { { i18n.T(ctx, "settings.title_unread.all") } }
							@selectbox.Item(selectbox.ItemProps{Value: "off", Selected: uiSettingGet(uiSettings, "title_unread_count", "inboxes") == "off"}) { { i18n.T(ctx, "settings.title_unread.off") } }
						}
					}
				</div>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
				<div class="min-w-0">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.mailto.title") }</h4>
					<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.mailto.description_before") }<span class="font-mono">mailto:</span>{ i18n.T(ctx, "settings.mailto.description_after") }</p>
					<p id="mailto-handler-status" class="text-xs text-muted-foreground mt-2" data-mailto-handler-status>{ i18n.T(ctx, "settings.mailto.confirm") }</p>
				</div>
				<div class="flex w-full shrink-0 flex-col gap-2 sm:w-auto">
					<button type="button" class="inline-flex h-8 w-full shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input bg-background px-3 text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 sm:w-auto" data-mailto-handler-button aria-describedby="mailto-handler-status">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
							<circle cx="12" cy="12" r="4"></circle>
							<path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"></path>
						</svg>
						{ i18n.T(ctx, "settings.mailto.use") }
					</button>
					<button type="button" class="inline-flex h-8 w-full shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-input bg-background px-3 text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 sm:w-auto" data-mailto-handler-test-button aria-describedby="mailto-handler-status">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
							<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
							<path d="m9 11 3 3L22 4"></path>
						</svg>
						{ i18n.T(ctx, "settings.mailto.test") }
					</button>
				</div>
			</div>
		</div>
	</div>
}

templ SettingsContactsTab(accounts []models.Account, uiSettings map[string]string) {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.contacts.local_title") }</h3>
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.contacts.local_description") }</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 space-y-5">
				<div class="flex items-start justify-between gap-6">
					<div class="min-w-0">
						<span id="contacts-auto-create-observed-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.contacts.auto_create_title") }</span>
						<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.contacts.auto_create_description") }</p>
					</div>
					@switchcomp.Switch(switchcomp.Props{
						ID:      "contacts-auto-create-observed",
						Name:    "contacts_auto_create_observed",
						Checked: uiSettingGet(uiSettings, "contacts_auto_create_observed", "true") != "false",
						Attributes: templ.Attributes{"aria-labelledby": "contacts-auto-create-observed-label", "data-ui-setting-switch": "contacts_auto_create_observed", "data-contact-autocreate-switch": ""},
					})
				</div>
				<fieldset
					data-contact-autocreate-dependent
					disabled?={ uiSettingGet(uiSettings, "contacts_auto_create_observed", "true") == "false" }
					class={
						"space-y-5 border-t border-border/60 pt-5 transition-opacity",
						templ.KV("opacity-45 pointer-events-none saturate-50", uiSettingGet(uiSettings, "contacts_auto_create_observed", "true") == "false"),
					}
				>
					<div class="space-y-4">
						<div class="min-w-0">
							<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.contacts.sources_title") }</h4>
							<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.contacts.sources_description") }</p>
						</div>
						<div class="space-y-3">
							<div class="flex items-start justify-between gap-6">
								<div class="min-w-0">
									<span id="contacts-observed-senders-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.contacts.senders") }</span>
									<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.contacts.senders_description") }</p>
								</div>
								@switchcomp.Switch(switchcomp.Props{
									ID:      "contacts-observed-senders",
									Name:    "contacts_observed_senders",
									Checked: uiSettingCSVHas(uiSettings, "contacts_observed_sources", "senders,recipients", "senders"),
									Attributes: templ.Attributes{"aria-labelledby": "contacts-observed-senders-label", "data-contact-source-switch": "senders"},
								})
							</div>
							<div class="flex items-start justify-between gap-6">
								<div class="min-w-0">
									<span id="contacts-observed-recipients-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.contacts.recipients") }</span>
									<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.contacts.recipients_description") }</p>
								</div>
								@switchcomp.Switch(switchcomp.Props{
									ID:      "contacts-observed-recipients",
									Name:    "contacts_observed_recipients",
									Checked: uiSettingCSVHas(uiSettings, "contacts_observed_sources", "senders,recipients", "recipients"),
									Attributes: templ.Attributes{"aria-labelledby": "contacts-observed-recipients-label", "data-contact-source-switch": "recipients"},
								})
							</div>
						</div>
					</div>
					<div class="flex items-start justify-between gap-6 border-t border-border/60 pt-5">
						<div class="min-w-0">
							<span id="contacts-prevent-recreate-deleted-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.contacts.no_recreate_title") }</span>
							<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.contacts.no_recreate_description") }</p>
						</div>
						@switchcomp.Switch(switchcomp.Props{
							ID:      "contacts-prevent-recreate-deleted",
							Name:    "contacts_prevent_recreate_deleted",
							Checked: uiSettingGet(uiSettings, "contacts_prevent_recreate_deleted", "true") != "false",
							Attributes: templ.Attributes{"aria-labelledby": "contacts-prevent-recreate-deleted-label", "data-ui-setting-switch": "contacts_prevent_recreate_deleted"},
						})
					</div>
					<div class="flex items-start justify-between gap-6 border-t border-border/60 pt-5">
						<div class="min-w-0">
							<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.contacts.delete_discovered_title") }</h4>
							<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.contacts.delete_discovered_description") }</p>
						</div>
						@dialog.Trigger(dialog.TriggerProps{For: "delete-discovered-contacts-dialog"}) {
							<button type="button" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-destructive/30 px-3 py-2 text-xs font-semibold text-destructive hover:bg-destructive/10">
								@icon.Trash2(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "settings.contacts.delete_discovered") }
							</button>
						}
					</div>
				</fieldset>
				@dialog.Dialog(dialog.Props{ID: "delete-discovered-contacts-dialog"}) {
					@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
						@dialog.Header() {
							@dialog.Title() { { i18n.T(ctx, "settings.contacts.delete_discovered_title") } }
							@dialog.Description() { { i18n.T(ctx, "settings.contacts.delete_discovered_dialog") } }
						}
						<div class="rounded-lg border border-destructive/15 bg-destructive/5 p-3 text-sm text-muted-foreground">
							{ i18n.T(ctx, "settings.contacts.delete_discovered_warning") }
						</div>
						@dialog.Footer() {
							@dialog.Close() {
								<button type="button" class="inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg border border-border hover:bg-accent transition-colors">
									{ i18n.T(ctx, "common.cancel") }
								</button>
							}
							<form action="/api/settings/contacts/delete-observed" method="post">
								<button type="submit" class="inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-destructive text-white hover:bg-destructive/90 transition-colors">
									@icon.Trash2(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "settings.contacts.delete_discovered") }
								</button>
							</form>
						}
					}
				}
				<div id="contacts-suppressed-settings" hx-get="/api/settings/contacts/suppressed" hx-trigger="load" hx-swap="outerHTML" class="settings-row border-t border-border/60 pt-5">
					<div class="flex items-center justify-between gap-4">
						<div class="min-w-0">
							<div class="h-4 w-40 rounded bg-muted animate-pulse"></div>
							<div class="mt-2 h-3 w-64 rounded bg-muted animate-pulse"></div>
						</div>
						<div class="h-8 w-20 rounded bg-muted animate-pulse"></div>
					</div>
				</div>
			</div>
		</div>
		<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
			<div>
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.contacts.provider_title") }</h3>
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.contacts.provider_description") }</p>
			</div>
			<div class="settings-row border-t border-border/60 pt-5 space-y-3">
				<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
					<div class="min-w-0">
						<div class="flex flex-wrap items-center gap-2">
							<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.contacts.account_contacts") }</h4>
							<span class="rounded-full bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">{ i18n.N(ctx, "settings.contacts.accounts_count", len(contactSyncAccounts(accounts))) }</span>
						</div>
						<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.contacts.account_contacts_description") }</p>
					</div>
					if len(contactSyncAccounts(accounts)) > 0 {
						<form hx-post="/api/settings/contacts/accounts/sync" hx-target="#account-contact-sync-status" hx-swap="innerHTML">
							<button type="submit" class="inline-flex shrink-0 whitespace-nowrap items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground hover:bg-accent">
								@icon.RefreshCw(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "settings.contacts.sync_all") }
							</button>
						</form>
					} else {
						<a href="/settings/accounts" hx-get="/settings/accounts" hx-select="#settings-content" hx-target="#settings-content" hx-swap="outerHTML" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground hover:bg-accent">
							@icon.Mail(icon.Props{Class: "size-3.5"})
							{ i18n.T(ctx, "settings.contacts.connect_account") }
						</a>
					}
				</div>
				if len(contactSyncAccounts(accounts)) > 0 {
					<div class="space-y-2 border-t border-border/60 pt-3">
						<p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.contacts.account_sync") }</p>
						for _, account := range contactSyncAccounts(accounts) {
							<div class="settings-item flex items-center justify-between gap-3 rounded-lg border border-border/60 bg-background/40 px-3 py-2">
								<div class="min-w-0">
									<p class="truncate text-xs font-medium text-foreground">{ account.Name }</p>
									<p class="truncate text-[11px] text-muted-foreground">{ contactProviderLabel(ctx, account) } - { account.Email }</p>
								</div>
								<form hx-post="/api/settings/contacts/accounts/sync" hx-target="#account-contact-sync-status" hx-swap="innerHTML">
									<input type="hidden" name="account_id" value={ account.ID }/>
									<button type="submit" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs font-semibold text-foreground hover:bg-accent">
										@icon.RefreshCw(icon.Props{Class: "size-3.5"})
										{ i18n.T(ctx, "settings.contacts.sync") }
									</button>
								</form>
							</div>
						}
					</div>
				}
				<div id="account-contact-sync-status" class="mt-3"></div>
			</div>
		</div>
	</div>
}

templ GmailReauthForm(account models.Account) {
	<form method="POST" action="/api/accounts/oauth2/authorize" class="contents">
		<input type="hidden" name="flow_action" value="reconnect"/>
		<input type="hidden" name="provider" value="gmail"/>
		<input type="hidden" name="email_address" value={ account.Email }/>
		<input type="hidden" name="display_name" value={ account.Name }/>
		<input type="hidden" name="imap_host" value="imap.gmail.com"/>
		<input type="hidden" name="imap_port" value="993"/>
		<input type="hidden" name="imap_tls_mode" value="tls"/>
		<input type="hidden" name="smtp_host" value="smtp.gmail.com"/>
		<input type="hidden" name="smtp_port" value="465"/>
		<input type="hidden" name="smtp_tls_mode" value="tls"/>
		<input type="hidden" name="auth_method" value="oauth2"/>
		<input type="hidden" name="username" value={ account.Email }/>
		@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "submit", "data-account-secondary-action": "reconnect"}}) {
			@icon.RefreshCw(icon.Props{Class: "size-3.5"})
			{ i18n.T(ctx, "settings.account.reconnect") }
		}
	</form>
}

templ OutlookReauthForm(account models.Account) {
	<form method="POST" action="/api/accounts/oauth2/authorize" class="contents">
		<input type="hidden" name="flow_action" value="reconnect"/>
		<input type="hidden" name="provider" value="outlook"/>
		<input type="hidden" name="email_address" value={ account.Email }/>
		<input type="hidden" name="display_name" value={ account.Name }/>
		@dropdown.Item(dropdown.ItemProps{Class: "justify-start gap-2", Attributes: templ.Attributes{"type": "submit", "data-account-secondary-action": "reconnect"}}) {
			@icon.RefreshCw(icon.Props{Class: "size-3.5"})
			{ i18n.T(ctx, "settings.account.reconnect") }
		}
	</form>
}

func gmailAccounts(accounts []models.Account) []models.Account {
	out := make([]models.Account, 0, len(accounts))
	for _, account := range accounts {
		if account.Provider == "gmail" {
			out = append(out, account)
		}
	}
	return out
}

func contactSyncAccounts(accounts []models.Account) []models.Account {
	out := make([]models.Account, 0, len(accounts))
	for _, account := range accounts {
		if account.ContactSyncEnabled {
			out = append(out, account)
		}
	}
	return out
}

func contactProviderLabel(ctx context.Context, account models.Account) string {
switch account.ContactSyncProvider {
	case "gmail":
		return "Gmail"
	case "outlook":
		return "Outlook"
	case "carddav":
		return "CardDAV"
	case "jmap":
		return "JMAP"
	default:
		return i18n.T(ctx, "settings.contacts.provider_default")
	}
}

templ SettingsSuppressedContacts(contacts []models.Contact, totalCount int) {
	<div id="contacts-suppressed-settings" class="settings-row border-t border-border/60 pt-5">
		<div class="flex items-start justify-between gap-6">
			<div class="min-w-0">
				<div class="flex items-center gap-2">
					<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.contacts.suppressed_title") }</h4>
					<span class="rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">{ fmt.Sprintf("%d", totalCount) }</span>
				</div>
				<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.contacts.suppressed_description") }</p>
			</div>
			@dialog.Trigger(dialog.TriggerProps{For: "suppressed-contacts-dialog"}) {
				<button type="button" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">
					@icon.List(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "settings.contacts.manage") }
				</button>
			}
		</div>
		@dialog.Dialog(dialog.Props{ID: "suppressed-contacts-dialog"}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl"}) {
				@dialog.Header() {
					@dialog.Title() { { i18n.T(ctx, "settings.contacts.suppressed_title") } }
					@dialog.Description() { { i18n.T(ctx, "settings.contacts.suppressed_dialog") } }
				}
				<div class="space-y-4">
					<div class="flex items-center justify-between gap-4 rounded-lg border border-border/60 bg-background/40 p-3">
						<div class="min-w-0">
							<div class="text-sm font-medium text-foreground">{ i18n.N(ctx, "settings.contacts.suppressed_count", totalCount, "count", i18n.Number(ctx, totalCount)) }</div>
							<p class="text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "settings.contacts.suppressed_hint") }</p>
						</div>
						if totalCount > 0 {
							<form hx-post="/api/settings/contacts/suppressed/clear" hx-target="#contacts-suppressed-settings" hx-swap="outerHTML" data-confirm-action={ i18n.T(ctx, "settings.contacts.clear_all") } data-confirm-destructive data-confirm={ i18n.T(ctx, "settings.contacts.clear_all_confirm") }>
								<button type="submit" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-destructive/30 px-3 py-2 text-xs font-semibold text-destructive hover:bg-destructive/10">
									@icon.Trash2(icon.Props{Class: "size-3.5"})
									{ i18n.T(ctx, "settings.contacts.clear_all") }
								</button>
							</form>
						}
					</div>
					if totalCount == 0 {
						<div class="rounded-lg border border-dashed border-border bg-background/40 p-6 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "settings.contacts.suppressed_empty") }</div>
					} else {
						<div class="max-h-80 overflow-y-auto rounded-lg border border-border/60 bg-background/35">
							for _, contact := range contacts {
								<div class="flex items-center gap-3 border-b border-border/50 px-3 py-2.5 last:border-b-0">
									@ContactAvatar(contact, "size-8 rounded-full text-[10px] font-bold shrink-0", "bg-muted text-muted-foreground")
									<div class="min-w-0 flex-1">
										<div class="truncate text-sm font-medium text-foreground">{ contact.Name }</div>
										<div class="truncate text-xs text-muted-foreground">{ contact.Email }</div>
									</div>
									<form hx-post={ templ.URL(fmt.Sprintf("/api/settings/contacts/suppressed/%s/clear", contact.ID)) } hx-target="#contacts-suppressed-settings" hx-swap="outerHTML">
										<button type="submit" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs font-semibold text-muted-foreground hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "settings.contacts.allow_again") }</button>
									</form>
								</div>
							}
							if totalCount > len(contacts) {
								<div class="px-3 py-2 text-xs text-muted-foreground">{ i18n.N(ctx, "settings.contacts.suppressed_showing", totalCount, "shown", i18n.Number(ctx, len(contacts)), "count", i18n.Number(ctx, totalCount)) }</div>
							}
						</div>
					}
				</div>
			}
		}
	</div>
}

templ SettingsAccountsTab(accounts []models.Account) {
	<div class="settings-card mt-6 bg-card rounded-lg border p-6 space-y-5">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
			<div class="min-w-0">
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.accounts.title") }</h3>
				<p class="text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.accounts.description") }</p>
			</div>
			@SettingsAddAccountButton()
		</div>
		if len(connectedAccounts(accounts)) == 0 {
			@SettingsNoAccounts()
		}
		if len(accounts) > 0 {
			<div class="space-y-3" data-account-order-list>
				for _, a := range accounts {
					if accountIsLocalFolders(a) {
						if !a.IsDeleting {
							@SettingsLocalFoldersCard(a)
						}
					} else {
						@SettingsAccountCard(a)
					}
				}
			</div>
		}
	</div>
}

templ SettingsSyncTab(settings models.SyncSettings, uiSettings map[string]string) {
	@tabs.Tabs(tabs.Props{ID: "email-sync-folder-tabs", Class: "mt-6 gap-5", Attributes: templ.Attributes{"data-tui-tabs-local": "", "data-tui-tabs-animate-content": "", "aria-label": i18n.T(ctx, "settings.sync.tabs_label")}}) {
		@tabs.List(tabs.ListProps{Class: "bg-card"}) {
			@tabs.Trigger(tabs.TriggerProps{Value: "sync", IsActive: true, Class: "px-3 text-xs"}) {
				@icon.RefreshCw(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "settings.sync.tab_sync") }
			}
			@tabs.Trigger(tabs.TriggerProps{Value: "unified", Class: "px-3 text-xs"}) {
				@icon.Folders(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "settings.unified.title") }
			}
		}
		@tabs.Content(tabs.ContentProps{Value: "sync", IsActive: true}) {
			<form id="sync-settings-form" action="/api/settings/sync" method="POST" class="space-y-4">
				<div class="settings-card bg-card rounded-lg border p-6">
					<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
						<div class="min-w-0">
							<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.sync.frequency_title") }</h3>
							<p class="text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.sync.frequency_description") }</p>
						</div>
						<div class="w-full sm:w-40 shrink-0">
							@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "sync_interval_minutes", Class: "bg-background", DisableClear: true}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.N(ctx, "settings.sync.minutes", 5)}) {
										{ i18n.T(ctx, "settings.sync.minutes_short", "minutes", settings.SyncIntervalMinutes) }
									}
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
									@selectbox.Item(selectbox.ItemProps{Value: "1", Selected: settings.SyncIntervalMinutes == 1}) { { i18n.N(ctx, "settings.sync.minutes", 1) } }
									@selectbox.Item(selectbox.ItemProps{Value: "5", Selected: settings.SyncIntervalMinutes == 5}) { { i18n.N(ctx, "settings.sync.minutes", 5) } }
									@selectbox.Item(selectbox.ItemProps{Value: "10", Selected: settings.SyncIntervalMinutes == 10}) { { i18n.N(ctx, "settings.sync.minutes", 10) } }
									@selectbox.Item(selectbox.ItemProps{Value: "15", Selected: settings.SyncIntervalMinutes == 15}) { { i18n.N(ctx, "settings.sync.minutes", 15) } }
									@selectbox.Item(selectbox.ItemProps{Value: "30", Selected: settings.SyncIntervalMinutes == 30}) { { i18n.N(ctx, "settings.sync.minutes", 30) } }
								}
								}
								<span id="sync-save-status" class="sr-only" aria-live="polite"></span>
							</div>
						</div>
					</div>

				if len(settings.Accounts) > 0 {
					<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
						<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
							<div>
								<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.sync.mode_title") }</h3>
								if syncSettingsHasConfigurableFolderModes(settings) {
									<p class="text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.sync.mode_description_imap") }</p>
								} else {
									<p class="text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.sync.mode_description_whole") }</p>
								}
							</div>
							if syncSettingsHasConfigurableFolderModes(settings) {
								@popover.Root(popover.RootProps{ID: "sync-real-time-note", Class: "shrink-0"}) {
									@popover.Trigger() {
										<button
											type="button"
											class="flex shrink-0 items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-md"
											aria-label={ i18n.T(ctx, "settings.sync.realtime_note_label") }
										>
											@icon.TriangleAlert(icon.Props{Class: "size-3"})
											{ i18n.T(ctx, "settings.sync.realtime_note") }
										</button>
									}
									@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, ShowArrow: true, Class: "mobile-sheet w-80"}) {
										<div class="flex items-start gap-2.5 p-3">
											@icon.TriangleAlert(icon.Props{Class: "size-3.5 text-muted-foreground mt-0.5 shrink-0"})
											<p class="text-xs text-muted-foreground leading-relaxed">
												{ i18n.T(ctx, "settings.sync.realtime_note_text") }
											</p>
										</div>
									}
								}
							}
						</div>
						<div id="idle-folders-inputs"></div>
						<div class="space-y-3" data-sync-folders={ strconv.Itoa(settings.SyncIntervalMinutes) }>
							for _, account := range settings.Accounts {
								<div class="settings-item rounded-lg border border-border/60 bg-background/40 p-4" data-sync-account-card>
									<div class="flex items-center gap-2.5 mb-4">
										<div class="account-color-marker size-4 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.AccountID }></div>
										<div class="min-w-0">
											<p class="text-sm font-medium leading-tight truncate">{ account.AccountName }</p>
											<p class="text-xs text-muted-foreground truncate">{ account.AccountEmail }</p>
										</div>
									</div>
									if account.OutlookPush != nil {
										@OutlookPushControl(*account.OutlookPush)
									} else if syncSettingsAccountUsesProviderAPI(account.Provider) {
										<div class="rounded-md border border-border/70 bg-card/60 p-3">
											<div class="flex items-start gap-2.5">
												<div class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-md border border-border/70 bg-background text-muted-foreground">
													@icon.MailCheck(icon.Props{Class: "size-3.5"})
												</div>
												<div class="min-w-0">
													<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ syncSettingsProviderAPITitle(ctx, account.Provider) }</div>
													<p class="mt-1 text-xs leading-relaxed text-muted-foreground">
														{ syncSettingsProviderAPIDescription(ctx, account.Provider) }
													</p>
												</div>
											</div>
										</div>
									} else {
										<div class="grid gap-3 md:grid-cols-2">
											<div class="rounded-md border border-border/70 bg-card/60 p-3">
												<div class="flex items-center gap-1.5 mb-2">
													@icon.Zap(icon.Props{Class: "size-3 text-amber-700 opacity-70 dark:text-amber-300"})
											<span class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "settings.sync.realtime") }</span>
										</div>
										<div class="flex flex-wrap gap-1.5 min-h-[28px]" data-idle-zone={ account.AccountID }>
											for _, f := range account.Folders {
												if syncFolderUsesEffectiveIDLE(f) {
													@syncFolderPill(f, settings.SyncIntervalMinutes, account.AccountID)
												}
											}
												</div>
											</div>
											<div class="rounded-md border border-border/70 bg-card/60 p-3">
												<div class="flex items-center gap-1.5 mb-2">
													@icon.Clock(icon.Props{Class: "size-3 text-muted-foreground"})
											<span class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider" data-sync-polling-title>{ i18n.T(ctx, "settings.sync.polling", "minutes", settings.SyncIntervalMinutes) }</span>
										</div>
										<div class="flex flex-wrap gap-1.5 min-h-[28px]" data-poll-zone={ account.AccountID }>
											for _, f := range account.Folders {
												if !syncFolderUsesEffectiveIDLE(f) {
													@syncFolderPill(f, settings.SyncIntervalMinutes, account.AccountID)
												}
											}
												</div>
											</div>
										</div>
									}
								</div>
							}
						</div>
					</div>
				}
				</form>
		}
		@tabs.Content(tabs.ContentProps{Value: "unified", Class: "space-y-5"}) {
			<div class="settings-card bg-card rounded-lg border p-6 space-y-5">
				<div>
					<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.unified.title") }</h3>
					<p class="text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.unified.description") }</p>
				</div>
				<div class="settings-row border-t border-border/60 pt-5">
					<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
						<div class="min-w-0">
								<span id="unified-folders-enabled-label" class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.unified.enable_title") }</span>
							<p class="text-xs text-muted-foreground mt-1 leading-relaxed">{ i18n.T(ctx, "settings.unified.enable_description") }</p>
						</div>
						<div class="w-full sm:w-44 shrink-0">
							@settingsSwitchBox(i18n.T(ctx, "settings.switch.enable")) {
								@switchcomp.Switch(switchcomp.Props{
									ID:      "unified-folders-enabled",
									Name:    "unified_folders_enabled",
									Checked: uiSettingGet(uiSettings, "unified_folders_enabled", "true") != "false",
									Attributes: templ.Attributes{"aria-labelledby": "unified-folders-enabled-label", "data-unified-folders-setting": "enabled"},
								})
							}
						</div>
					</div>
				</div>
				<div class="settings-item overflow-hidden rounded-lg border border-border/60 bg-background/40" data-unified-folder-list data-unified-order-list>
					for _, folder := range unifiedFolderOptionsInOrder(uiSettings) {
						@UnifiedFolderSettingRow(folder, settings.UnifiedAccounts, uiSettings)
					}
				</div>
			</div>
			@ScheduledViewAppearanceSetting(uiSettings)
		}
	}
	<style>
		@keyframes sync-pill-in {
			0% { opacity: 0; transform: scale(0.9); }
			100% { opacity: 1; transform: scale(1); }
		}
		@keyframes sync-pill-out {
			0% { opacity: 1; transform: scale(1); }
			100% { opacity: 0; transform: scale(0.9); }
		}
		.sync-pill-enter { animation: sync-pill-in 220ms ease-out; }
		.sync-pill-exit { animation: sync-pill-out 160ms ease-in forwards; }
	</style>
}

templ UnifiedFolderSettingRow(folder unifiedFolderOption, accounts []models.AccountSyncStatus, uiSettings map[string]string) {
	{{ key := unifiedFolderSettingKey(folder.ID) }}
	{{ enabled := uiSettingGet(uiSettings, key, "true") != "false" }}
	{{ masterEnabled := uiSettingGet(uiSettings, "unified_folders_enabled", "true") != "false" }}
	<div
		class={
			"flex min-h-12 items-center justify-between gap-3 border-b border-border/60 bg-background px-3 py-2.5 transition-[background-color,transform] duration-200 ease-out last:border-b-0 hover:bg-muted/30",
			templ.KV("opacity-50", !masterEnabled),
		}
		data-unified-folder-dependent
		data-unified-order-item
		data-folder-id={ folder.ID }
	>
		<div class="flex min-w-0 items-center gap-3">
			@OrderHandle("data-unified-order-handle", i18n.T(ctx, "settings.folders.reorder_label", "name", folder.Name))
			<span class="flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground">
				@FolderAppearanceIcon(virtualFolderAppearance(folder.ID, uiSettings))
			</span>
			<div class="min-w-0">
				<span id={ "unified-folder-" + folder.ID + "-label" } class="text-sm font-medium text-foreground">{ folder.Name }</span>
			</div>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			@VirtualFolderAppearanceButton(folder.ID, folder.Name)
			@UnifiedFolderAccountPopover(folder, accounts, uiSettings, masterEnabled)
			@switchcomp.Switch(switchcomp.Props{
				ID:       "unified-folder-" + folder.ID,
				Name:     key,
				Checked:  enabled,
				Disabled: !masterEnabled,
				Attributes: templ.Attributes{
					"data-unified-folder-switch": folder.ID,
					"aria-labelledby":            "unified-folder-" + folder.ID + "-label",
				},
			})
		</div>
	</div>
}

templ UnifiedFolderAccountPopover(folder unifiedFolderOption, accounts []models.AccountSyncStatus, uiSettings map[string]string, masterEnabled bool) {
	if len(accounts) > 0 {
		@popover.Root(popover.RootProps{ID: fmt.Sprintf("unified-folder-%s-accounts", folder.ID), Class: "shrink-0"}) {
			@popover.Trigger() {
				<button
					type="button"
					class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/60 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-40"
					aria-label={ i18n.T(ctx, "settings.unified.choose_accounts", "folder", folder.Name) }
					disabled?={ !masterEnabled }
					data-unified-folder-account-button={ folder.ID }
				>
					@icon.Settings(icon.Props{Class: "size-3.5"})
				</button>
			}
			@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, Offset: 8, ShowArrow: true, Class: "mobile-sheet w-72 p-2"}) {
				<div class="border-b border-border/60 px-2 pb-2 text-xs font-semibold text-muted-foreground uppercase tracking-wider">{ i18n.T(ctx, "settings.accounts.title") }</div>
				<div class="max-h-72 overflow-y-auto pt-1">
					for _, account := range accounts {
						@UnifiedFolderAccountRow(folder, account, uiSettings, masterEnabled)
					}
				</div>
			}
		}
	}
}

templ UnifiedFolderAccountRow(folder unifiedFolderOption, account models.AccountSyncStatus, uiSettings map[string]string, masterEnabled bool) {
	{{ key := unifiedFolderAccountSettingKey(folder.ID, account.AccountID) }}
	{{ enabled := uiSettingGet(uiSettings, key, "true") != "false" }}
	<div class="flex min-h-11 items-center justify-between gap-3 rounded-md px-2 py-2 hover:bg-muted/40" data-unified-folder-account-dependent={ folder.ID }>
		<div class="flex min-w-0 items-center gap-2.5">
			<span class="account-color-marker size-3 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.AccountID }></span>
			<div class="min-w-0">
				<span id={ "unified-folder-" + folder.ID + "-account-" + account.AccountID + "-label" } class="block truncate text-sm font-medium text-foreground">{ syncAccountDisplayName(account) }</span>
				if account.AccountEmail != "" && account.AccountEmail != syncAccountDisplayName(account) {
					<p class="truncate text-[11px] text-muted-foreground">{ account.AccountEmail }</p>
				}
			</div>
		</div>
		@switchcomp.Switch(switchcomp.Props{
			ID:       "unified-folder-" + folder.ID + "-account-" + account.AccountID,
			Name:     key,
			Checked:  enabled,
			Disabled: !masterEnabled,
			Attributes: templ.Attributes{
				"data-unified-folder-account-switch": folder.ID,
				"data-unified-folder-account-id":     account.AccountID,
				"aria-labelledby":                    "unified-folder-" + folder.ID + "-account-" + account.AccountID + "-label",
			},
		})
	</div>
}

templ syncFolderPillToggle(f models.FolderSyncStatus) {
	<button type="button" data-sync-pill-toggle class="inline-flex min-w-0 items-center gap-1.5">
		{{ folderIcon := icon.Icon(f.Icon) }}
		@folderIcon(icon.Props{Class: "size-3 shrink-0"})
		<span class="truncate">{ syncFolderShortName(f) }</span>
	</button>
}

templ syncFolderPill(f models.FolderSyncStatus, interval int, accountID string) {
		<div
			data-sync-pill
			data-folder-id={ f.ID }
			data-role={ f.Role }
			data-account-id={ accountID }
			data-interval={ strconv.Itoa(interval) }
			data-folder-name={ syncFolderDisplayName(f) }
			data-configured-idle={ strconv.FormatBool(f.IsIDLE) }
			data-effective-idle={ strconv.FormatBool(syncFolderUsesEffectiveIDLE(f)) }
			data-idle-fallback-reason={ f.IDLEFallbackReason }
			data-idle-retry-at={ f.IDLERetryAt }
			class={
				"inline-flex max-w-full items-center gap-1.5 px-2.5 rounded-md border text-xs font-medium cursor-pointer transition-transform hover:scale-[1.02] will-change-transform backface-hidden",
				templ.KV("bg-amber-800/10 border-amber-700/20 text-amber-800 dark:bg-amber-300/10 dark:border-amber-300/20 dark:text-amber-200", syncFolderUsesEffectiveIDLE(f)),
				templ.KV("bg-muted/50 border-border text-muted-foreground", !syncFolderUsesEffectiveIDLE(f)),
			}
			style="height:26px"
		>
			if syncFolderNeedsFullName(f) {
				// The full path, for a name shortened or too long for the pill.
				@tooltip.Tooltip() {
					@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex min-w-0"}) {
						@syncFolderPillToggle(f)
					}
					@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "max-w-96 break-all px-3 py-1.5 text-xs leading-relaxed"}) {
						{ syncFolderDisplayName(f) }
					}
				}
			} else {
				@syncFolderPillToggle(f)
			}
			<span
				data-idle-fallback-warning
				class={
					templ.KV("inline-flex", hasIDLEFallback(f)),
					templ.KV("hidden", !hasIDLEFallback(f)),
				}
			>
				@tooltip.Tooltip() {
					@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
						<span class="inline-flex text-amber-700 dark:text-amber-300" aria-label={ i18n.T(ctx, "settings.sync.idle_fallback_label") }>
							@icon.TriangleAlert(icon.Props{Class: "size-3"})
						</span>
					}
					@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "max-w-72 px-3 py-1.5 text-center text-xs leading-relaxed"}) {
						<span data-idle-fallback-tooltip-text>{ idleFallbackTooltip(ctx, f) }</span>
					}
				}
			</span>
		</div>
}

func syncFolderUsesEffectiveIDLE(f models.FolderSyncStatus) bool {
	return f.IsIDLE && (f.EffectiveIDLE || strings.TrimSpace(f.IDLEFallbackReason) == "")
}

func hasIDLEFallback(f models.FolderSyncStatus) bool {
	return strings.TrimSpace(f.IDLEFallbackReason) != ""
}

// idleFallbackTooltip says why a folder fell back to polling. The reasons
// sync gives in English are translated; one from elsewhere stays as it is.
func idleFallbackTooltip(ctx context.Context, f models.FolderSyncStatus) string {
	if strings.TrimSpace(f.IDLEFallbackReason) == "" {
		return ""
	}
	reason := i18n.Stored(ctx, "sync.fallback_reason.", strings.TrimSuffix(strings.TrimSpace(f.IDLEFallbackReason), "."))
	message := i18n.T(ctx, "js.settings.sync.fallback", "folder", syncFolderDisplayName(f), "reason", reason)
	if retryAt, err := time.Parse(time.RFC3339, f.IDLERetryAt); err == nil && retryAt.After(time.Now()) {
		remaining := time.Until(retryAt)
		minutes := max(1, int((remaining+time.Minute-1)/time.Minute))
		return message + " " + i18n.N(ctx, "js.compose.retry_in", minutes, "count", minutes)
	}
	return message
}

templ SettingsNoAccounts() {
	<div class="flex flex-col items-center justify-center py-10 text-center">
		<div class="size-14 rounded-full bg-muted/50 flex items-center justify-center mb-4">
			@icon.Mail(icon.Props{Class: "size-6 text-muted-foreground"})
		</div>
		<p class="text-sm font-medium text-foreground mb-1">{ i18n.T(ctx, "settings.accounts.none_title") }</p>
		<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.accounts.none_description") }</p>
	</div>
}

templ SettingsAccountCard(account models.Account) {
	{{ syncError := strings.TrimSpace(account.EmailSyncError) }}
	{{ syncErrorAt := strings.TrimSpace(account.EmailSyncErrorAt) }}
	<div
		id={ fmt.Sprintf("account-card-%s", account.ID) }
		data-settings-account-card
		data-account-id={ account.ID }
		data-account-email={ account.Email }
		data-account-deleting={ fmt.Sprintf("%t", account.IsDeleting) }
		class="transition-[opacity,transform] duration-200 ease-out"
	>
		<div class="settings-account-card settings-item rounded-lg border border-border/60 bg-background/40 p-4">
			<div class="flex items-start justify-between gap-3">
				<div class="flex min-w-0 items-start gap-3">
					if !account.IsDeleting {
						@SettingsAccountOrderHandle(account)
					}
					@AccountColorPopover(account)
					<div class="min-w-0">
						<div class="flex min-w-0 items-center gap-1.5">
							<p class="min-w-0 truncate text-sm font-semibold text-foreground">{ account.Name }</p>
							if jmapAccountPaused(account) {
								@SettingsAccountJMAPPausedPopover(account)
							}
							@SettingsAccountSyncErrorPopover(account, syncError, syncErrorAt)
							if account.Provider == "imap" && !account.IsDeleting {
								@SettingsAccountMissingFolderRoles(account, false)
							}
							if accountHasNoMail(account) {
								@AccountNoMailBadge(account)
							}
						</div>
						<p class="mt-0.5 truncate text-xs text-muted-foreground">{ accountAddressIn(ctx, account) }</p>
						if account.ReconnectPending && !account.IsDeleting {
							<p class="mt-1.5 flex items-start gap-1.5 text-xs text-amber-700 dark:text-amber-400" data-account-reconnect-pending>
								@icon.KeyRound(icon.Props{Class: "mt-0.5 size-3.5 shrink-0"})
								<span>{ accountReconnectPendingMessage(ctx, account) }</span>
							</p>
						}
					</div>
				</div>
				<div class="flex shrink-0 items-center justify-end gap-2" data-account-actions>
					if account.IsDeleting {
						<button type="button" data-account-deleting-status role="status" aria-live="polite" class="inline-flex items-center gap-1.5 text-xs text-amber-700 dark:text-amber-400 px-2.5 py-1.5 rounded-md border border-amber-300/40 dark:border-amber-500/30 bg-amber-100/50 dark:bg-amber-500/10 cursor-default" disabled>
							@icon.RefreshCw(icon.Props{Class: "size-3.5 animate-spin"})
							{ i18n.T(ctx, "settings.account.deleting") }
						</button>
					} else {
						if account.ReconnectPending {
							@AccountReconnectButton(account)
						}
						if accountHasNoMail(account) {
							@AccountAddMailButton(account.ID, account.Name, accountReconnectButtonClass)
						}
						<button
							type="button"
							data-account-primary-action="edit"
							class="account-action-btn inline-flex h-[30px] items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors px-2.5 rounded-md border border-border"
							hx-get={ fmt.Sprintf("/api/accounts/%s/edit", account.ID) }
							hx-target="#edit-account-container"
							hx-swap="innerHTML"
						>
							@icon.Pencil(icon.Props{Class: "size-3.5"})
							{ i18n.T(ctx, "settings.account.edit") }
						</button>
						@SettingsAccountActionsMenu(account)
					}
				</div>
			</div>
			<div class="mt-4 border-t border-border/60 pt-3">
				<div class="mb-2 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
					if accountHasNoMail(account) {
						<p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.account.service_heading") }</p>
					} else {
						<p class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.account.services_heading") }</p>
						<p class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "settings.account.services_hint") }</p>
					}
				</div>
				<div class="settings-account-services flex items-end justify-between gap-3">
					<div class="flex flex-wrap gap-2">
						if account.DAVService == davServiceContacts {
							@AccountServiceIndicator(account, "contacts", i18n.T(ctx, "settings.account.service.contacts"), accountContactSyncStatusDescription(ctx, account), account.ContactSyncEnabled)
						} else if account.DAVService == davServiceCalendar {
							@AccountServiceIndicator(account, "calendar", i18n.T(ctx, "settings.account.service.calendar"), accountCalendarSyncStatusDescription(ctx, account), account.CalendarSyncEnabled)
						} else {
							@AccountServiceIndicator(account, "email", i18n.T(ctx, "settings.account.service.email"), i18n.T(ctx, "settings.account.service.email_description"), account.EmailSyncEnabled)
							@AccountServiceIndicator(account, "contacts", i18n.T(ctx, "settings.account.service.contacts"), accountContactSyncStatusDescription(ctx, account), account.ContactSyncEnabled)
							@AccountServiceIndicator(account, "calendar", i18n.T(ctx, "settings.account.service.calendar"), accountCalendarSyncStatusDescription(ctx, account), account.CalendarSyncEnabled)
						}
					</div>
					<span class="inline-flex shrink-0 items-center gap-1 rounded-md border border-border/70 bg-muted/35 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">
						@AccountProviderIcon(accountDisplayProvider(account), "size-3.5 shrink-0")
						{ accountProviderName(accountDisplayProvider(account)) }
					</span>
				</div>
			</div>
			if account.EmailSyncEnabled && !account.IsDeleting {
				@SettingsAccountMailboxSize(account)
			}
		</div>
		if !account.IsDeleting && !accountHasNoMail(account) {
			@SettingsAccountConnectionTestDialog(account)
		}
		if account.Provider == "gmail" && account.EmailSyncEnabled && !account.IsDeleting {
			@dialog.Dialog(dialog.Props{ID: fmt.Sprintf("repair-account-%s", account.ID)}) {
				@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
					@dialog.Header() {
						@dialog.Title() {
							{ i18n.T(ctx, "settings.account.repair_title") }
						}
						@dialog.Description() {
							{ i18n.T(ctx, "settings.account.repair_before") }<strong>{ account.Email }</strong>{ i18n.T(ctx, "settings.account.repair_after") }
						}
					}
					<div class="flex items-center gap-3 rounded-lg border border-border bg-background/60 p-3">
						<div class="account-color-marker size-5 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.ID }></div>
						<div class="min-w-0 flex-1">
							<p class="truncate text-sm font-medium">{ account.Name }</p>
							<p class="truncate text-xs text-muted-foreground">{ account.Email }</p>
						</div>
					</div>
					@dialog.Footer() {
						@dialog.Close() {
							<button
								type="button"
								class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent"
							>
								{ i18n.T(ctx, "common.cancel") }
							</button>
						}
						<button
							type="button"
							class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
							hx-post={ fmt.Sprintf("/api/mail/sync/accounts/%s/repair", account.ID) }
							hx-swap="none"
							data-on-htmx-before-request='["handleMailSidebarSyncStart","$event","repair"]'
							data-on-htmx-after-request='["handleMailSidebarSyncResult","$event"]'
							data-mail-account-sync-button={ account.ID }
							data-repair-account-action="true"
							data-account-id={ account.ID }
						>
							@icon.RefreshCw(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "settings.account.repair_start") }
						</button>
					}
				}
			}
		}
		@dialog.Dialog(dialog.Props{ID: fmt.Sprintf("delete-account-%s", account.ID)}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
				@dialog.Header() {
					@dialog.Title() {
						{ i18n.T(ctx, "settings.account.delete_title") }
					}
					@dialog.Description() {
						if accountHasNoMail(account) {
							{ i18n.T(ctx, "settings.account.delete_dav_before") }<strong>{ account.Name }</strong>{ i18n.T(ctx, "settings.account.delete_dav_after") }
						} else {
							{ i18n.T(ctx, "settings.account.delete_before") }<strong>{ account.Email }</strong>{ i18n.T(ctx, "settings.account.delete_after") }
						}
					}
				}
				<div class="flex items-center gap-3 p-3 rounded-lg bg-destructive/5 border border-destructive/15">
					<div class="account-color-marker size-5 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.ID }></div>
					<div class="flex-1 min-w-0">
						<p class="text-sm font-medium truncate">{ account.Name }</p>
						<p class="text-xs text-muted-foreground truncate">{ accountAddressIn(ctx, account) }</p>
					</div>
				</div>
				@dialog.Footer() {
					@dialog.Close() {
						<button
							type="button"
							class="inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg border border-border hover:bg-accent transition-colors"
						>
							{ i18n.T(ctx, "common.cancel") }
						</button>
					}
					<button
						type="button"
						data-account-delete-submit
						class="inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-destructive text-white hover:bg-destructive/90 transition-colors"
						hx-delete={ fmt.Sprintf("/api/accounts/%s", account.ID) }
						hx-swap="none"
						data-delete-account-action="true"
						data-account-id={ account.ID }
					>
						@icon.Trash2(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "settings.account.delete_title") }
					</button>
				}
			}
		}
	</div>
}

const accountReconnectButtonClass = "inline-flex h-[30px] items-center gap-1.5 rounded-md bg-primary px-2.5 text-xs font-medium text-primary-foreground transition-colors hover:bg-primary/90"

// AccountReconnectButton finishes setting up an account imported without its
// credentials: Gmail and Outlook sign in again, other accounts open Edit to
// take the password.
templ AccountReconnectButton(account models.Account) {
	if slices.Contains(account.ReconnectNeeds, reconnectSignIn) {
		<form method="POST" action="/api/accounts/oauth2/authorize" class="contents">
			<input type="hidden" name="flow_action" value="reconnect"/>
			<input type="hidden" name="provider" value={ account.Provider }/>
			<input type="hidden" name="email_address" value={ account.Email }/>
			<input type="hidden" name="display_name" value={ account.Name }/>
			<button type="submit" data-account-primary-action="reconnect" class={ accountReconnectButtonClass }>
				@icon.RefreshCw(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "settings.account.reconnect") }
			</button>
		</form>
	} else {
		<button
			type="button"
			data-account-primary-action="reconnect"
			class={ accountReconnectButtonClass }
			hx-get={ fmt.Sprintf("/api/accounts/%s/edit", account.ID) }
			hx-target="#edit-account-container"
			hx-swap="innerHTML"
		>
			@icon.KeyRound(icon.Props{Class: "size-3.5"})
			{ accountReconnectButtonLabel(ctx, account) }
		</button>
	}
}

templ SettingsAccountSyncErrorPopover(account models.Account, syncError string, syncErrorAt string) {
	<span
		data-settings-account-sync-error={ account.ID }
		hidden?={ !account.EmailSyncEnabled || syncError == "" }
		class="inline-flex shrink-0"
		aria-live="polite"
	>
		@popover.Root(popover.RootProps{ID: fmt.Sprintf("account-sync-error-%s", account.ID), Class: "shrink-0"}) {
			@popover.Trigger() {
				<button
					type="button"
					class="inline-flex size-6 items-center justify-center rounded-md text-destructive transition-colors hover:bg-destructive/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive/40"
					aria-label={ i18n.T(ctx, "settings.account.sync_error_label", "account", account.Name) }
				>
					@icon.CircleAlert(icon.Props{Class: "size-4"})
				</button>
			}
			@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, ShowArrow: true, Class: "mobile-sheet w-80 p-3"}) {
				<div class="flex items-start gap-2.5">
					@icon.CircleAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-destructive"})
					<div class="min-w-0 flex-1">
						<p class="text-sm font-semibold text-popover-foreground">{ i18n.T(ctx, "mail.sync.failed") }</p>
						<p
							data-settings-account-sync-error-at-wrapper
							hidden?={ syncErrorAt == "" }
							class="mt-0.5 text-[11px] text-muted-foreground"
						>
							{ i18n.T(ctx, "mail.sync.last_failure_label") }
							<span data-account-sync-error-at={ syncErrorAt }>{ formatAccountSyncErrorAt(ctx, syncErrorAt, nil) }</span>
						</p>
						<p class="mt-2 break-words text-xs leading-relaxed text-muted-foreground" data-settings-account-sync-error-message>{ syncError }</p>
					</div>
				</div>
			}
		}
	</span>
}

// SettingsAccountMissingFolderRoles warns, next to an IMAP account's name,
// that roles of its folders weren't found, and opens Folder roles to set
// them. It is always there, empty while nothing is missing, so saving the
// roles can swap it in place.
templ SettingsAccountMissingFolderRoles(account models.Account, oob bool) {
	<span id={ "account-missing-folder-roles-" + account.ID } class="inline-flex shrink-0 empty:hidden" { swapOOB(oob)... }>
		if len(account.MissingFolderRoles) > 0 {
			@settingsAccountMissingFolderRolesAlert(account)
		}
	</span>
}

// FolderRolesMenuAlert marks the Folder roles item of an account's menu
// while roles of its folders weren't found.
templ FolderRolesMenuAlert(account models.Account, oob bool) {
	<span id={ "folder-roles-menu-alert-" + account.ID } class="ml-auto inline-flex text-destructive empty:hidden" { swapOOB(oob)... }>
		if len(account.MissingFolderRoles) > 0 {
			<span class="inline-flex" aria-label={ missingFolderRolesText(ctx, account.MissingFolderRoles) } data-folder-roles-missing-alert>
				@icon.CircleAlert(icon.Props{Class: "size-3.5"})
			</span>
		}
	</span>
}

func swapOOB(oob bool) templ.Attributes {
	if oob {
		return templ.Attributes{"hx-swap-oob": "true"}
	}
	return templ.Attributes{}
}

templ settingsAccountMissingFolderRolesAlert(account models.Account) {
	@tooltip.Tooltip() {
		@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex shrink-0"}) {
			<button
				type="button"
				class="inline-flex size-6 items-center justify-center rounded-md text-destructive transition-colors hover:bg-destructive/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-destructive/40"
				aria-label={ missingFolderRolesText(ctx, account.MissingFolderRoles) }
				hx-get={ fmt.Sprintf("/api/accounts/%s/folder-roles/manage", account.ID) }
				hx-target="#edit-account-container"
				hx-swap="innerHTML"
				data-settings-account-missing-folder-roles={ account.ID }
			>
				@icon.CircleAlert(icon.Props{Class: "size-4"})
			</button>
		}
		@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "max-w-72 px-3 py-1.5 text-center text-xs leading-relaxed"}) {
			{ missingFolderRolesText(ctx, account.MissingFolderRoles) }
		}
	}
}

// missingFolderRolesText says which folders weren't found, such as
// "Couldn't find the Trash and Spam folders. Set them in Folder roles."
func missingFolderRolesText(ctx context.Context, roles []string) string {
	labels := make([]string, len(roles))
	for i, role := range roles {
		labels[i] = folderRoleName(ctx, role)
	}
	if len(labels) == 1 {
		return i18n.T(ctx, "settings.folder_roles.missing_one", "folder", labels[0])
	}
	return i18n.T(ctx, "settings.folder_roles.missing_many", "folders", settingsJoinAnd(ctx, labels))
}

templ SettingsAccountJMAPPausedPopover(account models.Account) {
	<span data-settings-account-jmap-paused={ account.ID } class="inline-flex shrink-0">
		@popover.Root(popover.RootProps{ID: fmt.Sprintf("account-jmap-paused-%s", account.ID), Class: "shrink-0"}) {
			@popover.Trigger(popover.TriggerProps{TriggerType: popover.TriggerTypeHover}) {
				<button
					type="button"
					class="inline-flex size-6 items-center justify-center rounded-md text-amber-600 transition-colors hover:bg-amber-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500/40 dark:text-amber-400"
					aria-label={ i18n.T(ctx, "settings.account.jmap_paused_label", "account", account.Name) }
				>
					@icon.TriangleAlert(icon.Props{Class: "size-4"})
				</button>
			}
			@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, ShowArrow: true, Class: "mobile-sheet w-80 p-3 text-xs leading-relaxed text-popover-foreground"}) {
				@JMAPPausedExplanation()
			}
		}
	</span>
}

type accountConnectionTestService struct {
	ID          string
	Label       string
	Description string
}

func accountConnectionTestServices(ctx context.Context, account models.Account) []accountConnectionTestService {
	switch strings.ToLower(strings.TrimSpace(account.Provider)) {
	case providers.ProviderJMAP:
		return []accountConnectionTestService{{
			ID:          "jmap",
			Label:       "JMAP",
			Description: i18n.T(ctx, "settings.account.test.checking_service", "service", "JMAP"),
		}}
	case "gmail":
		return []accountConnectionTestService{{
			ID:          "gmail",
			Label:       "Gmail API",
			Description: i18n.T(ctx, "settings.account.test.checking_service", "service", "Gmail API"),
		}}
	case "outlook":
		return []accountConnectionTestService{{
			ID:          "graph",
			Label:       "Microsoft Graph",
			Description: i18n.T(ctx, "settings.account.test.checking_service", "service", "Microsoft Graph"),
		}}
	}
	return []accountConnectionTestService{
		{ID: "imap", Label: "IMAP", Description: i18n.T(ctx, "settings.account.test.checking_incoming")},
		{ID: "smtp", Label: "SMTP", Description: i18n.T(ctx, "settings.account.test.checking_outgoing")},
	}
}

templ AccountConnectionTestStateIcon() {
	<span class="relative block size-5 shrink-0" aria-hidden="true">
		<span class="account-test-state-icon text-muted-foreground" data-account-test-icon="testing">
			@icon.LoaderCircle(icon.Props{Class: "size-5 animate-spin"})
		</span>
		<span class="account-test-state-icon text-emerald-600 dark:text-emerald-400" data-account-test-icon="success">
			@icon.CircleCheck(icon.Props{Class: "size-5"})
		</span>
		<span class="account-test-state-icon text-destructive" data-account-test-icon="error">
			@icon.CircleX(icon.Props{Class: "size-5"})
		</span>
	</span>
}

templ SettingsAccountConnectionTestDialog(account models.Account) {
	{{ dialogID := fmt.Sprintf("test-account-%s", account.ID) }}
	@dialog.Dialog(dialog.Props{ID: dialogID}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "settings.account.test_title") }
				}
			}
			<div class="flex items-center gap-3 rounded-lg border border-border bg-background/60 p-3" data-account-test-identity>
				<div class="account-color-marker size-5 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.ID }></div>
				<div class="min-w-0 flex-1">
					<p class="truncate text-sm font-medium">{ account.Name }</p>
					<p class="truncate text-xs text-muted-foreground">{ account.Email }</p>
				</div>
			</div>
			<div class="space-y-3" data-account-test-status aria-live="polite">
				<div class="grid grid-cols-1 gap-3">
					for _, service := range accountConnectionTestServices(ctx, account) {
						<div
							class="account-test-service-card flex min-h-[72px] items-center gap-3 rounded-lg border p-3"
							data-account-test-service={ service.ID }
							data-account-test-loading-label={ service.Description }
							data-state="testing"
						>
							@AccountConnectionTestStateIcon()
							<div class="min-w-0 flex-1">
								<p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ service.Label }</p>
								<p class="mt-0.5 text-xs font-medium text-foreground" data-account-test-service-status>{ service.Description }</p>
								<p class="mt-0.5 hidden break-words text-xs text-muted-foreground" data-account-test-service-detail></p>
							</div>
						</div>
						<div class="hidden" data-account-test-service-warning={ service.ID }>
							<div class="flex items-start gap-3 rounded-lg border border-amber-500/25 bg-amber-500/10 p-3">
								@icon.TriangleAlert(icon.Props{Class: "size-5 shrink-0 text-amber-700 dark:text-amber-300"})
								<p class="min-w-0 flex-1 break-words text-xs leading-relaxed text-amber-800 dark:text-amber-200" data-account-test-service-warning-text></p>
							</div>
						</div>
					}
				</div>
			</div>
			@dialog.Footer() {
				@dialog.Close() {
					<button type="button" class="inline-flex items-center justify-center rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent">
						{ i18n.T(ctx, "common.close") }
					</button>
				}
				<button
					type="button"
					class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent disabled:pointer-events-none disabled:opacity-50"
					hx-post={ fmt.Sprintf("/api/accounts/%s/test", account.ID) }
					hx-swap="none"
					data-on-htmx-before-request='["handleAccountTestStart","$event"]'
					data-on-htmx-after-request='["handleAccountTestResult","$event"]'
					data-account-test-dialog={ dialogID }
					data-account-test-retry
					disabled
				>
					@icon.RefreshCw(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "settings.account.test_again") }
				</button>
			}
		}
	}
}

// SettingsAccountOrderHandle drags the account's card to a new place in the
// list. Focused, the arrow keys move it up and down.
templ SettingsAccountOrderHandle(account models.Account) {
	@OrderHandle("data-account-order-handle", i18n.T(ctx, "settings.account.reorder_label", "account", account.Name))
}

// OrderHandle drags its item to a new place in a list that settings.js puts
// in order; attribute names the list's kind of handle.
templ OrderHandle(attribute, label string) {
	<button
		type="button"
		{ templ.Attributes{attribute: ""}... }
		class="-ml-1.5 flex h-5 shrink-0 cursor-grab touch-none items-center rounded px-0.5 text-muted-foreground/70 transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:cursor-grabbing"
		aria-label={ label }
		title={ i18n.T(ctx, "settings.account.drag") }
	>
		@icon.GripVertical(icon.Props{Class: "size-4"})
	</button>
}

// SettingsAccountMoveItem moves the account's card one place up or down.
// The page turns it off for the first or last account.
templ SettingsAccountMoveItem(direction string) {
	@dropdown.Item(dropdown.ItemProps{
		Class: "justify-start gap-2 disabled:pointer-events-none disabled:opacity-50",
		Attributes: templ.Attributes{
			"type":              "button",
			"data-account-move": direction,
		},
	}) {
		if direction == "up" {
			@icon.ArrowUp(icon.Props{Class: "size-3.5"})
			{ i18n.T(ctx, "settings.account.move_up") }
		} else {
			@icon.ArrowDown(icon.Props{Class: "size-3.5"})
			{ i18n.T(ctx, "settings.account.move_down") }
		}
	}
}

templ SettingsAccountActionsMenu(account models.Account) {
	@dropdown.Dropdown(dropdown.Props{ID: fmt.Sprintf("account-actions-menu-%s", account.ID)}) {
		@dropdown.Trigger() {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
				Class:   "account-action-btn size-[30px] text-muted-foreground hover:text-foreground shadow-none",
				Attributes: templ.Attributes{
					"aria-label": i18n.T(ctx, "settings.account.more_actions", "account", account.Name),
				},
			}) {
				@icon.EllipsisVertical(icon.Props{Class: "size-4"})
			}
		}
		@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomEnd, Class: "mobile-sheet w-48 normal-case tracking-normal", Attributes: templ.Attributes{"data-account-actions-menu": account.ID}}) {
			@dropdown.Label(dropdown.LabelProps{Class: "text-[10px] uppercase tracking-wider text-muted-foreground"}) {
				{ i18n.T(ctx, "settings.account.actions") }
			}
			if !accountHasNoMail(account) {
				@dialog.Trigger(dialog.TriggerProps{For: fmt.Sprintf("test-account-%s", account.ID)}) {
					{{ testDialogID := fmt.Sprintf("test-account-%s", account.ID) }}
					@dropdown.Item(dropdown.ItemProps{
						ID:    fmt.Sprintf("test-btn-%s", account.ID),
						Class: "justify-start gap-2",
						Attributes: templ.Attributes{
							"type":                         "button",
							"data-account-id":              account.ID,
							"data-account-primary-action":  "test",
							"data-account-test-dialog-open": "",
							"data-account-test-dialog":      testDialogID,
							"hx-post":                      fmt.Sprintf("/api/accounts/%s/test", account.ID),
							"hx-swap":                      "none",
							"data-on-htmx-before-request":         onAction("handleAccountTestStart", actionEvent),
							"data-on-htmx-after-request":          onAction("handleAccountTestResult", actionEvent),
						},
					}) {
						@icon.Wifi(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "settings.account.test") }
					}
				}
				@dropdown.Item(dropdown.ItemProps{
					Class: "justify-start gap-2",
					Attributes: templ.Attributes{
						"type":      "button",
						"hx-get":    fmt.Sprintf("/api/accounts/%s/identities/manage", account.ID),
						"hx-target": "#edit-account-container",
						"hx-swap":   "innerHTML",
					},
				}) {
					@icon.AtSign(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "settings.account.identities") }
				}
				@dropdown.Item(dropdown.ItemProps{
					Class: "justify-start gap-2",
					Attributes: templ.Attributes{
						"type":      "button",
						"hx-get":    fmt.Sprintf("/api/accounts/%s/folders/manage", account.ID),
						"hx-target": "#edit-account-container",
						"hx-swap":   "innerHTML",
					},
				}) {
					if account.Provider == "gmail" {
						@icon.Tags(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "settings.account.labels") }
					} else {
						@icon.Folders(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "settings.account.folders") }
					}
				}
			}
			if account.Provider == "imap" {
				@dropdown.Item(dropdown.ItemProps{
					Class: "justify-start gap-2",
					Attributes: templ.Attributes{
						"type":      "button",
						"hx-get":    fmt.Sprintf("/api/accounts/%s/folder-roles/manage", account.ID),
						"hx-target": "#edit-account-container",
						"hx-swap":   "innerHTML",
					},
				}) {
					@icon.FolderCog(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "settings.account.folder_roles") }
					@FolderRolesMenuAlert(account, false)
				}
			}
			if account.Provider == "gmail" {
				@GmailReauthForm(account)
				if account.EmailSyncEnabled {
					@dialog.Trigger(dialog.TriggerProps{For: fmt.Sprintf("repair-account-%s", account.ID)}) {
						@dropdown.Item(dropdown.ItemProps{
							Class: "justify-start gap-2",
							Attributes: templ.Attributes{
								"type":                          "button",
								"data-account-secondary-action": "repair",
								"data-mail-account-sync-button": account.ID,
							},
						}) {
							@icon.Wrench(icon.Props{Class: "size-3.5"})
							{ i18n.T(ctx, "settings.account.repair") }
						}
					}
				}
			} else if account.Provider == "outlook" {
				@OutlookReauthForm(account)
			}
			@dropdown.Separator()
			@SettingsAccountMoveItem("up")
			@SettingsAccountMoveItem("down")
			@dropdown.Separator()
			@dialog.Trigger(dialog.TriggerProps{For: fmt.Sprintf("delete-account-%s", account.ID)}) {
				@dropdown.Item(dropdown.ItemProps{
					Class: "justify-start gap-2 text-destructive hover:bg-destructive/10 hover:text-destructive focus:bg-destructive/10 focus:text-destructive",
					Attributes: templ.Attributes{
						"type":                          "button",
						"data-account-secondary-action": "delete",
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "settings.account.delete") }
				}
			}
		}
	}
}
	templ AccountServiceIndicator(account models.Account, service string, label string, description string, enabled bool) {
		<div
			title={ description }
			aria-label={ i18n.T(ctx, "settings.account.service.aria", "service", label, "state", serviceStateLabel(ctx, enabled), "description", description) }
			class={
				"inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-xs font-medium",
				templ.KV("border-emerald-500/25 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300", enabled),
				templ.KV("border-border bg-muted/35 text-muted-foreground", !enabled),
			}
		>
			if service == "email" {
				@icon.Mail(icon.Props{Class: "size-3"})
			} else if service == "contacts" {
				@icon.Users(icon.Props{Class: "size-3"})
			} else {
				@icon.CalendarDays(icon.Props{Class: "size-3"})
			}
		<span>{ label }</span>
		<span class="text-[10px] font-semibold uppercase tracking-wide opacity-75">{ serviceStateLabel(ctx, enabled) }</span>
		</div>
	}

func serviceStateLabel(ctx context.Context, enabled bool) string {
	if enabled {
		return i18n.T(ctx, "settings.account.service.on")
	}
	return i18n.T(ctx, "settings.account.service.off")
}

func accountContactSyncConfigurable(account models.Account) bool {
	provider := strings.TrimSpace(account.Provider)
	return provider == "gmail" || provider == "outlook" || strings.TrimSpace(account.ContactSyncProvider) != ""
}

func accountContactSyncStatusDescription(ctx context.Context, account models.Account) string {
	if account.ContactSyncEnabled {
		return i18n.T(ctx, "settings.account.service.contacts_on")
	}
	if accountContactSyncConfigurable(account) {
		return i18n.T(ctx, "settings.account.service.contacts_unused")
	}
	return i18n.T(ctx, "settings.account.service.contacts_unset")
}

func accountCalendarSyncStatusDescription(ctx context.Context, account models.Account) string {
	if account.CalendarSyncEnabled {
		return i18n.T(ctx, "settings.account.service.calendar_on")
	}
	return i18n.T(ctx, "settings.account.service.calendar_unset")
}

// accountDisplayProvider names the service an account is shown as: iCloud
// accounts are IMAP accounts underneath.
func accountDisplayProvider(account models.Account) string {
	if account.MailService == providers.MailServiceICloud {
		return providers.MailServiceICloud
	}
	return account.Provider
}

// editAccountSkipsSending reports whether an account sends with the same
// connection its mail sync uses, so its edit wizard has no sending step.
func editAccountSkipsSending(data models.EditAccountData) bool {
	return accountEditUsesProviderAPI(data.Provider) || editAccountIsICloud(data) || editAccountIsJMAP(data)
}

func editAccountIsJMAP(data models.EditAccountData) bool {
	return data.Provider == providers.ProviderJMAP
}

// editAccountIsICloud reports whether the account being edited is on iCloud
// Mail. Its forms leave out server settings, which are always Apple's.
func editAccountSMTPPasswordPlaceholder(ctx context.Context, data models.EditAccountData) string {
	if data.ReconnectSMTP {
		return i18n.T(ctx, "settings.account.password.enter")
	}
	return i18n.T(ctx, "settings.account.password.keep")
}

func editAccountPasswordPlaceholder(ctx context.Context, data models.EditAccountData) string {
	if editAccountNeeds(data, reconnectMail) {
		return i18n.T(ctx, "settings.account.password.enter")
	}
	return i18n.T(ctx, "settings.account.password.keep")
}

func editAccountIsICloud(data models.EditAccountData) bool {
	return providers.IsICloudAccount(data.Provider, data.AuthMethod, data.IMAPHost)
}

func accountProviderName(provider string) string {
	switch strings.TrimSpace(provider) {
	case "gmail":
		return "Gmail"
	case "outlook":
		return "Outlook"
	case providers.MailServiceICloud:
		return "iCloud"
	case providers.ProviderJMAP:
		return "JMAP"
	case providers.ProviderDAV:
		return "DAV"
	case providers.ProviderLocal:
		return "Local"
	default:
		return "IMAP"
	}
}

templ AccountProviderIcon(provider string, class string) {
	if strings.TrimSpace(provider) == "gmail" {
		<svg class={ class } role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
			<title>Gmail</title>
			<path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457Z"/>
		</svg>
	} else if strings.TrimSpace(provider) == "outlook" {
		<svg class={ class } viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
			<path d="m13 4.69375 0 5.239c0 .115-.04.212-.119.288-.079.077-.176.115-.29.115h-4.2735v-3.4795l.8.6145c.051.0425.1145.063.1895.063.074 0 .1385-.0205.1945-.0635L13 4.69375Zm-4.6825-1.0105h4.2735c.1055 0 .1965.0315.2715.096.075.064.117.15.124.255l-3.6845 2.938-.9845-.7745v-2.5145Zm-.6155-2.251v11.1355L1 11.40975v-8.7875l6.703-1.19-.001 0Zm-2.0245 5.59c-.01-.5665-.1565-1.036-.4395-1.407-.2775-.37-.6375-.5655-1.0655-.582-.412.0165-.7645.2115-1.05.582-.285.371-.4275.841-.435 1.407.0075.5585.1575 1.0235.4425 1.3955.2855.37.637.5665 1.0505.588.4275-.0175.787-.212 1.0725-.585.285-.374.435-.84.4425-1.3985h-.018Zm-1.56-1.241c.2155.01.397.128.5415.3585.1425.2305.2175.5225.2175.876 0 .3605-.0745.6535-.2175.8855-.1505.232-.33.352-.548.352-.218 0-.3975-.113-.5475-.345-.15-.232-.2175-.525-.2175-.877 0-.3525.0675-.6455.2175-.87.142-.225.323-.345.5405-.3605l.0135-.0195Z"/>
		</svg>
	} else if strings.TrimSpace(provider) == providers.MailServiceICloud {
		<svg class={ class } role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
			<title>iCloud</title>
			<path d="M13.762 4.29a6.51 6.51 0 0 0-5.669 3.332 3.571 3.571 0 0 0-1.558-.36 3.571 3.571 0 0 0-3.516 3A4.918 4.918 0 0 0 0 14.796a4.918 4.918 0 0 0 4.92 4.914 4.93 4.93 0 0 0 .617-.045h14.42c2.305-.272 4.041-2.258 4.043-4.589v-.009a4.594 4.594 0 0 0-3.727-4.508 6.51 6.51 0 0 0-6.511-6.27z"/>
		</svg>
	} else if strings.TrimSpace(provider) == providers.ProviderJMAP {
		<svg class={ class } role="img" viewBox="0 0 69 80" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
			<title>JMAP</title>
			<path d="M64.2488 46.6806L61.3055 43.7394C61.0952 43.5294 60.7168 43.5294 60.4645 43.7394L55.8393 48.3613C55.6291 48.5714 55.6291 48.9495 55.8393 49.2016L58.7826 52.1428L54.0312 56.8907H68.9581V41.9747L64.2068 46.7226L64.2488 46.6806Z"/>
			<path d="M69 64.5798H61.2633V69.4958C61.2633 71.0504 60.0018 72.2689 58.4881 72.2689H10.5119C8.95612 72.2689 7.73675 71.0084 7.73675 69.4958V56.6806C7.73675 55.3361 8.24132 54.0756 9.20841 53.1512L30.1901 32.1848C31.2834 31.0924 32.755 30.3781 34.2687 30.2941C35.9506 30.21 37.5484 30.8403 38.7258 32.0168L42.8885 36.1764C43.0987 36.3865 43.4771 36.3865 43.7294 36.1764L48.3547 31.5546C48.5649 31.3445 48.5649 30.9663 48.3547 30.7142L44.4022 26.7647C41.8793 24.2437 38.5576 22.689 35.0256 22.563C31.1993 22.4369 27.5411 23.8655 24.8501 26.5546L3.74223 47.7311C1.34552 50.126 0 53.3193 0 56.7226V69.5378C0 75.3361 4.70932 80.042 10.5119 80.042H58.4881C64.2907 80.042 69 75.3361 69 69.5378V64.6218V64.5798Z"/>
			<path d="M4.75137 33.3193L7.6947 36.2605C7.90494 36.4706 8.28336 36.4706 8.53565 36.2605L13.1609 31.6387C13.3711 31.4286 13.3711 31.0504 13.1609 30.7983L10.2175 27.8572L14.9689 23.1093H0V38.0252L4.75137 33.2773V33.3193Z"/>
			<path d="M0 15.4202H7.73675V10.5042C7.73675 8.94958 8.99817 7.73109 10.5119 7.73109H58.4881C60.0439 7.73109 61.2633 8.9916 61.2633 10.5042V23.3193C61.2633 24.6639 60.7587 25.9244 59.7916 26.8487L38.8099 47.8151C37.7166 48.9076 36.245 49.6219 34.7313 49.7059C33.0494 49.7899 31.4516 49.1597 30.2742 47.9832L26.1115 43.8235C25.9013 43.6134 25.5229 43.6134 25.2706 43.8235L20.6453 48.4454C20.4351 48.6555 20.4351 49.0336 20.6453 49.2857L24.5978 53.2353C27.1207 55.7563 30.4424 57.3109 33.9744 57.437C37.8007 57.563 41.4589 56.1345 44.1499 53.4454L65.2578 32.3529C67.6545 29.958 69 26.7647 69 23.3613V10.5462C69 4.70588 64.2907 0 58.4881 0H10.5119C4.70932 0 0 4.70588 0 10.5042V15.4202Z"/>
		</svg>
	} else if strings.TrimSpace(provider) == providers.ProviderDAV {
		@icon.Server(icon.Props{Class: class})
	} else if strings.TrimSpace(provider) == providers.ProviderLocal {
		@icon.Monitor(icon.Props{Class: class})
	} else {
		@icon.Mail(icon.Props{Class: class})
	}
}

templ AccountColorPopover(account models.Account) {
	@popover.Root(popover.RootProps{ID: fmt.Sprintf("account-color-%s", account.ID), Class: "shrink-0"}) {
		@popover.Trigger() {
			<button
				type="button"
				class="account-color-marker size-5 shrink-0 cursor-pointer ring-2 ring-transparent ring-offset-2 ring-offset-background transition-[box-shadow,filter] hover:brightness-110 hover:ring-border focus-visible:outline-none focus-visible:ring-ring"
				style={ accountColorStyle(account.Color) }
				data-account-marker={ account.ID }
				aria-label={ i18n.T(ctx, "settings.account.color_label", "account", account.Name) }
			></button>
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, ShowArrow: true, Class: "mobile-sheet w-64"}) {
			<div class="p-3" data-account-color-picker data-account-id={ account.ID }>
				<div class="mb-3 flex items-start justify-between gap-3">
					<div class="min-w-0">
						<p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.account.marker_color") }</p>
						<p class="mt-0.5 truncate text-sm font-medium text-popover-foreground">{ account.Name }</p>
					</div>
					<div class="account-color-marker size-6 shrink-0" style={ accountColorStyle(account.Color) } data-account-marker={ account.ID }></div>
				</div>
				<div class="grid grid-cols-6 gap-2">
					for _, color := range accountColorOptions() {
						<button
							type="button"
							class="account-color-swatch size-7 rounded-full transition-transform hover:scale-110 focus-visible:outline-none"
							style={ accountColorStyle(color) }
							data-account-color-option={ color }
							data-account-color-active={ fmt.Sprintf("%t", accountColorSelected(account.Color, color)) }
							aria-label={ i18n.T(ctx, "settings.account.color_use", "color", color) }
							aria-pressed={ fmt.Sprintf("%t", accountColorSelected(account.Color, color)) }
						></button>
					}
				</div>
				<div class="mt-3 flex items-center gap-2 rounded-md border border-border/70 bg-background/50 px-2.5 py-2">
					<label for={ fmt.Sprintf("account-color-custom-%s", account.ID) } class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.account.color_custom") }</label>
					<input
						id={ fmt.Sprintf("account-color-custom-%s", account.ID) }
						type="color"
						value={ accountColorValue(account.Color) }
						class="h-7 w-9 cursor-pointer rounded border border-border bg-transparent p-0.5"
						data-account-color-custom
					/>
					<span class="ml-auto text-xs text-muted-foreground" data-account-color-status></span>
					</div>
				</div>
			}
		}
}

// ThemeColorsCardActions sit on a style's card: a pencil to change its colors
// while it is selected, and a trash once it has changes to discard.
templ ThemeColorsCardActions(uiSettings map[string]string, style string) {
	<div class="absolute right-2 top-2 z-20 flex gap-1">
		@ThemeColorsEditButton(style)
		<span class={ templ.KV("hidden", !themeColorsChanged(uiSettings, style)) } data-theme-colors-discard-wrap={ style }>
			@tooltip.Tooltip() {
				@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
					<button type="button" class="inline-flex size-7 items-center justify-center rounded-md border border-border bg-background/90 text-destructive shadow-sm transition-colors hover:bg-destructive/10" data-theme-colors-discard={ style } aria-label={ i18n.T(ctx, "settings.theme.discard_label", "style", themeStyleName(ctx, style)) }>
						@icon.Trash2(icon.Props{Class: "size-3.5"})
					</button>
				}
				@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionBottom}) {
					{ i18n.T(ctx, "settings.theme.discard") }
				}
			}
		</span>
	</div>
}

// ThemeColorsDialog changes the selected style's colors. settings-page.js
// fills it when it opens and previews every change on the page.
templ ThemeColorsDialog() {
	@dialog.Dialog(dialog.Props{ID: "theme-colors-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					<span data-theme-colors-title>{ i18n.T(ctx, "settings.theme.edit_colors") }</span>
				}
				@dialog.Description() {
					{ i18n.T(ctx, "settings.theme.edit_description") }
					<span data-theme-colors-modes-note>{ i18n.T(ctx, "settings.theme.modes_note") }</span>
				}
			}
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div class="inline-flex rounded-lg border border-border bg-background p-0.5 gap-0.5" data-theme-colors-modes>
					for _, mode := range []string{"light", "dark"} {
						<button type="button" class="inline-flex items-center px-3 py-1.5 rounded-md text-xs font-medium text-muted-foreground transition-colors hover:text-foreground data-[active=true]:bg-muted data-[active=true]:text-foreground data-[active=true]:shadow-sm" data-theme-colors-mode={ mode }>
							if mode == "light" {
								{ i18n.T(ctx, "settings.appearance.mode.light") }
							} else {
								{ i18n.T(ctx, "settings.appearance.mode.dark") }
							}
						</button>
					}
				</div>
				<span class="text-xs text-muted-foreground" data-theme-colors-count></span>
			</div>
			<div class="max-h-[55vh] space-y-5 overflow-y-auto pr-1" data-theme-colors-editor>
				for _, group := range themecolors.Groups {
					<section>
						<h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ themeColorGroupName(ctx, group.Label) }</h4>
						<div class="grid gap-x-4 gap-y-1 sm:grid-cols-2">
							for _, v := range group.Variables {
								<div class="flex items-center gap-2.5 rounded-md px-1.5 py-1 data-[changed=true]:bg-accent/60" data-theme-colors-row={ v.Name }>
									<input id={ "theme-color-" + v.Name } type="color" class="h-8 w-10 shrink-0 cursor-pointer rounded border border-border bg-transparent p-0.5" data-theme-colors-input={ v.Name }/>
									<div class="min-w-0 flex-1">
										<label for={ "theme-color-" + v.Name } class="block truncate text-sm text-foreground">{ i18n.T(ctx, "settings.theme.color."+v.Name) }</label>
										if v.Hint != "" {
											<p class="truncate text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.hint."+v.Name) }</p>
										}
									</div>
									<span class="font-mono text-xs text-muted-foreground" data-theme-colors-value></span>
									<button type="button" class="invisible inline-flex size-6 shrink-0 items-center justify-center rounded text-muted-foreground hover:bg-accent hover:text-foreground" data-theme-colors-reset={ v.Name } aria-label={ i18n.T(ctx, "settings.theme.reset_color", "color", i18n.T(ctx, "settings.theme.color."+v.Name)) }>
										@icon.RotateCcw(icon.Props{Class: "size-3.5"})
									</button>
								</div>
							}
						</div>
					</section>
				}
			</div>
			@dialog.Footer() {
				@button.Button(button.Props{Variant: button.VariantGhost, Class: "sm:mr-auto", Attributes: templ.Attributes{"data-theme-colors-reset-all": ""}}) {
					@icon.RotateCcw(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "settings.theme.reset_all") }
				}
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						{ i18n.T(ctx, "common.cancel") }
					}
				}
				@button.Button(button.Props{Attributes: templ.Attributes{"data-theme-colors-save": ""}}) {
					{ i18n.T(ctx, "settings.theme.save_colors") }
				}
			}
		}
	}
}

// ThemeColorsEditButton opens the color editor for a style. It shows only
// while that style is selected.
templ ThemeColorsEditButton(style string) {
	<span class="hidden group-has-[:checked]/theme:inline-flex">
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
				<button type="button" class="inline-flex size-7 items-center justify-center rounded-md border border-border bg-background/90 text-muted-foreground shadow-sm transition-colors hover:bg-accent hover:text-foreground" data-theme-colors-edit={ style } aria-label={ i18n.T(ctx, "settings.theme.edit_label", "style", themeStyleName(ctx, style)) }>
					@icon.Pencil(icon.Props{Class: "size-3.5"})
				</button>
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionBottom}) {
				{ i18n.T(ctx, "settings.theme.edit_colors") }
			}
		}
	</span>
}

// customThemeEditMenu is a Custom theme card's pencil: it opens the theme
// builder on that theme, or the editor for single colors that the other
// styles' pencils open. It shows on the selected card, so the theme it edits
// is the one the page is drawn with. It also duplicates the theme, unless
// full says there are as many themes as Gofer keeps.
templ customThemeEditMenu(id string, full bool) {
	<span class="hidden group-has-[:checked]/theme:inline-flex">
		@dropdown.Dropdown() {
			@dropdown.Trigger() {
				<button type="button" class="inline-flex size-7 items-center justify-center rounded-md border border-border bg-background/90 text-muted-foreground shadow-sm transition-colors hover:bg-accent hover:text-foreground" aria-label={ i18n.T(ctx, "settings.theme.edit_custom") }>
					@icon.Pencil(icon.Props{Class: "size-3.5"})
				</button>
			}
			@dropdown.Content(dropdown.ContentProps{Placement: dropdown.PlacementBottomStart, Class: "w-60"}) {
				@dropdown.Item(dropdown.ItemProps{Class: "items-start justify-start gap-2.5", Attributes: templ.Attributes{"data-custom-theme-edit": id}}) {
					@icon.WandSparkles(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
					<span class="flex flex-col gap-0.5 text-left">
						<span>{ i18n.T(ctx, "settings.theme.builder") }</span>
						<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.builder_hint") }</span>
					</span>
				}
				@dropdown.Item(dropdown.ItemProps{Class: "items-start justify-start gap-2.5", Attributes: templ.Attributes{"data-theme-colors-edit": "custom"}}) {
					@icon.Palette(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
					<span class="flex flex-col gap-0.5 text-left">
						<span>{ i18n.T(ctx, "settings.theme.edit_each") }</span>
						<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.edit_each_hint") }</span>
					</span>
				}
				@dropdown.Item(dropdown.ItemProps{Class: "items-start justify-start gap-2.5", Disabled: full, Attributes: templ.Attributes{"data-custom-theme-duplicate": id}}) {
					@icon.Copy(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
					<span class="flex flex-col gap-0.5 text-left">
						<span>{ i18n.T(ctx, "settings.theme.duplicate") }</span>
						if full {
							<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.duplicate_full") }</span>
						} else {
							<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.duplicate_hint") }</span>
						}
					</span>
				}
			}
		}
	</span>
}

// customThemesSection lists the saved Custom themes as cards in the style
// picker, each drawn in its own colors, under the button that builds a new
// one.
templ customThemesSection(uiSettings map[string]string) {
	{{ themes := themebuilder.ListFromSettings(uiSettings) }}
	{{ full := len(themes) >= themebuilder.MaxThemes }}
	<div class="space-y-4 border-t border-border/60 pt-5" data-custom-themes>
		<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
			<div class="min-w-0">
				<h4 class="text-sm font-medium text-foreground">{ i18n.T(ctx, "settings.theme.own_title") }</h4>
				if full {
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.full", "count", themebuilder.MaxThemes) }</p>
				} else {
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.own_description") }</p>
				}
			</div>
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "shrink-0", Disabled: full, Attributes: templ.Attributes{"data-custom-theme-build": ""}}) {
				@icon.WandSparkles(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.theme.new") }
			}
		</div>
		if len(themes) > 0 {
			@templ.Raw(`<style data-custom-theme-cards>` + customThemeCardsCSS(themes) + `</style>`)
			<div class="grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-2xl">
				for _, theme := range themes {
					@CustomThemeCard(theme, customThemeSelected(uiSettings, theme.ID), full)
				}
			</div>
		}
	</div>
}

// CustomThemeCard is a saved Custom theme in the style picker. Its preview is
// drawn with the theme's own palette (customThemeCardsCSS).
templ CustomThemeCard(theme themebuilder.Saved, selected bool, full bool) {
	<div id={ customThemeCardID(theme.ID) } class="group/theme relative flex" data-theme-card="custom" data-custom-theme-id={ theme.ID }>
		<label class="relative flex flex-1 flex-col rounded-lg border-2 p-3 cursor-pointer transition-all duration-200 text-left hover:shadow-md group border-border has-[:checked]:border-primary has-[:checked]:ring-2 has-[:checked]:ring-primary/20">
			@radio.Radio(radio.Props{Name: "theme_style", Value: "custom", Checked: selected, Class: "absolute right-2.5 bottom-2.5 z-10", Attributes: templ.Attributes{"data-custom-theme-id": theme.ID}})
			<div data-theme="custom" data-theme-preview class={ "overflow-hidden h-36 mb-2 flex", customThemeModeClass(theme) } style="background:var(--background); border-radius:var(--radius)">
				<div class="w-1/4 p-2 flex flex-col gap-1.5" style="background:var(--sidebar); border-right:1px solid var(--sidebar-border)">
					<div style="height:3px; width:70%; background:var(--sidebar-foreground); opacity:0.5; border-radius:var(--radius)"></div>
					<div style="height:3px; width:90%; background:var(--sidebar-foreground); opacity:0.3; border-radius:var(--radius)"></div>
					<div style="height:3px; width:50%; background:var(--sidebar-primary); border-radius:var(--radius)"></div>
					<div style="height:3px; width:80%; background:var(--sidebar-foreground); opacity:0.3; border-radius:var(--radius)"></div>
					<div style="height:3px; width:60%; background:var(--sidebar-foreground); opacity:0.3; border-radius:var(--radius)"></div>
				</div>
				<div class="flex-1 p-2 flex flex-col gap-1.5" style="background:var(--background)">
					<div style="height:3px; width:60%; background:var(--foreground); opacity:0.3; border-radius:var(--radius); margin-bottom:2px"></div>
					<div class="flex-1 p-2 flex flex-col" style="background:var(--card); border:1px solid var(--border); border-radius:var(--radius)">
						<div style="height:2px; width:75%; background:var(--foreground); opacity:0.4; margin-bottom:3px"></div>
						<div style="height:2px; width:50%; background:var(--primary); margin-bottom:3px"></div>
						<div style="height:2px; width:85%; background:var(--foreground); opacity:0.2; margin-bottom:3px"></div>
						<div style="height:2px; width:60%; background:var(--foreground); opacity:0.15; margin-bottom:3px"></div>
						<div style="height:2px; width:90%; background:var(--foreground); opacity:0.1; margin-bottom:3px"></div>
						<div style="flex:1; width:100%; background:var(--secondary); border-radius:calc(var(--radius) * 0.6); margin-bottom:3px"></div>
						<div style="display:inline-flex; gap:4px; margin-top:auto">
							<div style="height:10px; width:28px; background:var(--primary); border-radius:calc(var(--radius) * 0.75)"></div>
							<div style="height:10px; width:28px; background:var(--card); border:1px solid var(--border); border-radius:calc(var(--radius) * 0.75)"></div>
						</div>
					</div>
				</div>
			</div>
			<span class="truncate text-sm font-medium text-foreground leading-tight">{ theme.Name }</span>
			<span class="text-xs text-muted-foreground">
					if theme.Dark() {
						{ i18n.T(ctx, "settings.theme.dark_base") }
					} else {
						{ i18n.T(ctx, "settings.theme.light_base") }
					}
			</span>
		</label>
		<div class="absolute right-2 top-2 z-20 flex gap-1">
			@customThemeEditMenu(theme.ID, full)
			@tooltip.Tooltip() {
				@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
					<button type="button" class="inline-flex size-7 items-center justify-center rounded-md border border-border bg-background/90 text-destructive shadow-sm transition-colors hover:bg-destructive/10" data-custom-theme-delete={ theme.ID } data-custom-theme-delete-name={ theme.Name } aria-label={ i18n.T(ctx, "settings.theme.delete_label", "theme", theme.Name) }>
						@icon.Trash2(icon.Props{Class: "size-3.5"})
					</button>
				}
				@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionBottom}) {
					{ i18n.T(ctx, "settings.theme.delete") }
				}
			}
		</div>
	</div>
}

// CustomThemeDialog is the theme builder. settings-page.js fills it when it
// opens, from the saved theme or the selected style, and shows every change in
// the preview frame; the page itself changes only when the theme is saved.
templ CustomThemeDialog() {
	@dialog.Dialog(dialog.Props{ID: "custom-theme-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "custom-theme-dialog sm:max-w-[min(96vw,88rem)] max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:flex [&>[data-tui-dialog-panel]]:max-h-[calc(100dvh-2rem)] [&>[data-tui-dialog-panel]]:flex-col"}) {
			@dialog.Header() {
				@dialog.Title() { { i18n.T(ctx, "settings.theme.builder") } }
				@dialog.Description() { { i18n.T(ctx, "settings.theme.builder_description") } }
			}
			<div class="grid min-h-0 flex-1 gap-5 overflow-y-auto md:grid-cols-[19rem_minmax(0,1fr)] md:grid-rows-[minmax(0,1fr)] md:overflow-hidden" data-custom-theme-builder>
				<div class="space-y-5 px-1.5 md:h-0 md:min-h-full md:overflow-y-auto md:pr-2" data-custom-theme-controls>
					<div class="space-y-2">
						<label for="custom-theme-name" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "settings.theme.name") }</label>
						@input.Input(input.Props{ID: "custom-theme-name", Type: input.TypeText, Attributes: templ.Attributes{"maxlength": strconv.Itoa(themebuilder.MaxNameLength), "autocomplete": "off", "data-custom-theme-name": ""}})
					</div>
					@customThemeBase()
					<fieldset class="space-y-2">
						<legend class="mb-2 flex w-full items-center gap-2 text-sm font-semibold text-foreground">
							{ i18n.T(ctx, "settings.theme.primary") }
							<span class="ml-auto font-mono text-xs font-normal text-muted-foreground" data-custom-theme-seed-value></span>
						</legend>
						@customThemeSwatches("data-custom-theme-seed-option", "data-custom-theme-seed")
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.primary_hint") }</p>
					</fieldset>
					<fieldset class="space-y-2">
						<legend class="mb-2 flex w-full items-center gap-2 text-sm font-semibold text-foreground">
							{ i18n.T(ctx, "settings.theme.secondary") }
							<span class="ml-auto font-mono text-xs font-normal text-muted-foreground" data-custom-theme-secondary-value></span>
						</legend>
						@customThemeSecondarySwatches()
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.secondary_hint") }</p>
					</fieldset>
					<div class="space-y-3">
						@customThemeChoice(i18n.T(ctx, "settings.theme.tint"), i18n.T(ctx, "settings.theme.tint_info"), "tint", []customThemeOption{{"primary", i18n.T(ctx, "settings.theme.tint.primary")}, {"secondary", i18n.T(ctx, "settings.theme.tint.secondary")}, {"none", i18n.T(ctx, "settings.theme.tint.none")}})
						@customThemeSubChoice(i18n.T(ctx, "settings.theme.strength"), "strength", []customThemeOption{{"subtle", i18n.T(ctx, "settings.theme.strength.subtle")}, {"strong", i18n.T(ctx, "settings.theme.strength.strong")}, {"strongest", i18n.T(ctx, "settings.theme.strength.strongest")}})
					</div>
					@customThemeChoice(i18n.T(ctx, "settings.theme.contrast"), i18n.T(ctx, "settings.theme.contrast_info"), "contrast", []customThemeOption{{"normal", i18n.T(ctx, "settings.theme.contrast.normal")}, {"high", i18n.T(ctx, "settings.theme.contrast.high")}, {"highest", i18n.T(ctx, "settings.theme.contrast.highest")}})
					@customThemeChoice(i18n.T(ctx, "settings.theme.sidebar"), "", "sidebar", []customThemeOption{{"darker", i18n.T(ctx, "settings.theme.sidebar.darker")}, {"lighter", i18n.T(ctx, "settings.theme.sidebar.lighter")}})
					@customThemeChoice(i18n.T(ctx, "settings.theme.depth"), "", "depth", []customThemeOption{{"raised", i18n.T(ctx, "settings.theme.depth.raised")}, {"flat", i18n.T(ctx, "settings.theme.depth.flat")}})
					@customThemeChoice(i18n.T(ctx, "settings.theme.corners"), "", "corners", []customThemeOption{{"square", i18n.T(ctx, "settings.theme.corners.square")}, {"small", i18n.T(ctx, "settings.theme.corners.small")}, {"medium", i18n.T(ctx, "settings.theme.corners.medium")}, {"large", i18n.T(ctx, "settings.theme.corners.large")}})
					<p class="hidden rounded-md border border-border bg-muted/60 px-3 py-2 text-xs text-muted-foreground" data-custom-theme-reset-warning></p>
				</div>
				<div class="flex min-w-0 flex-col gap-2 [justify-content:safe_center] md:min-h-0 md:overflow-y-auto">
					<span class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "settings.theme.preview") }</span>
					<div class="relative w-full max-w-[1000px] overflow-hidden rounded-md border border-border bg-background" data-custom-theme-preview-stage>
						<iframe title={ i18n.T(ctx, "settings.theme.preview_title") } sandbox="allow-same-origin" tabindex="-1" class="pointer-events-auto absolute left-0 top-0 origin-top-left border-0" style="width:1060px;height:620px" data-custom-theme-preview-frame></iframe>
					</div>
					<template data-custom-theme-preview-template>
						@CustomThemePreview()
					</template>
				</div>
			</div>
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						{ i18n.T(ctx, "common.cancel") }
					}
				}
				@button.Button(button.Props{Attributes: templ.Attributes{"data-custom-theme-save": ""}}) {
					{ i18n.T(ctx, "settings.theme.save") }
				}
			}
		}
	}
}

// customThemeSwatches are the suggested colors, each marked with attribute,
// and a last tile that opens a color picker marked with pickerAttribute. The
// tile shows the picked color once one outside the suggestions is chosen.
templ customThemeSwatches(attribute string, pickerAttribute string) {
	<div class="flex flex-wrap gap-2">
		for _, preset := range themebuilder.Presets {
			<button
				type="button"
				class="account-color-swatch size-7 rounded-full transition-transform hover:scale-110 focus-visible:outline-none"
				style={ accountColorStyle(preset.Color) }
				{ templ.Attributes{attribute: preset.Color}... }
				data-account-color-active="false"
				aria-label={ i18n.T(ctx, "settings.theme.preset."+strings.ToLower(preset.Name)) }
				aria-pressed="false"
			></button>
		}
		@customThemePickerTile(pickerAttribute)
	</div>
}

// customThemeSecondarySwatches are colors that go with the primary color,
// which settings-page.js works out from it whenever it changes, and the
// color picker tile. The first follows the primary color.
templ customThemeSecondarySwatches() {
	<div class="flex flex-wrap gap-2">
		for _, suggestion := range secondarySuggestions {
			@tooltip.Tooltip() {
				@tooltip.Trigger() {
					<button
						type="button"
						class="account-color-swatch size-7 rounded-full transition-transform hover:scale-110 focus-visible:outline-none"
						data-custom-theme-secondary-option=""
						data-custom-theme-suggestion-turn={ strconv.Itoa(suggestion.Turn) }
						data-custom-theme-suggestion-chroma={ suggestion.Chroma }
						data-account-color-active="false"
						aria-label={ secondarySuggestionName(ctx, suggestion.Name) }
						aria-pressed="false"
					></button>
				}
				@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true}) {
					{ secondarySuggestionName(ctx, suggestion.Name) }
				}
			}
		}
		@customThemePickerTile("data-custom-theme-secondary")
	</div>
}

// customThemePickerTile opens a color picker, marked with pickerAttribute.
templ customThemePickerTile(pickerAttribute string) {
	<label class="account-color-swatch custom-theme-picker-tile relative flex size-7 cursor-pointer items-center justify-center rounded-full text-muted-foreground transition-transform hover:scale-110" data-account-color-active="false" data-custom-theme-picker-tile>
		@icon.Plus(icon.Props{Class: "custom-theme-picker-plus size-4"})
		<input type="color" value="#2563eb" class="absolute inset-0 size-full cursor-pointer opacity-0" aria-label={ i18n.T(ctx, "settings.theme.other_color") } { templ.Attributes{pickerAttribute: ""}... }/>
	</label>
}

// CustomThemePreview is the app, with made-up mail, in the theme builder's
// preview frame. It is a trimmed copy of the real sidebar, mail list and
// reader, with the same classes, so the theme looks as it will; keep it in
// step with them. Its sizes are its own: the frame runs no scripts, which the
// app needs to apply saved panel sizes.
templ CustomThemePreview() {
	{{ emails := themePreviewEmails(ctx) }}
	<div class="flex h-screen overflow-hidden">
		@customThemePreviewSidebar()
		<div class="resize-handle pointer-events-none"></div>
		<div class="flex w-[21.5rem] shrink-0 flex-col border-r border-border bg-card h-full overflow-hidden">
			<div class="mail-list-header px-4 py-4 space-y-3">
				<div class="mail-list-title-row flex items-center gap-2">
					<h2 class="text-lg font-bold tracking-tight" style="font-family: var(--font-serif)">{ i18n.T(ctx, "folder.inbox") }</h2>
				</div>
				<div class="mail-list-search-input-wrap relative groove rounded-lg min-w-0">
					@icon.Search(icon.Props{Class: "absolute left-2.5 top-1/2 -translate-y-1/2 size-3.5 text-muted-foreground"})
					<input type="text" placeholder={ i18n.T(ctx, "settings.theme.preview.search") } tabindex="-1" readonly class="h-9 w-full pl-8 pr-3 rounded-lg text-sm bg-background border border-border/50 outline-none"/>
				</div>
			</div>
			<hr class="divider-etched"/>
			<div id="mail-list-scroll" class="min-h-0 flex-1 overflow-hidden px-2 py-2" data-mail-card-fields="avatar,from,date,attachment,to,subject,preview,labels,starred">
				for i, email := range emails {
					@customThemePreviewCard(email, i == 1)
				}
			</div>
		</div>
		<div class="flex flex-1 flex-col min-w-0 bg-background surface-desk">
			@customThemePreviewReader(emails[1])
		</div>
	</div>
}

templ customThemePreviewSidebar() {
	<div class="flex w-max shrink-0 flex-col surface-leather text-sidebar-foreground h-full overflow-hidden">
		<div class="px-4 pt-5 pb-4">
			<div class="sidebar-app-nav relative grid h-8 w-full grid-cols-3 gap-0.5 rounded-lg border border-sidebar-border bg-sidebar-accent/35 p-0.5">
				<div class="absolute top-0.5 bottom-0.5 left-0.5 rounded-md border border-sidebar-border bg-sidebar-accent shadow-sm" style={ sidebarAppIndicatorStyle("mail") }></div>
				@customThemePreviewAppTab(icon.Mail(icon.Props{Class: "size-3.5"}), i18n.T(ctx, "app.mail"), true)
				@customThemePreviewAppTab(icon.BookUser(icon.Props{Class: "size-3.5"}), i18n.T(ctx, "contacts.title"), false)
				@customThemePreviewAppTab(icon.CalendarDays(icon.Props{Class: "size-3.5"}), i18n.T(ctx, "app.calendar"), false)
			</div>
		</div>
		<div class="px-4 pb-4">
			<div class="btn-skeuo flex items-center justify-center gap-2 w-full h-10 rounded-lg text-sidebar-primary-foreground font-semibold text-sm">
				@icon.Pen(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "mail.compose") }
			</div>
		</div>
		<hr class="divider-etched mx-4"/>
		<div class="flex-1 overflow-hidden px-3 pt-2 pb-3">
			<div class="flex w-full items-center gap-2.5 px-2 py-2 text-sm font-semibold text-sidebar-accent-foreground">
				<span class="flex size-4 shrink-0 items-center justify-center text-sidebar-primary">
					@icon.Folders(icon.Props{Class: "size-4"})
				</span>
				<span class="flex-1 truncate">{ i18n.T(ctx, "settings.unified.title") }</span>
				@icon.ChevronDown(icon.Props{Class: "size-3.5 shrink-0 text-sidebar-foreground"})
			</div>
			<div class="space-y-px mt-0.5">
				@customThemePreviewFolder("inbox", i18n.T(ctx, "folder.inbox"), 2, true)
				@customThemePreviewFolder("starred", i18n.T(ctx, "folder.starred"), 0, false)
				@customThemePreviewFolder("send", i18n.T(ctx, "folder.sent"), 0, false)
				@customThemePreviewFolder("file", i18n.T(ctx, "folder.drafts"), 1, false)
				@customThemePreviewFolder("archive", i18n.T(ctx, "folder.archive"), 0, false)
				@customThemePreviewFolder("trash", i18n.T(ctx, "folder.trash"), 0, false)
			</div>
			<div class="mt-1.5 flex w-full items-center gap-2.5 px-2 py-2 text-sm font-semibold text-sidebar-accent-foreground">
				<div class="account-color-marker size-2.5 shrink-0" style={ accountColorStyle("#0d9488") }></div>
				<span class="flex-1 truncate">{ i18n.T(ctx, "settings.theme.preview.account") }</span>
				@icon.ChevronRight(icon.Props{Class: "size-3.5 shrink-0 text-sidebar-foreground"})
			</div>
		</div>
		<div class="px-4 py-3 border-t border-sidebar-border">
			<div class="flex items-center gap-2 px-2 py-1.5 rounded-md text-sidebar-foreground text-[13px]">
				<span class="flex size-4 shrink-0 items-center justify-center">
					@icon.Settings(icon.Props{Class: "size-4"})
				</span>
				<span class="truncate">{ i18n.T(ctx, "settings.section.default.title") }</span>
			</div>
		</div>
	</div>
}

templ customThemePreviewAppTab(tabIcon templ.Component, label string, active bool) {
	<span
		class={
			"relative z-10 inline-flex h-7 min-w-0 items-center justify-center gap-1 rounded-md px-2 text-xs font-medium",
			templ.KV("text-sidebar-accent-foreground", active),
			templ.KV("text-sidebar-foreground", !active),
		}
	>
		@tabIcon
		<span class="truncate">{ label }</span>
	</span>
}

templ customThemePreviewFolder(folderIcon string, name string, unread int, active bool) {
	<div
		class={
			"flex w-full items-center gap-2.5 rounded-md px-2.5 py-1.5 text-[13px] transition-all duration-150",
			templ.KV("bg-sidebar-accent text-sidebar-primary font-medium", active),
			templ.KV("text-sidebar-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-accent-foreground", !active),
		}
	>
		<span class="flex size-5 shrink-0 items-center justify-center rounded text-sidebar-foreground">
			@SidebarFolderIcon(folderIcon)
		</span>
		<span class="flex-1 truncate">{ name }</span>
		if unread > 0 {
			<span
				data-folder-unread
				class={
					"min-w-5 h-5 px-1.5 flex items-center justify-center rounded-full text-[11px] font-semibold tabular-nums",
					templ.KV("bg-sidebar-primary/20 text-sidebar-primary", active),
					templ.KV("bg-sidebar-accent text-sidebar-foreground", !active),
				}
			>
				{ strconv.Itoa(unread) }
			</span>
		}
	</div>
}

// customThemePreviewCard is a mail list card, as MailListCardItem draws it
// with the default layout.
templ customThemePreviewCard(email models.Email, selected bool) {
	<div class="mail-list-item" data-is-read={ fmt.Sprintf("%t", email.IsRead) }>
		<a
			class={
				"mail-list-card px-3.5 py-2.5 rounded-lg cursor-pointer transition-all duration-200 group",
				templ.KV("envelope-active", selected),
				templ.KV("envelope", !selected),
			}
		>
			<div class="mail-list-card-zone mail-list-card-zone-rail-top" data-mail-card-zone="railTop">
				<div data-mail-card-field="avatar">
					@ContactAvatar(email.From, "size-6 rounded-full text-[10px] font-semibold shadow-[0_1px_3px_rgba(0,0,0,0.15)]", contactAvatarListFallback(email.IsRead))
				</div>
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-header" data-mail-card-zone="header">
				<span class={ "text-[15px] truncate", templ.KV("font-bold text-primary", !email.IsRead), templ.KV("text-black dark:text-foreground", email.IsRead) } data-mail-card-field="from">{ email.From.Name }</span>
				<span class={ "text-[13px] tabular-nums", templ.KV("text-primary font-semibold", !email.IsRead), templ.KV("text-black dark:text-foreground", email.IsRead) } data-mail-card-field="date">{ email.Date }</span>
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-meta" data-mail-card-zone="meta">
				if email.HasAttachment {
					<span data-mail-card-field="attachment" class="inline-flex items-center gap-0.5 text-xs text-muted-foreground">
						@icon.Paperclip(icon.Props{Class: "size-3"})
						<span class="mail-list-card-attachment-count tabular-nums">{ strconv.Itoa(email.AttachmentCount) }</span>
					</span>
				}
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-body" data-mail-card-zone="body">
				<p data-mail-card-field="to" class="text-xs text-black dark:text-foreground truncate leading-snug">
					<span class="font-medium text-muted-foreground">{ i18n.T(ctx, "mail.column.to") }</span>
					{ email.To[0].Name }
				</p>
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-body-bottom" data-mail-card-zone="bodyBottom">
				<p class={ "text-sm truncate", templ.KV("font-semibold text-primary", !email.IsRead), templ.KV("text-black dark:text-foreground", email.IsRead) } data-mail-card-field="subject">{ email.Subject }</p>
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-footer" data-mail-card-zone="footer">
				<p class="min-w-0 flex-1 text-[13px] text-black dark:text-foreground truncate leading-normal" data-mail-card-field="preview">{ email.Preview }</p>
				if len(email.Labels) > 0 {
					<span class="mail-list-card-labels" data-mail-card-field="labels">
						for _, label := range email.Labels {
							<span class={ "text-[11px] px-1.5 py-0.5 rounded font-medium shrink-0 shadow-[0_1px_2px_rgba(0,0,0,0.08)]", label.Color }>{ label.Name }</span>
						}
					</span>
				}
			</div>
			<div class="mail-list-card-zone mail-list-card-zone-corner" data-mail-card-zone="corner">
				if email.IsStarred {
					<span data-mail-card-field="starred">
						@icon.Star(icon.Props{Class: "size-3.5 text-amber-500 fill-amber-500 shrink-0 drop-shadow-[0_1px_1px_rgba(180,120,0,0.4)]"})
					</span>
				}
			</div>
		</a>
	</div>
}

// customThemePreviewReader is the reader, as MailViewContent draws a single
// message, with two of its toolbar buttons and two of its reply buttons.
templ customThemePreviewReader(email models.Email) {
	<div class="mail-view-frame flex flex-col h-full">
		<div class="surface-paper rounded-md flex flex-col h-full overflow-hidden">
			<div class="mail-view-toolbar flex items-center justify-between px-6 py-2.5">
				<div class="flex items-center gap-1">
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "h-8 w-8 text-icon hover:text-ink hover:bg-ink/5"}) {
						@icon.Trash2(icon.Props{Class: "size-4"})
					}
					@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Class: "h-8 w-8 text-icon hover:text-ink hover:bg-ink/5"}) {
						@icon.Archive(icon.Props{Class: "size-4"})
					}
				</div>
				<span class="text-xs text-muted-foreground tabular-nums">{ email.DateFull }</span>
			</div>
			<div class="h-px bg-gradient-to-r from-transparent via-amber-900/10 to-transparent"></div>
			<div class="flex-1 overflow-hidden">
				<div class="mail-view-content mx-auto px-8 py-6">
					<div class="flex items-start gap-4">
						@ContactAvatar(email.From, "size-11 rounded-full text-sm font-bold shrink-0 shadow-[0_2px_6px_rgba(0,0,0,0.2)]", "bg-gradient-to-b from-amber-700/70 to-amber-900/70 text-amber-100")
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2 flex-wrap">
								<span class="font-semibold text-ink">{ email.From.Name }</span>
								<span class="text-xs text-muted-foreground">&lt;{ email.From.Email }&gt;</span>
							</div>
							<div class="text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "mail.thread.to", "name", email.To[0].Name) }</div>
						</div>
					</div>
					<h1 class="mt-5 text-xl font-bold tracking-tight text-ink" style="font-family: var(--font-serif)">{ email.Subject }</h1>
					<div class="h-px bg-gradient-to-r from-transparent via-ink/10 to-transparent my-6"></div>
					<div class="custom-theme-preview-body">
							<p>{ i18n.T(ctx, "settings.theme.preview.body_greeting") }</p>
							<p>{ i18n.T(ctx, "settings.theme.preview.body_1") }</p>
							<p>{ i18n.T(ctx, "settings.theme.preview.body_2_before") }<a href="#">{ i18n.T(ctx, "settings.theme.preview.body_2_link") }</a>{ i18n.T(ctx, "settings.theme.preview.body_2_after") }</p>
							<p>Ana</p>
					</div>
				</div>
			</div>
			<div class="px-6 py-3 border-t border-ink/6">
				<div class="flex items-center gap-2">
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "flex-1 h-9 border-ink/10 text-muted-foreground hover:text-ink hover:border-ink/20"}) {
						<span class="flex items-center gap-2 text-[13px]">
							@icon.Reply(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "shortcuts.reply") }
						</span>
					}
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "flex-1 h-9 border-ink/10 text-muted-foreground hover:text-ink hover:border-ink/20"}) {
						<span class="flex items-center gap-2 text-[13px]">
							@icon.Forward(icon.Props{Class: "size-4"})
							{ i18n.T(ctx, "shortcuts.forward") }
						</span>
					}
				</div>
			</div>
		</div>
	</div>
}

// customThemeBase is the light or dark base, a wide switch like the Color
// Mode one, set apart from the rest since every other choice is made on it.
templ customThemeBase() {
	<fieldset class="space-y-2 border-b border-border pb-5" data-custom-theme-choice="mode">
		<legend class="mb-2 text-sm font-semibold text-foreground">{ i18n.T(ctx, "settings.theme.base") }</legend>
		<div class="relative grid grid-cols-2 gap-0.5 rounded-lg border border-border bg-background p-0.5">
			<div class="pointer-events-none absolute top-0.5 bottom-0.5 left-0.5 w-[calc((100%-6px)/2)] rounded-[calc(var(--radius)-2px)] border border-border bg-card shadow-[var(--shadow-card)] transition-transform duration-[220ms] ease-in-out" data-custom-theme-base-indicator></div>
			@customThemeBaseOption("light", i18n.T(ctx, "settings.appearance.mode.light"))
			@customThemeBaseOption("dark", i18n.T(ctx, "settings.appearance.mode.dark"))
		</div>
		<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.theme.base_hint") }</p>
	</fieldset>
}

templ customThemeBaseOption(value string, label string) {
	<label data-custom-theme-base-option class="relative z-10 inline-flex h-8 cursor-pointer items-center justify-center gap-1.5 rounded-md text-sm font-medium text-muted-foreground transition-colors duration-200 hover:text-foreground has-[:checked]:text-foreground has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ring">
		@radio.Radio(radio.Props{Name: "custom_theme_mode", Value: value, Class: "absolute inset-0 size-full cursor-pointer opacity-0", Attributes: templ.Attributes{"data-custom-theme-field": "mode"}})
		if value == "dark" {
			@icon.Moon(icon.Props{Class: "size-3.5"})
		} else {
			@icon.Sun(icon.Props{Class: "size-3.5"})
		}
		{ label }
	</label>
}

// customThemeSubChoice is a set of radios that refines the choice above it,
// under a small label rather than a heading.
templ customThemeSubChoice(label string, field string, options []customThemeOption) {
	<fieldset class="space-y-2" data-custom-theme-choice={ field }>
		<legend class="mb-1.5 text-xs font-medium text-muted-foreground">{ label }</legend>
		@customThemeRadios(field, options)
	</fieldset>
}

// customThemeChoice is a set of radios; info, if any, explains it in a
// tooltip on an icon next to the legend.
templ customThemeChoice(legend string, info string, field string, options []customThemeOption) {
	<fieldset class="space-y-2" data-custom-theme-choice={ field }>
		<legend class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-foreground">
			{ legend }
			if info != "" {
				@tooltip.Tooltip() {
					@tooltip.Trigger() {
						<button type="button" class="inline-flex text-muted-foreground hover:text-foreground focus-visible:outline-none" aria-label={ i18n.T(ctx, "settings.theme.about_choice", "choice", legend) }>
							@icon.Info(icon.Props{Class: "size-3.5"})
						</button>
					}
					@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionRight, ShowArrow: true, Class: "max-w-64 py-2 text-xs font-normal leading-snug"}) {
						{ info }
					}
				}
			}
		</legend>
		@customThemeRadios(field, options)
	</fieldset>
}

templ customThemeRadios(field string, options []customThemeOption) {
	<div class="flex flex-wrap gap-x-5 gap-y-2">
		for _, option := range options {
			<label class="flex items-center gap-2 text-sm">
				@radio.Radio(radio.Props{Name: "custom_theme_" + field, Value: option.Value, Attributes: templ.Attributes{"data-custom-theme-field": field}})
				{ option.Label }
			</label>
		}
	</div>
}

templ CustomThemeDeleteDialog() {
	@dialog.Dialog(dialog.Props{ID: "custom-theme-delete-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			@dialog.Header() {
				@dialog.Title() {
					<span data-custom-theme-delete-title>{ i18n.T(ctx, "settings.theme.delete_title") }</span>
				}
				@dialog.Description() { { i18n.T(ctx, "settings.theme.delete_description") } }
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						{ i18n.T(ctx, "common.cancel") }
					}
				}
				@button.Button(button.Props{Variant: button.VariantDestructive, Attributes: templ.Attributes{"data-custom-theme-delete-confirm": ""}}) {
					@icon.Trash2(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "settings.theme.delete") }
				}
			}
		}
	}
}

templ ThemeColorsDiscardDialog() {
	@dialog.Dialog(dialog.Props{ID: "theme-colors-discard-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			@dialog.Header() {
				@dialog.Title() { { i18n.T(ctx, "settings.theme.discard_title") } }
				@dialog.Description() {
					<span data-theme-colors-discard-text>{ i18n.T(ctx, "settings.theme.discard_description") }</span>
				}
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						{ i18n.T(ctx, "common.cancel") }
					}
				}
				@button.Button(button.Props{Variant: button.VariantDestructive, Attributes: templ.Attributes{"data-theme-colors-discard-confirm": ""}}) {
					@icon.Trash2(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "settings.theme.discard_confirm") }
				}
			}
		}
	}
}

templ AccountSignaturesSettings(accounts []models.AccountSignatureData) {
	<div class="settings-card bg-card rounded-lg border p-6">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div class="min-w-0">
				<h3 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">{ i18n.T(ctx, "settings.signatures.title") }</h3>
				<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "settings.signatures.description") }</p>
				<div class="mt-3 flex flex-wrap gap-2 text-xs text-muted-foreground">
					<span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-background px-2 py-1">
						@icon.Signature(icon.Props{Class: "size-3"})
						{ i18n.N(ctx, "settings.signatures.total", signatureTotal(accounts)) }
					</span>
				</div>
			</div>
			@dialog.Trigger(dialog.TriggerProps{For: "compose-signatures-dialog"}) {
				<button type="button" class="btn-skeuo inline-flex shrink-0 items-center justify-center gap-1.5 rounded-lg px-4 py-2 text-sm font-semibold">
					@icon.Signature(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "settings.signatures.manage") }
				</button>
			}
		</div>
	</div>
	<div id="compose-signatures-dialog-container">
		@ComposeSignaturesDialog(accounts)
	</div>
}

templ ComposeSignaturesDialog(accounts []models.AccountSignatureData) {
	@dialog.Dialog(dialog.Props{ID: "compose-signatures-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "signatures-dialog mobile-page-dialog sm:max-w-5xl max-h-[calc(100vh-2rem)] overflow-y-auto overflow-x-hidden"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "settings.signatures.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "settings.signatures.dialog_description") }
				}
			}
			@ComposeSignaturesManager(accounts)
		}
	}
}

templ ComposeSignaturesManager(accounts []models.AccountSignatureData) {
	<div id="compose-signatures-manager" class="min-w-0" data-account-signatures-manager data-refresh-url="/api/settings/signatures/manage" data-refresh-target="#compose-signatures-manager" data-refresh-swap="outerHTML">
		@SignatureManagerGrid(accounts)
	</div>
}

templ SignatureManagerGrid(accounts []models.AccountSignatureData) {
	if len(accounts) == 0 {
		<div class="rounded-lg border border-dashed border-border p-6 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "settings.signatures.no_accounts") }</div>
	} else {
		{{ first := accounts[0] }}
		<div class="grid min-w-0 gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
			<div class="min-w-0 space-y-4">
				@SignatureLibrary(first)
			</div>
			<div class="min-w-0 rounded-lg border border-border bg-background/60 p-4 space-y-4">
				<div class="space-y-2">
					<label class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.signatures.account") }</label>
					@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
						@selectbox.Trigger(selectbox.TriggerProps{Name: "signature_account_id", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-signature-account-select": ""}}) {
							<span class="flex min-w-0 flex-1 items-center gap-2">
								<span class="account-color-marker size-3.5 shrink-0" style={ accountColorStyle(first.Account.Color) } data-signature-account-marker data-account-marker={ first.Account.ID }></span>
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.signatures.choose_account"), Class: "min-w-0 text-left"}) {
									{ first.Account.Name } &lt;{ first.Account.Email }&gt;
								}
							</span>
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							for _, data := range accounts {
								@selectbox.Item(selectbox.ItemProps{Value: data.Account.ID, Selected: data.Account.ID == first.Account.ID}) {
									<span class="inline-flex min-w-0 items-center gap-2">
										<span class="account-color-marker size-3.5 shrink-0" style={ accountColorStyle(data.Account.Color) } data-signature-account-marker-source data-account-marker={ data.Account.ID }></span>
										<span class="truncate">{ data.Account.Name } &lt;{ data.Account.Email }&gt;</span>
									</span>
								}
							}
						}
					}
				</div>
				<div class="grid" data-signature-account-panels>
					for _, data := range accounts {
						<form class={ "col-start-1 row-start-1 space-y-4", templ.KV("invisible pointer-events-none", data.Account.ID != first.Account.ID) } data-account-signature-settings data-account-id={ data.Account.ID } aria-hidden={ strconv.FormatBool(data.Account.ID != first.Account.ID) }>
							@AccountSignatureAssignmentRow("new", i18n.T(ctx, "settings.signatures.new"), data.Settings.NewEnabled, data.Settings.NewSignatureID, "", data.Signatures)
							@AccountSignatureAssignmentRow("reply", i18n.T(ctx, "settings.signatures.replies"), data.Settings.ReplyEnabled, data.Settings.ReplySignatureID, data.Settings.ReplyPlacement, data.Signatures)
							@AccountSignatureAssignmentRow("forward", i18n.T(ctx, "settings.signatures.forwards"), data.Settings.ForwardEnabled, data.Settings.ForwardSignatureID, data.Settings.ForwardPlacement, data.Signatures)
							<div class="flex items-center justify-between gap-3 pt-1">
								<span class="text-xs text-muted-foreground" data-signature-settings-status></span>
								<button type="submit" class="btn-skeuo inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold">
									@icon.Check(icon.Props{Class: "size-3.5"})
									{ i18n.T(ctx, "common.save") }
								</button>
							</div>
						</form>
					}
				</div>
			</div>
		</div>
	}
}

templ SignatureLibrary(data models.AccountSignatureData) {
	<div class="min-w-0 rounded-lg border border-border bg-background/60 p-4 space-y-3">
		<div class="flex items-center justify-between gap-3">
			<div>
				<h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.signatures.library") }</h4>
				<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.signatures.library_description") }</p>
			</div>
		</div>
		<div class="flex items-end gap-2">
			<div class="min-w-0 flex-1 space-y-1.5">
				<label class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.signatures.saved") }</label>
				@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
					@selectbox.Trigger(selectbox.TriggerProps{Name: "signature_picker_id", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-signature-select": ""}}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.signatures.select")})
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
						if len(data.Signatures) == 0 {
							@selectbox.Item(selectbox.ItemProps{Value: "", Selected: true, Disabled: true}) { { i18n.T(ctx, "settings.signatures.empty") } }
						} else {
							@selectbox.Item(selectbox.ItemProps{Value: "", Selected: true}) { { i18n.T(ctx, "settings.signatures.select") } }
							for _, sig := range data.Signatures {
								@selectbox.Item(selectbox.ItemProps{Value: sig.ID, Attributes: templ.Attributes{"data-signature-option": "", "data-signature-name": sig.Name, "data-signature-html": sig.HTMLBody}}) { { sig.Name } }
							}
						}
					}
				}
			</div>
			<button type="button" class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border px-2.5 text-xs text-muted-foreground hover:bg-accent hover:text-foreground" data-signature-new>
				@icon.Plus(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "settings.signatures.new_button") }
			</button>
		</div>
		<form data-signature-form class="space-y-3">
			<input type="hidden" name="id" value="" data-signature-id/>
			<div>
				<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.theme.name") }</label>
				@input.Input(input.Props{Name: "name", Type: input.TypeText, Placeholder: i18n.T(ctx, "settings.signatures.name_placeholder"), Attributes: templ.Attributes{"data-signature-name": ""}})
			</div>
			<div>
				<div class="mb-1.5 flex items-center justify-between gap-3">
					<label class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.signatures.signature") }</label>
					<div class="inline-flex shrink-0 rounded-[var(--radius)] border border-border bg-background p-0.5 text-[11px]" data-signature-editor-mode>
						<button type="button" class="rounded-[calc(var(--radius)-2px)] px-2 py-0.5 font-medium text-foreground bg-card shadow-sm" data-signature-mode-button="visual">{ i18n.T(ctx, "settings.signatures.rendered") }</button>
						<button type="button" class="rounded-[calc(var(--radius)-2px)] px-2 py-0.5 font-medium text-muted-foreground hover:text-foreground" data-signature-mode-button="source">HTML</button>
					</div>
				</div>
				<textarea name="html_body" class="hidden" data-signature-html></textarea>
				<div class="min-h-28 max-w-full overflow-x-auto rounded-md border border-border bg-card px-3 py-2 text-sm leading-6 outline-none focus:ring-2 focus:ring-ring" contenteditable="true" role="textbox" data-signature-editor data-placeholder={ i18n.T(ctx, "settings.signatures.editor_placeholder") } data-on-input='["syncSignatureEditor","$this"]'></div>
				<textarea class="hidden min-h-28 w-full resize-y rounded-md border border-border bg-card px-3 py-2 font-mono text-xs leading-5 text-foreground outline-none focus:ring-2 focus:ring-ring" spellcheck="false" placeholder={ i18n.T(ctx, "settings.signatures.source_placeholder") } data-signature-source></textarea>
				<p class="text-[11px] text-muted-foreground mt-1">{ i18n.T(ctx, "settings.signatures.mode_hint") }</p>
			</div>
			<div class="flex items-center justify-between gap-3">
				<span class="text-xs text-muted-foreground" data-signature-save-status></span>
				<div class="flex items-center gap-2">
					<button type="button" class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs text-muted-foreground hover:border-destructive/30 hover:text-destructive" data-signature-delete-current>{ i18n.T(ctx, "settings.account.delete") }</button>
					<button type="submit" class="btn-skeuo inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold">
						@icon.Save(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "settings.signatures.save") }
					</button>
				</div>
			</div>
		</form>
	</div>
}

templ AccountSignaturesDialog(data models.AccountSignatureData) {
	@dialog.Dialog(dialog.Props{ID: "account-signatures-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "signatures-dialog mobile-page-dialog sm:max-w-3xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "settings.signatures.account_title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "settings.signatures.account_description", "account", data.Account.Email) }
				}
			}
			<div class="grid min-w-0 gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]" data-account-signatures-manager data-account-id={ data.Account.ID }>
				<div class="min-w-0 space-y-4">
					<div class="min-w-0 rounded-lg border border-border bg-background/60 p-4 space-y-3">
						<div class="flex items-center justify-between gap-3">
							<div>
								<h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.signatures.library") }</h3>
								<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.signatures.library_description_any") }</p>
							</div>
						</div>
						<div class="flex items-end gap-2">
							<div class="min-w-0 flex-1 space-y-1.5">
								<label class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.signatures.saved") }</label>
								@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
									@selectbox.Trigger(selectbox.TriggerProps{Name: "signature_picker_id", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-signature-select": ""}}) {
										@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.signatures.select")})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
										if len(data.Signatures) == 0 {
											@selectbox.Item(selectbox.ItemProps{Value: "", Selected: true, Disabled: true}) { { i18n.T(ctx, "settings.signatures.empty") } }
										} else {
											@selectbox.Item(selectbox.ItemProps{Value: "", Selected: true}) { { i18n.T(ctx, "settings.signatures.select") } }
											for _, sig := range data.Signatures {
												@selectbox.Item(selectbox.ItemProps{Value: sig.ID, Attributes: templ.Attributes{"data-signature-option": "", "data-signature-name": sig.Name, "data-signature-html": sig.HTMLBody}}) { { sig.Name } }
											}
										}
									}
								}
							</div>
							<button type="button" class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-border px-2.5 text-xs text-muted-foreground hover:bg-accent hover:text-foreground" data-signature-new>
								@icon.Plus(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "settings.signatures.new_button") }
							</button>
						</div>
						<form data-signature-form class="space-y-3">
							<input type="hidden" name="id" value="" data-signature-id/>
							<div>
								<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.theme.name") }</label>
								@input.Input(input.Props{Name: "name", Type: input.TypeText, Placeholder: i18n.T(ctx, "settings.signatures.name_placeholder"), Attributes: templ.Attributes{"data-signature-name": ""}})
							</div>
							<div>
								<div class="mb-1.5 flex items-center justify-between gap-3">
									<label class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.signatures.signature") }</label>
									<div class="inline-flex shrink-0 rounded-[var(--radius)] border border-border bg-background p-0.5 text-[11px]" data-signature-editor-mode>
										<button type="button" class="rounded-[calc(var(--radius)-2px)] px-2 py-0.5 font-medium text-foreground bg-card shadow-sm" data-signature-mode-button="visual">{ i18n.T(ctx, "settings.signatures.rendered") }</button>
										<button type="button" class="rounded-[calc(var(--radius)-2px)] px-2 py-0.5 font-medium text-muted-foreground hover:text-foreground" data-signature-mode-button="source">HTML</button>
									</div>
								</div>
								<textarea name="html_body" class="hidden" data-signature-html></textarea>
								<div class="min-h-28 max-w-full overflow-x-auto rounded-md border border-border bg-card px-3 py-2 text-sm leading-6 outline-none focus:ring-2 focus:ring-ring" contenteditable="true" role="textbox" data-signature-editor data-placeholder={ i18n.T(ctx, "settings.signatures.editor_placeholder") } data-on-input='["syncSignatureEditor","$this"]'></div>
								<textarea class="hidden min-h-28 w-full resize-y rounded-md border border-border bg-card px-3 py-2 font-mono text-xs leading-5 text-foreground outline-none focus:ring-2 focus:ring-ring" spellcheck="false" placeholder={ i18n.T(ctx, "settings.signatures.source_placeholder") } data-signature-source></textarea>
								<p class="text-[11px] text-muted-foreground mt-1">{ i18n.T(ctx, "settings.signatures.mode_hint") }</p>
							</div>
							<div class="flex items-center justify-between gap-3">
								<span class="text-xs text-muted-foreground" data-signature-save-status></span>
								<div class="flex items-center gap-2">
									<button type="button" class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs text-muted-foreground hover:border-destructive/30 hover:text-destructive" data-signature-delete-current>{ i18n.T(ctx, "settings.account.delete") }</button>
									<button type="submit" class="btn-skeuo inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold">
										@icon.Save(icon.Props{Class: "size-3.5"})
										{ i18n.T(ctx, "settings.signatures.save") }
									</button>
								</div>
							</div>
						</form>
					</div>
				</div>

				<form class="rounded-lg border border-border bg-background/60 p-4 space-y-4" data-account-signature-settings>
					<div>
						<h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.signatures.use_title") }</h3>
						<p class="text-xs text-muted-foreground mt-1">{ i18n.T(ctx, "settings.signatures.use_description") }</p>
					</div>
					@AccountSignatureAssignmentRow("new", i18n.T(ctx, "settings.signatures.new"), data.Settings.NewEnabled, data.Settings.NewSignatureID, "", data.Signatures)
					@AccountSignatureAssignmentRow("reply", i18n.T(ctx, "settings.signatures.replies"), data.Settings.ReplyEnabled, data.Settings.ReplySignatureID, data.Settings.ReplyPlacement, data.Signatures)
					@AccountSignatureAssignmentRow("forward", i18n.T(ctx, "settings.signatures.forwards"), data.Settings.ForwardEnabled, data.Settings.ForwardSignatureID, data.Settings.ForwardPlacement, data.Signatures)
					<div class="flex items-center justify-between gap-3 pt-2">
						<span class="text-xs text-muted-foreground" data-signature-settings-status></span>
						<button type="submit" class="btn-skeuo inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold">
							@icon.Check(icon.Props{Class: "size-3.5"})
							{ i18n.T(ctx, "settings.signatures.save_assignments") }
						</button>
					</div>
				</form>
			</div>
		}
	}
}

templ AccountSignatureAssignmentRow(kind string, label string, enabled bool, selectedID string, placement string, signatures []models.Signature) {
	<div class="rounded-md border border-border/70 bg-card/60 p-3 space-y-2">
		<label class="flex items-center gap-2 text-sm font-medium text-foreground">
			@checkbox.Checkbox(checkbox.Props{Name: kind + "_enabled", Value: "true", Checked: enabled})
			{ label }
		</label>
		@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
			@selectbox.Trigger(selectbox.TriggerProps{Name: kind + "_signature_id", Class: "bg-background"}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.signatures.none")}) {
					{ signatureLabel(ctx, signatures, selectedID) }
				}
			}
			@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
				@selectbox.Item(selectbox.ItemProps{Value: "", Selected: selectedID == ""}) { { i18n.T(ctx, "settings.signatures.none") } }
				for _, sig := range signatures {
					@selectbox.Item(selectbox.ItemProps{Value: sig.ID, Selected: selectedID == sig.ID}) { { sig.Name } }
				}
			}
		}
		if kind != "new" {
			<div class="grid gap-1.5">
				<label class="text-[11px] font-medium text-muted-foreground">{ i18n.T(ctx, "settings.signatures.place") }</label>
				@selectbox.SelectBox(selectbox.Props{Class: "settings-select"}) {
					@selectbox.Trigger(selectbox.TriggerProps{Name: kind + "_placement", Class: "bg-background", DisableClear: true}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "settings.signatures.before")}) {
							if placement == "after" {
								{ i18n.T(ctx, "settings.signatures.after") }
							} else {
								{ i18n.T(ctx, "settings.signatures.before") }
							}
						}
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
						@selectbox.Item(selectbox.ItemProps{Value: "before", Selected: placement != "after"}) { { i18n.T(ctx, "settings.signatures.before") } }
						@selectbox.Item(selectbox.ItemProps{Value: "after", Selected: placement == "after"}) { { i18n.T(ctx, "settings.signatures.after") } }
					}
				}
			</div>
		}
	</div>
}

templ ChooseAccountTypeDialog() {
	@dialog.Dialog(dialog.Props{ID: "choose-account-type-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "settings.add_account.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "settings.add_account.choose") }
				}
			}
		<div class="space-y-3 px-1 pt-2 pb-4">
				<button type="button" data-on-click='["openAddAccountWizard",""]' class="w-full group flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/50 hover:bg-accent/50 transition-all duration-200 text-left">
					<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent text-muted-foreground group-hover:text-foreground transition-colors">
						@AccountProviderIcon("imap", "size-5")
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-sm font-medium text-foreground">IMAP / SMTP</div>
						<div class="text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "settings.add_account.imap_description") }</div>
					</div>
					<svg class="size-4 text-muted-foreground group-hover:text-foreground transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
				</button>
				<button type="button" data-on-click='["goferSwitchDialog","choose-account-type-dialog","gmail-account-dialog"]' class="w-full group flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/50 hover:bg-accent/50 transition-all duration-200 text-left">
					<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent text-muted-foreground group-hover:text-foreground transition-colors">
						@AccountProviderIcon("gmail", "size-5")
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-sm font-medium text-foreground">Gmail</div>
						<div class="text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "settings.add_account.gmail_description") }</div>
					</div>
					<svg class="size-4 text-muted-foreground group-hover:text-foreground transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
				</button>
				<button type="button" data-on-click='["goferSwitchDialog","choose-account-type-dialog","outlook-account-dialog"]' class="w-full group flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/50 hover:bg-accent/50 transition-all duration-200 text-left">
					<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent text-muted-foreground group-hover:text-foreground transition-colors">
						@AccountProviderIcon("outlook", "size-5")
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-sm font-medium text-foreground">Outlook</div>
						<div class="text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "settings.add_account.outlook_description") }</div>
					</div>
					<svg class="size-4 text-muted-foreground group-hover:text-foreground transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
				</button>
				<button type="button" data-on-click='["openAddAccountWizard","icloud"]' class="w-full group flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/50 hover:bg-accent/50 transition-all duration-200 text-left">
					<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent text-muted-foreground group-hover:text-foreground transition-colors">
						@AccountProviderIcon(providers.MailServiceICloud, "size-5")
					</div>
					<div class="flex-1 min-w-0">
						<div class="text-sm font-medium text-foreground">iCloud</div>
						<div class="text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "settings.add_account.icloud_description") }</div>
					</div>
					<svg class="size-4 text-muted-foreground group-hover:text-foreground transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
				</button>
				if providers.JMAPEnabled() {
					<button type="button" data-on-click='["openAddAccountWizard","jmap"]' class="w-full group flex items-center gap-4 p-4 rounded-lg border border-border hover:border-primary/50 hover:bg-accent/50 transition-all duration-200 text-left">
						<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-accent text-muted-foreground group-hover:text-foreground transition-colors">
							@AccountProviderIcon(providers.ProviderJMAP, "size-5")
						</div>
						<div class="flex-1 min-w-0">
							<div class="text-sm font-medium text-foreground">JMAP <span class="ml-1 rounded border border-border px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.add_account.experimental") }</span></div>
							<div class="text-xs text-muted-foreground mt-0.5">{ i18n.T(ctx, "settings.add_account.jmap_description") }</div>
						</div>
						<svg class="size-4 text-muted-foreground group-hover:text-foreground transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
					</button>
				}
			</div>
		}
	}
}

templ GmailAccountDialog() {
	@dialog.Dialog(dialog.Props{ID: "gmail-account-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-sm"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "settings.add_account.gmail_title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "settings.add_account.gmail_authorize") }
				}
			}
			<form id="gmail-form" method="POST" action="/api/accounts/oauth2/authorize" class="px-1 pt-2 pb-4 space-y-4">
				<input type="hidden" name="flow_action" value="add"/>
				<div>
					<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.add_account.email") }</label>
					@input.Input(input.Props{
						Name:        "email_address",
						Type:        input.TypeEmail,
						Placeholder: "you@gmail.com",
						Required:    true,
					})
				</div>
				<div>
					<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.add_account.display_name") }</label>
					@input.Input(input.Props{
						Name:        "display_name",
						Type:        input.TypeText,
						Placeholder: i18n.T(ctx, "settings.add_account.your_name"),
					})
				</div>
				@AccountProxyChoiceLoader("")
				<input type="hidden" name="imap_host" value="imap.gmail.com"/>
				<input type="hidden" name="imap_port" value="993"/>
				<input type="hidden" name="imap_tls_mode" value="tls"/>
				<input type="hidden" name="smtp_host" value="smtp.gmail.com"/>
				<input type="hidden" name="smtp_port" value="465"/>
				<input type="hidden" name="smtp_tls_mode" value="tls"/>
				<input type="hidden" name="auth_method" value="oauth2"/>
				<input type="hidden" name="provider" value="gmail"/>
				<input type="hidden" name="username" value=""/>
				<input type="hidden" name="password" value="_oauth2_"/>
				<hr class="border-border"/>
				<div class="rounded-lg bg-accent/50 border border-border p-3">
					<div class="flex items-start gap-2.5">
						<svg class="size-4 text-muted-foreground mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
						<p class="text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.add_account.gmail_note") }</p>
					</div>
				</div>
				<button type="submit" class="w-full inline-flex items-center justify-center gap-2.5 text-sm font-medium px-4 py-2.5 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
					@AccountProviderIcon("gmail", "size-4 shrink-0")
					{ i18n.T(ctx, "settings.add_account.gmail_continue") }
				</button>
			</form>
		}
	}
}

templ OutlookAccountDialog() {
	@dialog.Dialog(dialog.Props{ID: "outlook-account-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-sm"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "settings.add_account.outlook_title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "settings.add_account.outlook_authorize") }
				}
			}
			<form id="outlook-form" method="POST" action="/api/accounts/oauth2/authorize" class="px-1 pt-2 pb-4 space-y-4">
				<input type="hidden" name="flow_action" value="add"/>
				<div>
					<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.add_account.email") }</label>
					@input.Input(input.Props{
						Name:        "email_address",
						Type:        input.TypeEmail,
						Placeholder: "you@outlook.com",
						Required:    true,
					})
				</div>
				<div>
					<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.add_account.display_name") }</label>
					@input.Input(input.Props{
						Name:        "display_name",
						Type:        input.TypeText,
						Placeholder: i18n.T(ctx, "settings.add_account.your_name"),
					})
				</div>
				@AccountProxyChoiceLoader("")
				<input type="hidden" name="provider" value="outlook"/>
				<hr class="border-border"/>
				<div class="rounded-lg bg-accent/50 border border-border p-3">
					<div class="flex items-start gap-2.5">
						<svg class="size-4 text-muted-foreground mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
						<p class="text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.add_account.outlook_note") }</p>
					</div>
				</div>
				<button type="submit" class="w-full inline-flex items-center justify-center gap-2.5 text-sm font-medium px-4 py-2.5 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
					@AccountProviderIcon("outlook", "size-4 shrink-0")
					{ i18n.T(ctx, "settings.add_account.outlook_continue") }
				</button>
			</form>
		}
	}
}

templ AddAccountDialog() {
	@dialog.Dialog(dialog.Props{ID: "add-account-dialog"}) {
		@dialog.Trigger() {
			<span></span>
		}
		@dialog.Content(dialog.ContentProps{Class: "account-wizard-dialog mobile-page-dialog sm:max-w-4xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					<span data-add-account-only>
						<span data-add-mode="generic">{ i18n.T(ctx, "settings.add_account.title") }</span>
						<span data-add-mode="icloud">{ i18n.T(ctx, "settings.wizard.add_icloud") }</span>
						<span data-add-mode="jmap">{ i18n.T(ctx, "settings.wizard.add_jmap") }</span>
					</span>
					<span data-add-mail-only>{ i18n.T(ctx, "settings.wizard.add_email") }</span>
				}
				@dialog.Description() {
					{ i18n.T(ctx, "settings.wizard.description") }
				}
			}
			@selectbox.Script()
			<style>
				.account-wizard-section { border:1px solid var(--border); border-radius:var(--radius); background:color-mix(in srgb, var(--background) 55%, transparent); padding:.4rem; transition:background .16s ease,border-color .16s ease,box-shadow .16s ease; }
				.account-wizard-section[data-active="true"] { border-color:color-mix(in srgb, var(--primary) 38%, var(--border)); background:var(--card); box-shadow:0 1px 0 var(--border); }
				.account-wizard-section[data-disabled="true"] { opacity:.55; }
				.account-wizard-section + .account-wizard-section { margin-top:.5rem; }
				.account-wizard-section-heading { display:flex; width:100%; align-items:flex-start; gap:.75rem; border-radius:calc(var(--radius) * .75); border:1px solid transparent; padding:.65rem; text-align:left; color:var(--foreground); transition:background .16s ease,border-color .16s ease,color .16s ease,opacity .16s ease; }
				.account-wizard-section-title { flex:1; min-width:0; display:flex; align-items:flex-start; gap:.75rem; border-radius:calc(var(--radius) * .75); text-align:left; }
				.account-wizard-section-title:disabled { cursor:not-allowed; }
				.account-wizard-section-heading:hover:not(:disabled) { background:var(--accent); color:var(--accent-foreground); }
				.account-wizard-section-heading[data-active="true"] { border-color:var(--border); background:var(--background); }
				.account-wizard-section-heading:disabled { cursor:not-allowed; opacity:.5; }
				.account-wizard-step { display:flex; width:100%; align-items:flex-start; gap:.65rem; border-radius:calc(var(--radius) * .75); border:1px solid transparent; padding:.55rem .6rem; text-align:left; color:var(--muted-foreground); transition:background .16s ease,border-color .16s ease,color .16s ease,opacity .16s ease; }
				.account-wizard-step:hover:not(:disabled) { background:var(--accent); color:var(--accent-foreground); }
				.account-wizard-step[data-active="true"] { border-color:var(--border); background:var(--background); color:var(--foreground); }
				.account-wizard-step:disabled { cursor:not-allowed; opacity:.5; }
				.account-wizard-substeps { display:grid; gap:.25rem; margin:.15rem 0 .1rem 1.15rem; border-left:1px solid var(--border); padding-left:.55rem; }
				.account-wizard-index { display:flex; height:1.5rem; min-width:1.5rem; flex-shrink:0; align-items:center; justify-content:center; border-radius:calc(var(--radius) * .75); background:var(--muted); padding:0 .35rem; font-size:.7rem; font-weight:800; color:var(--muted-foreground); }
				.account-wizard-section[data-active="true"] > .account-wizard-section-heading .account-wizard-index,
				.account-wizard-section-heading[data-active="true"] .account-wizard-index,
				.account-wizard-step[data-active="true"] .account-wizard-index { background:var(--primary); color:var(--primary-foreground); }
				.account-wizard-viewport { min-height:0; height:100%; overflow:hidden; }
				.account-wizard-viewport > .flex { height:100%; align-items:stretch; }
				.account-wizard-viewport [data-wizard-step] { min-height:0; height:100%; }
				.account-wizard-dialog [data-tui-dialog-panel] { height:fit-content; max-height:calc(100dvh - 2rem); grid-template-rows:auto minmax(0,1fr) auto; }
				.account-wizard-shell { min-height:0; height:auto; grid-template-rows:auto minmax(0,1fr); }
				@media (min-width: 768px) { .account-wizard-shell { grid-template-rows:minmax(0,1fr); } }
				.account-wizard-shell > aside { min-height:0; height:auto; overflow-y:auto; }
				.account-wizard-panel { display:flex; height:auto; min-height:0; flex-direction:column; overflow:hidden; padding-right:.25rem; }
				.account-wizard-scroll { flex:1 1 auto; min-height:0; overflow-y:auto; padding:6px calc(.25rem + 6px) calc(1rem + 6px) 6px; }
				.account-wizard-sticky-header { position:sticky; top:-6px; z-index:20; margin:-6px -6px 1rem; padding:6px 6px .75rem; background:var(--card); box-shadow:0 1px 0 color-mix(in oklab, var(--border) 70%, transparent); }
				.account-wizard-controls { flex-shrink:0; margin-top:.5rem; border-top:1px solid var(--border); background:var(--card); padding-top:.75rem; padding-bottom:2px; }
				.account-wizard-panel .account-wizard-controls { display:none; }
				.account-wizard-card-footer { min-height:3.25rem; background:var(--card); padding-top:.75rem; padding-bottom:2px; transition:opacity .12s ease; }
				.account-wizard-card-footer[data-switching="true"] { opacity:0; pointer-events:none; }
				.account-wizard-card-footer > [data-wizard-footer-step] { display:none !important; }
				.account-wizard-card-footer > [data-wizard-footer-step][data-active="true"] { display:flex !important; }
				#add-account-dialog:not([data-mail-service]) [data-add-mode]:not([data-add-mode~="generic"]),
				#add-account-dialog[data-mail-service="icloud"] [data-add-mode]:not([data-add-mode~="icloud"]),
				#add-account-dialog[data-mail-service="jmap"] [data-add-mode]:not([data-add-mode~="jmap"]) { display:none !important; }
				#add-account-dialog:not([data-add-mail]) [data-add-mail-only],
				#add-account-dialog[data-add-mail] [data-add-account-only] { display:none !important; }
			</style>
			<div class="account-wizard-shell grid gap-4 pt-2 md:grid-cols-[16rem_minmax(0,1fr)]">
		@AccountWizardAddSidebar()
				<div id="wizard-viewport" class="account-wizard-viewport">
					<div id="wizard-track" class="flex items-start transition-transform duration-300 ease-in-out" style="width: 600%">
						<form id="account-form" hx-post="/api/accounts" hx-target="#add-contacts-content" hx-swap="innerHTML" class="contents">
						<input type="hidden" name="mail_service" value=""/>
						<div class="w-1/6 shrink-0 px-1" data-wizard-step="0">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.User(icon.Props{Class: "size-4 text-muted-foreground"})
								{ i18n.T(ctx, "settings.wizard.account_details") }
							</h4>
							<div class="space-y-4">
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.add_account.email") }</label>
									@input.Input(input.Props{
										Name:        "email_address",
										Type:        input.TypeEmail,
										Placeholder: "you@example.com",
										Required:    true,
									})
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.add_account.display_name") }</label>
									@input.Input(input.Props{
										Name:        "display_name",
										Type:        input.TypeText,
										Placeholder: i18n.T(ctx, "settings.add_account.your_name"),
									})
								</div>
								<div data-add-mode="generic" class="rounded-lg border border-border bg-background/45 p-3">
									<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
										<div class="min-w-0">
											<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "settings.wizard.automatic") }</div>
											<p class="mt-0.5 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.wizard.automatic_description") }</p>
										</div>
										<button type="button" data-on-click='["discoverMailSettings","$this"]' class="inline-flex shrink-0 items-center justify-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground transition-colors hover:bg-accent disabled:pointer-events-none disabled:opacity-60">
											@icon.Radar(icon.Props{Class: "size-3.5"})
											<span data-mail-discovery-label>{ i18n.T(ctx, "settings.wizard.discover") }</span>
										</button>
									</div>
									<div id="mail-discovery-status" class="mt-3"></div>
								</div>
							</div>
							</div>
							<div class="account-wizard-controls flex justify-end">
								<button type="button" data-on-click='["wizardGo",1]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									{ i18n.T(ctx, "common.next") }
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="1">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							<div data-add-mode="icloud">
								<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
									@icon.MailCheck(icon.Props{Class: "size-4 text-muted-foreground"})
									{ i18n.T(ctx, "settings.wizard.mail_sync") }
									<span class="text-xs font-normal text-muted-foreground">(iCloud Mail)</span>
								</h4>
								<div class="mb-4">
									@ICloudAppPasswordNotice(i18n.T(ctx, "settings.wizard.icloud_notice"))
								</div>
							</div>
							<div data-add-mode="jmap">
								<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
									@icon.Server(icon.Props{Class: "size-4 text-muted-foreground"})
									{ i18n.T(ctx, "settings.wizard.server") }
									<span class="text-xs font-normal text-muted-foreground">(JMAP)</span>
								</h4>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.server_address") } <span class="font-normal">{ i18n.T(ctx, "settings.wizard.optional") }</span></label>
									@input.Input(input.Props{
										Name:        "jmap_server",
										Type:        input.TypeText,
										Placeholder: "mail.example.com",
									})
									<p class="mt-1.5 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.wizard.server_hint") }</p>
								</div>
								<input type="hidden" name="jmap_session_url" value=""/>
								<hr class="my-4 border-border"/>
								<h4 class="text-sm font-semibold text-foreground flex items-center gap-2 mb-4">
									@icon.Key(icon.Props{Class: "size-4 text-muted-foreground"})
									{ i18n.T(ctx, "settings.wizard.login") }
								</h4>
							</div>
							<div data-add-mode="generic">
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.Inbox(icon.Props{Class: "size-4 text-muted-foreground"})
								{ i18n.T(ctx, "settings.wizard.incoming_mail") }
								<span class="text-xs font-normal text-muted-foreground">(IMAP)</span>
							</h4>
							<div class="grid grid-cols-2 gap-3">
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.imap_host") }</label>
									@input.Input(input.Props{
										Name:        "imap_host",
										Type:        input.TypeText,
										Placeholder: "imap.example.com",
										Required:    true,
									})
									<div data-server-check="imap" class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.port") }</label>
									@input.Input(input.Props{
										Name:        "imap_port",
										Type:        input.TypeNumber,
										Placeholder: "993",
										Value:       "993",
									})
								</div>
					<div>
						<label class="text-xs font-medium text-muted-foreground mb-1.5 flex items-center gap-1.5">
							<span>{ i18n.T(ctx, "settings.wizard.encryption") }</span>
							@UnencryptedTransportWarning("add-imap-unencrypted-warning", false)
						</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "imap_tls_mode", DisableClear: true, Attributes: templ.Attributes{"data-on-change": onAction("toggleUnencryptedTransportWarning", actionElement)}}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "TLS"}) { TLS }
							}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
										@selectbox.Item(selectbox.ItemProps{Value: "tls", Selected: true}) { TLS }
										@selectbox.Item(selectbox.ItemProps{Value: "starttls"}) { STARTTLS }
										@selectbox.Item(selectbox.ItemProps{Value: "plaintext"}) { { i18n.T(ctx, "settings.wizard.unencrypted") } }
							}
						}
					</div>
							</div>
							<hr class="my-4 border-border"/>
							<h4 class="text-sm font-semibold text-foreground flex items-center gap-2 mb-4">
								@icon.Key(icon.Props{Class: "size-4 text-muted-foreground"})
								{ i18n.T(ctx, "settings.wizard.login") }
							</h4>
							</div>
							<div class="grid grid-cols-2 gap-3">
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block"><span data-add-mode="generic jmap">{ i18n.T(ctx, "settings.wizard.username") }</span><span data-add-mode="icloud">{ i18n.T(ctx, "settings.wizard.apple_email") }</span></label>
									@input.Input(input.Props{
										Name:        "username",
										Type:        input.TypeText,
										Placeholder: "you@example.com",
										Required:    true,
									})
									<p data-add-mode="icloud" class="mt-1.5 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.wizard.icloud_username_hint") }</p>
										<p data-add-mode="jmap" class="mt-1.5 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.wizard.username_hint") }</p>
								</div>
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block"><span data-add-mode="generic">{ i18n.T(ctx, "settings.wizard.password") }</span><span data-add-mode="jmap">{ i18n.T(ctx, "settings.wizard.password_or_token") }</span><span data-add-mode="icloud">{ i18n.T(ctx, "settings.wizard.app_password") }</span></label>
									@input.Input(input.Props{
										Name:        "password",
										Type:        input.TypePassword,
										Placeholder: "••••••••",
										Required:    true,
									})
									<p data-add-mode="jmap" class="mt-1.5 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.wizard.token_hint") }</p>
								</div>
								<div data-add-mode="generic" class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.method") }</label>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "auth_method"}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: "PLAIN"}) { PLAIN }
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
											@selectbox.Item(selectbox.ItemProps{Value: "plain", Selected: true}) { PLAIN }
											@selectbox.Item(selectbox.ItemProps{Value: "oauth2"}) { OAuth2 }
										}
									}
								</div>
							</div>
							</div>
							<div class="account-wizard-controls flex justify-between">
								<button type="button" data-on-click='["wizardGo",0]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "settings.wizard.back") }
								</button>
								<button type="button" data-on-click='["wizardGo",2]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									{ i18n.T(ctx, "common.next") }
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="2">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							<div data-add-mode="generic">
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.Send(icon.Props{Class: "size-4 text-muted-foreground"})
								{ i18n.T(ctx, "settings.wizard.sending_mail") }
								<span class="text-xs font-normal text-muted-foreground">(SMTP)</span>
							</h4>
							<div class="grid grid-cols-2 gap-3">
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.smtp_host") }</label>
									@input.Input(input.Props{
										Name:        "smtp_host",
										Type:        input.TypeText,
										Placeholder: "smtp.example.com",
										Required:    true,
									})
									<div data-server-check="smtp" class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.port") }</label>
									@input.Input(input.Props{
										Name:        "smtp_port",
										Type:        input.TypeNumber,
										Placeholder: "465",
										Value:       "465",
									})
								</div>
					<div>
						<label class="text-xs font-medium text-muted-foreground mb-1.5 flex items-center gap-1.5">
							<span>{ i18n.T(ctx, "settings.wizard.encryption") }</span>
							@UnencryptedTransportWarning("add-smtp-unencrypted-warning", false)
						</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "smtp_tls_mode", DisableClear: true, Attributes: templ.Attributes{"data-on-change": onAction("toggleUnencryptedTransportWarning", actionElement)}}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "TLS"}) { TLS }
							}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
										@selectbox.Item(selectbox.ItemProps{Value: "tls", Selected: true}) { TLS }
										@selectbox.Item(selectbox.ItemProps{Value: "starttls"}) { STARTTLS }
										@selectbox.Item(selectbox.ItemProps{Value: "plaintext"}) { { i18n.T(ctx, "settings.wizard.unencrypted") } }
							}
						}
					</div>
							</div>
							<hr class="my-4 border-border"/>
							<label class="flex items-center gap-2 cursor-pointer mb-4">
								@checkbox.Checkbox(checkbox.Props{
									ID:         "smtp-same-auth",
									Checked:    true,
									Attributes: templ.Attributes{"data-on-change": onAction("toggleSmtpAuth", actionChecked)},
								})
								<span class="text-sm">{ i18n.T(ctx, "settings.wizard.same_login") }</span>
							</label>
							<div id="smtp-auth-fields" class="opacity-50">
								<div class="grid grid-cols-2 gap-3">
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.smtp_username") }</label>
										@input.Input(input.Props{
											Name:        "smtp_username",
											Type:        input.TypeText,
											Placeholder: "you@example.com",
											Disabled:    true,
										})
									</div>
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.smtp_password") }</label>
										@input.Input(input.Props{
											Name:        "smtp_password",
											Type:        input.TypePassword,
											Placeholder: "••••••••",
											Disabled:    true,
										})
									</div>
								</div>
							</div>
							</div>
							</div>
							<div class="account-wizard-controls flex justify-between">
								<button type="button" data-on-click='["wizardGo",1]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "settings.wizard.back") }
								</button>
<button type="button" data-on-click='["wizardGo",3]' data-add-account-submit-button disabled class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
									{ i18n.T(ctx, "common.next") }
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>
						</form>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="3">
							<div class="account-wizard-panel">
								<div class="account-wizard-scroll">
									<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
										@icon.PlugZap(icon.Props{Class: "size-4 text-muted-foreground"})
										{ i18n.T(ctx, "settings.wizard.test_create") }
									</h4>
									<p class="text-xs leading-relaxed text-muted-foreground"><span data-add-mode="generic icloud">{ i18n.T(ctx, "settings.wizard.test_both") }</span><span data-add-mode="jmap">{ i18n.T(ctx, "settings.wizard.test_jmap") }</span> <span data-add-account-only>{ i18n.T(ctx, "settings.wizard.nothing_saved") }</span><span data-add-mail-only>{ i18n.T(ctx, "settings.wizard.nothing_changes") }</span></p>
									<div id="add-account-test-results" data-add-account-test-results aria-live="polite" class="mt-4 space-y-3"></div>
								</div>
							</div>
						</div>
						<div class="w-1/6 shrink-0 px-1" data-wizard-step="4">
							<div class="account-wizard-panel">
								<div id="add-contacts-content" data-on-htmx-after-swap='["syncAddContactStepAfterSwap"]'></div>
							</div>
						</div>
						<div class="w-1/6 shrink-0 px-1" data-wizard-step="5">
							<div class="account-wizard-panel">
								<div class="account-wizard-scroll">
									<div id="add-calendar-content">
										@CalendarSetupNotice()
									</div>
								</div>
							</div>
						</div>
					</div>
					</div>
				</div>
				@AddAccountWizardFooter()
			}
		}
}

templ AccountWizardAddSidebar() {
	<aside class="rounded-lg border border-border bg-muted/25 p-2 md:min-h-[28rem]">
		<div class="mb-2 px-2">
			<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.wizard.services") }</div>
			<p class="mt-0.5 text-[11px] leading-snug text-muted-foreground">{ i18n.T(ctx, "settings.wizard.sections_hint") }</p>
		</div>
		@AccountWizardAddEmailSection()
		@AccountWizardTopStep("wizardGo", 4, "2", i18n.T(ctx, "settings.wizard.contacts"), i18n.T(ctx, "settings.wizard.contacts_description"), true, true, "", "contacts", false, false, templ.Attributes{"data-add-contact-sync-switch": ""})
		@AccountWizardTopStep("wizardGo", 5, "3", i18n.T(ctx, "settings.wizard.calendar"), i18n.T(ctx, "settings.wizard.calendar_description"), true, true, "", "calendar", false, false, nil)
		// Adding mail to an account, the row is that account's own (see
		// startAddMail), so it stays in a container of its own to swap.
		<div id="add-account-proxy-row">
			@AccountProxyChoiceSidebarLoader("", "account-form")
		</div>
	</aside>
}

templ AccountWizardEditSidebar(data models.EditAccountData) {
	<aside class="rounded-lg border border-border bg-muted/25 p-2 md:min-h-[28rem]">
		<div class="mb-2 px-2">
			<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.wizard.services") }</div>
			<p class="mt-0.5 text-[11px] leading-snug text-muted-foreground">{ i18n.T(ctx, "settings.wizard.sections_hint") }</p>
		</div>
		{{ emailEnabled := data.EmailSyncEnabled || data.ReconnectPending }}
		if accountEditUsesProviderAPI(data.Provider) {
			@AccountWizardProviderAPIEmailSection("editWizardGo", data.AccountID, data.Provider, emailEnabled, true)
		} else if editAccountIsICloud(data) {
			@AccountWizardICloudEmailSection("editWizardGo", data.AccountID, emailEnabled, false, true, i18n.T(ctx, "settings.wizard.test_save"))
		} else if editAccountIsJMAP(data) {
			@AccountWizardJMAPEmailSection("editWizardGo", data.AccountID, emailEnabled, true)
		} else {
			@AccountWizardEmailSection("editWizardGo", data.AccountID, emailEnabled, false, true, i18n.T(ctx, "settings.wizard.test_save"))
		}
		@AccountWizardTopStep("editWizardGo", 4, "2", i18n.T(ctx, "settings.wizard.contacts"), i18n.T(ctx, "settings.wizard.contacts_description"), false, true, data.AccountID, "contacts", data.ContactSync.Enabled || data.ReconnectContacts, false, nil)
		@AccountWizardTopStep("editWizardGo", 5, "3", i18n.T(ctx, "settings.wizard.calendar"), i18n.T(ctx, "settings.wizard.calendar_description"), false, true, data.AccountID, "calendar", data.CalendarSync.Enabled || data.ReconnectCalendar, false, nil)
		@AccountProxyChoiceSidebarLoader(data.AccountID, "")
	</aside>
}

// AccountWizardEmailSection lists the mail steps, which end with a step that
// tests the settings and then creates or saves the account.
templ AccountWizardEmailSection(goFn string, accountID string, enabled bool, disabled bool, persist bool, finalStep string) {
	<div class="account-wizard-section" data-wizard-section-steps="0,1,2,3" data-active="true">
		<div class="account-wizard-section-heading">
			<button type="button" data-account-wizard-action={ goFn } data-account-wizard-target-step="0" class="account-wizard-section-title">
				<span class="account-wizard-index">1</span>
				<span class="min-w-0"><span class="block text-sm font-semibold">{ i18n.T(ctx, "settings.wizard.email") }</span><span class="block text-xs text-muted-foreground">{ i18n.T(ctx, "settings.wizard.email_description") }</span></span>
			</button>
			@AccountWizardSectionSwitch(goFn, accountID, "email", enabled, disabled, persist, false, nil)
		</div>
		<div class="account-wizard-substeps">
			@AccountWizardSubStep(goFn, 0, "1.a", i18n.T(ctx, "settings.wizard.account_details"), i18n.T(ctx, "settings.wizard.name_email"), false, true)
			@AccountWizardSubStep(goFn, 1, "1.b", i18n.T(ctx, "settings.wizard.incoming"), i18n.T(ctx, "settings.wizard.imap_settings"), false, false)
			@AccountWizardSubStep(goFn, 2, "1.c", i18n.T(ctx, "settings.wizard.outgoing"), i18n.T(ctx, "settings.wizard.smtp_settings"), false, false)
			@AccountWizardSubStep(goFn, 3, "1.d", finalStep, i18n.T(ctx, "settings.wizard.check_connection"), false, false)
		</div>
	</div>
}

templ AccountWizardProviderAPIEmailSection(goFn string, accountID string, provider string, enabled bool, persist bool) {
	<div class="account-wizard-section" data-wizard-section-steps="0,1,2,3" data-active="true">
		<div class="account-wizard-section-heading">
			<button type="button" data-account-wizard-action={ goFn } data-account-wizard-target-step="0" class="account-wizard-section-title">
				<span class="account-wizard-index">1</span>
				<span class="min-w-0"><span class="block text-sm font-semibold">{ i18n.T(ctx, "settings.wizard.email") }</span><span class="block text-xs text-muted-foreground">{ i18n.T(ctx, "settings.wizard.email_description") }</span></span>
			</button>
			@AccountWizardSectionSwitch(goFn, accountID, "email", enabled, false, persist, false, nil)
		</div>
		<div class="account-wizard-substeps">
			@AccountWizardSubStep(goFn, 0, "1.a", i18n.T(ctx, "settings.wizard.account_details"), i18n.T(ctx, "settings.wizard.name_email"), false, true)
			@AccountWizardSubStep(goFn, 1, "1.b", i18n.T(ctx, "settings.wizard.mail_sync"), providerAPIMailTransportLabel(provider), false, false)
			@AccountWizardSubStep(goFn, 3, "1.c", i18n.T(ctx, "settings.wizard.test_save"), i18n.T(ctx, "settings.wizard.check_connection"), false, false)
		</div>
	</div>
}

// AccountWizardAddEmailSection lists the add wizard's mail steps, whose
// descriptions follow whether it is adding an iCloud account.
templ AccountWizardAddEmailSection() {
	<div class="account-wizard-section" data-wizard-section-steps="0,1,2,3" data-active="true">
		<div class="account-wizard-section-heading">
			<button type="button" data-account-wizard-action="wizardGo" data-account-wizard-target-step="0" class="account-wizard-section-title">
				<span class="account-wizard-index">1</span>
				<span class="min-w-0"><span class="block text-sm font-semibold">{ i18n.T(ctx, "settings.wizard.email") }</span><span class="block text-xs text-muted-foreground">{ i18n.T(ctx, "settings.wizard.email_description") }</span></span>
			</button>
			@AccountWizardSectionSwitch("wizardGo", "", "email", true, true, false, false, nil)
		</div>
		<div class="account-wizard-substeps">
			@AccountWizardAddSubStep(0, "1.a", "1.a", i18n.T(ctx, "settings.wizard.account_details"), i18n.T(ctx, "settings.wizard.name_email"), i18n.T(ctx, "settings.wizard.account_details"), i18n.T(ctx, "settings.wizard.name_email"), i18n.T(ctx, "settings.wizard.account_details"), i18n.T(ctx, "settings.wizard.name_email"), true)
			@AccountWizardAddSubStep(1, "1.b", "1.b", i18n.T(ctx, "settings.wizard.incoming"), i18n.T(ctx, "settings.wizard.imap_settings"), i18n.T(ctx, "settings.wizard.mail_sync"), i18n.T(ctx, "settings.wizard.app_password"), i18n.T(ctx, "settings.wizard.server_login"), "JMAP", false)
			@AccountWizardAddSubStep(2, "1.c", "", i18n.T(ctx, "settings.wizard.outgoing"), i18n.T(ctx, "settings.wizard.smtp_settings"), "", "", "", "", false)
			@AccountWizardAddSubStep(3, "1.d", "1.c", i18n.T(ctx, "settings.wizard.test_create"), i18n.T(ctx, "settings.wizard.check_connection"), i18n.T(ctx, "settings.wizard.test_create"), i18n.T(ctx, "settings.wizard.check_connection"), i18n.T(ctx, "settings.wizard.test_create"), i18n.T(ctx, "settings.wizard.find_server"), false)
		</div>
	</div>
}

// AccountWizardAddSubStep is one of the add wizard's mail steps. One with no
// iCloud index is left out for iCloud and JMAP, which send with their mail
// sync login.
templ AccountWizardAddSubStep(step int, index string, iCloudIndex string, title string, description string, iCloudTitle string, iCloudDescription string, jmapTitle string, jmapDescription string, active bool) {
	<button type="button" data-on-click={ onAction("wizardGo", step) } data-account-wizard-action="wizardGo" data-account-wizard-target-step={ strconv.Itoa(step) } class="account-wizard-step" data-account-wizard-step={ strconv.Itoa(step) } data-active={ strconv.FormatBool(active) }
		if iCloudIndex == "" {
			data-add-mode="generic"
		}
	>
		<span class="account-wizard-index"><span data-add-mode="generic">{ index }</span><span data-add-mode="icloud jmap">{ iCloudIndex }</span></span>
		<span class="min-w-0">
			<span class="block text-xs font-semibold"><span data-add-mode="generic">{ title }</span><span data-add-mode="icloud">{ iCloudTitle }</span><span data-add-mode="jmap">{ jmapTitle }</span></span>
			<span class="block text-[11px] text-muted-foreground"><span data-add-mode="generic">{ description }</span><span data-add-mode="icloud">{ iCloudDescription }</span><span data-add-mode="jmap">{ jmapDescription }</span></span>
		</span>
	</button>
}

// AccountWizardICloudEmailSection lists the mail steps of an iCloud account,
// which has a login but no server settings.
templ AccountWizardICloudEmailSection(goFn string, accountID string, enabled bool, disabled bool, persist bool, finalStep string) {
	<div class="account-wizard-section" data-wizard-section-steps="0,1,2,3" data-active="true">
		<div class="account-wizard-section-heading">
			<button type="button" data-account-wizard-action={ goFn } data-account-wizard-target-step="0" class="account-wizard-section-title">
				<span class="account-wizard-index">1</span>
				<span class="min-w-0"><span class="block text-sm font-semibold">{ i18n.T(ctx, "settings.wizard.email") }</span><span class="block text-xs text-muted-foreground">{ i18n.T(ctx, "settings.wizard.email_description") }</span></span>
			</button>
			@AccountWizardSectionSwitch(goFn, accountID, "email", enabled, disabled, persist, false, nil)
		</div>
		<div class="account-wizard-substeps">
			@AccountWizardSubStep(goFn, 0, "1.a", i18n.T(ctx, "settings.wizard.account_details"), i18n.T(ctx, "settings.wizard.name_email"), false, true)
			@AccountWizardSubStep(goFn, 1, "1.b", i18n.T(ctx, "settings.wizard.mail_sync"), i18n.T(ctx, "settings.wizard.app_password"), false, false)
			@AccountWizardSubStep(goFn, 3, "1.c", finalStep, i18n.T(ctx, "settings.wizard.check_connection"), false, false)
		</div>
	</div>
}

// AccountWizardJMAPEmailSection lists the mail steps of a JMAP account,
// which has a server and login but no separate sending settings.
templ AccountWizardJMAPEmailSection(goFn string, accountID string, enabled bool, persist bool) {
	<div class="account-wizard-section" data-wizard-section-steps="0,1,2,3" data-active="true">
		<div class="account-wizard-section-heading">
			<button type="button" data-account-wizard-action={ goFn } data-account-wizard-target-step="0" class="account-wizard-section-title">
				<span class="account-wizard-index">1</span>
				<span class="min-w-0"><span class="block text-sm font-semibold">{ i18n.T(ctx, "settings.wizard.email") }</span><span class="block text-xs text-muted-foreground">{ i18n.T(ctx, "settings.wizard.email_description") }</span></span>
			</button>
			@AccountWizardSectionSwitch(goFn, accountID, "email", enabled, false, persist, false, nil)
		</div>
		<div class="account-wizard-substeps">
			@AccountWizardSubStep(goFn, 0, "1.a", i18n.T(ctx, "settings.wizard.account_details"), i18n.T(ctx, "settings.wizard.name_email"), false, true)
			@AccountWizardSubStep(goFn, 1, "1.b", i18n.T(ctx, "settings.wizard.server_login"), "JMAP", false, false)
			@AccountWizardSubStep(goFn, 3, "1.c", i18n.T(ctx, "settings.wizard.test_save"), i18n.T(ctx, "settings.wizard.find_server"), false, false)
		</div>
	</div>
}

templ AccountWizardSubStep(goFn string, step int, index string, title string, description string, disabled bool, active bool) {
	<button type="button" data-on-click={ onAction(goFn, step) } data-account-wizard-action={ goFn } data-account-wizard-target-step={ strconv.Itoa(step) } class="account-wizard-step" data-account-wizard-step={ strconv.Itoa(step) } data-active={ strconv.FormatBool(active) } disabled?={ disabled }>
		<span class="account-wizard-index">{ index }</span>
		<span class="min-w-0"><span class="block text-xs font-semibold">{ title }</span><span class="block text-[11px] text-muted-foreground">{ description }</span></span>
		@reconnectMarkBadge(reconnectMark(ctx, step))
	</button>
}

templ AccountWizardTopStep(goFn string, step int, index string, title string, description string, disabled bool, section bool, accountID string, service string, enabled bool, switchDisabled bool, attrs templ.Attributes) {
	{{ navigationDisabled := disabled }}
	<div id={ fmt.Sprintf("%s-service-section-%s", goFn, service) } class="account-wizard-section" data-wizard-section-steps={ strconv.Itoa(step) } data-active="false" data-disabled={ strconv.FormatBool(navigationDisabled) }>
		<div class="account-wizard-section-heading">
			<button type="button" data-on-click={ onAction(goFn, step) } data-account-wizard-action={ goFn } data-account-wizard-target-step={ strconv.Itoa(step) } class="account-wizard-section-title" data-account-wizard-step={ strconv.Itoa(step) } data-active="false" disabled?={ navigationDisabled }>
				<span class="account-wizard-index">{ index }</span>
				<span class="min-w-0"><span class="block text-sm font-semibold">{ title }</span><span class="block text-xs text-muted-foreground">{ description }</span></span>
				@reconnectMarkBadge(reconnectMark(ctx, step))
			</button>
			if service != "" {
				@AccountWizardSectionSwitch(goFn, accountID, service, enabled, switchDisabled, accountID != "" && service != "contacts" && service != "calendar", false, attrs)
			}
		</div>
	</div>
}

// reconnectMarkBadge marks a step where an imported account still needs a
// password.
templ reconnectMarkBadge(login string) {
	if login != "" {
		<span class="ml-auto inline-flex size-4 shrink-0 items-center justify-center rounded-full bg-amber-500 text-[11px] font-bold leading-none text-white" data-reconnect-mark={ login } title={ i18n.T(ctx, "settings.wizard.password_needed") } aria-label={ i18n.T(ctx, "settings.wizard.password_needed") }>!</span>
	}
}

templ AccountWizardSectionSwitch(goFn string, accountID string, service string, enabled bool, disabled bool, persist bool, oob bool, attrs templ.Attributes) {
	<form
		id={ fmt.Sprintf("%s-wizard-service-switch-%s", goFn, service) }
		class="shrink-0 pt-0.5"
		data-wizard-service-form
		data-wizard-service={ service }
		data-account-id={ accountID }
		if oob {
			hx-swap-oob="outerHTML"
		}
		if persist && service != "calendar" && service != "email" {
			hx-post={ fmt.Sprintf("/api/accounts/%s/services", accountID) }
			hx-swap="none"
		}
	>
		if persist {
			<input type="hidden" name="service" value={ service }/>
		}
		{{ changeAction := "goferSubmitHTMXForm" }}
		if persist && service == "email" {
			{{ changeAction = "saveWizardEmailService" }}
		}
		@switchcomp.Switch(switchcomp.Props{
			ID:         fmt.Sprintf("account-wizard-%s-%s", accountID, service),
			Name:       "enabled",
			Value:      "true",
			Checked:    enabled,
			Disabled:   disabled,
			Attributes: mergeTemplAttrs(attrs, templ.Attributes{"data-wizard-service-switch": service, "data-wizard-service-initial-enabled": strconv.FormatBool(enabled), "data-on-change": onAction(changeAction, actionElement)}),
		})
	</form>
}

func mergeTemplAttrs(base templ.Attributes, extra templ.Attributes) templ.Attributes {
	if base == nil {
		base = templ.Attributes{}
	}
	for k, v := range extra {
		base[k] = v
	}
	return base
}

templ AddAccountWizardFooter() {
	<div id="add-wizard-footer" class="account-wizard-card-footer">
		<div data-wizard-footer-step="0" data-active="true" class="flex justify-end">
			<button type="button" data-on-click='["wizardGo",1]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
				{ i18n.T(ctx, "common.next") }
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="1" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["wizardGo",0]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.wizard.back") }
			</button>
			<button type="button" data-on-click='["wizardGo",2]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
				{ i18n.T(ctx, "common.next") }
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="2" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["wizardGo",1]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.wizard.back") }
			</button>
			<button type="button" data-on-click='["wizardGo",3]' data-add-account-submit-button disabled class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
				{ i18n.T(ctx, "common.next") }
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="3" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["wizardGo",2]' data-account-test-action data-account-test-back class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.wizard.back") }
			</button>
			<div class="ml-auto flex flex-wrap justify-end gap-2">
				<button type="submit" form="account-form" data-account-test-action data-account-test-anyway class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-border text-foreground hover:bg-accent transition-colors disabled:pointer-events-none disabled:opacity-50">{ i18n.T(ctx, "settings.wizard.skip_test") }</button>
				<button type="button" data-on-click='["addAccountTest.run",true]' data-account-test-action data-account-test-retest hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					@icon.RefreshCw(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "settings.wizard.test_again") }
				</button>
				<button type="submit" form="account-form" data-account-test-action data-account-test-save hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					<span data-add-account-only>{ i18n.T(ctx, "settings.wizard.create") }</span>
					<span data-add-mail-only>{ i18n.T(ctx, "settings.wizard.add_email_button") }</span>
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
				<button type="button" data-on-click='["goferNavigate","/settings/accounts?account_added=1"]' data-account-test-close hidden class="inline-flex items-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
					@icon.Check(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "common.done") }
				</button>
				<button type="button" data-on-click='["wizardGo",4]' data-account-test-continue hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					{ i18n.T(ctx, "settings.wizard.continue_contacts") }
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
			</div>
		</div>
		<div id="add-wizard-footer-step-4" data-wizard-footer-step="4" data-active="false" class="hidden"></div>
		<div id="add-wizard-footer-step-5" data-wizard-footer-step="5" data-active="false" class="hidden"></div>
	</div>
}

// ProviderAPIMailPanel describes mail sync for Gmail and Outlook, whose API
// also sends, so these accounts have no sending step.
templ ProviderAPIMailPanel(provider string) {
	<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
		@icon.MailCheck(icon.Props{Class: "size-4 text-muted-foreground"})
		{ i18n.T(ctx, "settings.wizard.mail_sync") }
		<span class="text-xs font-normal text-muted-foreground">({ providerAPIMailTransportLabel(provider) })</span>
	</h4>
	<div class="rounded-lg border border-border bg-background/45 p-4">
		<div class="flex items-start gap-3">
			<div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-card text-muted-foreground">
				@icon.MailCheck(icon.Props{Class: "size-4"})
			</div>
			<div class="min-w-0">
				<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ providerAPIMailTransportLabel(provider) }</div>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ providerAPIMailPanelDescription(ctx, provider) }</p>
			</div>
		</div>
	</div>
}

// ICloudSignInPanel asks for an iCloud account's login. Apple lets other mail
// apps sign in only with an app-specific password, and the servers are
// always Apple's, so there are no server settings.
// JMAPSignInPanel edits a JMAP account's server and login. The server field
// takes the saved session URL, another one, or just a host or nothing, which
// the test and saving find the session URL from.
templ JMAPSignInPanel(sessionURL string, username string, passwordPlaceholder string, passwordRequired bool) {
	<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
		@icon.Server(icon.Props{Class: "size-4 text-muted-foreground"})
		{ i18n.T(ctx, "settings.wizard.server") }
		<span class="text-xs font-normal text-muted-foreground">(JMAP)</span>
	</h4>
	<div>
		<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.server_or_session") }</label>
		@input.Input(input.Props{
			Name:        "jmap_session_url",
			Type:        input.TypeText,
			Value:       sessionURL,
			Placeholder: "mail.example.com",
		})
		<p class="mt-1.5 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.wizard.server_edit_hint") }</p>
	</div>
	<hr class="my-4 border-border"/>
	<h4 class="text-sm font-semibold text-foreground flex items-center gap-2 mb-4">
		@icon.Key(icon.Props{Class: "size-4 text-muted-foreground"})
		{ i18n.T(ctx, "settings.wizard.login") }
	</h4>
	<div class="grid grid-cols-2 gap-3">
		<div class="col-span-2">
			<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.username") }</label>
			@input.Input(input.Props{
				Name:        "username",
				Type:        input.TypeText,
				Value:       username,
				Placeholder: i18n.T(ctx, "settings.wizard.same_as_email"),
			})
		</div>
		<div class="col-span-2">
			<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.password_or_token") }</label>
			@input.Input(input.Props{
				Name:        "password",
				Type:        input.TypePassword,
				Placeholder: passwordPlaceholder,
				Required:    passwordRequired,
				Attributes:  reconnectRequiredAttrs(reconnectMail, passwordRequired),
			})
			<p class="mt-1.5 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.wizard.token_hint") }</p>
		</div>
	</div>
}

templ ICloudSignInPanel(username string, passwordPlaceholder string, passwordRequired bool) {
	<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
		@icon.MailCheck(icon.Props{Class: "size-4 text-muted-foreground"})
		{ i18n.T(ctx, "settings.wizard.mail_sync") }
		<span class="text-xs font-normal text-muted-foreground">(iCloud Mail)</span>
	</h4>
	<div class="space-y-4">
		@ICloudAppPasswordNotice(i18n.T(ctx, "settings.wizard.icloud_notice_edit"))
		<div>
			<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.apple_email") }</label>
			@input.Input(input.Props{
				Name:        "username",
				Type:        input.TypeText,
				Value:       username,
				Placeholder: i18n.T(ctx, "settings.wizard.same_as_email"),
				Attributes:  templ.Attributes{"autocomplete": "username"},
			})
			<p class="mt-1.5 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.wizard.apple_email_hint") }</p>
		</div>
		<div>
			<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.app_password") }</label>
			@input.Input(input.Props{
				Name:        "password",
				Type:        input.TypePassword,
				Placeholder: passwordPlaceholder,
				Required:    passwordRequired,
				Attributes:  mergeTemplAttrs(templ.Attributes{"autocomplete": "new-password"}, reconnectRequiredAttrs(reconnectMail, passwordRequired)),
			})
		</div>
	</div>
}

templ ICloudAppPasswordNotice(message string) {
	<div class="rounded-lg border border-border bg-background/45 p-4">
		<div class="flex items-start gap-3">
			<div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-card text-muted-foreground">
				@AccountProviderIcon(providers.MailServiceICloud, "size-4")
			</div>
			<div class="min-w-0">
				<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">iCloud Mail</div>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ message }</p>
			</div>
		</div>
	</div>
}

templ UnencryptedTransportWarning(id string, active bool) {
	<span class="relative inline-flex size-4 shrink-0 align-middle">
		@popover.Root(popover.RootProps{ID: id, Class: "contents"}) {
			@popover.Trigger(popover.TriggerProps{TriggerType: popover.TriggerTypeHover}) {
				<button
					type="button"
					data-unencrypted-transport-warning
					class={ "size-4 items-center justify-center rounded-sm text-amber-700 transition-colors hover:bg-amber-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring dark:text-amber-300", templ.KV("hidden", !active), templ.KV("inline-flex", active) }
					aria-label={ i18n.T(ctx, "settings.wizard.unencrypted_warning_label") }
				>
					@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
				</button>
			}
			@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, Offset: 8, ShowArrow: true, Class: "mobile-sheet w-80 p-3"}) {
				<div class="flex items-start gap-2.5">
					@icon.TriangleAlert(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-amber-700 dark:text-amber-300"})
					<p class="text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.wizard.unencrypted_warning") }</p>
				</div>
			}
		}
	</span>
}

func accountEditUsesProviderAPI(provider string) bool {
	provider = strings.ToLower(strings.TrimSpace(provider))
	return provider == providers.ProviderGmail || provider == providers.ProviderOutlook
}

func providerAPIMailTransportLabel(provider string) string {
	if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
		return "Microsoft Graph"
	}
	return "Gmail API"
}

func providerAPIMailPanelDescription(ctx context.Context, provider string) string {
	if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
		return i18n.T(ctx, "settings.wizard.outlook_api_description")
	}
	return i18n.T(ctx, "settings.wizard.gmail_api_description")
}

templ EditAccountDialog(data models.EditAccountData) {
	@dialog.Dialog(dialog.Props{ID: "edit-account-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "account-wizard-dialog mobile-page-dialog sm:max-w-4xl"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "settings.edit_account.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "settings.edit_account.description") }
				}
			}
			if data.ReconnectPending {
				<p class="flex items-start gap-2 rounded-lg border border-amber-300/50 bg-amber-100/50 px-3 py-2 text-xs text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300" data-edit-account-reconnect-pending>
					@icon.KeyRound(icon.Props{Class: "mt-0.5 size-3.5 shrink-0"})
					if editAccountNeeds(data, reconnectSignIn) {
						<span>{ i18n.T(ctx, "settings.edit_account.reconnect_sign_in") }</span>
					} else {
						<span data-reconnect-note>{ editAccountReconnectNote(ctx, data) }</span>
					}
				</p>
			}
			<div class="account-wizard-shell grid gap-4 pt-2 md:grid-cols-[16rem_minmax(0,1fr)]">
		if editAccountSkipsSending(data) {
			<div data-wizard-skip-sending hidden></div>
		}
		@withReconnectMarks(data, AccountWizardEditSidebar(data))
				<div id="edit-wizard-viewport" class="account-wizard-viewport">
					<div id="edit-wizard-track" class="flex items-start transition-transform duration-300 ease-in-out" style="width: 600%">
						<form id="edit-account-form" hx-post={ fmt.Sprintf("/api/accounts/%s/edit", data.AccountID) } hx-target="#edit-account-save-status" hx-swap="innerHTML" data-on-htmx-before-request='["handleEditAccountSaveStart","$event"]' data-on-htmx-after-request='["handleEditAccountSaveResult","$event"]' class="contents">
						<input type="hidden" name="provider" value={ data.Provider }/>
						if editAccountIsICloud(data) {
							<input type="hidden" name="mail_service" value={ providers.MailServiceICloud }/>
						}
						<div class="w-1/6 shrink-0 px-1" data-wizard-step="0">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.User(icon.Props{Class: "size-4 text-muted-foreground"})
								{ i18n.T(ctx, "settings.wizard.account_details") }
							</h4>
							<div class="space-y-4">
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.add_account.email") }</label>
									@input.Input(input.Props{
										Name:  "email_address",
										Type:  input.TypeEmail,
										Value: data.EmailAddress,
									})
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.add_account.display_name") }</label>
									@input.Input(input.Props{
										Name:  "display_name",
										Type:  input.TypeText,
										Value: data.DisplayName,
									})
								</div>
							</div>
							</div>
							<div class="account-wizard-controls flex justify-end">
								<button type="button" data-on-click='["editWizardGo",1]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									{ i18n.T(ctx, "common.next") }
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="1">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							if accountEditUsesProviderAPI(data.Provider) {
								@ProviderAPIMailPanel(data.Provider)
							} else if editAccountIsICloud(data) {
								@ICloudSignInPanel(data.Username, editAccountPasswordPlaceholder(ctx, data), editAccountNeeds(data, reconnectMail))
							} else if editAccountIsJMAP(data) {
								@JMAPSignInPanel(data.JMAPSessionURL, data.Username, editAccountPasswordPlaceholder(ctx, data), editAccountNeeds(data, reconnectMail))
							} else {
								<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
									@icon.Inbox(icon.Props{Class: "size-4 text-muted-foreground"})
									{ i18n.T(ctx, "settings.wizard.incoming_mail") }
									<span class="text-xs font-normal text-muted-foreground">(IMAP)</span>
								</h4>
								<div class="grid grid-cols-2 gap-3">
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.imap_host") }</label>
										@input.Input(input.Props{
											Name:  "imap_host",
											Type:  input.TypeText,
											Value: data.IMAPHost,
										})
										<div data-server-check="imap" class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
									</div>
									<div>
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.port") }</label>
										@input.Input(input.Props{
											Name:  "imap_port",
											Type:  input.TypeNumber,
											Value: strconv.Itoa(data.IMAPPort),
										})
									</div>
					<div>
											<label class="text-xs font-medium text-muted-foreground mb-1.5 flex items-center gap-1.5">
												<span>{ i18n.T(ctx, "settings.wizard.encryption") }</span>
												@UnencryptedTransportWarning("edit-imap-unencrypted-warning", data.IMAPTLSMode == "plaintext")
											</label>
											@selectbox.SelectBox() {
												@selectbox.Trigger(selectbox.TriggerProps{Name: "imap_tls_mode", DisableClear: true, Attributes: templ.Attributes{"data-on-change": onAction("toggleUnencryptedTransportWarning", actionElement)}}) {
												@selectbox.Value(selectbox.ValueProps{Placeholder: "TLS"}) { TLS }
											}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
											@selectbox.Item(selectbox.ItemProps{Value: "tls", Selected: data.IMAPTLSMode == "tls"}) { TLS }
											@selectbox.Item(selectbox.ItemProps{Value: "starttls", Selected: data.IMAPTLSMode == "starttls"}) { STARTTLS }
											@selectbox.Item(selectbox.ItemProps{Value: "plaintext", Selected: data.IMAPTLSMode == "plaintext"}) { { i18n.T(ctx, "settings.wizard.unencrypted") } }
										}
									}
										</div>
								</div>
								<hr class="my-4 border-border"/>
								<h4 class="text-sm font-semibold text-foreground flex items-center gap-2 mb-4">
									@icon.Key(icon.Props{Class: "size-4 text-muted-foreground"})
									{ i18n.T(ctx, "settings.wizard.login") }
								</h4>
								<div class="grid grid-cols-2 gap-3">
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.username") }</label>
										@input.Input(input.Props{
											Name:  "username",
											Type:  input.TypeText,
											Value: data.Username,
										})
									</div>
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.password") }</label>
										@input.Input(input.Props{
											Name:        "password",
											Type:        input.TypePassword,
											Placeholder: editAccountPasswordPlaceholder(ctx, data),
											Required:    editAccountNeeds(data, reconnectMail),
											Attributes:  reconnectRequiredAttrs(reconnectMail, editAccountNeeds(data, reconnectMail)),
										})
									</div>
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.method") }</label>
										@selectbox.SelectBox() {
											@selectbox.Trigger(selectbox.TriggerProps{Name: "auth_method"}) {
												@selectbox.Value(selectbox.ValueProps{Placeholder: "PLAIN"}) { PLAIN }
											}
											@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
												@selectbox.Item(selectbox.ItemProps{Value: "plain", Selected: data.AuthMethod == "plain"}) { PLAIN }
												@selectbox.Item(selectbox.ItemProps{Value: "oauth2", Selected: data.AuthMethod == "oauth2"}) { OAuth2 }
											}
										}
									</div>
								</div>
							}
							</div>
							<div class="account-wizard-controls flex justify-between">
								<button type="button" data-on-click='["editWizardGo",0]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "settings.wizard.back") }
								</button>
								<button type="button" data-on-click='["editWizardGo",2]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									{ i18n.T(ctx, "common.next") }
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="2">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll" data-wizard-service-content="email">
							if !editAccountSkipsSending(data) {
							<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
								@icon.Send(icon.Props{Class: "size-4 text-muted-foreground"})
								{ i18n.T(ctx, "settings.wizard.sending_mail") }
								<span class="text-xs font-normal text-muted-foreground">(SMTP)</span>
							</h4>
							<div class="grid grid-cols-2 gap-3">
								<div class="col-span-2">
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.smtp_host") }</label>
									@input.Input(input.Props{
										Name:  "smtp_host",
										Type:  input.TypeText,
										Value: data.SMTPHost,
									})
									<div data-server-check="smtp" class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
								</div>
								<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.port") }</label>
									@input.Input(input.Props{
										Name:  "smtp_port",
										Type:  input.TypeNumber,
										Value: strconv.Itoa(data.SMTPPort),
									})
								</div>
					<div>
									<label class="text-xs font-medium text-muted-foreground mb-1.5 flex items-center gap-1.5">
										<span>{ i18n.T(ctx, "settings.wizard.encryption") }</span>
										@UnencryptedTransportWarning("edit-smtp-unencrypted-warning", data.SMTPTLSMode == "plaintext")
									</label>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "smtp_tls_mode", DisableClear: true, Attributes: templ.Attributes{"data-on-change": onAction("toggleUnencryptedTransportWarning", actionElement)}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: "TLS"}) { TLS }
										}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
										@selectbox.Item(selectbox.ItemProps{Value: "tls", Selected: data.SMTPTLSMode == "tls"}) { TLS }
										@selectbox.Item(selectbox.ItemProps{Value: "starttls", Selected: data.SMTPTLSMode == "starttls"}) { STARTTLS }
										@selectbox.Item(selectbox.ItemProps{Value: "plaintext", Selected: data.SMTPTLSMode == "plaintext"}) { { i18n.T(ctx, "settings.wizard.unencrypted") } }
									}
								}
							</div>
							</div>
							<hr class="my-4 border-border"/>
							<label class="flex items-center gap-2 cursor-pointer mb-4">
								@checkbox.Checkbox(checkbox.Props{
									ID:         "edit-smtp-same-auth",
									Checked:    data.SameSmtpAuth,
									Attributes: templ.Attributes{"data-on-change": onAction("editToggleSmtpAuth", actionChecked)},
								})
								<span class="text-sm">{ i18n.T(ctx, "settings.wizard.same_login") }</span>
							</label>
							<div id="edit-smtp-auth-fields" class={ templ.KV("opacity-50", data.SameSmtpAuth) }>
								<div class="grid grid-cols-2 gap-3">
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.smtp_username") }</label>
										@input.Input(input.Props{
											Name:     "smtp_username",
											Type:     input.TypeText,
											Value:    data.SmtpUsername,
											Disabled: data.SameSmtpAuth,
										})
									</div>
									<div class="col-span-2">
										<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.smtp_password") }</label>
										@input.Input(input.Props{
											Name:        "smtp_password",
											Type:        input.TypePassword,
											Placeholder: editAccountSMTPPasswordPlaceholder(ctx, data),
											Disabled:    data.SameSmtpAuth,
											Required:    data.ReconnectSMTP,
											Attributes:  reconnectRequiredAttrs(reconnectMail, data.ReconnectSMTP),
										})
									</div>
								</div>
							</div>
							}
							</div>
							<div class="account-wizard-controls flex justify-between">
								<button type="button" data-on-click='["editWizardGo",1]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "settings.wizard.back") }
								</button>
								<button type="button" data-on-click='["editWizardGo",3]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
									{ i18n.T(ctx, "common.next") }
									@icon.ChevronRight(icon.Props{Class: "size-4"})
								</button>
							</div>
							</div>
						</div>
						</form>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="3">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll">
								<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
									@icon.PlugZap(icon.Props{Class: "size-4 text-muted-foreground"})
									{ i18n.T(ctx, "settings.wizard.test_save") }
								</h4>
								<p class="text-xs leading-relaxed text-muted-foreground">{ editAccountTestDescription(ctx, data) }</p>
								<div data-edit-account-unsaved hidden role="status" class="mt-3 rounded-md border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-xs text-amber-900 dark:text-amber-100">{ i18n.T(ctx, "settings.edit_account.unsaved") }</div>
								<div id="edit-account-test-results" data-test-url={ editAccountTestURL(data) } data-test-typed={ strconv.FormatBool(editAccountTestsTypedSettings(data)) } aria-live="polite" class="mt-4 space-y-3"></div>
								<div id="edit-account-save-status" class="mt-5"></div>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="4">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll">
								<div data-wizard-service-content="contacts">
									@ContactSyncSettings(data)
								</div>
							</div>
							<div class="account-wizard-controls flex justify-between gap-2">
								<button type="button" data-on-click='["editWizardGo",3]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "settings.wizard.back") }
								</button>
				<button type="button" data-on-click='["wizardServiceNext","$this","contacts",5]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
					{ i18n.T(ctx, "common.next") }
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
							</div>
							</div>
						</div>

						<div class="w-1/6 shrink-0 px-1" data-wizard-step="5">
							<div class="account-wizard-panel">
							<div class="account-wizard-scroll">
								<div
									data-wizard-service-content="calendar"
									data-wizard-service-always-active="true"
								>
									@CalendarSyncSettings(data)
								</div>
							</div>
							<div class="account-wizard-controls flex justify-between gap-2">
								<button type="button" data-on-click='["editWizardGo",4]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent">
									@icon.ArrowLeft(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "settings.wizard.back") }
								</button>
				<button type="button" data-on-click='["wizardServiceNext","$this","calendar","done"]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
					{ i18n.T(ctx, "common.next") }
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
							</div>
						</div>
						</div>

					</div>
				</div>
			</div>
			@EditAccountWizardFooter(data)
		}
	}
}

templ EditAccountWizardFooter(data models.EditAccountData) {
	<div id="edit-wizard-footer" class="account-wizard-card-footer">
		<div data-wizard-footer-step="email-off" data-active="false" class="hidden flex justify-end gap-2">
			<div class="flex justify-end gap-2">
				<button type="button" data-on-click='["goferNavigate","/settings/accounts"]' class="inline-flex items-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
					@icon.Check(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "common.done") }
				</button>
				<button type="button" data-on-click='["editWizardGo",4,true]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">{ i18n.T(ctx, "settings.wizard.continue_contacts") }</button>
			</div>
		</div>
		<div data-wizard-footer-step="0" data-active="true" class="flex justify-end">
			<button type="button" data-on-click='["editWizardGo",1]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
				{ i18n.T(ctx, "common.next") }
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="1" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["editWizardGo",0]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.wizard.back") }
			</button>
			<button type="button" data-on-click='["editWizardGo",2]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
				{ i18n.T(ctx, "common.next") }
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="2" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["editWizardGo",1]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.wizard.back") }
			</button>
			<button type="button" data-on-click='["editWizardGo",3]' class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
				{ i18n.T(ctx, "common.next") }
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
		<div data-wizard-footer-step="3" data-active="false" class="hidden flex justify-between">
			<button type="button" data-on-click='["editWizardGo",2]' data-account-test-action data-account-test-back class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.wizard.back") }
			</button>
			<div class="ml-auto flex flex-wrap justify-end gap-2">
				<button type="submit" form="edit-account-form" data-account-test-action data-account-test-anyway { reconnectGateAttrs("edit-account-form", "", editAccountNeeds(data, reconnectMail))... } class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-2 rounded-lg border border-border text-foreground hover:bg-accent transition-colors disabled:pointer-events-none disabled:opacity-50">{ i18n.T(ctx, "settings.edit_account.skip_test") }</button>
				<button type="button" data-on-click='["editAccountTest.run",true]' data-account-test-action data-account-test-retest hidden { reconnectGateAttrs("edit-account-form", "", editAccountNeeds(data, reconnectMail))... } class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					@icon.RefreshCw(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "settings.wizard.test_again") }
				</button>
				<button type="button" data-on-click='["editAccountSaveOrContinue"]' data-account-test-action data-account-test-save hidden { reconnectGateAttrs("edit-account-form", "", editAccountNeeds(data, reconnectMail))... } class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					<span data-edit-account-save-label>{ i18n.T(ctx, "settings.edit_account.save") }</span>
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
				<button type="button" data-on-click='["goferNavigate","/settings/accounts"]' data-account-test-close hidden class="inline-flex items-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
					@icon.Check(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "common.done") }
				</button>
				<button type="button" data-on-click='["editWizardGo",4,true]' data-account-test-continue hidden class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg bg-primary text-primary-foreground hover:bg-primary/90 transition-colors disabled:pointer-events-none disabled:opacity-50">
					{ i18n.T(ctx, "settings.wizard.continue_contacts") }
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
			</div>
		</div>
		<div data-wizard-footer-step="4" data-active="false" class="hidden flex justify-between gap-2">
			<button type="button" data-on-click='["editWizardGo",3]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.wizard.back") }
			</button>
			// Done saves the contacts and finishes, without going on to the
			// calendar.
			<div class="flex gap-2">
				<button type="button" data-on-click='["wizardServiceNext","$this","contacts","done"]' { reconnectGateAttrs(fmt.Sprintf("account-contact-sync-form-%s", data.AccountID), "contacts", editAccountNeeds(data, reconnectContacts))... } class="inline-flex items-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-accent">
					@icon.Check(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "common.done") }
				</button>
				<button type="button" data-on-click='["wizardServiceNext","$this","contacts",5]' { reconnectGateAttrs(fmt.Sprintf("account-contact-sync-form-%s", data.AccountID), "contacts", editAccountNeeds(data, reconnectContacts))... } class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
					{ i18n.T(ctx, "common.next") }
					@icon.ChevronRight(icon.Props{Class: "size-4"})
				</button>
			</div>
		</div>
		<div data-wizard-footer-step="5" data-active="false" class="hidden flex justify-between gap-2">
			<button type="button" data-on-click='["editWizardGo",4]' class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-2 rounded-md border border-border hover:bg-accent disabled:pointer-events-none disabled:opacity-50">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.wizard.back") }
			</button>
			<button type="button" data-on-click='["wizardServiceNext","$this","calendar","done"]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
				@icon.Check(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "common.done") }
			</button>
		</div>
	</div>
}

func editAccountTestsTypedSettings(data models.EditAccountData) bool {
	return (data.Provider == "imap" || editAccountIsJMAP(data)) && data.AuthMethod == "plain"
}

// editAccountTestURL tests the typed settings of accounts that sign in with a
// password. Others, such as Gmail or Outlook, have no mail settings to type,
// so the saved connection is tested.
func editAccountTestURL(data models.EditAccountData) string {
	if editAccountTestsTypedSettings(data) {
		return "/api/accounts/" + data.AccountID + "/test-changes"
	}
	return "/api/accounts/" + data.AccountID + "/test?wizard=check"
}

func editAccountTestDescription(ctx context.Context, data models.EditAccountData) string {
	if editAccountIsJMAP(data) {
		return i18n.T(ctx, "settings.edit_account.test_jmap")
	}
	if editAccountTestsTypedSettings(data) {
		return i18n.T(ctx, "settings.edit_account.test_both")
	}
	return i18n.T(ctx, "settings.edit_account.test_saved")
}

templ ContactSyncSettings(data models.EditAccountData) {
	{{ sameCardDAVAuth := strings.TrimSpace(data.ContactSync.Username) == "" || strings.TrimSpace(data.ContactSync.Username) == strings.TrimSpace(data.Username) }}
	{{ isBuiltinOAuthContactSync := data.Provider == "gmail" || data.Provider == "outlook" }}
	{{ isICloud := editAccountIsICloud(data) }}
	{{ providerName := accountProviderName(data.Provider) }}
	{{ isJMAP := data.Provider == providers.ProviderJMAP && !isICloud }}
	{{ useJMAP := isJMAP && contactSyncUsesJMAP(data) }}
	{{ fieldsID := fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID) }}
	{{ statusID := fmt.Sprintf("account-contact-sync-status-%s", data.AccountID) }}
	<div class="space-y-3">
		<div class="account-wizard-sticky-header flex items-start justify-between gap-4">
			<div class="min-w-0">
				<h4 class="text-sm font-semibold text-foreground flex items-center gap-2">
					@icon.BookUser(icon.Props{Class: "size-4 text-muted-foreground"})
					{ i18n.T(ctx, "settings.contact_sync.title") }
				</h4>
				<p class="mt-1 text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.contact_sync.description") }</p>
			</div>
			if data.ContactSync.Enabled {
				<span class="shrink-0 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">{ i18n.T(ctx, "settings.switch.enabled") }</span>
			} else {
				<span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.not_configured") }</span>
			}
		</div>
		<div data-wizard-service-status="contacts" class="min-h-0"></div>
		if isBuiltinOAuthContactSync {
			<div class="space-y-2 rounded-lg border border-border bg-background/50 p-3 text-xs text-muted-foreground leading-relaxed">
				<p>{ i18n.T(ctx, "settings.contact_sync.provider_auth", "provider", providerName) }</p>
				<p data-contact-single-address-book>{ contactSingleAddressBookNote(ctx, data.Provider) }</p>
			</div>
		} else {
			<form id={ fmt.Sprintf("account-contact-sync-form-%s", data.AccountID) } data-contact-sync-form data-wizard-contact-form data-wizard-next-step="5" data-account-id={ data.AccountID } hx-post={ fmt.Sprintf("/api/accounts/%s/contacts/sync", data.AccountID) } hx-target={ fmt.Sprintf("#account-contact-sync-status-%s", data.AccountID) } hx-swap="innerHTML" class="space-y-3">
				<div id={ fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID) } class="grid gap-3 sm:grid-cols-2">
					if isICloud {
						<div class="sm:col-span-2">
							@ICloudContactsNotice()
						</div>
						@ICloudContactFields()
					} else {
					if isJMAP {
						@JMAPContactProtocolChoice(data.AccountID, fieldsID, statusID, useJMAP)
					}
					<div class={ "sm:col-span-2 grid gap-3 sm:grid-cols-2", templ.KV("hidden", useJMAP) } data-contact-protocol="carddav">
					<div class="sm:col-span-2">
						<div class="mb-1.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
							<label class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.base_url") }</label>
							@CardDAVAutodiscoverButton(data.AccountID, fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), fmt.Sprintf("account-contact-sync-status-%s", data.AccountID))
						</div>
						@input.Input(input.Props{Name: "base_url", Type: input.TypeURL, Value: data.ContactSync.BaseURL, Placeholder: "https://dav.example.com/"})
						<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
					</div>
					<label class="sm:col-span-2 flex items-center gap-2 cursor-pointer">
						@checkbox.Checkbox(checkbox.Props{
							Name:       "use_account_credentials",
							Value:      "1",
							Checked:    sameCardDAVAuth,
							Attributes: templ.Attributes{"data-on-change": onAction("toggleCardDAVAuth", actionElement)},
						})
						<span class="text-sm">{ i18n.T(ctx, "settings.contact_sync.same_credentials") }</span>
					</label>
					<div class={ "sm:col-span-2 grid gap-3 sm:grid-cols-2", templ.KV("opacity-50", sameCardDAVAuth) } data-carddav-credential-fields>
						<div>
							<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.wizard.username") }</label>
							@input.Input(input.Props{Name: "username", Type: input.TypeText, Value: data.ContactSync.Username, Placeholder: data.Username, Disabled: sameCardDAVAuth})
						</div>
						<div>
							<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.contact_sync.password") }</label>
							@input.Input(input.Props{Name: "password", Type: input.TypePassword, Placeholder: contactSyncPasswordPlaceholder(ctx, data.ContactSync), Disabled: sameCardDAVAuth, Attributes: reconnectRequiredAttrs(reconnectContacts, editAccountNeeds(data, reconnectContacts))})
						</div>
					</div>
					</div>
					}
					if len(data.ContactSync.AddressBooks) > 1 || (useJMAP && data.ContactSync.Provider == providers.ProviderJMAP && len(data.ContactSync.AddressBooks) > 0) {
						<div class="sm:col-span-2 rounded-lg border border-border bg-background/45 p-3" data-carddav-addressbook-section>
							<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "settings.contact_sync.selected_books") }</div>
							<p class="mt-1 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.selected_books_hint") }</p>
							<div class="mt-3 space-y-2">
								for i, book := range data.ContactSync.AddressBooks {
									<label class="flex w-full items-start gap-3 rounded-md border border-primary bg-primary/10 px-3 py-2 text-xs">
										<span class="mt-0.5 inline-flex">
											@checkbox.Checkbox(checkbox.Props{Name: "addressbook_url", Value: book.URL, Checked: true})
										</span>
										<input type="hidden" name="addressbook_id" value={ book.ID }/>
										<input type="hidden" name="addressbook_name" value={ book.Name }/>
										<div class="min-w-0 flex-1">
											<div class="font-semibold text-foreground">{ contactAddressBookName(ctx, book) }</div>
											if data.ContactSync.Provider != providers.ProviderJMAP {
												<div class="mt-0.5 truncate text-muted-foreground">{ book.URL }</div>
											}
											<label class="mt-2 inline-flex items-center gap-1.5 text-[11px] text-muted-foreground">
												if book.Default || (!contactSyncHasDefaultBook(data.ContactSync.AddressBooks) && i == 0) {
													@radio.Radio(radio.Props{Name: "default_addressbook_url", Value: book.URL, Checked: true})
												} else {
													@radio.Radio(radio.Props{Name: "default_addressbook_url", Value: book.URL})
												}
												{ i18n.T(ctx, "settings.contact_sync.default_book") }
											</label>
										</div>
										if contactSyncCanCreate(data) {
											@AddressBookActions(book.URL, contactAddressBookName(ctx, book), templ.Attributes{"data-account-id": data.AccountID, "data-fields-id": fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), "data-status-id": fmt.Sprintf("account-contact-sync-status-%s", data.AccountID), "data-carddav-autodiscover": "false"})
										}
									</label>
								}
							</div>
							if contactSyncCanCreate(data) {
								@CardDAVCreateAddressBook(data.AccountID, fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), fmt.Sprintf("account-contact-sync-status-%s", data.AccountID), false)
							}
						</div>
					} else if strings.TrimSpace(data.ContactSync.AddressBookURL) != "" {
						<div class="sm:col-span-2 rounded-md border border-border bg-background/35 px-3 py-2" data-carddav-addressbook-section data-carddav-manual-addressbook>
							<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.contact_sync.exact_url") }</label>
							@input.Input(input.Props{Name: "addressbook_url", Type: input.TypeURL, Value: data.ContactSync.AddressBookURL, Placeholder: "https://dav.example.com/addressbooks/user/default/"})
							<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
							if contactSyncCanCreate(data) {
								@CardDAVCreateAddressBook(data.AccountID, fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), fmt.Sprintf("account-contact-sync-status-%s", data.AccountID), false)
							}
						</div>
					} else {
						<div class="hidden sm:col-span-2 rounded-md border border-border bg-background/35 px-3 py-2" data-carddav-addressbook-section data-carddav-manual-addressbook>
							<label class="text-xs font-medium text-muted-foreground mb-1.5 block">{ i18n.T(ctx, "settings.contact_sync.exact_url") }</label>
							@input.Input(input.Props{Name: "addressbook_url", Type: input.TypeURL, Placeholder: "https://dav.example.com/addressbooks/user/default/"})
							<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
						</div>
					}
				</div>
				<div id={ fmt.Sprintf("account-contact-sync-status-%s", data.AccountID) } class="min-h-0"></div>
				<div class="flex flex-wrap justify-end gap-2">
					if isICloud {
						@CardDAVDiscoverAddressBooksButton(data.AccountID, fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), fmt.Sprintf("account-contact-sync-status-%s", data.AccountID), providers.ICloudCardDAVURL)
					} else {
						<span class={ templ.KV("contents", !useJMAP), templ.KV("hidden", useJMAP) } data-contact-protocol="carddav">
							@CardDAVDiscoverAddressBooksButton(data.AccountID, fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), fmt.Sprintf("account-contact-sync-status-%s", data.AccountID), data.ContactSync.BaseURL)
							@CardDAVManualAddressBookButton(fmt.Sprintf("account-contact-sync-fields-%s", data.AccountID), data.ContactSync.BaseURL)
						</span>
					}
				</div>
			</form>
		}
	</div>
}

// contactSyncCanCreate reports whether the account syncs contacts from a
// CardDAV server it found, or from its JMAP server, where new address books
// can be made.
func contactSyncCanCreate(data models.EditAccountData) bool {
	if data.ContactSync.Provider == providers.ProviderJMAP {
		return len(data.ContactSync.AddressBooks) > 0
	}
	return strings.TrimSpace(data.ContactSync.BaseURL) != ""
}

// AddressBookActions renames or deletes an address book on its server, by
// its URL or JMAP id. attrs say where the list it is in signs in from.
templ AddressBookActions(id, name string, attrs templ.Attributes) {
	<span class="ml-auto flex shrink-0 items-center gap-0.5">
		<button type="button" data-address-book-rename={ id } data-address-book-name={ name } aria-label={ i18n.T(ctx, "settings.contact_sync.rename_label", "name", name) } title={ i18n.T(ctx, "settings.contact_sync.rename") } class="inline-flex size-6 items-center justify-center rounded text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50" { attrs... }>
			@icon.Pencil(icon.Props{Class: "size-3.5"})
		</button>
		<button type="button" data-address-book-delete={ id } data-address-book-name={ name } aria-label={ i18n.T(ctx, "settings.contact_sync.delete_label", "name", name) } title={ i18n.T(ctx, "settings.account.delete") } class="inline-flex size-6 items-center justify-center rounded text-muted-foreground transition-colors hover:bg-destructive/10 hover:text-destructive focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50" { attrs... }>
			@icon.Trash2(icon.Props{Class: "size-3.5"})
		</button>
	</span>
}

// CardDAVCreateAddressBook makes a new address book on the CardDAV server in
// the fields, signing in with them, then lists the address books again with
// the new one ticked. The name field has no name, so saving doesn't send it.
templ CardDAVCreateAddressBook(accountID string, fieldsID string, statusID string, autodiscover bool) {
	<div class="mt-3 flex items-end gap-2 border-t border-border/60 pt-3" data-carddav-create-row>
		<div class="min-w-0 flex-1">
			<label class="mb-1.5 block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.new_book") }</label>
			@input.Input(input.Props{Type: input.TypeText, Placeholder: i18n.T(ctx, "settings.contact_sync.book_name"), Attributes: templ.Attributes{"maxlength": "100", "autocomplete": "off", "data-carddav-new-name": ""}})
		</div>
		<button type="button" data-carddav-create data-account-id={ accountID } data-fields-id={ fieldsID } data-status-id={ statusID } data-carddav-autodiscover={ fmt.Sprint(autodiscover) } class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md border border-primary/30 bg-primary/10 px-3 text-xs font-semibold text-primary transition-colors hover:border-primary/45 hover:bg-primary/15 disabled:pointer-events-none disabled:opacity-60">
			@icon.Plus(icon.Props{Class: "size-3.5"})
			{ i18n.T(ctx, "settings.contact_sync.create") }
		</button>
	</div>
}

// contactSingleAddressBookNote says why a Gmail or Outlook account shows no
// address books to choose or add: each keeps all its contacts in one.
func contactSingleAddressBookNote(ctx context.Context, provider string) string {
	if provider == providers.ProviderGmail {
		return i18n.T(ctx, "settings.contact_sync.single_book_google")
	}
	return i18n.T(ctx, "settings.contact_sync.single_book_outlook")
}

// contactSyncUsesJMAP reports whether a JMAP account's contacts form starts
// on JMAP: always, unless the account already syncs contacts over CardDAV.
func contactSyncUsesJMAP(data models.EditAccountData) bool {
	return data.Provider == providers.ProviderJMAP && !(data.ContactSync.Provider == providers.ProviderCardDAV && data.ContactSync.Enabled)
}

func contactProtocol(useJMAP bool) string {
	if useJMAP {
		return providers.ProviderJMAP
	}
	return providers.ProviderCardDAV
}

// JMAPContactProtocolChoice lets a JMAP account sync contacts over JMAP, with
// the mail login, or over CardDAV instead. The hidden provider field carries
// the choice; the CardDAV fields sit in data-contact-protocol="carddav".
templ JMAPContactProtocolChoice(accountID string, fieldsID string, statusID string, useJMAP bool) {
	<input type="hidden" name="provider" value={ contactProtocol(useJMAP) } data-contact-protocol-field/>
	<div class="sm:col-span-2 space-y-2">
		<label class="text-xs font-medium text-muted-foreground block">{ i18n.T(ctx, "settings.contact_sync.over") }</label>
		<div class="flex flex-wrap gap-4">
			<label class="inline-flex items-center gap-2 text-sm cursor-pointer">
				@radio.Radio(radio.Props{Name: "contact_protocol", Value: providers.ProviderJMAP, Checked: useJMAP, Attributes: templ.Attributes{"data-on-change": onAction("chooseContactProtocol", actionElement)}})
				JMAP
			</label>
			<label class="inline-flex items-center gap-2 text-sm cursor-pointer">
				@radio.Radio(radio.Props{Name: "contact_protocol", Value: providers.ProviderCardDAV, Checked: !useJMAP, Attributes: templ.Attributes{"data-on-change": onAction("chooseContactProtocol", actionElement)}})
				CardDAV
			</label>
		</div>
	</div>
	<div class={ "sm:col-span-2 space-y-3", templ.KV("hidden", !useJMAP) } data-contact-protocol="jmap">
		<p class="text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.jmap_note") }</p>
		<button type="button" data-carddav-discover data-account-id={ accountID } data-fields-id={ fieldsID } data-status-id={ statusID } class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground hover:bg-accent">
			@icon.Search(icon.Props{Class: "size-3.5"})
			{ i18n.T(ctx, "settings.contact_sync.find_books") }
		</button>
	</div>
}

// ICloudContactFields points contact sync at iCloud with the mail login, in
// place of the CardDAV server and login fields.
templ ICloudContactFields() {
	<input type="hidden" name="base_url" value={ providers.ICloudCardDAVURL }/>
	<input type="hidden" name="use_account_credentials" value="1"/>
}

templ ICloudContactsNotice() {
	<div class="rounded-lg border border-border bg-background/50 p-3 text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "settings.contact_sync.icloud_note") }</div>
}

// calendarSyncUsesJMAP reports whether a JMAP account's calendar form starts
// on JMAP: always, unless its calendars already come from CalDAV.
func calendarSyncUsesJMAP(data models.EditAccountData) bool {
	return editAccountIsJMAP(data) && !(data.CalendarSync.Protocol == "caldav" && data.CalendarSync.SourceCount > 0)
}

func calendarProtocol(useJMAP bool) string {
	if useJMAP {
		return providers.ProviderJMAP
	}
	return "caldav"
}

// JMAPCalendarProtocolChoice lets a JMAP account read its calendars over
// JMAP, with the mail login, or from a CalDAV server instead. The hidden
// calendar_protocol field carries the choice; the CalDAV fields sit in
// data-calendar-protocol="caldav".
templ JMAPCalendarProtocolChoice(useJMAP bool) {
	<input type="hidden" name="calendar_protocol" value={ calendarProtocol(useJMAP) } data-calendar-protocol-field/>
	<div class="sm:col-span-2 space-y-2">
		<label class="text-xs font-medium text-muted-foreground block">{ i18n.T(ctx, "settings.calendar_sync.over") }</label>
		<div class="flex flex-wrap gap-4">
			<label class="inline-flex items-center gap-2 text-sm cursor-pointer">
				@radio.Radio(radio.Props{Name: "calendar_protocol_choice", Value: providers.ProviderJMAP, Checked: useJMAP, Attributes: templ.Attributes{"data-on-change": onAction("chooseCalendarProtocol", actionElement)}})
				JMAP
			</label>
			<label class="inline-flex items-center gap-2 text-sm cursor-pointer">
				@radio.Radio(radio.Props{Name: "calendar_protocol_choice", Value: "caldav", Checked: !useJMAP, Attributes: templ.Attributes{"data-on-change": onAction("chooseCalendarProtocol", actionElement)}})
				CalDAV
			</label>
		</div>
	</div>
	<p class={ "sm:col-span-2 text-xs leading-relaxed text-muted-foreground", templ.KV("hidden", !useJMAP) } data-calendar-protocol="jmap">{ i18n.T(ctx, "settings.calendar_sync.jmap_note") }</p>
}

templ CalendarSyncSettings(data models.EditAccountData) {
	@CalendarSyncSettingsPanel(data, "", false)
}

templ CalendarSyncSettingsResult(data models.EditAccountData, message string, isError bool) {
	@CalendarSyncSettingsPanel(data, message, isError)
}

// GoogleCalendarManageAccess says which Google calendars Gofer may rename
// and delete, and, while that is only the ones it made, offers to sign in
// again allowing it to manage all of them.
templ GoogleCalendarManageAccess(data models.EditAccountData) {
	<div class="rounded-lg border border-border bg-background/50 p-3 text-xs leading-relaxed text-muted-foreground" data-google-calendar-access={ strconv.FormatBool(data.CalendarSync.FullAccess) }>
		if data.CalendarSync.FullAccess {
			<p class="font-semibold text-foreground">{ i18n.T(ctx, "settings.calendar_sync.full_access_title") }</p>
			<p class="mt-0.5">{ i18n.T(ctx, "settings.calendar_sync.full_access_before") }<a href="https://myaccount.google.com/connections" target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline">{ i18n.T(ctx, "settings.calendar_sync.google_account") }</a>{ i18n.T(ctx, "settings.calendar_sync.full_access_after") }</p>
		} else {
			<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
				<div class="min-w-0">
					<p class="font-semibold text-foreground">{ i18n.T(ctx, "settings.calendar_sync.created_only_title") }</p>
					<p class="mt-0.5">{ i18n.T(ctx, "settings.calendar_sync.created_only") }</p>
				</div>
				<form method="POST" action="/api/accounts/oauth2/authorize" class="shrink-0">
					<input type="hidden" name="flow_action" value="reconnect"/>
					<input type="hidden" name="provider" value="gmail"/>
					<input type="hidden" name="email_address" value={ data.EmailAddress }/>
					<input type="hidden" name="display_name" value={ data.DisplayName }/>
					<input type="hidden" name="calendar_access" value="full"/>
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Type: button.TypeSubmit, Attributes: templ.Attributes{"data-google-calendar-full-access": ""}}) {
						@icon.KeyRound(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "settings.calendar_sync.allow_full") }
					}
				</form>
			</div>
		}
	</div>
}

templ CalendarProviderAccessNotice(title string, message string) {
	<div class="rounded-lg border border-border bg-background/50 p-3 text-xs leading-relaxed text-muted-foreground">
		<p class="font-semibold text-foreground">{ title }</p>
		<p class="mt-0.5">{ message }</p>
	</div>
}

templ CalendarSyncSettingsPanel(data models.EditAccountData, message string, isError bool) {
	<div id={ fmt.Sprintf("account-calendar-sync-panel-%s", data.AccountID) } class="space-y-3" data-wizard-service-content="calendar">
		<div class="account-wizard-sticky-header flex items-start justify-between gap-4">
			<div class="min-w-0">
				<h4 class="flex items-center gap-2 text-sm font-semibold text-foreground">
					@icon.CalendarDays(icon.Props{Class: "size-4 text-muted-foreground"})
					{ i18n.T(ctx, "settings.calendar_sync.title") }
				</h4>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.description") }</p>
			</div>
			if data.CalendarSync.Enabled {
				<span class="shrink-0 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">{ i18n.T(ctx, "settings.switch.enabled") }</span>
			} else if data.CalendarSync.SourceCount > 0 {
				<span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.not_selected") }</span>
			} else {
				<span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.not_configured") }</span>
			}
		</div>
		<div data-wizard-service-status="calendar" class="min-h-0"></div>
		if data.Provider == "gmail" {
			@CalendarProviderAccessNotice(i18n.T(ctx, "settings.calendar_sync.google_access"), i18n.T(ctx, "settings.calendar_sync.google_access_note"))
			@GoogleCalendarManageAccess(data)
			<form method="POST" action={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } data-calendar-discovery-form hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) } hx-swap="outerHTML" data-on-htmx-before-request='["handleCalendarDiscoveryStart","$event"]' data-on-htmx-after-request='["handleCalendarDiscoveryResult","$event"]' class="flex justify-end">
				<button type="submit" data-calendar-discovery-submit data-calendar-discovery-refresh?={ data.CalendarSync.SourceCount > 0 } class="inline-flex h-8 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
					@icon.RefreshCw(icon.Props{Class: "size-3.5"})
					<span data-calendar-discovery-label>
						if data.CalendarSync.SourceCount > 0 {
							{ i18n.T(ctx, "settings.calendar_sync.refresh") }
						} else {
							{ i18n.T(ctx, "settings.calendar_sync.discover") }
						}
					</span>
				</button>
			</form>
		} else if data.Provider == "outlook" {
			@CalendarProviderAccessNotice(i18n.T(ctx, "settings.calendar_sync.microsoft_access"), i18n.T(ctx, "settings.calendar_sync.microsoft_access_note"))
			<form method="POST" action={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } data-calendar-discovery-form hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) } hx-swap="outerHTML" data-on-htmx-before-request='["handleCalendarDiscoveryStart","$event"]' data-on-htmx-after-request='["handleCalendarDiscoveryResult","$event"]' class="flex justify-end">
				<button type="submit" data-calendar-discovery-submit data-calendar-discovery-refresh?={ data.CalendarSync.SourceCount > 0 } class="inline-flex h-8 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
					@icon.RefreshCw(icon.Props{Class: "size-3.5"})
					<span data-calendar-discovery-label>
						if data.CalendarSync.SourceCount > 0 {
							{ i18n.T(ctx, "settings.calendar_sync.refresh") }
						} else {
							{ i18n.T(ctx, "settings.calendar_sync.discover") }
						}
					</span>
				</button>
			</form>
		} else if editAccountIsICloud(data) {
			@CalendarProviderAccessNotice(i18n.T(ctx, "settings.calendar_sync.icloud_access"), i18n.T(ctx, "settings.calendar_sync.icloud_access_note"))
			<form method="POST" action={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } data-calendar-discovery-form hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) } hx-swap="outerHTML" data-on-htmx-before-request='["handleCalendarDiscoveryStart","$event"]' data-on-htmx-after-request='["handleCalendarDiscoveryResult","$event"]' class="flex justify-end">
				<input type="hidden" name="caldav_url" value={ providers.ICloudCalDAVURL }/>
				<input type="hidden" name="use_account_credentials" value="1"/>
				<button type="submit" data-calendar-discovery-submit data-calendar-discovery-refresh?={ data.CalendarSync.SourceCount > 0 } class="inline-flex h-8 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
					@icon.RefreshCw(icon.Props{Class: "size-3.5"})
					<span data-calendar-discovery-label>
						if data.CalendarSync.SourceCount > 0 {
							{ i18n.T(ctx, "settings.calendar_sync.refresh") }
						} else {
							{ i18n.T(ctx, "settings.calendar_sync.discover") }
						}
					</span>
				</button>
			</form>
		} else if data.Provider == "imap" || editAccountIsJMAP(data) {
			<form id={ fmt.Sprintf("account-calendar-discovery-form-%s", data.AccountID) } method="POST" action={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } data-calendar-discovery-form hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) } hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) } hx-swap="outerHTML" data-on-htmx-before-request='["handleCalendarDiscoveryStart","$event"]' data-on-htmx-after-request='["handleCalendarDiscoveryResult","$event"]' class="space-y-3">
				{{ useJMAP := calendarSyncUsesJMAP(data) }}
				<div class="grid gap-3 sm:grid-cols-2">
					if editAccountIsJMAP(data) {
						@JMAPCalendarProtocolChoice(useJMAP)
					}
					<div class={ "sm:col-span-2 grid gap-3 sm:grid-cols-2", templ.KV("hidden", useJMAP) } data-calendar-protocol="caldav">
					<div class="sm:col-span-2">
						<div class="mb-1.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
							<label class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.base_url") }</label>
							<button type="button" data-calendar-autodiscover class="inline-flex h-8 w-fit shrink-0 items-center gap-1.5 rounded-md border border-primary/30 bg-primary/10 px-3 text-xs font-semibold text-primary shadow-sm transition-colors hover:border-primary/45 hover:bg-primary/15 disabled:pointer-events-none disabled:opacity-70">
								@icon.Search(icon.Props{Class: "size-3.5"})
								<span data-calendar-autodiscover-label>{ i18n.T(ctx, "settings.contact_sync.autodiscover") }</span>
							</button>
						</div>
						@input.Input(input.Props{Name: "caldav_url", Type: input.TypeURL, Value: data.CalendarSync.CalDAVBaseURL, Placeholder: "https://cdav.migadu.com"})
						<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
					</div>
					<label class="sm:col-span-2 flex cursor-pointer items-center gap-2">
						@checkbox.Checkbox(checkbox.Props{
							Name:       "use_account_credentials",
							Value:      "1",
							Checked:    data.CalendarSync.CalDAVUseAccountCredentials,
							Attributes: templ.Attributes{"data-on-change": onAction("toggleCalendarAuth", actionElement)},
						})
						<span class="text-sm">{ i18n.T(ctx, "settings.contact_sync.same_credentials") }</span>
					</label>
					<div class={ "sm:col-span-2 grid gap-3 sm:grid-cols-2", templ.KV("opacity-50", data.CalendarSync.CalDAVUseAccountCredentials) } data-calendar-credential-fields>
						<div>
							<label class="mb-1.5 block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.wizard.username") }</label>
							@input.Input(input.Props{Name: "username", Type: input.TypeText, Value: data.CalendarSync.CalDAVUsername, Placeholder: data.Username, Disabled: data.CalendarSync.CalDAVUseAccountCredentials})
						</div>
						<div>
							<label class="mb-1.5 block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.password") }</label>
							@input.Input(input.Props{Name: "password", Type: input.TypePassword, Placeholder: calDAVPasswordPlaceholder(ctx, data.CalendarSync), Disabled: data.CalendarSync.CalDAVUseAccountCredentials, Attributes: reconnectRequiredAttrs(reconnectCalendar, editAccountNeeds(data, reconnectCalendar))})
						</div>
					</div>
					</div>
				</div>
				<div class="flex flex-wrap justify-end gap-2">
					<button type="submit" data-calendar-discovery-submit data-calendar-discovery-refresh?={ data.CalendarSync.SourceCount > 0 } { reconnectGateAttrs(fmt.Sprintf("account-calendar-discovery-form-%s", data.AccountID), "", editAccountNeeds(data, reconnectCalendar))... } class="inline-flex h-8 shrink-0 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
						@icon.RefreshCw(icon.Props{Class: "size-3.5"})
						<span data-calendar-discovery-label>
							if data.CalendarSync.SourceCount > 0 {
								{ i18n.T(ctx, "settings.calendar_sync.refresh") }
							} else {
								{ i18n.T(ctx, "settings.calendar_sync.discover") }
							}
						</span>
					</button>
				</div>
			</form>
		} else {
			<div class="rounded-lg border border-border bg-background/50 p-4">
				<div class="flex items-start gap-3">
					<div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-card text-muted-foreground">
						@icon.LockKeyhole(icon.Props{Class: "size-4"})
					</div>
					<div class="min-w-0">
						<p class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "settings.calendar_sync.unavailable_title") }</p>
						<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.unavailable") }</p>
					</div>
					<span class="shrink-0 rounded-full bg-muted px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.coming") }</span>
				</div>
			</div>
		}
		if data.CalendarSync.SourceCount > 0 {
			<div class="rounded-lg border border-border bg-background/45 p-3">
				<div class="flex items-center justify-between gap-4">
					<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "settings.calendar_sync.selected") }</div>
					<span class="shrink-0 rounded-md bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.selected_count", "selected", data.CalendarSync.SelectedSourceCount, "total", data.CalendarSync.SourceCount) }</span>
				</div>
				<p class="mt-1 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.selected_hint") }</p>
				<form
					method="POST"
					action={ fmt.Sprintf("/api/accounts/%s/calendar/sources", data.AccountID) }
					data-calendar-source-form
					data-account-id={ data.AccountID }
					hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/sources", data.AccountID) }
					hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) }
					hx-swap="outerHTML"
					data-on-htmx-before-request='["handleCalendarSourceSaveStart","$event"]'
					data-on-htmx-after-request='["handleCalendarSourceSaveResult","$event"]'
					class="mt-3"
				>
					<div class="max-h-56 space-y-2 overflow-y-auto overscroll-contain pr-1">
						for _, source := range data.CalendarSync.Sources {
							<label class="flex w-full cursor-pointer items-start gap-3 rounded-md border border-border bg-background/35 px-3 py-2 text-xs transition-colors hover:bg-accent/50 has-[:checked]:border-primary/40 has-[:checked]:bg-primary/[0.06]">
								<span class="mt-0.5 inline-flex shrink-0">
									@checkbox.Checkbox(checkbox.Props{
										ID:      fmt.Sprintf("calendar-source-%s", source.ID),
										Name:    "source_id",
										Value:   source.ID,
										Checked: source.IsSelected,
										Attributes: templ.Attributes{
											"data-calendar-source-checkbox": "",
										},
									})
								</span>
								<span class="mt-1 size-2 shrink-0 rounded-full" style={ accountColorStyle(source.Color) }></span>
								<span class="min-w-0 flex-1">
									<span class="block truncate font-semibold text-foreground">{ calendarSourceLabel(ctx, source) }</span>
									if calendarSourceDetailText(ctx, source) != "" {
										<span class="mt-0.5 block truncate text-[11px] text-muted-foreground">{ calendarSourceDetailText(ctx, source) }</span>
									}
								</span>
								if source.IsPrimary {
									<span class="shrink-0 rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">{ i18n.T(ctx, "settings.calendar_sync.primary") }</span>
								}
							</label>
						}
					</div>
					<div data-calendar-source-save-status class="mt-3 min-h-0"></div>
				</form>
				if calendarCreateKind(data) != "" {
					@CalendarCreateForm(data)
				} else if data.CalendarSync.CreateAccess == models.CalendarCreateNeedsReconnect {
					<p class="mt-3 border-t border-border/60 pt-3 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.reconnect_to_create") }</p>
				}
			</div>
		} else if calendarCreateKind(data) != "" {
			<div class="rounded-lg border border-border bg-background/50 p-3 text-xs leading-relaxed text-muted-foreground">
				<p class="font-semibold text-foreground">{ i18n.T(ctx, "settings.calendar_sync.none_on_server") }</p>
				<p class="mt-0.5">{ i18n.T(ctx, "settings.calendar_sync.create_hint") }</p>
				@CalendarCreateForm(data)
			</div>
		} else if data.Provider == "gmail" || data.Provider == "outlook" || data.Provider == "imap" || editAccountIsJMAP(data) {
			<div class="rounded-lg border border-border bg-background/50 p-3 text-xs leading-relaxed text-muted-foreground">
				<p class="font-semibold text-foreground">{ i18n.T(ctx, "settings.calendar_sync.none_found") }</p>
				<p class="mt-0.5">{ i18n.T(ctx, "settings.calendar_sync.none_found_hint") }</p>
			</div>
		}
		if message != "" {
			if isError {
				<div role="alert" class="rounded-lg border border-destructive/30 bg-destructive/5 px-3 py-2 text-xs leading-relaxed text-destructive">{ message }</div>
			} else {
				<div role="status" class="rounded-lg border border-emerald-500/25 bg-emerald-500/5 px-3 py-2 text-xs leading-relaxed text-emerald-700 dark:text-emerald-300">{ message }</div>
			}
		}
	</div>
}

// calendarCreateKind is how the account can make a new calendar from its
// Calendar sync: on its CalDAV server ("caldav"), its JMAP server ("jmap"),
// or its Google or Microsoft calendar ("oauth"), or "" when it can't yet.
// Each needs discovery to have signed in first.
func calendarCreateKind(data models.EditAccountData) string {
	sync := data.CalendarSync
	switch {
	case data.Provider == "gmail" || data.Provider == "outlook":
		if sync.CreateAccess == models.CalendarCreateAllowed && sync.SourceCount > 0 {
			return "oauth"
		}
	case editAccountIsJMAP(data) && calendarSyncUsesJMAP(data):
		if (sync.Protocol == providers.ProviderJMAP && sync.SourceCount > 0) || sync.FoundNone {
			return providers.ProviderJMAP
		}
	case strings.TrimSpace(sync.CalDAVBaseURL) != "":
		return "caldav"
	}
	return ""
}

// CalendarCreateForm makes a new calendar on the account's server, signing in
// as discovery last did, then lists the calendars again with the new one
// selected.
templ CalendarCreateForm(data models.EditAccountData) {
	<form
		method="POST"
		action={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) }
		data-calendar-create-form
		hx-post={ fmt.Sprintf("/api/accounts/%s/calendar/discover", data.AccountID) }
		hx-target={ fmt.Sprintf("#account-calendar-sync-panel-%s", data.AccountID) }
		hx-swap="outerHTML"
		data-on-htmx-before-request='["handleCalendarCreateStart","$event"]'
		data-on-htmx-after-request='["handleCalendarCreateResult","$event"]'
		class="mt-3 flex items-end gap-2 border-t border-border/60 pt-3"
	>
		switch calendarCreateKind(data) {
			case "caldav":
				<input type="hidden" name="caldav_url" value={ data.CalendarSync.CalDAVBaseURL }/>
				if data.CalendarSync.CalDAVUseAccountCredentials {
					<input type="hidden" name="use_account_credentials" value="1"/>
				}
			case providers.ProviderJMAP:
				<input type="hidden" name="calendar_protocol" value={ providers.ProviderJMAP }/>
		}
		<div class="min-w-0 flex-1">
			<label class="mb-1.5 block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.new") }</label>
			@input.Input(input.Props{Name: "create_name", Type: input.TypeText, Placeholder: i18n.T(ctx, "settings.calendar_sync.name_placeholder"), Required: true, Attributes: templ.Attributes{"maxlength": "100", "autocomplete": "off"}})
		</div>
		<button type="submit" data-calendar-create-submit class="inline-flex h-9 shrink-0 items-center gap-1.5 rounded-md bg-primary px-3 text-xs font-semibold text-primary-foreground transition-colors hover:bg-primary/90 disabled:pointer-events-none disabled:opacity-70">
			@icon.Plus(icon.Props{Class: "size-3.5"})
			<span data-calendar-create-label>{ i18n.T(ctx, "settings.contact_sync.create") }</span>
		</button>
	</form>
}

templ CalendarSetupNotice() {
	<div data-wizard-service-content="calendar" data-wizard-service-always-active="true" class="rounded-lg border border-border bg-background/45 p-4">
		<div class="flex items-start justify-between gap-4">
			<div class="flex min-w-0 items-start gap-3">
				<div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-card text-muted-foreground">
					@icon.CalendarDays(icon.Props{Class: "size-4"})
				</div>
				<div class="min-w-0">
					<h4 class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "settings.calendar_sync.title") }</h4>
					<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.setup_note") }</p>
				</div>
			</div>
			<span class="shrink-0 rounded-full bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.available") }</span>
		</div>
		<p class="mt-3 border-t border-border/60 pt-3 text-[11px] leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.calendar_sync.setup_hint") }</p>
	</div>
}

func contactSyncPasswordPlaceholder(ctx context.Context, cfg models.ContactSyncConfig) string {
	if cfg.HasPassword {
		return i18n.T(ctx, "settings.account.password.keep")
	}
	return i18n.T(ctx, "settings.contact_sync.app_password")
}

func calDAVPasswordPlaceholder(ctx context.Context, cfg models.CalendarSyncConfig) string {
	if cfg.CalDAVHasPassword {
		return i18n.T(ctx, "settings.account.password.keep")
	}
	return i18n.T(ctx, "settings.contact_sync.app_password")
}

func contactAddressBookName(ctx context.Context, book models.ContactAddressBook) string {
	if strings.TrimSpace(book.Name) != "" {
		return strings.TrimSpace(book.Name)
	}
	return i18n.T(ctx, "settings.contact_sync.address_book")
}

func contactSyncHasDefaultBook(books []models.ContactAddressBook) bool {
	for _, book := range books {
		if book.Default {
			return true
		}
	}
	return false
}

templ CardDAVBaseURLRequiredTooltip(hidden bool) {
	<span data-carddav-disabled-action class={ "inline-flex", templ.KV("!hidden", hidden) }>
		@tooltip.Tooltip() {
			@tooltip.Trigger(tooltip.TriggerProps{Class: "inline-flex"}) {
				<span class="inline-flex cursor-not-allowed" title={ i18n.T(ctx, "settings.contact_sync.base_url_first") }>
					{ children... }
				</span>
			}
			@tooltip.Content(tooltip.ContentProps{Position: tooltip.PositionTop, ShowArrow: true, Class: "max-w-56 px-3 py-1.5 text-center text-xs leading-relaxed"}) {
				{ i18n.T(ctx, "settings.contact_sync.base_url_first") }
			}
		}
	</span>
}

templ CardDAVAutodiscoverButton(accountID string, fieldsID string, statusID string) {
	@button.Button(button.Props{
		Variant: button.VariantOutline,
		Size:    button.SizeSm,
		Class:   "h-8 w-fit shrink-0 gap-1.5 border-primary/30 bg-primary/10 px-3 text-xs font-semibold text-primary shadow-sm hover:border-primary/45 hover:bg-primary/15 hover:text-primary dark:border-primary/35 dark:bg-primary/15 dark:hover:border-primary/55 dark:hover:bg-primary/20",
		Attributes: templ.Attributes{
			"data-carddav-discover":      "",
			"data-carddav-autodiscover": "true",
			"data-account-id":           accountID,
			"data-fields-id":            fieldsID,
			"data-status-id":            statusID,
		},
	}) {
		@icon.Search(icon.Props{Class: "size-3.5"})
		{ i18n.T(ctx, "settings.contact_sync.autodiscover") }
	}
}

templ CardDAVDiscoverAddressBooksButton(accountID string, fieldsID string, statusID string, baseURL string) {
	{{ disabled := strings.TrimSpace(baseURL) == "" }}
	<span data-carddav-base-url-action data-fields-id={ fieldsID } class="contents">
		<button type="button" data-carddav-enabled-action data-carddav-discover data-account-id={ accountID } data-fields-id={ fieldsID } data-status-id={ statusID } class={ "inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground hover:bg-accent", templ.KV("!hidden", disabled) }>
			@icon.Search(icon.Props{Class: "size-3.5"})
			{ i18n.T(ctx, "settings.contact_sync.discover_books") }
		</button>
		@CardDAVBaseURLRequiredTooltip(!disabled) {
			<button type="button" disabled class="pointer-events-none inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-muted-foreground opacity-50">
				@icon.Search(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "settings.contact_sync.discover_books") }
			</button>
		}
	</span>
}

templ CardDAVManualAddressBookButton(fieldsID string, baseURL string) {
	{{ disabled := strings.TrimSpace(baseURL) == "" }}
	<span data-carddav-base-url-action data-fields-id={ fieldsID } class="contents">
		<button type="button" data-carddav-enabled-action data-carddav-manual data-fields-id={ fieldsID } class={ "inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-foreground hover:bg-accent", templ.KV("!hidden", disabled) }>
