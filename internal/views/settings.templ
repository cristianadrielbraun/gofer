			<button type="button" disabled class="pointer-events-none inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-xs font-semibold text-muted-foreground opacity-50">
				@icon.Pencil(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "settings.contact_sync.manual_url") }
			</button>
		}
	</span>
}

templ AddAccountPostCreateStep(data models.EditAccountData) {
	{{ accountID := data.AccountID }}
	{{ isJMAP := data.Provider == providers.ProviderJMAP && !editAccountIsICloud(data) }}
	<div id="add-wizard-footer-step-4" data-wizard-footer-step="4" data-active="false" hx-swap-oob="outerHTML" class="hidden flex-wrap justify-end gap-2">
		// Done saves the contacts and finishes, without going on to the
		// calendar.
		<button type="button" data-on-click='["wizardServiceNext","$this","contacts","done"]' class="inline-flex items-center gap-1.5 rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-accent">
			@icon.Check(icon.Props{Class: "size-4"})
			{ i18n.T(ctx, "common.done") }
		</button>
		if data.ContactSync.Enabled {
			<button type="button" data-on-click='["wizardGo",5]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
				{ i18n.T(ctx, "common.next") }
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		} else {
			<button type="submit" form={ fmt.Sprintf("add-contact-sync-form-%s", accountID) } class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
				{ i18n.T(ctx, "common.next") }
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		}
	</div>
	<div id="add-wizard-footer-step-5" data-wizard-footer-step="5" data-active="false" hx-swap-oob="outerHTML" class="hidden flex-wrap justify-between gap-2">
		<button type="button" data-on-click='["wizardGo",4]' class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
			@icon.ArrowLeft(icon.Props{Class: "size-4"})
			{ i18n.T(ctx, "settings.wizard.back") }
		</button>
		<button type="button" data-on-click='["wizardServiceNext","$this","calendar","done"]' class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
			@icon.Check(icon.Props{Class: "size-4"})
			{ i18n.T(ctx, "common.done") }
		</button>
	</div>
	<div id="add-calendar-content" hx-swap-oob="innerHTML">
		@CalendarSyncSettings(data)
	</div>
	@AccountWizardSectionSwitch("wizardGo", accountID, "calendar", data.CalendarSync.Enabled, false, false, true, nil)
	<div class="flex h-full flex-col pt-1">
		<div class="account-wizard-scroll space-y-5">
		<div data-add-account-created hidden></div>
		<div data-wizard-service-content="contacts" class="space-y-5">
		<h4 class="account-wizard-sticky-header text-sm font-semibold text-foreground flex items-center gap-2">
			@icon.BookUser(icon.Props{Class: "size-4 text-muted-foreground"})
			{ i18n.T(ctx, "settings.contact_sync.title") }
		</h4>
		if data.ContactSync.Enabled {
			<div class="rounded-lg border border-border bg-background/45 p-4" data-add-account-contacts-kept>
				<p class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "settings.contact_sync.already") }</p>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.already_hint") }</p>
			</div>
		} else {
			<form id={ fmt.Sprintf("add-contact-sync-form-%s", accountID) } data-wizard-contact-form data-wizard-next-step="5" hx-post={ fmt.Sprintf("/api/accounts/%s/contacts/sync", accountID) } hx-target={ fmt.Sprintf("#add-contact-sync-status-%s", accountID) } hx-swap="innerHTML" class="rounded-lg border border-border bg-background/45 p-4">
				<div class="mb-3 flex items-start justify-between gap-4">
					<div class="min-w-0">
						<h4 class="flex items-center gap-2 text-sm font-semibold text-foreground">
							@icon.BookUser(icon.Props{Class: "size-4 text-muted-foreground"})
							{ i18n.T(ctx, "settings.contact_sync.title") }
						</h4>
						if isJMAP {
							<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.add_jmap") }</p>
						} else {
							<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.add_carddav") }</p>
						}
					</div>
					<span class="shrink-0 rounded-full bg-muted px-2 py-0.5 text-[11px] font-semibold text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.optional") }</span>
				</div>
				<div id={ fmt.Sprintf("add-contact-sync-fields-%s", accountID) } class="space-y-3">
					<div class="grid gap-3 sm:grid-cols-2">
						if editAccountIsICloud(data) {
							<div class="sm:col-span-2">
								@ICloudContactsNotice()
							</div>
							@ICloudContactFields()
						} else {
						if isJMAP {
							@JMAPContactProtocolChoice(accountID, fmt.Sprintf("add-contact-sync-fields-%s", accountID), fmt.Sprintf("add-contact-sync-status-%s", accountID), true)
						}
						<div class={ "sm:col-span-2 grid gap-3 sm:grid-cols-2", templ.KV("hidden", isJMAP) } data-contact-protocol="carddav">
						<div class="sm:col-span-2">
							<div class="mb-1.5 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between">
								<label class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.base_url") }</label>
								@CardDAVAutodiscoverButton(accountID, fmt.Sprintf("add-contact-sync-fields-%s", accountID), fmt.Sprintf("add-contact-sync-status-%s", accountID))
							</div>
							@input.Input(input.Props{Name: "base_url", Type: input.TypeURL, Placeholder: "https://dav.example.com/"})
							<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
						</div>
						<label class="flex items-center gap-2 cursor-pointer sm:col-span-2">
							@checkbox.Checkbox(checkbox.Props{
								Name:       "use_account_credentials",
								Value:      "1",
								Checked:    true,
								Attributes: templ.Attributes{"data-on-change": onAction("toggleCardDAVAuth", actionElement)},
							})
							<span class="text-sm">{ i18n.T(ctx, "settings.contact_sync.same_credentials") }</span>
						</label>
						<div class="sm:col-span-2 grid gap-3 sm:grid-cols-2 opacity-50" data-carddav-credential-fields>
							<div>
								<label class="mb-1.5 block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.wizard.username") }</label>
								@input.Input(input.Props{Name: "username", Type: input.TypeText, Placeholder: i18n.T(ctx, "settings.contact_sync.same_as_incoming"), Disabled: true})
							</div>
							<div>
								<label class="mb-1.5 block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.password") }</label>
								@input.Input(input.Props{Name: "password", Type: input.TypePassword, Placeholder: i18n.T(ctx, "settings.contact_sync.same_as_incoming"), Disabled: true})
							</div>
						</div>
						</div>
						}
						<div class="hidden sm:col-span-2 rounded-md border border-border bg-background/35 px-3 py-2" data-carddav-addressbook-section data-carddav-manual-addressbook>
							<label class="mb-1.5 block text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "settings.contact_sync.exact_url") }</label>
							@input.Input(input.Props{Name: "addressbook_url", Type: input.TypeURL, Placeholder: "https://dav.example.com/addressbooks/user/default/"})
							<div data-server-check-url class="mt-1.5 hidden space-y-1" aria-live="polite"></div>
						</div>
					</div>
				</div>
				<div id={ fmt.Sprintf("add-contact-sync-status-%s", accountID) } class="mt-3 min-h-0"></div>
				<div class="mt-4 flex flex-wrap justify-end gap-2">
					if editAccountIsICloud(data) {
						@CardDAVDiscoverAddressBooksButton(accountID, fmt.Sprintf("add-contact-sync-fields-%s", accountID), fmt.Sprintf("add-contact-sync-status-%s", accountID), providers.ICloudCardDAVURL)
					} else {
						<span class={ templ.KV("contents", !isJMAP), templ.KV("hidden", isJMAP) } data-contact-protocol="carddav">
							@CardDAVDiscoverAddressBooksButton(accountID, fmt.Sprintf("add-contact-sync-fields-%s", accountID), fmt.Sprintf("add-contact-sync-status-%s", accountID), "")
							@CardDAVManualAddressBookButton(fmt.Sprintf("add-contact-sync-fields-%s", accountID), "")
						</span>
					}
				</div>
			</form>
		}
		</div>
		</div>
		<div class="account-wizard-controls flex flex-wrap justify-between gap-2">
			<button type="button" data-on-click='["wizardGo",2]' class="inline-flex items-center gap-1.5 rounded-md border border-border px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
				@icon.ArrowLeft(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.wizard.back") }
			</button>
			<button type="submit" form={ fmt.Sprintf("add-contact-sync-form-%s", accountID) } class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors">
				{ i18n.T(ctx, "common.next") }
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</button>
		</div>
	</div>
}

// AccountChangesSaved confirms that the edit wizard saved the mail changes.
templ AccountChangesSaved() {
	<div role="status" class="rounded-md border border-emerald-500/25 bg-emerald-500/10 px-3 py-2 text-xs text-emerald-800 dark:text-emerald-200">{ i18n.T(ctx, "settings.edit_account.saved") }</div>
}

func syncFolderDisplayName(f models.FolderSyncStatus) string {
	if remoteID := strings.TrimSpace(f.RemoteID); remoteID != "" {
		return remoteID
	}
	if name := strings.TrimSpace(f.Name); name != "" {
		return name
	}
	return f.Role
}

// syncFolderShortName shortens a folder nested more than one level to its
// top folder and its own name, such as "Trash/…/Nested three", so a deep
// folder fits its pill; the pill's tooltip has the whole path.
func syncFolderShortName(f models.FolderSyncStatus) string {
	full, name := syncFolderDisplayName(f), strings.TrimSpace(f.FolderName)
	cut := len(full) - len(name) - 1
	if name == "" || cut < 1 || !strings.HasSuffix(full, name) {
		return full
	}
	separator := full[cut : cut+1]
	top, rest, nested := strings.Cut(full[:cut], separator)
	if !nested || rest == "" {
		return full
	}
	return top + separator + "…" + separator + name
}

// syncFolderNeedsFullName reports whether the pill shortens the folder's
// name, or may cut it off, so its tooltip gives the whole path.
func syncFolderNeedsFullName(f models.FolderSyncStatus) bool {
	full := syncFolderDisplayName(f)
	return syncFolderShortName(f) != full || len([]rune(full)) > 32
}

func syncSettingsHasConfigurableFolderModes(settings models.SyncSettings) bool {
	for _, account := range settings.Accounts {
		if !syncSettingsAccountUsesProviderAPI(account.Provider) {
			return true
		}
	}
	return false
}

func syncSettingsAccountUsesProviderAPI(provider string) bool {
	switch strings.ToLower(strings.TrimSpace(provider)) {
	case "gmail", "outlook", providers.ProviderJMAP:
		return true
	default:
		return false
	}
}

func syncSettingsProviderAPITitle(ctx context.Context, provider string) string {
	if strings.EqualFold(strings.TrimSpace(provider), providers.ProviderJMAP) {
		return i18n.T(ctx, "settings.sync.api_title_jmap")
	}
	if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
		return i18n.T(ctx, "settings.sync.api_title_outlook")
	}
	return i18n.T(ctx, "settings.sync.api_title_gmail")
}

func syncSettingsProviderAPIDescription(ctx context.Context, provider string) string {
	if strings.EqualFold(strings.TrimSpace(provider), providers.ProviderJMAP) {
		return i18n.T(ctx, "settings.sync.api_description_jmap")
	}
	if strings.EqualFold(strings.TrimSpace(provider), "outlook") {
		return i18n.T(ctx, "settings.sync.api_description_outlook")
	}
	return i18n.T(ctx, "settings.sync.api_description_gmail")
}

// OutlookPushControl lets an Outlook account choose between Microsoft's
// change notifications and scheduled checks. Its own requests save the
// choice, so the sync form around it ignores its changes. The test button
// keeps its column while scheduled checks are chosen, so switching options
// doesn't reflow the descriptions.
templ OutlookPushControl(push models.OutlookPushSettings) {
	{{ id := "outlook-push-" + push.AccountID }}
	{{ usesPush := push.Enabled && push.Available }}
	<fieldset id={ id } class="rounded-md border border-border/70 bg-card/60 p-3" data-sync-autosave-ignore data-outlook-push={ push.AccountID }>
		<legend class="sr-only">{ i18n.T(ctx, "settings.outlook_push.legend") }</legend>
		<div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.sync.api_title_outlook") }</div>
		<div class="mt-3 flex items-start gap-4">
			<div class="min-w-0 flex-1 space-y-3">
				<div class={ templ.KV("opacity-60", !push.Available) }>
					<div class="flex min-h-8 flex-wrap items-center gap-x-2.5 gap-y-1">
						@radio.Radio(radio.Props{
							ID:         id + "-notifications",
							Name:       id,
							Value:      "true",
							Checked:    usesPush,
							Disabled:   !push.Available,
							Class:      "shrink-0",
							Attributes: outlookPushChoiceAttributes(push.AccountID, true),
						})
						<label for={ id + "-notifications" } class={ "text-sm font-medium", templ.KV("cursor-not-allowed", !push.Available) }>{ i18n.T(ctx, "settings.outlook_push.webhooks") }</label>
						if !push.Available {
							@outlookPushUnavailableNote(id+"-unavailable", push.Managed)
						}
						if usesPush {
							@outlookPushStatus(id, push)
						}
					</div>
					if push.Available {
						// Each subscription's state, kept in place while scheduled checks
						// are chosen so switching options doesn't move the card.
						<div class={ "flex min-h-6 flex-wrap items-center gap-x-3 gap-y-1 pl-[1.625rem] text-xs", templ.KV("invisible", !usesPush) } aria-hidden={ strconv.FormatBool(!usesPush) } data-outlook-push-services>
							@outlookPushServiceState(id+"-mail", i18n.T(ctx, "settings.reconnect.mail"), outlookPushMailState(push), outlookPushFailure(push))
							for _, service := range push.Services {
								@outlookPushServiceState(id+"-"+service.Service, outlookPushServiceLabel(ctx, service.Service), outlookPushServiceStateOf(service), outlookPushServiceFailure(service))
							}
						</div>
					}
					<p class="pl-[1.625rem] text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.outlook_push.webhooks_description") }</p>
				</div>
				<div>
					<div class="flex min-h-8 items-center gap-2.5">
						@radio.Radio(radio.Props{
							ID:         id + "-checks",
							Name:       id,
							Value:      "false",
							Checked:    !usesPush,
							Class:      "shrink-0",
							Attributes: outlookPushChoiceAttributes(push.AccountID, false),
						})
						<label for={ id + "-checks" } class="text-sm font-medium">{ i18n.T(ctx, "settings.outlook_push.scheduled") }</label>
					</div>
					<p class="pl-[1.625rem] text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.outlook_push.scheduled_description") }</p>
				</div>
			</div>
			if push.Available {
				@button.Button(button.Props{
					Variant:  button.VariantOutline,
					Size:     button.SizeSm,
					Class:    "shrink-0 group" + outlookPushHidden(!usesPush),
					Disabled: !usesPush,
					Attributes: templ.Attributes{
						"hx-post":         "/api/settings/accounts/" + push.AccountID + "/outlook-push/check",
						"hx-target":       "#" + id,
						"hx-swap":         "outerHTML",
						"hx-disabled-elt": "this",
						"aria-hidden":     strconv.FormatBool(!usesPush),
					},
				}) {
					@icon.RefreshCw(icon.Props{Class: "size-3.5 group-[.htmx-request]:animate-spin"})
					{ i18n.T(ctx, "settings.outlook_push.test") }
				}
			}
		</div>
	</fieldset>
}

// outlookPushStatus only says whether webhook notifications work, for every
// service the account is subscribed for, on the option's own line so
// switching options doesn't move the card.
templ outlookPushStatus(id string, push models.OutlookPushSettings) {
	{{ state := outlookPushOverall(push) }}
	<span class="inline-flex items-center gap-1 text-xs" role="status">
		if state == "working" {
			<span class="inline-flex items-center gap-1 text-emerald-700 dark:text-emerald-400">
				@icon.CircleCheck(icon.Props{Class: "size-3.5 shrink-0"})
				{ i18n.T(ctx, "settings.outlook_push.working") }
			</span>
		} else if state == "failing" {
			<span class="inline-flex items-center gap-1 text-destructive">
				@icon.CircleAlert(icon.Props{Class: "size-3.5 shrink-0"})
				{ i18n.T(ctx, "settings.outlook_push.not_working") }
			</span>
			@popover.Root(popover.RootProps{ID: id + "-failure", Class: "shrink-0"}) {
				@popover.Trigger() {
					<button
						type="button"
						class="inline-flex size-4 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
						aria-label={ i18n.T(ctx, "settings.outlook_push.why") }
					>
						@icon.Info(icon.Props{Class: "size-3.5"})
					</button>
				}
				@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, Offset: 8, ShowArrow: true, Class: "mobile-sheet w-80 p-3"}) {
					<div class="space-y-2 text-xs leading-relaxed text-muted-foreground">
						for _, failure := range outlookPushFailures(ctx, push) {
							<p class="text-foreground">{ failure }</p>
						}
						<p>{ i18n.T(ctx, "settings.outlook_push.reach_note") }</p>
					</div>
				}
			}
		} else {
			<span class="inline-flex items-center gap-1 text-muted-foreground" title={ i18n.T(ctx, "settings.outlook_push.starting_title") }>
				@icon.Clock(icon.Props{Class: "size-3.5 shrink-0"})
				{ i18n.T(ctx, "settings.outlook_push.starting") }
			</span>
		}
	</span>
}

// outlookPushServiceState is one service's subscription on the line under
// the webhook option, with Microsoft's reason when it fails.
templ outlookPushServiceState(id, label, state, failure string) {
	<span class="inline-flex items-center gap-1" data-outlook-push-service={ state }>
		switch state {
			case "working":
				<span class="inline-flex items-center gap-1 text-emerald-700 dark:text-emerald-400">
					@icon.CircleCheck(icon.Props{Class: "size-3.5 shrink-0"})
					{ label }
				</span>
			case "failing":
				<span class="inline-flex items-center gap-1 text-destructive">
					@icon.CircleAlert(icon.Props{Class: "size-3.5 shrink-0"})
					{ label }
				</span>
				@popover.Root(popover.RootProps{ID: id + "-failure", Class: "shrink-0"}) {
					@popover.Trigger() {
						<button
							type="button"
							class="inline-flex size-4 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
							aria-label={ i18n.T(ctx, "settings.outlook_push.why_service", "service", label) }
						>
							@icon.Info(icon.Props{Class: "size-3.5"})
						</button>
					}
					@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, Offset: 8, ShowArrow: true, Class: "mobile-sheet w-80 p-3"}) {
						<p class="text-xs leading-relaxed text-foreground">{ i18n.T(ctx, "settings.outlook_push.microsoft_says", "reason", failure) }</p>
					}
				}
			case "starting":
				<span class="inline-flex items-center gap-1 text-muted-foreground" title={ i18n.T(ctx, "settings.outlook_push.starting_title") }>
					@icon.Clock(icon.Props{Class: "size-3.5 shrink-0"})
					{ label }
				</span>
			default:
				<span class="inline-flex items-center gap-1 text-muted-foreground opacity-70" title={ i18n.T(ctx, "settings.outlook_push.not_synced_title", "service", label) }>
					@icon.Minus(icon.Props{Class: "size-3.5 shrink-0"})
					{ i18n.T(ctx, "settings.outlook_push.not_synced", "service", label) }
				</span>
		}
	</span>
}

templ outlookPushUnavailableNote(id string, managed bool) {
	@popover.Root(popover.RootProps{ID: id, Class: "shrink-0"}) {
		@popover.Trigger() {
			<button
				type="button"
				class="inline-flex size-4 items-center justify-center rounded-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
				aria-label={ i18n.T(ctx, "settings.outlook_push.why_unavailable") }
			>
				@icon.Info(icon.Props{Class: "size-3.5"})
			</button>
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomStart, Offset: 8, ShowArrow: true, Class: "mobile-sheet w-80 p-3"}) {
			if managed {
				<p class="text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.outlook_push.managed_off") }</p>
			} else {
				<div class="space-y-2 text-xs leading-relaxed text-muted-foreground">
					<p>{ i18n.T(ctx, "settings.outlook_push.off") }</p>
					<p>{ i18n.T(ctx, "settings.outlook_push.setup_1") }<code class="font-mono text-foreground">GOFER_OUTLOOK_WEBHOOKS=true</code>{ i18n.T(ctx, "settings.outlook_push.setup_2") }<code class="font-mono text-foreground">GOFER_BASE_URL</code>{ i18n.T(ctx, "settings.outlook_push.setup_3") }<code class="font-mono text-foreground">/webhooks/outlook</code>{ i18n.T(ctx, "settings.outlook_push.setup_4") }</p>
				</div>
			}
		}
	}
}

func outlookPushChoiceAttributes(accountID string, enabled bool) templ.Attributes {
	return templ.Attributes{
		"hx-post":    "/api/settings/accounts/" + accountID + "/outlook-push",
		"hx-trigger": "change",
		"hx-vals":    fmt.Sprintf(`{"enabled":"%t"}`, enabled),
		"hx-target":  "#outlook-push-" + accountID,
		"hx-swap":    "outerHTML",
	}
}

func outlookPushHidden(hidden bool) string {
	if hidden {
		return " invisible"
	}
	return ""
}

func outlookPushFailure(push models.OutlookPushSettings) string {
	if push.Checked {
		return push.CheckError
	}
	return push.Error
}

// outlookPushState is how one subscription is doing: "working", "failing",
// "starting" before Gofer has set it up, or "off" for a service the account
// doesn't sync, which isn't subscribed.
func outlookPushState(synced, subscribed bool, err string, checked bool, checkErr string) string {
	switch {
	case !synced:
		return "off"
	case checked && checkErr == "", !checked && subscribed:
		return "working"
	case checked, err != "":
		return "failing"
	}
	return "starting"
}

func outlookPushMailState(push models.OutlookPushSettings) string {
	return outlookPushState(true, push.Subscribed, push.Error, push.Checked, push.CheckError)
}

func outlookPushServiceStateOf(service models.OutlookPushServiceState) string {
	return outlookPushState(service.Synced, service.Subscribed, service.Error, service.Checked, service.CheckError)
}

func outlookPushServiceFailure(service models.OutlookPushServiceState) string {
	if service.Checked {
		return service.CheckError
	}
	return service.Error
}

func outlookPushServiceLabel(ctx context.Context, service string) string {
	if service == "calendar" {
		return i18n.T(ctx, "settings.wizard.calendar")
	}
	return i18n.T(ctx, "settings.wizard.contacts")
}

// outlookPushOverall is how webhook notifications are doing for the whole
// account: failing when any subscription fails, working when every one the
// account needs works, and starting otherwise.
func outlookPushOverall(push models.OutlookPushSettings) string {
	states := []string{outlookPushMailState(push)}
	for _, service := range push.Services {
		states = append(states, outlookPushServiceStateOf(service))
	}
	overall := "working"
	for _, state := range states {
		switch state {
		case "failing":
			return "failing"
		case "starting":
			overall = "starting"
		}
	}
	return overall
}

// outlookPushFailures are Microsoft's reasons for each subscription that
// fails, named by service.
func outlookPushFailures(ctx context.Context, push models.OutlookPushSettings) []string {
	var failures []string
	if outlookPushMailState(push) == "failing" {
		failures = append(failures, i18n.T(ctx, "settings.outlook_push.failure", "service", i18n.T(ctx, "settings.reconnect.mail"), "reason", outlookPushFailure(push)))
	}
	for _, service := range push.Services {
		if outlookPushServiceStateOf(service) == "failing" {
			failures = append(failures, i18n.T(ctx, "settings.outlook_push.failure", "service", outlookPushServiceLabel(ctx, service.Service), "reason", outlookPushServiceFailure(service)))
		}
	}
	return failures
}

templ AccountFormError(message string) {
	<div class="space-y-4" data-account-form-error>
		<div class="flex items-center gap-3 p-3 rounded-lg bg-destructive/10 border border-destructive/20">
			@icon.CircleAlert(icon.Props{Class: "size-5 text-destructive"})
			<p class="text-sm text-destructive">{ message }</p>
		</div>
		<div class="flex justify-end pt-2">
		<a href="/settings/accounts" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors px-3 py-1.5 rounded-md border border-border hover:bg-accent">
			@icon.ArrowLeft(icon.Props{Class: "size-4"})
			{ i18n.T(ctx, "settings.account.try_again") }
		</a>
		</div>
	</div>
}

templ ConnectionTestResults(results []models.ConnectionTestResult, accountID string, wizardType string) {
	<div class="space-y-3">
		<div class={ "grid grid-cols-1 gap-3", templ.KV("sm:grid-cols-2", len(results) > 1) }>
			for _, r := range results {
					<div class={
						"flex items-center gap-3 p-3 rounded-lg border",
						templ.KV("bg-emerald-500/10 border-emerald-500/25", r.Success),
						templ.KV("bg-destructive/10 border-destructive/20", !r.Success),
					}>
						if r.Success {
							@icon.Check(icon.Props{Class: "size-5 text-emerald-700 dark:text-emerald-300"})
						} else {
							@icon.X(icon.Props{Class: "size-5 text-destructive"})
						}
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2">
								<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ r.Service }</span>
								if r.Success {
									<span class="text-xs text-emerald-700 dark:text-emerald-300 font-medium">{ r.Message }</span>
							}
						</div>
						if !r.Success {
							<p class="text-xs text-destructive mt-0.5">{ r.Error }</p>
							<p class="text-xs text-muted-foreground mt-0.5">{ r.Message }</p>
						}
					</div>
				</div>
			}
		</div>
		for _, r := range results {
			if r.Success && r.Warning != "" {
				<div class="flex items-start gap-3 p-3 rounded-lg border bg-amber-500/10 border-amber-500/25" data-connection-test-warning>
					@icon.TriangleAlert(icon.Props{Class: "size-5 shrink-0 text-amber-700 dark:text-amber-300"})
					<p class="flex-1 min-w-0 text-xs leading-relaxed text-amber-800 dark:text-amber-200">{ r.Warning }</p>
				</div>
			}
		}
		if wizardType == "" {
			<button
				class="w-full inline-flex items-center justify-center gap-1.5 text-sm font-medium px-4 py-2 rounded-lg border border-border hover:bg-accent transition-colors"
				hx-post={ fmt.Sprintf("/api/accounts/%s/test", accountID) }
				hx-target="#test-results"
				hx-swap="outerHTML"
			>
				@icon.RefreshCw(icon.Props{Class: "size-4"})
				{ i18n.T(ctx, "settings.account.retry") }
			</button>
		}
	</div>
}

func mailOperationKindLabel(ctx context.Context, operationType string) string {
	switch operationType {
	case models.MailOperationMessageMutation:
		return i18n.T(ctx, "settings.operations.type.message")
	case models.MailOperationLabelMutation:
		return i18n.T(ctx, "settings.operations.type.label")
	case models.MailOperationIMAPDraft, models.MailOperationProviderDraft:
		return i18n.T(ctx, "settings.operations.type.draft")
	case models.MailOperationSentCopy:
		return i18n.T(ctx, "settings.operations.type.sent_copy")
	default:
		return i18n.T(ctx, "settings.operations.type.other")
	}
}

func mailOperationStateLabel(ctx context.Context, operation models.MailOperationSummary) string {
	if operation.State == "blocked" {
		return i18n.T(ctx, "settings.operations.state.blocked")
	}
	if operation.Ambiguous {
		return i18n.T(ctx, "settings.operations.state.reconcile")
	}
	if operation.CanRetry {
		return i18n.T(ctx, "settings.operations.state.failed")
	}
	switch operation.State {
	case "failed":
		return i18n.T(ctx, "settings.operations.state.failed")
	case "pending":
		return i18n.T(ctx, "settings.operations.state.queued")
	case "processing", "syncing", "sent_copy_copying":
		return i18n.T(ctx, "settings.operations.state.in_progress")
	case "sent_copy_pending":
		return i18n.T(ctx, "settings.operations.state.waiting_copy")
	default:
		return i18n.T(ctx, "settings.operations.state.waiting")
	}
}

func mailOperationTargetLabel(operation models.MailOperationSummary) string {
	parts := make([]string, 0, 3)
	if operation.Operation != "" {
		parts = append(parts, strings.ReplaceAll(operation.Operation, "_", " "))
	}
	if operation.LabelName != "" {
		parts = append(parts, "“"+operation.LabelName+"”")
	}
	if operation.FolderName != "" {
		if operation.DestinationFolderName != "" {
			parts = append(parts, operation.FolderName+" → "+operation.DestinationFolderName)
		} else {
			parts = append(parts, operation.FolderName)
		}
	}
	if len(parts) == 0 && operation.DraftKey != "" {
		return operation.DraftKey
	}
	return strings.Join(parts, " · ")
}

func mailOperationTimeLabel(ctx context.Context, value time.Time) string {
	if value.IsZero() {
		return i18n.T(ctx, "settings.operations.not_scheduled")
	}
	return i18n.Dates(ctx).ShortDateTime(value.Local())
}

func mailOperationActionLabel(ctx context.Context, operation models.MailOperationSummary) string {
	if operation.CanReconcile {
		return i18n.T(ctx, "settings.operations.reconcile_now")
	}
	return i18n.T(ctx, "settings.operations.retry_now")
}

templ SettingsOperationsTab() {
	<div class="mt-6 space-y-6">
		<div class="settings-card bg-card rounded-lg border p-6">
			<div class="flex items-start gap-3">
				<div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-background text-muted-foreground">
					@icon.ClipboardList(icon.Props{Class: "size-4"})
				</div>
				<div>
					<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.operations.title") }</h3>
					<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "settings.operations.description") }</p>
				</div>
			</div>
		</div>
		<div id="mail-operations-content" hx-get="/settings/operations/content" hx-trigger="load" hx-swap="outerHTML" class="settings-card rounded-lg border bg-card p-6 text-sm text-muted-foreground">
			{ i18n.T(ctx, "settings.operations.loading") }
		</div>
	</div>
}

// mailOperationsRefreshSeconds is how often the list reloads itself; the page
// counts down to it.
const mailOperationsRefreshSeconds = 15

// SettingsOperationsContent is the list of mail operations. It reloads itself
// when the countdown in settings.js reaches zero, or when Refresh is pressed;
// either way the whole block is replaced and the countdown starts again.
templ SettingsOperationsContent(status models.MailOperationsStatus) {
	<div
		id="mail-operations-content"
		hx-get="/settings/operations/content"
		hx-trigger="mail-operations-refresh"
		hx-swap="outerHTML"
		class="settings-card rounded-lg border bg-card p-6 space-y-4"
		data-mail-operations-refresh={ strconv.Itoa(mailOperationsRefreshSeconds) }
	>
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "settings.operations.background") }</h3>
				<p class="mt-1 text-xs text-muted-foreground">{ i18n.N(ctx, "settings.operations.total", status.Total) }</p>
			</div>
			<div class="flex flex-wrap items-center justify-end gap-2">
				if status.ActionRequired > 0 {
					<span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-amber-500/25 bg-amber-500/10 px-2 py-1 text-[11px] font-semibold text-amber-800 dark:text-amber-200">
						@icon.TriangleAlert(icon.Props{Class: "size-3.5"})
						{ i18n.N(ctx, "settings.operations.attention", status.ActionRequired) }
					</span>
				}
				<span class="text-[11px] tabular-nums text-muted-foreground" aria-live="off" data-mail-operations-countdown>
					{ i18n.T(ctx, "settings.operations.countdown", "seconds", mailOperationsRefreshSeconds) }
				</span>
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "h-7 gap-1.5 px-2.5 text-xs",
					Attributes: templ.Attributes{
						"type":                "button",
						"hx-get":              "/settings/operations/content",
						"hx-target":           "#mail-operations-content",
						"hx-swap":             "outerHTML",
						"hx-disabled-elt":     "this",
						"data-mail-operations-refresh-now": "",
					},
				}) {
					@icon.RefreshCw(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "settings.operations.refresh") }
				}
			</div>
		</div>
		if len(status.Operations) == 0 {
			<div class="rounded-md border border-dashed border-border px-4 py-8 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "settings.operations.empty") }</div>
		} else {
			<div class="space-y-2">
				for _, operation := range status.Operations {
					<div class={
						"settings-item rounded-lg border bg-background/40 p-4",
						templ.KV("border-amber-500/25", operation.CanRetry || operation.CanReconcile),
						templ.KV("border-border/60", !operation.CanRetry && !operation.CanReconcile),
					} data-mail-operation-id={ operation.ID }>
						<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
							<div class="min-w-0">
								<div class="flex flex-wrap items-center gap-2">
									<span class="text-sm font-semibold text-foreground">{ mailOperationKindLabel(ctx, operation.Type) }</span>
									<span class={
										"rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider",
										templ.KV("border-amber-500/25 bg-amber-500/10 text-amber-800 dark:text-amber-200", operation.CanRetry || operation.CanReconcile),
										templ.KV("border-border bg-card text-muted-foreground", !operation.CanRetry && !operation.CanReconcile),
									}>{ mailOperationStateLabel(ctx, operation) }</span>
								</div>
								<div class="mt-1 text-xs text-muted-foreground">
									{ operation.AccountEmail }
									if mailOperationTargetLabel(operation) != "" {
										<span> · { mailOperationTargetLabel(operation) }</span>
									}
								</div>
								if operation.LastError != "" {
									<div class="mt-2 rounded-md border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs leading-relaxed text-red-800 dark:text-red-200">
										{ operation.LastError }
										// Once a folder is chosen, Retry files the copy there.
										if strings.Contains(operation.LastError, models.NoSentFolderError) {
											<a href={ templ.SafeURL("/settings/accounts?folder_roles=" + url.QueryEscape(operation.AccountID)) } class="ml-1 font-semibold underline underline-offset-2" data-mail-operation-choose-sent>{ i18n.T(ctx, "settings.operations.choose_sent") }</a>
										}
									</div>
								}
								<div class="mt-2 text-[11px] text-muted-foreground">
									{ i18n.T(ctx, "settings.operations.attempt", "attempt", operation.Attempts, "time", mailOperationTimeLabel(ctx, operation.NextRetryAt)) }
								</div>
							</div>
							<div class="flex shrink-0 items-center gap-2">
								if operation.CanRetry || operation.CanReconcile {
									<button type="button" data-mail-operation-retry data-mail-operation-id={ operation.ID } class="inline-flex items-center gap-1.5 rounded-md border border-border bg-card px-3 py-1.5 text-xs font-semibold text-foreground transition-colors hover:bg-accent">
										@icon.RefreshCw(icon.Props{Class: "size-3.5"})
										{ mailOperationActionLabel(ctx, operation) }
									</button>
								}
							</div>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

