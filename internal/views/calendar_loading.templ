package views

import "github.com/cristianadrielbraun/gofer/internal/models"

// Inert templates reuse the real layout, including saved widths and timezone.
// They stay outside the HTMX/history targets so switching apps needs no fetch.
templ CalendarLoadingTemplates(accounts []models.Account, uiSettings map[string]string) {
	for _, view := range []string{"month", "week"} {
		{{ data := calendarLoadingData(view, uiSettings) }}
		<template id={ "calendar-loading-" + view }>
			@CalendarMainPane(data, uiSettings)
			@CalendarAgendaPane(data)
			if view == "month" {
				@CalendarSidebarContent(accounts, true)
				<div id="sidebar-sync-controls" inert aria-busy="true">
					@SidebarSyncControls(accounts, "calendar")
				</div>
			}
		</template>
	}
}

templ CalendarSkeletonBar(class string) {
	<span class={ "calendar-skeleton inline-block shrink-0 rounded bg-muted", class } aria-hidden="true"></span>
}

templ CalendarMonthDaySkeleton() {
	<div class="pointer-events-none relative mt-0.5 flex min-h-0 flex-1 flex-col gap-1 overflow-hidden sm:mt-1" data-calendar-loading-events aria-hidden="true">
		for index := 0; index < 2; index++ {
			<div class="flex h-[20.5px] w-full min-w-0 shrink-0 items-center gap-1.5 overflow-hidden rounded bg-primary/[0.06] px-1.5 py-1 text-[10px] leading-tight">
				@CalendarSkeletonBar("size-1.5 rounded-full")
				@CalendarSkeletonBar("h-[10px] w-6")
				@CalendarSkeletonBar("h-[10px] min-w-0 flex-1 shrink")
			</div>
		}
	</div>
}

templ CalendarAgendaEventSkeleton(index int) {
	<div class="relative w-full rounded-xl border border-border bg-card px-3.5 py-3 text-left shadow-sm" data-calendar-loading-agenda-event aria-hidden="true">
		<div class="flex items-start gap-3">
			<div class="calendar-skeleton size-9 shrink-0 rounded-lg bg-muted"></div>
			<div class="min-w-0 flex-1">
				<div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
					<div class="flex h-5 min-w-0 items-center gap-2 text-sm leading-5">
						@CalendarSkeletonBar("size-2 rounded-full")
						if index%2 == 0 {
							@CalendarSkeletonBar("h-3.5 w-28 max-w-full")
						} else {
							@CalendarSkeletonBar("h-3.5 w-36 max-w-full")
						}
					</div>
					<span class="inline-flex h-[16.5px] shrink-0 items-center text-[11px]">@CalendarSkeletonBar("h-[11px] w-14")</span>
				</div>
				<p class="mt-1 flex h-4 items-center text-xs">@CalendarSkeletonBar("h-3 w-24 max-w-full")</p>
				<p class="mt-1 flex h-[16.5px] items-center text-[11px]">@CalendarSkeletonBar("h-[11px] w-36 max-w-full")</p>
			</div>
		</div>
	</div>
}

templ CalendarWeekEventSkeleton() {
	<div class="flex min-w-0 items-center gap-1 text-[10px] leading-tight">
		@CalendarSkeletonBar("size-1.5 rounded-full")
		@CalendarSkeletonBar("h-[10px] min-w-0 flex-1 shrink")
	</div>
	<p class="mt-0.5 flex h-[12.5px] items-center" data-calendar-week-event-time>@CalendarSkeletonBar("h-2 w-3/5")</p>
}
