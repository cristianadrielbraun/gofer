package views

import "github.com/cristianadrielbraun/gofer/internal/models"

// Inert templates reuse the real layout, including saved widths and timezone.
// They stay outside the HTMX/history targets so switching apps needs no fetch.
// AppSwitchEmptyPaneTemplates hold the read pane Mail and Contacts show with
// nothing open. Switching to a section with nothing to open shows this at
// once instead of a loading placeholder. The wolf waits here too, for the
// mail one's icon to let it out.
templ AppSwitchEmptyPaneTemplates() {
	<template id="mail-view-empty">
		@MailViewEmpty()
	</template>
	<template id="mail-wolf">
		@MailWolf()
	</template>
	<template id="contacts-view-empty">
		@ContactsDetail(nil, nil, false, false, nil)
	</template>
}

templ CalendarLoadingTemplates(accounts []models.Account, uiSettings map[string]string) {
	<template id="calendar-event-loading">
		@CalendarEventLoadingDialog()
	</template>
	for _, view := range []string{"month", "week"} {
		{{ data := calendarLoadingData(view, uiSettings) }}
		<template id={ "calendar-loading-" + view }>
			@CalendarMainPane(data, uiSettings)
			@CalendarAgendaPane(data)
			if view == "month" {
				@CalendarSidebarContent(accounts, true)
				<div id="sidebar-sync-controls" inert aria-busy="true">
					@SidebarSyncControls(accounts, "calendar")
				</div>
			}
		</template>
	}
}
