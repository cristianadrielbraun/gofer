package views

import (
	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// MailCalendarSidebar is the calendar beside Mail. It loads the month from the
// calendar cache once it is on screen, so Mail never waits for it and phones,
// which don't show it, never load it.
templ MailCalendarSidebar() {
	<div
		id="mail-calendar-sidebar-slot"
		class="mail-calendar-shell"
		data-mail-calendar-shell
		data-open="true"
		data-mail-calendar-hide-label={ i18n.T(ctx, "calendar.mail_sidebar.hide") }
		data-mail-calendar-show-label={ i18n.T(ctx, "calendar.mail_sidebar.show") }
	>
		@button.Button(button.Props{
			Variant: button.VariantOutline,
			Class:   "mail-calendar-toggle h-8 w-6 rounded-r-none border-r-0 bg-background px-0 text-muted-foreground shadow-none hover:bg-accent hover:text-foreground dark:border-border dark:bg-background dark:hover:bg-accent",
			Attributes: templ.Attributes{
				"data-mail-calendar-toggle": "",
				"aria-label":                i18n.T(ctx, "calendar.mail_sidebar.hide"),
				"aria-expanded":             "true",
				"aria-controls":             "mail-calendar-sidebar-content",
				"title":                     i18n.T(ctx, "calendar.mail_sidebar.toggle"),
			},
		}) {
			<span class="mail-calendar-toggle-icon inline-flex" data-mail-calendar-toggle-icon>
				@icon.ChevronRight(icon.Props{Class: "size-4"})
			</span>
		}
		<div
			class="mail-calendar-grip"
			data-mail-calendar-grip
			role="separator"
			tabindex="0"
			aria-label={ i18n.T(ctx, "calendar.mail_sidebar.resize") }
			aria-orientation="vertical"
			aria-valuemin="260"
			aria-valuemax="450"
			aria-valuenow="300"
		></div>
		<aside
			class="mail-calendar-aside flex min-h-0 flex-col border-l border-border bg-background surface-desk max-2xl:shadow-xl"
			aria-label={ i18n.T(ctx, "calendar.mail_sidebar.label") }
			data-mail-calendar-sidebar
		>
			<div
				id="mail-calendar-sidebar-content"
				class="min-h-0 flex-1 flex items-center justify-center text-xs text-muted-foreground"
				hx-get="/calendar?view=month&cache=1"
				hx-trigger="intersect once"
				hx-target="this"
				hx-swap="outerHTML"
				role="status"
			>
				{ i18n.T(ctx, "calendar.loading") }
			</div>
		</aside>
	</div>
}

// MailCalendarSidebarContent is the month and the picked day's events. It uses
// the Calendar page's arrows, day dots and agenda cards, so it follows each
// style the same way.
templ MailCalendarSidebarContent(month CalendarMonthData) {
	{{ selected := mailSidebarSelectedDay(month) }}
	{{ events := mailSidebarDayEvents(selected, month.Events) }}
	<div id="mail-calendar-sidebar-content" class="min-h-0 flex-1 flex flex-col overflow-hidden">
		<header class="flex shrink-0 items-center justify-between gap-2 border-b border-border px-4 py-3">
			<h2 class="min-w-0 truncate text-base font-bold tracking-tight" style="font-family: var(--font-serif)">{ calendarPeriodLabel(ctx, month) }</h2>
			<div class="flex shrink-0 items-center gap-1.5">
				@button.Button(button.Props{Variant: button.VariantOutline, Href: mailSidebarURL(month.TodayDateKey), Class: "h-8 px-2.5 text-xs font-semibold text-foreground " + raisedButtonClass, Attributes: mailSidebarLinkAttributes(month.TodayDateKey)}) {
					{ i18n.T(ctx, "calendar.today") }
				}
				@calendarArrowPair(
					mailSidebarArrowAttributes(month.PreviousMonthKey+"-01", i18n.T(ctx, "calendar.nav.previous_month")),
					mailSidebarArrowAttributes(month.NextMonthKey+"-01", i18n.T(ctx, "calendar.nav.next_month")),
				)
			</div>
		</header>
		<div class="shrink-0 border-b border-border px-3 py-3">
			<div class="grid grid-cols-7 gap-1 text-center">
				if len(month.Weeks) > 0 {
					for _, day := range month.Weeks[0].Days {
						<span class="pb-1 text-[10px] font-bold uppercase tracking-[0.14em] text-muted-foreground">{ i18n.Dates(ctx).WeekdayShortName(day.Date.Weekday()) }</span>
					}
				}
				for _, week := range month.Weeks {
					for _, day := range week.Days {
						<a href={ templ.SafeURL(mailSidebarURL(day.ISODate)) } { mailSidebarLinkAttributes(day.ISODate)... } class={ mailSidebarDayClass(day, selected.ISODate) } aria-current={ mailSidebarDayCurrent(day) } aria-label={ calendarDayLabel(ctx, day) } data-mail-calendar-day>
							<span>{ day.DayNumber }</span>
							@CalendarDayDots(calendarEventsForDay(day, month.Events))
						</a>
					}
				}
			</div>
		</div>
		<div class="min-h-0 flex-1 overflow-y-auto px-4 py-4">
			<p class="text-[10px] font-bold uppercase tracking-[0.18em] text-muted-foreground">{ i18n.T(ctx, "calendar.agenda.title") }</p>
			<h3 class="mb-3 mt-1 text-sm font-bold tracking-tight text-foreground">{ i18n.Dates(ctx).LongDate(selected.Date) }</h3>
			if len(events) == 0 {
				<div class="py-6 text-center">
					@calendarAgendaEmptyGlyph()
					<p class="mt-3 text-sm font-semibold text-foreground">{ i18n.T(ctx, "calendar.agenda.no_events") }</p>
					<p class="mx-auto mt-1 max-w-xs text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "calendar.agenda.empty_day") }</p>
				</div>
			} else {
				<div class="space-y-2">
					for _, event := range events {
						@CalendarAgendaEventCard(event, month.Month.Location(), true)
					}
				</div>
			}
		</div>
	</div>
}

templ mailCalendarSidebarSlot(enabled bool) {
	if enabled {
		@MailCalendarSidebar()
	} else {
		<div id="mail-calendar-sidebar-slot" hidden></div>
	}
}
