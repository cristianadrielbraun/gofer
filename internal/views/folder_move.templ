package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/models"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
)

// FolderMoveDialog picks where a folder moves to inside its account: the
// top, or another folder, in the folder picker the Move dialog uses. The
// folder itself and the folders inside it can't be picked, nor the place
// it's in now. Clicking a row selects it; Move does the move (app.js).
templ FolderMoveDialog(data models.FolderMoveData) {
	{{ inside := folderMoveSubtree(data.Folders, data.FolderID) }}
	{{ account := data.Account }}
	{{ account.Folders = data.Folders }}
	{{ accountName := i18n.AccountName(ctx, data.Account.Provider, data.Account.Name) }}
	@dialog.Dialog(dialog.Props{ID: "folder-move-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: folderPickerContentClass}) {
			@dialog.Header(dialog.HeaderProps{Class: "shrink-0 px-6 pt-6 pb-4"}) {
				@dialog.Title() {
					{ i18n.T(ctx, "folders.move.title", "name", data.FolderName) }
				}
				@dialog.Description(dialog.DescriptionProps{Class: folderPickerDescriptionClass}) {
					{ i18n.T(ctx, "folders.move.description") }
				}
				@folderPickerSearch(i18n.T(ctx, "mail.move.search"), templ.Attributes{
					"data-folder-move-search": "",
					"data-on-input":           onAction("filterFolderMoveTargets", actionElement),
				})
			}
			@folderPickerList(i18n.T(ctx, "mail.move.no_match"), templ.Attributes{
				"role":                         "listbox",
				"aria-label":                   i18n.T(ctx, "mail.move.folders"),
				"data-folder-move-list":        "",
				"data-folder-move-id":          data.FolderID,
				"data-folder-move-account":     data.Account.ID,
				"data-folder-move-name":        data.FolderName,
				"data-folder-move-account-name": accountName,
			}) {
				@folderPickerAccount(account, "") {
					// The top of the account isn't a folder, so it stays while
					// searching.
					@folderMoveRow("", accountName, 0, data.ParentID == "", false, templ.Attributes{"data-folder-picker-keep": ""}) {
						<span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
							@icon.FolderRoot(icon.Props{Class: "size-4"})
						</span>
						<span class="min-w-0 flex-1 truncate text-sm">{ i18n.T(ctx, "folders.move.top") }</span>
					}
					for _, entry := range folderPickerEntries(ctx, account, false) {
						<div data-folder-picker-row data-search-text={ entry.Search }>
							@folderMoveRow(entry.Folder.ID, i18n.FolderName(ctx, entry.Folder.Role, entry.Folder.Name), entry.Depth, entry.Folder.ID == data.ParentID, inside[entry.Folder.ID], nil) {
								@folderPickerName(entry)
							}
						</div>
					}
				}
			}
			@dialog.Footer(dialog.FooterProps{Class: "shrink-0 px-6 py-4"}) {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						{ i18n.T(ctx, "common.cancel") }
					}
				}
				@button.Button(button.Props{
					Class:      "gap-1.5",
					Disabled:   true,
					Attributes: templ.Attributes{"data-folder-move-confirm": "", "data-on-click": onAction("confirmFolderMove")},
				}) {
					@icon.FolderInput(icon.Props{Class: "size-4"})
					{ i18n.T(ctx, "mail.move.confirm") }
				}
			}
		}
	}
}

// folderMoveRow is one place the folder can move to; parentID "" is the
// top of the account, and name is what the moved toast calls it. The
// current place says so, and neither it nor the folder's own branch can be
// picked.
templ folderMoveRow(parentID, name string, depth int, current, inside bool, attrs templ.Attributes) {
	<button
		type="button"
		role="option"
		aria-selected="false"
		disabled?={ current || inside }
		class="flex w-full min-w-0 items-center gap-2.5 py-1.5 pr-6 text-left enabled:hover:bg-accent/50 aria-selected:bg-primary/10 aria-selected:text-primary disabled:cursor-default disabled:opacity-50"
		style={ folderPickerIndent(depth) }
		data-folder-move-parent={ parentID }
		data-folder-move-place={ name }
		data-on-click={ onAction("selectFolderMoveTarget", actionElement) }
		{ attrs... }
	>
		{ children... }
		if current {
			<span class="shrink-0 text-[11px] text-muted-foreground">{ i18n.T(ctx, "mail.move.current") }</span>
		}
	</button>
}

// folderMoveSubtree returns the IDs of the folder named and the folders
// inside it.
func folderMoveSubtree(folders []models.Folder, id string) map[string]bool {
	inside := map[string]bool{}
	var mark func([]models.Folder)
	mark = func(folders []models.Folder) {
		for _, folder := range folders {
			inside[folder.ID] = true
			mark(folder.Children)
		}
	}
	var find func([]models.Folder) bool
	find = func(folders []models.Folder) bool {
		for _, folder := range folders {
			if folder.ID == id {
				inside[id] = true
				mark(folder.Children)
				return true
			}
			if find(folder.Children) {
				return true
			}
		}
		return false
	}
	find(folders)
	return inside
}
