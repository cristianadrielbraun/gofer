package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/models"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
)

// FolderMoveDialog picks where a folder moves to inside its account: the
// top, or another folder. The folder itself and the folders inside it
// can't be picked, nor the place it's in now. Clicking a row selects it;
// Move does the move (app.js).
templ FolderMoveDialog(data models.FolderMoveData) {
	{{ inside := folderMoveSubtree(data.Folders, data.FolderID) }}
	@dialog.Dialog(dialog.Props{ID: "folder-move-dialog"}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-md"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "folders.move.title", "name", data.FolderName) }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "folders.move.description") }
				}
			}
			<div
				class="h-[50vh] max-h-96 overflow-y-auto rounded-md border border-border bg-muted/50 p-1"
				role="listbox"
				aria-label={ i18n.T(ctx, "mail.move.folders") }
				data-folder-move-list
				data-folder-move-id={ data.FolderID }
				data-folder-move-account={ data.Account.ID }
				data-folder-move-name={ data.FolderName }
				data-folder-move-account-name={ i18n.AccountName(ctx, data.Account.Provider, data.Account.Name) }
			>
				@folderMoveRow("", 0, data.ParentID == "", false) {
					<span class="flex size-5 shrink-0 items-center justify-center">
						<span class="account-color-marker size-2.5" style={ accountColorStyle(data.Account.Color) }></span>
					</span>
					<span class="flex-1 truncate font-medium">{ i18n.AccountName(ctx, data.Account.Provider, data.Account.Name) }</span>
				}
				for _, target := range mailMoveTargets(data.Folders) {
					@folderMoveRow(target.Folder.ID, target.Depth+1, target.Folder.ID == data.ParentID, inside[target.Folder.ID]) {
						<span class="flex size-5 shrink-0 items-center justify-center text-muted-foreground">
							@FolderAppearanceIcon(target.Folder)
						</span>
						<span class="flex-1 truncate">{ i18n.FolderName(ctx, target.Folder.Role, target.Folder.Name) }</span>
					}
				}
			</div>
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Class: "h-8 px-3 text-xs"}) {
						{ i18n.T(ctx, "common.cancel") }
					}
				}
				@button.Button(button.Props{
					Class:      "h-8 gap-1.5 px-3 text-xs",
					Disabled:   true,
					Attributes: templ.Attributes{"data-folder-move-confirm": "", "data-on-click": onAction("confirmFolderMove")},
				}) {
					@icon.FolderInput(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "mail.move.confirm") }
				}
			}
		}
	}
}

// folderMoveRow is one place the folder can move to; parentID "" is the
// top of the account. The current place says so, and neither it nor the
// folder's own branch can be picked.
templ folderMoveRow(parentID string, depth int, current, inside bool) {
	<button
		type="button"
		role="option"
		aria-selected="false"
		disabled?={ current || inside }
		class="flex w-full min-w-0 items-center gap-2.5 rounded-md px-2.5 py-1.5 text-left text-sm enabled:hover:bg-accent enabled:hover:text-accent-foreground aria-selected:bg-primary/10 aria-selected:text-primary disabled:cursor-default disabled:opacity-50"
		style={ mailMoveIndent(depth) }
		data-folder-move-parent={ parentID }
		data-on-click={ onAction("selectFolderMoveTarget", actionElement) }
	>
		{ children... }
		if current {
			<span class="shrink-0 text-[11px] text-muted-foreground">{ i18n.T(ctx, "mail.move.current") }</span>
		}
	</button>
}

// folderMoveSubtree returns the IDs of the folder named and the folders
// inside it.
func folderMoveSubtree(folders []models.Folder, id string) map[string]bool {
	inside := map[string]bool{}
	var mark func([]models.Folder)
	mark = func(folders []models.Folder) {
		for _, folder := range folders {
			inside[folder.ID] = true
			mark(folder.Children)
		}
	}
	var find func([]models.Folder) bool
	find = func(folders []models.Folder) bool {
		for _, folder := range folders {
			if folder.ID == id {
				inside[id] = true
				mark(folder.Children)
				return true
			}
			if find(folder.Children) {
				return true
			}
		}
		return false
	}
	find(folders)
	return inside
}
