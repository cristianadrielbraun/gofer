package views

import (
	"fmt"

	"github.com/cristianadrielbraun/gofer/components/button"
)

type SetupTokenData struct {
	Message string
}

type SetupOwnerCandidateData struct {
	ID             string
	Name           string
	Email          string
	Username       string
	Status         string
	IsAdmin        bool
	MailboxCount   int64
	LegacySessions int64
}

type SetupOwnerFormData struct {
	Target   string
	Name     string
	Username string
	Email    string
	Errors   map[string]string
}

type SetupOwnerData struct {
	Kind       string
	Candidates []SetupOwnerCandidateData
	Form       SetupOwnerFormData
	DraftSaved bool
	DraftStale bool
	BlockedMessage string
}

type SetupPasswordData struct {
	PasswordReady bool
	Errors        map[string]string
}

type SetupMFAData struct {
	QRCodeDataURL string
	ManualKey    string
	Algorithm    string
	Digits       int
	Period       int
	TOTPReady    bool
	Errors       map[string]string
}

type SetupRecoveryData struct {
	BatchID      string
	Codes        []string
	Generated    bool
	Acknowledged bool
	Errors       map[string]string
}

func setupOwnerDescription(helpID, errorID string, hasError bool) string {
	if !hasError {
		return helpID
	}
	if helpID == "" {
		return errorID
	}
	return helpID + " " + errorID
}

templ SetupTokenPage(data SetupTokenData) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gofer — Initial Setup</title>
			@AppIcon()
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm">
					<div class="text-center mb-8">
						<img src="/assets/logo.svg" alt="Gofer" class="h-12 w-auto mx-auto"/>
						<h1 class="mt-6 text-2xl font-semibold">Set up Gofer</h1>
						<p class="mt-2 text-sm text-muted-foreground">Enter the private token shown on the machine running Gofer.</p>
					</div>
					if data.Message != "" {
						<div id="setup-token-error" role="alert" aria-live="polite" class="bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm mb-6">
							{ data.Message }
						</div>
					}
					<form method="post" action="/setup" class="space-y-4">
						<div class="space-y-2">
							<label for="setup-token" class="text-sm font-medium">Setup token</label>
							<input
								id="setup-token"
								name="token"
								type="password"
								autocomplete="one-time-code"
								autocapitalize="none"
								spellcheck="false"
								required
								autofocus
								if data.Message != "" {
									aria-invalid="true"
									aria-describedby="setup-token-error"
								}
								class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20"
							/>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							Continue securely
						}
					</form>
					<p class="mt-6 text-center text-xs text-muted-foreground">The token is sent only when you submit this form. It is never included in the page URL or saved by Gofer in browser storage.</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupOwnerPage(data SetupOwnerData) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gofer — Set Up Owner</title>
			@AppIcon()
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-2xl">
					<div class="text-center mb-8">
						<img src="/assets/logo.svg" alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">Setup access verified</p>
						if data.Kind == "fresh" {
							<h1 class="mt-2 text-2xl font-semibold">Create the first owner</h1>
							<p class="mt-2 text-sm text-muted-foreground">This installation has no Gofer users yet.</p>
						} else if data.Kind == "legacy_default" {
							<h1 class="mt-2 text-2xl font-semibold">Claim your existing Gofer data</h1>
							<p class="mt-2 text-sm text-muted-foreground">The legacy local user will become the real owner without changing its stable ID.</p>
						} else {
							<h1 class="mt-2 text-2xl font-semibold">Choose the Gofer owner</h1>
							<p class="mt-2 text-sm text-muted-foreground">Select an existing user explicitly, or create a separate owner.</p>
						}
					</div>
					if data.DraftSaved {
						<div role="status" aria-live="polite" class="mb-6 rounded-lg border border-success/25 bg-success/10 px-4 py-3">
							<p class="text-sm font-medium text-success">Owner profile ready for security enrollment</p>
							<p class="mt-1 text-xs text-muted-foreground">The encrypted draft is tied to this setup session. No user, role, credential, or owned data has been changed yet.</p>
						</div>
					}
					if data.DraftStale {
						<div role="alert" class="mb-6 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm">
							Existing users changed after this draft was saved. Review and save the owner selection again.
						</div>
					}
					if data.BlockedMessage != "" {
						<div role="alert" class="rounded-xl border border-destructive/25 bg-destructive/10 p-6">
							<h2 class="text-lg font-semibold">Owner setup needs local repair</h2>
							<p class="mt-2 text-sm text-muted-foreground">{ data.BlockedMessage }</p>
							<p class="mt-3 text-sm text-muted-foreground">Stop Gofer, run <code class="font-mono">gofer auth users list</code> locally, and resolve duplicate or excessive user records before rotating the setup token and trying again. Gofer will not guess an owner or merge records.</p>
						</div>
					}
					if data.BlockedMessage == "" {
						<form method="post" action="/setup/owner" class="space-y-6 rounded-xl border border-border bg-card p-6">
							if data.Form.Errors["form"] != "" {
								<p role="alert" class="rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.Form.Errors["form"] }</p>
							}
						if data.Kind == "fresh" {
							<input type="hidden" name="owner_target" value="create"/>
						} else if data.Kind == "legacy_default" {
							<input type="hidden" name="owner_target" value="existing:default"/>
							<div class="rounded-lg border border-border bg-muted/30 p-4">
								<p class="text-sm font-medium">Existing local data stays attached</p>
								<p class="mt-1 text-xs text-muted-foreground">Mail accounts, settings, contacts, messages, drafts, and queued operations keep using user ID <code class="font-mono">default</code>. Nothing is copied or reassigned.</p>
							</div>
						} else {
							<fieldset class="space-y-3" aria-describedby="owner-target-help">
								<legend class="text-sm font-medium">Owner target</legend>
								<p id="owner-target-help" class="text-xs text-muted-foreground">Selecting an existing user preserves every resource already attached to that exact user ID.</p>
								<label class="flex cursor-pointer gap-3 rounded-lg border border-border p-4">
									<input type="radio" name="owner_target" value="create" checked?={ data.Form.Target == "create" } required class="mt-1"/>
									<span><span class="block text-sm font-medium">Create a new owner</span><span class="mt-1 block text-xs text-muted-foreground">Existing users and their data remain unchanged.</span></span>
								</label>
								for _, candidate := range data.Candidates {
									<label class="flex cursor-pointer gap-3 rounded-lg border border-border p-4">
										<input type="radio" name="owner_target" value={ "existing:" + candidate.ID } checked?={ data.Form.Target == "existing:" + candidate.ID } required class="mt-1"/>
										<span class="min-w-0">
											if candidate.Name != "" {
												<span class="block text-sm font-medium">{ candidate.Name }</span>
											} else {
												<span class="block text-sm font-medium">Unnamed Gofer user</span>
											}
											<span class="mt-1 block break-all text-xs text-muted-foreground">{ candidate.Email } · ID <code class="font-mono">{ candidate.ID }</code></span>
											<span class="mt-1 block text-xs text-muted-foreground">
												{ fmt.Sprintf("%d mail accounts · %d legacy sessions · %s", candidate.MailboxCount, candidate.LegacySessions, candidate.Status) }
												if candidate.IsAdmin {
													· administrator
												} else {
													· standard user
												}
											</span>
										</span>
									</label>
								}
								if data.Form.Errors["target"] != "" {
									<p role="alert" class="text-sm text-destructive">{ data.Form.Errors["target"] }</p>
								}
							</fieldset>
						}
						<div>
							<h2 class="text-sm font-medium">Owner profile and login identifier</h2>
							if data.Kind == "fresh" {
								<p class="mt-1 text-xs text-muted-foreground">These values identify the first real Gofer user.</p>
							} else {
								<p class="mt-1 text-xs text-muted-foreground">For an existing target, these values replace its current profile only when final enrollment succeeds.</p>
							}
						</div>
						<div class="grid gap-4 sm:grid-cols-2">
							<div class="space-y-2 sm:col-span-2">
								<label for="owner-name" class="text-sm font-medium">Display name</label>
								<input id="owner-name" name="name" type="text" value={ data.Form.Name } autocomplete="name" maxlength="100" required aria-invalid={ fmt.Sprintf("%t", data.Form.Errors["name"] != "") } aria-describedby={ setupOwnerDescription("", "owner-name-error", data.Form.Errors["name"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
								if data.Form.Errors["name"] != "" {
									<p id="owner-name-error" role="alert" class="text-sm text-destructive">{ data.Form.Errors["name"] }</p>
								}
							</div>
							<div class="space-y-2">
								<label for="owner-username" class="text-sm font-medium">Username</label>
								<input id="owner-username" name="username" type="text" value={ data.Form.Username } autocomplete="username" autocapitalize="none" spellcheck="false" minlength="3" maxlength="32" required aria-invalid={ fmt.Sprintf("%t", data.Form.Errors["username"] != "") } aria-describedby={ setupOwnerDescription("owner-username-help", "owner-username-error", data.Form.Errors["username"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
								<p id="owner-username-help" class="text-xs text-muted-foreground">3–32 ASCII letters, numbers, periods, underscores, or hyphens.</p>
								if data.Form.Errors["username"] != "" {
									<p id="owner-username-error" role="alert" class="text-sm text-destructive">{ data.Form.Errors["username"] }</p>
								}
							</div>
							<div class="space-y-2">
								<label for="owner-email" class="text-sm font-medium">Email</label>
								<input id="owner-email" name="email" type="email" value={ data.Form.Email } autocomplete="email" maxlength="254" required aria-invalid={ fmt.Sprintf("%t", data.Form.Errors["email"] != "") } aria-describedby={ setupOwnerDescription("", "owner-email-error", data.Form.Errors["email"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
								if data.Form.Errors["email"] != "" {
									<p id="owner-email-error" role="alert" class="text-sm text-destructive">{ data.Form.Errors["email"] }</p>
								}
							</div>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							if data.DraftSaved {
								Save changes
							} else {
								Save owner profile
							}
						}
						if data.DraftSaved {
							<a href="/setup/password" class="flex h-9 w-full items-center justify-center rounded-md border border-border px-4 text-sm font-medium transition-colors hover:bg-accent">Continue to password</a>
						}
						<p class="text-center text-xs text-muted-foreground">Next, you will choose a sign-in credential and enroll the required administrator security factor.</p>
					</form>
					}
					<p class="mt-6 text-center text-xs text-muted-foreground">Setup access expires after ten minutes. The setup token remains active until final enrollment completes; rotating it discards this encrypted draft.</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupPasswordPage(data SetupPasswordData) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gofer — Set Owner Password</title>
			@AppIcon()
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-md">
					<div class="text-center mb-8">
						<img src="/assets/logo.svg" alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">Owner profile ready</p>
						<h1 class="mt-2 text-2xl font-semibold">Choose the owner password</h1>
						<p class="mt-2 text-sm text-muted-foreground">Use a unique passphrase that is not used for your email account or another service.</p>
					</div>
					if data.PasswordReady {
						<div role="status" aria-live="polite" class="mb-6 rounded-lg border border-success/25 bg-success/10 px-4 py-3">
							<p class="text-sm font-medium text-success">Owner password ready for final enrollment</p>
							<p class="mt-1 text-xs text-muted-foreground">Only its Argon2id hash is inside the encrypted setup draft. No credential or user has been created yet.</p>
						</div>
					}
					<form method="post" action="/setup/password" class="space-y-5 rounded-xl border border-border bg-card p-6">
						if data.Errors["form"] != "" {
							<p role="alert" class="rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.Errors["form"] }</p>
						}
						<div class="space-y-2">
							<label for="owner-password" class="text-sm font-medium">Password</label>
							<input id="owner-password" name="password" type="password" autocomplete="new-password" minlength="15" maxlength="256" required autofocus aria-invalid={ fmt.Sprintf("%t", data.Errors["password"] != "") } aria-describedby={ setupOwnerDescription("owner-password-help", "owner-password-error", data.Errors["password"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
							<p id="owner-password-help" class="text-xs text-muted-foreground">At least 15 characters. Common, compromised, and owner-specific passwords are rejected.</p>
							if data.Errors["password"] != "" {
								<p id="owner-password-error" role="alert" class="text-sm text-destructive">{ data.Errors["password"] }</p>
							}
						</div>
						<div class="space-y-2">
							<label for="owner-password-confirmation" class="text-sm font-medium">Confirm password</label>
							<input id="owner-password-confirmation" name="password_confirmation" type="password" autocomplete="new-password" minlength="15" maxlength="256" required aria-invalid={ fmt.Sprintf("%t", data.Errors["confirmation"] != "") } aria-describedby={ setupOwnerDescription("", "owner-password-confirmation-error", data.Errors["confirmation"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
							if data.Errors["confirmation"] != "" {
								<p id="owner-password-confirmation-error" role="alert" class="text-sm text-destructive">{ data.Errors["confirmation"] }</p>
							}
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							if data.PasswordReady {
								Replace prepared password
							} else {
								Save owner password
							}
						}
						<a href="/setup/owner" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Back to owner profile</a>
						<p class="text-center text-xs text-muted-foreground">Next, the owner must enroll administrator MFA and recovery codes before setup can complete.</p>
					</form>
					if data.PasswordReady {
						<form method="post" action="/setup/mfa" class="mt-4">
							<input type="hidden" name="action" value="start"/>
							@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
								Continue to authenticator setup
							}
						</form>
					}
					<p class="mt-6 text-center text-xs text-muted-foreground">Passwords are never echoed, logged, placed in URLs, or stored in browser storage.</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupMFAPage(data SetupMFAData) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gofer — Set Up Owner MFA</title>
			@AppIcon()
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-lg">
					<div class="text-center mb-8">
						<img src="/assets/logo.svg" alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">Password ready</p>
						<h1 class="mt-2 text-2xl font-semibold">Secure the owner account</h1>
						<p class="mt-2 text-sm text-muted-foreground">Add Gofer to an authenticator app, then confirm one current code.</p>
					</div>
					if data.TOTPReady {
						<div role="status" aria-live="polite" class="rounded-xl border border-success/25 bg-success/10 px-5 py-4">
							<p class="text-sm font-medium text-success">Authenticator verified for final enrollment</p>
							<p class="mt-1 text-xs text-muted-foreground">The encrypted setup draft now contains the seed and accepted time step. No authenticator, user, or session has been created yet.</p>
						</div>
						<div class="mt-4 rounded-xl border border-border bg-card p-5">
							<p class="text-sm font-medium">Next: recovery codes</p>
							<p class="mt-1 text-xs text-muted-foreground">Gofer will generate a single-use recovery batch and require acknowledgement before final setup can commit.</p>
						</div>
						<a href="/setup/recovery" class="mt-4 flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">Continue to recovery codes</a>
						<form method="post" action="/setup/mfa" class="mt-2">
							<input type="hidden" name="action" value="restart"/>
							<button type="submit" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Replace this authenticator setup</button>
						</form>
					} else {
						<div class="rounded-xl border border-border bg-card p-6">
							<div class="grid gap-6 sm:grid-cols-[auto_1fr] sm:items-center">
								<div class="rounded-lg bg-white p-3">
									<img src={ data.QRCodeDataURL } alt="QR code containing the Gofer authenticator setup key" width="192" height="192" class="h-48 w-48"/>
								</div>
								<div class="space-y-3">
									<div>
										<p class="text-sm font-medium">1. Scan the QR code</p>
										<p class="mt-1 text-xs text-muted-foreground">Use any RFC 6238-compatible authenticator app.</p>
									</div>
									<div>
										<p class="text-sm font-medium">Or enter this setup key</p>
										<code class="mt-2 block break-all rounded-md bg-muted px-3 py-2 font-mono text-xs" aria-label="Manual authenticator setup key">{ data.ManualKey }</code>
									</div>
									<p class="text-xs text-muted-foreground">{ data.Algorithm }, { fmt.Sprintf("%d digits", data.Digits) }, every { fmt.Sprintf("%d seconds", data.Period) }</p>
								</div>
							</div>
							<form method="post" action="/setup/mfa" class="mt-6 space-y-4">
								<input type="hidden" name="action" value="confirm"/>
								if data.Errors["form"] != "" {
									<p role="alert" class="rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.Errors["form"] }</p>
								}
								<div class="space-y-2">
									<label for="setup-mfa-code" class="text-sm font-medium">2. Enter the current six-digit code</label>
									<input id="setup-mfa-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required autofocus aria-invalid={ fmt.Sprintf("%t", data.Errors["code"] != "") } aria-describedby={ setupOwnerDescription("setup-mfa-code-help", "setup-mfa-code-error", data.Errors["code"] != "") } class="flex h-11 w-full rounded-md border border-input bg-background px-3 py-2 text-center font-mono text-lg tracking-[0.35em] outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
									<p id="setup-mfa-code-help" class="text-xs text-muted-foreground">Codes from the immediately previous or next 30-second window are accepted for small clock differences.</p>
									if data.Errors["code"] != "" {
										<p id="setup-mfa-code-error" role="alert" class="text-sm text-destructive">{ data.Errors["code"] }</p>
									}
								</div>
								@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
									Verify authenticator
								}
							</form>
							<form method="post" action="/setup/mfa" class="mt-2">
								<input type="hidden" name="action" value="restart"/>
								<button type="submit" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Generate a new setup key</button>
							</form>
						</div>
					}
					<a href="/setup/password" class="mt-4 flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Back to owner password</a>
					<p class="mt-6 text-center text-xs text-muted-foreground">The setup key is encrypted in the short-lived setup draft and is never sent to a third-party QR service.</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupRecoveryPage(data SetupRecoveryData) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gofer — Save Owner Recovery Codes</title>
			@AppIcon()
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-lg">
					<div class="text-center mb-8">
						<img src="/assets/logo.svg" alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">Authenticator verified</p>
						<h1 class="mt-2 text-2xl font-semibold">Save the owner recovery codes</h1>
						<p class="mt-2 text-sm text-muted-foreground">Each code can recover access once if the authenticator is unavailable.</p>
					</div>
					if data.Errors["form"] != "" {
						<p role="alert" class="mb-4 rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.Errors["form"] }</p>
					}
					if data.Acknowledged {
						<div role="status" aria-live="polite" class="rounded-xl border border-success/25 bg-success/10 px-5 py-4">
							<p class="text-sm font-medium text-success">Recovery codes acknowledged for final enrollment</p>
							<p class="mt-1 text-xs text-muted-foreground">Only the code hashes remain in the encrypted setup draft. No recovery credential or user has been created yet.</p>
						</div>
						<div class="mt-4 rounded-xl border border-border bg-card p-5">
							<p class="text-sm font-medium">Next: final setup review</p>
							<p class="mt-1 text-xs text-muted-foreground">The next step will review the owner and migration impact before anything is committed.</p>
						</div>
						<form method="post" action="/setup/recovery" class="mt-2">
							<input type="hidden" name="action" value="regenerate"/>
							<button type="submit" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Replace recovery codes</button>
						</form>
					} else if len(data.Codes) > 0 {
						<div role="alert" class="rounded-lg border border-warning/30 bg-warning/10 px-4 py-3">
							<p class="text-sm font-medium text-warning">These codes are shown only in this response</p>
							<p class="mt-1 text-xs text-muted-foreground">Copy them to a password manager or print this page now. Gofer cannot display this batch again.</p>
						</div>
						<div class="mt-4 grid gap-2 rounded-xl border border-border bg-card p-5 sm:grid-cols-2" aria-label="Owner recovery codes">
							for _, code := range data.Codes {
								<code class="select-all rounded-md bg-muted px-3 py-2 text-center font-mono text-sm tracking-wide">{ code }</code>
							}
						</div>
						@setupRecoveryAcknowledgement(data)
					} else if data.Generated {
						<div class="rounded-xl border border-border bg-card p-6">
							<p class="text-sm font-medium">Recovery codes were already shown</p>
							<p class="mt-1 text-xs text-muted-foreground">If you saved that batch, acknowledge it below. If not, generate a replacement; the current pending batch will no longer be usable.</p>
						</div>
						@setupRecoveryAcknowledgement(data)
					} else {
						<div class="rounded-xl border border-border bg-card p-6">
							<p class="text-sm font-medium">Create an offline fallback</p>
							<p class="mt-1 text-xs text-muted-foreground">Gofer will generate ten 120-bit pseudorandom codes locally. Their plaintext will appear once; only hashes enter the encrypted setup draft.</p>
							<form method="post" action="/setup/recovery" class="mt-5">
								<input type="hidden" name="action" value="generate"/>
								@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
									Generate recovery codes
								}
							</form>
						</div>
					}
					<a href="/setup/mfa" class="mt-4 flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Back to authenticator setup</a>
					<p class="mt-6 text-center text-xs text-muted-foreground">Recovery codes are never logged, placed in URLs, stored in browser storage, or retained as retrievable plaintext.</p>
				</div>
			</main>
		</body>
	</html>
}

templ setupRecoveryAcknowledgement(data SetupRecoveryData) {
	<form method="post" action="/setup/recovery" class="mt-4 space-y-4 rounded-xl border border-border bg-card p-5">
		<input type="hidden" name="action" value="acknowledge"/>
		<input type="hidden" name="batch_id" value={ data.BatchID }/>
		<label for="setup-recovery-saved" class="flex items-start gap-3 text-sm">
			<input id="setup-recovery-saved" name="saved" type="checkbox" value="yes" required aria-invalid={ fmt.Sprintf("%t", data.Errors["saved"] != "") } aria-describedby={ setupOwnerDescription("setup-recovery-saved-help", "setup-recovery-saved-error", data.Errors["saved"] != "") } class="mt-0.5 h-4 w-4 rounded border-input"/>
			<span>I saved these recovery codes somewhere secure and understand they cannot be displayed again.</span>
		</label>
		<p id="setup-recovery-saved-help" class="text-xs text-muted-foreground">This acknowledgement is bound to the exact current batch. Replacing the batch requires a new acknowledgement.</p>
		if data.Errors["saved"] != "" {
			<p id="setup-recovery-saved-error" role="alert" class="text-sm text-destructive">{ data.Errors["saved"] }</p>
		}
		@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
			Acknowledge saved recovery codes
		}
	</form>
	<form method="post" action="/setup/recovery" class="mt-2">
		<input type="hidden" name="action" value="regenerate"/>
		<button type="submit" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">Generate replacement codes</button>
	</form>
}
