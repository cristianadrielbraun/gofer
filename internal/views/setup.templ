package views

import (
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"fmt"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

type SetupTokenData struct {
	Message string
}

type SetupOwnerCandidateData struct {
	ID             string
	Name           string
	Username       string
	Status         string
	IsAdmin        bool
	MailboxCount   int64
	LegacySessions int64
}

type SetupOwnerFormData struct {
	Target   string
	Name     string
	Username string
	Errors   map[string]string
}

type SetupOwnerData struct {
	Kind       string
	Candidates []SetupOwnerCandidateData
	Form       SetupOwnerFormData
	DraftSaved bool
	DraftStale bool
	BlockedMessage string
}

type SetupPasswordData struct {
	PasswordReady bool
	Errors        map[string]string
}

type SetupMFAData struct {
	QRCodeDataURL string
	ManualKey    string
	Algorithm    string
	Digits       int
	Period       int
	TOTPReady    bool
	Errors       map[string]string
}

type SetupRecoveryData struct {
	BatchID      string
	Codes        []string
	Generated    bool
	Acknowledged bool
	Errors       map[string]string
}

type SetupReviewData struct {
	TopologyKind string
	Mode string
	TargetUserID string
	CurrentName string
	CurrentUsername string
	CurrentStatus string
	CurrentIsAdmin bool
	OwnerName string
	OwnerUsername string
	ExistingUserCount int
	TotalMailboxCount int64
	TargetMailboxCount int64
	UnassignedMailboxCount int64
	UnrevokedSessionCount int64
	TargetLegacySessions int64
	ExistingPasswordCredentials int64
	RetainedPasskeys int64
	ReplacedTOTPs int64
	RetainedIdentities int64
	ReplacedRecoveryCodes int64
	CreatesNewOwner bool
	ClaimsLegacyDefault bool
	ClaimsExistingUser bool
	BlockedMessage string
	CompletionError string
}

func setupOwnerDescription(helpID, errorID string, hasError bool) string {
	if !hasError {
		return helpID
	}
	if helpID == "" {
		return errorID
	}
	return helpID + " " + errorID
}

templ SetupTokenPage(data SetupTokenData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "setup.title.token") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<h1 class="mt-6 text-2xl font-semibold">{ i18n.T(ctx, "setup.token.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.token.description") }</p>
					</div>
					if data.Message != "" {
						<div id="setup-token-error" role="alert" aria-live="polite" class="bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm mb-6">
							{ data.Message }
						</div>
					}
					<form method="post" action="/setup" class="space-y-4">
						<div class="space-y-2">
							<label for="setup-token" class="text-sm font-medium">{ i18n.T(ctx, "setup.token.label") }</label>
							<input
								id="setup-token"
								name="token"
								type="password"
								autocomplete="one-time-code"
								autocapitalize="none"
								spellcheck="false"
								required
								autofocus
								if data.Message != "" {
									aria-invalid="true"
									aria-describedby="setup-token-error"
								}
								class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20"
							/>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							{ i18n.T(ctx, "setup.token.continue") }
						}
					</form>
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "setup.token.note") }</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupOwnerPage(data SetupOwnerData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "setup.title.owner") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-2xl">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">{ i18n.T(ctx, "setup.owner.verified") }</p>
						if data.Kind == "fresh" {
							<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "setup.owner.fresh_title") }</h1>
							<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.owner.fresh_description") }</p>
						} else if data.Kind == "legacy_default" {
							<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "setup.owner.legacy_title") }</h1>
							<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.owner.legacy_description") }</p>
						} else {
							<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "setup.owner.choose_title") }</h1>
							<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.owner.choose_description") }</p>
						}
					</div>
					if data.DraftSaved {
						<div role="status" aria-live="polite" class="mb-6 rounded-lg border border-success/25 bg-success/10 px-4 py-3">
							<p class="text-sm font-medium text-success">{ i18n.T(ctx, "setup.owner.draft_saved") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.owner.draft_note") }</p>
						</div>
					}
					if data.DraftStale {
						<div role="alert" class="mb-6 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm">
							{ i18n.T(ctx, "setup.owner.draft_stale") }
						</div>
					}
					if data.BlockedMessage != "" {
						<div role="alert" class="rounded-xl border border-destructive/25 bg-destructive/10 p-6">
							<h2 class="text-lg font-semibold">{ i18n.T(ctx, "setup.owner.blocked_title") }</h2>
							<p class="mt-2 text-sm text-muted-foreground">{ data.BlockedMessage }</p>
							<p class="mt-3 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.owner.repair_before") } <code class="font-mono">gofer auth users list</code> { i18n.T(ctx, "setup.owner.repair_after") }</p>
						</div>
					}
					if data.BlockedMessage == "" {
						<form method="post" action="/setup/owner" class="space-y-6 rounded-xl border border-border bg-card p-6">
							if data.Form.Errors["form"] != "" {
								<p role="alert" class="rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.Form.Errors["form"] }</p>
							}
						if data.Kind == "fresh" {
							<input type="hidden" name="owner_target" value="create"/>
						} else if data.Kind == "legacy_default" {
							<input type="hidden" name="owner_target" value="existing:default"/>
							<div class="rounded-lg border border-border bg-muted/30 p-4">
								<p class="text-sm font-medium">{ i18n.T(ctx, "setup.owner.legacy_kept_title") }</p>
								<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.owner.legacy_kept_before") } <code class="font-mono">default</code>{ i18n.T(ctx, "setup.owner.legacy_kept_after") }</p>
							</div>
						} else {
							<fieldset class="space-y-3" aria-describedby="owner-target-help">
								<legend class="text-sm font-medium">{ i18n.T(ctx, "setup.owner.target") }</legend>
								<p id="owner-target-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "setup.owner.target_help") }</p>
								<label class="flex cursor-pointer gap-3 rounded-lg border border-border p-4">
									<input type="radio" name="owner_target" value="create" checked?={ data.Form.Target == "create" } required class="mt-1"/>
									<span><span class="block text-sm font-medium">{ i18n.T(ctx, "setup.owner.create_new") }</span><span class="mt-1 block text-xs text-muted-foreground">{ i18n.T(ctx, "setup.owner.create_new_note") }</span></span>
								</label>
								for _, candidate := range data.Candidates {
									<label class="flex cursor-pointer gap-3 rounded-lg border border-border p-4">
										<input type="radio" name="owner_target" value={ "existing:" + candidate.ID } checked?={ data.Form.Target == "existing:" + candidate.ID } required class="mt-1"/>
										<span class="min-w-0">
											if candidate.Name != "" {
												<span class="block text-sm font-medium">{ candidate.Name }</span>
											} else {
												<span class="block text-sm font-medium">{ i18n.T(ctx, "setup.owner.unnamed") }</span>
											}
											<span class="mt-1 block break-all text-xs text-muted-foreground">{ "@" + candidate.Username } · { i18n.T(ctx, "setup.owner.id") } <code class="font-mono">{ candidate.ID }</code></span>
											<span class="mt-1 block text-xs text-muted-foreground">
												{ i18n.N(ctx, "setup.owner.mail_accounts", int(candidate.MailboxCount)) } · { i18n.N(ctx, "setup.owner.legacy_sessions", int(candidate.LegacySessions)) } · { candidate.Status }
												if candidate.IsAdmin {
													· { i18n.T(ctx, "setup.role.admin") }
												} else {
													· { i18n.T(ctx, "setup.role.standard") }
												}
											</span>
										</span>
									</label>
								}
								if data.Form.Errors["target"] != "" {
									<p role="alert" class="text-sm text-destructive">{ data.Form.Errors["target"] }</p>
								}
							</fieldset>
						}
						<div>
							<h2 class="text-sm font-medium">{ i18n.T(ctx, "setup.owner.profile_title") }</h2>
							if data.Kind == "fresh" {
								<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.owner.profile_fresh") }</p>
							} else {
								<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.owner.profile_existing") }</p>
							}
						</div>
						<div class="space-y-4">
							<div class="space-y-2">
								<label for="owner-name" class="text-sm font-medium">{ i18n.T(ctx, "setup.owner.display_name") }</label>
								<input id="owner-name" name="name" type="text" value={ data.Form.Name } autocomplete="name" maxlength="100" required aria-invalid={ fmt.Sprintf("%t", data.Form.Errors["name"] != "") } aria-describedby={ setupOwnerDescription("", "owner-name-error", data.Form.Errors["name"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
								if data.Form.Errors["name"] != "" {
									<p id="owner-name-error" role="alert" class="text-sm text-destructive">{ data.Form.Errors["name"] }</p>
								}
							</div>
							<div class="space-y-2">
								<label for="owner-username" class="text-sm font-medium">{ i18n.T(ctx, "signin.username") }</label>
								<input id="owner-username" name="username" type="text" value={ data.Form.Username } autocomplete="username" autocapitalize="none" spellcheck="false" minlength="3" maxlength="32" required aria-invalid={ fmt.Sprintf("%t", data.Form.Errors["username"] != "") } aria-describedby={ setupOwnerDescription("owner-username-help", "owner-username-error", data.Form.Errors["username"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
								<p id="owner-username-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "setup.owner.username_help") }</p>
								if data.Form.Errors["username"] != "" {
									<p id="owner-username-error" role="alert" class="text-sm text-destructive">{ data.Form.Errors["username"] }</p>
								}
							</div>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							if data.DraftSaved {
								{ i18n.T(ctx, "setup.owner.save_changes") }
							} else {
								{ i18n.T(ctx, "setup.owner.save") }
							}
						}
						if data.DraftSaved {
							<a href="/setup/password" class="flex h-9 w-full items-center justify-center rounded-md border border-border px-4 text-sm font-medium transition-colors hover:bg-accent">{ i18n.T(ctx, "setup.owner.continue") }</a>
						}
						<p class="text-center text-xs text-muted-foreground">{ i18n.T(ctx, "setup.owner.next") }</p>
					</form>
					}
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "setup.owner.expiry") }</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupPasswordPage(data SetupPasswordData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "setup.title.password") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-md">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">{ i18n.T(ctx, "setup.password.ready_badge") }</p>
						<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "setup.password.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.password.description") }</p>
					</div>
					if data.PasswordReady {
						<div role="status" aria-live="polite" class="mb-6 rounded-lg border border-success/25 bg-success/10 px-4 py-3">
							<p class="text-sm font-medium text-success">{ i18n.T(ctx, "setup.password.ready") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.password.ready_note") }</p>
						</div>
					}
					<form method="post" action="/setup/password" class="space-y-5 rounded-xl border border-border bg-card p-6">
						if data.Errors["form"] != "" {
							<p role="alert" class="rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.Errors["form"] }</p>
						}
						<div class="space-y-2">
							<label for="owner-password" class="text-sm font-medium">{ i18n.T(ctx, "signin.password") }</label>
							<input id="owner-password" name="password" type="password" autocomplete="new-password" minlength="15" maxlength="256" required autofocus aria-invalid={ fmt.Sprintf("%t", data.Errors["password"] != "") } aria-describedby={ setupOwnerDescription("owner-password-help", "owner-password-error", data.Errors["password"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
							<p id="owner-password-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "setup.password.help") }</p>
							if data.Errors["password"] != "" {
								<p id="owner-password-error" role="alert" class="text-sm text-destructive">{ data.Errors["password"] }</p>
							}
						</div>
						<div class="space-y-2">
							<label for="owner-password-confirmation" class="text-sm font-medium">{ i18n.T(ctx, "setup.password.confirm") }</label>
							<input id="owner-password-confirmation" name="password_confirmation" type="password" autocomplete="new-password" minlength="15" maxlength="256" required aria-invalid={ fmt.Sprintf("%t", data.Errors["confirmation"] != "") } aria-describedby={ setupOwnerDescription("", "owner-password-confirmation-error", data.Errors["confirmation"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
							if data.Errors["confirmation"] != "" {
								<p id="owner-password-confirmation-error" role="alert" class="text-sm text-destructive">{ data.Errors["confirmation"] }</p>
							}
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							if data.PasswordReady {
								{ i18n.T(ctx, "setup.password.replace") }
							} else {
								{ i18n.T(ctx, "setup.password.save") }
							}
						}
						<a href="/setup/owner" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "setup.password.back") }</a>
						<p class="text-center text-xs text-muted-foreground">{ i18n.T(ctx, "setup.password.next") }</p>
					</form>
					if data.PasswordReady {
						<form method="post" action="/setup/mfa" class="mt-4">
							<input type="hidden" name="action" value="start"/>
							@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
								{ i18n.T(ctx, "setup.password.continue") }
							}
						</form>
					}
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "setup.password.note") }</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupMFAPage(data SetupMFAData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "setup.title.mfa") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-lg">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">{ i18n.T(ctx, "setup.mfa.ready_badge") }</p>
						<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "setup.mfa.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.mfa.description") }</p>
					</div>
					if data.TOTPReady {
						<div role="status" aria-live="polite" class="rounded-xl border border-success/25 bg-success/10 px-5 py-4">
							<p class="text-sm font-medium text-success">{ i18n.T(ctx, "setup.mfa.verified") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.mfa.verified_note") }</p>
						</div>
						<div class="mt-4 rounded-xl border border-border bg-card p-5">
							<p class="text-sm font-medium">{ i18n.T(ctx, "setup.mfa.next_title") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.mfa.next") }</p>
						</div>
						<a href="/setup/recovery" class="mt-4 flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">{ i18n.T(ctx, "setup.mfa.continue") }</a>
						<form method="post" action="/setup/mfa" class="mt-2">
							<input type="hidden" name="action" value="restart"/>
							<button type="submit" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "setup.mfa.replace") }</button>
						</form>
					} else {
						<div class="rounded-xl border border-border bg-card p-6">
							<div class="grid gap-6 sm:grid-cols-[auto_1fr] sm:items-center">
								<div class="rounded-lg bg-white p-3">
									<img src={ data.QRCodeDataURL } alt={ i18n.T(ctx, "setup.mfa.qr_alt") } width="192" height="192" class="h-48 w-48"/>
								</div>
								<div class="space-y-3">
									<div>
										<p class="text-sm font-medium">{ i18n.T(ctx, "setup.mfa.step_scan") }</p>
										<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.mfa.scan_help") }</p>
									</div>
									<div>
										<p class="text-sm font-medium">{ i18n.T(ctx, "setup.mfa.enter_key") }</p>
										<code class="mt-2 block break-all rounded-md bg-muted px-3 py-2 font-mono text-xs" aria-label={ i18n.T(ctx, "setup.mfa.key_label") }>{ data.ManualKey }</code>
									</div>
									<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "setup.mfa.parameters", "algorithm", data.Algorithm, "digits", data.Digits, "period", data.Period) }</p>
								</div>
							</div>
							<form method="post" action="/setup/mfa" class="mt-6 space-y-4">
								<input type="hidden" name="action" value="confirm"/>
								if data.Errors["form"] != "" {
									<p role="alert" class="rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.Errors["form"] }</p>
								}
								<div class="space-y-2">
									<label for="setup-mfa-code" class="text-sm font-medium">{ i18n.T(ctx, "setup.mfa.step_code") }</label>
									<input id="setup-mfa-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required autofocus aria-invalid={ fmt.Sprintf("%t", data.Errors["code"] != "") } aria-describedby={ setupOwnerDescription("setup-mfa-code-help", "setup-mfa-code-error", data.Errors["code"] != "") } class="flex h-11 w-full rounded-md border border-input bg-background px-3 py-2 text-center font-mono text-lg tracking-[0.35em] outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
									<p id="setup-mfa-code-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "setup.mfa.code_help") }</p>
									if data.Errors["code"] != "" {
										<p id="setup-mfa-code-error" role="alert" class="text-sm text-destructive">{ data.Errors["code"] }</p>
									}
								</div>
								@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
									{ i18n.T(ctx, "signin.totp.verify") }
								}
							</form>
							<form method="post" action="/setup/mfa" class="mt-2">
								<input type="hidden" name="action" value="restart"/>
								<button type="submit" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "setup.mfa.new_key") }</button>
							</form>
						</div>
					}
					<a href="/setup/password" class="mt-4 flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "setup.mfa.back") }</a>
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "setup.mfa.note") }</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupRecoveryPage(data SetupRecoveryData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "setup.title.recovery") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-lg">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">{ i18n.T(ctx, "signin.codes.verified") }</p>
						<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "setup.recovery.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.recovery.description") }</p>
					</div>
					if data.Errors["form"] != "" {
						<p role="alert" class="mb-4 rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.Errors["form"] }</p>
					}
					if data.Acknowledged {
						<div role="status" aria-live="polite" class="rounded-xl border border-success/25 bg-success/10 px-5 py-4">
							<p class="text-sm font-medium text-success">{ i18n.T(ctx, "setup.recovery.acknowledged") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.recovery.acknowledged_note") }</p>
						</div>
						<div class="mt-4 rounded-xl border border-border bg-card p-5">
							<p class="text-sm font-medium">{ i18n.T(ctx, "setup.recovery.next_title") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.recovery.next") }</p>
						</div>
						<a href="/setup/review" class="mt-4 flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">{ i18n.T(ctx, "setup.recovery.review") }</a>
						<form method="post" action="/setup/recovery" class="mt-2">
							<input type="hidden" name="action" value="regenerate"/>
							<button type="submit" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "setup.recovery.replace") }</button>
						</form>
					} else if len(data.Codes) > 0 {
						<div role="alert" class="rounded-lg border border-warning/30 bg-warning/10 px-4 py-3">
							<p class="text-sm font-medium text-warning">{ i18n.T(ctx, "signin.codes.shown_once") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.recovery.copy") }</p>
						</div>
						<div class="mt-4 grid gap-2 rounded-xl border border-border bg-card p-5 sm:grid-cols-2" aria-label={ i18n.T(ctx, "setup.recovery.codes_label") }>
							for _, code := range data.Codes {
								<code class="select-all rounded-md bg-muted px-3 py-2 text-center font-mono text-sm tracking-wide">{ code }</code>
							}
						</div>
						@setupRecoveryAcknowledgement(data)
					} else if data.Generated {
						<div class="rounded-xl border border-border bg-card p-6">
							<p class="text-sm font-medium">{ i18n.T(ctx, "setup.recovery.already_shown") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.recovery.already_shown_note") }</p>
						</div>
						@setupRecoveryAcknowledgement(data)
					} else {
						<div class="rounded-xl border border-border bg-card p-6">
							<p class="text-sm font-medium">{ i18n.T(ctx, "setup.recovery.create_title") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.recovery.create_note") }</p>
							<form method="post" action="/setup/recovery" class="mt-5">
								<input type="hidden" name="action" value="generate"/>
								@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
									{ i18n.T(ctx, "signin.codes.generate") }
								}
							</form>
						</div>
					}
					<a href="/setup/mfa" class="mt-4 flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "setup.recovery.back") }</a>
					<p class="mt-6 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "setup.recovery.note") }</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupReviewPage(data SetupReviewData) {
	<!DOCTYPE html>
	<html lang={ pageLang(ctx) } class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			@I18nScripts()
			<title>{ i18n.T(ctx, "setup.title.review") }</title>
			@AppIcon()
			<link rel="stylesheet" href={ assetver.URL("/assets/css/output.css") }/>
			<script src={ assetver.URL("/assets/js/actions.js") }></script>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			@PublicPageCorners()
			<main class="min-h-screen flex justify-center p-4 py-10">
				<div class="w-full max-w-2xl">
					<div class="text-center mb-8">
						<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">{ i18n.T(ctx, "setup.review.ready_badge") }</p>
						<h1 class="mt-2 text-2xl font-semibold">{ i18n.T(ctx, "setup.review.title") }</h1>
						<p class="mt-2 text-sm text-muted-foreground">{ i18n.T(ctx, "setup.review.description") }</p>
					</div>
					if data.BlockedMessage != "" {
						<div role="alert" class="mb-5 rounded-xl border border-destructive/25 bg-destructive/10 p-5">
							<p class="text-sm font-medium text-destructive">{ i18n.T(ctx, "setup.review.blocked") }</p>
							<p class="mt-1 text-sm text-muted-foreground">{ data.BlockedMessage }</p>
							<p class="mt-2 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.review.blocked_note") }</p>
						</div>
					}
					if data.CompletionError != "" {
						<div role="alert" class="mb-5 rounded-xl border border-destructive/25 bg-destructive/10 p-5">
							<p class="text-sm font-medium text-destructive">{ i18n.T(ctx, "setup.review.failed") }</p>
							<p class="mt-1 text-sm text-muted-foreground">{ data.CompletionError }</p>
						</div>
					}
					<section aria-labelledby="review-owner-heading" class="rounded-xl border border-border bg-card p-6">
						<h2 id="review-owner-heading" class="text-base font-semibold">{ i18n.T(ctx, "setup.review.owner_identity") }</h2>
						if data.CreatesNewOwner {
							<p class="mt-2 text-sm">{ i18n.T(ctx, "setup.review.create_owner") }</p>
						} else {
							<p class="mt-2 text-sm">{ i18n.T(ctx, "setup.review.update_user_before") } <code class="font-mono">{ data.TargetUserID }</code> { i18n.T(ctx, "setup.review.update_user_after") }</p>
							<dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
								<div><dt class="text-xs text-muted-foreground">{ i18n.T(ctx, "setup.review.current_profile") }</dt><dd class="mt-1 break-words">{ data.CurrentName } · { "@" + data.CurrentUsername }</dd></div>
								<div>
									<dt class="text-xs text-muted-foreground">{ i18n.T(ctx, "setup.review.current_access") }</dt>
									<dd class="mt-1">
										{ data.CurrentStatus } ·
										if data.CurrentIsAdmin {
											{ i18n.T(ctx, "setup.role.admin") }
										} else {
											{ i18n.T(ctx, "setup.role.standard") }
										}
									</dd>
								</div>
							</dl>
						}
						<dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
							<div><dt class="text-xs text-muted-foreground">{ i18n.T(ctx, "setup.review.name") }</dt><dd class="mt-1 break-words">{ data.OwnerName }</dd></div>
							<div><dt class="text-xs text-muted-foreground">{ i18n.T(ctx, "signin.username") }</dt><dd class="mt-1 break-all">{ data.OwnerUsername }</dd></div>
						</dl>
					</section>
					<section aria-labelledby="review-security-heading" class="mt-4 rounded-xl border border-border bg-card p-6">
						<h2 id="review-security-heading" class="text-base font-semibold">{ i18n.T(ctx, "setup.review.security") }</h2>
						<ul class="mt-3 space-y-2 text-sm">
							<li>{ i18n.N(ctx, "setup.review.passwords", int(data.ExistingPasswordCredentials)) }</li>
							<li>{ i18n.N(ctx, "setup.review.totps", int(data.ReplacedTOTPs)) }</li>
							<li>{ i18n.N(ctx, "setup.review.recovery", int(data.ReplacedRecoveryCodes)) }</li>
							<li>{ i18n.N(ctx, "setup.review.passkeys", int(data.RetainedPasskeys)) } { i18n.N(ctx, "setup.review.identities", int(data.RetainedIdentities)) }</li>
						</ul>
						<p class="mt-3 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.review.security_note") }</p>
					</section>
					<section aria-labelledby="review-migration-heading" class="mt-4 rounded-xl border border-border bg-card p-6">
						<h2 id="review-migration-heading" class="text-base font-semibold">{ i18n.T(ctx, "setup.review.migration") }</h2>
						if data.ClaimsLegacyDefault {
							<p class="mt-2 text-sm">{ i18n.T(ctx, "setup.review.claim_legacy_before") } <code class="font-mono">default</code> { i18n.T(ctx, "setup.review.claim_legacy_after") }</p>
						} else if data.ClaimsExistingUser {
							<p class="mt-2 text-sm">{ i18n.T(ctx, "setup.review.claim_existing") }</p>
						} else if data.ExistingUserCount > 0 {
							<p class="mt-2 text-sm">{ i18n.T(ctx, "setup.review.add_owner") }</p>
						} else {
							<p class="mt-2 text-sm">{ i18n.T(ctx, "setup.review.fresh_owner") }</p>
						}
						<ul class="mt-3 space-y-2 text-sm">
							<li>{ i18n.N(ctx, "setup.review.mailboxes", int(data.TotalMailboxCount), "attached", data.TotalMailboxCount-data.UnassignedMailboxCount) }</li>
							if data.UnassignedMailboxCount > 0 {
								<li class="text-destructive">{ i18n.N(ctx, "setup.review.unassigned", int(data.UnassignedMailboxCount)) }</li>
							}
							if !data.CreatesNewOwner {
								<li>{ i18n.N(ctx, "setup.review.target_mailboxes", int(data.TargetMailboxCount)) }</li>
							}
							<li>{ i18n.N(ctx, "setup.review.sessions", int(data.UnrevokedSessionCount)) }</li>
							if data.TargetLegacySessions > 0 {
								<li>{ i18n.N(ctx, "setup.review.target_sessions", int(data.TargetLegacySessions)) }</li>
							}
						</ul>
					</section>
					<div role="status" aria-live="polite" class="mt-4 rounded-xl border border-info/25 bg-info/10 p-5">
						<p class="text-sm font-medium">{ i18n.T(ctx, "setup.review.only") }</p>
						<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.review.only_note") }</p>
					</div>
					if data.BlockedMessage == "" {
						<form method="post" action="/setup/review" class="mt-4 rounded-xl border border-success/25 bg-success/10 p-5">
							<input type="hidden" name="action" value="complete"/>
							<p class="text-sm font-medium">{ i18n.T(ctx, "setup.review.ready") }</p>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "setup.review.ready_note") }</p>
							<button type="submit" class="mt-4 flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">{ i18n.T(ctx, "setup.review.complete") }</button>
						</form>
					}
					<a href="/setup/recovery" class="mt-4 flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "setup.review.back") }</a>
				</div>
			</main>
		</body>
	</html>
}

templ setupRecoveryAcknowledgement(data SetupRecoveryData) {
	<form method="post" action="/setup/recovery" class="mt-4 space-y-4 rounded-xl border border-border bg-card p-5">
		<input type="hidden" name="action" value="acknowledge"/>
		<input type="hidden" name="batch_id" value={ data.BatchID }/>
		<label for="setup-recovery-saved" class="flex items-start gap-3 text-sm">
			<input id="setup-recovery-saved" name="saved" type="checkbox" value="yes" required aria-invalid={ fmt.Sprintf("%t", data.Errors["saved"] != "") } aria-describedby={ setupOwnerDescription("setup-recovery-saved-help", "setup-recovery-saved-error", data.Errors["saved"] != "") } class="mt-0.5 h-4 w-4 rounded border-input"/>
			<span>{ i18n.T(ctx, "setup.recovery.ack") }</span>
		</label>
		<p id="setup-recovery-saved-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "setup.recovery.ack_help") }</p>
		if data.Errors["saved"] != "" {
			<p id="setup-recovery-saved-error" role="alert" class="text-sm text-destructive">{ data.Errors["saved"] }</p>
		}
		@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
			{ i18n.T(ctx, "setup.recovery.ack_button") }
		}
	</form>
	<form method="post" action="/setup/recovery" class="mt-2">
		<input type="hidden" name="action" value="regenerate"/>
		<button type="submit" class="flex h-9 w-full items-center justify-center rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "setup.recovery.regenerate") }</button>
	</form>
}
