package views

import (
	"fmt"

	"github.com/cristianadrielbraun/gofer/components/button"
)

type SetupTokenData struct {
	Message string
}

type SetupOwnerCandidateData struct {
	ID             string
	Name           string
	Email          string
	Username       string
	Status         string
	IsAdmin        bool
	MailboxCount   int64
	LegacySessions int64
}

type SetupOwnerFormData struct {
	Target   string
	Name     string
	Username string
	Email    string
	Errors   map[string]string
}

type SetupOwnerData struct {
	Kind       string
	Candidates []SetupOwnerCandidateData
	Form       SetupOwnerFormData
	DraftSaved bool
	DraftStale bool
	BlockedMessage string
}

func setupOwnerDescription(helpID, errorID string, hasError bool) string {
	if !hasError {
		return helpID
	}
	if helpID == "" {
		return errorID
	}
	return helpID + " " + errorID
}

templ SetupTokenPage(data SetupTokenData) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gofer — Initial Setup</title>
			@AppIcon()
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			<main class="min-h-screen flex items-center justify-center p-4">
				<div class="w-full max-w-sm">
					<div class="text-center mb-8">
						<img src="/assets/logo.svg" alt="Gofer" class="h-12 w-auto mx-auto"/>
						<h1 class="mt-6 text-2xl font-semibold">Set up Gofer</h1>
						<p class="mt-2 text-sm text-muted-foreground">Enter the private token shown on the machine running Gofer.</p>
					</div>
					if data.Message != "" {
						<div id="setup-token-error" role="alert" aria-live="polite" class="bg-destructive/10 border border-destructive/20 text-destructive rounded-lg px-4 py-3 text-sm mb-6">
							{ data.Message }
						</div>
					}
					<form method="post" action="/setup" class="space-y-4">
						<div class="space-y-2">
							<label for="setup-token" class="text-sm font-medium">Setup token</label>
							<input
								id="setup-token"
								name="token"
								type="password"
								autocomplete="one-time-code"
								autocapitalize="none"
								spellcheck="false"
								required
								autofocus
								if data.Message != "" {
									aria-invalid="true"
									aria-describedby="setup-token-error"
								}
								class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none transition-shadow placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive aria-[invalid=true]:ring-destructive/20"
							/>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							Continue securely
						}
					</form>
					<p class="mt-6 text-center text-xs text-muted-foreground">The token is sent only when you submit this form. It is never included in the page URL or saved by Gofer in browser storage.</p>
				</div>
			</main>
		</body>
	</html>
}

templ SetupOwnerPage(data SetupOwnerData) {
	<!DOCTYPE html>
	<html lang="en" class="dark" data-theme="classic">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gofer — Set Up Owner</title>
			@AppIcon()
			<link rel="stylesheet" href="/assets/css/output.css"/>
		</head>
		<body class="bg-background text-foreground antialiased surface-desk">
			<main class="min-h-screen flex items-center justify-center p-4 py-10">
				<div class="w-full max-w-2xl">
					<div class="text-center mb-8">
						<img src="/assets/logo.svg" alt="Gofer" class="h-12 w-auto mx-auto"/>
						<p class="mt-5 text-xs font-medium uppercase tracking-widest text-success">Setup access verified</p>
						if data.Kind == "fresh" {
							<h1 class="mt-2 text-2xl font-semibold">Create the first owner</h1>
							<p class="mt-2 text-sm text-muted-foreground">This installation has no Gofer users yet.</p>
						} else if data.Kind == "legacy_default" {
							<h1 class="mt-2 text-2xl font-semibold">Claim your existing Gofer data</h1>
							<p class="mt-2 text-sm text-muted-foreground">The legacy local user will become the real owner without changing its stable ID.</p>
						} else {
							<h1 class="mt-2 text-2xl font-semibold">Choose the Gofer owner</h1>
							<p class="mt-2 text-sm text-muted-foreground">Select an existing user explicitly, or create a separate owner.</p>
						}
					</div>
					if data.DraftSaved {
						<div role="status" aria-live="polite" class="mb-6 rounded-lg border border-success/25 bg-success/10 px-4 py-3">
							<p class="text-sm font-medium text-success">Owner profile ready for security enrollment</p>
							<p class="mt-1 text-xs text-muted-foreground">The encrypted draft is tied to this setup session. No user, role, credential, or owned data has been changed yet.</p>
						</div>
					}
					if data.DraftStale {
						<div role="alert" class="mb-6 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm">
							Existing users changed after this draft was saved. Review and save the owner selection again.
						</div>
					}
					if data.BlockedMessage != "" {
						<div role="alert" class="rounded-xl border border-destructive/25 bg-destructive/10 p-6">
							<h2 class="text-lg font-semibold">Owner setup needs local repair</h2>
							<p class="mt-2 text-sm text-muted-foreground">{ data.BlockedMessage }</p>
							<p class="mt-3 text-sm text-muted-foreground">Stop Gofer, run <code class="font-mono">gofer auth users list</code> locally, and resolve duplicate or excessive user records before rotating the setup token and trying again. Gofer will not guess an owner or merge records.</p>
						</div>
					}
					if data.BlockedMessage == "" {
						<form method="post" action="/setup/owner" class="space-y-6 rounded-xl border border-border bg-card p-6">
							if data.Form.Errors["form"] != "" {
								<p role="alert" class="rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm text-destructive">{ data.Form.Errors["form"] }</p>
							}
						if data.Kind == "fresh" {
							<input type="hidden" name="owner_target" value="create"/>
						} else if data.Kind == "legacy_default" {
							<input type="hidden" name="owner_target" value="existing:default"/>
							<div class="rounded-lg border border-border bg-muted/30 p-4">
								<p class="text-sm font-medium">Existing local data stays attached</p>
								<p class="mt-1 text-xs text-muted-foreground">Mail accounts, settings, contacts, messages, drafts, and queued operations keep using user ID <code class="font-mono">default</code>. Nothing is copied or reassigned.</p>
							</div>
						} else {
							<fieldset class="space-y-3" aria-describedby="owner-target-help">
								<legend class="text-sm font-medium">Owner target</legend>
								<p id="owner-target-help" class="text-xs text-muted-foreground">Selecting an existing user preserves every resource already attached to that exact user ID.</p>
								<label class="flex cursor-pointer gap-3 rounded-lg border border-border p-4">
									<input type="radio" name="owner_target" value="create" checked?={ data.Form.Target == "create" } required class="mt-1"/>
									<span><span class="block text-sm font-medium">Create a new owner</span><span class="mt-1 block text-xs text-muted-foreground">Existing users and their data remain unchanged.</span></span>
								</label>
								for _, candidate := range data.Candidates {
									<label class="flex cursor-pointer gap-3 rounded-lg border border-border p-4">
										<input type="radio" name="owner_target" value={ "existing:" + candidate.ID } checked?={ data.Form.Target == "existing:" + candidate.ID } required class="mt-1"/>
										<span class="min-w-0">
											if candidate.Name != "" {
												<span class="block text-sm font-medium">{ candidate.Name }</span>
											} else {
												<span class="block text-sm font-medium">Unnamed Gofer user</span>
											}
											<span class="mt-1 block break-all text-xs text-muted-foreground">{ candidate.Email } · ID <code class="font-mono">{ candidate.ID }</code></span>
											<span class="mt-1 block text-xs text-muted-foreground">
												{ fmt.Sprintf("%d mail accounts · %d legacy sessions · %s", candidate.MailboxCount, candidate.LegacySessions, candidate.Status) }
												if candidate.IsAdmin {
													· administrator
												} else {
													· standard user
												}
											</span>
										</span>
									</label>
								}
								if data.Form.Errors["target"] != "" {
									<p role="alert" class="text-sm text-destructive">{ data.Form.Errors["target"] }</p>
								}
							</fieldset>
						}
						<div>
							<h2 class="text-sm font-medium">Owner profile and login identifier</h2>
							if data.Kind == "fresh" {
								<p class="mt-1 text-xs text-muted-foreground">These values identify the first real Gofer user.</p>
							} else {
								<p class="mt-1 text-xs text-muted-foreground">For an existing target, these values replace its current profile only when final enrollment succeeds.</p>
							}
						</div>
						<div class="grid gap-4 sm:grid-cols-2">
							<div class="space-y-2 sm:col-span-2">
								<label for="owner-name" class="text-sm font-medium">Display name</label>
								<input id="owner-name" name="name" type="text" value={ data.Form.Name } autocomplete="name" maxlength="100" required aria-invalid={ fmt.Sprintf("%t", data.Form.Errors["name"] != "") } aria-describedby={ setupOwnerDescription("", "owner-name-error", data.Form.Errors["name"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
								if data.Form.Errors["name"] != "" {
									<p id="owner-name-error" role="alert" class="text-sm text-destructive">{ data.Form.Errors["name"] }</p>
								}
							</div>
							<div class="space-y-2">
								<label for="owner-username" class="text-sm font-medium">Username</label>
								<input id="owner-username" name="username" type="text" value={ data.Form.Username } autocomplete="username" autocapitalize="none" spellcheck="false" minlength="3" maxlength="32" required aria-invalid={ fmt.Sprintf("%t", data.Form.Errors["username"] != "") } aria-describedby={ setupOwnerDescription("owner-username-help", "owner-username-error", data.Form.Errors["username"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
								<p id="owner-username-help" class="text-xs text-muted-foreground">3–32 ASCII letters, numbers, periods, underscores, or hyphens.</p>
								if data.Form.Errors["username"] != "" {
									<p id="owner-username-error" role="alert" class="text-sm text-destructive">{ data.Form.Errors["username"] }</p>
								}
							</div>
							<div class="space-y-2">
								<label for="owner-email" class="text-sm font-medium">Email</label>
								<input id="owner-email" name="email" type="email" value={ data.Form.Email } autocomplete="email" maxlength="254" required aria-invalid={ fmt.Sprintf("%t", data.Form.Errors["email"] != "") } aria-describedby={ setupOwnerDescription("", "owner-email-error", data.Form.Errors["email"] != "") } class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50 aria-[invalid=true]:border-destructive"/>
								if data.Form.Errors["email"] != "" {
									<p id="owner-email-error" role="alert" class="text-sm text-destructive">{ data.Form.Errors["email"] }</p>
								}
							</div>
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, FullWidth: true}) {
							if data.DraftSaved {
								Save changes
							} else {
								Save owner profile
							}
						}
						<p class="text-center text-xs text-muted-foreground">Next, you will choose a sign-in credential and enroll the required administrator security factor.</p>
					</form>
					}
					<p class="mt-6 text-center text-xs text-muted-foreground">Setup access expires after ten minutes. The setup token remains active until final enrollment completes; rotating it discards this encrypted draft.</p>
				</div>
			</main>
		</body>
	</html>
}
