package views

import (
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

type AdminSecurityVerificationData struct {
	Required               bool
	Open                   bool
	HasTOTP                bool
	HasPasskey             bool
	ReturnTo               string
	TOTPPath               string
	TOTPCSRFToken          string
	PasskeyStartPath       string
	PasskeyFinishPath      string
	PasskeyStartCSRFToken  string
	PasskeyFinishCSRFToken string
}

func adminSecurityVerificationValue(values []AdminSecurityVerificationData) AdminSecurityVerificationData {
	if len(values) == 0 {
		return AdminSecurityVerificationData{}
	}
	return values[0]
}

templ AdminSecurityVerificationTrigger(data AdminSecurityVerificationData, label string) {
	if data.Required {
		@dialog.Trigger(dialog.TriggerProps{For: "admin-security-verification-dialog"}) {
			<button type="button" class="inline-flex h-9 items-center justify-center gap-2 rounded-md border border-amber-500/40 bg-background px-3 text-sm font-semibold text-foreground transition-colors hover:bg-accent">
				@icon.ShieldCheck(icon.Props{Class: "size-4 text-amber-700 dark:text-amber-300"})
				{ label }
			</button>
		}
	}
}

templ AdminSecurityVerificationDialog(data AdminSecurityVerificationData) {
	if data.Required {
		@dialog.Dialog(dialog.Props{ID: "admin-security-verification-dialog", Open: data.Open}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl max-h-[calc(100vh-2rem)] overflow-y-auto", DisableModal: true, Attributes: templ.Attributes{"style": "box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.5)"}}) {
				@dialog.Header() {
					@dialog.Title() {
						{ i18n.T(ctx, "admin.verify.title") }
					}
					@dialog.Description() {
						{ i18n.T(ctx, "admin.verify.description") }
					}
				}
				<div
					data-admin-security-verification
					class={
						templ.Classes(
							"grid gap-4",
							templ.KV("sm:grid-cols-2", data.HasPasskey && data.HasTOTP),
						),
					}
				>
					if data.HasPasskey {
						<form
							data-passkey-authentication
							data-start-path={ data.PasskeyStartPath }
							data-finish-path={ data.PasskeyFinishPath }
							data-start-csrf={ data.PasskeyStartCSRFToken }
							data-finish-csrf={ data.PasskeyFinishCSRFToken }
							data-success-redirect={ data.ReturnTo }
							data-fallback={ i18n.T(ctx, "security.verify.fallback") }
							class="space-y-4 rounded-lg border border-border bg-background/60 p-4"
						>
							<div class="flex items-start gap-3">
								<div class="rounded-md bg-primary/10 p-2 text-primary">
									@icon.KeyRound(icon.Props{Class: "size-5"})
								</div>
								<div>
									<p class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "security.passkey") }</p>
									<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.verify.passkey_detail") }</p>
								</div>
							</div>
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60">{ i18n.T(ctx, "security.verify.passkey_button") }</button>
							<p data-passkey-authentication-status role="status" aria-live="polite" class="min-h-4 text-xs text-muted-foreground"></p>
						</form>
					}
					if data.HasTOTP {
						<form
							method="post"
							action={ templ.SafeURL(data.TOTPPath) }
							data-admin-security-totp
							autocomplete="on"
							data-success-redirect={ data.ReturnTo }
							class="space-y-4 rounded-lg border border-border bg-background/60 p-4"
						>
							<input type="hidden" name="_csrf" value={ data.TOTPCSRFToken }/>
							<input type="hidden" name="return_to" value={ data.ReturnTo }/>
							<div class="flex items-start gap-3">
								<div class="rounded-md bg-primary/10 p-2 text-primary">
									@icon.Smartphone(icon.Props{Class: "size-5"})
								</div>
								<div class="min-w-0 flex-1">
									<label for="admin-security-totp-code" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "security.verify.code") }</label>
									<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.verify.code_detail") }</p>
								</div>
							</div>
							<input
								id="admin-security-totp-code"
								autofocus
								aria-label={ i18n.T(ctx, "security.verify.code") }
								name="code"
								type="text"
								inputmode="numeric"
								autocomplete="one-time-code"
								pattern="[0-9]{6}"
								minlength="6"
								maxlength="6"
								required
								class="h-10 w-full rounded-md border border-input bg-background px-3 text-center font-mono text-base tracking-[0.3em] text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
							/>
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground shadow-sm transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-60">{ i18n.T(ctx, "security.verify.code_button") }</button>
							<p data-admin-security-totp-status role="status" aria-live="polite" class="min-h-4 text-xs text-muted-foreground"></p>
						</form>
					}
					if !data.HasTOTP && !data.HasPasskey {
						<div class="rounded-lg border border-border bg-background/60 p-4">
							<p class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.verify.sign_in_again") }</p>
							<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.verify.none") }</p>
							<a href="/admin/login" class="mt-4 inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">{ i18n.T(ctx, "admin.verify.go_sign_in") }</a>
						</div>
					}
				</div>
			}
		}
	}
}
