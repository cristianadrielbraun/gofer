package views

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"strconv"
	"github.com/cristianadrielbraun/gofer/components/datepicker"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/label"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
)

templ CalendarRecurrenceFields(data CalendarCreateData) {
	{{
		frequency, interval, ending, until, count := "none", "1", "never", "", "10"
		if repeat := data.Recurrence; repeat != nil {
			frequency, interval = repeat.Frequency, strconv.Itoa(repeat.Interval)
			if repeat.Count > 0 { ending, count = "count", strconv.Itoa(repeat.Count) }
			if repeat.Until != "" { ending, until = "until", repeat.Until }
		}
	}}
	<div class="space-y-2" data-calendar-repeat>
		<div class="flex min-w-0 flex-wrap items-center gap-2" data-calendar-repeat-row data-repeating={ strconv.FormatBool(frequency != "none") }>
			<div class="min-w-40 flex-1">
				@label.Label(label.Props{For: "calendar-create-repeat-frequency", Class: "sr-only"}) {
					{ i18n.T(ctx, "calendar.repeat.label") }
				}
				@selectbox.SelectBox() {
					@selectbox.Trigger(selectbox.TriggerProps{ID: "calendar-create-repeat-frequency", Name: "repeat_frequency", DisableClear: true, Attributes: templ.Attributes{"value": frequency}}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "calendar.repeat.none")})
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
						@selectbox.Group() {
							for _, option := range [][2]string{{"none", i18n.T(ctx, "calendar.repeat.none")}, {"daily", i18n.T(ctx, "calendar.repeat.daily")}, {"weekly", i18n.T(ctx, "calendar.repeat.weekly")}, {"monthly", i18n.T(ctx, "calendar.repeat.monthly")}, {"yearly", i18n.T(ctx, "calendar.repeat.yearly")}} {
								@selectbox.Item(selectbox.ItemProps{Value: option[0], Selected: option[0] == frequency, Disabled: data.EditSeries && option[0] == "none"}) {
									{ option[1] }
								}
							}
						}
					}
				}
			</div>
			<fieldset data-calendar-repeat-interval-group hidden?={ frequency == "none" } disabled?={ frequency == "none" } class="flex shrink-0 items-center gap-2">
				@label.Label(label.Props{For: "calendar-create-repeat-interval", Class: "font-normal text-muted-foreground"}) {
					{ i18n.T(ctx, "calendar.repeat.every") }
				}
				@input.Input(input.Props{ID: "calendar-create-repeat-interval", Name: "repeat_interval", Type: input.TypeNumber, Value: interval, Required: true, Class: "w-16 tabular-nums", Attributes: templ.Attributes{"min": "1", "max": "99", "step": "1", "data-calendar-repeat-number": "", "aria-describedby": "calendar-repeat-unit"}})
				<span id="calendar-repeat-unit" data-calendar-repeat-unit class="w-12 text-sm text-muted-foreground">{ i18n.T(ctx, "calendar.repeat.unit.days") }</span>
			</fieldset>
		</div>
		<fieldset data-calendar-repeat-options hidden?={ frequency == "none" } disabled?={ frequency == "none" } class="min-w-0 space-y-2">
			<div class="flex min-w-0 flex-wrap items-center gap-2">
				<div class="min-w-40 flex-1">
					@label.Label(label.Props{For: "calendar-create-repeat-end", Class: "sr-only"}) {
						{ i18n.T(ctx, "calendar.repeat.series_ends") }
					}
					@selectbox.SelectBox() {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "calendar-create-repeat-end", Name: "repeat_end", DisableClear: true, Attributes: templ.Attributes{"value": ending}}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "calendar.repeat.end.never")})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, Class: "mobile-sheet"}) {
							@selectbox.Group() {
								for _, option := range [][2]string{{"never", i18n.T(ctx, "calendar.repeat.end.never")}, {"until", i18n.T(ctx, "calendar.repeat.end.until")}, {"count", i18n.T(ctx, "calendar.repeat.end.count")}} {
									@selectbox.Item(selectbox.ItemProps{Value: option[0], Selected: option[0] == ending}) {
										{ option[1] }
									}
								}
							}
						}
					}
				</div>
				<fieldset data-calendar-repeat-until hidden?={ ending != "until" } disabled?={ ending != "until" } class="w-44 shrink-0">
					@label.Label(label.Props{For: "calendar-create-repeat-until", Class: "sr-only"}) {
						{ i18n.T(ctx, "calendar.repeat.last_start") }
					}
					@datepicker.DatePicker(datepicker.Props{ID: "calendar-create-repeat-until", Name: "repeat_until", Value: calendarCreatePickerValue("2006-01-02", until)})
				</fieldset>
				<fieldset data-calendar-repeat-count hidden?={ ending != "count" } disabled?={ ending != "count" } class="flex shrink-0 items-center gap-2">
					@label.Label(label.Props{For: "calendar-create-repeat-count", Class: "sr-only"}) {
						{ i18n.T(ctx, "calendar.repeat.occurrences") }
					}
					@input.Input(input.Props{ID: "calendar-create-repeat-count", Name: "repeat_count", Type: input.TypeNumber, Value: count, Required: true, Class: "w-16 tabular-nums", Attributes: templ.Attributes{"min": "1", "max": "999", "step": "1", "data-calendar-repeat-number": "", "aria-describedby": "calendar-repeat-count-unit"}})
					<span id="calendar-repeat-count-unit" class="w-12 text-sm text-muted-foreground">{ i18n.T(ctx, "calendar.repeat.times") }</span>
				</fieldset>
			</div>
			<div class="space-y-1 text-xs leading-relaxed text-muted-foreground">
				<p data-calendar-repeat-summary role="status" aria-live="polite" aria-atomic="true"></p>
				if data.EditSeries {
					<p>{ i18n.T(ctx, "calendar.repeat.series_help") }</p>
				}
			</div>
		</fieldset>
	</div>
}
