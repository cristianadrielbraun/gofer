package views

import (
	"context"
	"time"

	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
)

// adminValueLabel shows a user's status, role or 2FA value, which the
// handler sends as a code, in the page's language. The English names are
// what the handler sent before codes.
func adminValueLabel(ctx context.Context, value string) string {
	switch value {
	case "active", "Active":
		return i18n.T(ctx, "admin.value.active")
	case "pending", "Pending":
		return i18n.T(ctx, "admin.value.pending")
	case "disabled", "Disabled":
		return i18n.T(ctx, "admin.value.disabled")
	case "webmail_user", "Webmail user":
		return i18n.T(ctx, "admin.value.webmail_user")
	case "management_admin", "Management administrator":
		return i18n.T(ctx, "admin.value.management_admin")
	case "management_user", "Management user":
		return i18n.T(ctx, "admin.value.management_user")
	case "legacy", "Legacy mixed account":
		return i18n.T(ctx, "admin.value.legacy")
	case "optional", "Optional":
		return i18n.T(ctx, "admin.value.optional")
	case "required", "Required":
		return i18n.T(ctx, "admin.value.required")
	case "user_choice", "User choice":
		return i18n.T(ctx, "admin.value.user_choice")
	case "management_policy", "Management policy":
		return i18n.T(ctx, "admin.value.management_policy")
	case "individual_policy", "Individual policy":
		return i18n.T(ctx, "admin.value.individual_policy")
	case "instance_policy", "Instance policy":
		return i18n.T(ctx, "admin.value.instance_policy")
	}
	return value
}

templ AdminSidebar(activeSection string) {
	<aside class="hidden lg:flex w-64 shrink-0 flex-col border-r border-border bg-card/75 backdrop-blur-sm">
		<div class="px-5 py-5 border-b border-border">
			<a href="/admin" class="inline-flex items-center gap-2.5 text-foreground hover:text-primary transition-colors">
				<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-8 w-8 shrink-0"/>
				<span class="text-lg font-bold tracking-tight" style="font-family: var(--font-serif)">Gofer Admin</span>
			</a>
			<p class="mt-2 text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "admin.sidebar.description") }</p>
		</div>
		<nav class="flex-1 px-3 py-4 space-y-1">
			<a
				href="/admin/users"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.users") }
				aria-current?={ activeSection == "users" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "users"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "users"),
				}
			>
				@icon.Users(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.users") }
			</a>
			<a
				href="/admin/activity"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.activity") }
				aria-current?={ activeSection == "activity" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "activity"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "activity"),
				}
			>
				@icon.History(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.activity") }
			</a>
			<a
				href="/admin/avatars/"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.avatars") }
				aria-current?={ activeSection == "avatars" || activeSection == "" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "avatars" || activeSection == ""),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "avatars" && activeSection != ""),
				}
			>
				@icon.Activity(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.avatars") }
			</a>
			<a
				href="/admin/contacts"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.contacts") }
				aria-current?={ activeSection == "contacts" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "contacts"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "contacts"),
				}
			>
				@icon.BookUser(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.contacts") }
			</a>
			<a
				href="/admin/labels"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.labels") }
				aria-current?={ activeSection == "labels" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "labels"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "labels"),
				}
			>
				@icon.Tags(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.labels") }
			</a>
			<a
				href="/admin/operations"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.operations") }
				aria-current?={ activeSection == "operations" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "operations"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "operations"),
				}
			>
				@icon.ClipboardList(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.operations") }
			</a>
			<a
				href="/admin/security"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.security") }
				aria-current?={ activeSection == "security" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "security"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "security"),
				}
			>
				@icon.ShieldAlert(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.security") }
			</a>
			<a
				href="/admin/account/security"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.account_security") }
				aria-current?={ activeSection == "account-security" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "account-security"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "account-security"),
				}
			>
				@icon.ShieldCheck(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.account_security") }
			</a>
		</nav>
		<div class="px-5 py-4 border-t border-border">
			<p class="px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.sidebar.workspace") }</p>
		</div>
	</aside>
}

templ AdminNavigationLoading() {
	<div
		data-admin-navigation-loading
		class="absolute inset-0 z-50 hidden items-center justify-center bg-background/80 px-6 backdrop-blur-sm"
		role="status"
		aria-live="polite"
		aria-hidden="true"
	>
		<div class="flex items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 text-sm font-semibold text-foreground shadow-lg">
			@icon.LoaderCircle(icon.Props{Class: "size-5 animate-spin text-primary"})
			<span data-admin-navigation-loading-label>{ i18n.T(ctx, "admin.loading_section") }</span>
		</div>
	</div>
}

func adminPercent(part, total int) int {
	if total <= 0 {
		return 0
	}
	p := part * 100 / total
	if p > 100 {
		return 100
	}
	return p
}

// adminDateTimeZone writes a moment in the server's zone, naming the zone.
func adminDateTimeZone(ctx context.Context, t time.Time) string {
	t = t.Local()
	zone, _ := t.Zone()
	return i18n.Dates(ctx).DateTime(t) + " " + zone
}

func adminTime(ctx context.Context, t time.Time) string {
	if t.IsZero() {
		return i18n.T(ctx, "admin.never")
	}
	return i18n.Dates(ctx).ShortDateTime(t.Local())
}

func adminPanelTitleClass() string {
	return "text-sm font-semibold uppercase tracking-wider text-muted-foreground"
}

func adminError(ctx context.Context, err string) string {
	if err == "" {
		return i18n.T(ctx, "admin.no_error")
	}
	return err
}
