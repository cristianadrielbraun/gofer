package views

import (
	"context"
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/internal/assetver"
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/cristianadrielbraun/gofer/components/button"
	"github.com/cristianadrielbraun/gofer/components/copybutton"
	"github.com/cristianadrielbraun/gofer/components/dialog"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/input"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	switchcomp "github.com/cristianadrielbraun/gofer/components/switch"
	"github.com/cristianadrielbraun/gofer/components/tabs"
	"github.com/cristianadrielbraun/gofer/internal/models"
)

type AdminUserData struct {
	RequiredChangePath string
	RequiredChangeCSRFToken string
	RequiredChangeOpen bool
	HasPassword bool
	PasswordChangeRequired bool
	ID                        string
	Username                  string
	Status                    string
	Role                      string
	Current                   bool
	MFALabel                  string
	MFADetail                 string
	MFARequired               bool
	MFAPolicyPath             string
	MFAPolicyCSRFToken        string
	StatusPath                string
	StatusCSRFToken           string
	CredentialResetPath       string
	CredentialResetCSRFToken  string
	CredentialResetOpen       bool
	DeletionPending           bool
	DeletionPath              string
	DeletionCSRFToken         string
	PasswordResetRequestedAt  *time.Time
	InvitationState           string
	InvitationExpiresAt       *time.Time
	InvitationRevokePath      string
	InvitationRevokeCSRFToken string
	InvitationRotatePath      string
	InvitationRotateCSRFToken string
}

type AdminUsersData struct {
	Users               []AdminUserData
	Total               int
	Active              int
	Pending             int
	Disabled            int
	Administrators      int
	StepUpRequired      bool
	InvitationCSRFToken string
	InvitationForm      AdminUserInvitationFormData
	Invitation          *AdminUserInvitationData
	CredentialReset     *AdminUserCredentialResetData
	Notice              string
	Error               string
}

type AdminUserInvitationFormData struct {
	Name        string
	Username    string
	FieldErrors map[string]string
}

type AdminUserInvitationData struct {
	Name          string
	Username      string
	RedemptionURL string
	Token         string
	ExpiresAt     time.Time
	Rotated       bool
}

type AdminUserCredentialResetData struct {
	Username      string
	RedemptionURL string
	Token         string
	ExpiresAt     time.Time
}

type AdminSecurityActivityEventData struct {
	Title          string
	Detail         string
	OccurredAt     string
	Client         string
	Status         string
	Actor          string
	Subject        string
	SubjectDeleted bool
	Successful     bool
}

type AdminSecurityActivityData struct {
	Events               []AdminSecurityActivityEventData
	Filter               string
	TotalEvents          int64
	Page                 int64
	TotalPages           int64
	FirstEvent           int64
	LastEvent            int64
	PreviousPage         int64
	NextPage             int64
	HasPrevious          bool
	HasNext              bool
	StepUpRequired       bool
	ManagedMode          bool
	RetentionDays        int
	RetentionMinimumDays int
	RetentionMaximumDays int
	RetentionCSRFToken   string
	Notice               string
	Error                string
}

type AdminSecurityVerificationData struct {
	Required               bool
	Open                   bool
	HasTOTP                bool
	HasPasskey             bool
	ReturnTo               string
	TOTPPath               string
	TOTPCSRFToken          string
	PasskeyStartPath       string
	PasskeyFinishPath      string
	PasskeyStartCSRFToken  string
	PasskeyFinishCSRFToken string
}

func adminSecurityVerificationValue(values []AdminSecurityVerificationData) AdminSecurityVerificationData {
	if len(values) == 0 {
		return AdminSecurityVerificationData{}
	}
	return values[0]
}

func adminUserUsername(ctx context.Context, username string) string {
	if strings.TrimSpace(username) == "" {
		return i18n.T(ctx, "admin.users.no_username")
	}
	return username
}

// adminValueLabel shows a user's status, role or 2FA value, which the
// handler sends as a code, in the page's language. The English names are
// what the handler sent before codes.
func adminValueLabel(ctx context.Context, value string) string {
	switch value {
	case "active", "Active":
		return i18n.T(ctx, "admin.value.active")
	case "pending", "Pending":
		return i18n.T(ctx, "admin.value.pending")
	case "disabled", "Disabled":
		return i18n.T(ctx, "admin.value.disabled")
	case "webmail_user", "Webmail user":
		return i18n.T(ctx, "admin.value.webmail_user")
	case "management_admin", "Management administrator":
		return i18n.T(ctx, "admin.value.management_admin")
	case "management_user", "Management user":
		return i18n.T(ctx, "admin.value.management_user")
	case "legacy", "Legacy mixed account":
		return i18n.T(ctx, "admin.value.legacy")
	case "optional", "Optional":
		return i18n.T(ctx, "admin.value.optional")
	case "required", "Required":
		return i18n.T(ctx, "admin.value.required")
	case "user_choice", "User choice":
		return i18n.T(ctx, "admin.value.user_choice")
	case "management_policy", "Management policy":
		return i18n.T(ctx, "admin.value.management_policy")
	case "individual_policy", "Individual policy":
		return i18n.T(ctx, "admin.value.individual_policy")
	case "instance_policy", "Instance policy":
		return i18n.T(ctx, "admin.value.instance_policy")
	}
	return value
}

func adminUserInvitationFieldError(data AdminUserInvitationFormData, field string) string {
	if data.FieldErrors == nil {
		return ""
	}
	return data.FieldErrors[field]
}

func adminUserInvitationFormOpen(data AdminUserInvitationFormData) bool {
	return len(data.FieldErrors) != 0 || strings.TrimSpace(data.Name) != "" ||
		strings.TrimSpace(data.Username) != ""
}

func adminUserInvitationCopyText(ctx context.Context, data *AdminUserInvitationData) string {
	if data == nil {
		return ""
	}
	return i18n.T(ctx, "admin.invite.copy_text", "username", data.Username, "url", data.RedemptionURL, "token", data.Token, "expires", adminDateTimeZone(ctx, data.ExpiresAt))
}

func adminUserCredentialResetCopyText(ctx context.Context, data *AdminUserCredentialResetData) string {
	if data == nil {
		return ""
	}
	return i18n.T(ctx, "admin.reset.copy_text", "username", data.Username, "url", data.RedemptionURL, "token", data.Token, "expires", adminDateTimeZone(ctx, data.ExpiresAt))
}

func adminUserInvitationStateLabel(ctx context.Context, state string) string {
	switch state {
	case "active":
		return i18n.T(ctx, "admin.invite.state.active")
	case "expired":
		return i18n.T(ctx, "admin.invite.state.expired")
	case "revoked":
		return i18n.T(ctx, "admin.invite.state.revoked")
	default:
		return i18n.T(ctx, "admin.invite.state.none")
	}
}

func adminUserInvitationDialogID(prefix string, user AdminUserData) string {
	reference := strings.TrimSuffix(
		strings.TrimPrefix(user.InvitationRotatePath, "/admin/users/invitations/"),
		"/rotate",
	)
	return prefix + "-" + user.InvitationState + "-" + reference
}

func adminSecurityActivityPagePath(filter string, page int64) templ.SafeURL {
	values := url.Values{}
	if filter != "" {
		values.Set("filter", filter)
	}
	if page > 1 {
		values.Set("page", fmt.Sprintf("%d", page))
	}
	if len(values) == 0 {
		return templ.URL("/admin/activity")
	}
	return templ.URL("/admin/activity?" + values.Encode())
}

templ adminSecurityActivityFilterLink(data AdminSecurityActivityData, value string, label string) {
	<a
		href={ adminSecurityActivityPagePath(value, 1) }
		data-admin-navigation-link
		data-admin-navigation-label={ i18n.T(ctx, "admin.activity.filter_nav", "filter", strings.ToLower(label)) }
		if data.Filter == value {
			aria-current="page"
		}
		class={
			"inline-flex h-9 items-center justify-center rounded-full border px-3 text-xs font-semibold transition-colors",
			templ.KV("border-primary/30 bg-primary/10 text-primary", data.Filter == value),
			templ.KV("border-border bg-background text-muted-foreground hover:bg-accent hover:text-foreground", data.Filter != value),
		}
	>{ label }</a>
}

templ AdminSecurityVerificationTrigger(data AdminSecurityVerificationData, label string) {
	if data.Required {
		@dialog.Trigger(dialog.TriggerProps{For: "admin-security-verification-dialog"}) {
			<button type="button" class="inline-flex h-9 items-center justify-center gap-2 rounded-md border border-amber-500/40 bg-background px-3 text-sm font-semibold text-foreground transition-colors hover:bg-accent">
				@icon.ShieldCheck(icon.Props{Class: "size-4 text-amber-700 dark:text-amber-300"})
				{ label }
			</button>
		}
	}
}

templ AdminSecurityVerificationDialog(data AdminSecurityVerificationData) {
	if data.Required {
		@dialog.Dialog(dialog.Props{ID: "admin-security-verification-dialog", Open: data.Open}) {
			@dialog.Content(dialog.ContentProps{Class: "sm:max-w-2xl max-h-[calc(100vh-2rem)] overflow-y-auto", DisableModal: true, Attributes: templ.Attributes{"style": "box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.5)"}}) {
				@dialog.Header() {
					@dialog.Title() {
						{ i18n.T(ctx, "admin.verify.title") }
					}
					@dialog.Description() {
						{ i18n.T(ctx, "admin.verify.description") }
					}
				}
				<div
					data-admin-security-verification
					class={
						templ.Classes(
							"grid gap-4",
							templ.KV("sm:grid-cols-2", data.HasPasskey && data.HasTOTP),
						),
					}
				>
					if data.HasPasskey {
						<form
							data-passkey-authentication
							data-start-path={ data.PasskeyStartPath }
							data-finish-path={ data.PasskeyFinishPath }
							data-start-csrf={ data.PasskeyStartCSRFToken }
							data-finish-csrf={ data.PasskeyFinishCSRFToken }
							data-success-redirect={ data.ReturnTo }
							data-fallback={ i18n.T(ctx, "security.verify.fallback") }
							class="space-y-4 rounded-lg border border-border bg-background/60 p-4"
						>
							<div class="flex items-start gap-3">
								<div class="rounded-md bg-primary/10 p-2 text-primary">
									@icon.KeyRound(icon.Props{Class: "size-5"})
								</div>
								<div>
									<p class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "security.passkey") }</p>
									<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.verify.passkey_detail") }</p>
								</div>
							</div>
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 disabled:cursor-not-allowed disabled:opacity-60">{ i18n.T(ctx, "security.verify.passkey_button") }</button>
							<p data-passkey-authentication-status role="status" aria-live="polite" class="min-h-4 text-xs text-muted-foreground"></p>
						</form>
					}
					if data.HasTOTP {
						<form
							method="post"
							action={ templ.SafeURL(data.TOTPPath) }
							data-admin-security-totp
							autocomplete="on"
							data-success-redirect={ data.ReturnTo }
							class="space-y-4 rounded-lg border border-border bg-background/60 p-4"
						>
							<input type="hidden" name="_csrf" value={ data.TOTPCSRFToken }/>
							<input type="hidden" name="return_to" value={ data.ReturnTo }/>
							<div class="flex items-start gap-3">
								<div class="rounded-md bg-primary/10 p-2 text-primary">
									@icon.Smartphone(icon.Props{Class: "size-5"})
								</div>
								<div class="min-w-0 flex-1">
									<label for="admin-security-totp-code" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "security.verify.code") }</label>
									<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.verify.code_detail") }</p>
								</div>
							</div>
							<input
								id="admin-security-totp-code"
								autofocus
								aria-label={ i18n.T(ctx, "security.verify.code") }
								name="code"
								type="text"
								inputmode="numeric"
								autocomplete="one-time-code"
								pattern="[0-9]{6}"
								minlength="6"
								maxlength="6"
								required
								class="h-10 w-full rounded-md border border-input bg-background px-3 text-center font-mono text-base tracking-[0.3em] text-foreground shadow-sm outline-none transition-colors focus:border-ring focus:ring-2 focus:ring-ring/25"
							/>
							<button type="submit" class="inline-flex h-10 w-full items-center justify-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground shadow-sm transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-60">{ i18n.T(ctx, "security.verify.code_button") }</button>
							<p data-admin-security-totp-status role="status" aria-live="polite" class="min-h-4 text-xs text-muted-foreground"></p>
						</form>
					}
					if !data.HasTOTP && !data.HasPasskey {
						<div class="rounded-lg border border-border bg-background/60 p-4">
							<p class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.verify.sign_in_again") }</p>
							<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.verify.none") }</p>
							<a href="/admin/login" class="mt-4 inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">{ i18n.T(ctx, "admin.verify.go_sign_in") }</a>
						</div>
					}
				</div>
			}
		}
	}
}

templ AdminSidebar(activeSection string) {
	<aside class="hidden lg:flex w-64 shrink-0 flex-col border-r border-border bg-card/75 backdrop-blur-sm">
		<div class="px-5 py-5 border-b border-border">
			<a href="/admin" class="inline-flex items-center gap-2.5 text-foreground hover:text-primary transition-colors">
				<img src={ assetver.URL("/assets/logo.svg") } alt="Gofer" class="h-8 w-8 shrink-0"/>
				<span class="text-lg font-bold tracking-tight" style="font-family: var(--font-serif)">Gofer Admin</span>
			</a>
			<p class="mt-2 text-xs text-muted-foreground leading-relaxed">{ i18n.T(ctx, "admin.sidebar.description") }</p>
		</div>
		<nav class="flex-1 px-3 py-4 space-y-1">
			<a
				href="/admin/users"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.users") }
				aria-current?={ activeSection == "users" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "users"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "users"),
				}
			>
				@icon.Users(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.users") }
			</a>
			<a
				href="/admin/activity"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.activity") }
				aria-current?={ activeSection == "activity" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "activity"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "activity"),
				}
			>
				@icon.History(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.activity") }
			</a>
			<a
				href="/admin/avatars/"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.avatars") }
				aria-current?={ activeSection == "avatars" || activeSection == "" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "avatars" || activeSection == ""),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "avatars" && activeSection != ""),
				}
			>
				@icon.Activity(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.avatars") }
			</a>
			<a
				href="/admin/contacts"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.contacts") }
				aria-current?={ activeSection == "contacts" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "contacts"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "contacts"),
				}
			>
				@icon.BookUser(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.contacts") }
			</a>
			<a
				href="/admin/labels"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.labels") }
				aria-current?={ activeSection == "labels" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "labels"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "labels"),
				}
			>
				@icon.Tags(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.labels") }
			</a>
			<a
				href="/admin/operations"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.operations") }
				aria-current?={ activeSection == "operations" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "operations"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "operations"),
				}
			>
				@icon.ClipboardList(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.operations") }
			</a>
			<a
				href="/admin/security"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.security") }
				aria-current?={ activeSection == "security" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "security"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "security"),
				}
			>
				@icon.ShieldAlert(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.security") }
			</a>
			<a
				href="/admin/account/security"
				data-admin-navigation-link
				data-admin-navigation-label={ i18n.T(ctx, "admin.nav.account_security") }
				aria-current?={ activeSection == "account-security" }
				class={
					"flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
					templ.KV("bg-accent font-semibold text-foreground", activeSection == "account-security"),
					templ.KV("text-muted-foreground hover:bg-accent hover:text-foreground", activeSection != "account-security"),
				}
			>
				@icon.ShieldCheck(icon.Props{Class: "size-4 text-primary"})
				{ i18n.T(ctx, "admin.nav.account_security") }
			</a>
		</nav>
		<div class="px-5 py-4 border-t border-border">
			<p class="px-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.sidebar.workspace") }</p>
		</div>
	</aside>
}

templ AdminSecurityActivityPage(data AdminSecurityActivityData, verification ...AdminSecurityVerificationData) {
	<div class="flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden" data-admin-security-activity>
		<div class="min-h-0 flex-1 overflow-y-auto" data-admin-security-activity-scroll>
			<div class="max-w-7xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
					<div>
						<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.activity") }</h2>
						<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.activity.description") }</p>
					</div>
					<div class="flex shrink-0 items-center gap-3">
						<span class="w-fit shrink-0 rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">
							if data.Filter == "" {
								{ i18n.N(ctx, "admin.activity.events", int(data.TotalEvents), "count", i18n.Number(ctx, int(data.TotalEvents))) }
							} else {
								{ i18n.N(ctx, "admin.activity.matching", int(data.TotalEvents), "count", i18n.Number(ctx, int(data.TotalEvents))) }
							}
						</span>
						if data.ManagedMode && !data.StepUpRequired {
							@dialog.Trigger(dialog.TriggerProps{For: "admin-security-retention-dialog"}) {
								<button type="button" aria-haspopup="dialog" class="inline-flex h-9 items-center justify-center gap-2 rounded-md border border-border bg-background px-3 text-sm font-medium text-foreground transition-colors hover:bg-accent">
									@icon.Settings(icon.Props{Class: "size-4"})
									{ i18n.T(ctx, "admin.activity.settings") }
								</button>
							}
						}
					</div>
				</div>
				if data.Notice != "" && (!data.ManagedMode || data.StepUpRequired) {
					<div class="mt-5 rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm font-medium text-emerald-800 dark:text-emerald-200">{ data.Notice }</div>
				}
				if data.Error != "" && (!data.ManagedMode || data.StepUpRequired) {
					<div class="mt-5 rounded-lg border border-red-500/25 bg-red-500/10 px-4 py-3 text-sm font-medium text-red-800 dark:text-red-200">{ data.Error }</div>
				}
				if !data.ManagedMode {
					<div role="status" class="mt-6 rounded-lg border border-border bg-card px-5 py-8 text-center">
						<p class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.activity.unmanaged_title") }</p>
						<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.activity.unmanaged") }</p>
					</div>
				} else if data.StepUpRequired {
					<div role="alert" class="mt-6 rounded-lg border border-amber-500/30 bg-amber-500/10 px-5 py-5 text-amber-900 dark:text-amber-100" data-admin-security-activity-locked>
						<p class="font-semibold">{ i18n.T(ctx, "admin.verify.required") }</p>
						<p class="mt-1 text-sm">{ i18n.T(ctx, "admin.activity.verify") }</p>
						<div class="mt-4">
							@AdminSecurityVerificationTrigger(adminSecurityVerificationValue(verification), i18n.T(ctx, "admin.verify.now"))
						</div>
					</div>
				} else {
					@AdminSecurityRetentionDialog(data)
					<nav class="mt-6 flex flex-wrap gap-2" aria-label={ i18n.T(ctx, "admin.activity.filter_label") }>
						@adminSecurityActivityFilterLink(data, "", i18n.T(ctx, "admin.activity.filter.all"))
						@adminSecurityActivityFilterLink(data, "failures", i18n.T(ctx, "admin.activity.filter.failures"))
						@adminSecurityActivityFilterLink(data, "recovery", i18n.T(ctx, "admin.activity.filter.recovery"))
						@adminSecurityActivityFilterLink(data, "policy", i18n.T(ctx, "admin.activity.filter.policy"))
						@adminSecurityActivityFilterLink(data, "identities", i18n.T(ctx, "admin.activity.filter.identities"))
						@adminSecurityActivityFilterLink(data, "sessions", i18n.T(ctx, "admin.activity.filter.sessions"))
					</nav>
					<section class="mt-6 overflow-hidden rounded-lg border border-border bg-card" aria-labelledby="admin-security-events-heading">
						<div class="flex flex-col gap-1 border-b border-border px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
							<h3 id="admin-security-events-heading" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.activity.events_heading") }</h3>
							if len(data.Events) > 0 {
								<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.activity.showing", "first", i18n.Number(ctx, int(data.FirstEvent)), "last", i18n.Number(ctx, int(data.LastEvent)), "total", i18n.Number(ctx, int(data.TotalEvents))) }</span>
							}
						</div>
						if len(data.Events) == 0 {
							<div class="px-4 py-10 text-center text-sm text-muted-foreground">
								if data.Filter == "" {
									{ i18n.T(ctx, "admin.activity.empty") }
								} else {
									{ i18n.T(ctx, "admin.activity.empty_filter") }
								}
							</div>
						} else {
							<div class="overflow-x-auto">
								<table class="w-full min-w-[72rem] text-left text-sm" aria-label={ i18n.T(ctx, "admin.activity.table_label") }>
									<thead class="bg-muted/45 text-xs font-semibold text-muted-foreground">
										<tr>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.time") }</th>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.event") }</th>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.status") }</th>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.actor") }</th>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.subject") }</th>
											<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.client") }</th>
										</tr>
									</thead>
									<tbody class="divide-y divide-border">
										for _, event := range data.Events {
											<tr class="bg-background/35 align-top hover:bg-accent/35">
												<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">{ event.OccurredAt }</td>
												<td class="px-4 py-3">
													<p class="font-semibold text-foreground">{ event.Title }</p>
													<p class="mt-1 text-xs text-muted-foreground">{ event.Detail }</p>
												</td>
												<td class="px-4 py-3">
													<span
														class={
															"inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold",
															templ.KV("border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200", event.Successful),
															templ.KV("border-destructive/30 bg-destructive/10 text-destructive", !event.Successful),
														}
													>{ event.Status }</span>
												</td>
												<td class="px-4 py-3 font-medium text-foreground">{ event.Actor }</td>
												<td class="px-4 py-3">
													<span class="font-medium text-foreground">{ event.Subject }</span>
													if event.SubjectDeleted {
														<span class="ml-1.5 rounded-full border border-border bg-muted px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "admin.activity.deleted") }</span>
													}
												</td>
												<td class="max-w-xs break-words px-4 py-3 text-xs text-muted-foreground">{ event.Client }</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</section>
					if data.TotalPages > 1 {
						<nav class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" aria-label={ i18n.T(ctx, "admin.activity.pagination") }>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.page_of", "page", i18n.Number(ctx, int(data.Page)), "total", i18n.Number(ctx, int(data.TotalPages))) }</p>
							<div class="flex items-center gap-2">
								if data.HasPrevious {
									<a href={ adminSecurityActivityPagePath(data.Filter, data.PreviousPage) } data-admin-navigation-link data-admin-navigation-label={ i18n.T(ctx, "admin.activity.previous_nav") } class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent">{ i18n.T(ctx, "common.previous") }</a>
								} else {
									<span class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-muted px-3 text-xs font-semibold text-muted-foreground opacity-60" aria-disabled="true">{ i18n.T(ctx, "common.previous") }</span>
								}
								if data.HasNext {
									<a href={ adminSecurityActivityPagePath(data.Filter, data.NextPage) } data-admin-navigation-link data-admin-navigation-label={ i18n.T(ctx, "admin.activity.next_nav") } class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-semibold text-foreground hover:bg-accent">{ i18n.T(ctx, "common.next") }</a>
								} else {
									<span class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-muted px-3 text-xs font-semibold text-muted-foreground opacity-60" aria-disabled="true">{ i18n.T(ctx, "common.next") }</span>
								}
							</div>
						</nav>
					}
					<p class="mt-5 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.activity.privacy") }</p>
				}
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

templ AdminSecurityRetentionDialog(data AdminSecurityActivityData) {
	@dialog.Dialog(dialog.Props{ID: "admin-security-retention-dialog", Open: data.Notice != "" || data.Error != ""}) {
		@dialog.Content(dialog.ContentProps{Class: "max-h-[calc(100vh-2rem)] overflow-y-auto"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.retention.title") }
				}
				@dialog.Description() {
					{ i18n.N(ctx, "admin.retention.current", data.RetentionDays) }
				}
			}
			<form method="post" action="/admin/activity/retention" class="space-y-4" data-admin-security-retention>
				if data.RetentionCSRFToken != "" {
					<input type="hidden" name="_csrf" value={ data.RetentionCSRFToken }/>
				}
				if data.Notice != "" {
					<p role="status" class="text-sm text-emerald-800 dark:text-emerald-200">{ data.Notice }</p>
				}
				if data.Error != "" {
					<p role="alert" class="text-sm text-destructive">{ data.Error }</p>
				}
				<div>
					<label for="admin-security-retention-days" class="mb-1.5 block text-sm font-medium text-foreground">{ i18n.T(ctx, "admin.retention.label") }</label>
					<input
						id="admin-security-retention-days"
						name="days"
						type="number"
						min={ fmt.Sprintf("%d", data.RetentionMinimumDays) }
						max={ fmt.Sprintf("%d", data.RetentionMaximumDays) }
						value={ fmt.Sprintf("%d", data.RetentionDays) }
						aria-describedby="admin-security-retention-help"
						required
						class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm tabular-nums text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"
					/>
					<p id="admin-security-retention-help" class="mt-2 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.retention.help", "min", data.RetentionMinimumDays, "max", data.RetentionMaximumDays) }</p>
				</div>
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "admin.retention.note") }</p>
				@dialog.Footer() {
					@dialog.Close() {
						<button type="button" class="inline-flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-sm font-medium text-foreground hover:bg-accent">{ i18n.T(ctx, "common.cancel") }</button>
					}
					<button type="submit" class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-3 text-sm font-semibold text-primary-foreground hover:bg-primary/90">{ i18n.T(ctx, "admin.retention.save") }</button>
				}
			</form>
		}
	}
}

templ AdminNavigationLoading() {
	<div
		data-admin-navigation-loading
		class="absolute inset-0 z-50 hidden items-center justify-center bg-background/80 px-6 backdrop-blur-sm"
		role="status"
		aria-live="polite"
		aria-hidden="true"
	>
		<div class="flex items-center gap-3 rounded-lg border border-border bg-card px-4 py-3 text-sm font-semibold text-foreground shadow-lg">
			@icon.LoaderCircle(icon.Props{Class: "size-5 animate-spin text-primary"})
			<span data-admin-navigation-loading-label>{ i18n.T(ctx, "admin.loading_section") }</span>
		</div>
	</div>
}

templ AdminUsersPage(data AdminUsersData, verification ...AdminSecurityVerificationData) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden" data-admin-users>
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
					<div>
						<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.users") }</h2>
						<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.users.description") }</p>
					</div>
					<div class="flex flex-wrap items-center gap-2">
						@dialog.Trigger(dialog.TriggerProps{For: "admin-user-invitation-dialog"}) {
							@button.Button(button.Props{Disabled: data.StepUpRequired}) {
								@icon.UserPlus(icon.Props{Class: "size-4"})
								{ i18n.T(ctx, "admin.users.invite") }
							}
						}
						<span class="w-fit shrink-0 rounded-full border border-border bg-muted px-2.5 py-1 text-xs font-semibold text-muted-foreground">{ i18n.N(ctx, "admin.users.count", data.Total, "count", i18n.Number(ctx, data.Total)) }</span>
					</div>
				</div>
				if data.Error != "" {
					<div role="alert" class="mt-5 rounded-lg border border-destructive/25 bg-destructive/10 px-4 py-3 text-sm font-medium text-destructive">{ data.Error }</div>
				}
				if data.Notice != "" {
					<div role="status" class="mt-5 rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm font-medium text-emerald-800 dark:text-emerald-200">{ data.Notice }</div>
				}
				if data.StepUpRequired {
					<div role="alert" class="mt-5 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-900 dark:text-amber-100">
						<p class="font-semibold">{ i18n.T(ctx, "admin.verify.required") }</p>
						<p class="mt-1">{ i18n.T(ctx, "admin.users.verify") }</p>
						<div class="mt-3">
							@AdminSecurityVerificationTrigger(adminSecurityVerificationValue(verification), i18n.T(ctx, "admin.verify.now"))
						</div>
					</div>
				}
				@AdminUserInvitationDialog(data)
				if data.Invitation != nil {
					@AdminUserInvitationResultDialog(data.Invitation)
				}
				if data.CredentialReset != nil {
					@AdminUserCredentialResetResultDialog(data.CredentialReset)
				}
				<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label={ i18n.T(ctx, "admin.users.summary") }>
					<div class="rounded-lg border border-border bg-card px-4 py-3">
						<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "admin.users.stat.active") }</p>
						<p class="mt-1 text-xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, data.Active) }</p>
					</div>
					<div class="rounded-lg border border-border bg-card px-4 py-3">
						<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "admin.users.stat.pending") }</p>
						<p class="mt-1 text-xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, data.Pending) }</p>
					</div>
					<div class="rounded-lg border border-border bg-card px-4 py-3">
						<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "admin.users.stat.disabled") }</p>
						<p class="mt-1 text-xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, data.Disabled) }</p>
					</div>
					<div class="rounded-lg border border-border bg-card px-4 py-3">
						<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "admin.users.stat.admins") }</p>
						<p class="mt-1 text-xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, data.Administrators) }</p>
					</div>
				</div>
				<section class="mt-6 overflow-hidden rounded-lg border border-border bg-card" aria-labelledby="admin-users-heading">
					<div class="flex items-center justify-between gap-4 border-b border-border px-4 py-3">
						<h3 id="admin-users-heading" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.users.heading") }</h3>
						<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.users.heading_detail") }</span>
					</div>
					if len(data.Users) == 0 {
						<div class="px-4 py-10 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "admin.users.empty") }</div>
					} else {
						<div class="overflow-x-auto">
							<table class="w-full min-w-[70rem] text-left text-sm">
								<thead class="bg-muted/45 text-xs font-semibold text-muted-foreground">
									<tr>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.user") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.status") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.role") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.mfa") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.invitation") }</th>
										<th scope="col" class="px-4 py-3 text-right">{ i18n.T(ctx, "admin.col.actions") }</th>
										<th scope="col" class="px-4 py-3">{ i18n.T(ctx, "admin.col.user_id") }</th>
									</tr>
								</thead>
								<tbody class="divide-y divide-border">
									for _, user := range data.Users {
										<tr class="bg-background/35 align-top hover:bg-accent/35">
											<td class="px-4 py-3">
												<div class="flex flex-wrap items-center gap-2">
													<span class="font-semibold text-foreground">{ adminUserUsername(ctx, user.Username) }</span>
													if user.Current {
														<span class="rounded-full border border-primary/25 bg-primary/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-primary">{ i18n.T(ctx, "admin.users.you") }</span>
													}
												</div>
											</td>
											<td class="px-4 py-3">
												<span
													class={
														"inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold",
														templ.KV("border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200", user.Status == "active"),
														templ.KV("border-amber-500/30 bg-amber-500/10 text-amber-800 dark:text-amber-200", user.Status == "pending"),
														templ.KV("border-destructive/30 bg-destructive/10 text-destructive", user.Status == "disabled"),
													}
												>
													if user.DeletionPending {
														{ i18n.T(ctx, "admin.users.deleting") }
													} else {
														{ adminValueLabel(ctx, user.Status) }
													}
												</span>
											</td>
											<td class="px-4 py-3">
												<span
													class={
														"inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold",
														templ.KV("border-primary/30 bg-primary/10 text-primary", user.Role == "management_admin"),
														templ.KV("border-border bg-muted text-muted-foreground", user.Role == "management_user"),
													}
												>{ adminValueLabel(ctx, user.Role) }</span>
											</td>
											<td class="px-4 py-3">
												<span
													class={
														"inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold",
														templ.KV("border-primary/30 bg-primary/10 text-primary", user.MFALabel == "required"),
														templ.KV("border-border bg-muted text-muted-foreground", user.MFALabel != "required"),
													}
												>{ adminValueLabel(ctx, user.MFALabel) }</span>
												<p class="mt-1 whitespace-nowrap text-xs text-muted-foreground">{ adminValueLabel(ctx, user.MFADetail) }</p>
												@AdminUserMFAPolicyAction(user, data.StepUpRequired)
											</td>
											<td class="px-4 py-3">
												if user.InvitationRotatePath == "" {
													<span class="text-xs text-muted-foreground">—</span>
												} else {
													<span
														class={
															"inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold",
															templ.KV("border-emerald-500/30 bg-emerald-500/10 text-emerald-800 dark:text-emerald-200", user.InvitationState == "active"),
															templ.KV("border-amber-500/30 bg-amber-500/10 text-amber-800 dark:text-amber-200", user.InvitationState == "expired"),
															templ.KV("border-destructive/30 bg-destructive/10 text-destructive", user.InvitationState == "revoked"),
															templ.KV("border-border bg-muted text-muted-foreground", user.InvitationState == "not_issued"),
														}
													>{ adminUserInvitationStateLabel(ctx, user.InvitationState) }</span>
													if user.InvitationExpiresAt != nil {
														<p class="mt-1 whitespace-nowrap text-xs text-muted-foreground">
															if user.InvitationState == "active" {
																{ i18n.T(ctx, "admin.invite.expires", "date", i18n.Dates(ctx).ShortDateTime(user.InvitationExpiresAt.Local())) }
															} else {
																{ i18n.T(ctx, "admin.invite.expired_at", "date", i18n.Dates(ctx).ShortDateTime(user.InvitationExpiresAt.Local())) }
															}
														</p>
													}
												}
											</td>
											<td class="px-4 py-3 text-right">
												if user.InvitationRotatePath == "" && user.CredentialResetPath == "" && user.StatusPath == "" && user.DeletionPath == "" {
													<span class="text-xs text-muted-foreground">—</span>
												} else {
													<div class="flex flex-col items-end gap-2">
														if user.PasswordChangeRequired {
															<span class="inline-flex rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "admin.users.password_change_required") }</span>
														}
														if user.PasswordResetRequestedAt != nil {
															<div>
																<span class="inline-flex rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "admin.users.reset_requested") }</span>
																<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.users.requested_at", "date", i18n.Dates(ctx).ShortDateTime(user.PasswordResetRequestedAt.Local())) }</p>
															</div>
														}
														<div class="flex items-center justify-end gap-2">
															@AdminUserInvitationActions(user, data.StepUpRequired)
															@AdminUserCredentialResetAction(user, data.StepUpRequired)
															@AdminUserStatusAction(user, data.StepUpRequired)
															@AdminUserDeletionAction(user, data.StepUpRequired)
														</div>
													</div>
												}
											</td>
											<td class="px-4 py-3"><code class="break-all font-mono text-xs text-muted-foreground">{ user.ID }</code></td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
				<p class="mt-4 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.users.privacy") }</p>
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

func adminUserMFAPolicyDialogID(user AdminUserData) string {
	return "admin-user-mfa-policy-" + strings.NewReplacer("/", "-", " ", "-").Replace(user.ID)
}

func adminUserMFAPolicyButtonVariant(user AdminUserData) button.Variant {
	if user.MFARequired {
		return button.VariantDestructive
	}
	return button.VariantDefault
}

templ AdminUserMFAPolicyAction(user AdminUserData, stepUpRequired bool) {
	if user.MFAPolicyPath != "" {
		{{ policyDialogID := adminUserMFAPolicyDialogID(user) }}
		<div class="mt-2">
			@dialog.Trigger(dialog.TriggerProps{For: policyDialogID}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Disabled: stepUpRequired || user.MFAPolicyCSRFToken == ""}) {
					if user.MFARequired {
						{ i18n.T(ctx, "admin.mfa.clear") }
					} else {
						{ i18n.T(ctx, "admin.mfa.require") }
					}
				}
			}
			@dialog.Dialog(dialog.Props{ID: policyDialogID}) {
				@dialog.Content() {
					@dialog.Header() {
						@dialog.Title() {
							if user.MFARequired {
								{ i18n.T(ctx, "admin.mfa.clear_title") }
							} else {
								{ i18n.T(ctx, "admin.mfa.require_title", "user", adminUserUsername(ctx, user.Username)) }
							}
						}
						@dialog.Description() {
							if user.MFARequired {
								{ i18n.T(ctx, "admin.mfa.clear_detail") }
							} else {
								{ i18n.T(ctx, "admin.mfa.require_detail") }
							}
						}
					}
					<form method="post" action={ user.MFAPolicyPath }>
						<input type="hidden" name="_csrf" value={ user.MFAPolicyCSRFToken }/>
						<input type="hidden" name="required" value={ fmt.Sprintf("%t", !user.MFARequired) }/>
						@dialog.Footer() {
							@dialog.Close() {
								@button.Button(button.Props{Variant: button.VariantOutline}) {
									{ i18n.T(ctx, "common.cancel") }
								}
							}
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: adminUserMFAPolicyButtonVariant(user)}) {
								if user.MFARequired {
									{ i18n.T(ctx, "admin.mfa.clear") }
								} else {
									{ i18n.T(ctx, "admin.mfa.require") }
								}
							}
						}
					</form>
				}
			}
		</div>
	}
}

templ AdminUserInvitationActions(user AdminUserData, stepUpRequired bool) {
	if user.InvitationRotatePath != "" {
		<div class="contents">
			if user.InvitationState == "active" {
				{{ revokeDialogID := adminUserInvitationDialogID("admin-invitation-revoke", user) }}
				@dialog.Trigger(dialog.TriggerProps{For: revokeDialogID}) {
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Disabled: stepUpRequired || user.InvitationRevokeCSRFToken == ""}) {
						{ i18n.T(ctx, "admin.invite.revoke") }
					}
				}
				@dialog.Dialog(dialog.Props{ID: revokeDialogID}) {
					@dialog.Content() {
						@dialog.Header() {
							@dialog.Title() {
								{ i18n.T(ctx, "admin.invite.revoke_title") }
							}
							@dialog.Description() {
								{ i18n.T(ctx, "admin.invite.revoke_detail", "user", adminUserUsername(ctx, user.Username)) }
							}
						}
						<form method="post" action={ user.InvitationRevokePath }>
							<input type="hidden" name="_csrf" value={ user.InvitationRevokeCSRFToken }/>
							@dialog.Footer() {
								@dialog.Close() {
									@button.Button(button.Props{Variant: button.VariantOutline}) {
										{ i18n.T(ctx, "common.cancel") }
									}
								}
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
									{ i18n.T(ctx, "admin.invite.revoke_button") }
								}
							}
						</form>
					}
				}
				{{ rotateDialogID := adminUserInvitationDialogID("admin-invitation-rotate", user) }}
				@dialog.Trigger(dialog.TriggerProps{For: rotateDialogID}) {
					@button.Button(button.Props{Size: button.SizeSm, Disabled: stepUpRequired || user.InvitationRotateCSRFToken == ""}) {
						{ i18n.T(ctx, "admin.invite.rotate") }
					}
				}
				@dialog.Dialog(dialog.Props{ID: rotateDialogID}) {
					@dialog.Content() {
						@dialog.Header() {
							@dialog.Title() {
								{ i18n.T(ctx, "admin.invite.rotate_title") }
							}
							@dialog.Description() {
								{ i18n.T(ctx, "admin.invite.rotate_detail", "user", adminUserUsername(ctx, user.Username)) }
							}
						}
						<form method="post" action={ user.InvitationRotatePath }>
							<input type="hidden" name="_csrf" value={ user.InvitationRotateCSRFToken }/>
							@dialog.Footer() {
								@dialog.Close() {
									@button.Button(button.Props{Variant: button.VariantOutline}) {
										{ i18n.T(ctx, "common.cancel") }
									}
								}
								@button.Button(button.Props{Type: button.TypeSubmit}) {
									{ i18n.T(ctx, "admin.invite.rotate_button") }
								}
							}
						</form>
					}
				}
			} else {
				<form method="post" action={ user.InvitationRotatePath }>
					<input type="hidden" name="_csrf" value={ user.InvitationRotateCSRFToken }/>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Disabled: stepUpRequired || user.InvitationRotateCSRFToken == ""}) {
						{ i18n.T(ctx, "admin.invite.issue") }
					}
				</form>
			}
		</div>
	}
}

func adminUserStatusDialogID(user AdminUserData) string {
	return "admin-user-status-" + strings.NewReplacer("/", "-", " ", "-").Replace(user.ID)
}

templ AdminUserStatusAction(user AdminUserData, stepUpRequired bool) {
	if user.StatusPath != "" {
		{{ statusDialogID := adminUserStatusDialogID(user) }}
		@dialog.Trigger(dialog.TriggerProps{For: statusDialogID}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Disabled: stepUpRequired || user.StatusCSRFToken == ""}) {
				if user.Status == "disabled" {
					{ i18n.T(ctx, "admin.users.enable") }
				} else {
					{ i18n.T(ctx, "admin.users.disable") }
				}
			}
		}
		@dialog.Dialog(dialog.Props{ID: statusDialogID}) {
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						if user.Status == "disabled" {
							{ i18n.T(ctx, "admin.users.enable_title", "user", adminUserUsername(ctx, user.Username)) }
						} else {
							{ i18n.T(ctx, "admin.users.disable_title", "user", adminUserUsername(ctx, user.Username)) }
						}
					}
					@dialog.Description() {
						if user.Status == "disabled" {
							{ i18n.T(ctx, "admin.users.enable_detail") }
						} else {
							{ i18n.T(ctx, "admin.users.disable_detail") }
						}
					}
				}
				<form method="post" action={ user.StatusPath }>
					<input type="hidden" name="_csrf" value={ user.StatusCSRFToken }/>
					if user.Status == "disabled" {
						<input type="hidden" name="status" value="active"/>
					} else {
						<input type="hidden" name="status" value="disabled"/>
					}
					@dialog.Footer() {
						@dialog.Close() {
							@button.Button(button.Props{Variant: button.VariantOutline}) {
								{ i18n.T(ctx, "common.cancel") }
							}
						}
						if user.Status == "disabled" {
							@button.Button(button.Props{Type: button.TypeSubmit}) {
								{ i18n.T(ctx, "admin.users.enable_button") }
							}
						} else {
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
								{ i18n.T(ctx, "admin.users.disable_button") }
							}
						}
					}
				</form>
			}
		}
	}
}

func adminUserDeletionDialogID(user AdminUserData) string {
	return "admin-user-delete-" + strings.NewReplacer("/", "-", " ", "-").Replace(user.ID)
}

templ AdminUserDeletionAction(user AdminUserData, stepUpRequired bool) {
	if user.DeletionPath != "" {
		{{ deletionDialogID := adminUserDeletionDialogID(user) }}
		@dialog.Trigger(dialog.TriggerProps{For: deletionDialogID}) {
			@button.Button(button.Props{Variant: button.VariantDestructive, Size: button.SizeSm, Disabled: stepUpRequired || user.DeletionCSRFToken == ""}) {
				if user.DeletionPending {
					{ i18n.T(ctx, "admin.delete.retry") }
				} else {
					{ i18n.T(ctx, "admin.delete.button") }
				}
			}
		}
		@dialog.Dialog(dialog.Props{ID: deletionDialogID}) {
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						{ i18n.T(ctx, "admin.delete.title", "user", adminUserUsername(ctx, user.Username)) }
					}
					@dialog.Description() {
						{ i18n.T(ctx, "admin.delete.description") }
					}
				}
				<div class="space-y-4 text-sm text-foreground">
					<div class="rounded-lg border border-destructive/25 bg-destructive/5 px-4 py-3">
						<p class="font-semibold text-destructive">{ i18n.T(ctx, "admin.delete.removes") }</p>
						<ul class="mt-2 list-disc space-y-1 pl-5 text-muted-foreground">
							<li>{ i18n.T(ctx, "admin.delete.removes_signin") }</li>
							<li>{ i18n.T(ctx, "admin.delete.removes_mailboxes") }</li>
							<li>{ i18n.T(ctx, "admin.delete.removes_data") }</li>
						</ul>
					</div>
					<div class="rounded-lg border border-border bg-muted/35 px-4 py-3 text-muted-foreground">
						<p><span class="font-semibold text-foreground">{ i18n.T(ctx, "admin.delete.remote_title") }</span> { i18n.T(ctx, "admin.delete.remote") }</p>
						<p class="mt-2">{ i18n.T(ctx, "admin.delete.audit") }</p>
					</div>
					<div class="rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-amber-900 dark:text-amber-100">
						<p class="font-semibold">{ i18n.T(ctx, "admin.delete.backup_title") }</p>
						<p class="mt-1">{ i18n.T(ctx, "admin.delete.backup") }</p>
					</div>
				</div>
				<form method="post" action={ user.DeletionPath } class="mt-5">
					<input type="hidden" name="_csrf" value={ user.DeletionCSRFToken }/>
					<label for={ deletionDialogID + "-confirmation" } class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.delete.confirm_before") } <code class="font-mono">{ user.Username }</code> { i18n.T(ctx, "admin.delete.confirm_after") }</label>
					<input
						id={ deletionDialogID + "-confirmation" }
						name="confirmation"
						type="text"
						autocomplete="off"
						autocapitalize="none"
						spellcheck="false"
						required
						class="mt-2 flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 font-mono text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
					/>
					@dialog.Footer() {
						@dialog.Close() {
							@button.Button(button.Props{Variant: button.VariantOutline}) {
								{ i18n.T(ctx, "common.cancel") }
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
							if user.DeletionPending {
								{ i18n.T(ctx, "admin.delete.retry_button") }
							} else {
								{ i18n.T(ctx, "admin.delete.submit") }
							}
						}
					}
				</form>
			}
		}
	}
}

func adminUserCredentialResetDialogID(user AdminUserData) string {
	return "admin-user-credential-reset-" + strings.NewReplacer("/", "-", " ", "-").Replace(user.ID)
}

templ AdminUserCredentialResetAction(user AdminUserData, stepUpRequired bool) {
	if user.CredentialResetPath != "" {
		{{ resetDialogID := adminUserCredentialResetDialogID(user) }}
		if stepUpRequired {
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Href: "/admin/users?" + url.Values{"reset_user": {user.ID}}.Encode()}) {
				{ i18n.T(ctx, "admin.reset.generate") }
			}
		} else {
			@dialog.Trigger(dialog.TriggerProps{For: resetDialogID}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Disabled: stepUpRequired || user.CredentialResetCSRFToken == ""}) {
					if user.PasswordResetRequestedAt != nil {
						{ i18n.T(ctx, "admin.reset.generate") }
					} else {
						{ i18n.T(ctx, "admin.reset.generate") }
					}
				}
			}
		}
		@dialog.Dialog(dialog.Props{ID: resetDialogID, Open: user.CredentialResetOpen && !stepUpRequired}) {
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title() {
						if user.PasswordResetRequestedAt != nil {
							{ i18n.T(ctx, "admin.reset.issue_title", "user", adminUserUsername(ctx, user.Username)) }
						} else {
							{ i18n.T(ctx, "admin.reset.generate_title", "user", adminUserUsername(ctx, user.Username)) }
						}
					}
					@dialog.Description() {
						{ i18n.T(ctx, "admin.reset.detail") }
					}
				}
				<form method="post" action={ user.CredentialResetPath }>
					<input type="hidden" name="_csrf" value={ user.CredentialResetCSRFToken }/>
					@dialog.Footer() {
						@dialog.Close() {
							@button.Button(button.Props{Variant: button.VariantOutline}) {
								{ i18n.T(ctx, "common.cancel") }
							}
						}
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							{ i18n.T(ctx, "admin.reset.submit") }
						}
					}
				</form>
			}
		}
		@AdminUserRequiredPasswordChangeAction(user, stepUpRequired)
	}
}

templ AdminUserInvitationDialog(data AdminUsersData) {
	@dialog.Dialog(dialog.Props{ID: "admin-user-invitation-dialog", Open: !data.StepUpRequired && adminUserInvitationFormOpen(data.InvitationForm)}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-xl max-h-[calc(100vh-2rem)]"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.invite.title") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.invite.description") }
				}
			}
			<form method="post" action="/admin/users/invitations" class="space-y-4">
				if data.InvitationCSRFToken != "" {
					<input type="hidden" name="_csrf" value={ data.InvitationCSRFToken }/>
				}
				<div class="space-y-1.5">
					<label for="admin-invitation-name" class="block text-sm font-semibold text-foreground">{ i18n.T(ctx, "compose.from.display_name") }</label>
					<input
						id="admin-invitation-name"
						name="name"
						type="text"
						value={ data.InvitationForm.Name }
						maxlength="100"
						required
						autocomplete="off"
						if adminUserInvitationFieldError(data.InvitationForm, "name") != "" {
							aria-invalid="true"
							aria-describedby="admin-invitation-name-error"
						}
						class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30 aria-[invalid=true]:border-destructive"
					/>
					if fieldError := adminUserInvitationFieldError(data.InvitationForm, "name"); fieldError != "" {
						<p id="admin-invitation-name-error" class="text-xs font-medium text-destructive">{ fieldError }</p>
					}
				</div>
				<div class="space-y-1.5">
					<div class="space-y-1.5">
						<label for="admin-invitation-username" class="block text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.invite.username") }</label>
						<input
							id="admin-invitation-username"
							name="username"
							type="text"
							value={ data.InvitationForm.Username }
							minlength="3"
							maxlength="32"
							required
							autocomplete="off"
							autocapitalize="none"
							spellcheck="false"
							if adminUserInvitationFieldError(data.InvitationForm, "username") != "" {
								aria-invalid="true"
								aria-describedby="admin-invitation-username-help admin-invitation-username-error"
							} else {
								aria-describedby="admin-invitation-username-help"
							}
							class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30 aria-[invalid=true]:border-destructive"
						/>
						<p id="admin-invitation-username-help" class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.invite.username_help") }</p>
						if fieldError := adminUserInvitationFieldError(data.InvitationForm, "username"); fieldError != "" {
							<p id="admin-invitation-username-error" class="text-xs font-medium text-destructive">{ fieldError }</p>
						}
					</div>
				</div>
				<div class="rounded-md border border-border bg-muted/35 px-3 py-2.5 text-xs leading-relaxed text-muted-foreground">
					{ i18n.T(ctx, "admin.invite.note") }
				</div>
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{For: "admin-user-invitation-dialog"}) {
						@button.Button(button.Props{Variant: button.VariantOutline}) {
							{ i18n.T(ctx, "common.cancel") }
						}
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Disabled: data.StepUpRequired || data.InvitationCSRFToken == ""}) {
						@icon.UserPlus(icon.Props{Class: "size-4"})
						{ i18n.T(ctx, "admin.invite.create") }
					}
				}
			</form>
		}
	}
}

templ AdminUserInvitationResultDialog(data *AdminUserInvitationData) {
	@dialog.Dialog(dialog.Props{ID: "admin-user-invitation-result-dialog", Open: true, DisableClickAway: true, DisableESC: true}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-xl max-h-[calc(100vh-2rem)]"}) {
			@dialog.Header() {
				@dialog.Title() {
					if data.Rotated {
						{ i18n.T(ctx, "admin.invite.rotated") }
					} else {
						{ i18n.T(ctx, "admin.invite.created") }
					}
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.token.copy_now") }
				}
			}
			<div role="status" class="rounded-md border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-200">
				<p class="font-semibold">
					if data.Rotated {
						{ i18n.T(ctx, "admin.invite.ready", "username", data.Username) }
					} else {
						{ i18n.T(ctx, "admin.invite.pending", "username", data.Username) }
					}
				</p>
				<p class="mt-1 text-xs">{ i18n.T(ctx, "admin.invite.name_expires", "name", data.Name, "date", adminDateTimeZone(ctx, data.ExpiresAt)) }</p>
			</div>
			<div class="space-y-2">
				<div class="flex items-center justify-between gap-3">
					<label for="admin-user-invitation-details" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.invite.details") }</label>
					<div class="flex items-center gap-1 text-xs text-muted-foreground">
						<span data-copy-tooltip-text>{ i18n.T(ctx, "admin.token.copy_details") }</span>
						@copybutton.CopyButton(copybutton.Props{
							TargetID: "admin-user-invitation-details",
							Attrs:    templ.Attributes{"aria-label": i18n.T(ctx, "admin.invite.copy_label")},
						})
					</div>
				</div>
				<textarea id="admin-user-invitation-details" readonly rows="6" class="w-full resize-none rounded-md border border-border bg-background px-3 py-2 font-mono text-xs leading-relaxed text-foreground outline-none">{ adminUserInvitationCopyText(ctx, data) }</textarea>
			</div>
			<div class="rounded-md border border-amber-500/25 bg-amber-500/10 px-3 py-2.5 text-xs leading-relaxed text-amber-900 dark:text-amber-100">
				{ i18n.T(ctx, "admin.invite.send_note") }
			</div>
			@dialog.Footer() {
				@dialog.Close(dialog.CloseProps{For: "admin-user-invitation-result-dialog"}) {
					@button.Button() {
						{ i18n.T(ctx, "admin.invite.saved") }
					}
				}
			}
		}
	}
}

templ AdminUserCredentialResetResultDialog(data *AdminUserCredentialResetData) {
	@dialog.Dialog(dialog.Props{ID: "admin-user-credential-reset-result-dialog", Open: true, DisableClickAway: true, DisableESC: true}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-xl max-h-[calc(100vh-2rem)]"}) {
			@dialog.Header() {
				@dialog.Title() {
					{ i18n.T(ctx, "admin.reset.created") }
				}
				@dialog.Description() {
					{ i18n.T(ctx, "admin.token.copy_now") }
				}
			}
			<div role="status" class="rounded-md border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-800 dark:text-emerald-200">
				<p class="font-semibold">{ i18n.T(ctx, "admin.reset.ready", "username", data.Username) }</p>
				<p class="mt-1 text-xs">{ i18n.T(ctx, "admin.invite.expires", "date", adminDateTimeZone(ctx, data.ExpiresAt)) }</p>
			</div>
			<div class="space-y-2">
				<div class="flex items-center justify-between gap-3">
					<label for="admin-user-credential-reset-details" class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.reset.details") }</label>
					<div class="flex items-center gap-1 text-xs text-muted-foreground">
						<span data-copy-tooltip-text>{ i18n.T(ctx, "admin.token.copy_details") }</span>
						@copybutton.CopyButton(copybutton.Props{
							TargetID: "admin-user-credential-reset-details",
							Attrs:    templ.Attributes{"aria-label": i18n.T(ctx, "admin.reset.copy_label")},
						})
					</div>
				</div>
				<textarea id="admin-user-credential-reset-details" readonly rows="6" class="w-full resize-none rounded-md border border-border bg-background px-3 py-2 font-mono text-xs leading-relaxed text-foreground outline-none">{ adminUserCredentialResetCopyText(ctx, data) }</textarea>
			</div>
			<div class="rounded-md border border-amber-500/25 bg-amber-500/10 px-3 py-2.5 text-xs leading-relaxed text-amber-900 dark:text-amber-100">
				{ i18n.T(ctx, "admin.reset.send_note") }
			</div>
			@dialog.Footer() {
				@dialog.Close(dialog.CloseProps{For: "admin-user-credential-reset-result-dialog"}) {
					@button.Button() {
						{ i18n.T(ctx, "admin.reset.saved") }
					}
				}
			}
		}
	}
}

func adminMailSecurityEndpoint(item models.MailSecurityException) string {
	if item.Kind == models.MailSecurityExceptionHTTPDiscovery {
		return item.Host
	}
	return strings.ToUpper(item.Protocol) + " " + item.Host + ":" + fmt.Sprintf("%d", item.Port)
}

func adminMailSecurityKindLabel(ctx context.Context, item models.MailSecurityException) string {
	if item.Kind == models.MailSecurityExceptionHTTPDiscovery {
		return i18n.T(ctx, "admin.security.kind.http")
	}
	if item.Kind == models.MailSecurityExceptionPrivateTarget {
		return i18n.T(ctx, "admin.security.kind.private")
	}
	return i18n.T(ctx, "admin.security.kind.plaintext")
}

func adminMailSecurityAccounts(item models.MailSecurityException) string {
	accounts := make([]string, 0, len(item.Accounts))
	for _, account := range item.Accounts {
		accounts = append(accounts, account.Email)
	}
	return strings.Join(accounts, ", ")
}

templ AdminSecurityPage(data models.MailSecurityAdminData, verification ...AdminSecurityVerificationData) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="mb-7">
					<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.security") }</h2>
					<p class="mt-1 max-w-3xl text-sm text-muted-foreground">
						if data.Allowlist != nil {
							{ i18n.T(ctx, "admin.security.description_allowlist") }
						} else {
							{ i18n.T(ctx, "admin.security.description") }
						}
					</p>
				</div>
				if data.Notice != "" {
					<div class="mb-5 rounded-lg border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-sm font-medium text-emerald-800 dark:text-emerald-200">{ data.Notice }</div>
				}
				if data.Error != "" {
					<div class="mb-5 rounded-lg border border-red-500/25 bg-red-500/10 px-4 py-3 text-sm font-medium text-red-800 dark:text-red-200">{ data.Error }</div>
				}
				if data.StepUpRequired {
					<div role="alert" class="mb-5 rounded-lg border border-amber-500/30 bg-amber-500/10 px-4 py-3 text-sm text-amber-900 dark:text-amber-100">
						<p class="font-semibold">{ i18n.T(ctx, "admin.verify.required") }</p>
						<p class="mt-1">{ i18n.T(ctx, "admin.security.verify") }</p>
						<div class="mt-3">
							@AdminSecurityVerificationTrigger(adminSecurityVerificationValue(verification), i18n.T(ctx, "admin.verify.now"))
						</div>
					</div>
				}
				if data.Allowlist != nil {
					@tabs.Tabs(tabs.Props{ID: "mail-security-tabs"}) {
						@tabs.List(tabs.ListProps{Class: "bg-card"}) {
							@tabs.Trigger(tabs.TriggerProps{Value: "allowlist", IsActive: data.Tab != "exceptions" && data.Tab != "proxies"}) {
								{ i18n.T(ctx, "admin.allowlist.tab") }
								if len(data.Allowlist.Refused) > 0 {
									<span class="rounded-full bg-red-500/12 px-1.5 text-[11px] font-semibold tabular-nums text-red-700 dark:text-red-300">{ i18n.T(ctx, "admin.allowlist.refused_count", "count", i18n.Number(ctx, len(data.Allowlist.Refused))) }</span>
								}
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "exceptions", IsActive: data.Tab == "exceptions"}) {
								{ i18n.T(ctx, "admin.security.exceptions_tab") }
								if len(data.Exceptions) > 0 {
									<span class="rounded-full bg-muted px-1.5 text-[11px] font-semibold tabular-nums text-muted-foreground">{ i18n.Number(ctx, len(data.Exceptions)) }</span>
								}
							}
							@tabs.Trigger(tabs.TriggerProps{Value: "proxies", IsActive: data.Tab == "proxies"}) {
								{ i18n.T(ctx, "admin.proxies.tab") }
								if len(data.Proxies) > 0 {
									<span class="rounded-full bg-muted px-1.5 text-[11px] font-semibold tabular-nums text-muted-foreground">{ i18n.Number(ctx, len(data.Proxies)) }</span>
								}
							}
						}
						@tabs.Content(tabs.ContentProps{Value: "allowlist", IsActive: data.Tab != "exceptions" && data.Tab != "proxies", Class: "mt-6"}) {
							@MailAllowlistPanel(data, *data.Allowlist)
						}
						@tabs.Content(tabs.ContentProps{Value: "exceptions", IsActive: data.Tab == "exceptions", Class: "mt-6"}) {
							<p class="mb-4 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.exceptions_intro") }</p>
							if mailAllowlistServersLimited(*data.Allowlist) {
								<div class="mb-5 flex items-start gap-3 rounded-lg border border-border bg-card p-4 text-sm text-muted-foreground">
									@icon.Info(icon.Props{Class: "mt-0.5 size-4 shrink-0"})
									<p>{ i18n.T(ctx, "admin.security.exceptions_limited") }</p>
								</div>
							}
							@MailSecurityExceptionsPanel(data)
						}
						@tabs.Content(tabs.ContentProps{Value: "proxies", IsActive: data.Tab == "proxies", Class: "mt-6"}) {
							@OutboundProxiesPanel(data)
						}
					}
				} else {
					@MailSecurityExceptionsPanel(data)
					<div class="mt-6">
						@OutboundProxiesPanel(data)
					</div>
				}
			</div>
		</div>
	</div>
	@AdminSecurityVerificationDialog(adminSecurityVerificationValue(verification))
}

func mailAllowlistServersLimited(list models.MailAllowlistAdminData) bool {
	return len(list.Servers) > 0 || list.Gmail || list.Outlook
}

func mailAllowlistLimited(list models.MailAllowlistAdminData) bool {
	return mailAllowlistServersLimited(list) || len(list.Domains) > 0
}

// adminPeoplePickerProps describes a list of chosen people, each with a
// button that takes them off it, and a picker that adds one. Each change
// posts to Action with user_id and Field set to "true" (added) or "false"
// (taken off), and Hidden's fields.
type adminPeoplePickerProps struct {
	Title       string
	Detail      string
	Empty       string
	Chosen      []models.AdminWebmailUserOption
	Candidates  []models.AdminWebmailUserOption
	Action      string
	CSRFToken   string
	Field       string
	Hidden      map[string]string
	AddLabel    string
	RemoveLabel string
	Disabled    bool
}

templ adminPeoplePickerHidden(props adminPeoplePickerProps, value string) {
	if props.CSRFToken != "" {
		<input type="hidden" name="_csrf" value={ props.CSRFToken }/>
	}
	for name, hidden := range props.Hidden {
		<input type="hidden" name={ name } value={ hidden }/>
	}
	<input type="hidden" name={ props.Field } value={ value }/>
}

// adminPeoplePicker is the list of people a rule or proxy is chosen for.
templ adminPeoplePicker(props adminPeoplePickerProps) {
	if props.Title != "" {
		<div class="text-sm font-semibold text-foreground">{ props.Title }</div>
	}
	if props.Detail != "" {
		<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ props.Detail }</p>
	}
	if len(props.Chosen) == 0 {
		<div class="mt-3 rounded-md border border-dashed border-border px-3 py-4 text-center text-xs text-muted-foreground">{ props.Empty }</div>
	} else {
		<div class="mt-3 space-y-2">
			for _, user := range props.Chosen {
				<div class="flex items-center justify-between gap-3 rounded-md border border-border bg-card px-3 py-2">
					<span class="min-w-0 truncate text-sm font-semibold text-foreground">{ user.Username }</span>
					<form method="post" action={ templ.URL(props.Action) }>
						@adminPeoplePickerHidden(props, "false")
						<input type="hidden" name="user_id" value={ user.ID }/>
						<button type="submit" class={ mailAllowlistRemoveButtonClass() } disabled?={ props.Disabled }>{ props.RemoveLabel }</button>
					</form>
				</div>
			}
		</div>
	}
	if len(props.Candidates) > 0 {
		<form method="post" action={ templ.URL(props.Action) } class="mt-3 flex flex-col gap-2 sm:flex-row">
			@adminPeoplePickerHidden(props, "true")
			<div class="min-w-0 sm:flex-1">
				@selectbox.SelectBox() {
					@selectbox.Trigger(selectbox.TriggerProps{Name: "user_id", Class: "h-9 bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "admin.allowlist.user")}}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.allowlist.choose_user")})
					}
					@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "admin.allowlist.search_users")}) {
						for _, user := range props.Candidates {
							@selectbox.Item(selectbox.ItemProps{Value: user.ID}) {
								{ user.Username }
							}
						}
					}
				}
			</div>
			<button type="submit" class={ mailAllowlistAddButtonClass() } disabled?={ props.Disabled }>{ props.AddLabel }</button>
		</form>
	}
}

// MailAllowlistPanel limits the mail servers mailboxes connect to and the
// domains of their addresses, and says which mailboxes the limits refuse.
templ MailAllowlistPanel(data models.MailSecurityAdminData, list models.MailAllowlistAdminData) {
	<section class="rounded-lg border border-border bg-card p-5" id="allowed-mail">
		<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.allowlist.title") }</div>
		<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.description") }</p>
		<div class="mt-5 grid gap-5 lg:grid-cols-2">
			<div class="min-w-0 rounded-lg border border-border bg-background/45 p-4">
				<div class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.allowlist.servers") }</div>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.servers_detail") }</p>
				@mailAllowlistEntries(data, list.Servers, i18n.T(ctx, "admin.allowlist.servers_empty"))
				@mailAllowlistAddForm(data, "/servers", i18n.T(ctx, "admin.allowlist.or", "a", "imap.example.org", "b", "*.example.org"), i18n.T(ctx, "admin.allowlist.add_server"))
				<div class="mt-4 border-t border-border pt-4">
					<div class="text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.providers") }</div>
					<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.providers_detail") }</p>
					<div class="mt-2 space-y-2">
						@mailAllowlistProvider(data, "gmail", "Gmail", list.Gmail, mailAllowlistServersLimited(list))
						@mailAllowlistProvider(data, "outlook", "Outlook", list.Outlook, mailAllowlistServersLimited(list))
					</div>
				</div>
			</div>
			<div class="min-w-0 rounded-lg border border-border bg-background/45 p-4">
				<div class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.allowlist.domains") }</div>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.domains_detail") }</p>
				@mailAllowlistEntries(data, list.Domains, i18n.T(ctx, "admin.allowlist.domains_empty"))
				@mailAllowlistAddForm(data, "/domains", i18n.T(ctx, "admin.allowlist.or", "a", "example.org", "b", "*.example.org"), i18n.T(ctx, "admin.allowlist.add_domain"))
			</div>
		</div>
		<div class="mt-5 grid gap-5 lg:grid-cols-2">
			<div class="min-w-0 rounded-lg border border-border bg-background/45 p-4">
				@adminPeoplePicker(adminPeoplePickerProps{
					Title:        i18n.T(ctx, "admin.allowlist.exempt"),
					Detail:       i18n.T(ctx, "admin.allowlist.exempt_detail"),
					Empty:        i18n.T(ctx, "admin.allowlist.exempt_empty"),
					Chosen:       list.Exempt,
					Candidates:   list.Candidates,
					Action:       adminMailAllowlistBase + "/exempt",
					CSRFToken:    data.CSRFTokens[adminMailAllowlistBase+"/exempt"],
					Field:        "exempt",
					AddLabel:     i18n.T(ctx, "admin.allowlist.dont_apply"),
					RemoveLabel:  i18n.T(ctx, "admin.allowlist.apply"),
					Disabled:     data.StepUpRequired,
				})
			</div>
			<div class="min-w-0 rounded-lg border border-border bg-background/45 p-4">
				<div class="flex items-center justify-between gap-3">
					<div class="text-sm font-semibold text-foreground">{ i18n.T(ctx, "admin.allowlist.refused") }</div>
					if mailAllowlistLimited(list) {
						<span class="text-xs font-semibold tabular-nums text-muted-foreground">{ i18n.Number(ctx, len(list.Refused)) }</span>
					}
				</div>
				<p class="mt-1 text-xs leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.refused_detail") }</p>
				if !mailAllowlistLimited(list) {
					<div class="mt-3 rounded-md border border-dashed border-border px-3 py-4 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.unlimited") }</div>
				} else if len(list.Refused) == 0 {
					<div class="mt-3 rounded-md border border-dashed border-border px-3 py-4 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "admin.allowlist.all_within") }</div>
				} else {
					<div class="mt-3 space-y-2">
						for _, account := range list.Refused {
							<div class="rounded-md border border-red-500/20 bg-red-500/5 px-3 py-2">
								<div class="flex flex-wrap items-baseline justify-between gap-x-3">
									<span class="min-w-0 truncate text-sm font-semibold text-foreground">{ account.Email }</span>
									<span class="text-xs text-muted-foreground">{ account.Username }</span>
								</div>
								<div class="mt-0.5 text-xs font-medium text-red-700 dark:text-red-300">{ account.Reason }</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
	</section>
}

const adminMailAllowlistBase = "/admin/security/allowlist"

func mailAllowlistRemoveButtonClass() string {
	return "shrink-0 rounded-md border border-border bg-card px-2.5 py-1 text-xs font-semibold text-muted-foreground transition-colors hover:border-red-500/40 hover:bg-red-500/10 hover:text-red-700 disabled:cursor-not-allowed disabled:opacity-50 dark:hover:text-red-300"
}

func mailAllowlistAddButtonClass() string {
	return "h-9 shrink-0 rounded-md border border-border bg-card px-3 text-xs font-semibold text-foreground transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-50"
}

templ mailAllowlistEntries(data models.MailSecurityAdminData, entries []models.MailAllowlistAdminEntry, empty string) {
	if len(entries) == 0 {
		<div class="mt-3 rounded-md border border-dashed border-border px-3 py-4 text-center text-xs text-muted-foreground">{ empty }</div>
	} else {
		<div class="mt-3 space-y-2">
			for _, entry := range entries {
				<div class="flex items-center justify-between gap-3 rounded-md border border-border bg-card px-3 py-2">
					<span class="min-w-0 truncate font-mono text-sm font-bold text-foreground">{ entry.Value }</span>
					<form method="post" action={ templ.URL(adminMailAllowlistBase + "/entries/" + entry.ID + "/delete") } data-confirm-action={ i18n.T(ctx, "admin.allowlist.remove") } data-confirm-destructive data-confirm={ i18n.T(ctx, "admin.allowlist.remove_confirm", "entry", entry.Value) }>
						<input type="hidden" name="_csrf" value={ data.CSRFTokens[adminMailAllowlistBase+"/entries/"+entry.ID+"/delete"] }/>
						<button type="submit" class={ mailAllowlistRemoveButtonClass() } disabled?={ data.StepUpRequired }>{ i18n.T(ctx, "admin.allowlist.remove") }</button>
					</form>
				</div>
			}
		</div>
	}
}

templ mailAllowlistAddForm(data models.MailSecurityAdminData, action, placeholder, label string) {
	<form method="post" action={ templ.URL(adminMailAllowlistBase + action) } class="mt-3 flex flex-col gap-2 sm:flex-row">
		<input type="hidden" name="_csrf" value={ data.CSRFTokens[adminMailAllowlistBase+action] }/>
		<input name="value" type="text" required placeholder={ placeholder } aria-label={ label } class="h-9 min-w-0 sm:flex-1 rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
		<button type="submit" class={ mailAllowlistAddButtonClass() } disabled?={ data.StepUpRequired }>{ label }</button>
	</form>
}

templ mailAllowlistProvider(data models.MailSecurityAdminData, provider, name string, allowed, limited bool) {
	<div class="flex items-center justify-between gap-3 rounded-md border border-border bg-card px-3 py-2">
		<div class="min-w-0">
			<span class="text-sm font-semibold text-foreground">{ name }</span>
			<span class="ml-2 text-xs text-muted-foreground">
				if allowed {
					{ i18n.T(ctx, "admin.allowlist.allowed") }
				} else if limited {
					{ i18n.T(ctx, "admin.allowlist.refused_state") }
				} else {
					{ i18n.T(ctx, "admin.allowlist.allowed_unlimited") }
				}
			</span>
		</div>
		<form method="post" action={ templ.URL(adminMailAllowlistBase + "/providers") }>
			<input type="hidden" name="_csrf" value={ data.CSRFTokens[adminMailAllowlistBase+"/providers"] }/>
			<input type="hidden" name="provider" value={ provider }/>
			<input type="hidden" name="allowed" value={ fmt.Sprintf("%t", !allowed) }/>
			if allowed {
				<button type="submit" class={ mailAllowlistRemoveButtonClass() } disabled?={ data.StepUpRequired }>{ i18n.T(ctx, "admin.allowlist.stop_allowing") }</button>
			} else {
				<button type="submit" class={ mailAllowlistRemoveButtonClass() } disabled?={ data.StepUpRequired }>{ i18n.T(ctx, "admin.allowlist.allow") }</button>
			}
		</form>
	</div>
}

// MailSecurityExceptionsPanel lists and adds the exceptions an administrator,
// or the owner in personal mode, has approved. Its forms post under data.ActionBase.
templ MailSecurityExceptionsPanel(data models.MailSecurityAdminData) {
	<div class="mb-6 rounded-lg border border-amber-500/30 bg-amber-500/10 p-4">
		<div class="flex items-start gap-3">
			@icon.TriangleAlert(icon.Props{Class: "mt-0.5 size-5 shrink-0 text-amber-700 dark:text-amber-300"})
			<div>
				<div class="text-sm font-bold text-amber-900 dark:text-amber-100">{ i18n.T(ctx, "admin.security.warning_title") }</div>
				<p class="mt-1 text-sm leading-relaxed text-amber-800 dark:text-amber-200">{ i18n.T(ctx, "admin.security.warning") }</p>
			</div>
		</div>
	</div>
	<div class="grid gap-5">
		<section class="rounded-lg border border-border bg-card p-5">
			<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.security.kind.http") }</div>
			<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.http_detail") }</p>
			<form method="post" action={ templ.URL(data.ActionBase + "/http-discovery") } class="mt-5 space-y-4" data-confirm-action={ i18n.T(ctx, "admin.security.http_confirm_action") } data-confirm={ i18n.T(ctx, "admin.security.http_confirm") }>
				if data.CSRFTokens[data.ActionBase+"/http-discovery"] != "" {
					<input type="hidden" name="_csrf" value={ data.CSRFTokens[data.ActionBase+"/http-discovery"] }/>
				}
				<div>
					<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.email_domain") }</label>
					<input name="domain" type="text" required placeholder="lab.example.test" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
				</div>
				<label class="flex items-start gap-2.5 rounded-md border border-amber-500/20 bg-amber-500/5 p-3 text-xs leading-relaxed text-muted-foreground">
					<input type="checkbox" name="acknowledge" value="yes" required class="mt-0.5 size-4 shrink-0 accent-amber-600"/>
					<span>{ i18n.T(ctx, "admin.security.http_ack") }</span>
				</label>
				<button type="submit" class="rounded-md border border-amber-500/35 bg-amber-500/10 px-3 py-2 text-xs font-semibold text-amber-800 transition-colors hover:bg-amber-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-amber-200" disabled?={ data.StepUpRequired }>{ i18n.T(ctx, "admin.security.http_add") }</button>
			</form>
		</section>
		<section class="rounded-lg border border-border bg-card p-5">
			<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.security.plaintext_title") }</div>
			<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.plaintext_detail") }</p>
			<form method="post" action={ templ.URL(data.ActionBase + "/plaintext") } class="mt-5 space-y-4" data-confirm-action={ i18n.T(ctx, "admin.security.plaintext_confirm_action") } data-confirm-destructive data-confirm={ i18n.T(ctx, "admin.security.plaintext_confirm") }>
				if data.CSRFTokens[data.ActionBase+"/plaintext"] != "" {
					<input type="hidden" name="_csrf" value={ data.CSRFTokens[data.ActionBase+"/plaintext"] }/>
				}
				<div class="grid gap-3 sm:grid-cols-[8rem_minmax(0,1fr)_7rem]">
					<div>
						<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.protocol") }</label>
						@adminSecurityProtocolSelect([]string{"imap", "smtp", "http"})
					</div>
					<div>
						<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.host") }</label>
						<input name="host" type="text" required placeholder="mailhog.local" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
					</div>
					<div>
						<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.port") }</label>
						<input name="port" type="number" min="1" max="65535" required placeholder="1025" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
					</div>
				</div>
				<label class="flex items-start gap-2.5 rounded-md border border-red-500/20 bg-red-500/5 p-3 text-xs leading-relaxed text-muted-foreground">
					<input type="checkbox" name="acknowledge" value="yes" required class="mt-0.5 size-4 shrink-0 accent-red-600"/>
					<span>{ i18n.T(ctx, "admin.security.plaintext_ack") }</span>
				</label>
				<button type="submit" class="rounded-md border border-red-500/35 bg-red-500/10 px-3 py-2 text-xs font-semibold text-red-800 transition-colors hover:bg-red-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-red-200" disabled?={ data.StepUpRequired }>{ i18n.T(ctx, "admin.security.plaintext_add") }</button>
			</form>
		</section>
	</div>
	<section class="mt-5 rounded-lg border border-border bg-card p-5">
		<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.security.private_title") }</div>
		<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.private_detail") }</p>
		<form method="post" action={ templ.URL(data.ActionBase + "/private-target") } class="mt-5 space-y-4" data-confirm-action={ i18n.T(ctx, "admin.security.private_confirm_action") } data-confirm={ i18n.T(ctx, "admin.security.private_confirm") }>
			if data.CSRFTokens[data.ActionBase+"/private-target"] != "" {
				<input type="hidden" name="_csrf" value={ data.CSRFTokens[data.ActionBase+"/private-target"] }/>
			}
			<div class="grid gap-3 sm:grid-cols-[8rem_minmax(0,1fr)_7rem]">
				<div>
					<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.protocol") }</label>
					@adminSecurityProtocolSelect([]string{"http", "https", "imap", "smtp", "proxy"})
				</div>
				<div>
					<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.host") }</label>
					<input name="host" type="text" required placeholder={ i18n.T(ctx, "admin.allowlist.or", "a", "127.0.0.1", "b", "mail.lab.test") } class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
				</div>
				<div>
					<label class="mb-1.5 block text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.security.port") }</label>
					<input name="port" type="number" min="1" max="65535" required placeholder="8080" class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm text-foreground shadow-sm outline-none focus:border-ring focus:ring-2 focus:ring-ring/30"/>
				</div>
			</div>
			<label class="flex items-start gap-2.5 rounded-md border border-red-500/20 bg-red-500/5 p-3 text-xs leading-relaxed text-muted-foreground">
				<input type="checkbox" name="acknowledge" value="yes" required class="mt-0.5 size-4 shrink-0 accent-red-600"/>
				<span>{ i18n.T(ctx, "admin.security.private_ack") }</span>
			</label>
			<button type="submit" class="rounded-md border border-red-500/35 bg-red-500/10 px-3 py-2 text-xs font-semibold text-red-800 transition-colors hover:bg-red-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-red-200" disabled?={ data.StepUpRequired }>{ i18n.T(ctx, "admin.security.private_add") }</button>
		</form>
	</section>
	<section class="mt-6 rounded-lg border border-border bg-card p-5">
		<div class="flex items-end justify-between gap-4">
			<div>
				<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.security.approved") }</div>
				<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.approved_detail") }</p>
			</div>
			<div class="text-xs font-semibold tabular-nums text-muted-foreground">{ i18n.T(ctx, "admin.security.total", "count", i18n.Number(ctx, len(data.Exceptions))) }</div>
		</div>
		if len(data.Exceptions) == 0 {
			<div class="mt-4 rounded-lg border border-dashed border-border bg-background/35 px-4 py-8 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "admin.security.none") }</div>
		} else {
			<div class="mt-4 space-y-3">
				for _, item := range data.Exceptions {
					<div class="flex flex-col gap-3 rounded-lg border border-border bg-background/45 p-4 sm:flex-row sm:items-start sm:justify-between">
						<div class="min-w-0">
							<div class="flex flex-wrap items-center gap-2">
								<span class="font-mono text-sm font-bold text-foreground">{ adminMailSecurityEndpoint(item) }</span>
								<span
									class={
										"rounded-md px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider",
										templ.KV("bg-amber-500/12 text-amber-800 dark:text-amber-200", item.Kind == models.MailSecurityExceptionHTTPDiscovery),
										templ.KV("bg-red-500/12 text-red-800 dark:text-red-200", item.Kind == models.MailSecurityExceptionPlaintextTransport),
										templ.KV("bg-red-500/12 text-red-800 dark:text-red-200", item.Kind == models.MailSecurityExceptionPrivateTarget),
									}
								>
									{ adminMailSecurityKindLabel(ctx, item) }
								</span>
								if item.OutsideAllowlist {
									<span class="rounded-md bg-muted px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.security.outside_allowlist") }</span>
								}
							</div>
							<div class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.security.added_by", "user", item.CreatedBy, "date", i18n.Dates(ctx).DateTime(item.CreatedAt.Local())) }</div>
							if len(item.Accounts) > 0 {
								<div class="mt-2 text-xs font-medium text-red-700 dark:text-red-300">
									{ i18n.T(ctx, "admin.security.used_by", "accounts", adminMailSecurityAccounts(item)) }
								</div>
							}
						</div>
						<form method="post" action={ templ.URL(data.ActionBase + "/exceptions/" + item.ID + "/delete") } data-confirm-action={ i18n.T(ctx, "admin.security.revoke_action") } data-confirm-destructive data-confirm={ i18n.T(ctx, "admin.security.revoke_confirm") }>
							if action := data.ActionBase + "/exceptions/" + item.ID + "/delete"; data.CSRFTokens[action] != "" {
								<input type="hidden" name="_csrf" value={ data.CSRFTokens[action] }/>
							}
							<button type="submit" class="rounded-md border border-border bg-card px-3 py-1.5 text-xs font-semibold text-muted-foreground transition-colors hover:border-red-500/40 hover:bg-red-500/10 hover:text-red-700 disabled:cursor-not-allowed disabled:opacity-50 dark:hover:text-red-300" disabled?={ data.StepUpRequired }>{ i18n.T(ctx, "admin.invite.revoke") }</button>
						</form>
					</div>
				}
			</div>
		}
	</section>
}

func adminPercent(part, total int) int {
	if total <= 0 {
		return 0
	}
	p := part * 100 / total
	if p > 100 {
		return 100
	}
	return p
}

// adminDateTimeZone writes a moment in the server's zone, naming the zone.
func adminDateTimeZone(ctx context.Context, t time.Time) string {
	t = t.Local()
	zone, _ := t.Zone()
	return i18n.Dates(ctx).DateTime(t) + " " + zone
}

func adminTime(ctx context.Context, t time.Time) string {
	if t.IsZero() {
		return i18n.T(ctx, "admin.never")
	}
	return i18n.Dates(ctx).ShortDateTime(t.Local())
}

func adminMailPendingAge(ctx context.Context, t time.Time) string {
	if t.IsZero() {
		return i18n.T(ctx, "admin.none")
	}
	age := time.Since(t)
	if age < 0 {
		return i18n.T(ctx, "admin.age.future")
	}
	if age < time.Minute {
		return i18n.T(ctx, "admin.age.now")
	}
	if age < time.Hour {
		return i18n.T(ctx, "admin.age.minutes", "count", int(age/time.Minute))
	}
	if age < 24*time.Hour {
		return i18n.T(ctx, "admin.age.hours", "count", int(age/time.Hour))
	}
	return i18n.T(ctx, "admin.age.days", "count", int(age/(24*time.Hour)))
}

func adminSMTPProfileDuration(ctx context.Context, milliseconds int64) string {
	if milliseconds <= 0 {
		return "—"
	}
	if milliseconds < 1000 {
		return i18n.Number(ctx, int(milliseconds)) + " ms"
	}
	return strings.Replace(fmt.Sprintf("%.1f", float64(milliseconds)/1000), ".", i18n.T(ctx, "number.decimal"), 1) + " s"
}

func adminChecked(total, pending int) int {
	checked := total - pending
	if checked < 0 {
		return 0
	}
	return checked
}

func adminLatestAvatarError(ctx context.Context, status models.AvatarStatus) string {
	for _, attempt := range status.RecentErrors {
		if attempt.Message != "" {
			return attempt.Message
		}
	}
	return adminError(ctx, status.Backfill.LastError)
}

func adminPanelTitleClass() string {
	return "text-sm font-semibold uppercase tracking-wider text-muted-foreground"
}

func adminScopeURL(path string, scope models.AdminWebmailScope) string {
	if strings.TrimSpace(scope.SelectedUserID) == "" {
		return path
	}
	return path + "?user_id=" + url.QueryEscape(scope.SelectedUserID)
}

func adminScopeDescription(ctx context.Context, scope models.AdminWebmailScope) string {
	if scope.SelectedUsername == "" {
		return i18n.T(ctx, "admin.scope.all")
	}
	return i18n.T(ctx, "admin.scope.user", "username", scope.SelectedUsername)
}

templ AdminWebmailScopeFilter(scope models.AdminWebmailScope, path string) {
	<form method="get" action={ path } class="w-full sm:w-72" data-admin-webmail-scope-form>
		<label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.scope.label") }</label>
		@selectbox.SelectBox() {
			@selectbox.Trigger(selectbox.TriggerProps{Name: "user_id", Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-admin-webmail-scope": ""}}) {
				@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.scope.all_accounts")})
			}
			@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "admin.scope.search")}) {
				@selectbox.Item(selectbox.ItemProps{Value: "", Selected: scope.SelectedUserID == ""}) {
					{ i18n.T(ctx, "admin.scope.all_accounts") }
				}
				for _, user := range scope.Users {
					@selectbox.Item(selectbox.ItemProps{Value: user.ID, Selected: user.ID == scope.SelectedUserID}) {
						{ user.Username }
						if user.Status != "active" {
							<span class="ml-1 text-xs text-muted-foreground">({ adminValueLabel(ctx, user.Status) })</span>
						}
					}
				}
			}
		}
		<p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">{ adminScopeDescription(ctx, scope) }</p>
	</form>
}

templ AdminPage(status models.AvatarStatus, activeTab string) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="mb-7 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.avatars") }</h2>
						<p class="mt-1 max-w-2xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.avatars.description") }</p>
					</div>
					<div class="flex w-full shrink-0 flex-col items-end gap-3 lg:w-auto">
						@AdminWebmailScopeFilter(status.Scope, "/admin/avatars/"+activeTab)
						<div class="flex flex-wrap items-center justify-end gap-2">
							<form method="post" action="/admin/avatar-backfill/recheck">
								<button
									type="submit"
									class="rounded-md border border-amber-500/35 bg-amber-500/10 px-3 py-2 text-xs font-semibold text-amber-800 transition-colors hover:bg-amber-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-amber-200"
									disabled?={ status.Backfill.InProgress }
								>
									{ i18n.T(ctx, "admin.avatars.force") }
								</button>
							</form>
							<form method="post" action="/admin/avatar-backfill/cancel">
								<button
									type="submit"
									class="rounded-md border border-red-500/35 bg-red-500/10 px-3 py-2 text-xs font-semibold text-red-700 transition-colors hover:bg-red-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-red-300"
									disabled?={ !status.Backfill.InProgress || status.Backfill.CancelRequested }
									data-avatar-cancel-button
								>
									{ i18n.T(ctx, "admin.avatars.cancel") }
								</button>
							</form>
							<a href={ adminScopeURL("/api/admin/avatars/status", status.Scope) } class="whitespace-nowrap rounded-md border border-border bg-card px-3 py-2 text-xs font-semibold text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "admin.raw_json") }</a>
						</div>
					</div>
				</div>
				@tabs.Tabs(tabs.Props{ID: "avatar-admin-tabs", Attributes: templ.Attributes{"data-avatar-admin": ""}}) {
					@tabs.List(tabs.ListProps{Class: "bg-card"}) {
						@tabs.Trigger(tabs.TriggerProps{Value: "overview", IsActive: activeTab == "overview"}) {
							{ i18n.T(ctx, "admin.tab.overview") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "senders", IsActive: activeTab == "senders"}) {
							{ i18n.T(ctx, "admin.avatars.tab.senders") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "providers", IsActive: activeTab == "providers"}) {
							{ i18n.T(ctx, "admin.avatars.tab.providers") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "events", IsActive: activeTab == "events"}) {
							{ i18n.T(ctx, "admin.tab.events") }
						}
					}
					@tabs.Content(tabs.ContentProps{Value: "overview", IsActive: activeTab == "overview", Class: "mt-6 space-y-5", Attributes: templ.Attributes{"data-avatar-tab-panel": "overview"}}) {
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.avatars.run_title") }</div>
									<p class="mt-1 text-sm text-muted-foreground" data-avatar-run-description>{ adminAvatarRunDescription(ctx, status.Backfill) }</p>
								</div>
								<span
									class={
										"inline-flex w-fit shrink-0 items-center rounded-md px-2.5 py-1 text-[11px] font-semibold",
										templ.KV("bg-red-500/12 text-red-700 dark:text-red-300", status.Backfill.CancelRequested || status.Backfill.Canceled),
										templ.KV("bg-amber-500/12 text-amber-700 dark:text-amber-300", status.Backfill.InProgress && !status.Backfill.CancelRequested),
										templ.KV("bg-emerald-500/12 text-emerald-700 dark:text-emerald-300", !status.Backfill.InProgress && !status.Backfill.Canceled),
									}
									data-avatar-state
								>
									if status.Backfill.CancelRequested {
										{ i18n.T(ctx, "admin.avatars.state.canceling") }
									} else if status.Backfill.InProgress {
										{ adminAvatarRunLabel(ctx, status.Backfill.Mode) }
									} else if status.Backfill.Canceled {
										{ i18n.T(ctx, "admin.avatars.state.canceled") }
									} else {
										{ i18n.T(ctx, "admin.state.idle") }
									}
								</span>
							</div>
							<div class="mt-2 flex items-center justify-between gap-4">
								<div class="text-sm font-medium text-foreground" data-avatar-progress-text>{ i18n.T(ctx, "admin.progress", "done", i18n.Number(ctx, status.Backfill.Processed), "total", i18n.Number(ctx, status.Backfill.Total)) }</div>
								<div class="text-sm font-semibold tabular-nums text-foreground" data-avatar-progress-percent>{ fmt.Sprintf("%d%%", adminPercent(status.Backfill.Processed, status.Backfill.Total)) }</div>
							</div>
							<div class="mt-4 h-2 overflow-hidden rounded-md bg-muted shadow-inner">
								<div class="h-full rounded-md bg-primary transition-all duration-500" style={ fmt.Sprintf("width:%d%%", adminPercent(status.Backfill.Processed, status.Backfill.Total)) } data-avatar-progress-bar></div>
							</div>
						</div>
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="mb-3">
								<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.avatars.provider_activity") }</div>
								<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.avatars.provider_activity_detail") }</p>
							</div>
							<div class="space-y-2">
								for _, provider := range status.Backfill.ProviderStats {
									@AdminRunProviderCard(provider)
								}
							</div>
						</div>
						<div class="grid gap-4 lg:grid-cols-2">
							<div class="rounded-lg border border-border bg-card p-4">
								<div class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.outcomes") }</div>
								<div class="flex min-h-[10.75rem] flex-col justify-between gap-3">
									@AdminCompactMetric("total", i18n.T(ctx, "admin.avatars.metric.total"), status.Cache.Total)
									@AdminCompactMetric("found", i18n.T(ctx, "admin.avatars.metric.found"), status.Cache.Found)
									@AdminCompactMetric("missing", i18n.T(ctx, "admin.avatars.metric.missing"), status.Cache.Missing)
									@AdminCompactMetric("checked", i18n.T(ctx, "admin.avatars.metric.checked"), adminChecked(status.Cache.Total, status.Cache.Pending))
									@AdminCompactMetric("pending", i18n.T(ctx, "admin.avatars.metric.pending"), status.Cache.Pending)
								</div>
							</div>
							<div class="rounded-lg border border-border bg-card p-4">
								<div class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.run_status") }</div>
								<div class="space-y-3">
									@AdminCompactDetail("started", i18n.T(ctx, "admin.started"), adminTime(ctx, status.Backfill.StartedAt))
									@AdminCompactDetail("finished", i18n.T(ctx, "admin.finished"), adminTime(ctx, status.Backfill.FinishedAt))
									@AdminCompactMetric("due", i18n.T(ctx, "admin.avatars.metric.due"), status.Cache.Due)
									@AdminCompactMetric("error", i18n.T(ctx, "admin.errors"), status.Cache.Error)
									@AdminErrorDetail("last_error", i18n.T(ctx, "admin.latest_error"), adminLatestAvatarError(ctx, status))
								</div>
							</div>
						</div>
					}
					@tabs.Content(tabs.ContentProps{Value: "senders", IsActive: activeTab == "senders", Class: "mt-6", Attributes: templ.Attributes{"data-avatar-tab-panel": "senders"}}) {
						<div class="rounded-lg border border-border bg-card p-4" data-avatar-explorer>
							<div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
								<div>
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.avatars.tab.senders") }</div>
									<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.avatars.senders_detail") }</p>
								</div>
								<div class="flex flex-col gap-2 lg:items-end">
									@AdminTableUpdateControls()
								</div>
							</div>
							<div class="grid gap-3 lg:grid-cols-[minmax(16rem,1fr)_10rem_10rem_auto]">
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.sender_search") }</span>
									@input.Input(input.Props{Type: input.TypeSearch, Placeholder: "sender@example.com", Class: "bg-background", Attributes: templ.Attributes{"data-avatar-filter": "query"}})
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.provider_checked") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-filter": "provider"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.avatars.all_providers")}) {
												{ i18n.T(ctx, "admin.avatars.all_providers") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: true}) {
												{ i18n.T(ctx, "admin.avatars.all_providers") }
											}
											for _, provider := range status.Cache.ProviderStats {
												@selectbox.Item(selectbox.ItemProps{Value: provider.Provider}) {
													{ adminProviderLabel(ctx, provider.Provider) }
												}
											}
										}
									}
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.final_status") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-filter": "status"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.avatars.all_statuses")}) {
												{ i18n.T(ctx, "admin.avatars.all_statuses") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: true}) {
												{ i18n.T(ctx, "admin.avatars.all_statuses") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "found"}) {
												{ i18n.T(ctx, "admin.avatars.found") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "missing"}) {
												{ i18n.T(ctx, "admin.avatars.missing") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "skipped"}) {
												{ i18n.T(ctx, "admin.avatars.skipped") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "error"}) {
												{ i18n.T(ctx, "admin.avatars.error") }
											}
										}
									}
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.errors_only") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-filter": "errors"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "common.no")}) {
												{ i18n.T(ctx, "common.no") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "false", Selected: true}) {
												{ i18n.T(ctx, "common.no") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "true"}) {
												{ i18n.T(ctx, "common.yes") }
											}
										}
									}
								</label>
							</div>
							<div class="mt-3 text-xs font-medium text-muted-foreground" data-avatar-log-count>{ i18n.T(ctx, "admin.avatars.loading_senders") }</div>
							<div class="mt-4 overflow-x-auto rounded-lg border border-border bg-muted/25 shadow-inner">
								<div class="min-w-[48rem]">
									<div class="grid gap-2 border-b border-border bg-muted/70 px-4 py-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground" data-avatar-sender-header>
										<div>{ i18n.T(ctx, "admin.avatars.col.sender") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.col.in_use") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.tab.providers") }</div>
									</div>
									<div class="h-[34rem] overflow-y-auto" data-avatar-log-viewport></div>
								</div>
							</div>
						</div>
					}
					@tabs.Content(tabs.ContentProps{Value: "providers", IsActive: activeTab == "providers", Class: "mt-6 space-y-5", Attributes: templ.Attributes{"data-avatar-tab-panel": "providers"}}) {
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
								<div>
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.avatars.source_mix") }</div>
									<p class="mt-1 max-w-xl text-sm leading-relaxed text-muted-foreground">{ i18n.T(ctx, "admin.avatars.source_mix_detail") }</p>
									<div class="mt-5 grid gap-3 sm:grid-cols-3">
										@AdminMetric("providers_total", i18n.T(ctx, "admin.avatars.tab.providers"), len(status.Cache.ProviderStats))
										@AdminMetric("provider_assignments", i18n.T(ctx, "admin.avatars.metric.assigned"), adminProviderInUseTotal(status.Cache.ProviderStats))
										@AdminMetric("other_found", i18n.T(ctx, "admin.avatars.metric.other"), status.Cache.OtherFound)
									</div>
								</div>
								<div class="rounded-lg border border-border bg-background/35 p-4">
									<div class="mb-3 flex items-center justify-between gap-3">
										<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.usage") }</div>
										<div class="text-xs font-semibold tabular-nums text-muted-foreground">{ i18n.T(ctx, "admin.avatars.assigned_count", "count", i18n.Number(ctx, adminProviderInUseTotal(status.Cache.ProviderStats))) }</div>
									</div>
									<div class="space-y-3">
										for _, provider := range status.Cache.ProviderStats {
											@AdminProviderUsageRow(provider, status.Cache.Found)
										}
									</div>
								</div>
							</div>
						</div>
						<div class="grid gap-4 xl:grid-cols-3">
							for _, provider := range status.Cache.ProviderStats {
								@AdminProviderCard(provider)
							}
						</div>
					}
					@tabs.Content(tabs.ContentProps{Value: "events", IsActive: activeTab == "events", Class: "mt-6 space-y-4", Attributes: templ.Attributes{"data-avatar-tab-panel": "events"}}) {
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
								<div>
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.tab.events") }</div>
									<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.avatars.events_detail") }</p>
								</div>
								<div class="flex flex-col gap-2 lg:items-end">
									@AdminTableUpdateControls()
								</div>
							</div>
							<div class="grid gap-3 lg:grid-cols-[minmax(16rem,1fr)_10rem_10rem_auto]">
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.sender_search") }</span>
									@input.Input(input.Props{Type: input.TypeSearch, Placeholder: "sender@example.com", Class: "bg-background", Attributes: templ.Attributes{"data-avatar-event-filter": "query"}})
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.provider") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-event-filter": "provider"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.avatars.all_providers")}) {
												{ i18n.T(ctx, "admin.avatars.all_providers") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: true}) {
												{ i18n.T(ctx, "admin.avatars.all_providers") }
											}
											for _, provider := range status.Cache.ProviderStats {
												@selectbox.Item(selectbox.ItemProps{Value: provider.Provider}) {
													{ adminProviderLabel(ctx, provider.Provider) }
												}
											}
										}
									}
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.outcome") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-event-filter": "status"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.avatars.all_outcomes")}) {
												{ i18n.T(ctx, "admin.avatars.all_outcomes") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "all", Selected: true}) {
												{ i18n.T(ctx, "admin.avatars.all_outcomes") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "found"}) {
												{ i18n.T(ctx, "admin.avatars.found") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "missing"}) {
												{ i18n.T(ctx, "admin.avatars.missing") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "skipped"}) {
												{ i18n.T(ctx, "admin.avatars.skipped") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "error"}) {
												{ i18n.T(ctx, "admin.avatars.error") }
											}
										}
									}
								</label>
								<label class="block">
									<span class="mb-1 block text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.avatars.errors_only") }</span>
									@selectbox.SelectBox() {
										@selectbox.Trigger(selectbox.TriggerProps{Class: "bg-background", DisableClear: true, Attributes: templ.Attributes{"data-avatar-event-filter": "errors"}}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "common.no")}) {
												{ i18n.T(ctx, "common.no") }
											}
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
											@selectbox.Item(selectbox.ItemProps{Value: "false", Selected: true}) {
												{ i18n.T(ctx, "common.no") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "true"}) {
												{ i18n.T(ctx, "common.yes") }
											}
										}
									}
								</label>
							</div>
							<div class="mt-3 text-xs font-medium text-muted-foreground" data-avatar-event-count>{ i18n.T(ctx, "admin.avatars.loading_events") }</div>
							<div class="mt-4 overflow-x-auto rounded-lg border border-border bg-muted/25 shadow-inner">
								<div class="min-w-[58rem]">
									<div class="grid grid-cols-[10rem_minmax(15rem,1fr)_8rem_8rem_minmax(18rem,1.3fr)] gap-3 border-b border-border bg-muted/70 px-4 py-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
										<div>{ i18n.T(ctx, "admin.col.time") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.col.sender") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.provider") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.outcome") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.col.details") }</div>
									</div>
									<div class="h-[34rem] overflow-y-auto" data-avatar-event-viewport></div>
								</div>
							</div>
						</div>
					}
				}
			</div>
		</div>
	</div>
}

func adminAvatarRunLabel(ctx context.Context, mode string) string {
	if mode == "manual" {
		return i18n.T(ctx, "admin.avatars.state.full")
	}
	return i18n.T(ctx, "admin.avatars.state.due")
}

func adminAvatarRunDescription(ctx context.Context, state models.AvatarBackfillState) string {
	if state.CancelRequested {
		return i18n.T(ctx, "admin.avatars.run.canceling")
	}
	if state.InProgress && state.Mode == "manual" {
		return i18n.T(ctx, "admin.avatars.run.full")
	}
	if state.InProgress {
		return i18n.T(ctx, "admin.avatars.run.due")
	}
	if state.Canceled {
		return i18n.T(ctx, "admin.avatars.run.canceled")
	}
	return i18n.T(ctx, "admin.avatars.run.idle")
}

func adminAttemptEmail(ctx context.Context, email string) string {
	if email == "" {
		return i18n.T(ctx, "admin.unknown_sender")
	}
	return email
}

func adminAttemptMessage(ctx context.Context, message string) string {
	return i18n.ServerText(ctx, message)
}

func adminHasMore(attempts []models.AvatarAttemptLog) string {
	if len(attempts) >= 50 {
		return "true"
	}
	return "false"
}

func adminAttemptID(attempt models.AvatarAttemptLog) string {
	return fmt.Sprintf("%s|%s|%s|%s|%d", attempt.CreatedAt.UTC().Format(time.RFC3339Nano), attempt.Provider, attempt.Status, attempt.Email, len(attempt.Message))
}

type adminMetricData struct {
	Key   string
	Label string
	Value int
}

func adminProviderLabel(ctx context.Context, provider string) string {
	switch strings.ToLower(strings.TrimSpace(provider)) {
	case "bimi":
		return "BIMI"
	case "gravatar":
		return "Gravatar"
	case "libravatar":
		return "Libravatar"
	case "domain_icon":
		return i18n.T(ctx, "admin.provider.domain_icon")
	case "":
		return i18n.T(ctx, "admin.unknown")
	default:
		label := strings.ReplaceAll(provider, "_", " ")
		return strings.Title(label)
	}
}

func adminProviderRole(ctx context.Context, provider string) string {
	switch strings.ToLower(strings.TrimSpace(provider)) {
	case "gravatar":
		return i18n.T(ctx, "admin.provider.role.gravatar")
	case "libravatar":
		return i18n.T(ctx, "admin.provider.role.libravatar")
	case "bimi":
		return i18n.T(ctx, "admin.provider.role.bimi")
	case "domain_icon":
		return i18n.T(ctx, "admin.provider.role.domain_icon")
	default:
		return i18n.T(ctx, "admin.provider.role.custom")
	}
}

func adminProviderMetricKey(provider string, metric string) string {
	provider = strings.ToLower(strings.TrimSpace(provider))
	provider = strings.ReplaceAll(provider, "-", "_")
	provider = strings.ReplaceAll(provider, " ", "_")
	if provider == "" {
		provider = "unknown"
	}
	return provider + "_" + metric
}

func adminRunProviderMetricKey(provider string, metric string) string {
	return "run_" + adminProviderMetricKey(provider, metric)
}

func adminProviderInUseTotal(stats []models.AvatarProviderStats) int {
	total := 0
	for _, stat := range stats {
		total += stat.InUse
	}
	return total
}

func adminProviderAttemptTotal(stat models.AvatarProviderStats) int {
	return stat.Checked + stat.Skipped
}

func adminProviderPercent(part, total int) int {
	return adminPercent(part, total)
}

// adminAttemptStatusLabel names a provider attempt's outcome, as admin.js
// does for the rows it draws.
func adminAttemptStatusLabel(ctx context.Context, status string) string {
	switch status {
	case "found":
		return i18n.T(ctx, "admin.avatars.status.found")
	case "missing":
		return i18n.T(ctx, "admin.avatars.status.missing")
	case "skipped":
		return i18n.T(ctx, "admin.avatars.status.skipped")
	case "error":
		return i18n.T(ctx, "admin.avatars.status.error")
	}
	return status
}

func adminAttemptStatusClass(status string) string {
	switch status {
	case "found":
		return "bg-emerald-500/12 text-emerald-700 dark:text-emerald-300"
	case "missing":
		return "bg-slate-500/12 text-slate-700 dark:text-slate-300"
	case "skipped":
		return "bg-blue-500/12 text-blue-700 dark:text-blue-300"
	case "error":
		return "bg-red-500/12 text-red-700 dark:text-red-300"
	default:
		return "bg-muted text-muted-foreground"
	}
}

templ AdminTableUpdateControls() {
	<div class="flex shrink-0 items-center gap-2">
		<span class="text-xs font-semibold text-muted-foreground">{ i18n.T(ctx, "admin.live_updates") }</span>
		@switchcomp.Switch(switchcomp.Props{Checked: true, Class: "avatar-live-switch", Attributes: templ.Attributes{"data-avatar-table-live": ""}})
		<button type="button" class="avatar-table-refresh rounded-md border border-border bg-background px-3 py-1.5 text-xs font-semibold text-muted-foreground transition-colors hover:bg-accent hover:text-foreground disabled:cursor-not-allowed disabled:opacity-50" data-avatar-table-refresh disabled>
			{ i18n.T(ctx, "admin.manual_refresh") }
		</button>
	</div>
}

func adminContactEventLabel(ctx context.Context, eventType string) string {
	switch eventType {
	case "backfill_forced":
		return i18n.T(ctx, "admin.contacts.event.backfill_forced")
	case "backfill_started":
		return i18n.T(ctx, "admin.contacts.event.backfill_started")
	case "backfill_completed":
		return i18n.T(ctx, "admin.contacts.event.backfill_completed")
	case "manual_contact_added":
		return i18n.T(ctx, "admin.contacts.event.manual_contact_added")
	case "observed_contact_added":
		return i18n.T(ctx, "admin.contacts.event.observed_contact_added")
	case "contact_deleted":
		return i18n.T(ctx, "admin.contacts.event.contact_deleted")
	case "observed_contacts_deleted":
		return i18n.T(ctx, "admin.contacts.event.observed_contacts_deleted")
	case "contacts_trashed":
		return i18n.T(ctx, "admin.contacts.event.contacts_trashed")
	case "contacts_restored":
		return i18n.T(ctx, "admin.contacts.event.contacts_restored")
	case "contacts_unresolved":
		return i18n.T(ctx, "admin.contacts.event.contacts_unresolved")
	case "contact_sync_queued":
		return i18n.T(ctx, "admin.contacts.event.contact_sync_queued")
	case "contact_sync_started":
		return i18n.T(ctx, "admin.contacts.event.contact_sync_started")
	case "contact_synced":
		return i18n.T(ctx, "admin.contacts.event.contact_synced")
	case "contact_sync_failed":
		return i18n.T(ctx, "admin.contacts.event.contact_sync_failed")
	case "provider_contacts_synced":
		return i18n.T(ctx, "admin.contacts.event.provider_contacts_synced")
	default:
		return strings.Title(strings.ReplaceAll(eventType, "_", " "))
	}
}

func adminContactEventClass(eventType string) string {
	switch eventType {
	case "backfill_forced", "backfill_started", "contacts_unresolved":
		return "bg-amber-500/12 text-amber-700 dark:text-amber-300"
	case "backfill_completed", "manual_contact_added", "observed_contact_added", "contacts_restored":
		return "bg-emerald-500/12 text-emerald-700 dark:text-emerald-300"
	case "contact_deleted", "observed_contacts_deleted", "contacts_trashed":
		return "bg-red-500/12 text-red-700 dark:text-red-300"
	default:
		return "bg-muted text-muted-foreground"
	}
}

func adminContactRunDescription(ctx context.Context, state models.ContactBackfillState) string {
	if state.InProgress {
		return i18n.T(ctx, "admin.contacts.run.running")
	}
	if state.LastError != "" {
		return i18n.T(ctx, "admin.contacts.run.failed")
	}
	return i18n.T(ctx, "admin.contacts.run.idle")
}

func adminContactRunLabel(ctx context.Context, state models.ContactBackfillState) string {
	if state.InProgress {
		return i18n.T(ctx, "admin.contacts.state.running")
	}
	if state.LastError != "" {
		return i18n.T(ctx, "admin.avatars.error")
	}
	return i18n.T(ctx, "admin.state.idle")
}

func adminContactSyncProviderLabel(ctx context.Context, provider string) string {
	switch strings.ToLower(strings.TrimSpace(provider)) {
	case "gmail":
		return "Gmail"
	case "outlook":
		return "Outlook"
	case "carddav":
		return "CardDAV"
	case "jmap":
		return "JMAP"
	case "":
		return i18n.T(ctx, "admin.unknown")
	default:
		return strings.Title(strings.ReplaceAll(provider, "_", " "))
	}
}

func adminContactSyncLabel(ctx context.Context, sync models.ContactSyncStatus) string {
	if sync.Running {
		return i18n.T(ctx, "admin.sync.syncing")
	}
	if sync.LastError != "" {
		return i18n.T(ctx, "admin.avatars.error")
	}
	if sync.Enabled {
		return i18n.T(ctx, "admin.sync.enabled")
	}
	if sync.Capable {
		return i18n.T(ctx, "admin.sync.configured")
	}
	return i18n.T(ctx, "admin.sync.disabled")
}

func adminContactSyncClass(sync models.ContactSyncStatus) string {
	if sync.Running {
		return "bg-amber-500/12 text-amber-700 dark:text-amber-300"
	}
	if sync.LastError != "" {
		return "bg-red-500/12 text-red-700 dark:text-red-300"
	}
	if sync.Enabled {
		return "bg-emerald-500/12 text-emerald-700 dark:text-emerald-300"
	}
	return "bg-muted text-muted-foreground"
}

func adminLabelProviderLabel(ctx context.Context, provider string) string {
	switch strings.ToLower(strings.TrimSpace(provider)) {
	case "gmail":
		return i18n.T(ctx, "admin.labels.provider.gmail")
	case "outlook":
		return i18n.T(ctx, "admin.labels.provider.outlook")
	case "imap_keyword":
		return i18n.T(ctx, "admin.labels.provider.keywords")
	case "local":
		return i18n.T(ctx, "admin.labels.provider.local")
	case "":
		return i18n.T(ctx, "admin.unknown")
	default:
		return strings.Title(strings.ReplaceAll(provider, "_", " "))
	}
}

func adminLabelSyncLabel(ctx context.Context, account models.LabelAccountSyncStatus) string {
	if account.Sync.LastError != "" {
		return i18n.T(ctx, "admin.avatars.error")
	}
	if !account.Sync.LastRunFinishedAt.IsZero() {
		return i18n.T(ctx, "admin.sync.synced")
	}
	return i18n.T(ctx, "admin.sync.waiting")
}

func adminLabelSyncClass(account models.LabelAccountSyncStatus) string {
	if account.Sync.LastError != "" || account.MutationErrors > 0 {
		return "bg-red-500/12 text-red-700 dark:text-red-300"
	}
	if account.PendingMutations > 0 {
		return "bg-amber-500/12 text-amber-700 dark:text-amber-300"
	}
	if !account.Sync.LastRunFinishedAt.IsZero() {
		return "bg-emerald-500/12 text-emerald-700 dark:text-emerald-300"
	}
	return "bg-muted text-muted-foreground"
}

func adminLabelCoverageText(withLabels int, total int) string {
	return fmt.Sprintf("%d%%", adminPercent(withLabels, total))
}

func adminOutlookGraphParityStatus(ctx context.Context, status *models.OutlookGraphDiagnostics) string {
	if status != nil && status.GraphParityReady {
		return i18n.T(ctx, "admin.parity.ready")
	}
	return i18n.T(ctx, "admin.parity.repair")
}

func adminGmailAPIParityStatus(ctx context.Context, status *models.GmailAPIDiagnostics) string {
	if status != nil && status.APIParityReady {
		return i18n.T(ctx, "admin.parity.ready")
	}
	return i18n.T(ctx, "admin.parity.repair")
}

templ AdminLabelsPage(status models.LabelAdminStatus) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="mb-7 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.labels") }</h2>
						<p class="mt-1 max-w-2xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.labels.description") }</p>
					</div>
					<div class="flex w-full flex-col items-end gap-3 lg:w-auto">
						@AdminWebmailScopeFilter(status.Scope, "/admin/labels")
						<a href={ adminScopeURL("/api/admin/labels/status", status.Scope) } class="w-fit whitespace-nowrap rounded-md border border-border bg-background px-3 py-1.5 text-xs font-semibold text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "admin.raw_json") }</a>
					</div>
				</div>
				<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
					@AdminMetric("labels_total_messages", i18n.T(ctx, "admin.labels.visible"), status.Totals.TotalMessages)
					@AdminMetric("labels_with_labels", i18n.T(ctx, "admin.labels.with"), status.Totals.MessagesWithLabels)
					@AdminMetric("labels_without_labels", i18n.T(ctx, "admin.labels.without"), status.Totals.MessagesWithoutLabels)
					@AdminMetric("labels_known", i18n.T(ctx, "admin.labels.known"), status.Totals.KnownLabels)
					@AdminMetric("labels_provider_backed", i18n.T(ctx, "admin.labels.provider_backed"), status.Totals.ProviderBackedMessages)
					@AdminMetric("labels_local_only", i18n.T(ctx, "admin.labels.local_only"), status.Totals.LocalOnlyMessages)
					@AdminMetric("labels_missing_provider", i18n.T(ctx, "admin.labels.missing_provider"), status.Totals.MissingProviderMessages)
					@AdminMetric("labels_pending_mutations", i18n.T(ctx, "admin.labels.queued"), status.Totals.PendingMutations)
				</div>
				<div class="mt-5 grid gap-4 lg:grid-cols-3">
					<div class="rounded-lg border border-border bg-card p-4">
						<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.labels.coverage") }</div>
						<div class="mt-3 flex items-center justify-between gap-3">
							<div class="text-sm font-medium text-muted-foreground">{ i18n.T(ctx, "admin.labels.any_label") }</div>
							<div class="text-sm font-bold tabular-nums text-foreground">{ adminLabelCoverageText(status.Totals.MessagesWithLabels, status.Totals.TotalMessages) }</div>
						</div>
						<div class="mt-3 h-2 overflow-hidden rounded-md bg-muted shadow-inner">
							<div class="h-full rounded-md bg-primary" style={ fmt.Sprintf("width:%d%%", adminPercent(status.Totals.MessagesWithLabels, status.Totals.TotalMessages)) }></div>
						</div>
					</div>
					<div class="rounded-lg border border-border bg-card p-4">
						<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.labels.last_run") }</div>
						<div class="mt-3 space-y-2">
							@AdminCompactMetric("labels_last_run_missing", i18n.T(ctx, "admin.labels.not_found_remote"), status.Totals.LastRunMissingProvider)
							@AdminCompactMetric("labels_last_run_skipped", i18n.T(ctx, "admin.labels.skipped_identity"), status.Totals.LastRunSkipped)
							@AdminCompactMetric("labels_last_run_failed", i18n.T(ctx, "admin.labels.failed_imports"), status.Totals.LastRunFailed)
						</div>
					</div>
					<div class="rounded-lg border border-border bg-card p-4">
						<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.labels.queue") }</div>
						<div class="mt-3 space-y-2">
							@AdminCompactMetric("labels_queue_pending", i18n.T(ctx, "admin.pending"), status.Totals.PendingMutations)
							@AdminCompactMetric("labels_queue_errors", i18n.T(ctx, "admin.labels.with_errors"), status.Totals.MutationErrors)
							@AdminCompactMetric("labels_identity_missing", i18n.T(ctx, "admin.labels.missing_message_id"), status.Totals.MissingIdentityMessages)
						</div>
					</div>
				</div>
				<div class="mt-6 space-y-4">
					<div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
						<div>
							<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.accounts") }</div>
							<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.labels.accounts_detail") }</p>
						</div>
						<div class="text-xs font-semibold text-muted-foreground tabular-nums">{ i18n.N(ctx, "admin.accounts_count", len(status.Accounts), "count", i18n.Number(ctx, len(status.Accounts))) }</div>
					</div>
					if len(status.Accounts) == 0 {
						<div class="rounded-lg border border-dashed border-border bg-background/35 px-4 py-8 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "admin.no_accounts") }</div>
					} else {
						<div class="grid gap-4 xl:grid-cols-2">
							for _, account := range status.Accounts {
								@AdminLabelAccountCard(account)
							}
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

templ AdminLabelAccountCard(account models.LabelAccountSyncStatus) {
	<div class="rounded-lg border border-border bg-card p-4">
		<div class="mb-4 flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="truncate text-sm font-bold text-foreground">{ account.AccountName }</div>
				<div class="mt-0.5 truncate text-xs font-medium text-muted-foreground">{ account.AccountEmail }</div>
				if account.OwnerUsername != "" {
					<div class="mt-1 truncate text-[11px] font-medium text-muted-foreground">{ i18n.T(ctx, "admin.owned_by", "username", account.OwnerUsername) }</div>
				}
				<div class="mt-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ adminLabelProviderLabel(ctx, account.LabelProvider) }</div>
			</div>
			<span class={ "inline-flex shrink-0 rounded-md px-2.5 py-1 text-[11px] font-semibold", adminLabelSyncClass(account) }>{ adminLabelSyncLabel(ctx, account) }</span>
		</div>
		<div class="mb-4">
			<div class="flex items-center justify-between gap-3">
				<div class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "admin.labels.label_coverage") }</div>
				<div class="text-xs font-bold tabular-nums text-foreground">{ adminLabelCoverageText(account.MessagesWithLabels, account.TotalMessages) }</div>
			</div>
			<div class="mt-2 h-2 overflow-hidden rounded-md bg-muted shadow-inner">
				<div class="h-full rounded-md bg-primary" style={ fmt.Sprintf("width:%d%%", adminPercent(account.MessagesWithLabels, account.TotalMessages)) }></div>
			</div>
		</div>
		<div class="grid gap-2 sm:grid-cols-2">
			@AdminDetail("labels_total_"+account.AccountID, i18n.T(ctx, "admin.labels.visible"), i18n.Number(ctx, account.TotalMessages))
			@AdminDetail("labels_any_"+account.AccountID, i18n.T(ctx, "admin.labels.with"), i18n.Number(ctx, account.MessagesWithLabels))
			@AdminDetail("labels_provider_"+account.AccountID, i18n.T(ctx, "admin.labels.provider_backed"), i18n.Number(ctx, account.ProviderBackedMessages))
			@AdminDetail("labels_local_only_"+account.AccountID, i18n.T(ctx, "admin.labels.local_only"), i18n.Number(ctx, account.LocalOnlyMessages))
			@AdminDetail("labels_missing_provider_"+account.AccountID, i18n.T(ctx, "admin.labels.missing_provider"), i18n.Number(ctx, account.MissingProviderMessages))
			@AdminDetail("labels_missing_identity_"+account.AccountID, i18n.T(ctx, "admin.labels.missing_message_id"), i18n.Number(ctx, account.MissingIdentityMessages))
			@AdminDetail("labels_catalog_"+account.AccountID, i18n.T(ctx, "admin.labels.known"), i18n.Number(ctx, account.KnownLabels))
			@AdminDetail("labels_queue_"+account.AccountID, i18n.T(ctx, "admin.labels.queued"), i18n.Number(ctx, account.PendingMutations))
		</div>
		if account.OutlookGraph != nil {
			<div class="mt-4 rounded-lg border border-border bg-background/35 p-3">
				<div class="mb-2 flex items-center justify-between gap-3">
					<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.labels.graph_parity") }</div>
					<div class="text-[11px] font-bold tabular-nums text-foreground">{ i18n.T(ctx, "admin.labels.folders_ratio", "done", i18n.Number(ctx, account.OutlookGraph.GraphBackedFolders), "total", i18n.Number(ctx, account.OutlookGraph.LocalFolders)) }</div>
				</div>
				<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
					@AdminCompactMetric("labels_graph_messages_"+account.AccountID, i18n.T(ctx, "admin.labels.graph_ids"), account.OutlookGraph.GraphBackedMessages)
					@AdminCompactMetric("labels_imap_messages_"+account.AccountID, i18n.T(ctx, "admin.labels.imap_rows"), account.OutlookGraph.IMAPBackedMessages)
					@AdminCompactMetric("labels_graph_delta_"+account.AccountID, i18n.T(ctx, "admin.labels.parity_delta"), account.OutlookGraph.MessageParityDelta)
					@AdminCompactDetail("labels_graph_ready_"+account.AccountID, i18n.T(ctx, "admin.labels.parity_status"), adminOutlookGraphParityStatus(ctx, account.OutlookGraph))
					@AdminCompactMetric("labels_missing_graph_"+account.AccountID, i18n.T(ctx, "admin.labels.missing_graph"), account.OutlookGraph.MessagesMissingGraphID)
					@AdminCompactMetric("labels_backfillable_"+account.AccountID, i18n.T(ctx, "admin.labels.backfillable"), account.OutlookGraph.MissingGraphIDWithInternetID)
					@AdminCompactMetric("labels_unresolvable_"+account.AccountID, i18n.T(ctx, "admin.labels.no_message_id"), account.OutlookGraph.MissingGraphIDWithoutInternetID)
					@AdminCompactMetric("labels_missing_graph_folder_"+account.AccountID, i18n.T(ctx, "admin.labels.no_graph_folder"), account.OutlookGraph.MissingGraphIDWithoutGraphFolder)
				</div>
			</div>
		}
		if account.GmailAPI != nil {
			<div class="mt-4 rounded-lg border border-border bg-background/35 p-3">
				<div class="mb-2 flex items-center justify-between gap-3">
					<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.labels.gmail_parity") }</div>
					<div class="text-[11px] font-bold tabular-nums text-foreground">{ i18n.T(ctx, "admin.labels.folders_ratio", "done", i18n.Number(ctx, account.GmailAPI.GmailBackedFolders), "total", i18n.Number(ctx, account.GmailAPI.LocalFolders)) }</div>
				</div>
				<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
					@AdminCompactMetric("labels_gmail_messages_"+account.AccountID, i18n.T(ctx, "admin.labels.gmail_ids"), account.GmailAPI.APIBackedMessages)
					@AdminCompactMetric("labels_gmail_imap_messages_"+account.AccountID, i18n.T(ctx, "admin.labels.imap_rows"), account.GmailAPI.IMAPBackedMessages)
					@AdminCompactMetric("labels_gmail_delta_"+account.AccountID, i18n.T(ctx, "admin.labels.parity_delta"), account.GmailAPI.MessageParityDelta)
					@AdminCompactDetail("labels_gmail_ready_"+account.AccountID, i18n.T(ctx, "admin.labels.parity_status"), adminGmailAPIParityStatus(ctx, account.GmailAPI))
					@AdminCompactMetric("labels_missing_gmail_"+account.AccountID, i18n.T(ctx, "admin.labels.missing_gmail"), account.GmailAPI.MessagesMissingGmailID)
					@AdminCompactMetric("labels_gmail_backfillable_"+account.AccountID, i18n.T(ctx, "admin.labels.backfillable"), account.GmailAPI.MissingGmailIDWithInternetID)
					@AdminCompactMetric("labels_gmail_unresolvable_"+account.AccountID, i18n.T(ctx, "admin.labels.no_message_id"), account.GmailAPI.MissingGmailIDWithoutInternetID)
					@AdminCompactMetric("labels_missing_gmail_folder_"+account.AccountID, i18n.T(ctx, "admin.labels.no_gmail_label"), account.GmailAPI.MissingGmailIDWithoutGmailLabel)
					@AdminCompactDetail("labels_gmail_cursor_"+account.AccountID, i18n.T(ctx, "admin.labels.history_cursor"), account.GmailAPI.HistoryCursor)
				</div>
			</div>
		}
		<div class="mt-4 grid gap-3 lg:grid-cols-2">
			<div class="rounded-lg border border-border bg-background/35 p-3">
				<div class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.labels.last_sync") }</div>
				<div class="space-y-2">
					@AdminCompactDetail("labels_sync_finished_"+account.AccountID, i18n.T(ctx, "admin.finished"), adminTime(ctx, account.Sync.LastRunFinishedAt))
					@AdminCompactMetric("labels_sync_total_"+account.AccountID, i18n.T(ctx, "admin.labels.scanned"), account.Sync.LastTotalMessages)
					@AdminCompactMetric("labels_sync_synced_"+account.AccountID, i18n.T(ctx, "admin.labels.synced"), account.Sync.LastSyncedMessages)
					@AdminCompactMetric("labels_sync_missing_"+account.AccountID, i18n.T(ctx, "admin.labels.not_found"), account.Sync.LastMissingProviderMessages)
					@AdminCompactMetric("labels_sync_skipped_"+account.AccountID, i18n.T(ctx, "admin.skipped"), account.Sync.LastSkippedMessages)
					@AdminCompactMetric("labels_sync_failed_"+account.AccountID, i18n.T(ctx, "admin.failed"), account.Sync.LastFailedMessages)
				</div>
			</div>
			<div class="rounded-lg border border-border bg-background/35 p-3">
				<div class="mb-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.labels.top") }</div>
				if len(account.TopLabels) == 0 {
					<div class="rounded-md border border-dashed border-border px-3 py-5 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "admin.labels.top_empty") }</div>
				} else {
					<div class="space-y-2">
						for _, label := range account.TopLabels {
							<div>
								<div class="flex items-center justify-between gap-3 text-xs">
									<div class="min-w-0 truncate font-semibold text-foreground">{ label.Name }</div>
									<div class="shrink-0 tabular-nums text-muted-foreground">{ i18n.Number(ctx, label.Count) }</div>
								</div>
								<div class="mt-1 h-1.5 overflow-hidden rounded-md bg-muted">
									<div class="h-full rounded-md bg-primary/80" style={ fmt.Sprintf("width:%d%%", adminPercent(label.Count, account.MessagesWithLabels)) }></div>
								</div>
								<div class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ adminLabelProviderLabel(ctx, label.ProviderType) }</div>
							</div>
						}
					</div>
				}
			</div>
		</div>
		if account.Sync.LastError != "" {
			<div class="mt-3 rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs font-medium text-red-700 dark:text-red-300">{ account.Sync.LastError }</div>
		}
		if account.LatestMutationError != "" {
			<div class="mt-3 rounded-lg border border-amber-500/20 bg-amber-500/10 px-3 py-2 text-xs font-medium text-amber-800 dark:text-amber-200">{ account.LatestMutationError }</div>
		}
	</div>
}

templ AdminContactsPage(status models.ContactAdminStatus) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="mb-7 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.contacts") }</h2>
						<p class="mt-1 max-w-2xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.contacts.description") }</p>
					</div>
					<div class="flex w-full shrink-0 flex-col items-end gap-3 lg:w-auto">
						@AdminWebmailScopeFilter(status.Scope, "/admin/contacts")
						<form method="post" action={ adminScopeURL("/admin/contacts/backfill", status.Scope) } data-contact-backfill-form>
							<button type="submit" class="rounded-md border border-amber-500/35 bg-amber-500/10 px-3 py-2 text-xs font-semibold text-amber-800 transition-colors hover:bg-amber-500/20 disabled:cursor-not-allowed disabled:opacity-50 dark:text-amber-200" disabled?={ status.Backfill.InProgress }>
								if status.Scope.SelectedUserID == "" {
									{ i18n.T(ctx, "admin.contacts.force") }
								} else {
									{ i18n.T(ctx, "admin.contacts.backfill_selected") }
								}
							</button>
						</form>
					</div>
				</div>
				@tabs.Tabs(tabs.Props{ID: "contact-admin-tabs", Attributes: templ.Attributes{"data-contact-admin": ""}}) {
					@tabs.List(tabs.ListProps{Class: "bg-card"}) {
						@tabs.Trigger(tabs.TriggerProps{Value: "overview", IsActive: true}) {
							{ i18n.T(ctx, "admin.tab.overview") }
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "events"}) {
							{ i18n.T(ctx, "admin.tab.events") }
						}
					}
					@tabs.Content(tabs.ContentProps{Value: "overview", IsActive: true, Class: "mt-6 space-y-5"}) {
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="flex items-start justify-between gap-4">
								<div class="min-w-0">
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.contacts.run_title") }</div>
									<p class="mt-1 text-sm text-muted-foreground" data-contact-run-description>{ adminContactRunDescription(ctx, status.Backfill) }</p>
								</div>
								<span
									class={
										"inline-flex w-fit shrink-0 items-center rounded-md px-2.5 py-1 text-[11px] font-semibold",
										templ.KV("bg-amber-500/12 text-amber-700 dark:text-amber-300", status.Backfill.InProgress),
										templ.KV("bg-red-500/12 text-red-700 dark:text-red-300", !status.Backfill.InProgress && status.Backfill.LastError != ""),
										templ.KV("bg-emerald-500/12 text-emerald-700 dark:text-emerald-300", !status.Backfill.InProgress && status.Backfill.LastError == ""),
									}
									data-contact-state
								>
									{ adminContactRunLabel(ctx, status.Backfill) }
								</span>
							</div>
							<div class="mt-2 flex items-center justify-between gap-4">
								<div class="text-sm font-medium text-foreground" data-contact-progress-text>{ i18n.T(ctx, "admin.progress", "done", i18n.Number(ctx, status.Backfill.Processed), "total", i18n.Number(ctx, status.Backfill.Total)) }</div>
								<div class="text-sm font-semibold tabular-nums text-foreground" data-contact-progress-percent>{ fmt.Sprintf("%d%%", adminPercent(status.Backfill.Processed, status.Backfill.Total)) }</div>
							</div>
							<div class="mt-4 h-2 overflow-hidden rounded-md bg-muted shadow-inner">
								<div class="h-full rounded-md bg-primary transition-all duration-500" style={ fmt.Sprintf("width:%d%%", adminPercent(status.Backfill.Processed, status.Backfill.Total)) } data-contact-progress-bar></div>
							</div>
						</div>
						<div class="grid gap-4 lg:grid-cols-2">
							<div class="rounded-lg border border-border bg-card p-4">
								<div class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.contacts.registry") }</div>
								<div class="flex min-h-[10.75rem] flex-col justify-between gap-3">
									@AdminCompactMetric("contacts_total", i18n.T(ctx, "admin.contacts.metric.active"), status.Total)
									@AdminCompactMetric("contacts_observed", i18n.T(ctx, "admin.contacts.metric.observed"), status.Observed)
									@AdminCompactMetric("contacts_manual", i18n.T(ctx, "admin.contacts.metric.manual"), status.Manual)
									@AdminCompactMetric("contacts_synced", i18n.T(ctx, "admin.contacts.metric.provider"), status.Synced)
									@AdminCompactMetric("contacts_suppressed", i18n.T(ctx, "admin.contacts.metric.suppressed"), status.Suppressed)
								</div>
							</div>
							<div class="rounded-lg border border-border bg-card p-4">
								<div class="mb-3 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.run_status") }</div>
								<div class="space-y-3">
									@AdminCompactDetail("contacts_started", i18n.T(ctx, "admin.started"), adminTime(ctx, status.Backfill.StartedAt))
									@AdminCompactDetail("contacts_finished", i18n.T(ctx, "admin.finished"), adminTime(ctx, status.Backfill.FinishedAt))
									@AdminCompactDetail("contacts_last_backfill", i18n.T(ctx, "admin.contacts.last_backfill"), adminTime(ctx, status.LastBackfill))
									@AdminCompactMetric("contacts_added_today", i18n.T(ctx, "admin.contacts.metric.added_24h"), status.AddedToday)
									@AdminCompactMetric("contacts_deleted_today", i18n.T(ctx, "admin.contacts.metric.deleted_24h"), status.DeletedToday)
									@AdminErrorDetail("contacts_last_error", i18n.T(ctx, "admin.latest_error"), adminError(ctx, status.Backfill.LastError))
								</div>
							</div>
						</div>
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-start sm:justify-between">
								<div>
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.contacts.account_sync") }</div>
									<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.contacts.account_sync_detail") }</p>
								</div>
								<a href="/api/admin/contacts/status" class="w-fit whitespace-nowrap rounded-md border border-border bg-background px-3 py-1.5 text-xs font-semibold text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">{ i18n.T(ctx, "admin.raw_json") }</a>
							</div>
							if len(status.AccountSync) == 0 {
								<div class="rounded-lg border border-dashed border-border bg-background/35 px-4 py-8 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "admin.contacts.no_sync") }</div>
							} else {
								<div class="grid gap-3 xl:grid-cols-2">
									for _, sync := range status.AccountSync {
										@AdminContactSyncCard(sync)
									}
								</div>
							}
						</div>
					}
					@tabs.Content(tabs.ContentProps{Value: "events", Class: "mt-6 space-y-4"}) {
						<div class="rounded-lg border border-border bg-card p-4">
							<div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
								<div>
									<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.tab.events") }</div>
									<p class="mt-1 text-sm text-muted-foreground">{ i18n.T(ctx, "admin.contacts.events_detail") }</p>
								</div>
							</div>
							<div class="mt-3 text-xs font-medium text-muted-foreground" data-contact-event-count>{ i18n.N(ctx, "admin.contacts.recent_events", len(status.RecentEvents), "count", i18n.Number(ctx, len(status.RecentEvents))) }</div>
							<div class="mt-4 overflow-x-auto rounded-lg border border-border bg-muted/25 shadow-inner">
								<div class="min-w-[58rem]">
									<div class="grid grid-cols-[10rem_minmax(15rem,1fr)_12rem_8rem_minmax(18rem,1.3fr)] gap-3 border-b border-border bg-muted/70 px-4 py-2 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
										<div>{ i18n.T(ctx, "admin.col.time") }</div>
										<div>{ i18n.T(ctx, "admin.contacts.col.user") }</div>
										<div>{ i18n.T(ctx, "admin.col.event") }</div>
										<div>{ i18n.T(ctx, "admin.contacts.col.count") }</div>
										<div>{ i18n.T(ctx, "admin.avatars.col.details") }</div>
									</div>
									<div class="h-[34rem] overflow-y-auto" data-contact-event-viewport>
										if len(status.RecentEvents) == 0 {
											<div class="px-4 py-8 text-center text-sm text-muted-foreground">{ i18n.T(ctx, "admin.contacts.no_activity") }</div>
										} else {
											for _, event := range status.RecentEvents {
												@AdminContactEventRow(event)
											}
										}
									</div>
								</div>
							</div>
						</div>
					}
				}
			</div>
		</div>
	</div>
}

templ AdminContactSyncCard(sync models.ContactSyncStatus) {
	<div class="rounded-lg border border-border bg-background/45 p-4">
		<div class="mb-4 flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="truncate text-sm font-bold text-foreground">{ sync.AccountName }</div>
				<div class="mt-0.5 truncate text-xs font-medium text-muted-foreground">{ sync.AccountEmail }</div>
				if sync.OwnerUsername != "" {
					<div class="mt-1 truncate text-[11px] font-medium text-muted-foreground">{ i18n.T(ctx, "admin.owned_by", "username", sync.OwnerUsername) }</div>
				}
			</div>
			<span class={ "inline-flex shrink-0 rounded-md px-2.5 py-1 text-[11px] font-semibold", adminContactSyncClass(sync) }>{ adminContactSyncLabel(ctx, sync) }</span>
		</div>
		<div class="grid gap-2 sm:grid-cols-2">
			@AdminDetail("contact_sync_provider_"+sync.AccountID, i18n.T(ctx, "admin.avatars.provider"), adminContactSyncProviderLabel(ctx, sync.Provider))
			@AdminDetail("contact_sync_imported_"+sync.AccountID, i18n.T(ctx, "admin.last_import"), i18n.Number(ctx, sync.LastImportCount))
			@AdminDetail("contact_sync_started_"+sync.AccountID, i18n.T(ctx, "admin.started"), adminTime(ctx, sync.LastStartedAt))
			@AdminDetail("contact_sync_success_"+sync.AccountID, i18n.T(ctx, "admin.last_success"), adminTime(ctx, sync.LastSuccessAt))
		</div>
		if sync.LastError != "" {
			<div class="mt-3 rounded-lg border border-red-500/20 bg-red-500/10 px-3 py-2 text-xs font-medium text-red-700 dark:text-red-300">{ sync.LastError }</div>
		}
	</div>
}

templ AdminContactEventRow(event models.ContactActivityEvent) {
	<div class="grid grid-cols-[10rem_minmax(15rem,1fr)_12rem_8rem_minmax(18rem,1.3fr)] gap-3 border-b border-border/70 bg-background/55 px-4 py-3 text-sm odd:bg-background/70 hover:bg-accent/35">
		<div class="text-xs font-medium text-muted-foreground">{ adminTime(ctx, event.CreatedAt) }</div>
		<div class="min-w-0">
			<div class="truncate font-medium text-foreground">
				if event.Username != "" {
					{ event.Username }
				} else {
					{ i18n.T(ctx, "admin.unknown_user") }
				}
			</div>
			<div class="truncate text-xs text-muted-foreground">
				if event.Email != "" {
					{ event.Email }
				} else {
					{ i18n.T(ctx, "admin.system_event") }
				}
			</div>
		</div>
		<div><span class={ "inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold", adminContactEventClass(event.Type) }>{ adminContactEventLabel(ctx, event.Type) }</span></div>
		<div class="text-sm font-semibold tabular-nums text-foreground">{ i18n.Number(ctx, event.Count) }</div>
		<div class="min-w-0 truncate text-sm text-muted-foreground">{ i18n.Stored(ctx, "admin.contacts.message.", event.Message) }</div>
	</div>
}

func adminError(ctx context.Context, err string) string {
	if err == "" {
		return i18n.T(ctx, "admin.no_error")
	}
	return err
}

templ AdminAttemptRow(attempt models.AvatarAttemptLog, errorMode bool) {
	<div class="grid gap-2 px-4 py-3 text-sm lg:grid-cols-[10rem_1fr_12rem] lg:items-start" data-log-row data-log-id={ adminAttemptID(attempt) }>
		<div class="flex items-center gap-2">
			<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{ attempt.Provider }</span>
			<span class={ "inline-flex rounded-full px-2 py-0.5 text-[11px] font-semibold", adminAttemptStatusClass(attempt.Status) }>{ adminAttemptStatusLabel(ctx, attempt.Status) }</span>
		</div>
		<div class="min-w-0">
			<div class="truncate font-medium text-foreground">{ adminAttemptEmail(ctx, attempt.Email) }</div>
			if errorMode {
				<div class="mt-0.5 whitespace-pre-wrap break-words text-xs text-muted-foreground">{ adminAttemptMessage(ctx, attempt.Message) }</div>
			} else if attempt.Message != "" {
				<div class="mt-0.5 truncate text-xs text-muted-foreground">{ adminAttemptMessage(ctx, attempt.Message) }</div>
			}
		</div>
		<div class="text-xs font-medium text-muted-foreground lg:text-right">{ adminTime(ctx, attempt.CreatedAt) }</div>
	</div>
}

templ AdminMetric(key string, label string, value int) {
	<div class="rounded-lg border border-border bg-background/45 px-3 py-3 transition-colors duration-300" data-admin-metric={ key }>
		<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		<div class="mt-1 text-xl font-bold tabular-nums text-foreground" data-admin-metric-value>{ i18n.Number(ctx, value) }</div>
	</div>
}

templ AdminCompactMetric(key string, label string, value int) {
	<div class="flex items-center justify-between gap-3 rounded-lg px-2 py-1 transition-colors duration-300" data-admin-metric={ key }>
		<div class="text-sm text-muted-foreground">{ label }</div>
		<div class="text-sm font-semibold tabular-nums text-foreground" data-admin-metric-value>{ i18n.Number(ctx, value) }</div>
	</div>
}

templ AdminCompactDetail(key string, label string, value string) {
	<div class="flex items-center justify-between gap-3 rounded-lg px-2 py-1 transition-colors duration-300" data-admin-detail={ key }>
		<div class="text-sm text-muted-foreground">{ label }</div>
		<div class="max-w-40 truncate text-right text-sm font-semibold text-foreground" data-admin-detail-value>{ value }</div>
	</div>
}

templ AdminErrorDetail(key string, label string, value string) {
	<div class="space-y-1" data-admin-detail={ key }>
		<div class="text-sm text-muted-foreground">{ label }</div>
		<div class="line-clamp-3 break-words text-sm font-semibold text-foreground" data-admin-detail-value>{ value }</div>
	</div>
}

templ AdminInlineMetric(key string, label string, value int) {
	<div class="rounded-md border border-border bg-card px-2.5 py-1.5 transition-colors duration-300" data-admin-metric={ key }>
		<div class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		<div class="text-sm font-bold tabular-nums text-foreground" data-admin-metric-value>{ i18n.Number(ctx, value) }</div>
	</div>
}

templ AdminInlineDetail(key string, label string, value string) {
	<div class="inline-flex min-w-0 items-center gap-1.5 text-xs" data-admin-detail={ key }>
		<span class="text-muted-foreground">{ label }</span>
		<span class="max-w-40 truncate font-semibold text-foreground" data-admin-detail-value>{ value }</span>
	</div>
}

templ AdminProviderUsageRow(provider models.AvatarProviderStats, totalFound int) {
	<div>
		<div class="mb-1.5 flex items-center justify-between gap-3 text-sm">
			<div class="min-w-0">
				<div class="truncate font-semibold text-foreground">{ adminProviderLabel(ctx, provider.Provider) }</div>
				<div class="text-xs text-muted-foreground">{ adminProviderRole(ctx, provider.Provider) }</div>
			</div>
			<div class="shrink-0 text-right text-xs font-semibold tabular-nums text-foreground" data-admin-metric={ adminProviderMetricKey(provider.Provider, "in_use") }><span data-admin-metric-value>{ fmt.Sprintf("%d", provider.InUse) }</span></div>
		</div>
		<div class="h-2 overflow-hidden rounded-md bg-muted shadow-inner">
			<div class="h-full rounded-md bg-primary/80" style={ fmt.Sprintf("width:%d%%", adminProviderPercent(provider.InUse, totalFound)) }></div>
		</div>
	</div>
}

templ AdminRunProviderCard(provider models.AvatarProviderStats) {
	<div class="flex flex-col gap-3 rounded-lg border border-border bg-background/35 px-3 py-2 sm:flex-row sm:items-center sm:justify-between">
		<div class="min-w-36 shrink-0">
			<div class="min-w-0 truncate text-sm font-semibold text-foreground">{ adminProviderLabel(ctx, provider.Provider) }</div>
		</div>
		<div class="grid flex-1 grid-cols-5 gap-2">
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "checked"), i18n.T(ctx, "admin.avatars.checked"), provider.Checked)
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "found"), i18n.T(ctx, "admin.avatars.metric.found_short"), provider.Found)
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "missing"), i18n.T(ctx, "admin.avatars.metric.missing_short"), provider.Missing)
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "skipped"), i18n.T(ctx, "admin.skipped"), provider.Skipped)
			@AdminInlineMetric(adminRunProviderMetricKey(provider.Provider, "error"), i18n.T(ctx, "admin.errors"), provider.Error)
		</div>
	</div>
}

templ AdminProviderCard(provider models.AvatarProviderStats) {
	<div class="rounded-lg border border-border bg-card p-4 transition-colors hover:bg-accent/20">
		<div class="mb-4 flex items-start justify-between gap-3">
			<div class="min-w-0">
				<div class="truncate text-base font-bold text-foreground" style="font-family: var(--font-serif)">{ adminProviderLabel(ctx, provider.Provider) }</div>
				<div class="mt-0.5 text-xs font-medium text-muted-foreground">{ adminProviderRole(ctx, provider.Provider) }</div>
			</div>
			<div class="rounded-md border border-border bg-background px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ provider.Provider }</div>
		</div>
		<div class="grid gap-3 sm:grid-cols-2">
			@AdminMetric(adminProviderMetricKey(provider.Provider, "in_use"), i18n.T(ctx, "admin.avatars.col.in_use"), provider.InUse)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "checked"), i18n.T(ctx, "admin.avatars.checked"), provider.Checked)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "found"), i18n.T(ctx, "admin.avatars.metric.found_short"), provider.Found)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "missing"), i18n.T(ctx, "admin.avatars.metric.missing_short"), provider.Missing)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "skipped"), i18n.T(ctx, "admin.skipped"), provider.Skipped)
			@AdminMetric(adminProviderMetricKey(provider.Provider, "error"), i18n.T(ctx, "admin.errors"), provider.Error)
		</div>
		<div class="mt-4 border-t border-border pt-3">
			<div class="mb-1 flex items-center justify-between text-xs">
				<span class="font-medium text-muted-foreground">{ i18n.T(ctx, "admin.avatars.found_rate") }</span>
				<span class="font-semibold tabular-nums text-foreground">{ fmt.Sprintf("%d%%", adminProviderPercent(provider.Found, provider.Checked)) }</span>
			</div>
			<div class="h-1.5 overflow-hidden rounded-md bg-muted">
				<div class="h-full rounded-md bg-emerald-500/80" style={ fmt.Sprintf("width:%d%%", adminProviderPercent(provider.Found, provider.Checked)) }></div>
			</div>
			<div class="mt-2 text-[11px] text-muted-foreground">{ i18n.N(ctx, "admin.avatars.lookups", adminProviderAttemptTotal(provider), "count", i18n.Number(ctx, adminProviderAttemptTotal(provider))) }</div>
		</div>
	</div>
}

templ AdminDetail(key string, label string, value string) {
	<div class="rounded-lg border border-border bg-background/35 px-3 py-3 min-w-0" data-admin-detail={ key }>
		<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		<div class="mt-1 truncate text-sm font-medium text-foreground" data-admin-detail-value>{ value }</div>
	</div>
}

func adminMailHealthStateLabel(ctx context.Context, state string) string {
	switch state {
	case "pending":
		return i18n.T(ctx, "admin.ops.state.pending")
	case "processing", "syncing", "copying", "sending":
		return i18n.T(ctx, "admin.ops.state.running")
	case "failed":
		return i18n.T(ctx, "admin.ops.state.failed")
	case "ambiguous":
		return i18n.T(ctx, "admin.ops.state.ambiguous")
	case "applied":
		return i18n.T(ctx, "admin.ops.state.applied")
	default:
		return state
	}
}

func adminMailHealthKindLabel(ctx context.Context, kind string) string {
	switch kind {
	case "read":
		return i18n.T(ctx, "admin.ops.kind.read")
	case "starred":
		return i18n.T(ctx, "admin.ops.kind.starred")
	case "move":
		return i18n.T(ctx, "admin.ops.kind.move")
	case "delete":
		return i18n.T(ctx, "admin.ops.kind.delete")
	default:
		return kind
	}
}

templ AdminMailHealthCard(label string, value int, warning bool, danger bool) {
	<div
		class={
			"rounded-lg border bg-card p-4",
			templ.KV("border-amber-500/30", warning && !danger),
			templ.KV("border-red-500/35", danger),
			templ.KV("border-border", !warning && !danger),
		}
	>
		<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ label }</div>
		<div
			class={
				"mt-2 text-2xl font-bold tabular-nums",
				templ.KV("text-amber-700 dark:text-amber-300", warning && !danger),
				templ.KV("text-red-700 dark:text-red-300", danger),
				templ.KV("text-foreground", !warning && !danger),
			}
		>{ i18n.Number(ctx, value) }</div>
	</div>
}

templ AdminMailOperationsPage(status models.MailOperationsAdminStatus) {
	<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
		<div class="flex-1 overflow-y-auto">
			<div class="max-w-6xl px-6 py-8 lg:px-8 lg:py-10">
				<div class="mb-7 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
					<div>
						<h2 class="text-2xl font-bold text-foreground" style="font-family: var(--font-serif)">{ i18n.T(ctx, "admin.nav.operations") }</h2>
						<p class="mt-1 max-w-3xl text-sm text-muted-foreground">{ i18n.T(ctx, "admin.ops.description") }</p>
					</div>
					@AdminWebmailScopeFilter(status.Scope, "/admin/operations")
				</div>
				<div class="grid gap-3 sm:grid-cols-2">
					<div class="rounded-lg border border-border bg-card p-4">
						<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.ops.retained") }</div>
						<div class="mt-2 text-2xl font-bold tabular-nums text-foreground">{ i18n.Number(ctx, status.Total) }</div>
					</div>
					<div
						class={
							"rounded-lg border bg-card p-4",
							templ.KV("border-amber-500/30", status.ActionRequired > 0),
							templ.KV("border-border", status.ActionRequired == 0),
						}
					>
						<div class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{ i18n.T(ctx, "admin.ops.attention") }</div>
						<div
							class={
								"mt-2 text-2xl font-bold tabular-nums",
								templ.KV("text-amber-700 dark:text-amber-300", status.ActionRequired > 0),
								templ.KV("text-foreground", status.ActionRequired == 0),
							}
						>{ i18n.Number(ctx, status.ActionRequired) }</div>
					</div>
				</div>
				if status.Scope.SelectedUserID == "" {
					<section class="mt-5 rounded-lg border border-border bg-card p-5">
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div>
								<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.ops.retention") }</div>
								<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.retention_detail") }</p>
							</div>
							<div class="text-right text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.last_run", "date", adminTime(ctx, status.Retention.LastRunAt)) }</div>
						</div>
						<div class="mt-4 grid gap-2 sm:grid-cols-4">
							@AdminCompactMetric("retention_outgoing_sends", i18n.T(ctx, "admin.ops.pruned.sends"), status.Retention.LastPruned.OutgoingSends)
							@AdminCompactMetric("retention_message_mutations", i18n.T(ctx, "admin.ops.pruned.mutations"), status.Retention.LastPruned.MessageMutations)
							@AdminCompactMetric("retention_imap_drafts", i18n.T(ctx, "admin.ops.pruned.drafts"), status.Retention.LastPruned.IMAPDraftOperations)
							@AdminCompactMetric("retention_label_mutations", i18n.T(ctx, "admin.ops.pruned.labels"), status.Retention.LastPruned.LabelMutations)
							@AdminCompactMetric("retention_folder_states", i18n.T(ctx, "admin.ops.pruned.folders"), status.Retention.LastPruned.FolderStates)
							@AdminCompactMetric("retention_messages", i18n.T(ctx, "admin.ops.pruned.orphans"), status.Retention.LastPruned.Messages)
							@AdminCompactMetric("retention_threads", i18n.T(ctx, "admin.ops.pruned.threads"), status.Retention.LastPruned.Threads)
						</div>
						if status.Retention.LastError != "" {
							<div class="mt-3 rounded-md border border-amber-500/25 bg-amber-500/10 px-3 py-2 text-xs text-amber-800 dark:text-amber-200">{ status.Retention.LastError }</div>
						}
					</section>
				}
				<section class="mt-5 rounded-lg border border-border bg-card p-5">
					<div>
						<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.ops.queue") }</div>
						<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.queue_detail") }</p>
					</div>
					<div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-6">
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.out_active"), status.Health.Outgoing.Pending+status.Health.Outgoing.Sending, false, false)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.out_failed"), status.Health.Outgoing.Failed, status.Health.Outgoing.Failed > 0, false)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.out_ambiguous"), status.Health.Outgoing.Ambiguous, false, status.Health.Outgoing.Ambiguous > 0)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.copy_active"), status.Health.SentCopy.Pending+status.Health.SentCopy.Copying, false, false)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.copy_failed"), status.Health.SentCopy.Failed, status.Health.SentCopy.Failed > 0, false)
						@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.copy_ambiguous"), status.Health.SentCopy.Ambiguous, false, status.Health.SentCopy.Ambiguous > 0)
					</div>
					<div class="mt-5 grid gap-5 lg:grid-cols-3">
						<section class="rounded-lg border border-border/70 bg-background/35 p-4">
							<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "admin.ops.mutations") }</div>
							if len(status.Health.MessageMutations) == 0 {
								<div class="mt-3 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.mutations_empty") }</div>
							} else {
								<div class="mt-3 space-y-1.5">
									for _, item := range status.Health.MessageMutations {
										<div class="flex items-center justify-between gap-3 text-xs">
											<span class="text-muted-foreground">{ adminMailHealthKindLabel(ctx, item.Kind) } · { adminMailHealthStateLabel(ctx, item.State) }</span>
											<span class="font-semibold tabular-nums text-foreground">{ i18n.Number(ctx, item.Count) }</span>
										</div>
									}
								</div>
							}
						</section>
						<section class="rounded-lg border border-border/70 bg-background/35 p-4">
							<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "admin.ops.labels_drafts") }</div>
							<div class="mt-3 space-y-1.5">
								for _, item := range status.Health.LabelMutations {
									<div class="flex items-center justify-between gap-3 text-xs">
										<span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.labels_state", "state", adminMailHealthStateLabel(ctx, item.State)) }</span>
										<span class="font-semibold tabular-nums text-foreground">{ i18n.Number(ctx, item.Count) }</span>
									</div>
								}
								for _, item := range status.Health.IMAPDraftOperations {
									<div class="flex items-center justify-between gap-3 text-xs">
										<span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.drafts_state", "state", adminMailHealthStateLabel(ctx, item.State)) }</span>
										<span class="font-semibold tabular-nums text-foreground">{ i18n.Number(ctx, item.Count) }</span>
									</div>
								}
								if len(status.Health.LabelMutations) == 0 && len(status.Health.IMAPDraftOperations) == 0 {
									<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.labels_drafts_empty") }</div>
								}
							</div>
						</section>
						<section class="rounded-lg border border-border/70 bg-background/35 p-4">
							<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "admin.ops.mailbox_health") }</div>
							<div class="mt-3 space-y-1.5 text-xs">
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">IDLE</span><span class="font-semibold tabular-nums text-foreground">{ i18n.T(ctx, "admin.ops.idle_counts", "configured", i18n.Number(ctx, status.Health.IDLE.Configured), "healthy", i18n.Number(ctx, status.Health.IDLE.Healthy), "fallback", i18n.Number(ctx, status.Health.IDLE.Fallback)) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.folder_sync") }</span><span class="font-semibold tabular-nums text-foreground">{ i18n.T(ctx, "admin.ops.folder_counts", "complete", i18n.Number(ctx, status.Health.FolderSync.Complete), "partial", i18n.Number(ctx, status.Health.FolderSync.Partial), "failed", i18n.Number(ctx, status.Health.FolderSync.Failed)) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.oldest") }</span><span class="font-semibold text-foreground">{ adminMailPendingAge(ctx, status.Health.OldestPendingAt) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.next_retry") }</span><span class="font-semibold text-foreground">{ adminTime(ctx, status.Health.NextRetryAt) }</span></div>
							</div>
						</section>
					</div>
					if status.Scope.SelectedUserID == "" {
						<section class="mt-5 rounded-lg border border-border/70 bg-background/35 p-4">
							<div class="flex items-baseline justify-between gap-3">
								<div class="text-xs font-semibold text-foreground">{ i18n.T(ctx, "admin.ops.smtp") }</div>
								<div class="text-[11px] text-muted-foreground">{ i18n.T(ctx, "admin.ops.smtp_lifetime") }</div>
							</div>
							<p class="mt-1 text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.smtp_detail") }</p>
							<div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-6">
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.smtp_attempts"), status.Health.SMTPProfile.Samples, false, false)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.smtp_successes"), status.Health.SMTPProfile.Successes, false, false)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.smtp_failed"), status.Health.SMTPProfile.Failures, status.Health.SMTPProfile.Failures > 0, false)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.smtp_ambiguous"), status.Health.SMTPProfile.Ambiguous, false, status.Health.SMTPProfile.Ambiguous > 0)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.connections"), status.Health.SMTPProfile.Connections, false, false)
								@AdminMailHealthCard(i18n.T(ctx, "admin.ops.card.messages"), status.Health.SMTPProfile.Messages, false, false)
							</div>
							<div class="mt-4 grid gap-2 text-xs sm:grid-cols-2 xl:grid-cols-4">
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.avg_connect") }</span><span class="font-semibold tabular-nums text-foreground">{ adminSMTPProfileDuration(ctx, status.Health.SMTPProfile.AvgConnectAuthMs) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.avg_transaction") }</span><span class="font-semibold tabular-nums text-foreground">{ adminSMTPProfileDuration(ctx, status.Health.SMTPProfile.AvgDataMs) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.avg_total") }</span><span class="font-semibold tabular-nums text-foreground">{ adminSMTPProfileDuration(ctx, status.Health.SMTPProfile.AvgTotalMs) }</span></div>
								<div class="flex items-center justify-between gap-3"><span class="text-muted-foreground">{ i18n.T(ctx, "admin.ops.avg_queue") }</span><span class="font-semibold tabular-nums text-foreground">{ adminSMTPProfileDuration(ctx, status.Health.SMTPProfile.AvgQueueWaitMs) }</span></div>
							</div>
						</section>
					}
				</section>
				<div class="mt-5 grid gap-5 lg:grid-cols-2">
					<section class="rounded-lg border border-border bg-card p-5">
						<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.ops.by_type") }</div>
						if len(status.ByType) == 0 {
							<div class="mt-4 rounded-md border border-dashed border-border px-3 py-5 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.none") }</div>
						} else {
							<div class="mt-4 space-y-2">
								for _, item := range status.ByType {
									<div class="flex items-center justify-between gap-3 rounded-md border border-border/70 bg-background/40 px-3 py-2.5">
										<div class="min-w-0">
											<div class="text-xs font-semibold text-foreground">{ mailOperationKindLabel(ctx, item.Type) }</div>
											<div class="mt-0.5 text-[11px] text-muted-foreground">{ item.Provider }</div>
										</div>
										<div class="shrink-0 text-right text-xs tabular-nums text-muted-foreground">
											<div>{ i18n.T(ctx, "admin.security.total", "count", i18n.Number(ctx, item.Total)) }</div>
											if item.ActionRequired > 0 {
												<div class="mt-0.5 font-semibold text-amber-700 dark:text-amber-300">{ i18n.N(ctx, "admin.ops.need_attention", item.ActionRequired, "count", i18n.Number(ctx, item.ActionRequired)) }</div>
											}
										</div>
									</div>
								}
							</div>
						}
					</section>
					<section class="rounded-lg border border-border bg-card p-5">
						<div class={ adminPanelTitleClass() }>{ i18n.T(ctx, "admin.ops.by_account") }</div>
						if len(status.ByAccount) == 0 {
							<div class="mt-4 rounded-md border border-dashed border-border px-3 py-5 text-center text-xs text-muted-foreground">{ i18n.T(ctx, "admin.ops.none") }</div>
						} else {
							<div class="mt-4 space-y-2">
								for _, item := range status.ByAccount {
									<div class="flex items-center justify-between gap-3 rounded-md border border-border/70 bg-background/40 px-3 py-2.5">
										<div class="min-w-0">
											<div class="truncate text-xs font-semibold text-foreground">{ item.AccountLabel }</div>
											<div class="mt-0.5 text-[11px] text-muted-foreground">{ item.Provider }</div>
										</div>
										<div class="shrink-0 text-right text-xs tabular-nums text-muted-foreground">
											<div>{ i18n.T(ctx, "admin.security.total", "count", i18n.Number(ctx, item.Total)) }</div>
											if item.ActionRequired > 0 {
												<div class="mt-0.5 font-semibold text-amber-700 dark:text-amber-300">{ i18n.N(ctx, "admin.ops.need_attention", item.ActionRequired, "count", i18n.Number(ctx, item.ActionRequired)) }</div>
											}
										</div>
									</div>
								}
							</div>
						}
					</section>
				</div>
			</div>
		</div>
	</div>
}


templ AdminUserRequiredPasswordChangeAction(user AdminUserData, stepUpRequired bool) {
 if user.RequiredChangePath != "" {
  {{ id := "admin-user-required-change-" + user.ID }}
  if stepUpRequired {
   @button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Href: "/admin/users?" + url.Values{"change_user": {user.ID}}.Encode()}) {
    { i18n.T(ctx, "admin.required_change.button") }
   }
  } else {
   @dialog.Trigger(dialog.TriggerProps{For: id}) {
    @button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Disabled: user.PasswordChangeRequired}) {
     { i18n.T(ctx, "admin.required_change.button") }
    }
   }
  }
  @dialog.Dialog(dialog.Props{ID: id, Open: user.RequiredChangeOpen && !stepUpRequired}) {
   @dialog.Content() {
    @dialog.Header() {
     @dialog.Title() {
      { i18n.T(ctx, "admin.required_change.title", "user", adminUserUsername(ctx, user.Username)) }
     }
     @dialog.Description() {
      { i18n.T(ctx, "admin.required_change.detail") }
     }
    }
    <form method="post" action={ user.RequiredChangePath }>
     <input type="hidden" name="_csrf" value={ user.RequiredChangeCSRFToken }/>
     @dialog.Footer() {
      @dialog.Close() {
       @button.Button(button.Props{Variant: button.VariantOutline}) {
        { i18n.T(ctx, "common.cancel") }
       }
      }
      @button.Button(button.Props{Type: button.TypeSubmit, Disabled: user.PasswordChangeRequired}) {
       { i18n.T(ctx, "admin.required_change.submit") }
      }
     }
    </form>
   }
  }
 }
}

// adminSecurityProtocolSelect picks the protocol of a mail security exception;
// the first one starts selected.
// adminSecurityProtocolLabel names a protocol of an exception: its letters,
// or, for the proxy people add for their own accounts, the word.
func adminSecurityProtocolLabel(ctx context.Context, protocol string) string {
	if protocol == "proxy" {
		return i18n.T(ctx, "admin.security.protocol_proxy")
	}
	return strings.ToUpper(protocol)
}

templ adminSecurityProtocolSelect(protocols []string) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{Name: "protocol", Class: "h-9 bg-background", DisableClear: true, Required: true, Attributes: templ.Attributes{"value": protocols[0], "aria-label": i18n.T(ctx, "admin.security.protocol")}}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "admin.security.protocol")})
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
			for i, protocol := range protocols {
				@selectbox.Item(selectbox.ItemProps{Value: protocol, Selected: i == 0}) {
					{ adminSecurityProtocolLabel(ctx, protocol) }
				}
			}
		}
	}
}
