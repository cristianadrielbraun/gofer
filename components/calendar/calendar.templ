// templui component calendar - version: v1.10.0 installed by templui v1.10.0
// 📚 Documentation: https://templui.io/docs/components/calendar
package calendar

import (
	"github.com/cristianadrielbraun/gofer/internal/i18n"
	"github.com/cristianadrielbraun/gofer/components/icon"
	"github.com/cristianadrielbraun/gofer/components/selectbox"
	"github.com/cristianadrielbraun/gofer/utils"
	"strconv"
	"time"
)

type LocaleTag string

var (
	LocaleDefaultTag    = LocaleTag("en-US")
	LocaleTagChinese    = LocaleTag("zh-CN")
	LocaleTagFrench     = LocaleTag("fr-FR")
	LocaleTagGerman     = LocaleTag("de-DE")
	LocaleTagItalian    = LocaleTag("it-IT")
	LocaleTagJapanese   = LocaleTag("ja-JP")
	LocaleTagPortuguese = LocaleTag("pt-PT")
	LocaleTagSpanish    = LocaleTag("es-ES")
)

type Day int

var (
	Sunday    = Day(0)
	Monday    = Day(1)
	Tuesday   = Day(2)
	Wednesday = Day(3)
	Thursday  = Day(4)
	Friday    = Day(5)
	Saturday  = Day(6)
)

type Props struct {
	ID              string
	Class           string
	LocaleTag       LocaleTag
	Value           *time.Time
	Name            string
	InitialMonth    int  // Optional: 0-11 (Default: current or from Value). Controls the initially displayed month view.
	InitialYear     int  // Optional: (Default: current or from Value). Controls the initially displayed year view.
	StartOfWeek     *Day // Optional: 0-6 [Sun-Sat] (Default: 1).
	HideHiddenInput bool // Optional: Hide the hidden input when a parent component owns form submission.
	MinYear         int  // Optional: first year in the year menu (Default: 1900).
	MaxYear         int  // Optional: last year in the year menu (Default: 2100).
}

templ Calendar(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
		if p.ID == "" {
			p.ID = utils.RandomID() + "-calendar"
		}
		if p.Name == "" {
			// Should be provided by parent (e.g., DatePicker or in standalone usage)
			p.Name = p.ID + "-value" // Fallback name
		}
		if p.LocaleTag == "" {
			// Gofer: the page's language, so month and day names match it.
			p.LocaleTag = LocaleTag(i18n.Lang(ctx))
		}
		if p.LocaleTag == "" {
			p.LocaleTag = LocaleDefaultTag
		}

		initialStartOfWeek := Monday
		if p.StartOfWeek != nil {
			initialStartOfWeek = *p.StartOfWeek
		}

		initialView := time.Now()
		if p.Value != nil {
			initialView = *p.Value
		}

		initialMonth := p.InitialMonth
		initialYear := p.InitialYear

		// Use year from initialView if InitialYear prop is invalid/unset (<= 0)
		if initialYear <= 0 {
			initialYear = initialView.Year()
		}

		// Use month from initialView if InitialMonth prop is invalid OR
		// if InitialMonth is default 0 AND InitialYear was also defaulted (meaning neither was likely set explicitly)
		if (initialMonth < 0 || initialMonth > 11) || (initialMonth == 0 && p.InitialYear <= 0) {
			initialMonth = int(initialView.Month()) - 1 // time.Month is 1-12
		}

		initialSelectedISO := ""
		if p.Value != nil {
			initialSelectedISO = p.Value.Format("2006-01-02")
		}

		// For SelectBox display
		currentMonth := initialMonth
		currentYear := initialYear

		// Generate short month names (English only, JS will update with localized)
		monthNames := []string{"Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"}
	}}
	<div
		class={ utils.TwMerge("inline-flex flex-col [--cell-size:2rem]", p.Class) }
		id={ p.ID + "-wrapper" }
		data-tui-calendar-wrapper="true"
	>
		if !p.HideHiddenInput {
			<input
				type="hidden"
				name={ p.Name }
				value={ initialSelectedISO }
				id={ p.ID + "-hidden" }
				data-tui-calendar-hidden-input
			/>
		}
		<div
			id={ p.ID }
			class="inline-flex flex-col"
			data-tui-calendar-container="true"
			data-tui-calendar-locale-tag={ string(p.LocaleTag) }
			data-tui-calendar-initial-month={ strconv.Itoa(initialMonth) }
			data-tui-calendar-initial-year={ strconv.Itoa(initialYear) }
			data-tui-calendar-selected-date={ initialSelectedISO }
			data-tui-calendar-start-of-week={ int(initialStartOfWeek) }
		>
			<!-- Calendar Header -->
			<div class="flex w-full items-center gap-2 mb-4">
				<button
					type="button"
					data-tui-calendar-prev
					class="inline-flex items-center justify-center rounded-md text-sm font-medium h-7 w-7 hover:bg-accent hover:text-accent-foreground focus:outline-none disabled:opacity-50 shrink-0"
				>
					@icon.ChevronLeft()
				</button>
				<div class="flex gap-2 flex-1 min-w-0">
					@selectbox.SelectBox(selectbox.Props{Class: "flex-1 min-w-0"}) {
						@selectbox.Trigger(selectbox.TriggerProps{ID: p.ID + "-month-select", Class: "h-7 px-2 text-sm", DisableClear: true, Attributes: templ.Attributes{"data-tui-calendar-month-select": "", "value": strconv.Itoa(currentMonth)}}) {
							@selectbox.Value(selectbox.ValueProps{ID: p.ID + "-month-value", Placeholder: monthNames[currentMonth]})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "components.choose_month")}}) {
							@selectbox.Group(selectbox.GroupProps{Attributes: selectbox.LazyItems(monthMenuItems(monthNames))}) {
								@selectbox.Item(selectbox.ItemProps{Value: strconv.Itoa(currentMonth), Selected: true, Attributes: templ.Attributes{"data-tui-calendar-month-index": strconv.Itoa(currentMonth)}}) { { monthNames[currentMonth] } }
							}
						}
					}
					@selectbox.SelectBox(selectbox.Props{Class: "flex-1 min-w-0"}) {
						@selectbox.Trigger(selectbox.TriggerProps{ID: p.ID + "-year-select", Class: "h-7 px-2 text-sm", DisableClear: true, Attributes: templ.Attributes{"data-tui-calendar-year-select": "", "value": strconv.Itoa(currentYear)}}) {
							@selectbox.Value(selectbox.ValueProps{ID: p.ID + "-year-value", Placeholder: strconv.Itoa(currentYear)})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true, DisableExclusive: true, Attributes: templ.Attributes{"aria-label": i18n.T(ctx, "components.choose_year")}}) {
							@selectbox.Group(selectbox.GroupProps{Attributes: selectbox.LazyItems(yearMenuItems(p))}) {
								@selectbox.Item(selectbox.ItemProps{Value: strconv.Itoa(currentYear), Selected: true}) { { strconv.Itoa(currentYear) } }
							}
						}
					}
				</div>
				<button
					type="button"
					data-tui-calendar-next
					class="inline-flex items-center justify-center rounded-md text-sm font-medium h-7 w-7 hover:bg-accent hover:text-accent-foreground focus:outline-none disabled:opacity-50 shrink-0"
				>
					@icon.ChevronRight()
				</button>
			</div>
			<!-- Weekday Headers -->
			<div data-tui-calendar-weekdays class="inline-grid grid-cols-[repeat(7,var(--cell-size))] gap-1 mb-1 place-items-center"></div>
			<!-- Calendar Day Grid -->
			<div data-tui-calendar-days class="inline-grid grid-cols-[repeat(7,var(--cell-size))] gap-1 place-items-center"></div>
		</div>
	</div>
}

var scriptOnce = templ.NewOnceHandle()

templ Script() {
	@scriptOnce.Once() {
		@selectbox.Script()
		@utils.ComponentScript("calendar")
	}
}

func yearMenuMin(p Props) int {
	if p.MinYear > 0 {
		return p.MinYear
	}
	return 1900
}

func yearMenuMax(p Props) int {
	if p.MaxYear > 0 {
		return p.MaxYear
	}
	return 2100
}

// The month and year menus are sent with their selected entry only; the
// browser builds the rest from these lists (see selectbox.LazyItems).
func monthMenuItems(names []string) []selectbox.LazyItem {
	items := make([]selectbox.LazyItem, len(names))
	for i, name := range names {
		items[i] = selectbox.LazyItem{Value: strconv.Itoa(i), Label: name}
	}
	return items
}

func yearMenuItems(p Props) []selectbox.LazyItem {
	var items []selectbox.LazyItem
	for year := yearMenuMax(p); year >= yearMenuMin(p); year-- {
		items = append(items, selectbox.LazyItem{Value: strconv.Itoa(year), Label: strconv.Itoa(year)})
	}
	return items
}
