GO_ENV=development

# HTTP boundary. The default listener is loopback-only.
GOFER_ADDR=127.0.0.1:8090
GOFER_BASE_URL=http://local.localhost:8090
# Optional client-network allowlist for ALL modes. Explicit lists replace defaults.
# Unset: open permits only loopback; personal/managed permit any client network.
# GOFER_ALLOWED_CIDRS=127.0.0.0/8,::1/128,192.168.0.0/24
# Trust only the actual reverse-proxy peer addresses, if a proxy is used.
# GOFER_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Legacy unrestricted open-mode flag. A nonempty GOFER_ALLOWED_CIDRS overrides it.
# GOFER_ALLOW_UNAUTHENTICATED_REMOTE=false
# Allow a plain-HTTP GOFER_BASE_URL on a private network address (for example
# http://192.168.0.10:8090) while sign-in is required. Sign-in cookies then travel
# unencrypted on that network, and passkeys are unavailable there.
# GOFER_ALLOW_INSECURE_LAN=false
# Let Microsoft announce Outlook mailbox changes at GOFER_BASE_URL/webhooks/outlook
# instead of waiting for the next check. Requires personal or managed auth and a
# public https GOFER_BASE_URL; the path must be reachable without signing in.
# GOFER_OUTLOOK_WEBHOOKS=false
# Let Microsoft's servers reach that path when GOFER_ALLOWED_CIDRS is set.
# GOFER_OUTLOOK_WEBHOOKS_SKIP_ALLOWED_CIDRS=false
# Open GOFER_BASE_URL in this computer's default browser once Gofer is ready.
# Off by default; leave it off on servers and in containers.
# GOFER_OPEN_BROWSER=false
# Experimental: lets people add JMAP mail accounts. Incomplete; off by default.
# GOFER_JMAP_EXPERIMENT=false

# Authentication. Application-login clients are identity-only and separate from mailbox clients.
# open: no login; personal: one protected profile; managed: separate administrators/users.
# Unset: personal, unless the legacy GOFER_AUTH_ENABLED is set. When set,
# GOFER_AUTH_MODE takes precedence over the legacy GOFER_AUTH_ENABLED.
GOFER_AUTH_MODE=personal
# Managed mode: maximum user databases kept open (default 16). A higher limit
# reduces reopening for active users but uses more memory and file descriptors.
# GOFER_USER_DB_MAX_OPEN=16
# Managed mode: background mail syncs running at once across all users
# (default 16), and at most this many to the same mail server (default 8).
# Syncs mostly wait on mail servers; raise the first if the log warns that
# syncs wait for a free worker, keeping it near GOFER_USER_DB_MAX_OPEN.
# Opening messages and other actions people wait for are never queued behind
# background syncs.
# GOFER_SYNC_MAX_CONCURRENT=16
# GOFER_SYNC_MAX_PER_SERVER=8
# Managed mode: folders watched for new mail in real time (IMAP IDLE), for
# people who have Gofer open; each holds one mail server connection. At most
# GOFER_IDLE_MAX across all users (default 1024) and GOFER_IDLE_MAX_PER_SERVER
# on one mail server (default 256). Inboxes come first; beyond the limits, and
# for servers without IDLE, open accounts are checked every minute instead.
# GOFER_IDLE_MAX=1024
# GOFER_IDLE_MAX_PER_SERVER=256
# Managed mode converts an existing shared database to per-user storage on the
# first start. Set this to refuse to start instead, for example while automatic
# updates are enabled, until you have backed up and are ready to convert.
# GOFER_PREVENT_STORAGE_CONVERSION=false
# Legacy fallback when GOFER_AUTH_MODE is unset: false=open, true=managed.
# GOFER_AUTH_ENABLED=false
GOFER_GOOGLE_LOGIN_CLIENT_ID=
GOFER_GOOGLE_LOGIN_CLIENT_SECRET=
GOFER_MICROSOFT_LOGIN_CLIENT_ID=
GOFER_MICROSOFT_LOGIN_CLIENT_SECRET=
GOFER_MICROSOFT_LOGIN_TENANT=common
# One optional generic OpenID Connect application-login provider. Identity only; no mailbox access.
GOFER_OIDC_LOGIN_ISSUER=
GOFER_OIDC_LOGIN_CLIENT_ID=
GOFER_OIDC_LOGIN_CLIENT_SECRET=
GOFER_OIDC_LOGIN_NAME=OpenID Connect

# Mailbox authorization. These clients grant Gmail/Outlook data access only after an authenticated Settings action.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Outlook works without setup: leave the client ID empty to use Gofer's built-in registration,
# which connects mailboxes with a device code. Set it to "off" to hide Outlook, or to your own
# registration's client ID to use that instead. With your own registration, a secret switches to
# the redirect flow; leaving it empty uses a device code and needs "Allow public client flows".
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Optional Web Push override. If omitted, Gofer generates and stores keys next to the DB.
GOFER_VAPID_PUBLIC_KEY=
GOFER_VAPID_PRIVATE_KEY=
GOFER_VAPID_SUBJECT=mailto:gofer@gofer.email

# Performance diagnostics, off by default. GOFER_SLOW_QUERY_MS logs database
# queries and transactions slower than this many milliseconds (statement text
# only, never the values). GOFER_PPROF_ADDR serves Go profiling at
# /debug/pprof/ on a loopback address; it has no login, so reach it remotely
# through an SSH tunnel.
# GOFER_SLOW_QUERY_MS=100
# GOFER_PPROF_ADDR=127.0.0.1:6060
