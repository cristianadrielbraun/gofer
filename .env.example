GO_ENV=development

# HTTP boundary. The default listener is loopback-only.
GOFER_ADDR=127.0.0.1:8090
GOFER_BASE_URL=http://local.localhost:8090
# Optional client-network allowlist for ALL modes. Explicit lists replace defaults.
# Unset: open permits only loopback; personal/managed permit any client network.
# GOFER_ALLOWED_CIDRS=127.0.0.0/8,::1/128,192.168.0.0/24
# Trust only the actual reverse-proxy peer addresses, if a proxy is used.
# GOFER_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Legacy unrestricted open-mode flag. A nonempty GOFER_ALLOWED_CIDRS overrides it.
# GOFER_ALLOW_UNAUTHENTICATED_REMOTE=false

# Authentication. Application-login clients are identity-only and separate from mailbox clients.
# open: no login; personal: one protected profile; managed: separate administrators/users.
# When set, GOFER_AUTH_MODE takes precedence over the legacy GOFER_AUTH_ENABLED.
GOFER_AUTH_MODE=open
# Legacy fallback when GOFER_AUTH_MODE is unset: false=open, true=managed.
# GOFER_AUTH_ENABLED=false
GOFER_GOOGLE_LOGIN_CLIENT_ID=
GOFER_GOOGLE_LOGIN_CLIENT_SECRET=
GOFER_MICROSOFT_LOGIN_CLIENT_ID=
GOFER_MICROSOFT_LOGIN_CLIENT_SECRET=
GOFER_MICROSOFT_LOGIN_TENANT=common
# One optional generic OpenID Connect application-login provider. Identity only; no mailbox access.
GOFER_OIDC_LOGIN_ISSUER=
GOFER_OIDC_LOGIN_CLIENT_ID=
GOFER_OIDC_LOGIN_CLIENT_SECRET=
GOFER_OIDC_LOGIN_NAME=OpenID Connect

# Mailbox authorization. These clients grant Gmail/Outlook data access only after an authenticated Settings action.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# Optional Web Push override. If omitted, Gofer generates and stores keys next to the DB.
GOFER_VAPID_PUBLIC_KEY=
GOFER_VAPID_PRIVATE_KEY=
GOFER_VAPID_SUBJECT=mailto:gofer@gofer.email
